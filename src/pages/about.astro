---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import EcommerceShowcase from '../components/demo-lab/EcommerceShowcase';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const supportHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('E-commerce demo request')}`;
---

<MarketingLayout
  title="Portfolio | Interactive Commerce Demo"
  description="Interactive commerce demo route for portfolio reviews, implementation walkthroughs, and buyer-facing storefront exploration."
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <div class="shop-demo-page">
    <section
      class="border-b border-white/10"
      data-reveal
      id="portfolio-hero"
      data-page-section
    >
      <div
        class="mx-auto max-w-[1240px] px-4 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-32"
      >
        <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
          <div class="space-y-6">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Portfolio demo
            </p>
            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
            >
              Full demo e-commerce setup for portfolio reviews, buyer demos, and
              implementation walkthroughs.
            </h1>
            <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
              This route keeps the interactive storefront, but the framing is
              now more useful: what the demo proves, what buyers can review, and
              how the experience maps to a real implementation discussion.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
                className="min-h-[50px]"
              >
                Request this demo build
              </ModernButton>
              <ModernButton
                href={supportHref}
                variant="secondary"
                className="min-h-[50px]"
              >
                Ask implementation details
              </ModernButton>
            </div>
          </div>

          <ModernCard variant="glass" className="p-7 sm:p-8">
            <p
              class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
            >
              Demo capabilities
            </p>
            <ul class="mt-4 space-y-3 text-sm text-slate-300">
              <li class="flex items-start gap-2">
                <span
                  class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-300"
                ></span>
                <span>Instant search + smart filtering + sorting</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-300"
                ></span>
                <span>Wishlist, compare view, and quick product previews</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-300"
                ></span>
                <span>Cart persistence + promo flow + checkout simulation</span>
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-300"
                ></span>
                <span>Safety console for pause/reduced-motion/perf mode</span>
              </li>
            </ul>

            <div class="mt-6 border-t border-white/10 pt-5">
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
              >
                Quick launch scenarios
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <button
                  type="button"
                  class="demo-launch inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-3 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                  data-demo-command="open-cart"
                >
                  Open cart
                </button>
                <button
                  type="button"
                  class="demo-launch inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-3 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                  data-demo-command="open-compare"
                >
                  Open compare
                </button>
                <button
                  type="button"
                  class="demo-launch inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-3 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                  data-demo-command="open-quick-view"
                  data-demo-product="spectral-sneaker"
                >
                  Quick view
                </button>
                <button
                  type="button"
                  class="demo-launch inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-3 text-xs font-semibold uppercase tracking-[0.12em] text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                  data-demo-command="start-checkout"
                  data-demo-product="aurora-hoodie"
                >
                  Jump to checkout
                </button>
              </div>
            </div>
          </ModernCard>
        </div>
      </div>
    </section>

    <section
      class="border-b border-white/10"
      data-reveal
      id="safety-console"
      data-page-section
    >
      <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
        <ModernCard className="p-7" variant="glass">
          <div class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-start">
            <div class="space-y-3">
              <p
                class="font-mono text-[0.72rem] uppercase tracking-[0.22em] text-white/45"
              >
                Controls
              </p>
              <h2 class="text-2xl font-semibold text-white">Safety Console</h2>
              <p class="text-sm leading-7 text-slate-300">
                Toggle pause, reduced motion, and perf mode. These controls
                apply through
                <code
                  class="rounded border border-white/10 bg-white/[0.03] px-1.5 py-0.5 text-slate-200"
                  >data-demo-*</code
                >
                attributes and are respected by the interactive showcase.
              </p>
            </div>

            <div class="grid gap-2 sm:grid-cols-3 md:w-auto">
              <button
                type="button"
                class="demo-toggle inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-4 text-sm font-semibold text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                data-demo-toggle="paused"
                aria-pressed="false"
              >
                Pause
              </button>
              <button
                type="button"
                class="demo-toggle inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-4 text-sm font-semibold text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                data-demo-toggle="reduced"
                aria-pressed="false"
              >
                Reduced motion
              </button>
              <button
                type="button"
                class="demo-toggle inline-flex h-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] px-4 text-sm font-semibold text-white transition hover:border-white/20 hover:bg-white/[0.05] focus:outline-none focus:ring-2 focus:ring-white/20"
                data-demo-toggle="perf"
                aria-pressed="false"
              >
                Perf mode
              </button>
            </div>

            <p
              class="mt-2 font-mono text-xs text-white/55"
              data-demo-status
              data-testid="demo-safety-status"
            >
              Demo safety status: pause off, reduced motion off, perf mode off.
            </p>
          </div>
        </ModernCard>
      </div>
    </section>

    <section
      class="pb-20 pt-10"
      data-reveal
      id="shop-experience"
      data-page-section
    >
      <div class="mx-auto max-w-[1240px] scroll-mt-24 px-4 sm:px-6">
        <div class="demo-module" data-demo-module="ecommerce-showcase">
          <EcommerceShowcase client:visible />
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .demo-module {
    content-visibility: auto;
    contain: layout paint style;
    contain-intrinsic-size: 900px;
  }

  .demo-module[data-demo-paused='true'] * {
    animation-play-state: paused !important;
  }

  html[data-demo-reduced-motion='true'] .demo-module *,
  .demo-module[data-demo-reduced-motion='true'] * {
    animation: none !important;
    transition: none !important;
  }
</style>

<script>
  import '../scripts/demo-lab';

  const commandButtons = document.querySelectorAll(
    '[data-demo-command]'
  ) as NodeListOf<HTMLButtonElement>;

  const dispatchDemoCommand = (payload: {
    action: 'open-cart' | 'open-compare' | 'open-quick-view' | 'start-checkout';
    productId?: string;
  }) => {
    window.dispatchEvent(
      new CustomEvent('demo:ecom-command', {
        detail: payload,
      })
    );

    const demoSection = document.getElementById('shop-experience');
    if (demoSection) {
      demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  commandButtons.forEach(button => {
    button.addEventListener('click', () => {
      const action = button.dataset.demoCommand;
      if (!action) return;

      dispatchDemoCommand({
        action: action as
          | 'open-cart'
          | 'open-compare'
          | 'open-quick-view'
          | 'start-checkout',
        productId: button.dataset.demoProduct,
      });
    });
  });
</script>
