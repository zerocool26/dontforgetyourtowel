---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import EcommerceShowcase from '../components/demo-lab/EcommerceShowcase';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const supportHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('E-commerce demo request')}`;
---

<MarketingLayout
  title="Portfolio | Interactive E-Commerce Demo"
  description="Interactive portfolio storefront with search, filters, compare, wishlist, cart persistence, and simulated checkout flow."
>
  <div class="creative-page shop-demo-page">
    <section class="tone-surface relative overflow-hidden" data-reveal>
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(204,255,0,0.15),_transparent_52%)]"
      >
      </div>
      <div class="mx-auto max-w-[1220px] px-6 pb-14 pt-28">
        <div
          class="creative-hero-shell grid gap-8 p-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center"
        >
          <div class="space-y-6">
            <span class="creative-kicker">Portfolio • Live Commerce Engine</span
            >
            <h1
              class="creative-title tone-title text-4xl font-bold sm:text-5xl"
            >
              Full demo e-commerce setup,
              <span class="text-[#ccff00]">
                now embedded in the portfolio route.</span
              >
            </h1>
            <p class="creative-copy tone-body text-base">
              This is no longer a static showcase. You now have a complete
              interactive commerce lab on this page with product discovery,
              merchandising controls, and a simulated checkout workflow.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
                className="min-h-[48px]"
              >
                Request this build
              </ModernButton>
              <ModernButton
                href={supportHref}
                variant="secondary"
                className="min-h-[48px]"
              >
                Ask implementation details
              </ModernButton>
            </div>
          </div>

          <ModernCard
            variant="minimal"
            className="creative-panel tone-elevated p-6"
          >
            <p class="tone-muted text-xs uppercase tracking-[0.24em]">
              Enabled capabilities
            </p>
            <ul class="tone-body mt-4 space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-[#ccff00]"
                ></span>
                <span>Instant search + smart filtering + sorting</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-[#ccff00]"
                ></span>
                <span>Wishlist, compare view, and quick product previews</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-[#ccff00]"
                ></span>
                <span>Cart persistence + promo flow + checkout simulation</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-[#ccff00]"
                ></span>
                <span>Safety console for pause/reduced-motion/perf mode</span>
              </li>
            </ul>

            <div class="tone-border mt-5 border-t pt-4">
              <p class="tone-muted text-xs uppercase tracking-[0.24em]">
                Launch scenarios
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <button
                  type="button"
                  class="demo-launch tone-border tone-surface tone-title inline-flex h-10 items-center justify-center rounded-lg border px-3 text-xs font-semibold uppercase tracking-[0.12em] transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                  data-demo-command="open-cart"
                >
                  Open cart
                </button>
                <button
                  type="button"
                  class="demo-launch tone-border tone-surface tone-title inline-flex h-10 items-center justify-center rounded-lg border px-3 text-xs font-semibold uppercase tracking-[0.12em] transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                  data-demo-command="open-compare"
                >
                  Open compare
                </button>
                <button
                  type="button"
                  class="demo-launch tone-border tone-surface tone-title inline-flex h-10 items-center justify-center rounded-lg border px-3 text-xs font-semibold uppercase tracking-[0.12em] transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                  data-demo-command="open-quick-view"
                  data-demo-product="spectral-sneaker"
                >
                  Quick view
                </button>
                <button
                  type="button"
                  class="demo-launch tone-border tone-surface tone-title inline-flex h-10 items-center justify-center rounded-lg border px-3 text-xs font-semibold uppercase tracking-[0.12em] transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                  data-demo-command="start-checkout"
                  data-demo-product="aurora-hoodie"
                >
                  Jump to checkout
                </button>
              </div>
            </div>
          </ModernCard>
        </div>
      </div>
    </section>

    <section class="tone-border tone-surface border-y" data-reveal>
      <div class="mx-auto max-w-[1220px] px-6 py-10">
        <ModernCard
          className="creative-panel tone-elevated p-6"
          variant="minimal"
        >
          <div class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-start">
            <div class="space-y-3">
              <h2 class="tone-title text-2xl font-semibold">Safety Console</h2>
              <p class="tone-body text-sm leading-relaxed">
                Toggle pause, reduced motion, and perf mode. These controls
                apply through
                <code class="tone-border tone-surface rounded px-1.5 py-0.5"
                  >data-demo-*</code
                >
                attributes and are respected by the interactive showcase.
              </p>
            </div>

            <div class="grid gap-2 sm:grid-cols-3 md:w-auto">
              <button
                type="button"
                class="demo-toggle tone-border tone-surface tone-title inline-flex h-11 items-center justify-center rounded-lg border px-4 text-sm font-semibold transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                data-demo-toggle="paused"
                aria-pressed="false"
              >
                Pause
              </button>
              <button
                type="button"
                class="demo-toggle tone-border tone-surface tone-title inline-flex h-11 items-center justify-center rounded-lg border px-4 text-sm font-semibold transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                data-demo-toggle="reduced"
                aria-pressed="false"
              >
                Reduced motion
              </button>
              <button
                type="button"
                class="demo-toggle tone-border tone-surface tone-title inline-flex h-11 items-center justify-center rounded-lg border px-4 text-sm font-semibold transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[#ccff00]"
                data-demo-toggle="perf"
                aria-pressed="false"
              >
                Perf mode
              </button>
            </div>
          </div>
        </ModernCard>
      </div>
    </section>

    <section class="pb-20 pt-10" data-reveal id="shop-experience">
      <div class="mx-auto max-w-[1220px] scroll-mt-24 px-6">
        <div class="demo-module" data-demo-module="ecommerce-showcase">
          <EcommerceShowcase client:visible />
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .demo-module {
    content-visibility: auto;
    contain: layout paint style;
    contain-intrinsic-size: 900px;
  }

  .demo-module[data-demo-paused='true'] * {
    animation-play-state: paused !important;
  }

  html[data-demo-reduced-motion='true'] .demo-module *,
  .demo-module[data-demo-reduced-motion='true'] * {
    animation: none !important;
    transition: none !important;
  }
</style>

<script>
  import '../scripts/demo-lab';

  const commandButtons = document.querySelectorAll(
    '[data-demo-command]'
  ) as NodeListOf<HTMLButtonElement>;

  const dispatchDemoCommand = (payload: {
    action: 'open-cart' | 'open-compare' | 'open-quick-view' | 'start-checkout';
    productId?: string;
  }) => {
    window.dispatchEvent(
      new CustomEvent('demo:ecom-command', {
        detail: payload,
      })
    );

    const demoSection = document.getElementById('shop-experience');
    if (demoSection) {
      demoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };

  commandButtons.forEach(button => {
    button.addEventListener('click', () => {
      const action = button.dataset.demoCommand;
      if (!action) return;

      dispatchDemoCommand({
        action: action as
          | 'open-cart'
          | 'open-compare'
          | 'open-quick-view'
          | 'start-checkout',
        productId: button.dataset.demoProduct,
      });
    });
  });
</script>
