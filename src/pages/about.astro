---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import EcommerceShowcase from '../components/demo-lab/EcommerceShowcase';
import { withBasePath } from '../utils/helpers';

const proofSignals = [
  {
    value: 'URL-backed',
    label: 'Review presets',
    detail:
      'Stakeholders can reopen cart, compare, quick view, and checkout states without a long screen-share explanation.',
  },
  {
    value: 'Live',
    label: 'Buyer interactions',
    detail:
      'Search, compare, quick view, cart, and checkout behavior can be tested directly instead of guessed from mockups.',
  },
  {
    value: 'Mobile-first',
    label: 'Presentation rhythm',
    detail:
      'Controls stay readable and tappable because most buyer research and approval checks happen on imperfect screens.',
  },
];

const quickActions = [
  {
    title: 'Start with discovery',
    description:
      'Jump into search and product detail behavior to see whether finding and evaluating an item stays fast.',
    state: 'quickview',
    productId: 'spectral-sneaker',
    buttonLabel: 'Open quick view',
    command: 'open-quick-view',
  },
  {
    title: 'Walk the decision moment',
    description:
      'Open compare to review scanability, tradeoffs, reassurance, and whether the next step is obvious.',
    state: 'compare',
    buttonLabel: 'Open compare',
    command: 'open-compare',
  },
  {
    title: 'Review conversion friction',
    description:
      'Go directly to checkout and review shipping, totals, reassurance, and handoff points that protect buyer intent.',
    state: 'checkout',
    productId: 'aurora-hoodie',
    buttonLabel: 'Jump to checkout',
    command: 'start-checkout',
  },
];

const guidedReviewSteps = [
  {
    title: 'Frame the audience first',
    copy: 'Set the review around merchandising, sales, owner approval, or stakeholder signoff so the right details matter first.',
  },
  {
    title: 'Open a believable journey state',
    copy: 'Use a preset that mirrors the actual question being asked instead of clicking around while narrating the intent.',
  },
  {
    title: 'Show the confidence layer',
    copy: 'Point to compare clarity, quick-view context, shipping detail, and checkout reassurance so trust is visible, not implied.',
  },
  {
    title: 'Share the exact moment',
    copy: 'Copy the state URL and keep the conversation synchronized across owners, vendors, and follow-up notes.',
  },
];

const storeStandards = [
  'Fast scan paths for first-time visitors',
  'Visible trust and proof near decision points',
  'Reduced-motion and pause controls for stakeholder reviews',
  'Shareable states for async approvals and follow-up',
];

const commerceTrustSignals = [
  {
    title: 'Storytelling that stays actionable',
    copy: 'Strong visual rhythm, but every section still has to earn the next buyer step.',
  },
  {
    title: 'Review states that are easy to share',
    copy: 'A single URL can reopen the exact screen state being discussed in the room.',
  },
  {
    title: 'Operational credibility',
    copy: 'The lab behaves like something a team could actually review, refine, QA, and ship.',
  },
];

const implementationTracks = [
  {
    title: 'Executive walkthrough',
    copy: 'Use presets and the review board to explain value quickly without getting lost in product mechanics.',
  },
  {
    title: 'Design + content critique',
    copy: 'Review hierarchy, motion, trust cues, product copy, CTA clarity, and mobile behavior in one place.',
  },
  {
    title: 'Production handoff',
    copy: 'Translate review states into build tickets, product rules, QA notes, and real acceptance criteria.',
  },
];

const featuredProducts = [
  {
    title: 'Aurora Hoodie',
    state: 'checkout',
    productId: 'aurora-hoodie',
    note: 'Use for shipping reassurance, checkout sequencing, and conversion handoff review.',
  },
  {
    title: 'Spectral Sneaker',
    state: 'quickview',
    productId: 'spectral-sneaker',
    note: 'Use for merchandising, quick-view context, and product-storytelling discussion.',
  },
  {
    title: 'Compare set',
    state: 'compare',
    note: 'Use for decision support and scan-friendly differentiation review.',
  },
];
---

<MarketingLayout
  title="Commerce Lab | Olive Chicago"
  description="Interactive commerce lab with shareable review states, safety controls, and a live proof board for buyer-facing digital systems."
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="website"
    data={{
      name: 'Commerce Lab',
      description:
        'Interactive commerce lab with review board, shareable screen states, and accessibility-minded controls.',
    }}
  />

  <section class="demo-page-hero" data-page-section>
    <div class="premium-container">
      <div class="demo-page-hero__grid">
        <div class="tone-page-header">
          <p class="tone-page-eyebrow">Commerce lab</p>
          <h1 class="tone-page-title">
            Buyer-facing systems should prove trust before the sales call.
          </h1>
          <p class="tone-page-copy">
            Storefronts, portals, product pages, and intake paths need fast
            finding, clear comparison, useful reassurance, clean handoff, and a
            review trail teams can share before anything ships.
          </p>

          <div class="tone-page-actions">
            <ModernButton
              href="#shop-experience"
              variant="gradient"
              className="min-h-[52px]"
            >
              Open live demo
            </ModernButton>
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Scope a digital system
            </ModernButton>
          </div>
        </div>

        <div class="demo-page-hero__panel tone-panel-soft">
          <p class="demo-page-panel__label">
            What a serious review should check
          </p>
          <div class="demo-page-signal-grid">
            {
              proofSignals.map(signal => (
                <article class="demo-page-signal">
                  <p>{signal.label}</p>
                  <h2>{signal.value}</h2>
                  <span>{signal.detail}</span>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="demo-page-section" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Launch states</p>
        <h2 class="tone-section-title">
          Open the exact decision moment instead of clicking around and hoping
          the value becomes obvious.
        </h2>
      </div>

      <div class="demo-launch-grid">
        {
          quickActions.map(action => (
            <article class="demo-launch-card tone-panel-soft">
              <div>
                <p class="demo-launch-card__eyebrow">{action.title}</p>
                <p>{action.description}</p>
              </div>
              <button
                type="button"
                class="demo-action-button"
                data-demo-command={action.command}
                data-demo-state={action.state}
                data-demo-product={action.productId}
              >
                {action.buttonLabel}
              </button>
            </article>
          ))
        }

        <article
          class="demo-launch-card tone-panel-soft demo-launch-card--reset"
        >
          <div>
            <p class="demo-launch-card__eyebrow">Back to baseline</p>
            <p>
              Clear the query-backed launch state and reopen the baseline
              commerce view.
            </p>
          </div>
          <button
            type="button"
            class="demo-action-button demo-action-button--ghost"
            data-demo-reset
          >
            Reset launch state
          </button>
        </article>
      </div>
    </div>
  </section>

  <section class="demo-page-section" data-page-section>
    <div class="premium-container">
      <div class="demo-proof-grid">
        <article class="demo-proof-board tone-panel-soft">
          <p class="tone-section-kicker">Scenario review board</p>
          <div class="demo-proof-board__headline">
            <h2 data-demo-active-state>Baseline commerce view loaded</h2>
            <p>
              The board updates as you change review states, so teams can keep
              the narrative, audience, and share URL aligned.
            </p>
          </div>

          <div class="demo-proof-metrics">
            <article class="demo-proof-metric">
              <p>Focus</p>
              <strong data-demo-metric-focus>Storefront overview</strong>
            </article>
            <article class="demo-proof-metric">
              <p>Audience</p>
              <strong data-demo-metric-audience>Stakeholder walkthroughs</strong
              >
            </article>
            <article class="demo-proof-metric">
              <p>Proof</p>
              <strong data-demo-metric-proof>
                The baseline view gives the room a clean starting point before
                drilling into a buyer task.
              </strong>
            </article>
          </div>

          <div class="demo-share-board">
            <div class="demo-share-board__meta">
              <p>Share title</p>
              <strong data-demo-share-title
                >Baseline commerce view loaded</strong
              >
            </div>
            <div class="demo-share-board__meta">
              <p>Share URL</p>
              <strong data-demo-share-url
                >{withBasePath('about/#shop-experience')}</strong
              >
            </div>
            <div class="demo-share-board__actions">
              <button
                type="button"
                class="demo-share-button"
                data-demo-copy-link
              >
                Copy launch link
              </button>
              <button
                type="button"
                class="demo-share-button"
                data-demo-native-share
              >
                Native share
              </button>
            </div>
            <div class="demo-share-platforms" data-demo-share-platforms>
              <button
                type="button"
                class="share-button"
                data-demo-share-platform="email">Email</button
              >
              <button
                type="button"
                class="share-button"
                data-demo-share-platform="linkedin">LinkedIn</button
              >
              <button
                type="button"
                class="share-button"
                data-demo-share-platform="x">X</button
              >
            </div>
          </div>
        </article>

        <article class="demo-proof-board tone-panel-soft">
          <p class="tone-section-kicker">Review choreography</p>
          <div class="demo-step-list">
            {
              guidedReviewSteps.map((step, index) => (
                <div class="demo-step-item">
                  <span>0{index + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.copy}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="demo-page-section" data-page-section>
    <div class="premium-container">
      <div class="demo-assurance-grid">
        <article class="demo-assurance-card tone-panel-soft">
          <p class="tone-section-kicker">Store standards</p>
          <ul class="demo-bullet-list">
            {storeStandards.map(item => <li>{item}</li>)}
          </ul>
        </article>

        <article class="demo-assurance-card tone-panel-soft">
          <p class="tone-section-kicker">Trust signals</p>
          <div class="demo-trust-list">
            {
              commerceTrustSignals.map(signal => (
                <div>
                  <h3>{signal.title}</h3>
                  <p>{signal.copy}</p>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="demo-page-section" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Implementation depth</p>
        <h2 class="tone-section-title">
          Useful in the room today, and useful to the build team after the
          meeting.
        </h2>
      </div>

      <div class="demo-delivery-grid">
        <article class="demo-delivery-card tone-panel-soft">
          <div class="demo-track-list">
            {
              implementationTracks.map(track => (
                <div class="demo-track-item">
                  <h3>{track.title}</h3>
                  <p>{track.copy}</p>
                </div>
              ))
            }
          </div>
        </article>

        <article class="demo-delivery-card tone-panel-soft">
          <p class="demo-page-panel__label">Featured review presets</p>
          <div class="demo-product-preset-list">
            {
              featuredProducts.map(item => (
                <button
                  type="button"
                  class="demo-product-preset"
                  data-demo-launch={
                    item.state === 'compare'
                      ? 'open-compare'
                      : item.state === 'quickview'
                        ? 'open-quick-view'
                        : 'start-checkout'
                  }
                  data-demo-state={item.state}
                  data-demo-product={item.productId}
                >
                  <strong>{item.title}</strong>
                  <span>{item.note}</span>
                </button>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="demo-page-section" data-page-section>
    <div class="premium-container">
      <div class="demo-console-grid">
        <article class="demo-console-card tone-panel-soft">
          <h2>Safety console</h2>
          <p>
            Review with motion, pause, and performance controls visible so the
            lab can serve both creative critique and practical stakeholder
            walkthroughs.
          </p>
          <div class="demo-console-actions">
            <button
              type="button"
              class="demo-toggle-button"
              data-demo-toggle="paused"
            >
              Toggle pause
            </button>
            <button
              type="button"
              class="demo-toggle-button"
              data-demo-toggle="reduced"
            >
              Toggle reduced motion
            </button>
            <button
              type="button"
              class="demo-toggle-button"
              data-demo-toggle="perf"
            >
              Toggle perf mode
            </button>
          </div>
          <p class="demo-console-status" data-testid="demo-safety-status">
            pause off • reduced motion off • perf mode off
          </p>
        </article>

        <article class="demo-console-card tone-panel-soft">
          <div class="demo-live-header">
            <div>
              <p class="tone-section-kicker">Live storefront</p>
              <h2>Use the real interactions, not a slideshow.</h2>
            </div>
            <p>
              Search, quick view, compare, cart, and checkout are all wired into
              the live demo below.
            </p>
          </div>

          <div
            class="demo-live-shell"
            id="shop-experience"
            data-demo-module="ecommerce-showcase"
          >
            <EcommerceShowcase client:only="preact" />
          </div>
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const anchor = '#shop-experience';
    const demoStates = {
      default: {
        title: 'Baseline commerce view loaded',
        focus: 'Storefront overview',
        audience: 'Stakeholder walkthroughs',
        proof:
          'The baseline commerce view gives the room a clean starting point before drilling into a buyer task.',
      },
      cart: {
        title: 'Cart review active',
        focus: 'Cart confidence',
        audience: 'Conversion reviews',
        proof:
          'Cart details stay easy to scan while totals, shipping, and next actions remain visible.',
      },
      compare: {
        title: 'Compare review active',
        focus: 'Decision support',
        audience: 'Buying team approvals',
        proof:
          'Comparison states stay easy to scan when the decision moment gets busy.',
      },
      quickview: {
        title: 'Quick view review active',
        focus: 'Product storytelling',
        audience: 'Merchandising reviews',
        proof:
          'Quick view keeps product context visible without forcing the audience out of the browse flow.',
      },
      checkout: {
        title: 'Checkout review active',
        focus: 'Checkout reassurance',
        audience: 'Revenue ops handoff',
        proof:
          'Shipping details, payment steps, and order confidence surface without breaking the buyer rhythm.',
      },
    };

    const commandStateMap = {
      'open-cart': 'cart',
      'open-compare': 'compare',
      'open-quick-view': 'quickview',
      'start-checkout': 'checkout',
    };

    const commandActionMap = {
      cart: 'open-cart',
      compare: 'open-compare',
      quickview: 'open-quick-view',
      checkout: 'start-checkout',
    };

    const initDemoPage = () => {
      const html = document.documentElement;
      const activeState = document.querySelector('[data-demo-active-state]');
      const focusMetric = document.querySelector('[data-demo-metric-focus]');
      const audienceMetric = document.querySelector(
        '[data-demo-metric-audience]'
      );
      const proofMetric = document.querySelector('[data-demo-metric-proof]');
      const shareTitle = document.querySelector('[data-demo-share-title]');
      const shareUrl = document.querySelector('[data-demo-share-url]');
      const copyLink = document.querySelector('[data-demo-copy-link]');
      const nativeShare = document.querySelector('[data-demo-native-share]');
      const resetButton = document.querySelector('[data-demo-reset]');
      const commandButtons = Array.from(
        document.querySelectorAll('[data-demo-command], [data-demo-launch]')
      );
      const toggleButtons = Array.from(
        document.querySelectorAll('[data-demo-toggle]')
      );
      const status = document.querySelector(
        '[data-testid="demo-safety-status"]'
      );
      const sharePlatformButtons = Array.from(
        document.querySelectorAll('[data-demo-share-platform]')
      );

      if (
        !(html instanceof HTMLElement) ||
        !(activeState instanceof HTMLElement)
      ) {
        return;
      }

      if (html.dataset.demoPageBound === 'true') {
        return;
      }

      html.dataset.demoPageBound = 'true';

      const readStateFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const demo = params.get('demo') || 'default';
        return demo in demoStates ? demo : 'default';
      };

      const buildShareUrl = state => {
        const url = new URL(window.location.href);
        if (state === 'default') {
          url.searchParams.delete('demo');
          url.searchParams.delete('product');
        }

        url.hash = 'shop-experience';
        return `${url.pathname}${url.search}${url.hash}`;
      };

      const dispatchDemoCommand = (action, productId) => {
        const detail = {
          action,
          productId: productId || undefined,
        };

        window.__pendingDemoCommand = detail;
        window.dispatchEvent(new CustomEvent('demo:ecom-command', { detail }));
      };

      const scrollProofBoardIntoView = () => {
        if (window.location.hash !== anchor) return;

        const shortcutButton = document.querySelector(
          '[data-ecom="review-shortcut-discovery"]'
        );
        const reviewBoard = document.querySelector(
          '[data-ecom="review-board"]'
        );
        const fallbackTarget = document.querySelector(anchor);
        const target =
          shortcutButton instanceof HTMLElement
            ? shortcutButton
            : reviewBoard instanceof HTMLElement
              ? reviewBoard
              : fallbackTarget instanceof HTMLElement
                ? fallbackTarget
                : null;

        target?.scrollIntoView({ behavior: 'auto', block: 'center' });
      };

      const syncSafetyStatus = () => {
        const paused = html.getAttribute('data-demo-paused') === 'true';
        const reduced =
          html.getAttribute('data-demo-reduced-motion') === 'true';
        const perf = html.getAttribute('data-demo-perf') === 'true';

        if (status instanceof HTMLElement) {
          status.textContent = `pause ${paused ? 'on' : 'off'} • reduced motion ${reduced ? 'on' : 'off'} • perf mode ${perf ? 'on' : 'off'}`;
        }
      };

      const syncBoard = state => {
        const current = demoStates[state] || demoStates.default;
        const url = buildShareUrl(state);

        activeState.textContent = current.title;
        if (focusMetric instanceof HTMLElement)
          focusMetric.textContent = current.focus;
        if (audienceMetric instanceof HTMLElement)
          audienceMetric.textContent = current.audience;
        if (proofMetric instanceof HTMLElement)
          proofMetric.textContent = current.proof;
        if (shareTitle instanceof HTMLElement)
          shareTitle.textContent = current.title;
        if (shareUrl instanceof HTMLElement) shareUrl.textContent = url;
      };

      const setLaunchState = (state, productId) => {
        const nextUrl = new URL(window.location.href);

        if (state === 'default') {
          nextUrl.searchParams.delete('demo');
          nextUrl.searchParams.delete('product');
        } else {
          nextUrl.searchParams.set('demo', state);
          if (productId) {
            nextUrl.searchParams.set('product', productId);
          } else {
            nextUrl.searchParams.delete('product');
          }
        }

        nextUrl.hash = 'shop-experience';
        window.history.replaceState({}, '', nextUrl.toString());
        syncBoard(state);
      };

      commandButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const state = button.dataset.demoState || 'default';
          const action =
            button.dataset.demoCommand ||
            button.dataset.demoLaunch ||
            commandActionMap[state];
          const productId = button.dataset.demoProduct || '';

          setLaunchState(state, productId);
          dispatchDemoCommand(action, productId);

          const section = document.querySelector(anchor);
          if (section instanceof HTMLElement) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }

          window.setTimeout(scrollProofBoardIntoView, 120);
        });
      });

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener('click', () => {
          setLaunchState('default');
        });
      }

      toggleButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const type = button.dataset.demoToggle;
          if (!type) return;

          const attrName =
            type === 'reduced'
              ? 'data-demo-reduced-motion'
              : type === 'perf'
                ? 'data-demo-perf'
                : 'data-demo-paused';

          const current = html.getAttribute(attrName) === 'true';
          html.setAttribute(attrName, String(!current));
          syncSafetyStatus();
        });
      });

      if (copyLink instanceof HTMLButtonElement) {
        copyLink.addEventListener('click', async () => {
          const state = readStateFromUrl();
          const currentUrl = `${window.location.origin}${buildShareUrl(state)}`;
          try {
            await navigator.clipboard.writeText(currentUrl);
            copyLink.textContent = 'Copied';
          } catch {
            copyLink.textContent = 'Unavailable';
          }
          window.setTimeout(() => {
            copyLink.textContent = 'Copy launch link';
          }, 1200);
        });
      }

      if (nativeShare instanceof HTMLButtonElement) {
        nativeShare.addEventListener('click', async () => {
          const state = readStateFromUrl();
          const current = demoStates[state] || demoStates.default;
          const currentUrl = `${window.location.origin}${buildShareUrl(state)}`;
          if (navigator.share) {
            try {
              await navigator.share({ title: current.title, url: currentUrl });
            } catch {
              // ignore cancelled shares
            }
          }
        });
      }

      sharePlatformButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const state = readStateFromUrl();
          const current = demoStates[state] || demoStates.default;
          const currentUrl = `${window.location.origin}${buildShareUrl(state)}`;
          const encodedUrl = encodeURIComponent(currentUrl);
          const encodedTitle = encodeURIComponent(current.title);
          const platform = button.dataset.demoSharePlatform;

          const targetUrl =
            platform === 'email'
              ? `mailto:?subject=${encodedTitle}&body=${encodedUrl}`
              : platform === 'linkedin'
                ? `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`
                : `https://x.com/intent/post?text=${encodedTitle}%20${encodedUrl}`;

          window.open(targetUrl, '_blank', 'noopener,noreferrer');
        });
      });

      window.addEventListener('popstate', () => {
        syncBoard(readStateFromUrl());
      });

      window.addEventListener('demo:ecom-ready', scrollProofBoardIntoView);

      syncSafetyStatus();
      syncBoard(readStateFromUrl());
      window.setTimeout(scrollProofBoardIntoView, 120);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDemoPage, {
        once: true,
      });
    } else {
      initDemoPage();
    }

    document.addEventListener('astro:page-load', initDemoPage);
  })();
</script>

<style is:inline>
  .demo-page-hero,
  .demo-page-section {
    padding: clamp(4.25rem, 8vw, 6.75rem) 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .demo-page-hero {
    padding-top: clamp(5.8rem, 9vw, 7.5rem);
  }

  .demo-page-hero__grid,
  .demo-page-signal-grid,
  .demo-launch-grid,
  .demo-proof-grid,
  .demo-assurance-grid,
  .demo-delivery-grid,
  .demo-console-grid {
    display: grid;
    gap: 1rem;
  }

  .demo-page-hero__panel,
  .demo-launch-card,
  .demo-proof-board,
  .demo-assurance-card,
  .demo-delivery-card,
  .demo-console-card {
    min-width: 0;
    padding: 1.2rem;
    border-radius: 1.5rem;
  }

  .demo-page-panel__label,
  .demo-launch-card__eyebrow,
  .demo-proof-metric p,
