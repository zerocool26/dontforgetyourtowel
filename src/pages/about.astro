---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { demoProducts } from '../data/demo-ecommerce';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const featuredProducts = demoProducts.slice(0, 4);

const collections = [
  {
    name: 'Street Utility',
    items: 'Outerwear • Footwear • Carry',
    note: 'Daily performance pieces designed for movement and durability.',
  },
  {
    name: 'Studio Minimal',
    items: 'Deskware • Home • Work Essentials',
    note: 'Clean forms and tactile finishes for focused creative environments.',
  },
  {
    name: 'Launch Week',
    items: 'Limited Drops',
    note: 'Small-batch releases with elevated materials and seasonal palettes.',
  },
];

const checkoutSteps = [
  'Add products and auto-calculate subtotal',
  'Apply shipping and tax previews instantly',
  'Persist cart state between route transitions',
  'Trigger trust and confirmation states at checkout',
];

const formatPrice = (priceCents: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(priceCents / 100);

const demoTotal = featuredProducts.reduce(
  (sum, product) => sum + product.priceCents,
  0
);
const supportHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('E-commerce demo request')}`;
---

<MarketingLayout
  title="Portfolio | E-Commerce Demo Experience"
  description="Interactive portfolio route rebuilt as a modern e-commerce demo setup with product storytelling, merchandising, and checkout flow previews."
>
  <div class="creative-page">
    <section class="relative overflow-hidden bg-zinc-950" data-reveal>
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(34,211,238,0.24),_transparent_52%)]"
      >
      </div>
      <div class="mx-auto max-w-[1220px] px-6 pb-16 pt-28">
        <div
          class="creative-hero-shell grid gap-8 p-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center"
        >
          <div class="space-y-6">
            <span class="creative-kicker">Portfolio • Demo Commerce Build</span>
            <h1
              class="creative-title text-4xl font-bold text-white sm:text-5xl"
            >
              E-commerce demo setup,
              <span class="text-accent-300">
                rebuilt as a live portfolio experience.</span
              >
            </h1>
            <p class="creative-copy text-base">
              This page now behaves like a modern storefront showcase: product
              merchandising, collection framing, pricing hierarchy, and
              checkout-preview flow—all tuned for design quality and conversion
              clarity.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
                className="min-h-[48px]"
              >
                Request this build
              </ModernButton>
              <ModernButton
                href={supportHref}
                variant="secondary"
                className="min-h-[48px]"
              >
                Ask for stack details
              </ModernButton>
            </div>
          </div>

          <ModernCard variant="minimal" className="creative-panel p-6">
            <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">
              Demo Basket
            </p>
            <p class="mt-2 text-3xl font-semibold text-white">
              {formatPrice(demoTotal)}
            </p>
            <p class="mt-2 text-sm text-zinc-300">
              {featuredProducts.length} featured products staged in cart preview.
            </p>
            <ul class="mt-4 space-y-2 text-sm text-zinc-300">
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-accent-400"
                ></span>
                <span>Real merchandising cadence</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-accent-400"
                ></span>
                <span>Trust and delivery messaging built-in</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-accent-400"
                ></span>
                <span>Conversion-focused UI hierarchy</span>
              </li>
            </ul>
          </ModernCard>
        </div>
      </div>
    </section>

    <section class="border-y border-white/5 bg-zinc-900/25" data-reveal>
      <div class="mx-auto max-w-[1220px] px-6 py-16">
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span class="creative-kicker">Collections</span>
          {
            collections.map(collection => (
              <span class="creative-chip">{collection.name}</span>
            ))
          }
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {
            collections.map(collection => (
              <ModernCard variant="minimal" className="creative-panel p-6">
                <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">
                  {collection.items}
                </p>
                <h2 class="mt-2 text-xl font-semibold text-white">
                  {collection.name}
                </h2>
                <p class="mt-3 text-sm text-zinc-300">{collection.note}</p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-zinc-950" data-reveal>
      <div class="mx-auto max-w-[1220px] px-6 py-20">
        <div class="max-w-3xl space-y-4">
          <h2 class="creative-title text-3xl font-semibold text-white">
            Featured products
          </h2>
          <p class="creative-copy text-sm">
            Product cards include image hierarchy, pricing context, ratings, and
            category tags to simulate a production merch layer.
          </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {
            featuredProducts.map(product => (
              <ModernCard
                variant="minimal"
                className="creative-panel overflow-hidden p-0"
              >
                <div class="aspect-[4/3] overflow-hidden border-b border-white/10 bg-black/30">
                  <img
                    src={product.images[0]}
                    alt={product.name}
                    class="h-full w-full object-cover transition duration-500 hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="space-y-3 p-5">
                  <p class="text-xs uppercase tracking-[0.18em] text-zinc-500">
                    {product.brand}
                  </p>
                  <h3 class="text-base font-semibold text-white">
                    {product.name}
                  </h3>
                  <p class="line-clamp-2 text-sm text-zinc-300">
                    {product.description}
                  </p>
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-lg font-semibold text-white">
                      {formatPrice(product.priceCents)}
                    </p>
                    {product.compareAtCents ? (
                      <p class="text-sm text-zinc-500 line-through">
                        {formatPrice(product.compareAtCents)}
                      </p>
                    ) : null}
                  </div>
                  <p class="text-xs text-zinc-400">
                    ★ {product.rating.toFixed(1)} · {product.reviewCount}{' '}
                    reviews
                  </p>
                  <ModernButton
                    href={withBasePath('contact-hq/')}
                    variant="secondary"
                    className="min-h-[44px] w-full"
                  >
                    Add to demo cart
                  </ModernButton>
                </div>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-y border-white/5 bg-zinc-900/30" data-reveal>
      <div
        class="mx-auto grid max-w-[1220px] gap-8 px-6 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-start"
      >
        <div class="space-y-4">
          <h2 class="creative-title text-3xl font-semibold text-white">
            Checkout experience preview
          </h2>
          <p class="creative-copy text-sm">
            The flow is structured to reduce friction: clear totals, confidence
            cues, and progressive handoff to order confirmation.
          </p>
          <ul class="mt-5 space-y-3 text-sm text-zinc-300">
            {
              checkoutSteps.map(step => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-violet-400" />
                  <span>{step}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <ModernCard variant="minimal" className="creative-panel p-6">
          <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">
            Order Summary
          </p>
          <div class="mt-4 space-y-2 text-sm text-zinc-300">
            <div class="flex items-center justify-between">
              <span>Subtotal</span><span>{formatPrice(demoTotal)}</span>
            </div>
            <div class="flex items-center justify-between">
              <span>Shipping</span><span>{formatPrice(1200)}</span>
            </div>
            <div class="flex items-center justify-between">
              <span>Estimated Tax</span><span>{formatPrice(980)}</span>
            </div>
            <div
              class="mt-3 flex items-center justify-between border-t border-white/10 pt-3 text-base font-semibold text-white"
            >
              <span>Total</span>
              <span>{formatPrice(demoTotal + 1200 + 980)}</span>
            </div>
          </div>
          <div class="mt-5 flex flex-col gap-3">
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="primary"
              className="min-h-[48px] w-full"
            >
              Start demo checkout
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="outline"
              className="min-h-[48px] w-full"
            >
              See implementation services
            </ModernButton>
          </div>
        </ModernCard>
      </div>
    </section>
  </div>
</MarketingLayout>
