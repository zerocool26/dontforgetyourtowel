---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import EcommerceShowcase from '../components/demo-lab/EcommerceShowcase';
import { demoProducts } from '../data/demo-ecommerce';
import { servicesExtended } from '../data/services-extended';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const supportHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Proof lab walkthrough request')}`;

const proofSignals = [
  {
    label: 'Prototype states',
    value: String(demoProducts.length),
    detail: 'Real product, cart, review, and checkout states.',
  },
  {
    label: 'Review paths',
    value: '4',
    detail: 'Cart, compare, quick view, and checkout.',
  },
  {
    label: 'Safety controls',
    value: '3',
    detail: 'Pause, reduced motion, and perf mode.',
  },
];

const proofPoints = [
  {
    title: 'Presentation that can actually sell',
    copy: 'The route shows what a premium buyer-facing experience feels like when it still has structure, hierarchy, and restraint.',
  },
  {
    title: 'Real decision points, not just nicer visuals',
    copy: 'Cart states, comparison paths, quick views, and checkout framing help buyers review real decision points.',
  },
  {
    title: 'Production discipline underneath',
    copy: 'The demo still respects device constraints, accessibility controls, and implementation depth.',
  },
];

const quickActions = [
  {
    label: 'Open cart',
    command: 'open-cart',
    demoParam: 'cart',
    note: 'Check drawer layout, promo handling, and persistence.',
    reviewPath:
      'Buyer reviews basket clarity, savings, and friction before checkout.',
    focus: 'Basket clarity',
    audience: 'Sales demos and buyer review calls',
    proof:
      'Promo logic, quantity changes, and cart persistence feel deliberate on mobile.',
  },
  {
    label: 'Open compare',
    command: 'open-compare',
    demoParam: 'compare',
    note: 'Review selection logic and side-by-side merchandising.',
    reviewPath:
      'Stakeholders compare product density, decision support, and mobile scanability.',
    focus: 'Decision support',
    audience: 'Stakeholder workshops and product strategy reviews',
    proof:
      'Comparison states stay easy to scan without collapsing into desktop-only patterns.',
  },
  {
    label: 'Quick view',
    command: 'open-quick-view',
    demoParam: 'quickview',
    productId: 'spectral-sneaker',
    note: 'See detail density without forcing a full product-page jump.',
    reviewPath:
      'Teams inspect the product-detail layer without losing catalog context.',
    focus: 'Product storytelling',
    audience: 'Merchandising reviews and mobile UX audits',
    proof:
      'Product details, variants, and imagery stay rich without creating route churn.',
  },
  {
    label: 'Jump to checkout',
    command: 'start-checkout',
    demoParam: 'checkout',
    productId: 'aurora-hoodie',
    note: 'Validate the final conversion path and friction points fast.',
    reviewPath:
      'Leadership reviews the handoff from product discovery into a credible checkout flow.',
    focus: 'Conversion handoff',
    audience: 'Leadership reviews and launch readiness checks',
    proof:
      'Checkout steps, shipping decisions, and confidence cues read like a shippable flow.',
  },
];

const guidedReviewSteps = [
  {
    title: 'Start from the buyer question',
    copy: 'Pick cart, compare, quick view, or checkout first so the review begins with a real business moment.',
  },
  {
    title: 'Judge it on a phone',
    copy: 'The point is to test density, clarity, and confidence on mobile instead of approving a desktop-only concept.',
  },
  {
    title: 'Turn taste into a build plan',
    copy: 'Use the linked implementation tracks to move from “this feels right” into real delivery scope.',
  },
];

const implementationTracks = servicesExtended.filter(service =>
  [
    'client-portal-web-refresh',
    'client-portal-intranet',
    'workflow-automation-ai-enablement',
    'qa-release-hardening',
    'discovery-roadmapping',
  ].includes(service.id)
);

const featuredProducts = demoProducts
  .filter(product => product.featured)
  .slice(0, 2);
---

<MarketingLayout
  title="Experience Lab | Interactive Buyer-Facing Demo"
  description="Interactive experience lab for premium digital walkthroughs, client-facing system reviews, and buyer-facing product experience exploration."
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
  mainClass="relative isolate overflow-x-clip"
>
  <div class="proof-page">
    <section class="proof-hero" id="proof-hero" data-page-section>
      <div class="premium-container">
        <div class="proof-hero__shell">
          <div class="proof-hero__copy">
            <p class="proof-eyebrow">Experience lab</p>
            <h1 class="proof-title">
              Show the buyer-facing experience
              <span>and the implementation discipline</span>
              <span>in the same route.</span>
            </h1>
            <p class="proof-copy">
              This page is built to prove stronger mobile UX, cleaner decision
              support, and premium digital presentation without drifting into
              empty demo theater.
            </p>

            <div class="proof-actions">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
                className="min-h-[52px]"
              >
                Request an experience-led build
              </ModernButton>
              <ModernButton
                href={supportHref}
                variant="outline"
                className="min-h-[52px]"
              >
                Ask for the walkthrough
              </ModernButton>
            </div>
          </div>

          <div class="proof-signal-list">
            {
              proofSignals.map(signal => (
                <div class="proof-signal">
                  <p class="proof-signal__label">{signal.label}</p>
                  <p class="proof-signal__value">{signal.value}</p>
                  <p class="proof-signal__detail">{signal.detail}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="proof-section" id="proof-review" data-page-section>
      <div class="premium-container">
        <div class="proof-section__intro">
          <p class="proof-eyebrow">Launch review paths</p>
          <h2 class="proof-section__title">
            Open the exact scenario you want a stakeholder to judge.
          </h2>
          <p class="proof-section__copy">
            The route is simpler when the review starts with a clear question:
            basket clarity, product comparison, product storytelling, or the
            conversion handoff.
          </p>
        </div>

        <div class="proof-launch-grid">
          {
            quickActions.map(action => (
              <button
                type="button"
                class="demo-launch proof-launch"
                data-demo-command={action.command}
                data-demo-param={action.demoParam}
                data-demo-product={action.productId}
                data-demo-label={action.label}
                aria-pressed="false"
              >
                <span class="proof-launch__title">{action.label}</span>
                <span class="proof-launch__copy">{action.note}</span>
              </button>
            ))
          }
        </div>

        <div class="proof-review-shell">
          <div class="proof-review-state">
            <p class="proof-review-state__label">Active review path</p>
            <p class="proof-review-state__title" data-demo-active-state>
              Default showcase loaded.
            </p>
            <p class="proof-review-state__copy" data-demo-active-copy>
              Choose a launch scenario to turn this proof route into a shareable
              customer review path.
            </p>
          </div>

          <div class="proof-review-metrics">
            <div class="demo-token-card proof-token-card">
              <p class="proof-token-card__label">Focus</p>
              <p class="proof-token-card__value" data-demo-metric-focus>
                Mobile walkthrough
              </p>
            </div>
            <div class="demo-token-card proof-token-card">
              <p class="proof-token-card__label">Best for</p>
              <p class="proof-token-card__value" data-demo-metric-audience>
                First-call reviews
              </p>
            </div>
            <div class="demo-token-card proof-token-card">
              <p class="proof-token-card__label">Proof</p>
              <p class="proof-token-card__value" data-demo-metric-proof>
                Share a scenario to reveal the strongest proof point.
              </p>
            </div>
          </div>

          <div class="proof-review-share">
            <div
              class="demo-token-card proof-token-card proof-token-card--wide"
            >
              <p class="proof-token-card__label">Shareable URL</p>
              <p class="proof-token-card__copy" data-demo-share-url>
                {withBasePath('about/')}#shop-experience
              </p>
            </div>

            <div class="proof-share-actions">
              <button
                type="button"
                class="demo-link-action proof-inline-action"
                data-demo-copy-link
              >
                Copy launch link
              </button>
              <button
                type="button"
                class="demo-link-action proof-inline-action"
                data-demo-reset-link
              >
                Reset launch state
              </button>
              <button
                type="button"
                class="demo-link-action proof-inline-action"
                data-demo-native-share
              >
                Share or copy link
              </button>
            </div>

            <div
              class="demo-token-card proof-token-card proof-token-card--wide"
            >
              <p class="proof-token-card__label">Share review path</p>
              <p class="proof-token-card__copy" data-demo-share-title>
                Default showcase loaded.
              </p>
              <div
                class="demo-share-platforms proof-share-platforms"
                data-demo-share-platforms
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-section" id="proof-structure" data-page-section>
      <div class="premium-container">
        <div class="proof-grid">
          <div class="proof-column">
            <p class="proof-eyebrow">What this route proves</p>
            <div class="proof-list">
              {
                proofPoints.map(point => (
                  <div class="proof-list__item">
                    <h3>{point.title}</h3>
                    <p>{point.copy}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="proof-column">
            <p class="proof-eyebrow">Review doctrine</p>
            <div class="proof-steps">
              {
                guidedReviewSteps.map((step, index) => (
                  <div class="proof-step">
                    <span>0{index + 1}</span>
                    <div>
                      <h3>{step.title}</h3>
                      <p>{step.copy}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="proof-section" id="proof-delivery" data-page-section>
      <div class="premium-container">
        <div class="proof-section__intro">
          <p class="proof-eyebrow">Implementation depth</p>
          <h2 class="proof-section__title">
            The visual proof maps back to real delivery lanes.
          </h2>
          <p class="proof-section__copy">
            The point is to connect stakeholder taste to actual product, design,
            QA, and rollout work.
          </p>
        </div>

        <div class="proof-delivery-grid">
          <div class="proof-track-list">
            {
              implementationTracks.map(track => (
                <div class="proof-track">
                  <h3>{track.name}</h3>
                  <p>{track.description}</p>
                </div>
              ))
            }
          </div>

          <div class="proof-product-list">
            {
              featuredProducts.map(product => (
                <div class="proof-product">
                  <div class="proof-product__top">
                    <div>
                      <p class="proof-product__label">Featured product state</p>
                      <h3>{product.name}</h3>
                      <p class="proof-product__brand">{product.brand}</p>
                    </div>
                    <span class="proof-product__price">
                      ${Math.round(product.priceCents / 100)}
                    </span>
                  </div>
                  <p class="proof-product__copy">{product.description}</p>
                  <ul class="proof-product__bullets">
                    {product.bullets.slice(0, 2).map(bullet => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <div class="proof-scenario-links">
          {
            quickActions.map(action => (
              <a
                href={`${withBasePath('about/')}?demo=${action.demoParam}${action.productId ? `&product=${action.productId}` : ''}#shop-experience`}
                class="demo-scenario-link proof-scenario-link"
              >
                <p class="proof-scenario-link__label">Review path</p>
                <h3>{action.label}</h3>
                <p>{action.reviewPath}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="proof-section" id="safety-console" data-page-section>
      <div class="premium-container">
        <div class="proof-console">
          <div>
            <p class="proof-eyebrow">Controls</p>
            <h2 class="proof-section__title proof-section__title--sm">
              Safety console
            </h2>
            <p class="proof-section__copy">
              Pause, reduced motion, and perf mode keep the demo reviewable on
              real devices without killing the underlying functionality.
            </p>
          </div>

          <div class="proof-console__actions">
            <button
              type="button"
              class="demo-toggle demo-console-toggle proof-inline-action"
              data-demo-toggle="paused"
              aria-pressed="false"
            >
              Pause
            </button>
            <button
              type="button"
              class="demo-toggle demo-console-toggle proof-inline-action"
              data-demo-toggle="reduced"
              aria-pressed="false"
            >
              Reduced motion
            </button>
            <button
              type="button"
              class="demo-toggle demo-console-toggle proof-inline-action"
              data-demo-toggle="perf"
              aria-pressed="false"
            >
              Perf mode
            </button>
          </div>

          <p
            class="proof-console__status"
            data-demo-status
            data-testid="demo-safety-status"
          >
            Demo safety status: pause off, reduced motion off, perf mode off.
          </p>
        </div>
      </div>
    </section>

    <section class="proof-demo" id="shop-experience" data-page-section>
      <div class="premium-container">
        <div class="proof-section__intro">
          <p class="proof-eyebrow">Live proof environment</p>
          <h2 class="proof-section__title">
            Review the live experience after the framing is clear.
          </h2>
          <p class="proof-section__copy">
            Once the route is explained properly, the demo reads like a real
            product surface instead of a noisy experiment.
          </p>
        </div>

        <div class="demo-module" data-demo-module="ecommerce-showcase">
          <EcommerceShowcase client:only="preact" />
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<style>
  .proof-page,
  .proof-hero,
  .proof-section,
  .proof-demo {
    position: relative;
  }

  .proof-hero,
  .proof-section,
  .proof-demo {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .proof-hero {
    padding-top: clamp(6rem, 9vw, 7.75rem);
  }

  .proof-hero__shell,
  .proof-grid,
  .proof-delivery-grid {
    display: grid;
    gap: 2rem;
  }

  .proof-hero__copy,
  .proof-section__intro {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
  }

  .proof-eyebrow,
  .proof-signal__label,
  .proof-review-state__label,
  .proof-token-card__label,
  .proof-product__label,
  .proof-scenario-link__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
  }

  .proof-title {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .proof-title span {
    display: block;
  }

  .proof-title span:nth-child(1) {
    color: color-mix(in srgb, var(--color-text-primary) 72%, transparent);
  }

  .proof-title span:last-child {
    color: color-mix(in srgb, var(--color-primary) 80%, white 20%);
  }

  .proof-copy,
  .proof-section__copy,
  .proof-list__item p,
  .proof-step p,
  .proof-track p,
  .proof-product__copy,
  .proof-scenario-link p,
  .proof-launch__copy,
  .proof-review-state__copy {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
    font-size: clamp(1rem, 1.35vw, 1.06rem);
    line-height: 1.7;
  }

  .proof-actions,
  .proof-console__actions,
  .proof-share-actions,
  .proof-share-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .proof-signal-list {
    display: grid;
    gap: 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 68%, transparent);
  }

  .proof-signal,
  .proof-list__item,
  .proof-track,
  .proof-product,
  .proof-console,
  .proof-review-shell {
    padding: 1.25rem 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 66%, transparent);
  }

  .proof-signal__value,
  .proof-review-state__title,
  .proof-token-card__value,
  .proof-list__item h3,
  .proof-step h3,
  .proof-track h3,
  .proof-product h3,
  .proof-scenario-link h3,
  .proof-section__title {
    margin: 0;
    color: var(--color-text-primary);
    font-size: clamp(1.35rem, 3vw, 2.8rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .proof-section__title--sm {
    font-size: clamp(1.3rem, 2vw, 2rem);
  }

  .proof-signal__value {
    margin-top: 0.35rem;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }

  .proof-launch-grid,
  .proof-review-metrics,
  .proof-scenario-links {
    display: grid;
    gap: 1rem;
  }

  .proof-launch {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1rem;
    border-radius: 1rem;
    text-align: left;
  }

  .proof-launch__title {
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 600;
  }

  .proof-review-shell {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .proof-review-state,
  .proof-token-card,
  .proof-scenario-link {
    display: grid;
    gap: 0.45rem;
  }

  .proof-token-card,
  .proof-scenario-link,
  .proof-inline-action,
  .proof-launch {
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
  }

  .proof-token-card {
    padding: 1rem;
    border-radius: 1rem;
  }

  .proof-token-card--wide {
    gap: 0.65rem;
  }

  .proof-token-card__copy,
  .proof-console__status {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: 0.92rem;
    line-height: 1.6;
    word-break: break-word;
  }

  .proof-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 66%, transparent);
  }

  .proof-step span {
    color: color-mix(in srgb, var(--color-text-primary) 36%, transparent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .proof-product__top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .proof-product__brand {
    margin: 0.35rem 0 0;
    color: color-mix(in srgb, var(--color-text-secondary) 82%, transparent);
    font-size: 0.95rem;
  }

  .proof-product__price {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
    color: var(--color-text-primary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .proof-product__bullets {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .proof-product__bullets li {
    position: relative;
    padding-left: 1rem;
    color: color-mix(in srgb, var(--color-text-secondary) 90%, transparent);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .proof-product__bullets li::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 82%, white 18%);
  }

  .proof-scenario-link {
    padding: 1rem;
    border-radius: 1rem;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .proof-scenario-link:hover,
  .proof-launch:hover,
  .proof-inline-action:hover {
    transform: translateX(3px);
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 18%,
      transparent
    );
  }

  .proof-inline-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    border-radius: 999px;
    color: var(--color-text-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .proof-console {
    display: grid;
    gap: 1rem;
  }

  .demo-module {
    content-visibility: auto;
    contain: layout paint style;
    contain-intrinsic-size: 900px;
  }

  .demo-module[data-demo-paused='true'] * {
    animation-play-state: paused !important;
  }

  html[data-demo-reduced-motion='true'] .demo-module *,
  .demo-module[data-demo-reduced-motion='true'] * {
    animation: none !important;
    transition: none !important;
  }

  .proof-share-platforms :global(.share-button) {
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    padding: 0.7rem 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-primary);
  }

  @media (min-width: 960px) {
    .proof-hero__shell,
    .proof-grid,
    .proof-delivery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .proof-signal-list {
      padding-top: 0.5rem;
    }

    .proof-launch-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .proof-review-metrics,
    .proof-scenario-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .proof-review-shell {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
    }
  }

  @media (max-width: 767px) {
    .proof-hero {
      padding-top: calc(5.8rem + env(safe-area-inset-top));
    }

    .proof-title {
      max-width: 100%;
      font-size: clamp(2.5rem, 12vw, 4.4rem);
    }

    .proof-actions,
    .proof-console__actions,
    .proof-share-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  import '../scripts/demo-lab';
  import { announce } from '../utils/a11y';
  import { createShareButtons, share } from '../utils/share';

  const ACTIVE_LABELS = {
    cart: {
      title: 'Cart review active.',
      copy: 'Share this launch when you want buyers to review pricing clarity, savings, and the basket experience first.',
    },
    compare: {
      title: 'Compare review active.',
      copy: 'Share this launch when stakeholders need to inspect product comparison logic and decision support.',
    },
    quickview: {
      title: 'Quick view review active.',
      copy: 'Share this launch when the product-detail layer needs to be assessed without leaving catalog context.',
    },
    checkout: {
      title: 'Checkout review active.',
      copy: 'Share this launch when leadership needs to review the conversion path and final handoff experience.',
    },
    default: {
      title: 'Default showcase loaded.',
      copy: 'Choose a launch scenario to turn this proof route into a shareable customer review path.',
    },
  };

  const REVIEW_CARDS = {
    cart: {
      focus: 'Basket clarity',
      audience: 'Sales demos and buyer review calls',
      proof:
        'Promo logic, quantity changes, and cart persistence feel deliberate on mobile.',
    },
    compare: {
      focus: 'Decision support',
      audience: 'Stakeholder workshops and product strategy reviews',
      proof:
        'Comparison states stay easy to scan without collapsing into desktop-only patterns.',
    },
    quickview: {
      focus: 'Product storytelling',
      audience: 'Merchandising reviews and mobile UX audits',
      proof:
        'Product details, variants, and imagery stay rich without creating route churn.',
    },
    checkout: {
      focus: 'Conversion handoff',
      audience: 'Leadership reviews and launch readiness checks',
      proof:
        'Checkout steps, shipping decisions, and confidence cues read like a shippable flow.',
    },
    default: {
      focus: 'Mobile walkthrough',
      audience: 'First-call reviews',
      proof: 'Share a scenario to reveal the strongest proof point.',
    },
  };

  const globalScope = window as Window & {
    __aboutDemoCleanup?: () => void;
  };

  const initProofLabDemo = () => {
    globalScope.__aboutDemoCleanup?.();

    const cleanups: Array<() => void> = [];
    const commandButtons = Array.from(
      document.querySelectorAll('[data-demo-command]')
    ) as HTMLButtonElement[];
    const activeState = document.querySelector(
      '[data-demo-active-state]'
    ) as HTMLElement | null;
    const activeCopy = document.querySelector(
      '[data-demo-active-copy]'
    ) as HTMLElement | null;
    const activeFocus = document.querySelector(
      '[data-demo-metric-focus]'
    ) as HTMLElement | null;
    const activeAudience = document.querySelector(
      '[data-demo-metric-audience]'
    ) as HTMLElement | null;
    const activeProof = document.querySelector(
      '[data-demo-metric-proof]'
    ) as HTMLElement | null;
    const shareUrl = document.querySelector(
      '[data-demo-share-url]'
    ) as HTMLElement | null;
    const shareTitle = document.querySelector(
      '[data-demo-share-title]'
    ) as HTMLElement | null;
    const copyLinkButton = document.querySelector(
      '[data-demo-copy-link]'
    ) as HTMLButtonElement | null;
    const resetLinkButton = document.querySelector(
      '[data-demo-reset-link]'
    ) as HTMLButtonElement | null;
    const nativeShareButton = document.querySelector(
      '[data-demo-native-share]'
    ) as HTMLButtonElement | null;
    const sharePlatformsHost = document.querySelector(
      '[data-demo-share-platforms]'
    ) as HTMLElement | null;

    let buttonTimer = 0;

    const setTemporaryButtonLabel = (
      button: HTMLButtonElement | null,
      idleText: string,
      nextText: string
    ) => {
      if (!button) return;

      button.textContent = nextText;
      window.clearTimeout(buttonTimer);
      buttonTimer = window.setTimeout(() => {
        button.textContent = idleText;
      }, 1400);
    };

    const getActiveShareData = () => ({
      title: `Proof lab review — ${
        activeState?.textContent?.trim() || 'Olive Global Systems'
      }`,
      text: [activeCopy?.textContent?.trim(), activeProof?.textContent?.trim()]
        .filter(Boolean)
        .join(' '),
      url: window.location.href,
    });

    const syncActiveState = () => {
      const params = new URLSearchParams(window.location.search);
      const rawMode = (params.get('demo') || '').toLowerCase();
      const state =
        ACTIVE_LABELS[rawMode as keyof typeof ACTIVE_LABELS] ||
        ACTIVE_LABELS.default;
      const reviewState =
        REVIEW_CARDS[rawMode as keyof typeof REVIEW_CARDS] ||
        REVIEW_CARDS.default;

      if (activeState) activeState.textContent = state.title;
      if (activeCopy) activeCopy.textContent = state.copy;
      if (activeFocus) activeFocus.textContent = reviewState.focus;
      if (activeAudience) activeAudience.textContent = reviewState.audience;
      if (activeProof) activeProof.textContent = reviewState.proof;
      if (shareUrl) shareUrl.textContent = window.location.href;
      if (shareTitle) shareTitle.textContent = `${state.title} ${state.copy}`;

      commandButtons.forEach(button => {
        const isActive =
          (button.dataset.demoParam || '').toLowerCase() === rawMode;
        button.dataset.active = isActive ? 'true' : 'false';
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    };

    const syncUrlState = (demoParam?: string, productId?: string) => {
      const url = new URL(window.location.href);

      if (!demoParam) {
        url.searchParams.delete('demo');
        url.searchParams.delete('product');
      } else {
        url.searchParams.set('demo', demoParam);
        if (productId) {
          url.searchParams.set('product', productId);
        } else {
          url.searchParams.delete('product');
        }
      }

      url.hash = 'shop-experience';
      window.history.replaceState({}, '', url.toString());
      syncActiveState();
    };

    const scrollToShowcase = () => {
      const demoModule = document.querySelector(
        '[data-demo-module="ecommerce-showcase"]'
      );
      const demoSection = document.getElementById('shop-experience');
      const scrollTarget = demoModule || demoSection;
      if (scrollTarget instanceof HTMLElement) {
        scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    const dispatchDemoCommand = (payload: {
      action:
        | 'open-cart'
        | 'open-compare'
        | 'open-quick-view'
        | 'start-checkout';
      productId?: string;
    }) => {
      window.__pendingDemoCommand = payload;

      window.dispatchEvent(
        new CustomEvent('demo:ecom-command', {
          detail: payload,
        })
      );

      scrollToShowcase();
    };

    const onEcomReady = () => {
      if (!window.__pendingDemoCommand) return;

      window.dispatchEvent(
        new CustomEvent('demo:ecom-command', {
          detail: window.__pendingDemoCommand,
        })
      );
    };

    window.addEventListener('demo:ecom-ready', onEcomReady);
    cleanups.push(() =>
      window.removeEventListener('demo:ecom-ready', onEcomReady)
    );

    commandButtons.forEach(button => {
      const onClick = () => {
        const action = button.dataset.demoCommand;
        if (!action) return;

        syncUrlState(button.dataset.demoParam, button.dataset.demoProduct);

        dispatchDemoCommand({
          action: action as
            | 'open-cart'
            | 'open-compare'
            | 'open-quick-view'
            | 'start-checkout',
          productId: button.dataset.demoProduct,
        });

        announce(`${button.dataset.demoLabel || 'Demo'} scenario ready.`);
      };

      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });

    if (sharePlatformsHost) {
      const destroyShareButtons = createShareButtons(
        sharePlatformsHost,
        getActiveShareData,
        ['linkedin', 'email', 'twitter']
      );
      cleanups.push(() => destroyShareButtons());
    }

    if (nativeShareButton) {
      const onShare = async () => {
        const shared = await share(getActiveShareData(), {
          copySuccessMessage: 'Scenario link copied.',
          onSuccess: () => announce('Review link shared or copied.'),
          onCancel: () => announce('Share dismissed.'),
        });

        setTemporaryButtonLabel(
          nativeShareButton,
          'Share or copy link',
          shared ? 'Link ready' : 'Unavailable'
        );
      };

      nativeShareButton.addEventListener('click', onShare);
      cleanups.push(() =>
        nativeShareButton.removeEventListener('click', onShare)
      );
    }

    if (copyLinkButton) {
      const onCopy = async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          announce('Launch link copied.');
          setTemporaryButtonLabel(copyLinkButton, 'Copy launch link', 'Copied');
        } catch {
          announce('Launch link unavailable for copying.');
          setTemporaryButtonLabel(
            copyLinkButton,
            'Copy launch link',
            'Unavailable'
          );
        }
      };

      copyLinkButton.addEventListener('click', onCopy);
      cleanups.push(() => copyLinkButton.removeEventListener('click', onCopy));
    }

    if (resetLinkButton) {
      const onReset = () => {
        syncUrlState();
        scrollToShowcase();
        announce('Demo launch state reset.');
      };

      resetLinkButton.addEventListener('click', onReset);
      cleanups.push(() =>
        resetLinkButton.removeEventListener('click', onReset)
      );
    }

    syncActiveState();

    globalScope.__aboutDemoCleanup = () => {
      cleanups.forEach(cleanup => cleanup());
      window.clearTimeout(buttonTimer);
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProofLabDemo, {
      once: true,
    });
  } else {
    initProofLabDemo();
  }

  document.addEventListener('astro:page-load', initProofLabDemo);
</script>
