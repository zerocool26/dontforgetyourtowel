---
import { CONTACT_EMAIL } from '../consts';
import PageHero from '../components/PageHero.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Privacy Policy | CHICAGOS #1 MSP"
  description="How CHICAGOS #1 MSP handles information submitted through this website."
>
  <article class="legal-page">
    <PageHero
      title="Privacy"
      accent="Policy"
      copy="Effective August 13, 2026"
      primaryLabel={false}
      compact
    />
    <div class="shell legal-page__body prose">
      <h2>Information you choose to send</h2>
      <p>
        This is a static marketing website. We receive information when you
        contact us by email or use a separately configured scheduling or intake
        service. That information may include your name, company, contact
        details, environment overview, and the business issue you want to
        discuss.
      </p>
      <p>
        Do not send passwords, private keys, recovery codes, regulated records,
        or other sensitive client or system data through the first contact.
      </p>

      <h2>How information is used</h2>
      <p>
        We use the information you provide to respond, evaluate fit, prepare a
        recommendation or scope, coordinate follow-up, and maintain reasonable
        business records. We do not sell personal information.
      </p>

      <h2>Service providers and links</h2>
      <p>
        Email, scheduling, hosting, and other service providers may process
        information according to their own terms and privacy practices. This
        site may also link to third-party websites; their policies apply after
        you leave this site.
      </p>

      <h2>Retention and security</h2>
      <p>
        Business communications are retained only as reasonably needed for the
        conversation, a potential or active engagement, legal obligations, and
        ordinary recordkeeping. No internet transmission or storage system can
        be guaranteed completely secure.
      </p>

      <h2>Your questions</h2>
      <p>
        To ask about information you previously sent, email
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </article>
</MarketingLayout>
