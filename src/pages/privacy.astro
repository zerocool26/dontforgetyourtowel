---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="Privacy Policy | Olive Global Systems"
  description="How Olive Global Systems handles privacy for this static marketing site and project intake communications."
>
  <section class="tone-surface relative overflow-hidden" data-reveal>
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(34,211,238,0.2),_transparent_58%)]"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-6 pb-20 pt-28">
      <span class="creative-kicker">Legal</span>
      <h1
        class="creative-title tone-title mt-6 text-4xl font-semibold sm:text-5xl"
      >
        Privacy Policy
      </h1>
      <p class="tone-body mt-6 text-base">Last updated: February 15, 2026</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={withBasePath('contact-hq/')}
          class="tone-border tone-surface tone-title inline-flex items-center justify-center rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] transition hover:opacity-90"
        >
          Contact HQ
        </a>
        <a
          href={withBasePath('about/?demo=cart#shop-experience')}
          class="tone-border tone-surface tone-title inline-flex items-center justify-center rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] transition hover:opacity-90"
        >
          Open cart demo
        </a>
      </div>
    </div>
  </section>

  <section class="tone-border tone-surface border-y py-16" data-reveal>
    <div class="tone-body mx-auto max-w-4xl space-y-10 px-6">
      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">
          Information We Collect
        </h2>
        <p>
          This website is primarily static. We do not run a custom backend that
          stores visitor profiles or account data. Information is only shared
          when you intentionally contact us by email.
        </p>
      </article>

      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">
          Contact Communications
        </h2>
        <p>
          If you send us an email, your message and sender details are processed
          by your email provider and ours so we can respond. We use that
          information strictly for inquiry handling, project conversations, and
          support communication.
        </p>
      </article>

      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">Third-Party Hosting</h2>
        <p>
          This site is delivered via static hosting. Hosting providers may log
          technical request data (for example IP address, timestamp, and
          user-agent) for reliability and security operations.
        </p>
      </article>

      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">
          Cookies & Local Storage
        </h2>
        <p>
          The site does not use tracking cookies by default. Theme preference
          and similar UI settings may be stored locally in your browser to
          preserve your experience.
        </p>
      </article>

      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">Policy Updates</h2>
        <p>
          We may revise this policy as the site evolves. Any updates appear on
          this page with a revised date.
        </p>
      </article>

      <article class="creative-panel tone-elevated space-y-4 p-6">
        <h2 class="tone-title text-2xl font-semibold">Contact</h2>
        <p>
          Questions about this privacy policy can be sent to
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-accent-300 hover:text-accent-200 hover:underline"
          >
            {CONTACT_EMAIL}
          </a>.
        </p>
      </article>
    </div>
  </section>
</MarketingLayout>
