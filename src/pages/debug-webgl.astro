---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { withBasePath } from '../utils/helpers';

const title = 'WebGL Diagnostics';
const description =
  'Device + browser diagnostics to determine why 3D rendering fails (WebGL, service worker cache, asset paths).';

const homeHref = withBasePath('/');
const servicesHref = withBasePath('services/');
const contactHref = withBasePath('contact-hq/');
---

<MarketingLayout
  title={title}
  description={description}
  mainClass="pb-24 pt-12"
  bodyClass="bg-[#06101d]"
  showStickyCTA={false}
  showLiveChat={false}
>
  <section class="mx-auto w-full max-w-[1240px] px-4 sm:px-6">
    <div class="grid gap-8 pt-16 lg:grid-cols-[1.02fr_0.98fr] lg:items-start">
      <div class="space-y-5">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Support and diagnostics
        </p>
        <h1
          class="max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          WebGL diagnostics for 3D rendering issues.
        </h1>
        <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
          This page runs a safe set of checks to help explain why 3D rendering
          may fail on a device or browser. It looks for WebGL support, asset
          loading, and common interference from cached service-worker state.
        </p>

        <div class="flex flex-col gap-3 sm:flex-row">
          <ModernButton variant="secondary" href={homeHref}>Home</ModernButton>
          <ModernButton variant="secondary" href={servicesHref}
            >Services</ModernButton
          >
          <ModernButton variant="outline" href={contactHref}
            >Contact</ModernButton
          >
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <p
            class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
          >
            What this checks
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Browser graphics support, likely cache interference, and whether key
            deployed assets are reachable.
          </p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <p
            class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
          >
            Best next step
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Run the probes first, then send the results when asking for help so
            the issue can be triaged faster.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3"></div>

    <div
      id="debug-webgl-root"
      class="mt-8 rounded-2xl border border-white/10 bg-black/30 p-5 backdrop-blur"
    >
      <div class="text-sm text-neutral-400">Running probes…</div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <p
          class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
        >
          If you are on mobile
        </p>
        <p class="mt-3 text-sm leading-7 text-slate-300">
          Avoid in-app browsers such as Instagram or TikTok. Open the page in
          Chrome, Edge, or Safari directly for more reliable diagnostics.
        </p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <p
          class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
        >
          When contacting support
        </p>
        <p class="mt-3 text-sm leading-7 text-slate-300">
          Include the device, browser version, what failed visually, and the
          probe results shown on this page.
        </p>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/debug-webgl';
  </script>
</MarketingLayout>
