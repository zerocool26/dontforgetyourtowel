---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import {
  galleryCategories,
  galleryInstallations,
} from '../data/design-gallery';
import { withBasePath } from '../utils/helpers';

const featuredInstallation = galleryInstallations[0];

const gallerySignals = [
  {
    label: 'Installations',
    value: String(galleryInstallations.length),
    detail: 'A curated wall of trade-inspired visual systems.',
  },
  {
    label: 'Trade references',
    value: '7 + platform',
    detail: 'Every major service lane gets its own design language.',
  },
  {
    label: 'View modes',
    value: 'Poster / Salon / Index',
    detail: 'The page can shift from immersive gallery to quick scan.',
  },
];

const galleryPrinciples = [
  {
    title: 'Built from real scope',
    copy: 'The collection uses actual trade logic like sequencing, plantroom geometry, controls flow, balancing, phasing, and diagnostics rather than generic “creative agency” abstractions.',
  },
  {
    title: 'Art direction with boundaries',
    copy: 'Each study stretches visual language without losing professional credibility, which keeps the page premium, strange in the right way, and still usable on mobile.',
  },
  {
    title: 'Tied back to the live site',
    copy: 'Every installation routes into a live trade or platform page so the gallery remains part of the working website instead of becoming a disconnected concept board.',
  },
];

const galleryRoutes = [
  {
    title: 'Trade Directory',
    description:
      'Use the source map when you want all seven divisions in one place.',
    href: withBasePath('trades/'),
  },
  {
    title: 'About The Platform',
    description:
      'Read the broader operating model behind the multi-trade site.',
    href: withBasePath('company/'),
  },
  {
    title: 'Build Studio',
    description:
      'Jump into the retained flagship interactive showroom experience.',
    href: withBasePath('build-studio/#studio'),
  },
];

const pageNavigator = {
  label: 'Gallery Guide',
  accent: featuredInstallation.palette[0],
  items: [
    { id: 'gallery-hero', label: 'Gallery Introduction', shortLabel: 'Intro' },
    { id: 'gallery-wall', label: 'Curatorial Wall', shortLabel: 'Wall' },
    {
      id: 'gallery-doctrine',
      label: 'Gallery Doctrine',
      shortLabel: 'Doctrine',
    },
  ],
};
---

<MarketingLayout
  title="Design Gallery | Olive Global Systems"
  description="Interactive design gallery featuring premium trade-inspired interface, motion, material, and spatial studies tied back to the live seven-trade site."
  bodyClass="creative-page bg-[#02040a]"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  pageNavigator={pageNavigator}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Design Gallery',
      description:
        'Interactive gallery of trade-inspired visual studies tied to the live site architecture.',
    }}
  />
  <StructuredData
    type="breadcrumbs"
    data={{
      items: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL(withBasePath('/'), Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Design Gallery',
          item: new URL(withBasePath('gallery/'), Astro.site).toString(),
        },
      ],
    }}
  />
  <section
    class="relative scroll-mt-32 overflow-hidden pb-14 pt-28"
    data-reveal
    id="gallery-hero"
    data-page-section
  >
    <div class="gallery-ambient"></div>
    <div class="mx-auto max-w-[1440px] px-6">
      <div class="grid gap-8 xl:grid-cols-[1.08fr_0.92fr] xl:items-end">
        <div class="space-y-6">
          <div class="inline-flex flex-wrap gap-2">
            <span class="creative-kicker">Design Gallery</span>
            <span class="creative-chip">Interactive curatorial filters</span>
            <span class="creative-chip">Trade-led art direction</span>
            <span class="creative-chip">Mobile safe</span>
          </div>

          <div class="space-y-5">
            <h1
              class="tone-title max-w-5xl text-5xl !leading-[0.94] tracking-[-0.06em] sm:text-6xl lg:text-7xl xl:text-[5.45rem]"
            >
              A gallery of
              <span class="creative-gradient-text--accent">
                trade-exclusive design worlds
              </span>
              built directly into the site.
            </h1>
            <p class="creative-copy text-white/78 max-w-3xl text-lg sm:text-xl">
              This page is a living exhibition of premium interface, motion,
              material, and spatial ideas. Each installation is rooted in one of
              the live trades or platform systems, so the gallery functions as
              both digital art and a serious demonstration of how far the site
              can go.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href="#gallery-wall"
              variant="gradient"
              className="min-h-[50px]"
            >
              Enter the gallery
            </ModernButton>
            <ModernButton
              href={withBasePath('trades/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Browse trade directory
            </ModernButton>
            <ModernButton
              href={withBasePath('/')}
              variant="outline"
              className="min-h-[50px]"
            >
              Return to landing page
            </ModernButton>
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            {
              gallerySignals.map(signal => (
                <ModernCard variant="minimal" className="creative-panel p-5">
                  <p class="tone-muted text-xs uppercase tracking-[0.26em]">
                    {signal.label}
                  </p>
                  <p class="tone-title mt-2 text-3xl font-semibold">
                    {signal.value}
                  </p>
                  <p class="tone-body mt-2 text-sm">{signal.detail}</p>
                </ModernCard>
              ))
            }
          </div>
        </div>

        <ModernCard
          variant="minimal"
          className="gallery-feature-card overflow-hidden p-0"
        >
          <div
            class="gallery-feature-stage"
            style={`--gallery-accent:${featuredInstallation.palette[0]};--gallery-secondary:${featuredInstallation.palette[1]};--gallery-shadow:${featuredInstallation.palette[2]};`}
          >
            <div class="gallery-feature-stage__mesh"></div>
            <div class="gallery-feature-stage__orb"></div>
            <div class="gallery-feature-stage__plane"></div>
          </div>
          <div class="space-y-4 p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="creative-chip">{featuredInstallation.trade}</span>
              <span class="creative-chip">{featuredInstallation.category}</span>
              <span class="creative-chip">{featuredInstallation.room}</span>
            </div>
            <div>
              <p class="tone-title text-2xl font-semibold">
                {featuredInstallation.title}
              </p>
              <p class="tone-body mt-3 text-sm leading-relaxed">
                {featuredInstallation.summary}
              </p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              {
                featuredInstallation.metrics.map(metric => (
                  <div class="rounded-[1.35rem] border border-white/10 bg-white/[0.03] px-4 py-3">
                    <p class="tone-muted text-[0.68rem] uppercase tracking-[0.24em]">
                      {metric.label}
                    </p>
                    <p class="tone-title mt-2 text-sm font-semibold">
                      {metric.value}
                    </p>
                  </div>
                ))
              }
            </div>
            <ModernButton
              href={featuredInstallation.sourceHref}
              variant="secondary"
              className="min-h-[48px]"
            >
              {featuredInstallation.sourceLabel}
            </ModernButton>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  <section
    class="relative z-20 scroll-mt-32"
    data-reveal
    id="gallery-wall"
    data-page-section
  >
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="creative-hero-shell p-6 sm:p-8">
        <div class="flex flex-col gap-6 border-b border-white/10 pb-6">
          <div class="space-y-3">
            <p class="creative-kicker">Curatorial Controls</p>
            <h2 class="tone-title text-4xl font-semibold tracking-tight">
              Switch the wall between immersive posters, a salon hang, and a
              fast index view.
            </h2>
            <p class="tone-body max-w-3xl text-sm leading-relaxed">
              Filter by design discipline to study one mood at a time or scan
              the full collection. The view modes are lightweight on purpose, so
              the page stays responsive and elegant across desktop and mobile.
            </p>
          </div>

          <div class="grid gap-5 xl:grid-cols-[1fr_auto] xl:items-end">
            <div
              class="flex flex-wrap gap-2"
              aria-label="Filter installations by category"
              data-gallery-filter-group
            >
              <button
                type="button"
                class="gallery-toggle is-active"
                data-gallery-filter="All"
                aria-pressed="true"
              >
                All disciplines
              </button>
              {
                galleryCategories.map(category => (
                  <button
                    type="button"
                    class="gallery-toggle"
                    data-gallery-filter={category}
                    aria-pressed="false"
                  >
                    {category}
                  </button>
                ))
              }
            </div>

            <div
              class="flex flex-wrap gap-2"
              aria-label="Change gallery view"
              data-gallery-view-group
            >
              <button
                type="button"
                class="gallery-toggle is-active"
                data-gallery-view="poster"
                aria-pressed="true"
              >
                Poster
              </button>
              <button
                type="button"
                class="gallery-toggle"
                data-gallery-view="salon"
                aria-pressed="false"
              >
                Salon
              </button>
              <button
                type="button"
                class="gallery-toggle"
                data-gallery-view="index"
                aria-pressed="false"
              >
                Index
              </button>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <span class="creative-chip">Interactive wall</span>
            <span class="creative-chip">Live route integration</span>
            <span class="creative-chip" data-gallery-active-state>
              Poster view • All disciplines
            </span>
            <p class="tone-muted text-sm" data-gallery-count>
              Showing {galleryInstallations.length} installations
            </p>
          </div>
          <div class="gallery-state-bar">
            <div class="gallery-state-bar__copy">
              <p class="tone-title text-sm font-semibold">Curatorial state</p>
              <p class="tone-body text-sm" data-gallery-state-summary>
                All disciplines in poster view.
              </p>
            </div>
            <div class="gallery-state-bar__actions">
              <button
                type="button"
                class="gallery-state-button"
                data-gallery-copy-state
              >
                Copy state link
              </button>
              <button
                type="button"
                class="gallery-state-button"
                data-gallery-reset-state
              >
                Reset wall
              </button>
            </div>
          </div>
        </div>

        <div class="gallery-grid is-poster mt-8" data-gallery-grid>
          {
            galleryInstallations.map(installation => (
              <article
                class={`gallery-card gallery-card--${installation.size}`}
                data-gallery-card
                data-gallery-category={installation.category}
                style={`--gallery-accent:${installation.palette[0]};--gallery-secondary:${installation.palette[1]};--gallery-shadow:${installation.palette[2]};`}
              >
                <div class="gallery-card__poster">
                  <div class="gallery-card__poster-grid" />
                  <div class="gallery-card__poster-orb" />
                  <div class="gallery-card__poster-ribbon" />
                  <div class="gallery-card__poster-chip">
                    {installation.room}
                  </div>
                </div>

                <div class="gallery-card__content">
                  <div class="flex flex-wrap gap-2">
                    <span class="creative-chip">{installation.trade}</span>
                    <span class="creative-chip">{installation.category}</span>
                    <span class="creative-chip">{installation.medium}</span>
                  </div>

                  <div class="space-y-3">
                    <h3 class="tone-title text-2xl font-semibold">
                      {installation.title}
                    </h3>
                    <p class="tone-body text-sm leading-relaxed">
                      {installation.summary}
                    </p>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-2">
                    {installation.metrics.map(metric => (
                      <div class="gallery-card__metric">
                        <p class="tone-muted text-[0.65rem] uppercase tracking-[0.24em]">
                          {metric.label}
                        </p>
                        <p class="tone-title mt-2 text-sm font-semibold">
                          {metric.value}
                        </p>
                      </div>
                    ))}
                  </div>

                  <details class="gallery-card__notes">
                    <summary>Curator note</summary>
                    <p>{installation.curatorNote}</p>
                  </details>

                  <div class="flex flex-wrap gap-2">
                    {installation.tags.map(tag => (
                      <span class="gallery-tag">{tag}</span>
                    ))}
                  </div>

                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="tone-muted text-xs uppercase tracking-[0.24em]">
                      Linked into the live site
                    </p>
                    <ModernButton
                      href={installation.sourceHref}
                      variant="secondary"
                      className="min-h-[46px]"
                    >
                      {installation.sourceLabel}
                    </ModernButton>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="relative z-20 scroll-mt-32"
    data-reveal
    id="gallery-doctrine"
    data-page-section
  >
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="grid gap-5 xl:grid-cols-[0.98fr_1.02fr]">
        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Gallery Doctrine</p>
          <div class="mt-6 space-y-5">
            {
              galleryPrinciples.map((principle, index) => (
                <div class="flex items-start gap-4">
                  <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 font-mono text-xs text-white/70">
                    0{index + 1}
                  </span>
                  <div>
                    <p class="tone-title text-lg font-semibold">
                      {principle.title}
                    </p>
                    <p class="tone-body mt-2 text-sm leading-relaxed">
                      {principle.copy}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </ModernCard>

        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Continue Into The Site</p>
          <div class="mt-6 grid gap-4">
            {
              galleryRoutes.map(route => (
                <a
                  href={route.href}
                  class="gallery-route-card rounded-[1.6rem] border border-white/10 bg-white/[0.03] p-5 transition hover:border-white/20 hover:bg-white/[0.05]"
                >
                  <p class="tone-title text-xl font-semibold">{route.title}</p>
                  <p class="tone-body mt-2 text-sm">{route.description}</p>
                </a>
              ))
            }
          </div>
        </ModernCard>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'olive-gallery-state';
    const FILTER_PARAM = 'discipline';
    const VIEW_PARAM = 'galleryView';

    const initGallery = () => {
      const grid = document.querySelector('[data-gallery-grid]');
      const count = document.querySelector('[data-gallery-count]');
      const activeState = document.querySelector('[data-gallery-active-state]');
      const summary = document.querySelector('[data-gallery-state-summary]');
      const copyButton = document.querySelector('[data-gallery-copy-state]');
      const resetButton = document.querySelector('[data-gallery-reset-state]');
      const filterButtons = Array.from(
        document.querySelectorAll('[data-gallery-filter]')
      );
      const viewButtons = Array.from(
        document.querySelectorAll('[data-gallery-view]')
      );
      const cards = Array.from(
        document.querySelectorAll('[data-gallery-card]')
      );

      if (!(grid instanceof HTMLElement) || !(count instanceof HTMLElement)) {
        return;
      }

      if (grid.dataset.galleryBound === 'true') {
        return;
      }

      grid.dataset.galleryBound = 'true';

      const availableFilters = new Set(
        filterButtons
          .map(button =>
            button instanceof HTMLElement ? button.dataset.galleryFilter : ''
          )
          .filter(Boolean)
      );
      const availableViews = new Set(
        viewButtons
          .map(button =>
            button instanceof HTMLElement ? button.dataset.galleryView : ''
          )
          .filter(Boolean)
      );

      const readStoredState = () => {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch {
          return null;
        }
      };

      const getInitialFilter = () => {
        const params = new URLSearchParams(window.location.search);
        const fromUrl = params.get(FILTER_PARAM) || '';
        const fromStorage = readStoredState()?.filter || '';
        const nextFilter = fromUrl || fromStorage || 'All';
        return availableFilters.has(nextFilter) ? nextFilter : 'All';
      };

      const getInitialView = () => {
        const params = new URLSearchParams(window.location.search);
        const fromUrl = params.get(VIEW_PARAM) || '';
        const fromStorage = readStoredState()?.view || '';
        const nextView = fromUrl || fromStorage || 'poster';
        return availableViews.has(nextView) ? nextView : 'poster';
      };

      let activeFilter = getInitialFilter();
      let activeView = getInitialView();

      const syncControlState = () => {
        filterButtons.forEach(node => {
          if (!(node instanceof HTMLButtonElement)) return;
          const isActive = (node.dataset.galleryFilter ?? '') === activeFilter;
          node.classList.toggle('is-active', isActive);
          node.setAttribute('aria-pressed', String(isActive));
        });

        viewButtons.forEach(node => {
          if (!(node instanceof HTMLButtonElement)) return;
          const isActive = (node.dataset.galleryView ?? '') === activeView;
          node.classList.toggle('is-active', isActive);
          node.setAttribute('aria-pressed', String(isActive));
        });
      };

      const syncUrlAndStorage = () => {
        const nextUrl = new URL(window.location.href);
        if (activeFilter === 'All') {
          nextUrl.searchParams.delete(FILTER_PARAM);
        } else {
          nextUrl.searchParams.set(FILTER_PARAM, activeFilter);
        }

        if (activeView === 'poster') {
          nextUrl.searchParams.delete(VIEW_PARAM);
        } else {
          nextUrl.searchParams.set(VIEW_PARAM, activeView);
        }

        window.history.replaceState({}, '', nextUrl.toString());

        try {
          window.localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({
              filter: activeFilter,
              view: activeView,
            })
          );
        } catch {
          // ignore storage failures
        }
      };

      const render = () => {
        let visibleCount = 0;

        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;

          const category = card.dataset.galleryCategory ?? '';
          const isVisible = activeFilter === 'All' || category === activeFilter;

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        grid.classList.remove('is-poster', 'is-salon', 'is-index');
        grid.classList.add(`is-${activeView}`);
        count.textContent = `Showing ${visibleCount} installation${visibleCount === 1 ? '' : 's'}`;

        const filterLabel =
          activeFilter === 'All' ? 'All disciplines' : activeFilter;
        const viewLabel =
          activeView === 'poster'
            ? 'Poster view'
            : activeView === 'salon'
              ? 'Salon view'
              : 'Index view';

        if (activeState instanceof HTMLElement) {
          activeState.textContent = `${viewLabel} • ${filterLabel}`;
        }

        if (summary instanceof HTMLElement) {
          summary.textContent = `${filterLabel} active in ${viewLabel.toLowerCase()}.`;
        }

        syncControlState();
        syncUrlAndStorage();
      };

      filterButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          activeFilter = button.dataset.galleryFilter ?? 'All';
          render();
        });
      });

      viewButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          activeView = button.dataset.galleryView ?? 'poster';
          render();
        });
      });

      if (copyButton instanceof HTMLButtonElement) {
        copyButton.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyButton.textContent = 'Copied';
          } catch {
            copyButton.textContent = 'Unavailable';
          }

          window.setTimeout(() => {
            copyButton.textContent = 'Copy state link';
          }, 1200);
        });
      }

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener('click', () => {
          activeFilter = 'All';
          activeView = 'poster';
          render();
        });
      }

      render();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery, {
        once: true,
      });
    } else {
      initGallery();
    }

    document.addEventListener('astro:page-load', initGallery);
  })();
</script>

<style is:inline>
  .gallery-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 15% 10%,
        rgba(204, 255, 0, 0.12),
        transparent 26%
      ),
      radial-gradient(
        circle at 88% 14%,
        rgba(118, 194, 255, 0.14),
        transparent 24%
      ),
      linear-gradient(180deg, rgba(2, 4, 10, 0), rgba(2, 4, 10, 0.84));
  }

  .gallery-feature-card {
    background:
      linear-gradient(
        155deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(4, 6, 12, 0.86);
  }

  .gallery-feature-stage {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(
        circle at 24% 18%,
        color-mix(in srgb, var(--gallery-accent) 46%, transparent),
        transparent 26%
      ),
      radial-gradient(
        circle at 78% 26%,
        color-mix(in srgb, var(--gallery-secondary) 42%, transparent),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--gallery-shadow) 82%, black 18%),
        rgba(9, 14, 22, 0.96)
      );
  }

  .gallery-feature-stage__mesh,
  .gallery-feature-stage__orb,
  .gallery-feature-stage__plane {
    position: absolute;
    pointer-events: none;
  }

  .gallery-feature-stage__mesh {
    inset: 10% 8%;
    border-radius: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.82), transparent);
  }

  .gallery-feature-stage__orb {
    top: 18%;
    right: 14%;
    height: 180px;
    width: 180px;
    border-radius: 999px;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(255, 255, 255, 0.95),
      color-mix(in srgb, var(--gallery-accent) 50%, white 50%) 26%,
      transparent 72%
    );
    filter: blur(2px);
    opacity: 0.88;
  }

  .gallery-feature-stage__plane {
    inset: auto 10% 14% 14%;
    height: 92px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--gallery-accent) 0%, transparent),
      color-mix(in srgb, var(--gallery-secondary) 46%, transparent),
      color-mix(in srgb, var(--gallery-accent) 18%, transparent)
    );
    filter: blur(28px);
    opacity: 0.9;
  }

  .gallery-toggle {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
