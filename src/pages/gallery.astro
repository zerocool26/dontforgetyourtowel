---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import {
  galleryCategories,
  galleryInstallations,
} from '../data/design-gallery';
import { withBasePath } from '../utils/helpers';

const featuredInstallation = galleryInstallations[0];
const curatorPicks = galleryInstallations.slice(0, 3);

const gallerySignals = [
  {
    label: 'Installations',
    value: String(galleryInstallations.length),
    detail:
      'Filterable studies tied to service pages, proposal moments, and launch materials.',
  },
  {
    label: 'View modes',
    value: '3',
    detail:
      'Poster, salon, and index views tuned for scanning different moods.',
  },
  {
    label: 'Purpose',
    value: 'Live reference library',
    detail:
      'Visual direction tied back to buyer confidence, support credibility, and mobile scanability.',
  },
];

const galleryPrinciples = [
  {
    title: 'Built from real operating moments',
    copy: 'Every study starts from support, security, infrastructure, delivery, or buyer-facing workflow, not generic interface wallpaper.',
  },
  {
    title: 'Expressive without losing business value',
    copy: 'The work can be vivid and cinematic while still helping a mobile visitor understand trust, action, and ownership.',
  },
  {
    title: 'Connected back to a real use',
    copy: 'Every installation points toward a live page, proposal cue, or buyer moment so the library does not become a detached mood board.',
  },
];

const galleryRoutes = [
  {
    title: 'Solutions Hub',
    description:
      'See where these visual studies translate into managed IT, security, cloud, and workflow messaging.',
    href: withBasePath('services/'),
  },
  {
    title: 'Digital Proof Lab',
    description:
      'Open the lab where visual taste meets product behavior, mobile conversion, and reviewable checkout states.',
    href: withBasePath('about/'),
  },
  {
    title: 'Photo Library',
    description:
      'Switch from conceptual studies to reusable image references for operations, security, infrastructure, and buyer-facing pages.',
    href: withBasePath('photos/'),
  },
  {
    title: 'Contact HQ',
    description:
      'Turn visual direction into scoped work when the page, proposal, or launch path is clear enough to discuss.',
    href: withBasePath('contact-hq/'),
  },
];
---

<MarketingLayout
  title="Design Library | CHICAGOS #1 MSP"
  description="Filterable design reference library of interface, layout, and material studies tied to managed IT, security, commerce, and mobile workflows."
  noIndex={true}
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Design Library',
      description:
        'Interactive library of visual studies tied to the live managed IT site architecture.',
    }}
  />
  <StructuredData
    type="breadcrumbs"
    data={{
      items: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL(withBasePath('/'), Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Design Library',
          item: new URL(withBasePath('gallery/'), Astro.site).toString(),
        },
      ],
    }}
  />

  <section class="gallery-page-hero" id="gallery-hero" data-page-section>
    <div class="premium-container">
      <div class="gallery-page-hero__grid">
        <div class="gallery-page-copy tone-page-header">
          <p class="tone-page-eyebrow">Design library</p>
          <h1 class="tone-page-title">
            A visual reference system for work that has to feel specific fast.
          </h1>
          <p class="tone-page-copy">
            Compare mood, density, motion, and material choices across support,
            security, infrastructure, commerce, and mobile workflows without
            drifting into generic tech wallpaper.
          </p>

          <div class="tone-page-actions">
            <ModernButton
              href="#gallery-wall"
              variant="gradient"
              className="min-h-[52px]"
            >
              Browse studies
            </ModernButton>
            <ModernButton
              href={withBasePath('photos/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Open photo library
            </ModernButton>
          </div>
        </div>

        <div class="gallery-page-feature tone-panel-soft">
          <div
            class="gallery-page-feature__art"
            style={`--gallery-accent:${featuredInstallation.palette[0]};--gallery-secondary:${featuredInstallation.palette[1]};--gallery-shadow:${featuredInstallation.palette[2]};`}
          >
            <span>{featuredInstallation.room}</span>
            <div class="gallery-page-feature__palette">
              {
                featuredInstallation.palette.map(color => (
                  <i style={`background:${color};`} />
                ))
              }
            </div>
          </div>
          <div class="gallery-page-feature__body">
            <p class="gallery-page-feature__label">Featured study</p>
            <h2>{featuredInstallation.title}</h2>
            <p>{featuredInstallation.summary}</p>
            <div class="gallery-page-feature__meta">
              <span>{featuredInstallation.trade}</span>
              <span>{featuredInstallation.category}</span>
              <span>{featuredInstallation.medium}</span>
            </div>
          </div>
        </div>
      </div>

      <div
        class="gallery-page-signal-grid"
        aria-label="Gallery quality signals"
      >
        {
          gallerySignals.map(signal => (
            <article class="gallery-page-signal tone-panel-soft">
              <p class="gallery-page-signal__label">{signal.label}</p>
              <h2>{signal.value}</h2>
              <p>{signal.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery-page-section" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Curator picks</p>
        <h2 class="tone-section-title">Quick studies worth opening first.</h2>
      </div>

      <div class="gallery-page-pick-grid">
        {
          curatorPicks.map(item => (
            <article
              class="gallery-page-pick tone-panel-soft"
              style={`--gallery-accent:${item.palette[0]};--gallery-secondary:${item.palette[1]};--gallery-shadow:${item.palette[2]};`}
            >
              <div class="gallery-page-pick__art" />
              <div class="gallery-page-pick__body">
                <p class="gallery-page-pick__label">{item.category}</p>
                <h3>{item.title}</h3>
                <p>{item.curatorNote}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery-page-section" id="gallery-wall" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Browse studies</p>
        <h2 class="tone-section-title">
          Change the discipline or the scan mode, then move into the linked
          business surface.
        </h2>
        <p class="tone-section-copy">
          Poster view is best for narrative browsing, salon for comparing visual
          direction, and index for a cleaner production-style scan.
        </p>
      </div>

      <div class="gallery-controls">
        <div
          class="gallery-controls__group"
          aria-label="Filter installations by category"
          data-gallery-filter-group
        >
          <button
            type="button"
            class="gallery-toggle is-active"
            data-gallery-filter="All"
            aria-pressed="true"
          >
            All disciplines
          </button>
          {
            galleryCategories.map(category => (
              <button
                type="button"
                class="gallery-toggle"
                data-gallery-filter={category}
                aria-pressed="false"
              >
                {category}
              </button>
            ))
          }
        </div>

        <div
          class="gallery-controls__group"
          aria-label="Change gallery view"
          data-gallery-view-group
        >
          <button
            type="button"
            class="gallery-toggle is-active"
            data-gallery-view="poster"
            aria-pressed="true"
          >
            Poster
          </button>
          <button
            type="button"
            class="gallery-toggle"
            data-gallery-view="salon"
            aria-pressed="false"
          >
            Salon
          </button>
          <button
            type="button"
            class="gallery-toggle"
            data-gallery-view="index"
            aria-pressed="false"
          >
            Index
          </button>
        </div>
      </div>

      <div class="gallery-state-bar tone-panel-soft">
        <div>
          <p class="gallery-state-bar__label">Current wall state</p>
          <p class="gallery-state-bar__value" data-gallery-active-state>
            Poster view • All disciplines
          </p>
          <p class="gallery-state-bar__copy" data-gallery-state-summary>
            All disciplines in poster view.
          </p>
        </div>

        <div class="gallery-state-bar__actions">
          <p class="gallery-state-bar__count" data-gallery-count>
            Showing {galleryInstallations.length} installations
          </p>
          <button
            type="button"
            class="gallery-state-button"
            data-gallery-copy-state
          >
            Copy state link
          </button>
          <button
            type="button"
            class="gallery-state-button"
            data-gallery-reset-state
          >
            Reset wall
          </button>
        </div>
      </div>

      <div class="gallery-grid is-poster" data-gallery-grid>
        {
          galleryInstallations.map(installation => (
            <article
              class={`gallery-card gallery-card--${installation.size}`}
              data-gallery-card
              data-gallery-category={installation.category}
              style={`--gallery-accent:${installation.palette[0]};--gallery-secondary:${installation.palette[1]};--gallery-shadow:${installation.palette[2]};`}
            >
              <div class="gallery-card__art">
                <div class="gallery-card__art-grid" />
                <div class="gallery-card__art-mark">{installation.room}</div>
                <div class="gallery-card__palette">
                  {installation.palette.map(color => (
                    <i style={`background:${color};`} />
                  ))}
                </div>
              </div>

              <div class="gallery-card__body">
                <div class="gallery-card__meta">
                  <span>{installation.trade}</span>
                  <span>{installation.category}</span>
                  <span>{installation.medium}</span>
                </div>

                <div class="gallery-card__copy">
                  <h3>{installation.title}</h3>
                  <p>{installation.summary}</p>
                </div>

                <div class="gallery-card__metrics">
                  {installation.metrics.map(metric => (
                    <div class="gallery-card__metric">
                      <p>{metric.label}</p>
                      <strong>{metric.value}</strong>
                    </div>
                  ))}
                </div>

                <details class="gallery-card__notes">
                  <summary>Curator note</summary>
                  <p>{installation.curatorNote}</p>
                </details>

                <div class="gallery-card__tags">
                  {installation.tags.map(tag => (
                    <span>{tag}</span>
                  ))}
                </div>

                <div class="gallery-card__footer">
                  <p>Linked into the live site</p>
                  <ModernButton
                    href={installation.sourceHref}
                    variant="outline"
                    className="min-h-[46px]"
                  >
                    {installation.sourceLabel}
                  </ModernButton>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="gallery-page-section" id="gallery-doctrine" data-page-section>
    <div class="premium-container">
      <div class="gallery-doctrine-grid">
        <div class="gallery-doctrine-block tone-panel-soft">
          <p class="tone-section-kicker">Why this page exists</p>
          <div class="gallery-doctrine-list">
            {
              galleryPrinciples.map((principle, index) => (
                <div class="gallery-doctrine-item">
                  <span>0{index + 1}</span>
                  <div>
                    <h3>{principle.title}</h3>
                    <p>{principle.copy}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="gallery-doctrine-block tone-panel-soft">
          <p class="tone-section-kicker">Where to go next</p>
          <div class="gallery-route-list">
            {
              galleryRoutes.map(route => (
                <a href={route.href} class="gallery-route-card">
                  <h3>{route.title}</h3>
                  <p>{route.description}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'chicagos-msp-gallery-state';
    const FILTER_PARAM = 'discipline';
    const VIEW_PARAM = 'galleryView';

    const initGallery = () => {
      const grid = document.querySelector('[data-gallery-grid]');
      const count = document.querySelector('[data-gallery-count]');
      const activeState = document.querySelector('[data-gallery-active-state]');
      const summary = document.querySelector('[data-gallery-state-summary]');
      const copyButton = document.querySelector('[data-gallery-copy-state]');
      const resetButton = document.querySelector('[data-gallery-reset-state]');
      const filterButtons = Array.from(
        document.querySelectorAll('[data-gallery-filter]')
      );
      const viewButtons = Array.from(
        document.querySelectorAll('[data-gallery-view]')
      );
      const cards = Array.from(
        document.querySelectorAll('[data-gallery-card]')
      );

      if (!(grid instanceof HTMLElement) || !(count instanceof HTMLElement)) {
        return;
      }

      if (grid.dataset.galleryBound === 'true') {
        return;
      }

      grid.dataset.galleryBound = 'true';

      const availableFilters = new Set(
        filterButtons
          .map(button =>
            button instanceof HTMLElement ? button.dataset.galleryFilter : ''
          )
          .filter(Boolean)
      );
      const availableViews = new Set(
        viewButtons
          .map(button =>
            button instanceof HTMLElement ? button.dataset.galleryView : ''
          )
          .filter(Boolean)
      );

      const readStoredState = () => {
        try {
          const raw = window.localStorage.getItem(STORAGE_KEY);
          return raw ? JSON.parse(raw) : null;
        } catch {
          return null;
        }
      };

      const getInitialFilter = () => {
        const params = new URLSearchParams(window.location.search);
        const fromUrl = params.get(FILTER_PARAM) || '';
        const fromStorage = readStoredState()?.filter || '';
        const nextFilter = fromUrl || fromStorage || 'All';
        return availableFilters.has(nextFilter) ? nextFilter : 'All';
      };

      const getInitialView = () => {
        const params = new URLSearchParams(window.location.search);
        const fromUrl = params.get(VIEW_PARAM) || '';
        const fromStorage = readStoredState()?.view || '';
        const nextView = fromUrl || fromStorage || 'poster';
        return availableViews.has(nextView) ? nextView : 'poster';
      };

      let activeFilter = getInitialFilter();
      let activeView = getInitialView();

      const syncControlState = () => {
        filterButtons.forEach(node => {
          if (!(node instanceof HTMLButtonElement)) return;
          const isActive = (node.dataset.galleryFilter ?? '') === activeFilter;
          node.classList.toggle('is-active', isActive);
          node.setAttribute('aria-pressed', String(isActive));
        });

        viewButtons.forEach(node => {
          if (!(node instanceof HTMLButtonElement)) return;
          const isActive = (node.dataset.galleryView ?? '') === activeView;
          node.classList.toggle('is-active', isActive);
          node.setAttribute('aria-pressed', String(isActive));
        });
      };

      const syncUrlAndStorage = () => {
        const nextUrl = new URL(window.location.href);
        if (activeFilter === 'All') {
          nextUrl.searchParams.delete(FILTER_PARAM);
        } else {
          nextUrl.searchParams.set(FILTER_PARAM, activeFilter);
        }

        if (activeView === 'poster') {
          nextUrl.searchParams.delete(VIEW_PARAM);
        } else {
          nextUrl.searchParams.set(VIEW_PARAM, activeView);
        }

        window.history.replaceState({}, '', nextUrl.toString());

        try {
          window.localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({
              filter: activeFilter,
              view: activeView,
            })
          );
        } catch {
          // ignore storage failures
        }
      };

      const render = () => {
        let visibleCount = 0;

        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;

          const category = card.dataset.galleryCategory ?? '';
          const isVisible = activeFilter === 'All' || category === activeFilter;

          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        grid.classList.remove('is-poster', 'is-salon', 'is-index');
        grid.classList.add(`is-${activeView}`);
        count.textContent = `Showing ${visibleCount} installation${visibleCount === 1 ? '' : 's'}`;

        const filterLabel =
          activeFilter === 'All' ? 'All disciplines' : activeFilter;
        const viewLabel =
          activeView === 'poster'
            ? 'Poster view'
            : activeView === 'salon'
              ? 'Salon view'
              : 'Index view';

        if (activeState instanceof HTMLElement) {
          activeState.textContent = `${viewLabel} • ${filterLabel}`;
        }

        if (summary instanceof HTMLElement) {
          summary.textContent = `${filterLabel} active in ${viewLabel.toLowerCase()}.`;
        }

        syncControlState();
        syncUrlAndStorage();
      };

      filterButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          activeFilter = button.dataset.galleryFilter ?? 'All';
          render();
        });
      });

      viewButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          activeView = button.dataset.galleryView ?? 'poster';
          render();
        });
      });

      if (copyButton instanceof HTMLButtonElement) {
        copyButton.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            copyButton.textContent = 'Copied';
          } catch {
            copyButton.textContent = 'Unavailable';
          }

          window.setTimeout(() => {
            copyButton.textContent = 'Copy state link';
          }, 1200);
        });
      }

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener('click', () => {
          activeFilter = 'All';
          activeView = 'poster';
          render();
        });
      }

      render();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery, {
        once: true,
      });
    } else {
      initGallery();
    }

    document.addEventListener('astro:page-load', initGallery);
  })();
</script>

<style is:inline>
  .gallery-page-hero,
  .gallery-page-section {
    padding: clamp(4.25rem, 8vw, 6.75rem) 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .gallery-page-hero {
    padding-top: clamp(5.8rem, 9vw, 7.6rem);
  }

  .gallery-page-hero__grid,
  .gallery-page-signal-grid,
  .gallery-page-pick-grid,
  .gallery-doctrine-grid,
  .gallery-grid {
    display: grid;
    gap: 1rem;
  }

  .gallery-page-feature,
  .gallery-page-signal,
  .gallery-page-pick,
  .gallery-state-bar,
  .gallery-doctrine-block {
    padding: 1.2rem;
    border-radius: 1.5rem;
  }

  .gallery-page-feature,
  .gallery-page-pick {
    display: grid;
    gap: 1rem;
  }

  .gallery-page-feature__art,
  .gallery-page-pick__art,
  .gallery-card__art {
    position: relative;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background:
      radial-gradient(
        circle at 18% 20%,
        color-mix(in srgb, var(--gallery-accent) 42%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at 82% 26%,
        color-mix(in srgb, var(--gallery-secondary) 38%, transparent),
        transparent 28%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--gallery-shadow) 84%, black 16%),
        rgba(10, 13, 17, 0.96)
      );
  }

  .gallery-page-feature__art {
    min-height: 20rem;
  }

  .gallery-page-pick__art {
    min-height: 10rem;
  }

  .gallery-page-feature__art::before,
  .gallery-page-pick__art::before,
  .gallery-card__art-grid {
    content: '';
    position: absolute;
    inset: 1rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .gallery-page-feature__art span,
  .gallery-card__art-mark {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    padding: 0 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(10, 13, 17, 0.42);
    color: rgba(255, 255, 255, 0.76);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .gallery-page-feature__palette,
  .gallery-card__palette {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: flex;
    gap: 0.45rem;
  }

  .gallery-page-feature__palette i,
  .gallery-card__palette i {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 10px 20px -14px rgba(0, 0, 0, 0.85);
  }

  .gallery-page-feature__label,
  .gallery-page-signal__label,
  .gallery-state-bar__label,
  .gallery-page-pick__label,
  .gallery-card__metric p,
  .gallery-card__footer p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
  }

  .gallery-page-feature h2,
  .gallery-page-signal h2,
  .gallery-page-pick h3,
  .gallery-state-bar__value,
  .gallery-card h3,
  .gallery-doctrine-item h3,
  .gallery-route-card h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-weight: 650;
    line-height: 1.03;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .gallery-page-feature p,
  .gallery-page-signal p,
  .gallery-page-pick p,
  .gallery-state-bar__copy,
  .gallery-card__copy p,
  .gallery-card__notes p,
  .gallery-doctrine-item p,
  .gallery-route-card p {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 96%, transparent);
    line-height: 1.68;
  }

  .gallery-page-feature__meta,
  .gallery-controls,
  .gallery-controls__group,
  .gallery-state-bar__actions,
  .gallery-card__meta,
  .gallery-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .gallery-page-feature__meta span,
  .gallery-card__meta span,
  .gallery-card__tags span,
  .gallery-route-card,
  .gallery-state-button,
  .gallery-toggle {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
  }

  .gallery-page-feature__meta span,
  .gallery-card__meta span,
  .gallery-card__tags span {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border-radius: 999px;
    padding: 0 0.75rem;
    color: color-mix(in srgb, var(--color-text-primary) 78%, transparent);
    font-size: 0.78rem;
  }

  .gallery-controls,
  .gallery-state-bar,
  .gallery-grid,
  .gallery-doctrine-grid,
  .gallery-page-pick-grid {
    margin-top: 1.5rem;
  }

  .gallery-toggle,
  .gallery-state-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
