---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BuildStudioShowcase from '../components/showcase/BuildStudio.tsx';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import {
  engineeringSignals,
  studioPresets,
  studioSurfaces,
} from '../data/build-studio';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="Build Studio | Olive Global Systems"
  description="Configure a flagship digital system in real time: presets, capability modules, launch sequencing, and a live build brief that proves what this codebase can really do."
>
  <section class="tone-surface relative overflow-hidden" data-reveal>
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,_rgba(204,255,0,0.16),_transparent_48%),radial-gradient(circle_at_bottom_left,_rgba(99,102,241,0.22),_transparent_42%)]"
    >
    </div>

    <div class="mx-auto max-w-[1240px] px-6 pb-16 pt-28">
      <div
        class="creative-hero-shell grid gap-10 p-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
      >
        <div class="space-y-6">
          <span class="creative-kicker">Flagship showcase route</span>
          <h1 class="creative-title tone-title text-4xl font-bold sm:text-5xl">
            Build a premium digital system
            <span class="text-[#ccff00]">
              instead of browsing another generic demo.</span
            >
          </h1>
          <p class="creative-copy text-base sm:text-lg">
            This is the interactive showroom for what this codebase can actually
            become at the high end: cinematic interfaces, AI-native workflows,
            diagnostics, pricing intelligence, launch sequencing, and
            stakeholder-ready proof—configured in one live brief.
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href="#studio"
              variant="primary"
              className="min-h-[48px]"
            >
              Jump into Build Studio
            </ModernButton>
            <ModernButton
              href={withBasePath('about/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Open live commerce engine
            </ModernButton>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Presets
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {studioPresets.length}
            </p>
            <p class="tone-body mt-2 text-sm">
              Flagship build directions spanning launch rooms, AI ops, premium
              commerce, and trust-first command centers.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Live surfaces
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {studioSurfaces.length}
            </p>
            <p class="tone-body mt-2 text-sm">
              Existing routes already wired with the patterns this studio can
              amplify into a premium system.
            </p>
          </ModernCard>
          <ModernCard
            variant="minimal"
            className="creative-panel p-5 sm:col-span-2"
          >
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Why this matters
            </p>
            <p class="tone-title mt-2 text-xl font-semibold">
              It proves architecture, product sense, and launch discipline in
              one interaction.
            </p>
            <p class="tone-body mt-2 text-sm">
              Instead of showing isolated widgets, Build Studio demonstrates how
              motion, orchestration, trust, pricing, diagnostics, and buyer flow
              can be composed into a coherent high-end product system.
            </p>
          </ModernCard>
        </div>
      </div>
    </div>
  </section>

  <section
    id="studio"
    class="tone-border tone-surface scroll-mt-28 border-y"
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-6 py-16 sm:py-20">
      <BuildStudioShowcase client:visible />
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 py-16 sm:py-20" data-reveal>
    <div class="max-w-3xl space-y-4">
      <span class="creative-kicker">Engineering proof</span>
      <h2 class="creative-title tone-title text-3xl font-semibold sm:text-4xl">
        What this route proves technically
      </h2>
      <p class="creative-copy text-sm sm:text-base">
        The cool part is not the chrome. It’s how the chrome is backed by
        modular data, deterministic planning logic, client-safe state,
        deployment-safe routing, and validation that keeps the premium feel from
        becoming fragile.
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        engineeringSignals.map(signal => (
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-title text-sm font-semibold">{signal.title}</p>
            <p class="tone-body mt-3 text-sm leading-relaxed">
              {signal.detail}
            </p>
          </ModernCard>
        ))
      }
    </div>
  </section>

  <section class="tone-border tone-surface border-y" data-reveal>
    <div class="mx-auto max-w-[1240px] px-6 py-16 sm:py-20">
      <div class="max-w-3xl space-y-4">
        <span class="creative-kicker">Live surfaces</span>
        <h2
          class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
        >
          Routes already carrying the advanced patterns
        </h2>
        <p class="creative-copy text-sm sm:text-base">
          Build Studio is not vapor. Every recommendation points at a live
          surface in this repo that already demonstrates part of the stack.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          studioSurfaces.map(surface => (
            <ModernCard
              variant="minimal"
              className="creative-panel flex h-full flex-col p-5"
            >
              <p class="tone-title text-lg font-semibold">{surface.title}</p>
              <p class="tone-body mt-3 flex-1 text-sm leading-relaxed">
                {surface.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {surface.tags.slice(0, 3).map(tag => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-300">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={withBasePath(surface.href)}
                class="mt-5 inline-flex items-center text-sm font-semibold text-[#ccff00] hover:underline"
              >
                Open surface →
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
