---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BuildStudioShowcase from '../components/showcase/BuildStudio.tsx';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import {
  engineeringSignals,
  studioPresets,
  studioSurfaces,
} from '../data/build-studio';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="Build Studio | Olive Global Systems"
  description="Interactive planning route for shaping a digital system brief around scope, priorities, rollout pace, and linked live surfaces."
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="relative overflow-hidden border-b border-white/10"
    data-reveal
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,_rgba(215,247,91,0.12),_transparent_48%),radial-gradient(circle_at_bottom_left,_rgba(18,181,166,0.12),_transparent_42%)]"
    >
    </div>

    <div
      class="mx-auto max-w-[1240px] px-4 pb-14 pt-20 sm:px-6 sm:pb-20 sm:pt-28"
    >
      <div
        class="creative-hero-shell grid gap-8 p-5 sm:p-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
      >
        <div class="space-y-6">
          <span class="creative-kicker">Interactive planning route</span>
          <h1 class="creative-title tone-title text-4xl font-bold sm:text-5xl">
            Shape a digital system brief around scope, rollout pace, and buyer
            priorities.
          </h1>
          <p class="creative-copy text-base sm:text-lg">
            Use Build Studio to combine capabilities, compare rollout pace,
            generate a cleaner intake brief, and jump into the live routes that
            already support the system you have in mind.
          </p>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href="#studio"
              variant="primary"
              className="min-h-[48px]"
            >
              Open studio
            </ModernButton>
            <ModernButton
              href={withBasePath('about/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              View portfolio demo
            </ModernButton>
          </div>
        </div>

        <div class="hidden gap-4 md:grid md:grid-cols-2">
          <ModernCard variant="glass" className="p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Presets
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {studioPresets.length}
            </p>
            <p class="tone-body mt-2 text-sm">
              Starting directions for launch, operations, trust, or commerce
              systems.
            </p>
          </ModernCard>
          <ModernCard variant="glass" className="p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Live surfaces
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {studioSurfaces.length}
            </p>
            <p class="tone-body mt-2 text-sm">
              Existing routes already carrying the patterns this planner can
              extend.
            </p>
          </ModernCard>
          <ModernCard variant="glass" className="p-5 sm:col-span-2">
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Why this route matters
            </p>
            <p class="tone-title mt-2 text-xl font-semibold">
              It turns a vague request into a more structured system brief.
            </p>
            <p class="tone-body mt-2 text-sm">
              Instead of showing isolated widgets, it shows how planning,
              capability choices, linked routes, and rollout discipline fit
              together.
            </p>
          </ModernCard>
        </div>
      </div>
    </div>
  </section>

  <section
    id="studio"
    class="scroll-mt-28 border-b border-white/10"
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-14 sm:px-6 sm:py-20">
      <BuildStudioShowcase client:visible />
    </div>
  </section>

  <section
    class="mx-auto max-w-[1240px] px-4 py-14 sm:px-6 sm:py-20"
    data-reveal
  >
    <div class="max-w-3xl space-y-4">
      <span class="creative-kicker">Why this route is useful</span>
      <h2 class="creative-title tone-title text-3xl font-semibold sm:text-4xl">
        What this route proves technically
      </h2>
      <p class="creative-copy text-sm sm:text-base">
        The point is not the chrome. The useful part is the modular data,
        deterministic logic, client-safe state, deployment-safe routing, and
        validation behind it.
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        engineeringSignals.map(signal => (
          <ModernCard variant="glass" className="p-5">
            <p class="tone-title text-sm font-semibold">{signal.title}</p>
            <p class="tone-body mt-3 text-sm leading-relaxed">
              {signal.detail}
            </p>
          </ModernCard>
        ))
      }
    </div>
  </section>

  <section class="border-y border-white/10" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-3xl space-y-4">
        <span class="creative-kicker">Linked routes</span>
        <h2
          class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
        >
          Live routes already supporting parts of the system
        </h2>
        <p class="creative-copy text-sm sm:text-base">
          Every recommendation points at a real route so the studio stays tied
          to working product surfaces instead of imaginary future pages.
        </p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          studioSurfaces.map(surface => (
            <ModernCard variant="glass" className="flex h-full flex-col p-5">
              <p class="tone-title text-lg font-semibold">{surface.title}</p>
              <p class="tone-body mt-3 flex-1 text-sm leading-relaxed">
                {surface.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {surface.tags.slice(0, 3).map(tag => (
                  <span class="tone-chip-neutral rounded-full border px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em]">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={withBasePath(surface.href)}
                class="tone-accent-link mt-5 inline-flex items-center text-sm font-semibold"
              >
                Open route →
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
