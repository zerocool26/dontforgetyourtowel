---
import { CONTACT_EMAIL } from '../consts';
import PageHero from '../components/PageHero.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Website Terms | CHICAGOS #1 MSP"
  description="Terms for using the CHICAGOS #1 MSP website and its informational resources."
>
  <article class="legal-page">
    <PageHero
      title="Website"
      accent="Terms"
      copy="Effective August 13, 2026"
      primaryLabel={false}
      compact
    />
    <div class="shell legal-page__body prose">
      <h2>Informational use</h2>
      <p>
        This website provides general information about technology consulting,
        software engineering, cloud, cybersecurity, managed IT, and related
        services. It is not a substitute for an environment or code review, a
        signed statement of work, advice tailored to your systems, or legal,
        compliance, insurance, or financial advice.
      </p>

      <h2>No service relationship</h2>
      <p>
        Visiting the site or sending an inquiry does not create a client,
        advisory, support, or emergency-response relationship. Services begin
        only under an authorized written agreement.
      </p>

      <h2>Pricing and service descriptions</h2>
      <p>
        Website pricing is directional. Final fees, responsibilities, service
        levels, exclusions, and assumptions are defined in the applicable
        proposal and agreement. Website content may be revised as services and
        operating practices change.
      </p>

      <h2>Acceptable use</h2>
      <p>
        You may use the site for lawful business evaluation and reference. Do
        not attempt to disrupt the site, probe systems without authorization,
        submit harmful content, impersonate another person, or misuse contact
        channels.
      </p>

      <h2>Intellectual property</h2>
      <p>
        Site copy, design, and original materials are owned by or licensed to
        CHICAGOS #1 MSP unless otherwise noted. Ordinary links and brief
        quotations with attribution are permitted; broader reuse requires
        permission.
      </p>

      <h2>Questions</h2>
      <p>
        Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with questions
        about these terms.
      </p>
    </div>
  </article>
</MarketingLayout>
