---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ModernButton from '../../components/ui/ModernButton.astro';
import ModernCard from '../../components/ui/ModernCard.astro';
import ProofOperatingSystem from '../../components/business/ProofOperatingSystem.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import {
  chicagoServicePages,
  type LocalServicePage,
} from '../../data/authority-pages';
import { buildContactHqHref } from '../../utils/contact';
import { withBasePath } from '../../utils/helpers';

export function getStaticPaths() {
  return chicagoServicePages.map(page => ({
    params: { service: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: LocalServicePage };
---

<MarketingLayout
  title={page.seoTitle}
  description={page.description}
  bodyClass="creative-page buyer-reframe chicago-service-reframe"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="service"
    data={{
      name: page.title,
      description: page.description,
      serviceType: page.title,
      areaServed: 'Chicago metropolitan area',
    }}
  />

  <section class="premium-page-section pt-10 sm:pt-14" data-page-section>
    <div class="premium-container">
      <div class="tone-page-header max-w-4xl">
        <p class="tone-page-eyebrow">{page.eyebrow}</p>
        <h1 class="tone-page-title">{page.title}</h1>
        <p class="tone-page-copy">{page.intro}</p>
        <div class="tone-page-actions">
          <ModernButton
            href={buildContactHqHref({
              brief: `I want to discuss ${page.title.toLowerCase()}.`,
            })}
            variant="gradient"
            className="min-h-[52px]"
          >
            Start intake
          </ModernButton>
          <ModernButton
            href={withBasePath('pricing/')}
            variant="outline"
            className="min-h-[52px]"
          >
            Review pricing logic
          </ModernButton>
        </div>
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        <ModernCard className="lg:col-span-1">
          <p class="tone-label">Buyer fit</p>
          <ul class="tone-body mt-4 grid gap-2 pl-5">
            {page.buyerFit.map(item => <li>{item}</li>)}
          </ul>
        </ModernCard>

        <ModernCard className="lg:col-span-1">
          <p class="tone-label">Likely outcomes</p>
          <ul class="tone-body mt-4 grid gap-2 pl-5">
            {page.outcomes.map(item => <li>{item}</li>)}
          </ul>
        </ModernCard>

        <ModernCard className="lg:col-span-1">
          <p class="tone-label">Core deliverables</p>
          <ul class="tone-body mt-4 grid gap-2 pl-5">
            {page.deliverables.map(item => <li>{item}</li>)}
          </ul>
        </ModernCard>
      </div>
    </div>
  </section>

  <ProofOperatingSystem
    compact
    showComparison={false}
    showFit={false}
    eyebrow="Service proof"
    title="The service has to make ownership visible."
    description="A local service page should not just name the category. It should show the evidence a buyer will use to trust the engagement."
  />

  <section class="premium-page-section pb-16 sm:pb-20" data-page-section>
    <div class="premium-container max-w-4xl">
      <FAQAccordion items={page.faqs} />
    </div>
  </section>
</MarketingLayout>
