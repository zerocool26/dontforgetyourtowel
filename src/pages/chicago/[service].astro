---
import CtaBand from '../../components/CtaBand.astro';
import { chicagoServices, processSteps, proofRows } from '../../data/site';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { withBasePath } from '../../utils/helpers';

export function getStaticPaths() {
  return chicagoServices.map(service => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<MarketingLayout
  title={`${service.title} in Chicago | CHICAGOS #1 MSP`}
  description={`${service.summary} for established Chicago-area businesses.`}
>
  <section class="local-detail-hero">
    <div class="shell local-detail-hero__grid">
      <div>
        <a href={withBasePath('chicago/')}>Chicago services</a>
        <h1>{service.title} for Chicago teams.</h1>
        <p>{service.summary}</p>
        <div class="button-row">
          <a
            class="button"
            href={withBasePath(`contact-hq/?topic=${service.slug}`)}
          >
            Discuss this work
          </a>
          <a class="button button--outline" href={withBasePath('services/')}>
            See all services
          </a>
        </div>
      </div>
      <aside>
        <h2>The local standard</h2>
        <p>
          Senior access, intentional on-site coordination, a named delivery
          owner, and decisions written for the business.
        </p>
      </aside>
    </div>
  </section>

  <section class="section proof-section">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>What good ownership should make visible.</h2>
      </div>
      <div class="proof-ledger">
        {
          proofRows.map(row => (
            <div class="proof-ledger__row">
              <span class="index-number">{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="process-band">
    <div class="shell process-band__grid">
      <h2>A practical<br />first phase.</h2>
      <ol>
        {
          processSteps.map(step => (
            <li>
              <>
                <span>{step.number}</span>
                <strong>{step.title}</strong>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading"><h2>Before scope is final.</h2></div>
      <div class="boundary-list">
        <div>
          <span>01</span><p>
            Confirm the outcome, users or customers, systems, data, workflow,
            locations, and coverage expectations.
          </p>
        </div>
        <div>
          <span>02</span><p>
            Review the current owner, provider, software, source, tools,
            contracts, dependencies, and urgent issues.
          </p>
        </div>
        <div>
          <span>03</span><p>
            Separate discovery and delivery from recurring operations,
            onboarding, cleanup, and support.
          </p>
        </div>
        <div>
          <span>04</span><p>
            Agree on the first priorities, decision-makers, and next review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={`Talk through your ${service.title.toLowerCase()} needs.`}
    copy="Bring the business outcome, rough environment, current ownership, and timing. We will identify the right first phase and what still needs discovery."
  />
</MarketingLayout>
