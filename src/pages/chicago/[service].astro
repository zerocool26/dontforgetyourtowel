---
import CtaBand from '../../components/CtaBand.astro';
import MediaInterlude from '../../components/MediaInterlude.astro';
import PageHero from '../../components/PageHero.astro';
import { chicagoServices, processSteps, proofRows } from '../../data/site';
import { localServiceMedia } from '../../data/visuals';
import MarketingLayout from '../../layouts/MarketingLayout.astro';

export function getStaticPaths() {
  return chicagoServices.map(service => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const serviceIndex = chicagoServices.findIndex(
  item => item.slug === service.slug
);
const heroMediaKey =
  localServiceMedia[serviceIndex % localServiceMedia.length] ?? 'riverwalk';
const chapterMediaKey =
  localServiceMedia[(serviceIndex + 1) % localServiceMedia.length] ?? 'loop';
---

<MarketingLayout
  title={`${service.title} in Chicago | CHICAGOS #1 MSP`}
  description={`${service.summary} for established Chicago-area businesses.`}
>
  <PageHero
    title={`${service.title} for`}
    accent="Chicago teams."
    copy={service.summary}
    primaryLabel="Discuss this work"
    primaryHref={`contact-hq/?topic=${service.slug}`}
    secondaryLabel="See all services"
    secondaryHref="services/"
    asideTitle="The local standard"
    asideCopy="Senior access, intentional on-site coordination, a named delivery owner, and decisions written for the business."
    mediaKey={heroMediaKey}
  />

  <section class="section proof-section">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>What good ownership should make visible.</h2>
      </div>
      <div class="proof-ledger">
        {
          proofRows.map(row => (
            <div class="proof-ledger__row">
              <span class="index-number">{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <MediaInterlude
    id="first-phase"
    title="A practical"
    accent="first phase."
    items={processSteps.map(step => ({
      number: step.number,
      title: step.title,
    }))}
    mediaKey={chapterMediaKey}
  />

  <section class="section section--ink">
    <div class="shell split-section split-section--top">
      <div class="section-heading"><h2>Before scope is final.</h2></div>
      <div class="boundary-list">
        <div>
          <span>01</span><p>
            Confirm the outcome, users or customers, systems, data, workflow,
            locations, and coverage expectations.
          </p>
        </div>
        <div>
          <span>02</span><p>
            Review the current owner, provider, software, source, tools,
            contracts, dependencies, and urgent issues.
          </p>
        </div>
        <div>
          <span>03</span><p>
            Separate discovery and delivery from recurring operations,
            onboarding, cleanup, and support.
          </p>
        </div>
        <div>
          <span>04</span><p>
            Agree on the first priorities, decision-makers, and next review.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={`Talk through your ${service.title.toLowerCase()}`}
    accent="needs."
    copy="Bring the business outcome, rough environment, current ownership, and timing. We will identify the right first phase and what still needs discovery."
  />
</MarketingLayout>
