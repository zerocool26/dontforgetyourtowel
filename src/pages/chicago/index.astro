---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ModernButton from '../../components/ui/ModernButton.astro';
import ModernCard from '../../components/ui/ModernCard.astro';
import ProofOperatingSystem from '../../components/business/ProofOperatingSystem.astro';
import { chicagoServicePages } from '../../data/authority-pages';
import { buildContactHqHref } from '../../utils/contact';
import { withBasePath } from '../../utils/helpers';
---

<MarketingLayout
  title="Chicago IT Service Areas | CHICAGOS #1 MSP"
  description="Chicago service pages for managed IT, cybersecurity, Microsoft 365, backup and disaster recovery, and co-managed IT."
  bodyClass="creative-page buyer-reframe chicago-reframe"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Chicago IT service areas',
      description:
        'Chicago-area managed IT, security, Microsoft 365, backup, and co-managed IT service coverage.',
    }}
  />

  <section class="premium-page-section pt-10 sm:pt-14" data-page-section>
    <div class="premium-container">
      <div class="tone-page-header max-w-4xl">
        <p class="tone-page-eyebrow">Chicago IT service areas</p>
        <h1 class="tone-page-title">
          Local IT support for teams that need fewer loose ends.
        </h1>
        <p class="tone-page-copy">
          Get managed IT, cybersecurity, Microsoft 365, backup, and co-managed
          support shaped around the problems Chicago-area companies actually run
          into: recurring tickets, vendor confusion, access risk, and recovery
          doubt.
        </p>
        <div class="tone-page-actions">
          <ModernButton
            href={buildContactHqHref({
              brief:
                'I want to discuss a Chicago managed IT, security, Microsoft 365, backup, or co-managed need.',
            })}
            variant="gradient"
            className="min-h-[52px]"
          >
            Start local intake
          </ModernButton>
          <ModernButton
            href={withBasePath('services/')}
            variant="outline"
            className="min-h-[52px]"
          >
            Review all services
          </ModernButton>
        </div>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          chicagoServicePages.map(page => (
            <ModernCard>
              <p class="tone-label">{page.eyebrow}</p>
              <h2 class="tone-title mt-3 text-2xl">{page.title}</h2>
              <p class="tone-body mt-3">{page.description}</p>
              <ul class="tone-body mt-4 grid gap-2 pl-5">
                {page.outcomes.slice(0, 2).map(item => (
                  <li>{item}</li>
                ))}
              </ul>
              <div class="mt-5">
                <ModernButton href={withBasePath(`chicago/${page.slug}/`)}>
                  Open page
                </ModernButton>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <ProofOperatingSystem
    compact
    eyebrow="Local proof standard"
    title="Local coverage should be practical, not just a service-area claim."
    description="A local provider should explain who owns support, how recovery is reviewed, how access risk is handled, and how pricing scope is shaped for your company."
    ctaHref={buildContactHqHref({
      brief:
        'I want to discuss a Chicago managed IT, security, Microsoft 365, backup, or co-managed need.',
    })}
    ctaLabel="Start local intake"
  />
</MarketingLayout>
