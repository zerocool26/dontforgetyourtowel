---
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { chicagoServices } from '../../data/site';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { withBasePath } from '../../utils/helpers';
---

<MarketingLayout
  title="Chicago Technology Consulting, Software & Managed IT | CHICAGOS #1 MSP"
  description="Technology consulting, custom software, cloud modernization, cybersecurity, managed IT, data, integration, and recovery for Chicago businesses."
>
  <PageHero
    title="Chicago technology without the vendor maze."
    copy="Senior advisory, custom software, cloud, cybersecurity, data, and managed operations through one accountable local delivery model."
    secondaryLabel="Explore software engineering"
    secondaryHref="software/"
    asideTitle="Built for Chicago teams"
    asideCopy="Established organizations across the city and surrounding area that need a decision made, a system built, or critical technology operated properly."
  />

  <section class="section local-service-list">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>Chicago service areas.</h2>
        <p>Choose the lane closest to the outcome you need now.</p>
      </div>
      <div class="route-index__rows">
        {
          chicagoServices.map((service, index) => (
            <a href={withBasePath(`chicago/${service.slug}/`)}>
              <span class="index-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <strong>{service.title}</strong>
              <em>{service.summary}</em>
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ownership-band">
    <div class="shell local-standard">
      <h2>Local should mean accountable.</h2>
      <ol>
        <li>
          <span>01</span><strong>Senior decisions stay accessible</strong>
        </li>
        <li>
          <span>02</span><strong>Delivery has one accountable lead</strong>
        </li>
        <li><span>03</span><strong>On-site work has a clear reason</strong></li>
        <li>
          <span>04</span><strong>The operating path survives launch</strong>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>What we need to understand first.</h2>
      </div>
      <div class="boundary-list">
        <div>
          <span>01</span><p>
            The business outcome, users or customers, systems, workflow, and
            locations involved.
          </p>
        </div>
        <div>
          <span>02</span><p>
            Current software, cloud, provider, internal technology ownership,
            and the handoffs that are failing.
          </p>
        </div>
        <div>
          <span>03</span><p>
            Data, integrations, source, Microsoft 365, network, backup,
            security, and line-of-business dependencies.
          </p>
        </div>
        <div>
          <span>04</span><p>
            Timing, launch windows, urgent risks, contract dates, and leadership
            priorities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</MarketingLayout>
