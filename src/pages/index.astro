---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import OperationalIntelligenceWorkbench from '../components/business/OperationalIntelligenceWorkbench.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { operatingIntelligenceItems } from '../data/operating-intelligence';
import { homeRouteGuideLinks } from '../data/site-navigation';
import { withBasePath } from '../utils/helpers';
import { buildContactHqHref, getContactCalendarHref } from '../utils/contact';

const contactHref = buildContactHqHref({
  brief:
    'I want to scope support ownership, security, Microsoft 365, backup, or a buyer-facing system.',
});
const scheduleHref = getContactCalendarHref();

const workbenchItems = operatingIntelligenceItems.map(item => ({
  ...item,
  ctaHref: withBasePath(item.path),
}));

const heroSignals = [
  {
    label: 'Customer excellence',
    value: 'Issues are owned, prioritized, and followed through.',
    detail:
      'Support should feel calm because status, escalation, and next steps are never hidden.',
  },
  {
    label: 'Real service depth',
    value:
      'The core offer is support, security, Microsoft 365, backup, and network.',
    detail:
      'No vague technology bundle. Each lane has a buyer problem, included work, and proof output.',
  },
  {
    label: 'Business visibility',
    value: 'Leadership gets plain-language proof, not tool noise.',
    detail:
      'Monthly reporting should connect tickets, security, backups, projects, risk, and decisions.',
  },
];

const heroProofPoints = [
  'Fast triage rules set by plan',
  'Named escalation owner for stuck issues',
  'Backup and restore proof reviewed early',
  'Monthly decision summary for leadership',
];

const heroFitCards = [
  {
    label: 'Best fit',
    value: '25-150 user teams',
    detail:
      'Chicago-area firms that need support ownership, security proof, and fewer loose ends.',
  },
  {
    label: 'First review',
    value: 'Users, devices, access, backups',
    detail:
      'The first pass maps Microsoft 365, vendors, network gear, recurring tickets, and admin roles.',
  },
  {
    label: 'First output',
    value: '30/60/90 operating plan',
    detail:
      'A plain-language plan with owners, risks, budget shape, and the first work worth proving.',
  },
];

const siteGuide = homeRouteGuideLinks.map(link => ({
  ...link,
  copy: link.description ?? '',
  href: withBasePath(link.href),
}));

const serviceLanes = [
  {
    index: '01',
    label: 'Support',
    title: 'Managed IT support.',
    copy: 'Help desk, onboarding, endpoint hygiene, patching, and vendor follow-through.',
    fit: 'Recurring tickets, slow responses, messy onboarding, or vendor finger-pointing.',
    output:
      'Support lanes, escalation rules, device standards, and issue-reduction targets.',
    href: withBasePath('services/'),
  },
  {
    index: '02',
    label: 'Security',
    title: 'Cybersecurity baseline.',
    copy: 'MFA, conditional access, endpoint protection, email defense, awareness, and response contacts.',
    fit: 'Insurance pressure, stale admin access, email risk, or unclear incident ownership.',
    output:
      'Identity, endpoint, email, backup, and response evidence leadership can review.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '03',
    label: 'Microsoft 365',
    title: 'Microsoft 365 and cloud operations.',
    copy: 'Exchange, Teams, SharePoint, OneDrive, licensing, access rules, migrations, and governance.',
    fit: 'Teams sprawl, risky sharing, license waste, migrations, or unclear tenant ownership.',
    output:
      'Governance rules, cleanup priorities, license notes, and migration or workflow next steps.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '04',
    label: 'Continuity',
    title: 'Backup, network, and recovery.',
    copy: 'Backup monitoring, restore testing, firewall, Wi-Fi, ISP, and recovery runbooks.',
    fit: 'Restore doubt, network drag, aging firewalls, ISP issues, or no written recovery order.',
    output:
      'Coverage notes, restore-test proof, recovery contacts, and recovery order.',
    href: withBasePath('services/#technology-catalog'),
  },
];

const excellenceStandards = [
  {
    code: '01',
    label: 'Response',
    title: 'Support cannot disappear into a queue.',
    copy: 'Every request should show priority, owner, status, next action, and escalation path.',
    meta: ['Triage', 'Status', 'Escalation'],
  },
  {
    code: '02',
    label: 'Security',
    title: 'Security must be explainable to non-technical leaders.',
    copy: 'Identity, endpoint, email, backup, and response posture should be reviewed in plain language.',
    meta: ['MFA', 'Endpoint', 'Email'],
  },
  {
    code: '03',
    label: 'Continuity',
    title: 'Backup confidence comes from restore proof.',
    copy: 'Coverage, alerts, retention, recovery owners, and restore tests should be visible before crisis.',
    meta: ['Coverage', 'Restore', 'Runbook'],
  },
  {
    code: '04',
    label: 'Planning',
    title: 'A great MSP helps leadership decide.',
    copy: 'Budget, lifecycle, risk, vendor, and project decisions should be surfaced before they become emergencies.',
    meta: ['Budget', 'Lifecycle', 'Roadmap'],
  },
];

const offerComparison = [
  {
    market: 'Flat-rate support',
    buyerNeeds:
      'Clear response model, escalation owner, recurring-issue reduction, and monthly reporting.',
    ourStandard:
      'Support scope is tied to named ownership, queue visibility, device hygiene, and vendor follow-through.',
  },
  {
    market: 'Cybersecurity add-ons',
    buyerNeeds:
      'Identity, endpoint, email, backup, awareness, response, and insurance evidence connected in one baseline.',
    ourStandard:
      'Security is positioned as operating proof, not a pile of disconnected tools.',
  },
  {
    market: 'Microsoft 365 admin',
    buyerNeeds:
      'Governance for Teams, SharePoint, guest access, licensing, retention assumptions, and backup.',
    ourStandard:
      'Microsoft 365 is treated like business infrastructure, with cleanup priorities and owner decisions.',
  },
  {
    market: 'Backup monitoring',
    buyerNeeds:
      'Restore testing, coverage notes, recovery order, incident contacts, and runbook clarity.',
    ourStandard:
      'Continuity work is reviewed early so recovery does not become a guess during an outage.',
  },
];

const operatingSignals = [
  {
    label: 'Response ownership',
    copy: 'Ticket lanes, escalation rules, vendor follow-through, and a weekly view of what is open or blocked.',
  },
  {
    label: 'Security baseline',
    copy: 'Identity, endpoint, email, backup, admin access, and risky forwarding are checked before new tools.',
  },
  {
    label: 'Executive visibility',
    copy: 'Owners see priorities, risks, renewal pressure, budget signals, and decisions that need attention.',
  },
];

const firstThirtyDays = [
  'Map users, devices, Microsoft 365, network gear, backups, vendors, admin roles, and recurring tickets.',
  'Stabilize urgent support and security gaps before expanding the roadmap.',
  'Turn findings into a 30/60/90-day plan with owners, budget ranges, and a decision point.',
];

const buyerQuestions = [
  {
    title: 'Who really owns the environment after the contract is signed?',
    copy: 'Ticket handling, vendor coordination, onboarding, reporting, backups, and security evidence should all have an owner.',
  },
  {
    title:
      'Can the provider keep up with security, AI, cloud, and workflow change?',
    copy: 'The right partner knows what to standardize, secure, document, automate, and leave alone.',
  },
  {
    title:
      'Can the website, portal, or intake flow help sales instead of slowing it down?',
    copy: 'When digital work is in scope, the goal is trust, fewer dead ends, better mobile behavior, and a cleaner next step.',
  },
];

const startOptions = [
  {
    title: 'Need service coverage?',
    copy: 'Start with support ownership, device hygiene, Microsoft 365, backup, or network stability.',
    href: withBasePath('services/'),
    cta: 'Open solutions hub',
  },
  {
    title: 'Need budget clarity?',
    copy: 'Compare package depth, scope boundaries, user/device assumptions, and co-managed fit.',
    href: withBasePath('pricing/'),
    cta: 'Open pricing guide',
  },
  {
    title: 'Need fit clarity?',
    copy: 'Sort whether the first move is support, security, recovery, Microsoft 365 cleanup, or workflow build.',
    href: withBasePath('contact-hq/'),
    cta: 'Open fit intake',
  },
];
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Managed IT, Security, Microsoft 365, and Workflow Support"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and customer-first support for firms that need clearer ownership."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-homepage-hero" id="landing-hero" data-page-section>
    <div class="home-homepage-stage home-homepage-stage--full">
      <div
        class="home-homepage-stage__scene"
        data-testid="home-orbit-scene"
        data-home-orbit-root
        role="img"
        aria-label="Interactive 3D operations field showing managed IT, security, and digital proof"
      >
        <div class="home-orbit-scene__fallback" aria-hidden="true"></div>
        <canvas
          class="home-orbit-scene__canvas"
          data-home-orbit-canvas
          aria-hidden="true"></canvas>
      </div>
    </div>

    <div class="home-homepage-hero__overlay">
      <div class="premium-container home-homepage-hero__grid">
        <div class="home-homepage-hero__content">
          <p class="home-homepage-eyebrow">
            Customer-first managed IT for Chicago businesses
          </p>
          <h1 class="home-homepage-title">
            CHICAGOS #1 MSP for companies that expect excellent support.
          </h1>
          <p class="home-homepage-copy home-homepage-copy--hero">
            Managed IT, cybersecurity, Microsoft 365, backup, network, and
            recovery support built around fast triage, visible ownership, and
            plain-language decisions.
          </p>
          <p class="home-homepage-claim home-homepage-claim--hero">
            No mystery queue. No random tool list. The business logic is simple:
            customers should know who owns the issue, what is included, what is
            risky, and what happens next.
          </p>

          <div class="home-homepage-actions home-homepage-actions--hero">
            <ModernButton
              href={withBasePath('services/')}
              variant="gradient"
              className="min-h-[52px]"
              rounded="sm"
            >
              View services
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="outline"
              className="min-h-[52px]"
              rounded="sm"
            >
              See pricing
            </ModernButton>
            <a
              class="home-homepage-fit-link"
              href={withBasePath('contact-hq/')}
            >
              Start fit check
            </a>
          </div>

          <div
            class="home-homepage-fit-grid"
            aria-label="Best fit and first engagement output"
          >
            {
              heroFitCards.map(card => (
                <article class="home-homepage-fit-card">
                  <span>{card.label}</span>
                  <strong>{card.value}</strong>
                  <p>{card.detail}</p>
                </article>
              ))
            }
          </div>
        </div>

        <aside
          class="home-homepage-hero__proof"
          aria-label="Managed service proof points"
        >
          <p class="home-homepage-eyebrow">Operating proof</p>
          <div class="home-homepage-proof-list">
            {
              heroProofPoints.map((point, index) => (
                <div class="home-homepage-proof-item">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <p>{point}</p>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--intro"
    id="home-intro"
    data-page-section
  >
    <div class="premium-container home-homepage-intro__grid">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Why buyers stay oriented</p>
        <h2 class="home-homepage-section__title">
          When IT feels scattered, customers feel it.
        </h2>
        <p class="home-homepage-copy">
          The first job is to make ownership visible: what is included, who owns
          support, how security is handled, where backup proof lives, how
          pricing is shaped, and what happens after the first conversation.
        </p>
        <p class="home-homepage-claim">
          That is the conversion logic: prove the operating model before asking
          a serious buyer for trust.
        </p>

        <div class="home-homepage-jump-links" aria-label="Popular routes">
          {
            siteGuide.slice(0, 4).map(item => (
              <a class="home-homepage-jump" href={item.href}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="home-homepage-signal-grid" aria-label="Landing proof signals">
        {
          heroSignals.map(signal => (
            <article class="home-homepage-signal-card">
              <p class="home-homepage-signal-card__label">{signal.label}</p>
              <h2>{signal.value}</h2>
              <p>{signal.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="home-homepage-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">What we do</p>
        <h2 class="home-homepage-section__title">
          Four clear service lanes buyers can understand fast.
        </h2>
        <p class="home-homepage-section__copy">
          Built around the outcomes Chicago SMBs actually ask for: responsive
          support, safer access, cleaner Microsoft 365, and recovery confidence.
        </p>
      </div>

      <div class="home-homepage-lanes">
        {
          serviceLanes.map(lane => (
            <a class="home-homepage-lane" href={lane.href}>
              <div class="home-homepage-lane__meta">
                <span class="home-homepage-lane__index">{lane.index}</span>
                <span class="home-homepage-lane__label">{lane.label}</span>
              </div>
              <div class="home-homepage-lane__body">
                <h3>{lane.title}</h3>
                <p>{lane.copy}</p>
                <dl class="home-homepage-lane__facts">
                  <div>
                    <dt>Best when</dt>
                    <dd>{lane.fit}</dd>
                  </div>
                  <div>
                    <dt>First proof</dt>
                    <dd>{lane.output}</dd>
                  </div>
                </dl>
              </div>
              <span class="home-homepage-lane__cta">Open scope</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--guide"
    id="guide"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Start here</p>
        <h2 class="home-homepage-section__title">
          Use the fastest route to a decision.
        </h2>
        <p class="home-homepage-section__copy">
          Most buyers need one of five answers first: service fit, budget shape,
          operating proof, contact routing, or a Chicago-specific service page.
        </p>
      </div>

      <div class="home-homepage-guide__grid" aria-label="Site guide">
        {
          siteGuide.map(item => (
            <a class="home-homepage-guide__item" href={item.href}>
              <span>{item.label}</span>
              <p>{item.copy}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--handoff"
    id="decision-handoff"
    data-page-section
  >
    <div class="premium-container">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Decision handoff"
        title="A mature first conversation has an output before it has a pitch."
        description="Use the pressure point to choose the right evidence, first output, and route before the conversation turns into a broad tool list."
      />
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--workbench"
    id="operations-workbench"
    data-page-section
  >
    <div class="premium-container">
      <OperationalIntelligenceWorkbench
        client:only="preact"
        items={workbenchItems}
        defaultItemId="support-ownership"
        eyebrow="Chicago Operations Studio"
        title="A working diagnostic for support, security, recovery, Microsoft 365, and service ownership."
        description="Choose the pressure point, inspect the signals, collect the evidence, and move into the right route with a handoff brief that an owner can actually use."
      />
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--comparison"
    id="offer-comparison"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Competitive clarity</p>
        <h2 class="home-homepage-section__title">
          Match the offer against what customers actually need.
        </h2>
        <p class="home-homepage-section__copy">
          Chicago competitors commonly emphasize flat-rate support, help desk,
          cybersecurity, cloud, and backup. The winning offer makes the proof,
          ownership, and boundaries clearer than everyone else.
        </p>
      </div>

      <div class="home-homepage-comparison-table">
        {
          offerComparison.map(item => (
            <article class="home-homepage-comparison-row">
              <div>
                <span>Market offer</span>
                <p>{item.market}</p>
              </div>
              <div>
                <span>Buyer needs</span>
                <p>{item.buyerNeeds}</p>
              </div>
              <div>
                <span>Our standard</span>
                <p>{item.ourStandard}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--experience"
    id="customer-excellence"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Customer excellence system</p>
        <h2 class="home-homepage-section__title">
          The experience should feel energetic because the service is clear.
        </h2>
        <p class="home-homepage-section__copy">
          Design energy is not decoration. The color, spacing, and motion should
          make the buyer feel control: issues move, evidence appears, and the
          next action is obvious.
        </p>
      </div>

      <div class="home-homepage-experience-grid">
        {
          excellenceStandards.map(item => (
            <article class="home-homepage-experience-card">
              <div class="home-homepage-experience-card__topline">
                <span class="home-homepage-experience-card__code">
                  {item.code}
                </span>
                <span class="home-homepage-experience-card__label">
                  {item.label}
                </span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <div class="home-homepage-experience-card__meta">
                {item.meta.map(meta => (
                  <span>{meta}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--questions"
    id="buyer-realities"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Buyer realities</p>
        <h2 class="home-homepage-section__title">
          The buying questions are practical.
        </h2>
        <p class="home-homepage-section__copy">
          A strong MSP site should answer ownership, risk, budget, evidence,
          service boundaries, and what happens after the first conversation.
        </p>
      </div>

      <div class="home-homepage-realities">
        {
          buyerQuestions.map(item => (
            <article class="home-homepage-reality">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section"
    id="operating-standard"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-operating">
        <div class="home-homepage-section__intro">
          <p class="home-homepage-eyebrow">Operating standard</p>
          <h2 class="home-homepage-section__title">
            The first phase is about control, evidence, and fewer loose ends.
          </h2>
          <p class="home-homepage-section__copy">
            Intake separates urgent support, security, and continuity work from
            longer cleanup. Leadership sees what happens now, what waits, and
            what it should cost.
          </p>
        </div>

        <div class="home-homepage-operating__grid">
          <div class="home-homepage-operating__signals">
            {
              operatingSignals.map(signal => (
                <article class="home-homepage-signal">
                  <h3>{signal.label}</h3>
                  <p>{signal.copy}</p>
                </article>
              ))
            }
          </div>

          <div class="home-homepage-first30" aria-labelledby="first30-title">
            <p class="home-homepage-eyebrow">First 30 days</p>
            <h3 id="first30-title">
              A practical start before the longer roadmap.
            </h3>
            <ol>
              {firstThirtyDays.map(item => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--closing"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-closing">
        <div class="home-homepage-closing__intro">
          <p class="home-homepage-eyebrow">Choose the next move</p>
          <h2 class="home-homepage-section__title">
            Start where the uncertainty is highest.
          </h2>
          <p class="home-homepage-section__copy">
            Choose the path that answers the first decision cleanly: service
            coverage, budget shape, or whether the work is a fit.
          </p>
        </div>

        <div class="home-homepage-start-list">
          {
            startOptions.map(option => (
              <a class="home-homepage-start-item" href={option.href}>
                <div>
                  <h3>{option.title}</h3>
                  <p>{option.copy}</p>
                </div>
                <span>{option.cta}</span>
              </a>
            ))
          }
        </div>

        <div class="home-homepage-closeout tone-cta-band">
          <div>
            <p class="home-homepage-eyebrow">Ready to move</p>
            <h3 class="home-homepage-closeout__title">
              Make the operating layer easier to own and the client-facing
              workflow easier to trust.
            </h3>
            <p class="home-homepage-closeout__copy">
              The first conversation should identify the pressure point, risk,
              likely cost range, owner, and first outcome worth proving.
            </p>
          </div>

          <div class="home-homepage-actions home-homepage-actions--closeout">
            <ModernButton
              href={contactHref}
              variant="gradient"
              className="min-h-[52px]"
            >
              Start intake
            </ModernButton>
            <ModernButton
              href={scheduleHref}
              variant="outline"
              className="min-h-[52px]"
            >
              Book planning call
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const paintHomeOrbitFallback = (root: HTMLElement) => {
      const canvas = root.querySelector<HTMLCanvasElement>(
        '[data-home-orbit-canvas]'
      );
      if (!canvas) return;

      const width = Math.max(320, Math.round(root.clientWidth || 960));
      const height = Math.max(320, Math.round(root.clientHeight || 620));
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const ctx = canvas.getContext('2d', { willReadFrequently: false });
      if (!ctx) return;

      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = '100%';
      canvas.style.height = '100%';

      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const wash = ctx.createLinearGradient(0, 0, width, height);
      wash.addColorStop(0, '#101415');
      wash.addColorStop(0.38, '#172b29');
      wash.addColorStop(0.72, '#151318');
      wash.addColorStop(1, '#070807');
      ctx.fillStyle = wash;
      ctx.fillRect(0, 0, width, height);

      const glow = ctx.createRadialGradient(
        width * 0.68,
        height * 0.42,
        8,
        width * 0.68,
        height * 0.42,
        width * 0.38
      );
      glow.addColorStop(0, 'rgba(98, 216, 198, 0.24)');
      glow.addColorStop(0.42, 'rgba(246, 198, 91, 0.18)');
      glow.addColorStop(1, 'rgba(7, 8, 9, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(251, 247, 239, 0.09)';
      for (let index = -3; index < 18; index += 1) {
        const x = index * 84;
        ctx.beginPath();
        ctx.moveTo(x, height * 0.12);
        ctx.lineTo(x + width * 0.22, height * 0.92);
        ctx.stroke();
      }

      const skyline = [
        [0.56, 0.28, 0.028],
        [0.6, 0.18, 0.018],
        [0.64, 0.24, 0.024],
        [0.69, 0.32, 0.03],
        [0.74, 0.2, 0.02],
        [0.79, 0.27, 0.026],
      ];
      const baseY = height * 0.76;
      skyline.forEach(([xScale, hScale, wScale], index) => {
        const barWidth = width * wScale;
        const barHeight = height * hScale;
        const x = width * xScale - barWidth / 2;
        const y = baseY - barHeight;
        const bar = ctx.createLinearGradient(x, y, x, baseY);
        bar.addColorStop(
          0,
          index % 2 === 0
            ? 'rgba(98, 216, 198, 0.68)'
            : 'rgba(246, 198, 91, 0.58)'
        );
        bar.addColorStop(1, 'rgba(251, 247, 239, 0.08)');
        ctx.fillStyle = bar;
        ctx.fillRect(x, y, barWidth, barHeight);
      });

      ctx.strokeStyle = 'rgba(98, 216, 198, 0.46)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.ellipse(
        width * 0.68,
        height * 0.42,
        width * 0.16,
        height * 0.08,
        -0.22,
        0,
        Math.PI * 2
      );
      ctx.stroke();

      for (let index = 0; index < 28; index += 1) {
        const angle = (index / 28) * Math.PI * 2;
        const radius = width * (0.08 + (index % 4) * 0.016);
        const x = width * 0.68 + Math.cos(angle) * radius;
        const y = height * 0.42 + Math.sin(angle) * radius * 0.48;
        ctx.fillStyle =
          index % 3 === 0
            ? 'rgba(246, 198, 91, 0.72)'
            : 'rgba(251, 247, 239, 0.62)';
        ctx.beginPath();
        ctx.arc(x, y, 2.4 + (index % 2), 0, Math.PI * 2);
        ctx.fill();
      }

      root.dataset.homeOrbitFallbackPainted = 'true';
    };

    const scheduleHomeOrbitScene = () => {
      const root = document.querySelector<HTMLElement>(
        '[data-home-orbit-root]'
      );

      if (!root || root.dataset.homeOrbitScheduled === 'true') return;

      root.dataset.homeOrbitScheduled = 'true';
      paintHomeOrbitFallback(root);

      const prefersStaticScene = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const saveData =
        (navigator as Navigator & { connection?: { saveData?: boolean } })
          .connection?.saveData === true;

      if (saveData) {
        root.dataset.homeOrbitMode = 'static';
        return;
      }

      if (prefersStaticScene) {
        root.dataset.homeOrbitMode = 'static';
      }

      const loadScene = () => {
        import('../scripts/home-orbit-scene').catch(error => {
          console.error('[HomeOrbitScene] Failed to load scene', error);
        });
      };

      const loadWhenIdle = () => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadScene, { timeout: 7000 });
          return;
        }

        globalThis.setTimeout(loadScene, 2200);
      };

      const scheduleAfterVisible = () => {
        const observer = new IntersectionObserver(
          entries => {
            const visible = entries.some(entry => entry.isIntersecting);
            if (!visible) return;
            observer.disconnect();
            globalThis.setTimeout(loadWhenIdle, 1200);
          },
          {
            rootMargin: '160px 0px',
            threshold: 0.15,
          }
        );

        observer.observe(root);
      };

      if (document.readyState === 'complete') {
        scheduleAfterVisible();
      } else {
        window.addEventListener('load', scheduleAfterVisible, { once: true });
      }
    };

    scheduleHomeOrbitScene();
    document.addEventListener('astro:page-load', scheduleHomeOrbitScene);
  </script>

