    eyebrow: 'Managed operations',
    title: 'Support that feels organized',
    summary:
      'Help desk, onboarding, endpoint health, vendor coordination, and operational visibility without the usual MSP sprawl.',
    operatingModel:
      'Retained coverage with reporting, ownership, and executive-friendly communication.',
    rhythm: 'Daily support, weekly signals, monthly roadmap clarity.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    badge: 'SEC',
    eyebrow: 'Security and compliance',
    title: 'Trust built into the core stack',
    summary:
      'Identity, device, response, compliance, and security advisory shaped for real-world pressure instead of box-checking theatrics.',
    operatingModel:
      'Security posture that matures at the same speed the business can actually absorb.',
    rhythm:
