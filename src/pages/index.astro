---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ChicagoSkyline from '../components/ChicagoSkyline.astro';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake - Olive Global Systems')}`;

const serviceLanes = [
  {
    index: '01',
    label: 'Operate',
    title: 'Managed IT that actually owns the day-to-day',
    copy: 'Help desk, endpoint management, onboarding, vendor coordination, and recurring maintenance under one accountable operating model.',
    href: withBasePath('services/'),
  },
  {
    index: '02',
    label: 'Protect',
    title: 'Security and compliance without enterprise theater',
    copy: 'Identity, email protection, endpoint security, compliance readiness, and response planning that leadership can actually follow.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '03',
    label: 'Modernize',
    title: 'Cloud and Microsoft 365 with practical leverage',
    copy: 'Migration, cleanup, collaboration governance, backup strategy, and workflow automation tied to lower drag and better visibility.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '04',
    label: 'Present',
    title: 'A digital front door that feels as strong as the backend',
    copy: 'Selective website, portal, and client-facing work for firms whose presentation needs to match the quality of their operations.',
    href: withBasePath('about/'),
  },
];

const outcomePoints = [
  'One partner for support, security, Microsoft 365, and infrastructure decisions',
  'A Chicago-specific service story that reads clearly on mobile',
  'A sharper first impression before the first sales or intake call',
];

const proofMetrics = [
  {
    value: '30',
    label: 'day operating baseline',
  },
  {
    value: '4',
    label: 'service lanes, one accountable model',
  },
  {
    value: '0',
    label: 'generic handoff theater',
  },
];

const operatingSignals = [
  {
    label: 'Response ownership',
    copy: 'Clear ticket lanes, escalation rules, and a weekly view of what is open, aging, blocked, or recurring.',
  },
  {
    label: 'Security baseline',
    copy: 'Identity, endpoint, email, backup, and admin-access checks before new tools or larger projects are layered in.',
  },
  {
    label: 'Executive visibility',
    copy: 'Plain-language priorities, risk notes, and roadmap sequencing that leadership can use without translating IT noise.',
  },
];

const firstThirtyDays = [
  'Map users, devices, Microsoft 365, network, backup, vendors, and support pain',
  'Stabilize urgent support and security gaps before expanding scope',
  'Create a practical roadmap with owners, budget ranges, and the next decision point',
];

const startOptions = [
  {
    title: 'Need service coverage?',
    copy: 'Start with the solution hub if you need help desk ownership, security lift, M365 guidance, or infrastructure support.',
    href: withBasePath('services/'),
    cta: 'View solutions',
  },
  {
    title: 'Need budget clarity?',
    copy: 'Use pricing when the main question is directional budget, coverage depth, or whether co-managed support makes sense.',
    href: withBasePath('pricing/'),
    cta: 'See pricing',
  },
  {
    title: 'Need fit clarity?',
    copy: 'Use contact HQ when the main question is scope, sequence, timing, or which service lane should lead first.',
    href: withBasePath('contact-hq/'),
    cta: 'Start fit check',
  },
];
---

<MarketingLayout
  title="Olive Global Systems | Chicago Managed IT, Security, and Digital Systems"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and selective digital systems for firms that need steadier operations and a stronger first impression."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-homepage-hero" id="landing-hero" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-hero__shell">
        <div class="home-homepage-hero__copy">
          <p class="home-homepage-eyebrow">
            Chicago managed IT and cybersecurity
          </p>
          <h1 class="home-homepage-title">
            <span>Support that answers.</span>
            <span>Security that holds.</span>
            <span>A sharper Chicago front door.</span>
          </h1>
          <p class="home-homepage-copy">
            Managed IT, cybersecurity, Microsoft 365, cloud, backup, networking,
            and selective digital systems for Chicago-area teams that need
            technology to feel organized again.
          </p>

          <div class="home-homepage-actions">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[54px]"
            >
              Start strategy intake
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="outline"
              className="min-h-[54px]"
            >
              Explore services
            </ModernButton>
          </div>

          <ul class="home-homepage-outcomes" aria-label="Primary outcomes">
            {outcomePoints.map(item => <li>{item}</li>)}
          </ul>

          <div class="home-homepage-proof" aria-label="Operating proof points">
            {
              proofMetrics.map(metric => (
                <div class="home-homepage-proof__item">
                  <span>{metric.value}</span>
                  <p>{metric.label}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="home-homepage-hero__art" aria-hidden="true">
          <div class="home-homepage-art-panel">
            <div class="home-homepage-art-panel__plate">
              <span>Olive OS</span>
              <span>Chicago / managed layer</span>
            </div>

            <div class="home-homepage-art-map">
              <div class="home-homepage-art-map__track"></div>
              <div
                class="home-homepage-art-node home-homepage-art-node--operate"
              >
                <span>01</span>
                <strong>Operate</strong>
                <small>Tickets, endpoints, vendors</small>
              </div>
              <div
                class="home-homepage-art-node home-homepage-art-node--protect"
              >
                <span>02</span>
                <strong>Protect</strong>
                <small>Identity, email, backup</small>
              </div>
              <div
                class="home-homepage-art-node home-homepage-art-node--modernize"
              >
                <span>03</span>
                <strong>Modernize</strong>
                <small>M365, cloud, workflow</small>
              </div>
              <div
                class="home-homepage-art-node home-homepage-art-node--present"
              >
                <span>04</span>
                <strong>Present</strong>
                <small>Portal, web, proof</small>
              </div>
            </div>

            <div class="home-homepage-art-panel__skyline">
              <ChicagoSkyline
                className="home-homepage-skyline"
                style="width:min(100%,30rem);height:4.2rem;"
              />
            </div>

            <div class="home-homepage-art-panel__meta">
              <p>Support signal</p>
              <p>Risk baseline</p>
              <p>Roadmap clarity</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-homepage-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">What we do</p>
        <h2 class="home-homepage-section__title">
          Four lanes that make the operating model easier to understand.
        </h2>
        <p class="home-homepage-section__copy">
          The service story is intentionally organized around the decisions
          Chicago-area teams actually have to make: who owns support, how risk
          gets reduced, what cloud work should change first, and how the public
          experience supports trust.
        </p>
      </div>

      <div class="home-homepage-lanes">
        {
          serviceLanes.map(lane => (
            <a class="home-homepage-lane" href={lane.href}>
              <div class="home-homepage-lane__meta">
                <span class="home-homepage-lane__index">{lane.index}</span>
                <span class="home-homepage-lane__label">{lane.label}</span>
              </div>
              <div class="home-homepage-lane__body">
                <h3>{lane.title}</h3>
                <p>{lane.copy}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section"
    id="operating-standard"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-operating">
        <div class="home-homepage-section__intro">
          <p class="home-homepage-eyebrow">Operating standard</p>
          <h2 class="home-homepage-section__title">
            The first phase should make the environment easier to run, not just
            easier to sell.
          </h2>
          <p class="home-homepage-section__copy">
            Intake starts by separating urgent support needs from structural
            risk. That keeps early work concrete and gives leadership a clean
            view of what should happen now, next, and later.
          </p>
        </div>

        <div class="home-homepage-operating__grid">
          <div class="home-homepage-operating__signals">
            {
              operatingSignals.map(signal => (
                <article class="home-homepage-signal">
                  <h3>{signal.label}</h3>
                  <p>{signal.copy}</p>
                </article>
              ))
            }
          </div>

          <div class="home-homepage-first30" aria-labelledby="first30-title">
            <p class="home-homepage-eyebrow">First 30 days</p>
            <h3 id="first30-title">
              A practical start, before the bigger roadmap.
            </h3>
            <ol>
              {firstThirtyDays.map(item => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--closing"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-closing">
        <div class="home-homepage-closing__intro">
          <p class="home-homepage-eyebrow">Choose the next move</p>
          <h2 class="home-homepage-section__title">
            Start where the pressure is: support, budget, or fit clarity.
          </h2>
        </div>

        <div class="home-homepage-start-list">
          {
            startOptions.map(option => (
              <a class="home-homepage-start-item" href={option.href}>
                <div>
                  <h3>{option.title}</h3>
                  <p>{option.copy}</p>
                </div>
                <span>{option.cta}</span>
              </a>
            ))
          }
        </div>

        <div class="home-homepage-closeout">
          <div>
            <p class="home-homepage-eyebrow">Ready to move</p>
            <h3 class="home-homepage-closeout__title">
              Fix the operating layer first. Improve the front door with the
              same discipline.
            </h3>
          </div>

          <div class="home-homepage-actions home-homepage-actions--closeout">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[52px]"
            >
              Book intake
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Review pricing
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .home-homepage-hero,
    .home-homepage-section {
      position: relative;
      padding: clamp(4rem, 8vw, 7rem) 0;
    }

    .home-homepage-hero {
      min-height: min(800px, calc(100svh - 1rem));
      display: grid;
      align-items: center;
      padding-top: clamp(6rem, 8vw, 7.25rem);
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
      background:
        linear-gradient(
          120deg,
          color-mix(in srgb, #20322f 20%, transparent) 0 1px,
          transparent 1px 42px
        ),
        radial-gradient(
          ellipse at 78% 22%,
          color-mix(in srgb, #1d5f5c 20%, transparent),
          transparent 34%
        );
    }

    .home-homepage-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-border) 24%, transparent) 1px,
          transparent 1px
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-border) 18%, transparent) 1px,
          transparent 1px
        ),
        radial-gradient(
          circle at 14% 10%,
          color-mix(in srgb, var(--color-primary) 14%, transparent),
          transparent 30%
        ),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22%);
      background-size:
        72px 72px,
        72px 72px,
        auto,
        auto;
      pointer-events: none;
    }

    .home-homepage-hero::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.16;
      background:
        repeating-linear-gradient(
          0deg,
          transparent 0 8px,
          rgba(255, 255, 255, 0.018) 8px 9px
        ),
        linear-gradient(
          135deg,
          transparent 0 48%,
          color-mix(in srgb, var(--color-primary) 10%, transparent) 48% 49%,
          transparent 49%
        );
      mix-blend-mode: screen;
    }

    .home-homepage-hero__shell {
      position: relative;
      z-index: 1;
      display: grid;
      gap: clamp(2rem, 5vw, 3.8rem);
      align-items: center;
    }

    .home-homepage-hero__copy {
      display: grid;
      gap: 1.15rem;
      max-width: 45rem;
    }

    .home-homepage-eyebrow {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-muted) 94%, transparent);
      font-family: var(--font-sans);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .home-homepage-title {
      max-width: 12.1ch;
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 6.2vw, 5.75rem);
      font-weight: 700;
      line-height: 0.92;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .home-homepage-title span {
      display: block;
    }

    .home-homepage-title span:nth-child(2) {
      color: color-mix(in srgb, var(--color-text-primary) 70%, transparent);
    }

    .home-homepage-title span:nth-child(3) {
      color: color-mix(in srgb, var(--color-primary) 70%, #62d2c5 30%);
      text-shadow: 0 16px 48px color-mix(in srgb, #62d2c5 18%, transparent);
    }

    .home-homepage-copy,
    .home-homepage-section__copy,
    .home-homepage-lane p,
    .home-homepage-start-item p {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
      font-size: clamp(1rem, 1.12vw, 1.08rem);
      line-height: 1.68;
    }

    .home-homepage-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      padding-top: 0.25rem;
    }

    .home-homepage-outcomes {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 1.35rem 0 0;
      list-style: none;
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
    }

    .home-homepage-outcomes li {
      position: relative;
      padding-left: 1.2rem;
      color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .home-homepage-outcomes li::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 0;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-primary) 84%, white 16%);
    }

    .home-homepage-proof {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      overflow: hidden;
      max-width: 40rem;
      border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
      background: color-mix(in srgb, var(--color-border) 52%, transparent);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 24px 70px -54px rgba(0, 0, 0, 0.82);
    }

    .home-homepage-proof__item {
      min-height: 6.7rem;
      padding: 1rem;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 92%, white 3%),
        color-mix(in srgb, var(--color-background) 82%, transparent)
      );
    }

    .home-homepage-proof__item span {
      display: block;
      color: color-mix(in srgb, var(--color-primary) 72%, #62d2c5 28%);
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3.45rem);
      font-weight: 800;
      line-height: 0.9;
      letter-spacing: 0;
    }

    .home-homepage-proof__item p {
      max-width: 10rem;
      margin: 0.65rem 0 0;
      color: color-mix(in srgb, var(--color-text-secondary) 80%, transparent);
      font-size: 0.78rem;
      font-weight: 700;
      line-height: 1.25;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .home-homepage-art-panel {
      position: relative;
      overflow: hidden;
      min-height: 31.5rem;
      padding: clamp(1rem, 2.4vw, 1.35rem);
      border: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);
      border-radius: var(--radius-sm);
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-surface) 92%, white 4%),
          color-mix(in srgb, #0b0f10 96%, transparent)
        ),
        color-mix(in srgb, var(--color-surface) 92%, transparent);
      box-shadow:
        0 32px 88px -56px rgba(0, 0, 0, 0.92),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transform: translateY(-0.65rem) rotate(1.1deg);
    }

    .home-homepage-art-panel::before,
    .home-homepage-art-panel::after {
      content: '';
      position: absolute;
      pointer-events: none;
    }

    .home-homepage-art-panel::before {
      inset: 0;
      background:
        linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
        linear-gradient(180deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 30px 30px;
      mask-image: linear-gradient(180deg, black, transparent 82%);
      opacity: 0.5;
    }

    .home-homepage-art-panel::after {
      inset: auto 1rem 1rem 1rem;
      height: 34%;
      background: linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, #06100f 86%, transparent)
      );
    }

    .home-homepage-art-panel__plate,
    .home-homepage-art-panel__meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.7rem 1rem;
      color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
      font-family: var(--font-sans);
      font-size: 0.65rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .home-homepage-art-panel__skyline {
      position: absolute;
      z-index: 1;
      right: 1.25rem;
      bottom: 3.75rem;
      left: 1.25rem;
      padding: 0 0 0.9rem;
      color: color-mix(in srgb, var(--color-primary) 76%, white 24%);
    }

    .home-homepage-skyline {
      display: block;
      --skyline-width: min(100%, 30rem);
      --skyline-height: 4.2rem;
      width: min(100%, 30rem);
      height: 4.2rem;
      opacity: 0.9;
    }

    .home-homepage-art-map {
      position: relative;
      z-index: 1;
      min-height: 22rem;
      margin-top: 1.2rem;
    }

    .home-homepage-art-map__track {
      position: absolute;
      inset: 2rem 19% 2rem auto;
      width: 1px;
      background: linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--color-primary) 55%, transparent),
        color-mix(in srgb, #62d2c5 54%, transparent),
        transparent
      );
      box-shadow: 0 0 34px color-mix(in srgb, #62d2c5 20%, transparent);
    }

    .home-homepage-art-node {
      position: absolute;
      display: grid;
      gap: 0.18rem;
      width: min(16rem, 74%);
      padding: 0.95rem 1rem;
      border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-surface) 82%, white 5%),
        color-mix(in srgb, #0f1716 94%, transparent)
      );
      box-shadow:
        0 18px 48px -38px rgba(0, 0, 0, 0.9),
        inset 0 1px 0 rgba(255, 255, 255, 0.07);
    }

    .home-homepage-art-node span {
      color: color-mix(in srgb, var(--color-primary) 74%, white 10%);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.14em;
    }

    .home-homepage-art-node strong {
      color: var(--color-text-primary);
      font-size: 1.1rem;
      line-height: 1;
    }

    .home-homepage-art-node small {
      color: color-mix(in srgb, var(--color-text-secondary) 72%, transparent);
      font-size: 0.72rem;
      line-height: 1.35;
    }

    .home-homepage-art-node--operate {
      top: 0.4rem;
      left: 0;
    }

    .home-homepage-art-node--protect {
      top: 5.6rem;
      right: 0;
      border-color: color-mix(in srgb, #62d2c5 28%, var(--color-border));
    }

    .home-homepage-art-node--modernize {
      top: 11rem;
      left: 2.4rem;
    }

    .home-homepage-art-node--present {
      top: 15.6rem;
      right: 1rem;
      border-color: color-mix(in srgb, #d9966b 24%, var(--color-border));
    }

    .home-homepage-art-panel__meta {
      position: absolute;
      z-index: 2;
      right: 1.25rem;
      bottom: 1.2rem;
      left: 1.25rem;
    }

    .home-homepage-section {
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .home-homepage-section__intro {
      display: grid;
      gap: 0.85rem;
      max-width: 44rem;
      margin-bottom: 2.35rem;
    }

    .home-homepage-section__title,
    .home-homepage-lane h3,
    .home-homepage-start-item h3,
    .home-homepage-closeout__title {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.45rem, 3vw, 3rem);
      font-weight: 700;
      line-height: 0.98;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .home-homepage-lanes {
      display: grid;
      gap: 1px;
      overflow: hidden;
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
      background: color-mix(in srgb, var(--color-border) 54%, transparent);
    }

    .home-homepage-lane {
      position: relative;
      display: grid;
      gap: 1rem;
      min-height: 15rem;
      padding: clamp(1.2rem, 2.2vw, 1.7rem);
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 84%, transparent),
        color-mix(in srgb, var(--color-background) 92%, transparent)
      );
      border-bottom: 0;
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease,
        background 0.2s ease;
    }

    .home-homepage-lane::after {
      content: '';
      position: absolute;
      inset: auto 1rem 1rem auto;
