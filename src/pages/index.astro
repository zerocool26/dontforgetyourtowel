---
import { Image } from 'astro:assets';

import CtaBand from '../components/CtaBand.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import heroImage from '../assets/chicago-architecture.png';
import { processSteps, proofRows, services } from '../data/site';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Technology Consulting & Software Engineering"
  description="Technology strategy, custom software, cloud, cybersecurity, and managed IT from one accountable Chicago team."
>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1>Build faster.<br />Run stronger<span>.</span></h1>
        <p>
          Technology strategy, custom software, cloud, cybersecurity, and
          managed IT—one accountable Chicago team from first decision through
          daily operations.
        </p>
        <div class="button-row">
          <a class="button" href={withBasePath('contact-hq/')}>Put us to work</a
          >
          <a class="button button--outline" href="#what-we-deliver">
            See what we deliver
          </a>
        </div>
      </div>
      <div class="home-hero__media">
        <Image
          src={heroImage}
          alt="Chicago elevated steel structure with Marina City and the Willis Tower"
          widths={[720, 960, 1280]}
          sizes="(min-width: 900px) 50vw, 100vw"
          format="webp"
          quality={88}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="ownership-strip" aria-labelledby="ownership-heading">
    <div class="shell">
      <h2 id="ownership-heading">
        One team from decision to daily operations.
      </h2>
      <div class="ownership-strip__items">
        <span class="ownership-item">
          <svg aria-hidden="true" viewBox="0 0 32 32">
            <path d="M8 3h11l5 5v21H8z"></path>
            <path d="M19 3v6h5M12 16h8M12 21h8"></path>
          </svg>
          <span>Plan</span>
        </span>
        <span class="ownership-item">
          <svg aria-hidden="true" viewBox="0 0 32 32">
            <path d="m11 8-7 8 7 8M21 8l7 8-7 8M18 5l-4 22"></path>
          </svg>
          <span>Build</span>
        </span>
        <span class="ownership-item">
          <svg aria-hidden="true" viewBox="0 0 32 32">
            <path d="M16 3 27 7v8c0 7-4 11-11 14C9 26 5 22 5 15V7z"></path>
          </svg>
          <span>Secure</span>
        </span>
        <span class="ownership-item">
          <svg aria-hidden="true" viewBox="0 0 32 32">
            <path d="M5 6h22v6H5zM5 14h22v6H5zM5 22h22v6H5z"></path>
            <circle cx="9" cy="9" r="1"></circle>
            <circle cx="9" cy="17" r="1"></circle>
            <circle cx="9" cy="25" r="1"></circle>
          </svg>
          <span>Run</span>
        </span>
      </div>
    </div>
  </section>

  <section class="handoff-section" id="what-we-deliver">
    <div class="shell handoff-section__grid">
      <div class="handoff-section__content">
        <div class="section-heading">
          <h2>Stop managing the handoffs.</h2>
          <p>
            Consultants write the plan. Developers ship the build. IT inherits
            the mess. We keep one accountable operating model across all three.
          </p>
        </div>
        <div class="service-ledger">
          {
            services.map(service => (
              <a href={withBasePath(`services/#${service.id}`)}>
                <span class="index-number">{service.number}</span>
                <strong>{service.title}</strong>
                <p>{service.summary}</p>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="handoff-section__media" aria-hidden="true">
        <Image
          src={heroImage}
          alt=""
          widths={[720, 960]}
          sizes="(min-width: 900px) 44vw, 100vw"
          format="webp"
          quality={84}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="delivery-band" id="how-we-work">
    <div class="shell">
      <div class="delivery-band__heading">
        <h2>Plan it. Build it. Secure it. Run it.</h2>
        <p>
          Start with the stage you need. Keep the operating responsibility
          connected through what comes next.
        </p>
      </div>
      <ol class="delivery-band__steps">
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
      <a class="button button--light" href={withBasePath('contact-hq/')}>
        Put us to work
      </a>
    </div>
  </section>

  <section class="section proof-section">
    <div class="shell proof-section__inner">
      <div class="section-heading section-heading--wide">
        <h2>Prove the work in the operating record.</h2>
        <p>
          The name says #1. The standard has to earn it—through decisions,
          delivery discipline, secure ownership, and a system that works after
          launch.
        </p>
      </div>
      <div class="proof-ledger">
        {
          proofRows.map(row => (
            <div class="proof-ledger__row">
              <span class="index-number">{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.copy}</p>
            </div>
          ))
        }
      </div>
      <a class="text-link" href={withBasePath('trust-center/')}>
        Review our operating standard <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <CtaBand />
</MarketingLayout>
