---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake - Olive Global Systems')}`;

const serviceLanes = [
  {
    index: '01',
    label: 'Operate',
    title: 'Managed IT with real ownership',
    copy: 'Support, vendors, device health, onboarding, and day-to-day follow-through under one accountable team.',
    href: withBasePath('services/'),
  },
  {
    index: '02',
    label: 'Secure',
    title: 'Security that leadership can understand',
    copy: 'Identity, compliance progress, endpoint hardening, and practical risk reduction without theater.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '03',
    label: 'Modernize',
    title: 'Cloud, AI, and automation tied to leverage',
    copy: 'Modernization work shaped around speed, visibility, and lower drag instead of trend chasing.',
    href: withBasePath('build-studio/'),
  },
  {
    index: '04',
    label: 'Present',
    title: 'Premium websites and buyer-facing systems',
    copy: 'Sharper mobile experiences, launch pages, demos, and digital front doors that feel credible on first contact.',
    href: withBasePath('about/'),
  },
];

const outcomePoints = [
  'A homepage that explains the business in seconds',
  'Navigation that feels obvious on a phone',
  'An operating partner instead of a list of vendors',
];

const startOptions = [
  {
    title: 'Need service coverage?',
    copy: 'Go straight to solutions for the full operating, security, and modernization scope.',
    href: withBasePath('services/'),
    cta: 'View solutions',
  },
  {
    title: 'Need budget clarity?',
    copy: 'Use pricing when the main question is scope, support depth, or rollout shape.',
    href: withBasePath('pricing/'),
    cta: 'See pricing',
  },
  {
    title: 'Need a faster brief?',
    copy: 'Use the studio to shape the project before the first call.',
    href: withBasePath('build-studio/'),
    cta: 'Open studio',
  },
];
---

<MarketingLayout
  title="Olive Global Systems | Managed IT, Security, and Premium Web Systems"
  description="Managed IT, security, cloud, AI, automation, and premium buyer-facing systems for companies that need to run cleaner and sell sharper."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-homepage-hero" id="landing-hero" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-hero__shell">
        <div class="home-homepage-hero__copy">
          <p class="home-homepage-eyebrow">Chicago systems partner</p>
          <h1 class="home-homepage-title">
            Own operations.
            <span>Tighten security.</span>
            <span>Look premium on mobile.</span>
          </h1>
          <p class="home-homepage-copy">
            Managed IT, security, cloud, AI, and premium buyer-facing systems
            for companies that need a cleaner operation and a stronger front
            door.
          </p>

          <div class="home-homepage-actions">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[54px]"
            >
              Start strategy intake
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="outline"
              className="min-h-[54px]"
            >
              Explore services
            </ModernButton>
          </div>

          <ul class="home-homepage-outcomes" aria-label="Primary outcomes">
            {outcomePoints.map(item => <li>{item}</li>)}
          </ul>
        </div>

        <div class="home-homepage-hero__art" aria-hidden="true">
          <div class="home-homepage-art-panel">
            <div class="home-homepage-art-panel__topline">
              <span>Operate</span>
              <span>Secure</span>
              <span>Present</span>
            </div>

            <div class="home-homepage-art-panel__headline">
              <span>Trust</span>
              <span>starts</span>
              <span>before</span>
              <span>the call.</span>
            </div>

            <div class="home-homepage-art-panel__rule"></div>

            <div class="home-homepage-art-panel__meta">
              <p>Mobile-first browsing</p>
              <p>Clear service lanes</p>
              <p>No hidden content</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-homepage-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">What we do</p>
        <h2 class="home-homepage-section__title">
          Four lanes. Clear scope. No homepage maze.
        </h2>
        <p class="home-homepage-section__copy">
          The homepage should explain the company fast. Detail belongs deeper in
          the site, not in a pile of boxes on the first screen.
        </p>
      </div>

      <div class="home-homepage-lanes">
        {
          serviceLanes.map(lane => (
            <a class="home-homepage-lane" href={lane.href}>
              <div class="home-homepage-lane__meta">
                <span class="home-homepage-lane__index">{lane.index}</span>
                <span class="home-homepage-lane__label">{lane.label}</span>
              </div>
              <div class="home-homepage-lane__body">
                <h3>{lane.title}</h3>
                <p>{lane.copy}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--closing"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-closing">
        <div class="home-homepage-closing__intro">
          <p class="home-homepage-eyebrow">Choose the next move</p>
          <h2 class="home-homepage-section__title">
            Start where the pressure is: scope, budget, or project shaping.
          </h2>
        </div>

        <div class="home-homepage-start-list">
          {
            startOptions.map(option => (
              <a class="home-homepage-start-item" href={option.href}>
                <div>
                  <h3>{option.title}</h3>
                  <p>{option.copy}</p>
                </div>
                <span>{option.cta}</span>
              </a>
            ))
          }
        </div>

        <div class="home-homepage-closeout">
          <div>
            <p class="home-homepage-eyebrow">Ready to move</p>
            <h3 class="home-homepage-closeout__title">
              Fix the operating layer and the digital front door together.
            </h3>
          </div>

          <div class="home-homepage-actions home-homepage-actions--closeout">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[52px]"
            >
              Book intake
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Review pricing
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .home-homepage-hero,
    .home-homepage-section {
      position: relative;
      padding: clamp(4rem, 8vw, 7rem) 0;
    }

    .home-homepage-hero {
      padding-top: clamp(6.25rem, 9vw, 8rem);
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .home-homepage-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(
          circle at 14% 10%,
          color-mix(in srgb, var(--color-primary) 14%, transparent),
          transparent 30%
        ),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22%);
      pointer-events: none;
    }

    .home-homepage-hero__shell {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 2.5rem;
      align-items: end;
    }

    .home-homepage-hero__copy {
      display: grid;
      gap: 1.25rem;
      max-width: 42rem;
    }

    .home-homepage-eyebrow {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }

    .home-homepage-title {
      max-width: 10.5ch;
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(3rem, 8vw, 6.8rem);
      font-weight: 600;
      line-height: 0.94;
      letter-spacing: -0.07em;
      text-wrap: balance;
    }

    .home-homepage-title span {
      display: block;
    }

    .home-homepage-title span:first-of-type {
      color: color-mix(in srgb, var(--color-text-primary) 70%, transparent);
    }

    .home-homepage-title span:last-of-type {
      color: color-mix(in srgb, var(--color-primary) 78%, white 22%);
    }

    .home-homepage-copy,
    .home-homepage-section__copy,
    .home-homepage-lane p,
    .home-homepage-start-item p {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
      font-size: clamp(1rem, 1.4vw, 1.08rem);
      line-height: 1.7;
    }

    .home-homepage-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      padding-top: 0.25rem;
    }

    .home-homepage-outcomes {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 1.2rem 0 0;
      list-style: none;
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
    }

    .home-homepage-outcomes li {
      position: relative;
      padding-left: 1.2rem;
      color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .home-homepage-outcomes li::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 0;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-primary) 84%, white 16%);
    }

    .home-homepage-art-panel {
      position: relative;
      overflow: hidden;
      min-height: 100%;
      padding: clamp(1.4rem, 3vw, 2rem) 0 0;
    }

    .home-homepage-art-panel::before,
    .home-homepage-art-panel::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      height: 1px;
      background: color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-art-panel::before {
      top: 0;
    }

    .home-homepage-art-panel::after {
      bottom: 0;
    }

    .home-homepage-art-panel__topline,
    .home-homepage-art-panel__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
      color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
      font-family: var(--font-mono);
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .home-homepage-art-panel__headline {
      display: grid;
      gap: 0.1rem;
      margin: 1.25rem 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(2.7rem, 7vw, 5.4rem);
      font-weight: 600;
      line-height: 0.9;
      letter-spacing: -0.08em;
      text-transform: uppercase;
    }

    .home-homepage-art-panel__headline span:nth-child(2),
    .home-homepage-art-panel__headline span:nth-child(3) {
      padding-left: clamp(1rem, 4vw, 2.5rem);
      color: color-mix(in srgb, var(--color-text-primary) 42%, transparent);
    }

    .home-homepage-art-panel__headline span:last-child {
      color: color-mix(in srgb, var(--color-primary) 80%, white 20%);
    }

    .home-homepage-art-panel__rule {
      height: 1px;
      margin: 0 0 1rem;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-border) 70%, transparent),
        color-mix(in srgb, var(--color-primary) 55%, transparent),
        transparent
      );
    }

    .home-homepage-section {
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .home-homepage-section__intro {
      display: grid;
      gap: 0.85rem;
      max-width: 44rem;
      margin-bottom: 2rem;
    }

    .home-homepage-section__title,
    .home-homepage-lane h3,
    .home-homepage-start-item h3,
    .home-homepage-closeout__title {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.45rem, 3vw, 3rem);
      font-weight: 600;
      line-height: 1.02;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .home-homepage-lanes {
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-lane {
      display: grid;
      gap: 1rem;
      padding: 1.35rem 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .home-homepage-lane:hover {
      transform: translateX(4px);
      border-color: color-mix(
        in srgb,
        var(--color-text-primary) 20%,
        transparent
      );
    }

    .home-homepage-lane__meta {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .home-homepage-lane__index {
      color: color-mix(in srgb, var(--color-text-primary) 34%, transparent);
      font-family: var(--font-display);
      font-size: 1.1rem;
      letter-spacing: -0.04em;
    }

    .home-homepage-lane__label {
      color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .home-homepage-lane h3,
    .home-homepage-start-item h3 {
      font-size: clamp(1.3rem, 2vw, 1.8rem);
      margin-bottom: 0.55rem;
    }

    .home-homepage-closing {
      display: grid;
      gap: 2rem;
    }

    .home-homepage-start-list {
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-start-item {
      display: grid;
      gap: 1rem;
      align-items: end;
      padding: 1.25rem 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .home-homepage-start-item span {
      color: var(--color-text-primary);
      font-size: 0.92rem;
      font-weight: 600;
    }

    .home-homepage-start-item:hover {
      transform: translateX(4px);
      border-color: color-mix(
        in srgb,
        var(--color-text-primary) 20%,
        transparent
      );
    }

    .home-homepage-closeout {
      display: grid;
      gap: 1.2rem;
      padding-top: 0.5rem;
    }

    @media (min-width: 960px) {
      .home-homepage-hero__shell {
        grid-template-columns: minmax(0, 1fr) minmax(20rem, 28rem);
      }

      .home-homepage-lane {
        grid-template-columns: 8rem minmax(0, 1fr);
        align-items: start;
      }

      .home-homepage-start-item {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .home-homepage-closeout {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
      }
    }

    @media (max-width: 767px) {
      .home-homepage-hero {
        padding-top: calc(5.8rem + env(safe-area-inset-top));
      }

      .home-homepage-title {
        max-width: 100%;
        font-size: clamp(2.6rem, 12vw, 4.5rem);
      }

      .home-homepage-actions,
      .home-homepage-actions--closeout {
        flex-direction: column;
      }

      .home-homepage-art-panel__headline {
        font-size: clamp(2.3rem, 13vw, 3.8rem);
      }
    }
  </style>
</MarketingLayout>
