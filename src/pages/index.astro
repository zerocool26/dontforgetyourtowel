---
import { Image } from 'astro:assets';

import systemsCutaway from '../assets/chicago-systems-cutaway-v2.png';
import systemsSculpture from '../assets/chicago-systems-sculpture-v2.png';
import CtaBand from '../components/CtaBand.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { processSteps, proofRows, services } from '../data/site';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Technology Consulting & Software Engineering"
  description="Technology strategy, custom software, cloud, cybersecurity, and managed IT from one accountable Chicago team."
  bodyClass="spatial-site"
  mainClass="spatial-home"
>
  <section class="spatial-hero">
    <div class="spatial-hero__visual" aria-hidden="true">
      <Image
        src={systemsSculpture}
        alt=""
        widths={[960, 1280, 1536]}
        sizes="100vw"
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="spatial-hero__wire spatial-hero__wire--one" aria-hidden="true">
    </div>
    <div class="spatial-hero__wire spatial-hero__wire--two" aria-hidden="true">
    </div>
    <div class="shell spatial-hero__inner">
      <div class="spatial-hero__copy">
        <h1>
          <span>Build it like</span>
          <span>you’ll have to</span>
          <span>run it<em>.</em></span>
        </h1>
        <p>
          Strategy, software, cloud, security, and managed IT—designed by one
          accountable Chicago team that stays with the consequences.
        </p>
        <div class="button-row">
          <a class="button" href={withBasePath('contact-hq/')}>Put us to work</a
          >
          <a class="button button--outline-light" href="#what-we-deliver">
            See what we deliver
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="operating-rail" aria-labelledby="ownership-heading">
    <div class="shell operating-rail__inner">
      <h2 id="ownership-heading">A plan is only as good as Monday morning.</h2>
      <ol class="operating-rail__track">
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="spatial-handoff" id="what-we-deliver">
    <div class="shell spatial-handoff__inner">
      <header class="spatial-handoff__heading">
        <span class="spatial-index" aria-hidden="true">01—06</span>
        <h2>The handoff is where ownership disappears.</h2>
        <p>
          Consultants write the plan. Developers ship the build. IT inherits the
          mess. We keep one accountable operating model across all three.
        </p>
      </header>

      <figure class="spatial-handoff__cutaway">
        <Image
          src={systemsCutaway}
          alt="An exploded architectural cutaway of glass, steel, and copper infrastructure layers"
          widths={[640, 960, 1120]}
          sizes="(min-width: 960px) 42vw, 92vw"
          format="webp"
          quality={88}
          loading="lazy"
        />
      </figure>

      <div class="spatial-services">
        {
          services.map(service => (
            <a href={withBasePath(`services/#${service.id}`)}>
              <span class="index-number">{service.number}</span>
              <span class="spatial-services__copy">
                <strong>{service.title}</strong>
                <small>{service.summary}</small>
              </span>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M5 12h13M14 7l5 5-5 5" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="spatial-stages" id="how-we-work">
    <div class="shell spatial-stages__inner">
      <header class="spatial-stages__heading">
        <h2>
          <span>Plan it.</span>
          <span>Build it.</span>
          <span>Secure it.</span>
          <span>Run it.</span>
        </h2>
        <div>
          <p>
            Start with the stage you need. Keep the operating responsibility
            connected through what comes next.
          </p>
          <a class="button button--light" href={withBasePath('contact-hq/')}>
            Put us to work
          </a>
        </div>
      </header>

      <ol class="spatial-stages__stack">
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="spatial-proof">
    <div class="shell spatial-proof__desk">
      <div class="spatial-proof__paper">
        <header>
          <h2>The operating record is the proof.</h2>
          <p>
            The name says #1. The standard has to earn it—through decisions,
            delivery discipline, secure ownership, and a system that works after
            launch.
          </p>
          <a class="text-link" href={withBasePath('trust-center/')}>
            Review our operating standard
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h13M14 7l5 5-5 5"></path>
            </svg>
          </a>
        </header>

        <div class="spatial-proof__ledger">
          {
            proofRows.map(row => (
              <article>
                <span class="index-number">{row.number}</span>
                <h3>{row.title}</h3>
                <p>{row.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</MarketingLayout>
