const platformFocus = [
  {
    title: 'Calmer managed operations',
    copy: 'Support coverage, onboarding, device health, and vendor coordination with cleaner ownership from day one.',
  },
  {
    title: 'Security without theater',
    copy: 'Practical hardening, identity controls, compliance momentum, and leadership-level guidance that still moves fast.',
