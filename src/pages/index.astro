---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import OperationalIntelligenceWorkbench from '../components/business/OperationalIntelligenceWorkbench.tsx';
import ModernButton from '../components/ui/ModernButton.astro';
import { CONTACT_EMAIL } from '../consts';
import { operatingIntelligenceItems } from '../data/operating-intelligence';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake - Olive Chicago')}`;

const workbenchItems = operatingIntelligenceItems.map(item => ({
  ...item,
  ctaHref: withBasePath(item.path),
}));

const heroSignals = [
  {
    label: 'Operate',
    value: 'A support layer someone actually owns.',
    detail:
      'Tickets, devices, onboarding, vendors, and escalation stay visible.',
  },
  {
    label: 'Protect',
    value: 'Security evidence instead of vague reassurance.',
    detail:
      'Identity, endpoints, email, backup, and response contacts get documented.',
  },
  {
    label: 'Present',
    value: 'Digital systems that make the company easier to trust.',
    detail:
      'Pages, forms, portals, and commerce flows are judged by buyer movement.',
  },
];

const siteGuide = [
  {
    label: 'Solutions',
    copy: 'Support, security, Microsoft 365, backup, network, and buyer-facing systems.',
    href: withBasePath('services/'),
  },
  {
    label: 'Pricing',
    copy: 'Ranges, scope drivers, approval logic, and what changes the monthly number.',
    href: withBasePath('pricing/'),
  },
  {
    label: 'Digital proof',
    copy: 'Working screens that show buyer paths, not decorative mockups.',
    href: withBasePath('about/'),
  },
  {
    label: 'Blog',
    copy: 'Practical notes on transitions, backup assumptions, Microsoft 365, and scope.',
    href: withBasePath('blog/'),
  },
  {
    label: 'Briefings',
    copy: 'Short reads on budget, risk, insurance, AI pressure, and operations.',
    href: withBasePath('news/'),
  },
  {
    label: 'Visual library',
    copy: 'Reference material for pages, proposals, launches, and interface direction.',
    href: withBasePath('photos/'),
  },
];

const serviceLanes = [
  {
    index: '01',
    label: 'Operate',
    title: 'Daily IT support with named ownership.',
    copy: 'Help desk, onboarding, patching, device standards, vendor follow-up, and queue clarity.',
    href: withBasePath('services/'),
  },
  {
    index: '02',
    label: 'Protect',
    title: 'Cybersecurity that shows its work.',
    copy: 'MFA, conditional access, endpoint protection, email defense, backup proof, and incident contacts.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '03',
    label: 'Modernize',
    title: 'Microsoft 365 and cloud cleanup that reduces drag.',
    copy: 'Teams, SharePoint, Exchange, licensing, access rules, migrations, and automation candidates.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '04',
    label: 'Present',
    title: 'Selective digital systems for better sales and intake.',
    copy: 'Websites, portals, demos, ecommerce, and contact flows built around trust and movement.',
    href: withBasePath('about/'),
  },
];

const experienceHubs = [
  {
    code: 'DX',
    label: 'Proof',
    title: 'Live commerce and intake behavior',
    copy: 'Carts, comparison, quick views, checkout review, shareable states, and mobile behavior.',
    meta: ['Stateful screens', 'Mobile review', 'Checkout path'],
    href: withBasePath('about/'),
  },
  {
    code: 'JG',
    label: 'Guidance',
    title: 'Field notes for operators and owners',
    copy: 'Short explanations for provider transitions, security posture, backup gaps, and scope.',
    meta: ['Provider switch', 'Backup gaps', 'M365 cleanup'],
    href: withBasePath('blog/'),
  },
  {
    code: 'NP',
    label: 'Signals',
    title: 'Briefings on change that affects operations',
    copy: 'Security requirements, Microsoft changes, AI workflow pressure, and buyer expectations.',
    meta: ['Insurance', 'AI policy', 'M365 changes'],
    href: withBasePath('news/'),
  },
  {
    code: 'PG',
    label: 'Visuals',
    title: 'Photo and design reference library',
    copy: 'Reusable art direction for pages, proposals, launches, and client-facing screens.',
    meta: ['Photo sets', 'Interface studies', 'Launch assets'],
    href: withBasePath('photos/'),
  },
];

const operatingSignals = [
  {
    label: 'Response ownership',
    copy: 'Ticket lanes, escalation rules, vendor follow-through, and a weekly view of what is open or blocked.',
  },
  {
    label: 'Security baseline',
    copy: 'Identity, endpoint, email, backup, admin access, and risky forwarding are checked before new tools.',
  },
  {
    label: 'Executive visibility',
    copy: 'Owners see priorities, risks, renewal pressure, budget signals, and decisions that need attention.',
  },
];

const firstThirtyDays = [
  'Map users, devices, Microsoft 365, network gear, backups, vendors, admin roles, and recurring tickets.',
  'Stabilize urgent support and security gaps before expanding the roadmap.',
  'Turn findings into a 30/60/90-day plan with owners, budget ranges, and a decision point.',
];

const buyerQuestions = [
  {
    title: 'Who really owns the environment after the contract is signed?',
    copy: 'Ticket handling, vendor coordination, onboarding, reporting, backups, and security evidence should all have an owner.',
  },
  {
    title:
      'Can the provider keep up with security, AI, cloud, and workflow change?',
    copy: 'The right partner knows what to standardize, secure, document, automate, and leave alone.',
  },
  {
    title:
      'Can the website, portal, or intake flow help sales instead of slowing it down?',
    copy: 'When digital work is in scope, the goal is trust, fewer dead ends, better mobile behavior, and a cleaner next step.',
  },
];

const startOptions = [
  {
    title: 'Need service coverage?',
    copy: 'Start with support ownership, device hygiene, Microsoft 365, backup, or network stability.',
    href: withBasePath('services/'),
    cta: 'Open solutions hub',
  },
  {
    title: 'Need budget clarity?',
    copy: 'Compare package depth, scope boundaries, user/device assumptions, and co-managed fit.',
    href: withBasePath('pricing/'),
    cta: 'Open pricing guide',
  },
  {
    title: 'Need fit clarity?',
    copy: 'Sort whether the first move is support, security, recovery, Microsoft 365 cleanup, or digital build.',
    href: withBasePath('contact-hq/'),
    cta: 'Open fit intake',
  },
];
---

<MarketingLayout
  title="Olive Chicago | Managed IT, Security, Microsoft 365, and Digital Systems"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and selective digital systems for firms that need steadier operations and a stronger first impression."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-homepage-hero" id="landing-hero" data-page-section>
    <div class="home-homepage-stage home-homepage-stage--full">
      <div
        class="home-homepage-stage__scene"
        data-testid="home-orbit-scene"
        data-home-orbit-root
        role="img"
        aria-label="Interactive 3D operations field showing managed IT, security, and digital proof"
      >
        <canvas
          class="home-orbit-scene__canvas"
          data-home-orbit-canvas
          aria-hidden="true"></canvas>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--intro"
    id="home-intro"
    data-page-section
  >
    <div class="premium-container home-homepage-intro__grid">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">
          Chicago managed IT + practical digital systems
        </p>
        <h1 class="home-homepage-title">
          Olive Chicago managed IT for companies that need technology to stay
          owned.
        </h1>
        <p class="home-homepage-copy">
          Support, cybersecurity, Microsoft 365, cloud, backup, networking, and
          selective digital systems for Chicago-area teams with no room for
          unclear ownership.
        </p>
        <p class="home-homepage-claim">
          Start with the loose end: recurring tickets, stale access, backup
          uncertainty, vendor confusion, or a site that no longer reflects the
          business.
        </p>

        <div class="home-homepage-actions">
          <ModernButton
            href={withBasePath('services/')}
            variant="gradient"
            className="min-h-[52px]"
            rounded="sm"
          >
            View solutions
          </ModernButton>
          <ModernButton
            href={withBasePath('pricing/')}
            variant="outline"
            className="min-h-[52px]"
            rounded="sm"
          >
            See pricing
          </ModernButton>
          <ModernButton
            href={withBasePath('contact-hq/')}
            variant="secondary"
            className="min-h-[52px]"
            rounded="sm"
          >
            Start fit check
          </ModernButton>
        </div>

        <div class="home-homepage-jump-links" aria-label="Popular routes">
          {
            siteGuide.slice(0, 4).map(item => (
              <a class="home-homepage-jump" href={item.href}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="home-homepage-signal-grid" aria-label="Landing proof signals">
        {
          heroSignals.map(signal => (
            <article class="home-homepage-signal-card">
              <p class="home-homepage-signal-card__label">{signal.label}</p>
              <h2>{signal.value}</h2>
              <p>{signal.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--guide"
    id="guide"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Start here</p>
        <h2 class="home-homepage-section__title">
          Find the first useful move.
        </h2>
        <p class="home-homepage-section__copy">
          Most buyers arrive with one of four questions: who owns support, are
          the basics secure, what will this cost, or is the front door hurting
          trust.
        </p>
      </div>

      <div class="home-homepage-guide__grid" aria-label="Site guide">
        {
          siteGuide.map(item => (
            <a class="home-homepage-guide__item" href={item.href}>
              <span>{item.label}</span>
              <p>{item.copy}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--workbench"
    id="operations-workbench"
    data-page-section
  >
    <div class="premium-container">
      <OperationalIntelligenceWorkbench
        client:only="preact"
        items={workbenchItems}
        defaultItemId="support-ownership"
        eyebrow="Expert operating layer"
        title="A working diagnostic for support, security, recovery, Microsoft 365, and digital trust."
        description="This is the layer that should make the site feel useful: choose a pressure point, inspect the signals, collect the evidence, and move into the right next route with a real handoff brief."
      />
    </div>
  </section>

  <section class="home-homepage-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">What we do</p>
        <h2 class="home-homepage-section__title">
          Four lanes, one operating standard.
        </h2>
        <p class="home-homepage-section__copy">
          Run the daily IT layer, harden the security baseline, clean up
          Microsoft 365 and cloud systems, and build digital surfaces when they
          support sales or service.
        </p>
      </div>

      <div class="home-homepage-lanes">
        {
          serviceLanes.map(lane => (
            <a class="home-homepage-lane" href={lane.href}>
              <div class="home-homepage-lane__meta">
                <span class="home-homepage-lane__index">{lane.index}</span>
                <span class="home-homepage-lane__label">{lane.label}</span>
              </div>
              <div class="home-homepage-lane__body">
                <h3>{lane.title}</h3>
                <p>{lane.copy}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--experience"
    id="experience-hubs"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Featured experiences</p>
        <h2 class="home-homepage-section__title">
          Proof should be inspectable.
        </h2>
        <p class="home-homepage-section__copy">
          Working examples, briefings, and visual references show how the
          company thinks, builds, and explains technical work before a call.
        </p>
      </div>

      <div class="home-homepage-experience-grid">
        {
          experienceHubs.map(item => (
            <a class="home-homepage-experience-card" href={item.href}>
              <div class="home-homepage-experience-card__topline">
                <span class="home-homepage-experience-card__code">
                  {item.code}
                </span>
                <span class="home-homepage-experience-card__label">
                  {item.label}
                </span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <div class="home-homepage-experience-card__meta">
                {item.meta.map(meta => (
                  <span>{meta}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--questions"
    id="buyer-realities"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">Buyer realities</p>
        <h2 class="home-homepage-section__title">
          The real buying questions are practical.
        </h2>
        <p class="home-homepage-section__copy">
          A strong MSP site should answer ownership, risk, budget, evidence, and
          what happens after the first conversation.
        </p>
      </div>

      <div class="home-homepage-realities">
        {
          buyerQuestions.map(item => (
            <article class="home-homepage-reality">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section"
    id="operating-standard"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-operating">
        <div class="home-homepage-section__intro">
          <p class="home-homepage-eyebrow">Operating standard</p>
          <h2 class="home-homepage-section__title">
            The first phase is about control, evidence, and fewer loose ends.
          </h2>
          <p class="home-homepage-section__copy">
            Intake separates urgent support, security, and continuity work from
            longer cleanup. Leadership sees what happens now, what waits, and
            what it should cost.
          </p>
        </div>

        <div class="home-homepage-operating__grid">
          <div class="home-homepage-operating__signals">
            {
              operatingSignals.map(signal => (
                <article class="home-homepage-signal">
                  <h3>{signal.label}</h3>
                  <p>{signal.copy}</p>
                </article>
              ))
            }
          </div>

          <div class="home-homepage-first30" aria-labelledby="first30-title">
            <p class="home-homepage-eyebrow">First 30 days</p>
            <h3 id="first30-title">
              A practical start before the longer roadmap.
            </h3>
            <ol>
              {firstThirtyDays.map(item => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--closing"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-closing">
        <div class="home-homepage-closing__intro">
          <p class="home-homepage-eyebrow">Choose the next move</p>
          <h2 class="home-homepage-section__title">
            Start where the uncertainty is highest.
          </h2>
          <p class="home-homepage-section__copy">
            Choose the path that answers the first decision cleanly: service
            coverage, budget shape, or whether the work is a fit.
          </p>
        </div>

        <div class="home-homepage-start-list">
          {
            startOptions.map(option => (
              <a class="home-homepage-start-item" href={option.href}>
                <div>
                  <h3>{option.title}</h3>
                  <p>{option.copy}</p>
                </div>
                <span>{option.cta}</span>
              </a>
            ))
          }
        </div>

        <div class="home-homepage-closeout tone-cta-band">
          <div>
            <p class="home-homepage-eyebrow">Ready to move</p>
            <h3 class="home-homepage-closeout__title">
              Make the operating layer easier to own and the digital front door
              easier to trust.
            </h3>
            <p class="home-homepage-closeout__copy">
              The first conversation should identify the pressure point, risk,
              likely cost range, owner, and first outcome worth proving.
            </p>
          </div>

          <div class="home-homepage-actions home-homepage-actions--closeout">
            <ModernButton
              href={contactHref}
              variant="gradient"
              className="min-h-[52px]"
            >
              Book intake
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Review pricing
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home-orbit-scene';
  </script>

  <style>
    .home-homepage-hero,
    .home-homepage-section {
      position: relative;
      padding: clamp(4rem, 8vw, 7rem) 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-hero {
      isolation: isolate;
      overflow: hidden;
      min-height: calc(100svh - 4.35rem);
      padding: 0;
      background:
        linear-gradient(
          135deg,
          color-mix(in srgb, var(--color-primary) 8%, transparent),
          transparent 38%,
          color-mix(in srgb, var(--color-primary-strong) 6%, transparent)
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-background) 92%, black 8%),
          color-mix(in srgb, var(--color-surface) 66%, black 34%)
        );
    }

    .home-homepage-intro__grid,
    .home-homepage-operating__grid,
    .home-homepage-closing,
    .home-homepage-guide__grid,
    .home-homepage-lanes,
    .home-homepage-experience-grid,
    .home-homepage-realities,
    .home-homepage-signal-grid {
      display: grid;
      gap: 1rem;
    }

    .home-homepage-section__intro,
    .home-homepage-closing__intro {
      display: grid;
      gap: 0.95rem;
    }

    .home-homepage-section--intro {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-background) 94%, transparent),
          transparent 72%
        ),
        color-mix(in srgb, var(--color-surface) 24%, transparent);
    }

    .home-homepage-intro__grid {
      align-items: start;
      gap: clamp(1.25rem, 3vw, 2rem);
    }

    .home-homepage-eyebrow {
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
    }

    .home-homepage-title,
    .home-homepage-section__title,
    .home-homepage-lane h3,
    .home-homepage-experience-card h3,
    .home-homepage-reality h3,
    .home-homepage-signal h3,
    .home-homepage-first30 h3,
    .home-homepage-start-item h3,
    .home-homepage-closeout__title,
    .home-homepage-signal-card h2 {
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-weight: 650;
      letter-spacing: 0;
      line-height: 1.02;
      text-wrap: balance;
    }

    .home-homepage-title {
      max-width: 15ch;
      font-size: clamp(2.35rem, 5.2vw, 5.2rem);
    }

    .home-homepage-section__title,
    .home-homepage-closeout__title {
      max-width: 18ch;
      font-size: clamp(1.7rem, 3vw, 3rem);
    }

    .home-homepage-copy,
    .home-homepage-claim,
    .home-homepage-section__copy,
    .home-homepage-lane p,
    .home-homepage-guide__item p,
    .home-homepage-experience-card p,
    .home-homepage-reality p,
    .home-homepage-signal p,
    .home-homepage-first30 li,
    .home-homepage-start-item p,
    .home-homepage-closeout__copy,
    .home-homepage-signal-card p {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 96%, transparent);
      font-size: clamp(1rem, 1.15vw, 1.08rem);
      line-height: 1.72;
    }

    .home-homepage-claim {
      max-width: 48rem;
      border-left: 1px solid
        color-mix(in srgb, var(--color-primary) 42%, transparent);
      padding-left: 1rem;
      color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
      font-size: clamp(0.98rem, 1.1vw, 1.05rem);
    }

    .home-homepage-actions,
    .home-homepage-jump-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .home-homepage-jump {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      border-radius: 0.5rem;
      border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
      background: color-mix(in srgb, var(--color-surface) 80%, transparent);
      padding: 0 0.95rem;
      color: color-mix(in srgb, var(--color-text-primary) 78%, transparent);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition:
        border-color 0.2s ease,
        transform 0.2s ease,
        background 0.2s ease;
    }

    .home-homepage-jump:hover {
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
      background: color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 10%,
        transparent
      );
    }

    .home-homepage-stage {
      position: relative;
      overflow: hidden;
      min-height: clamp(26rem, 58vw, 42rem);
      border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
      border-radius: 0;
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-surface) 96%, white 2%),
          color-mix(in srgb, var(--color-background) 92%, transparent)
        ),
        color-mix(in srgb, var(--color-background) 96%, black 4%);
      box-shadow: none;
    }

    .home-homepage-stage--full {
      position: absolute;
      inset: 0;
      min-height: 100%;
      border: 0;
      border-radius: 0;
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--color-primary) 10%, transparent),
          transparent 38%,
          color-mix(in srgb, var(--color-primary-strong) 8%, transparent)
        ),
        color-mix(in srgb, var(--color-background) 96%, black 4%);
      box-shadow: none;
    }

    .home-homepage-stage::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-border) 18%, transparent) 1px,
          transparent 1px
        ),
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-border) 14%, transparent) 1px,
          transparent 1px
        );
      background-size: 64px 64px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 88%);
      opacity: 0.38;
    }

    .home-homepage-stage--full::before {
      background-size: clamp(2.7rem, 6vw, 5rem) clamp(2.7rem, 6vw, 5rem);
      mask-image: radial-gradient(
        circle at 50% 48%,
        rgba(0, 0, 0, 0.62),
