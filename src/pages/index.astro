---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import SignalCabinet from '../components/business/SignalCabinet.astro';
import { CONTACT_EMAIL } from '../consts';
import {
  tradeProfiles,
  tradePrograms,
  totalTradeSubpages,
} from '../data/trades';
import { getTradeOperations } from '../data/trade-operations';
import { servicesExtended } from '../data/services-extended';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Project inquiry — Olive Global Systems')}`;

const tradeHighlights = tradeProfiles.map(trade => ({
  trade,
  operations: getTradeOperations(trade.slug),
}));

const landingSignalItems = tradeHighlights
  .slice(0, 4)
  .map(({ trade, operations }) => ({
    kicker: trade.shortName,
    title: trade.name,
    detail: operations.operatingModel,
    meta: [
      operations.serviceRhythm,
      operations.ownerOutputs[0] ?? trade.summary,
    ],
  }));

const operatingHighlights = [
  {
    label: 'Service divisions',
    value: `${tradeProfiles.length}`,
    note: 'Mechanical, electrical, plumbing, general contracting, commercial HVAC, auto repair, and managed technology.',
  },
  {
    label: 'Specialist routes',
    value: `${totalTradeSubpages}+`,
    note: 'Dedicated pages for retrofit delivery, controls, site logistics, service bays, and managed operations.',
  },
  {
    label: 'Retained services',
    value: `${servicesExtended.length}+`,
    note: 'Managed IT, security, cloud, automation, ecommerce, AI, and digital systems remain part of the delivery stack.',
  },
];

const platformFocus = [
  {
    title: 'Capital projects and phased renovations',
    copy: 'General contracting, MEP trades, and HVAC are organized around access, shutdowns, sequencing, and turnover — not just isolated scopes.',
  },
  {
    title: 'Occupied buildings and continuity-sensitive work',
    copy: 'Mechanical, electrical, plumbing, and HVAC delivery are framed around keeping facilities usable while work progresses.',
  },
  {
    title: 'Managed operations and technology delivery',
    copy: 'MSP, security, cloud, AI, and business systems are visible alongside the field-facing trades instead of hidden on a disconnected tech page.',
  },
];

const marketSectors = Array.from(
  new Set(
    tradeProfiles.flatMap(trade => trade.sectors.map(sector => sector.name))
  )
).slice(0, 6);

const deliveryStages = [
  {
    step: '01',
    title: 'Scope the work in operational terms',
    copy: 'Start with the constraints that actually matter: access, shutdowns, occupancy, support coverage, risk, and owner outcomes.',
  },
  {
    step: '02',
    title: 'Assign the right lane and interfaces',
    copy: 'Each trade or service lane keeps its own operating model, while connected trades are surfaced early instead of discovered late.',
  },
  {
    step: '03',
    title: 'Execute against readiness, not assumptions',
    copy: 'Release work based on actual room readiness, outage windows, controls dependencies, field verification, and service routing.',
  },
  {
    step: '04',
    title: 'Close out with usable owner outputs',
    copy: 'Turnover focuses on startup logs, asset information, operating documentation, punch control, and clear next actions.',
  },
];
---

<MarketingLayout
  title="Olive Global Systems | Integrated Trade And Technology Delivery"
  description="Integrated delivery across seven service divisions, from capital projects and occupied-building trade work to managed IT, security, cloud, and automation."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="relative min-h-[100dvh] overflow-hidden border-b border-white/10"
    id="landing-hero"
    data-page-section
    data-olive-universe="ready"
    data-olive-mobile-3d="optimized"
    data-olive-mode="lite"
  >
    <div aria-hidden="true" class="absolute inset-0">
      <canvas data-hero-canvas="true" class="block h-full w-full"></canvas>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.06),transparent_30%),linear-gradient(180deg,rgba(8,17,29,0.16),rgba(8,17,29,0.82)_72%,rgba(8,17,29,0.96))]"
      >
      </div>
    </div>

    <div
      class="relative z-10 mx-auto max-w-[1240px] px-4 pb-20 pt-28 sm:px-6 sm:pb-24 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div class="space-y-7">
          <div class="space-y-3">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Olive Global Systems
            </p>
            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
            >
              Creative technology and integrated trade delivery built around
              real operating constraints.
            </h1>
            <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
              This site now leads with what matters most: what each division
              actually does, how work is delivered, where trades connect, and
              what buyers should expect before starting a project.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Explore service divisions
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open services hub
            </ModernButton>
            <ModernButton
              href={contactHref}
              variant="outline"
              className="min-h-[50px]"
            >
              Send a project brief
            </ModernButton>
          </div>

          <div data-olive-links class="flex flex-wrap gap-2 pt-1">
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('trades/')}>Trades</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('services/')}>Services</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('about/')}>About</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('build-studio/')}>Build studio</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('contact-hq/')}>Contact</a
            >
          </div>

          <dl class="grid gap-4 pt-4 sm:grid-cols-3">
            {
              operatingHighlights.map(item => (
                <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
                  <dt class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45">
                    {item.label}
                  </dt>
                  <dd class="mt-3 text-3xl font-semibold tracking-tight text-white">
                    {item.value}
                  </dd>
                  <dd class="mt-3 text-sm leading-6 text-slate-300">
                    {item.note}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <ModernCard variant="glass" className="p-7 sm:p-8">
          <div class="space-y-6">
            <div>
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-white/50"
              >
                What to expect
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                A simpler front door with clearer service ownership.
              </p>
            </div>

            <div class="space-y-4">
              {
                platformFocus.map(item => (
                  <div class="border-l border-white/10 pl-4">
                    <p class="text-sm font-semibold text-white">{item.title}</p>
                    <p class="mt-2 text-sm leading-6 text-slate-300">
                      {item.copy}
                    </p>
                  </div>
                ))
              }
            </div>

            <div class="border-t border-white/10 pt-5">
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
              >
                Common sectors
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  marketSectors.map(sector => (
                    <span class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200">
                      {sector}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const paintHeroCanvases = () => {
        document
          .querySelectorAll('canvas[data-hero-canvas="true"]')
          .forEach(node => {
            if (!(node instanceof HTMLCanvasElement)) return;

            const rect = node.getBoundingClientRect();
            const width = Math.max(Math.floor(rect.width), 1);
            const height = Math.max(Math.floor(rect.height), 1);
            const ratio = Math.min(window.devicePixelRatio || 1, 2);

            node.width = Math.floor(width * ratio);
            node.height = Math.floor(height * ratio);

            const context = node.getContext('2d');
            if (!context) return;

            context.setTransform(ratio, 0, 0, ratio, 0, 0);
            context.clearRect(0, 0, width, height);

            const base = context.createLinearGradient(0, 0, 0, height);
            base.addColorStop(0, '#102033');
            base.addColorStop(0.52, '#0d1727');
            base.addColorStop(1, '#08111d');
            context.fillStyle = base;
            context.fillRect(0, 0, width, height);

            const glowLeft = context.createRadialGradient(
              width * 0.18,
              height * 0.14,
              0,
              width * 0.18,
              height * 0.14,
              width * 0.34
            );
            glowLeft.addColorStop(0, 'rgba(191, 219, 254, 0.42)');
            glowLeft.addColorStop(1, 'rgba(191, 219, 254, 0)');
            context.fillStyle = glowLeft;
            context.fillRect(0, 0, width, height);

            const glowRight = context.createRadialGradient(
              width * 0.84,
              height * 0.1,
              0,
              width * 0.84,
              height * 0.1,
              width * 0.28
            );
            glowRight.addColorStop(0, 'rgba(125, 211, 252, 0.24)');
            glowRight.addColorStop(1, 'rgba(125, 211, 252, 0)');
            context.fillStyle = glowRight;
            context.fillRect(0, 0, width, height);

            context.strokeStyle = 'rgba(255, 255, 255, 0.08)';
            context.lineWidth = 1;
            const gridSize = Math.max(Math.round(width / 18), 44);

            for (let x = 0; x <= width; x += gridSize) {
              context.beginPath();
              context.moveTo(x, 0);
              context.lineTo(x, height);
              context.stroke();
            }

            for (let y = 0; y <= height; y += gridSize) {
              context.beginPath();
              context.moveTo(0, y);
              context.lineTo(width, y);
              context.stroke();
            }

            context.strokeStyle = 'rgba(147, 197, 253, 0.4)';
            context.lineWidth = 2;
            context.beginPath();
            context.moveTo(width * 0.08, height * 0.72);
            context.bezierCurveTo(
              width * 0.24,
              height * 0.58,
              width * 0.42,
              height * 0.82,
              width * 0.58,
              height * 0.6
            );
            context.bezierCurveTo(
              width * 0.68,
              height * 0.46,
              width * 0.8,
              height * 0.64,
              width * 0.92,
              height * 0.42
            );
            context.stroke();

            context.fillStyle = 'rgba(255, 255, 255, 0.65)';
            [
              [0.18, 0.32],
              [0.38, 0.54],
              [0.61, 0.38],
              [0.81, 0.22],
            ].forEach(([x, y]) => {
              context.beginPath();
              context.arc(width * x, height * y, 5, 0, Math.PI * 2);
              context.fill();
            });
          });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', paintHeroCanvases, {
          once: true,
        });
      } else {
        paintHeroCanvases();
      }

      window.addEventListener('resize', paintHeroCanvases);
      document.addEventListener('astro:page-load', paintHeroCanvases);
    })();
  </script>

  <section
    class="border-b border-white/10"
    id="signal-cabinet"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <SignalCabinet
        eyebrow="Operational signals"
        title="Compare how the core divisions actually behave."
        description="This interactive layer keeps the landing page useful: click through the lead divisions to see how operating model, service rhythm, and owner outputs differ before you go deeper."
        accent="#93c5fd"
        items={landingSignalItems}
      />
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="focus"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Where the platform is strongest
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Delivery lanes built for projects, facilities, and ongoing operations.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          The site now emphasizes practical fit instead of generic claims. These
          are the main problem spaces the platform is designed to handle.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          platformFocus.map(item => (
            <ModernCard variant="default" className="h-full p-7">
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
        <ModernCard variant="default" className="h-full p-7">
          <h3 class="text-lg font-semibold text-white">
            AI Orchestration & Advanced Dev
          </h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            The technology lane still covers AI integration, workflow
            automation, advanced application support, and business systems work
            when the right starting point is digital rather than field-led.
          </p>
        </ModernCard>
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="directory"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-3xl space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Service divisions
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Each division has its own operating model, service rhythm, and owner
            output.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            Instead of hiding everything behind style, the homepage now surfaces
            the basic operating logic for each lane so buyers can orient
            quickly.
          </p>
        </div>

        <ModernButton
          href={withBasePath('trades/')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          View full trade directory
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          tradeHighlights.map(({ trade, operations }) => (
            <a
              href={withBasePath(`trades/${trade.slug}/`)}
              class="hover:border-white/18 group rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:bg-white/[0.05]"
              style={`--trade-accent:${trade.accent};`}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div
                    class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border text-sm font-semibold uppercase tracking-[0.18em] text-white"
                    style={`border-color:color-mix(in srgb, var(--trade-accent) 40%, rgba(255,255,255,0.12)); background:color-mix(in srgb, var(--trade-accent) 16%, transparent);`}
                  >
                    {trade.badge}
                  </div>
                  <p class="mt-4 text-xs uppercase tracking-[0.22em] text-white/45">
                    {trade.eyebrow}
                  </p>
                </div>

                <span class="rounded-full border border-white/10 px-3 py-1 text-[0.65rem] uppercase tracking-[0.22em] text-white/55">
                  {trade.shortName}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-semibold text-white">
                {trade.name}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {trade.summary}
              </p>

              <dl class="mt-6 space-y-4 border-t border-white/10 pt-5 text-sm">
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Operating model
                  </dt>
                  <dd class="mt-1 text-slate-100">
                    {operations.operatingModel}
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Service rhythm
                  </dt>
                  <dd class="mt-1 text-slate-300">
                    {operations.serviceRhythm}
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Typical project window
                  </dt>
                  <dd class="mt-1 text-slate-300">
                    {operations.projectWindow}
                  </dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="delivery"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Delivery model
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          The site now explains how work moves, not just what the brand says.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          A more professional site should help a buyer understand the workflow.
          These four stages are the spine of the new homepage structure.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          deliveryStages.map(stage => (
            <ModernCard variant="outline" className="h-full p-6">
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/45">
                {stage.step}
              </p>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {stage.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{stage.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="programs"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Cross-trade programs
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Some client needs cross more than one lane. That relationship is now
          visible.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Rather than forcing every buyer into a single silo, the homepage now
          shows how recurring program types combine the right trades and
          outputs.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          tradePrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45">
                {program.tradeSlugs.length} linked trades
              </p>
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                  Typical outputs
                </p>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                  {program.outputs.map(output => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-300" />
                      <span>{output}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative" id="contact" data-page-section data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div class="space-y-4">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Get started
            </p>
            <h2
              class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Need the right division, the right starting scope, or the right
              program shape?
            </h2>
            <p class="max-w-2xl text-base leading-7 text-slate-300">
              Browse the trade directory, work through the services hub, or send
              a brief describing your facility, project, environment, or
              operational problem. The site is now organized to make that first
              step easier.
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
          >
            <ModernButton
              href={withBasePath('trades/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Browse all divisions
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review pricing and scope
            </ModernButton>
            <ModernButton
              href={contactHref}
              variant="outline"
              className="min-h-[50px]"
            >
              Email a project brief
            </ModernButton>
          </div>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
