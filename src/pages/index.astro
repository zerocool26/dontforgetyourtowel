---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake - Olive Global Systems')}`;

const serviceLanes = [
  {
    index: '01',
    label: 'Operate',
    title: 'Managed IT with ownership',
    copy: 'Support, device health, onboarding, vendors, and day-to-day operational follow-through under one accountable team.',
    href: withBasePath('services/'),
    cta: 'Explore operations',
  },
  {
    index: '02',
    label: 'Secure',
    title: 'Security that reads clearly to leadership',
    copy: 'Identity, endpoint posture, compliance progress, and practical hardening without fear-marketing or audit theater.',
    href: withBasePath('services/#technology-catalog'),
    cta: 'Review security',
  },
  {
    index: '03',
    label: 'Modernize',
    title: 'Cloud, AI, and automation tied to leverage',
    copy: 'Modernization work shaped around speed, visibility, and lower operational drag instead of trend chasing.',
    href: withBasePath('build-studio/'),
    cta: 'Open the studio',
  },
  {
    index: '04',
    label: 'Present',
    title: 'Buyer-facing systems that look premium',
    copy: 'Web experiences, demos, and launch surfaces designed to improve trust, first impression, and close rate on mobile first.',
    href: withBasePath('about/'),
    cta: 'See proof',
  },
];

const routeCards = [
  {
    title: 'Need exact service coverage?',
    copy: 'Go straight to the solutions hub for the full MSP+, security, cloud, and automation structure.',
    href: withBasePath('services/'),
    cta: 'Open solutions',
  },
  {
    title: 'Need scope and budget clarity?',
    copy: 'Use pricing when the real question is support depth, rollout shape, or what changes cost.',
    href: withBasePath('pricing/'),
    cta: 'Review pricing',
  },
  {
    title: 'Need to shape a project fast?',
    copy: 'Use the studio to turn a rough need into a cleaner brief before the first call.',
    href: withBasePath('build-studio/'),
    cta: 'Start the brief',
  },
];

const proofSignals = [
  'Mobile-first execution',
  'Executive-level clarity',
  'One accountable operating partner',
];
---

<MarketingLayout
  title="Olive Global Systems | Managed IT, Security, and Premium Web Systems"
  description="Managed IT, security, cloud, AI, automation, and premium buyer-facing systems for companies that need to run cleaner and sell sharper."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="landing-hero tone-section-divider"
    id="landing-hero"
    data-page-section
  >
    <div class="premium-container">
      <div class="landing-hero__shell">
        <div class="landing-hero__copy">
          <p class="landing-eyebrow">Chicago systems studio</p>
          <h1 class="landing-title">
            Managed IT, security, and premium web systems for companies that
            need to look sharper and run cleaner.
          </h1>
          <p class="landing-copy">
            Olive is built for teams that are done with reactive support, vague
            modernization plans, and buyer-facing experiences that look cheaper
            than the work behind them.
          </p>

          <div class="landing-actions">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[54px]"
            >
              Start strategy intake
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[54px]"
            >
              Explore solutions
            </ModernButton>
          </div>

          <div class="landing-proof-strip" aria-label="Core positioning">
            {
              proofSignals.map(signal => (
                <span class="landing-proof-strip__item">{signal}</span>
              ))
            }
          </div>
        </div>

        <div class="landing-stage" aria-hidden="true">
          <div class="landing-stage__frame">
            <div class="landing-stage__rail">
              <span>Operate</span>
              <span>Secure</span>
              <span>Modernize</span>
              <span>Present</span>
            </div>

            <div class="landing-stage__headline">
              <span>Systems</span>
              <span>that</span>
              <span>close.</span>
            </div>

            <div class="landing-stage__grid">
              <div class="landing-stage__panel">
                <p class="landing-stage__panel-label">What changes</p>
                <p class="landing-stage__panel-value">
                  Less noise. More ownership. Better buyer confidence.
                </p>
              </div>
              <div class="landing-stage__panel landing-stage__panel--compact">
                <p class="landing-stage__panel-label">Built for</p>
                <p class="landing-stage__panel-value">mobile first</p>
              </div>
              <div class="landing-stage__panel landing-stage__panel--accent">
                <p class="landing-stage__panel-label">Positioning</p>
                <p class="landing-stage__panel-value">
                  Premium execution without empty visual tricks.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="landing-section__intro">
        <p class="landing-section__eyebrow">What we handle</p>
        <h2 class="landing-section__title">
          Four clear lanes. No cluttered homepage maze.
        </h2>
        <p class="landing-section__copy">
          The homepage should tell buyers exactly what you do in one screen. If
          they need detail, the deeper routes are already there.
        </p>
      </div>

      <div class="landing-lane-grid">
        {
          serviceLanes.map(lane => (
            <ModernCard variant="glass" className="landing-lane p-6">
              <div class="landing-lane__meta">
                <span class="landing-lane__index">{lane.index}</span>
                <span class="landing-lane__label">{lane.label}</span>
              </div>
              <h3 class="landing-lane__title">{lane.title}</h3>
              <p class="landing-lane__copy">{lane.copy}</p>
              <a class="landing-lane__link" href={lane.href}>
                {lane.cta}
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="landing-section landing-section--routes"
    id="next-step"
    data-page-section
  >
    <div class="premium-container">
      <div class="landing-section__intro landing-section__intro--split">
        <div>
          <p class="landing-section__eyebrow">Choose the right next move</p>
          <h2 class="landing-section__title">
            The homepage should create direction, not force a scavenger hunt.
          </h2>
        </div>
        <p class="landing-section__copy">
          Pick the route that matches the real question: coverage, pricing, or
          project shaping.
        </p>
      </div>

      <div class="landing-route-grid">
        {
          routeCards.map(route => (
            <ModernCard variant="default" className="landing-route p-6">
              <h3 class="landing-route__title">{route.title}</h3>
              <p class="landing-route__copy">{route.copy}</p>
              <a class="landing-route__link" href={route.href}>
                {route.cta}
              </a>
            </ModernCard>
          ))
        }
      </div>

      <div class="landing-closeout">
        <div>
          <p class="landing-closeout__eyebrow">Ready to move</p>
          <h3 class="landing-closeout__title">
            If the current setup is slowing response, trust, or conversion, fix
            the front door and the operating layer together.
          </h3>
        </div>

        <div class="landing-actions landing-actions--closeout">
          <ModernButton
            href={contactHref}
            variant="primary"
            className="min-h-[52px]"
          >
            Book intake
          </ModernButton>
          <ModernButton
            href={withBasePath('pricing/')}
            variant="outline"
            className="min-h-[52px]"
          >
            See pricing
          </ModernButton>
        </div>
      </div>
    </div>
  </section>

  <style>
    .landing-hero {
      position: relative;
      overflow: clip;
      padding: clamp(6.5rem, 8vw, 8rem) 0 clamp(3.5rem, 6vw, 5rem);
    }

    .landing-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(
          circle at 18% 12%,
          rgba(190, 165, 122, 0.12),
          transparent 28%
        ),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 18%);
      pointer-events: none;
    }

    .landing-hero__shell {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 2rem;
      align-items: center;
    }

    .landing-hero__copy {
      display: grid;
      gap: 1.25rem;
      max-width: 42rem;
    }

    .landing-eyebrow,
    .landing-section__eyebrow,
    .landing-closeout__eyebrow,
    .landing-stage__panel-label {
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--color-text-muted) 86%, transparent);
    }

    .landing-title {
      max-width: 11ch;
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6.4rem);
      font-weight: 600;
      line-height: 0.94;
      letter-spacing: -0.06em;
      text-wrap: balance;
    }

    .landing-copy,
    .landing-section__copy,
    .landing-lane__copy,
    .landing-route__copy {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
      font-size: clamp(1rem, 1.45vw, 1.1rem);
      line-height: 1.72;
    }

    .landing-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .landing-proof-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-top: 0.25rem;
    }

    .landing-proof-strip__item {
      display: inline-flex;
      min-height: 2.2rem;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.03);
      padding: 0.45rem 0.85rem;
      color: rgba(243, 238, 231, 0.84);
      font-size: 0.82rem;
      line-height: 1;
    }

    .landing-stage {
      position: relative;
    }

    .landing-stage__frame {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 2rem;
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.04),
          rgba(255, 255, 255, 0.01)
        ),
        linear-gradient(135deg, rgba(190, 165, 122, 0.08), transparent 36%),
        rgba(12, 15, 19, 0.88);
      padding: clamp(1.2rem, 2vw, 1.6rem);
      box-shadow: 0 28px 64px -46px rgba(0, 0, 0, 0.72);
    }

    .landing-stage__frame::before {
      content: '';
      position: absolute;
      inset: 1rem;
      border-radius: 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.06);
      pointer-events: none;
    }

    .landing-stage__rail {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .landing-stage__rail span {
      display: inline-flex;
      min-height: 2rem;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.35rem 0.75rem;
      color: rgba(243, 238, 231, 0.68);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .landing-stage__headline {
      display: grid;
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(2.6rem, 8vw, 6rem);
      font-weight: 600;
      line-height: 0.9;
      letter-spacing: -0.08em;
      text-transform: uppercase;
    }

    .landing-stage__headline span:nth-child(2) {
      padding-left: clamp(1rem, 5vw, 3rem);
      color: rgba(243, 238, 231, 0.46);
    }

    .landing-stage__headline span:nth-child(3) {
      color: color-mix(in srgb, var(--color-primary) 74%, white 26%);
    }

    .landing-stage__grid {
      display: grid;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .landing-stage__panel {
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.2rem;
      background: rgba(255, 255, 255, 0.03);
      padding: 1rem;
    }

    .landing-stage__panel--compact {
      max-width: 16rem;
    }

    .landing-stage__panel--accent {
      background: linear-gradient(
        135deg,
        rgba(190, 165, 122, 0.08),
        rgba(255, 255, 255, 0.02)
      );
    }

    .landing-stage__panel-value {
      margin: 0.5rem 0 0;
      color: rgba(243, 238, 231, 0.9);
      font-size: 1rem;
      line-height: 1.55;
    }

    .landing-section {
      padding: clamp(3.75rem, 7vw, 5.5rem) 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .landing-section__intro {
      display: grid;
      gap: 0.9rem;
      max-width: 44rem;
      margin-bottom: 2rem;
    }

    .landing-section__intro--split {
      max-width: 100%;
    }

    .landing-section__title,
    .landing-closeout__title,
    .landing-lane__title,
    .landing-route__title {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.5rem, 3vw, 3rem);
      font-weight: 600;
      line-height: 1;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .landing-lane-grid,
    .landing-route-grid {
      display: grid;
      gap: 1rem;
    }

    .landing-lane,
    .landing-route {
      min-height: 100%;
    }

    .landing-lane__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .landing-lane__index {
      color: rgba(243, 238, 231, 0.34);
      font-family: var(--font-display);
      font-size: 1.25rem;
      letter-spacing: -0.04em;
    }

    .landing-lane__label {
      color: rgba(243, 238, 231, 0.52);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .landing-lane__title,
    .landing-route__title {
      font-size: clamp(1.3rem, 2vw, 1.9rem);
      margin-bottom: 0.75rem;
    }

    .landing-lane__link,
    .landing-route__link {
      display: inline-flex;
      margin-top: 1.2rem;
      color: var(--color-text-primary);
      font-size: 0.9rem;
      font-weight: 600;
    }

    .landing-closeout {
      display: grid;
      gap: 1.25rem;
      margin-top: 1.5rem;
      padding: 1.35rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.5rem;
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.03),
        rgba(255, 255, 255, 0.01)
      );
    }

    @media (min-width: 960px) {
      .landing-hero__shell {
        grid-template-columns: minmax(0, 1fr) minmax(22rem, 32rem);
      }

      .landing-section__intro--split {
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
        align-items: end;
      }

      .landing-lane-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .landing-route-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .landing-closeout {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
      }
    }

    @media (max-width: 767px) {
      .landing-hero {
        padding-top: calc(6rem + env(safe-area-inset-top));
      }

      .landing-title {
        max-width: 100%;
        font-size: clamp(2.4rem, 12vw, 4rem);
      }

      .landing-actions,
      .landing-actions--closeout {
        flex-direction: column;
      }

      .landing-stage__headline {
        font-size: clamp(2.4rem, 15vw, 4rem);
      }

      .landing-stage__panel--compact {
        max-width: none;
      }
    }
  </style>
</MarketingLayout>
