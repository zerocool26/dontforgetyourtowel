---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { withBasePath } from '../utils/helpers';

const contactHref = withBasePath('contact-hq/');
const pricingHref = withBasePath('pricing/');
const servicesHref = withBasePath('services/');

const heroStats = [
  {
    value: '25-150',
    label: 'user teams',
    detail: 'Best fit for owner-led and operations-heavy Chicago-area firms.',
  },
  {
    value: '4 lanes',
    label: 'one owner',
    detail: 'Support, security, Microsoft 365, and recovery handled together.',
  },
  {
    value: '30/60/90',
    label: 'first plan',
    detail: 'A plain-language plan after the first environment review.',
  },
];

const boardSteps = [
  {
    label: 'Intake',
    title: 'Issue lands with context',
    detail: 'Users, devices, vendor, impact, and urgency are captured early.',
  },
  {
    label: 'Owner',
    title: 'One path stays accountable',
    detail: 'Support, escalation, vendor follow-up, and status do not scatter.',
  },
  {
    label: 'Proof',
    title: 'Leaders see what changed',
    detail: 'Tickets, security, backup, and roadmap decisions become visible.',
  },
];

const serviceLanes = [
  {
    label: 'Support',
    title: 'Managed IT support',
    copy: 'Help desk, onboarding, endpoint hygiene, patching, and vendor follow-through.',
    href: servicesHref,
  },
  {
    label: 'Security',
    title: 'Cybersecurity baseline',
    copy: 'MFA, endpoint protection, email defense, admin access, awareness, and response contacts.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Microsoft 365',
    title: 'Microsoft 365 operations',
    copy: 'Exchange, Teams, SharePoint, OneDrive, licensing, access rules, cleanup, and governance.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Continuity',
    title: 'Backup, network, and recovery',
    copy: 'Backup monitoring, restore checks, firewall, Wi-Fi, ISP coordination, and recovery order.',
    href: withBasePath('services/#technology-catalog'),
  },
];

const firstThirtyDays = [
  'Map users, devices, Microsoft 365, backups, vendors, network gear, admin roles, and recurring issues.',
  'Stabilize urgent support, access, email, and recovery gaps before expanding the roadmap.',
  'Deliver a 30/60/90 operating plan with owners, budget shape, and the first proof worth reviewing.',
];
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Managed IT, Security, Microsoft 365, and Backup"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and support ownership for firms that need calmer operations."
  mainClass="relative overflow-x-clip"
  bodyClass="home-reboot"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-reboot-hero" id="landing-hero" data-page-section>
    <div class="home-reboot-shell home-reboot-hero__grid">
      <div class="home-reboot-hero__content">
        <p class="home-reboot-kicker">
          Managed IT for Chicago teams that need the work owned
        </p>
        <h1 class="home-reboot-title">
          CHICAGOS #1 MSP for IT support that gets answered, owned, and proven.
        </h1>
        <p class="home-reboot-copy home-reboot-copy--large">
          Managed IT, cybersecurity, Microsoft 365, backup, network, and
          recovery support with a simple promise: the issue has an owner, the
          risk has evidence, and the next step is clear.
        </p>

        <div class="home-reboot-actions" aria-label="Primary actions">
          <ModernButton
            href={contactHref}
            variant="gradient"
            rounded="sm"
            className="home-reboot-primary-action"
          >
            Start fit check
          </ModernButton>
          <ModernButton
            href={pricingHref}
            variant="outline"
            rounded="sm"
            className="home-reboot-secondary-action"
          >
            See pricing
          </ModernButton>
          <a class="home-reboot-text-link" href={servicesHref}>View services</a>
        </div>

        <div class="home-reboot-stat-grid" aria-label="Buyer fit signals">
          {
            heroStats.map(stat => (
              <article class="home-reboot-stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
                <p>{stat.detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <aside class="home-reboot-board" aria-label="Support ownership board">
        <div
          class="home-reboot-board__scene"
          data-testid="home-orbit-scene"
          data-home-orbit-root
          role="img"
          aria-label="Operations board showing intake, owner, and proof lanes"
        >
          <canvas
            class="home-reboot-board__canvas"
            data-home-orbit-canvas
            aria-hidden="true"></canvas>
        </div>

        <div class="home-reboot-board__content">
          <div class="home-reboot-board__topline">
            <span>Live operating model</span>
            <strong>Calm IT starts here</strong>
          </div>
          <div class="home-reboot-board__steps">
            {
              boardSteps.map((step, index) => (
                <article class="home-reboot-board-step">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <p>{step.label}</p>
                    <h2>{step.title}</h2>
                    <small>{step.detail}</small>
                  </div>
                </article>
              ))
            }
          </div>
          <div class="home-reboot-board__footer">
            <span>First review output</span>
            <strong>scope, risks, owners, budget shape</strong>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <ProofOperatingSystem
    eyebrow="Better than another MSP brochure"
    title="Show the operating proof before asking for trust."
    description="The site now leads with the artifacts a serious buyer needs: owner map, recovery receipt, access ledger, roadmap board, and pricing clarity."
    ctaHref={contactHref}
    ctaLabel="Send the pressure point"
  />

  <section class="home-reboot-section" id="services" data-page-section>
    <div class="home-reboot-shell">
      <div
        class="home-reboot-section-heading home-reboot-section-heading--wide"
      >
        <p class="home-reboot-kicker">Services</p>
        <h2 class="home-reboot-section-title">
          Four clear service lanes buyers can understand fast.
        </h2>
        <p class="home-reboot-copy">
          No giant capability wall. Start with the operating pressure, then
          confirm the lane and proof output.
        </p>
      </div>

      <div class="home-reboot-lanes">
        {
          serviceLanes.map((lane, index) => (
            <a class="home-homepage-lane home-reboot-lane" href={lane.href}>
              <span class="home-reboot-lane__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="home-homepage-lane__label home-reboot-lane__label">
                {lane.label}
              </span>
              <h3>{lane.title}</h3>
              <p>{lane.copy}</p>
              <strong>Open scope</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--handoff"
    id="decision-handoff"
    data-page-section
  >
    <div class="home-reboot-shell">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Decision handoff"
        title="A mature first conversation has an output before it has a pitch."
        description="Choose the pressure point, bring the right evidence, and leave the first conversation with a clear service lane, owner, and next action."
      />
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--operating"
    id="operating-standard"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-operating">
      <div class="home-reboot-section-heading">
        <p class="home-reboot-kicker">First phase</p>
        <h2 class="home-reboot-section-title">
          The first phase should calm the room.
        </h2>
        <p class="home-reboot-copy">
          Before anyone buys a bigger stack, the environment needs a baseline,
          visible owners, and a practical plan.
        </p>
      </div>

      <div class="home-homepage-first30 home-reboot-first30">
        <ol>
          {firstThirtyDays.map(item => <li>{item}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--final"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-final">
      <div>
        <p class="home-reboot-kicker">Ready when you are</p>
        <h2 class="home-reboot-section-title">
          Send the pressure point. Get a cleaner next step.
        </h2>
      </div>
      <div class="home-reboot-actions home-reboot-actions--final">
        <ModernButton href={contactHref} variant="gradient" rounded="sm">
          Start fit check
        </ModernButton>
        <ModernButton href={servicesHref} variant="outline" rounded="sm">
          View services
        </ModernButton>
      </div>
    </div>
  </section>

  <script>
    const paintHomeBoard = (root: HTMLElement) => {
      const canvas = root.querySelector<HTMLCanvasElement>(
        '[data-home-orbit-canvas]'
      );
      if (!canvas) return;

      const width = Math.max(320, Math.round(root.clientWidth || 680));
      const height = Math.max(320, Math.round(root.clientHeight || 560));
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const ctx = canvas.getContext('2d', { willReadFrequently: false });
      if (!ctx) return;

      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const background = ctx.createLinearGradient(0, 0, width, height);
      background.addColorStop(0, '#f8f2e7');
      background.addColorStop(0.42, '#cbeee6');
      background.addColorStop(0.72, '#d9e4ff');
      background.addColorStop(1, '#0a1113');
      ctx.fillStyle = background;
      ctx.fillRect(0, 0, width, height);

      ctx.globalAlpha = 0.24;
      ctx.strokeStyle = '#0f1720';
      ctx.lineWidth = 1;
      for (let x = 0; x <= width; x += 44) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      for (let y = 0; y <= height; y += 44) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      const lanes = [
        { y: 0.24, color: 'rgba(15, 118, 110, 0.82)' },
        { y: 0.42, color: 'rgba(29, 78, 216, 0.72)' },
        { y: 0.6, color: 'rgba(161, 98, 7, 0.72)' },
      ];

      lanes.forEach((lane, laneIndex) => {
        const y = height * lane.y;
        const startX = width * 0.14;
        const endX = width * 0.84;
        ctx.strokeStyle = lane.color;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(startX, y);
        ctx.bezierCurveTo(width * 0.36, y - 36, width * 0.58, y + 42, endX, y);
        ctx.stroke();

        for (let index = 0; index < 4; index += 1) {
          const progress = index / 3;
          const x = startX + (endX - startX) * progress;
          const dotY = y + Math.sin(progress * Math.PI * 2 + laneIndex) * 18;
          ctx.fillStyle =
            index === 3 ? 'rgba(6, 78, 59, 0.92)' : 'rgba(255, 255, 255, 0.84)';
          ctx.strokeStyle = lane.color;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(x, dotY, index === 3 ? 8 : 6, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }
      });

      ctx.fillStyle = 'rgba(7, 14, 17, 0.86)';
      ctx.fillRect(width * 0.58, height * 0.72, width * 0.29, height * 0.1);
      ctx.fillStyle = 'rgba(248, 242, 231, 0.92)';
      ctx.font = '700 12px system-ui, sans-serif';
      ctx.fillText('OWNER + PROOF', width * 0.61, height * 0.78);
    };

    const setupHomeBoard = () => {
      const roots = document.querySelectorAll<HTMLElement>(
        '[data-home-orbit-root]'
      );
      roots.forEach(root => {
        paintHomeBoard(root);
        if (root.dataset.homeBoardBound === '1') return;
        root.dataset.homeBoardBound = '1';

        let frame = 0;
        const repaint = () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => paintHomeBoard(root));
        };
        window.addEventListener('resize', repaint, { passive: true });
      });
    };

    setupHomeBoard();
    document.addEventListener('astro:page-load', setupHomeBoard);
  </script>

  <style>
    :global(.home-reboot) {
      background: linear-gradient(
        180deg,
        #111816 0%,
        #101416 36%,
        #090b0d 100%
      );
      color: #f8f2e7;
    }

    :global(.home-reboot .tone-site-shell),
    :global(.home-reboot .tone-main-shell) {
      background: transparent;
    }

    .home-reboot-shell {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .home-reboot-hero {
      position: relative;
      min-height: min(42rem, calc(100svh - 2rem));
      display: grid;
      align-items: center;
      overflow: hidden;
      padding: clamp(3.25rem, 6vw, 5.2rem) 0 clamp(2.5rem, 4vw, 3.5rem);
      background:
        linear-gradient(110deg, rgba(156, 230, 217, 0.18), transparent 34%),
        linear-gradient(180deg, #17201d 0%, #101416 100%);
      color: #f8f2e7;
    }

    .home-reboot-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(rgba(17, 24, 28, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(17, 24, 28, 0.045) 1px, transparent 1px);
      background-size: 58px 58px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 82%);
    }

    .home-reboot-hero__grid {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .home-reboot-hero__content {
      display: grid;
      gap: 1.15rem;
      max-width: 47rem;
    }

    .home-reboot-kicker {
      margin: 0;
      color: rgba(248, 242, 231, 0.58);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      line-height: 1.45;
      text-transform: uppercase;
    }

    .home-reboot-title,
    .home-reboot-section-title {
      margin: 0;
      color: inherit;
      font-family: var(--font-display);
      font-weight: 760;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .home-reboot-title {
      max-width: 13ch;
      font-size: clamp(3rem, 4.8vw, 4.7rem);
      line-height: 0.98;
    }

    .home-reboot-section-title {
      font-size: clamp(2rem, 4vw, 4.25rem);
      line-height: 0.98;
    }

    .home-reboot-copy {
      max-width: 64ch;
      margin: 0;
      color: rgba(226, 232, 240, 0.76);
      font-size: 1rem;
      line-height: 1.65;
    }

    .home-reboot-copy--large {
      max-width: 43rem;
      color: rgba(248, 242, 231, 0.78);
      font-size: clamp(1.05rem, 1.7vw, 1.28rem);
      line-height: 1.62;
    }

    .home-reboot-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: center;
      margin-top: 0.3rem;
    }

    .home-reboot-primary-action,
    .home-reboot-secondary-action {
      min-height: 52px;
    }

    .home-reboot-text-link {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid rgba(15, 118, 110, 0.42);
      color: #9ce6d9;
      font-weight: 750;
    }

    .home-reboot-text-link:hover {
      color: #f8f2e7;
    }

    .home-reboot-text-link--standalone {
      margin-top: 0.65rem;
      color: #9ce6d9;
      justify-self: start;
    }

    .home-reboot-stat-grid {
      display: grid;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    .home-reboot-stat {
      border: 1px solid rgba(248, 242, 231, 0.13);
      border-radius: 8px;
      background: rgba(248, 242, 231, 0.055);
      padding: 1rem;
    }

    .home-reboot-stat strong,
    .home-reboot-stat span {
      display: block;
    }

    .home-reboot-stat strong {
      color: #f8f2e7;
      font-size: 1.4rem;
      line-height: 1;
    }

    .home-reboot-stat span {
      margin-top: 0.3rem;
      color: #9ce6d9;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-stat p {
      margin: 0.55rem 0 0;
      color: rgba(248, 242, 231, 0.66);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .home-reboot-board {
      position: relative;
      min-height: clamp(26rem, 38vw, 32rem);
      overflow: hidden;
      border: 1px solid rgba(248, 242, 231, 0.14);
      border-radius: 8px;
      background: #101719;
      box-shadow: 0 28px 70px -46px rgba(15, 23, 42, 0.5);
      color: #f8f2e7;
      isolation: isolate;
    }

    .home-reboot-board__scene,
    .home-reboot-board__canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .home-reboot-board__scene::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(8, 13, 15, 0.82), rgba(8, 13, 15, 0.14)),
        linear-gradient(180deg, rgba(8, 13, 15, 0.08), rgba(8, 13, 15, 0.78));
    }

    .home-reboot-board__content {
      position: relative;
      z-index: 2;
      display: grid;
      min-height: inherit;
      align-content: space-between;
      gap: 1rem;
      padding: clamp(1rem, 2.4vw, 1.4rem);
    }

    .home-reboot-board__topline,
    .home-reboot-board__footer {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      align-items: center;
      justify-content: space-between;
      border: 1px solid rgba(248, 242, 231, 0.14);
      border-radius: 8px;
      background: rgba(8, 13, 15, 0.58);
      padding: 0.85rem;
      backdrop-filter: blur(8px);
    }

    .home-reboot-board__topline span,
    .home-reboot-board__footer span {
      color: rgba(248, 242, 231, 0.6);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .home-reboot-board__topline strong,
    .home-reboot-board__footer strong {
      color: #f8f2e7;
      font-size: 0.95rem;
    }

    .home-reboot-board__steps {
      display: grid;
      gap: 0.8rem;
    }

    .home-reboot-board-step {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.85rem;
      border: 1px solid rgba(248, 242, 231, 0.13);
      border-radius: 8px;
      background: rgba(8, 13, 15, 0.62);
      padding: 1rem;
      backdrop-filter: blur(10px);
    }

    .home-reboot-board-step > span {
      display: inline-flex;
      width: 2rem;
      height: 2rem;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(156, 230, 217, 0.34);
      border-radius: 6px;
      color: #f2c76f;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 800;
    }

    .home-reboot-board-step p {
      margin: 0;
      color: #9ce6d9;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-board-step h2 {
      margin: 0.2rem 0 0;
      color: #f8f2e7;
      font-size: 1.1rem;
      line-height: 1.15;
    }

    .home-reboot-board-step small {
      display: block;
      margin-top: 0.45rem;
      color: rgba(248, 242, 231, 0.68);
      font-size: 0.86rem;
      line-height: 1.45;
    }

    .home-reboot-section {
      position: relative;
      padding: clamp(4rem, 7vw, 6.5rem) 0;
      border-top: 1px solid rgba(248, 242, 231, 0.08);
      background: #090b0d;
      color: #f8f2e7;
    }

    .home-reboot-section:nth-of-type(odd) {
      background: #0f1416;
    }

    .home-reboot-section .home-reboot-kicker {
      color: rgba(248, 242, 231, 0.48);
    }

    .home-reboot-split,
    .home-reboot-proof-grid,
    .home-reboot-operating,
    .home-reboot-final {
      display: grid;
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .home-reboot-section-heading {
      display: grid;
      gap: 1rem;
      max-width: 44rem;
    }

    .home-reboot-section-heading--wide {
      max-width: 58rem;
    }

    .home-reboot-reasons {
      display: grid;
      gap: 0.75rem;
    }

    .home-reboot-reason,
    .home-reboot-lane,
    .home-reboot-proof-item,
    .home-reboot-first30 {
      border: 1px solid rgba(248, 242, 231, 0.11);
      border-radius: 8px;
      background:
        linear-gradient(180deg, rgba(248, 242, 231, 0.045), transparent 48%),
        rgba(248, 242, 231, 0.025);
    }

    .home-reboot-reason {
      padding: 1.15rem;
    }

    .home-reboot-reason p {
      margin: 0;
      color: #f2c76f;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-reason h3 {
      margin: 0.55rem 0 0;
      color: #f8f2e7;
      font-size: clamp(1.25rem, 2vw, 1.65rem);
      line-height: 1.12;
    }

    .home-reboot-lanes,
    .home-reboot-proof-list {
      display: grid;
      gap: 0.85rem;
      margin-top: 1.5rem;
    }

    .home-reboot-lane {
      display: grid;
      gap: 0.72rem;
      min-height: 100%;
      padding: 1.15rem;
      color: inherit;
      transition:
        border-color 0.18s ease,
        transform 0.18s ease,
        background 0.18s ease;
    }

    .home-reboot-lane:hover {
      transform: translateY(-2px);
      border-color: rgba(156, 230, 217, 0.35);
      background:
        linear-gradient(180deg, rgba(156, 230, 217, 0.075), transparent 54%),
        rgba(248, 242, 231, 0.035);
