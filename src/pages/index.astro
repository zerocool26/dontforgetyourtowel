---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import OliveUniverse from '../components/react/OliveUniverse';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import { CONTACT_EMAIL } from '../consts';
import {
  tradeProfiles,
  tradePrograms,
  totalTradeSubpages,
} from '../data/trades';
import { getTradeVisual } from '../data/trade-visuals';
import { servicesExtended } from '../data/services-extended';
import { galleryInstallations } from '../data/design-gallery';
import { withBasePath } from '../utils/helpers';

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Premium multi-trade project inquiry')}`;

const landingSignals = [
  {
    label: 'Trade divisions',
    value: String(tradeProfiles.length),
    detail: 'Seven verticals developed like their own serious brand surfaces.',
  },
  {
    label: 'Specialist routes',
    value: String(totalTradeSubpages),
    detail:
      'Overview pages and support subpages stay linked back to one landing model.',
  },
  {
    label: 'Retained service depth',
    value: `${servicesExtended.length}+`,
    detail:
      'The original MSP, cloud, AI, ecommerce, and digital stack stays active.',
  },
  {
    label: 'Gallery studies',
    value: String(galleryInstallations.length),
    detail:
      'A new design-gallery layer now shows how the system can stretch visually.',
  },
];

const designPillars = [
  {
    title: 'Landing page as command center',
    copy: 'The homepage now works like a living index of the entire site. Trade pages, gallery studies, services, about content, and retained interactive work all route back here cleanly.',
  },
  {
    title: 'Each trade treated as a world',
    copy: 'Mechanical does not look like electrical. Plumbing does not read like MSP. The goal is a shared platform architecture with deliberately different atmospheres inside each lane.',
  },
  {
    title: 'Creative, but still credible',
    copy: 'The visual system goes further than a normal contractor site while keeping hierarchy, responsiveness, clarity, and professional trust intact.',
  },
];

const featuredInstallations = galleryInstallations.slice(0, 4);

const continuityRoutes = [
  {
    title: 'Design Gallery',
    description:
      'The new art-forward gallery of trade-exclusive visual studies and premium interface experiments.',
    href: withBasePath('gallery/'),
  },
  {
    title: 'Services Hub',
    description:
      'The cross-trade bridge that keeps MSP, security, cloud, AI, and digital systems integrated with the field-facing trades.',
    href: withBasePath('services/'),
  },
  {
    title: 'About The Platform',
    description:
      'A dedicated page for the broader story, structure, and operating model behind the site.',
    href: withBasePath('company/'),
  },
  {
    title: 'Build Studio',
    description:
      'The flagship interactive showroom remains part of the live experience as a retained proof point for premium digital work.',
    href: withBasePath('build-studio/#studio'),
  },
  {
    title: 'Portfolio Commerce Lab',
    description:
      'The ecommerce-style demo still lives on the site and now sits beside the trade architecture rather than competing with it.',
    href: withBasePath('about/#shop-experience'),
  },
];

const highlightedTrade = tradeProfiles.find(
  trade => trade.slug === 'msp-tech-services'
);
---

<MarketingLayout
  title="Olive Global Systems | Editorial Multi-Trade Landing Platform"
  description="Creative premium landing page for seven integrated trades, a design gallery, retained interactive demos, and a connected service architecture."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page bg-[#02040a]"
  showFooter={true}
>
  <OliveUniverse client:load />

  <section class="relative min-h-[100dvh] overflow-hidden">
    <div class="landing-veil"></div>
    <div class="relative z-20 mx-auto max-w-[1440px] px-6 pb-20 pt-28 sm:pt-36">
      <div class="grid gap-8 xl:grid-cols-[1.1fr_0.9fr] xl:items-end">
        <div class="pointer-events-none max-w-5xl space-y-7">
          <div class="pointer-events-auto inline-flex flex-wrap gap-2">
            <span class="creative-kicker">Landing Command Center</span>
            <span class="creative-chip">7 trades</span>
            <span class="creative-chip">Design gallery added</span>
            <span class="creative-chip">Ecommerce + studio retained</span>
          </div>

          <div class="pointer-events-auto space-y-5">
            <h1
              class="tone-title max-w-5xl text-5xl !leading-[0.94] tracking-[-0.065em] sm:text-6xl lg:text-7xl xl:text-[5.75rem]"
            >
              A premium
              <span class="creative-gradient-text--accent">
                multi-trade website
              </span>
              designed like a living exhibition of engineering, service, and digital
              craft.
            </h1>
            <p
              class="creative-copy text-white/78 max-w-3xl text-lg leading-relaxed sm:text-xl"
            >
              The site now treats mechanical, electrical, plumbing, general
              contracting, commercial HVAC, auto repair, and MSP / tech services
              as seven distinct design worlds tied back to one landing source of
              truth. A new gallery page pushes the visual language further
              without disconnecting it from the working site.
            </p>
          </div>

          <div class="pointer-events-auto flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/')}
              variant="gradient"
              className="min-h-[50px]"
            >
              Explore all trades
            </ModernButton>
            <ModernButton
              href={withBasePath('gallery/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open design gallery
            </ModernButton>
            <ModernButton
              href={startProjectHref}
              variant="outline"
              className="min-h-[50px]"
            >
              Start a premium brief
            </ModernButton>
          </div>

          <div class="pointer-events-auto grid gap-3 md:grid-cols-2">
            {
              designPillars.map(pillar => (
                <div class="landing-note-card">
                  <p class="tone-title text-base font-semibold">
                    {pillar.title}
                  </p>
                  <p class="tone-body mt-2 text-sm leading-relaxed">
                    {pillar.copy}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="pointer-events-auto grid gap-4">
          <ModernCard variant="minimal" className="landing-specimen p-6">
            <p class="creative-kicker">Specimen Board</p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {
                landingSignals.map(signal => (
                  <div class="landing-specimen__tile">
                    <p class="tone-muted text-[0.68rem] uppercase tracking-[0.25em]">
                      {signal.label}
                    </p>
                    <p class="tone-title mt-2 text-3xl font-semibold">
                      {signal.value}
                    </p>
                    <p class="tone-body mt-2 text-sm">{signal.detail}</p>
                  </div>
                ))
              }
            </div>
          </ModernCard>

          <ModernCard variant="minimal" className="landing-atrium p-6">
            <div class="landing-atrium__stage">
              <div class="landing-atrium__grid"></div>
              <div class="landing-atrium__orb"></div>
              <div class="landing-atrium__ribbon"></div>
            </div>
            <div class="space-y-3">
              <p class="creative-kicker">New Gallery Route</p>
              <p class="tone-title text-2xl font-semibold">
                The gallery is not filler. It is a functional design index.
              </p>
              <p class="tone-body text-sm leading-relaxed">
                The new page adds curatorial filters, view modes, and
                trade-linked visual studies so the site can show premium design
                range without abandoning usability or structure.
              </p>
              <ModernButton
                href={withBasePath('gallery/')}
                variant="secondary"
                className="min-h-[48px]"
              >
                View the gallery
              </ModernButton>
            </div>
          </ModernCard>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-20" data-reveal id="directory">
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="creative-hero-shell p-8">
        <div
          class="flex flex-col gap-6 border-b border-white/10 pb-8 md:flex-row md:items-end md:justify-between"
        >
          <div class="max-w-3xl space-y-4">
            <p class="creative-kicker">Trade Worlds</p>
            <h2 class="tone-title text-4xl font-semibold tracking-tight">
              Each trade now has enough design personality to feel like its own
              premium site.
            </h2>
            <p class="tone-body text-base leading-relaxed">
              The goal is not seven copies of the same contractor page. Each
              lane gets its own atmosphere, headline rhythm, visual accent, and
              route structure while still staying connected to the main
              platform.
            </p>
          </div>
          <ModernButton
            href={withBasePath('trades/')}
            variant="secondary"
            className="min-h-[48px]"
          >
            Open trade directory
          </ModernButton>
        </div>

        <div class="mt-8 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
          {
            tradeProfiles.map(trade => {
              const visual = getTradeVisual(trade.slug);
              return (
                <a
                  href={withBasePath(`trades/${trade.slug}/`)}
                  class="landing-trade-world"
                  style={`--trade-accent:${trade.accent};`}
                >
                  <div class="landing-trade-world__glow" />
                  <div class="landing-trade-world__stage">
                    <span class="landing-trade-world__badge">
                      {trade.badge}
                    </span>
                    <span class="creative-chip">{visual.stageLabel}</span>
                  </div>
                  <div class="space-y-3">
                    <p class="tone-title text-2xl font-semibold">
                      {trade.name}
                    </p>
                    <p class="tone-body text-sm leading-relaxed">
                      {trade.summary}
                    </p>
                  </div>
                  <div class="landing-trade-world__metric">
                    <p class="tone-muted text-[0.65rem] uppercase tracking-[0.24em]">
                      {visual.stageLabel}
                    </p>
                    <p class="tone-title mt-2 text-sm font-semibold">
                      {visual.stageValue}
                    </p>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {trade.subpages.map(subpage => (
                      <span class="landing-trade-world__tag">
                        {subpage.shortLabel}
                      </span>
                    ))}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-20" data-reveal>
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="grid gap-5 xl:grid-cols-[1fr_1fr]">
        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Program Choreography</p>
          <h2 class="tone-title mt-4 text-3xl font-semibold">
            The landing page still explains how the entire platform operates.
          </h2>
          <div class="mt-6 grid gap-4">
            {
              tradePrograms.map(program => (
                <div class="landing-program-card">
                  <div class="border-white/8 flex flex-col gap-3 border-b pb-4 md:flex-row md:items-start md:justify-between">
                    <div class="max-w-2xl">
                      <p class="tone-title text-xl font-semibold">
                        {program.title}
                      </p>
                      <p class="tone-body mt-2 text-sm">
                        {program.description}
                      </p>
                    </div>
                    <span class="creative-chip">
                      {program.tradeSlugs.length} linked trades
                    </span>
                  </div>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {program.outputs.map(output => (
                      <span class="landing-program-card__output">{output}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </ModernCard>

        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">MSP Shift</p>
          <h2 class="tone-title mt-4 text-3xl font-semibold">
            MSP / tech services now reads like trade lane seven, not an
            unrelated side brand.
          </h2>
          <p class="tone-body mt-3 text-sm leading-relaxed">
            The original technology stack stays intact, but it now sits beside
            the field-facing trades with equivalent design weight and
            navigational visibility. That means support, security, cloud, AI,
            and digital systems are integrated into the same architecture
            instead of being hidden somewhere else on the site.
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {
              highlightedTrade?.serviceLines.map(line => (
                <div class="landing-note-card">
                  <p class="tone-title text-base font-semibold">{line.title}</p>
                  <p class="tone-body mt-2 text-sm leading-relaxed">
                    {line.description}
                  </p>
                </div>
              ))
            }
          </div>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/msp-tech-services/')}
              variant="primary"
              className="min-h-[48px]"
            >
              Open MSP / Tech trade
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Open services hub
            </ModernButton>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  <section class="relative z-20" data-reveal>
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="creative-hero-shell p-8">
        <div
          class="flex flex-col gap-6 border-b border-white/10 pb-8 md:flex-row md:items-end md:justify-between"
        >
          <div class="max-w-3xl space-y-4">
            <p class="creative-kicker">Gallery Preview</p>
            <h2 class="tone-title text-4xl font-semibold tracking-tight">
              A new page turns the site into a working mini gallery of digital
              art direction.
            </h2>
            <p class="tone-body text-base leading-relaxed">
              These studies are not generic placeholders. They are trade-aware
              visual concepts linked directly into the live routes, showing how
              a premium frontend system can move between operations,
              storytelling, and design expression.
            </p>
          </div>
          <ModernButton
            href={withBasePath('gallery/')}
            variant="secondary"
            className="min-h-[48px]"
          >
            Open full gallery
          </ModernButton>
        </div>

        <div class="mt-8 grid gap-5 xl:grid-cols-2">
          {
            featuredInstallations.map(installation => (
              <a
                href={withBasePath('gallery/#gallery-wall')}
                class="landing-gallery-card"
                style={`--gallery-accent:${installation.palette[0]};--gallery-secondary:${installation.palette[1]};--gallery-shadow:${installation.palette[2]};`}
              >
                <div class="landing-gallery-card__poster">
                  <div class="landing-gallery-card__grid" />
                  <div class="landing-gallery-card__orb" />
                  <div class="landing-gallery-card__ribbon" />
                </div>
                <div class="space-y-3 p-5">
                  <div class="flex flex-wrap gap-2">
                    <span class="creative-chip">{installation.trade}</span>
                    <span class="creative-chip">{installation.category}</span>
                  </div>
                  <p class="tone-title text-2xl font-semibold">
                    {installation.title}
                  </p>
                  <p class="tone-body text-sm leading-relaxed">
                    {installation.summary}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-20" data-reveal>
    <div class="mx-auto max-w-[1440px] px-6 py-10">
      <div class="grid gap-5 xl:grid-cols-[1.04fr_0.96fr]">
        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Connected Continuity</p>
          <h2 class="tone-title mt-4 text-3xl font-semibold">
            Nothing important was deleted. The site was extended into a more
            mature system.
          </h2>
          <p class="tone-body mt-3 max-w-3xl text-sm leading-relaxed">
            The landing page now points clearly into the trade map, the new
            gallery, the services architecture, the about page, the portfolio
            lab, and the build studio. That turns the homepage into a real
            command layer rather than a decorative splash screen.
          </p>

          <div class="mt-8 grid gap-4 lg:grid-cols-2">
            {
              continuityRoutes.map(route => (
                <a
                  href={route.href}
                  class="landing-route-card rounded-[1.6rem] border border-white/10 bg-white/[0.03] p-5 transition hover:border-white/20 hover:bg-white/[0.05]"
                >
                  <p class="tone-title text-xl font-semibold">{route.title}</p>
                  <p class="tone-body mt-2 text-sm">{route.description}</p>
                </a>
              ))
            }
          </div>
        </ModernCard>

        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Final Read</p>
          <div class="space-y-4">
            <h2 class="tone-title text-3xl font-semibold">
              The experience now behaves more like a premium platform than a
              generic marketing homepage.
            </h2>
            <p class="tone-body text-sm leading-relaxed">
              Buyers can route into a specific trade, explore art-directed
              gallery concepts, study the broader company architecture, or jump
              into the retained interactive demos. That balance between utility,
              expression, and architecture is the point.
            </p>
          </div>
          <div class="mt-8 flex flex-col gap-3">
            <ModernButton
              href={withBasePath('gallery/')}
              variant="gradient"
              className="min-h-[50px]"
            >
              Enter the design gallery
            </ModernButton>
            <ModernButton
              href={withBasePath('company/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open About
            </ModernButton>
            <ModernButton
              href={startProjectHref}
              variant="outline"
              className="min-h-[50px]"
            >
              Email a project brief
            </ModernButton>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>
</MarketingLayout>

<style is:inline>
  .landing-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 16% 12%,
        rgba(204, 255, 0, 0.12),
        transparent 28%
      ),
      radial-gradient(
        circle at 82% 16%,
        rgba(128, 214, 255, 0.16),
        transparent 24%
      ),
      linear-gradient(180deg, rgba(2, 4, 10, 0.14), rgba(2, 4, 10, 0.82));
  }

  .landing-note-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        155deg,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0)
      ),
      rgba(5, 7, 14, 0.76);
    padding: 1rem 1.05rem;
    box-shadow: 0 28px 70px -42px rgba(0, 0, 0, 0.9);
  }

  .landing-specimen {
    background:
      linear-gradient(
        155deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      radial-gradient(
        circle at top right,
        rgba(204, 255, 0, 0.1),
        transparent 34%
      ),
      rgba(5, 7, 12, 0.84);
  }

  .landing-specimen__tile {
    border-radius: 1.3rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem;
  }

  .landing-atrium {
    display: grid;
    gap: 1.2rem;
    background:
      linear-gradient(
        155deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(5, 7, 12, 0.8);
  }

  .landing-atrium__stage {
    position: relative;
    min-height: 250px;
    overflow: hidden;
    border-radius: 1.5rem;
    background:
      radial-gradient(
        circle at 18% 20%,
        rgba(204, 255, 0, 0.24),
        transparent 24%
      ),
      radial-gradient(
        circle at 82% 22%,
        rgba(112, 210, 255, 0.3),
        transparent 24%
      ),
      linear-gradient(145deg, #0a1016, #080b10);
  }

  .landing-atrium__grid,
  .landing-atrium__orb,
  .landing-atrium__ribbon {
    position: absolute;
    pointer-events: none;
  }

  .landing-atrium__grid {
    inset: 8%;
    border-radius: 1.3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.88), transparent);
  }

  .landing-atrium__orb {
    top: 18%;
    right: 12%;
    height: 140px;
    width: 140px;
    border-radius: 999px;
    background: radial-gradient(
      circle at 36% 28%,
      rgba(255, 255, 255, 0.98),
      rgba(204, 255, 0, 0.56) 28%,
      transparent 72%
    );
  }

  .landing-atrium__ribbon {
    left: 12%;
    right: 18%;
    bottom: 14%;
    height: 76px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(204, 255, 0, 0),
      rgba(104, 204, 255, 0.58),
      rgba(204, 255, 0, 0.2)
    );
    filter: blur(28px);
  }

  .landing-trade-world {
    position: relative;
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border-radius: 1.55rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--trade-accent) 10%, transparent),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(5, 7, 14, 0.84);
    padding: 1.2rem;
    box-shadow: 0 32px 80px -44px rgba(0, 0, 0, 0.94);
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .landing-trade-world:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--trade-accent) 36%, transparent);
    box-shadow:
      0 40px 100px -48px rgba(0, 0, 0, 0.98),
      0 0 42px -26px color-mix(in srgb, var(--trade-accent) 36%, transparent);
  }

  .landing-trade-world__glow {
    position: absolute;
    inset: auto -12% -20% 36%;
    height: 160px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--trade-accent) 22%, transparent),
      transparent 70%
    );
    filter: blur(22px);
    pointer-events: none;
  }

  .landing-trade-world__stage {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .landing-trade-world__badge {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--trade-accent) 28%, transparent);
    background: color-mix(
      in srgb,
      var(--trade-accent) 12%,
      rgba(255, 255, 255, 0.02)
    );
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: white;
  }

  .landing-trade-world__metric {
    border-radius: 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.9rem 1rem;
  }

  .landing-trade-world__tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.44rem 0.8rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.68);
  }

  .landing-program-card {
    border-radius: 1.4rem;
