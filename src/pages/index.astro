    outputs: [
      'Support ownership',
      'Core security baseline',
      'Reporting rhythm',
    ],
  },
  {
    title: 'Modernize with purpose',
    description:
      'Bring in cloud, automation, and AI only where they create visible leverage for the team and the buyer journey.',
    outputs: ['Workflow lift', 'Automation map', 'Cloud modernization plan'],
