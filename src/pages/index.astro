  <script is:inline>
    (() => {
      const heroSelector = '[data-olive-universe]';
      const canvasSelector = '[data-hero-canvas="true"]';

      const getMode = () => {
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const forcedStability = Boolean(
          window.__OLIVE_FORCE_STABILITY_ASSIST__
        );
        const deviceMemory = Number(window.navigator.deviceMemory || 8);
        const mobileViewport = window.innerWidth < 900;
        const liteMode = forcedStability || deviceMemory <= 2 || mobileViewport;

        if (reducedMotion) {
          return {
            mode: 'reduced',
            runtime: forcedStability ? 'stability' : 'default',
            scene: 'ambient',
            mobile3d: 'optimized',
          };
        }

        return {
          mode: liteMode ? 'lite' : 'immersive',
          runtime: forcedStability ? 'stability' : 'default',
          scene: 'interactive',
          mobile3d: liteMode ? 'optimized' : 'full',
        };
      };

      const paintHeroCanvases = () => {
        const mode = getMode();

        document.querySelectorAll(heroSelector).forEach(hero => {
          hero.setAttribute('data-olive-mode', mode.mode);
          hero.setAttribute('data-olive-runtime', mode.runtime);
          hero.setAttribute('data-olive-scene', mode.scene);
          hero.setAttribute('data-olive-mobile-3d', mode.mobile3d);
        });

        document.querySelectorAll(canvasSelector).forEach(node => {
          if (!(node instanceof HTMLCanvasElement)) return;
          const context = node.getContext('2d');
          if (!context) return;

          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(node.clientWidth, 320);
          const height = Math.max(node.clientHeight, 620);
          node.width = Math.floor(width * ratio);
          node.height = Math.floor(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);

          const base = context.createLinearGradient(0, 0, width, height);
          base.addColorStop(0, '#111b2b');
          base.addColorStop(0.45, '#091322');
          base.addColorStop(1, '#060c15');
          context.fillStyle = base;
          context.fillRect(0, 0, width, height);

          const glowLeft = context.createRadialGradient(
            width * 0.18,
            height * 0.18,
            0,
            width * 0.18,
            height * 0.18,
            width * 0.38
          );
          glowLeft.addColorStop(0, 'rgba(209, 179, 122, 0.22)');
          glowLeft.addColorStop(1, 'rgba(209, 179, 122, 0)');
          context.fillStyle = glowLeft;
          context.fillRect(0, 0, width, height);

          const glowRight = context.createRadialGradient(
            width * 0.82,
            height * 0.1,
            0,
            width * 0.82,
            height * 0.1,
            width * 0.3
          );
          glowRight.addColorStop(0, 'rgba(104, 180, 213, 0.26)');
          glowRight.addColorStop(1, 'rgba(104, 180, 213, 0)');
          context.fillStyle = glowRight;
          context.fillRect(0, 0, width, height);

          context.strokeStyle = 'rgba(255, 255, 255, 0.06)';
          context.lineWidth = 1;
          const gridSize = Math.max(Math.round(width / 18), 48);

          for (let x = 0; x <= width; x += gridSize) {
            context.beginPath();
            context.moveTo(x, 0);
            context.lineTo(x, height);
            context.stroke();
          }

          for (let y = 0; y <= height; y += gridSize) {
            context.beginPath();
            context.moveTo(0, y);
            context.lineTo(width, y);
            context.stroke();
          }

          context.strokeStyle = 'rgba(226, 232, 240, 0.2)';
          context.lineWidth = 2;
          context.beginPath();
          context.moveTo(width * 0.08, height * 0.7);
          context.bezierCurveTo(
            width * 0.24,
            height * 0.54,
            width * 0.44,
            height * 0.78,
            width * 0.58,
            height * 0.56
          );
          context.bezierCurveTo(
            width * 0.66,
            height * 0.42,
            width * 0.82,
            height * 0.62,
            width * 0.92,
            height * 0.38
          );
          context.stroke();

          context.fillStyle = 'rgba(255, 255, 255, 0.44)';
          [
            [0.18, 0.3],
            [0.38, 0.52],
            [0.62, 0.36],
            [0.8, 0.18],
          ].forEach(([x, y]) => {
            context.beginPath();
            context.arc(width * x, height * y, 5, 0, Math.PI * 2);
            context.fill();
          });
        });
      };

      const bindInteractions = () => {
        document.querySelectorAll(heroSelector).forEach(hero => {
          if (!(hero instanceof HTMLElement)) return;
          if (hero.dataset.oliveInteractionBound === '1') return;

          hero.dataset.oliveInteractionBound = '1';
          hero.addEventListener('click', () => {
            hero.setAttribute('data-olive-interaction', 'burst');
            window.setTimeout(() => {
              hero.setAttribute('data-olive-interaction', 'idle');
            }, 1200);
          });
        });
      };

      const boot = () => {
        paintHeroCanvases();
        bindInteractions();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, {
          once: true,
        });
      } else {
        boot();
      }

      window.addEventListener('resize', paintHeroCanvases);
      document.addEventListener('astro:page-load', boot);
    })();
  </script>

