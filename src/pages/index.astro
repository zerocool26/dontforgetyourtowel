---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import SignalCabinet from '../components/business/SignalCabinet.astro';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import { CONTACT_EMAIL } from '../consts';
import {
  tradeProfiles,
  tradePrograms,
  totalTradeSubpages,
} from '../data/trades';
import { getTradeOperations } from '../data/trade-operations';
import { servicesExtended } from '../data/services-extended';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Project inquiry — Olive Global Systems')}`;

const tradeHighlights = tradeProfiles.map(trade => ({
  trade,
  operations: getTradeOperations(trade.slug),
}));

const landingSignalItems = tradeHighlights
  .slice(0, 4)
  .map(({ trade, operations }) => ({
    kicker: trade.shortName,
    title: trade.name,
    detail: operations.operatingModel,
    meta: [
      operations.serviceRhythm,
      operations.ownerOutputs[0] ?? trade.summary,
    ],
  }));

const operatingHighlights = [
  {
    label: 'Service divisions',
    value: `${tradeProfiles.length}`,
    note: 'Mechanical, electrical, plumbing, general contracting, HVAC, auto repair, and managed technology.',
  },
  {
    label: 'Specialist routes',
    value: `${totalTradeSubpages}+`,
    note: 'Dedicated routes for retrofit delivery, controls, logistics, service bays, and managed operations.',
  },
  {
    label: 'Retained services',
    value: `${servicesExtended.length}+`,
    note: 'Managed IT, security, cloud, automation, ecommerce, AI, and digital systems remain in view.',
  },
];

const platformFocus = [
  {
    title: 'Capital projects and phased renovations',
    copy: 'Built around access, shutdowns, sequencing, and clean turnover.',
  },
  {
    title: 'Occupied buildings and continuity-sensitive work',
    copy: 'Keeps facilities usable while trade work moves in controlled phases.',
  },
  {
    title: 'AI Orchestration & Advanced Dev',
    copy: 'AI, cloud, security, automation, and business systems stay connected to the field-facing delivery picture.',
  },
];

const heroMedia = [
  {
    src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=900&q=82',
    alt: 'Modern commercial building facade viewed from below',
    label: 'Built environment',
  },
  {
    src: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=900&q=82',
    alt: 'Premium operations workspace with desks and collaborative planning areas',
    label: 'Operations systems',
  },
  {
    src: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=900&q=82',
    alt: 'Industrial technician reviewing equipment in a modern facility',
    label: 'Field execution',
  },
];

const deliveryStages = [
  {
    step: '01',
    title: 'Scope the work in operational terms',
    copy: 'Start with access, occupancy, risk, support coverage, and owner outcomes.',
  },
  {
    step: '02',
    title: 'Assign the right lane and interfaces',
    copy: 'Pick the lead lane early and surface connected trades before execution starts.',
  },
  {
    step: '03',
    title: 'Execute against readiness, not assumptions',
    copy: 'Release work against readiness, outage windows, verification, and real dependencies.',
  },
  {
    step: '04',
    title: 'Close out with usable owner outputs',
    copy: 'Close with documentation, startup records, punch control, and clear next steps.',
  },
];
---

<MarketingLayout
  title="Olive Global Systems | Integrated Trade And Technology Delivery"
  description="Integrated delivery across seven service divisions, from capital projects and occupied-building trade work to managed IT, security, cloud, and automation."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="relative min-h-[100svh] overflow-hidden border-b border-white/10"
    id="landing-hero"
    data-page-section
    data-olive-universe="ready"
    data-olive-mobile-3d="optimized"
    data-olive-mode="lite"
  >
    <div aria-hidden="true" class="absolute inset-0">
      <canvas data-hero-canvas="true" class="block h-full w-full"></canvas>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.06),transparent_30%),linear-gradient(180deg,rgba(8,17,29,0.16),rgba(8,17,29,0.82)_72%,rgba(8,17,29,0.96))]"
      >
      </div>
    </div>

    <div
      class="premium-container relative z-10 flex min-h-[100svh] items-end pb-8 pt-18 sm:pb-16 sm:pt-28 lg:pb-18 lg:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div class="space-y-7">
          <div class="space-y-3">
            <p class="premium-eyebrow">Olive Global Systems</p>
            <h1
              class="premium-title text-4xl font-semibold sm:text-5xl lg:text-6xl"
            >
              Creative technology and integrated trade delivery for complex
              operating environments.
              <span class="sr-only"> Immersive landing experience.</span>
            </h1>
            <p class="premium-copy text-base sm:text-lg">
              See the divisions, delivery logic, and cross-trade programs
              without digging through generic marketing filler.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Explore service divisions
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open services hub
            </ModernButton>
            <ModernButton
              href={contactHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Send a project brief
            </ModernButton>
          </div>

          <div data-olive-links class="flex flex-wrap gap-2 pt-1">
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('trades/')}>Trades</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('services/')}>Services</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('about/')}>About</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('build-studio/')}>Build studio</a
            >
            <a
              class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
              href={withBasePath('contact-hq/')}>Contact</a
            >
          </div>

          <dl class="hidden">
            {
              operatingHighlights.map(item => (
                <div class="premium-stat">
                  <dt>{item.label}</dt>
                  <dd class="text-3xl font-semibold tracking-normal text-white">
                    {item.value}
                  </dd>
                  <dd class="text-sm leading-6 text-slate-300">{item.note}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div
          class="hidden grid-cols-[0.8fr_1fr] gap-4 md:grid lg:min-h-[430px]"
        >
          <div class="grid gap-4">
            {
              heroMedia.slice(0, 2).map(item => (
                <figure class="premium-media min-h-[150px]">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="premium-chip absolute bottom-3 left-3 z-10">
                    {item.label}
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <figure class="premium-media min-h-[320px]">
            <img
              src={heroMedia[2].src}
              alt={heroMedia[2].alt}
              loading="eager"
              decoding="async"
            />
            <figcaption class="absolute bottom-4 left-4 right-4 z-10">
              <span class="premium-chip">{heroMedia[2].label}</span>
              <p
                class="mt-3 max-w-sm text-xl font-semibold leading-tight text-white"
              >
                Field work, managed systems, and owner-ready closeout in one
                operating view.
              </p>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const initializeHeroState = () => {
        const hero = document.querySelector('[data-olive-universe="ready"]');
        if (!(hero instanceof HTMLElement)) return;

        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const forceStability = window.__OLIVE_FORCE_STABILITY_ASSIST__ === true;

        hero.setAttribute('data-current-chapter', 'singularity');
        hero.setAttribute(
          'data-olive-runtime',
          forceStability ? 'stability' : 'default'
        );
        hero.setAttribute(
          'data-olive-mode',
          reducedMotion
            ? 'reduced'
            : hero.getAttribute('data-olive-mode') || 'lite'
        );
        hero.setAttribute(
          'data-olive-scene',
          reducedMotion ? 'ambient' : 'interactive'
        );

        if (hero.dataset.oliveInteractionBound === '1') return;
        hero.dataset.oliveInteractionBound = '1';
        hero.setAttribute('data-olive-interaction', 'idle');
        hero.addEventListener('click', () => {
          if (reducedMotion) return;
          hero.setAttribute('data-olive-interaction', 'burst');
          window.setTimeout(() => {
            hero.setAttribute('data-olive-interaction', 'idle');
          }, 450);
        });
      };

      const paintHeroCanvases = () => {
        initializeHeroState();
        document
          .querySelectorAll('canvas[data-hero-canvas="true"]')
          .forEach(node => {
            if (!(node instanceof HTMLCanvasElement)) return;

            const rect = node.getBoundingClientRect();
            const width = Math.max(Math.floor(rect.width), 1);
            const height = Math.max(Math.floor(rect.height), 1);
            const ratio = Math.min(window.devicePixelRatio || 1, 2);

            node.width = Math.floor(width * ratio);
            node.height = Math.floor(height * ratio);

            const context = node.getContext('2d');
            if (!context) return;

            context.setTransform(ratio, 0, 0, ratio, 0, 0);
            context.clearRect(0, 0, width, height);

            const base = context.createLinearGradient(0, 0, 0, height);
            base.addColorStop(0, '#102033');
            base.addColorStop(0.52, '#0d1727');
            base.addColorStop(1, '#08111d');
            context.fillStyle = base;
            context.fillRect(0, 0, width, height);

            const glowLeft = context.createRadialGradient(
              width * 0.18,
              height * 0.14,
              0,
              width * 0.18,
              height * 0.14,
              width * 0.34
            );
            glowLeft.addColorStop(0, 'rgba(191, 219, 254, 0.42)');
            glowLeft.addColorStop(1, 'rgba(191, 219, 254, 0)');
            context.fillStyle = glowLeft;
            context.fillRect(0, 0, width, height);

            const glowRight = context.createRadialGradient(
              width * 0.84,
              height * 0.1,
              0,
              width * 0.84,
              height * 0.1,
              width * 0.28
            );
            glowRight.addColorStop(0, 'rgba(125, 211, 252, 0.24)');
            glowRight.addColorStop(1, 'rgba(125, 211, 252, 0)');
            context.fillStyle = glowRight;
            context.fillRect(0, 0, width, height);

            context.strokeStyle = 'rgba(255, 255, 255, 0.08)';
            context.lineWidth = 1;
            const gridSize = Math.max(Math.round(width / 18), 44);

            for (let x = 0; x <= width; x += gridSize) {
              context.beginPath();
              context.moveTo(x, 0);
              context.lineTo(x, height);
              context.stroke();
            }

            for (let y = 0; y <= height; y += gridSize) {
              context.beginPath();
              context.moveTo(0, y);
              context.lineTo(width, y);
              context.stroke();
            }

            context.strokeStyle = 'rgba(147, 197, 253, 0.4)';
            context.lineWidth = 2;
            context.beginPath();
            context.moveTo(width * 0.08, height * 0.72);
            context.bezierCurveTo(
              width * 0.24,
              height * 0.58,
              width * 0.42,
              height * 0.82,
              width * 0.58,
              height * 0.6
            );
            context.bezierCurveTo(
              width * 0.68,
              height * 0.46,
              width * 0.8,
              height * 0.64,
              width * 0.92,
              height * 0.42
            );
            context.stroke();

            context.fillStyle = 'rgba(255, 255, 255, 0.65)';
            [
              [0.18, 0.32],
              [0.38, 0.54],
              [0.61, 0.38],
              [0.81, 0.22],
            ].forEach(([x, y]) => {
              context.beginPath();
              context.arc(width * x, height * y, 5, 0, Math.PI * 2);
              context.fill();
            });
          });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', paintHeroCanvases, {
          once: true,
        });
      } else {
        paintHeroCanvases();
      }

      window.addEventListener('resize', paintHeroCanvases);
      document.addEventListener('astro:page-load', paintHeroCanvases);
    })();
  </script>

  <section
    class="premium-section"
    id="front-door-proof"
    data-page-section
    data-reveal
  >
    <div class="premium-container py-10 sm:py-12">
      <div class="grid gap-4 md:grid-cols-3">
        {
          operatingHighlights.map(item => (
            <div class="premium-card premium-card--interactive p-5">
              <p class="premium-eyebrow text-[0.64rem]">{item.label}</p>
              <p class="mt-3 text-3xl font-semibold tracking-normal text-white">
                {item.value}
              </p>
              <p class="mb-0 mt-3 text-sm leading-6 text-slate-300">
                {item.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="signal-cabinet"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <SignalCabinet
        eyebrow="Operational signals"
        title="Compare how the core divisions operate."
        description="Click through the lead divisions to see their operating model, rhythm, and owner outputs before you go deeper."
        accent="#93c5fd"
        items={landingSignalItems}
      />
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="focus"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Where the platform is strongest
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Delivery lanes for projects, facilities, and ongoing operations.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          These are the problem spaces the platform is built to handle best.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          platformFocus.map(item => (
            <ModernCard variant="default" className="h-full p-7">
              <h3 class="text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="directory"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-3xl space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Service divisions
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Each division has its own operating model and owner output.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            The homepage surfaces the basics fast so buyers can orient quickly.
          </p>
        </div>

        <ModernButton
          href={withBasePath('trades/')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          View full trade directory
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          tradeHighlights.map(({ trade, operations }) => (
            <a
              href={withBasePath(`trades/${trade.slug}/`)}
              class="premium-card premium-card--interactive group block p-6"
              style={`--trade-accent:${trade.accent};`}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div
                    class="inline-flex h-11 w-11 items-center justify-center rounded-lg border text-sm font-semibold uppercase tracking-[0.18em] text-white"
                    style={`border-color:color-mix(in srgb, var(--trade-accent) 40%, rgba(255,255,255,0.12)); background:color-mix(in srgb, var(--trade-accent) 16%, transparent);`}
                  >
                    {trade.badge}
                  </div>
                  <p class="mt-4 text-xs uppercase tracking-[0.22em] text-white/45">
                    {trade.eyebrow}
                  </p>
                </div>

                <span class="rounded-full border border-white/10 px-3 py-1 text-[0.65rem] uppercase tracking-[0.22em] text-white/55">
                  {trade.shortName}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-semibold text-white">
                {trade.name}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {trade.summary}
              </p>

              <dl class="mt-6 space-y-4 border-t border-white/10 pt-5 text-sm">
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Operating model
                  </dt>
                  <dd class="mt-1 text-slate-100">
                    {operations.operatingModel}
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Service rhythm
                  </dt>
                  <dd class="mt-1 text-slate-300">
                    {operations.serviceRhythm}
                  </dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="delivery"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Delivery model
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          The site explains how work moves, not just what the brand says.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          These four stages are the spine of the buyer journey.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          deliveryStages.map(stage => (
            <ModernCard variant="outline" className="h-full p-6">
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/45">
                {stage.step}
              </p>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {stage.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{stage.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="readiness"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel />
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="programs"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Cross-trade programs
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Some scopes cross more than one lane.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          These recurring programs show where the right answer is coordinated,
          not siloed.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          tradePrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45">
                {program.tradeSlugs.length} linked trades
              </p>
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                  Typical outputs
                </p>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                  {program.outputs.map(output => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#12b5a6]" />
                      <span>{output}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative" id="contact" data-page-section data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div class="space-y-4">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Get started
            </p>
            <h2
              class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Need the right division or a cleaner starting scope?
            </h2>
            <p class="max-w-2xl text-base leading-7 text-slate-300">
              Browse the directory, use the services hub, or send a short brief
              with the problem you need solved.
            </p>
          </div>

