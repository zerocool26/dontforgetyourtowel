---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BuyerSituationRouter from '../components/business/BuyerSituationRouter.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import OperatingProofBoard from '../components/business/OperatingProofBoard.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ProviderSelectionStandard from '../components/business/ProviderSelectionStandard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { buyerSituations } from '../data/buyer-situations';
import { withBasePath } from '../utils/helpers';

const contactHref = withBasePath('contact-hq/');
const pricingHref = withBasePath('pricing/');
const servicesHref = withBasePath('services/');
const trustHref = withBasePath('trust-center/');
const heroMediaDesktop = withBasePath('media/chicago-ops-command.webp');
const heroMediaMobile = withBasePath('media/chicago-ops-command-mobile.webp');

const receiptTapeFields = [
  {
    label: 'Receipt',
    value: 'Operating proof',
  },
  {
    label: 'What you get',
    value: 'Visible owners. Clear risk. Recovery plan. Evidence you can share.',
  },
  {
    label: 'Delivered',
    value: 'Service ledger and first-phase plan',
  },
  {
    label: 'Next step',
    value: 'Your main issue, routed to a clearer first move',
  },
];

const operatingSignals = [
  {
    title: 'Response ownership',
    copy: 'Named owners for every support lane, vendor handoff, device issue, and escalation path.',
  },
  {
    title: 'Security baseline',
    copy: 'MFA, endpoint, email, admin roles, guest access, and exceptions documented in business language.',
  },
  {
    title: 'Recovery proof',
    copy: 'Protected systems, restore access, recovery order, and vendor dependencies reviewed before pressure hits.',
  },
  {
    title: 'Scope boundaries',
    copy: 'Recurring support, security depth, onsite work, and projects separated before pricing gets fuzzy.',
  },
];

const serviceLanes = [
  {
    label: 'Support',
    title: 'Managed IT support',
    copy: 'Help desk, onboarding, device standards, patching, and vendor follow-through.',
    href: servicesHref,
  },
  {
    label: 'Security',
    title: 'Cybersecurity operations',
    copy: 'MFA, endpoint protection, email defense, admin access, awareness, and response contacts.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Microsoft 365',
    title: 'Microsoft 365 operations',
    copy: 'Exchange, Teams, SharePoint, OneDrive, licensing, access rules, cleanup, and governance.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Continuity',
    title: 'Backup, network, and recovery',
    copy: 'Backup monitoring, restore checks, firewall, Wi-Fi, ISP coordination, and recovery order.',
    href: withBasePath('services/#technology-catalog'),
  },
];

const firstThirtyDays = [
  'Document users, devices, Microsoft 365, backups, vendors, network gear, admin roles, and recurring issues.',
  'Stabilize the support, access, email, and recovery gaps that create the most daily disruption.',
  'Deliver a 30/60/90 plan with owners, budget notes, and the decisions leadership needs to make next.',
];

const firstPhaseOutputs = [
  'Owners assigned',
  'Service ledger',
  'Risk and recovery summary',
  '30/60/90 day plan',
];

const evidenceReceiptFields = [
  { label: 'Account shape', value: '25-150 user teams' },
  { label: 'Delivered', value: 'Operating proof board' },
  { label: 'Review rhythm', value: 'onboarding, then cadence' },
  { label: 'Pages', value: 'owners, risks, scope' },
];

const routeBoardSteps = [
  'Main issue',
  'First owner',
  'Evidence needed',
  'Next decision',
];
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Managed IT, Security, Microsoft 365, and Backup"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and support ownership for firms that need calmer operations."
  mainClass="relative overflow-x-clip"
  bodyClass="home-reboot"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-reboot-hero" id="landing-hero" data-page-section>
    <picture class="home-reboot-hero__media">
      <source media="(max-width: 767px)" srcset={heroMediaMobile} />
      <img
        src={heroMediaDesktop}
        alt="Chicago skyline behind a managed IT operations desk at dusk"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="home-reboot-hero__shade" aria-hidden="true"></div>

    <div class="home-reboot-shell home-reboot-hero__grid">
      <div class="home-reboot-hero__content">
        <h1 class="home-reboot-title">
          When IT feels ownerless, the business slows down.
        </h1>
        <p class="home-reboot-copy home-reboot-copy--large">
          Chicago-area support, cybersecurity, Microsoft 365, backup, network,
          and vendor work organized around visible owners, evidence, and the
          next decision.
        </p>

        <div class="home-reboot-actions" aria-label="Primary actions">
          <ModernButton
            href={contactHref}
            variant="gradient"
            rounded="sm"
            className="home-reboot-primary-action"
          >
            Start fit check
          </ModernButton>
          <ModernButton
            href={pricingHref}
            variant="outline"
            rounded="sm"
            className="home-reboot-secondary-action"
          >
            See pricing logic
          </ModernButton>
        </div>
      </div>

      <div class="home-reboot-hero__board">
        <OperatingProofBoard />
      </div>
    </div>

    <div class="home-reboot-receipt-tape" aria-label="First review receipt">
      <div class="home-reboot-shell home-reboot-receipt-tape__grid">
        {
          receiptTapeFields.map(field => (
            <div class="home-reboot-receipt-tape__field">
              <span>{field.label}</span>
              <strong>{field.value}</strong>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--model"
    id="operating-proof-board"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-model">
      <div class="home-reboot-section-heading">
        <h2 class="home-reboot-section-title">
          Make the operating model easier to explain.
        </h2>
        <p class="home-reboot-copy">
          A better first review turns messy support, access, recovery, and scope
          questions into visible ownership. That is what leadership can inspect,
          fund, and hold steady.
        </p>
      </div>

      <div class="home-reboot-model__signals" aria-label="Operating signals">
        {
          operatingSignals.map((signal, index) => (
            <article class="home-reboot-model-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{signal.title}</h3>
              <p>{signal.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--receipt"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-receipt-section">
      <div class="home-reboot-section-heading">
        <h2 class="home-reboot-section-title">
          The first review should leave a receipt.
        </h2>
        <p class="home-reboot-copy">
          Response ownership, access risk, recovery confidence, Microsoft 365
          cleanup, and scope boundaries should be visible early enough to shape
          the first decision.
        </p>
      </div>

      <aside
        class="home-reboot-receipt tone-artifact-paper"
        aria-label="Example evidence receipt"
      >
        <div class="home-reboot-receipt__stack" aria-hidden="true"></div>
        <div class="home-reboot-receipt__header">
          <p>Evidence receipt</p>
          <span class="tone-proof-stamp">Review complete</span>
        </div>
        <dl>
          {
            evidenceReceiptFields.map(field => (
              <div>
                <dt>{field.label}</dt>
                <dd>{field.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--router"
    id="situation-router"
    data-page-section
  >
    <div class="home-reboot-shell">
      <BuyerSituationRouter
        client:only="preact"
        situations={buyerSituations}
        contactHref={contactHref}
        pricingHref={pricingHref}
        trustHref={trustHref}
        defaultSituationId="provider-stall"
        eyebrow="Fit router"
        title="Pick the pressure point. Get the right first move."
        description="A serious MSP conversation should start with what is happening in the business, not a menu of tools. Choose the closest situation and send a cleaner first brief."
      />
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--services"
    id="services"
    data-page-section
  >
    <div class="home-reboot-shell">
      <div
        class="home-reboot-section-heading home-reboot-section-heading--wide"
      >
        <p class="home-reboot-kicker">What we own</p>
        <h2 class="home-reboot-section-title">
          Four clear service lanes for the daily IT mess.
        </h2>
        <p class="home-reboot-copy">
          Start with the problem in front of you, then route it to the right
          support, security, Microsoft 365, or recovery owner.
        </p>
      </div>

      <div class="home-reboot-lanes">
        {
          serviceLanes.map((lane, index) => (
            <a class="home-homepage-lane home-reboot-lane" href={lane.href}>
              <span class="home-reboot-lane__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="home-homepage-lane__label home-reboot-lane__label">
                {lane.label}
              </span>
              <h3>{lane.title}</h3>
              <p>{lane.copy}</p>
              <strong>Open scope</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--operating"
    id="operating-standard"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-operating">
      <div class="home-reboot-section-heading">
        <p class="home-reboot-kicker">First phase</p>
        <h2 class="home-reboot-section-title">
          The first phase should calm the noise.
        </h2>
        <p class="home-reboot-copy">
          Before buying more tools, the environment needs a baseline, clear
          owners, and a practical plan leadership can understand.
        </p>
      </div>

      <div class="home-reboot-first-phase">
        <div class="home-homepage-first30 home-reboot-first30">
          <ol>
            {firstThirtyDays.map(item => <li>{item}</li>)}
          </ol>
        </div>
        <aside class="home-reboot-output-board" aria-label="First phase output">
          <p>First-phase output</p>
          <ul>
            {firstPhaseOutputs.map(item => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <ProofOperatingSystem
    eyebrow="What leadership should see"
    title="Support should leave a record, not another vague ticket thread."
    description="The first review should make the basics visible: open issues, vendor ownership, backup confidence, access risk, Microsoft 365 cleanup, and the budget decisions ahead."
    ctaHref={contactHref}
    ctaLabel="Send the main issue"
  />

  <ProviderSelectionStandard
    compact
    eyebrow="Why this should feel different"
    title="A good MSP makes the first questions easier to answer."
    description="The advantage is not a longer service list. It is whether ownership, recovery, access, Microsoft 365, recurring issues, and scope boundaries become visible fast."
    ctaHref={trustHref}
    ctaLabel="Review proof"
  />

  <section
    class="home-reboot-section home-reboot-section--handoff"
    id="decision-handoff"
    data-page-section
  >
    <div class="home-reboot-shell">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Decision handoff"
        title="A useful first conversation should leave you with a next step."
        description="Bring the rough counts, the current provider problem, and the urgent risk. The first reply should point to the right owner, missing details, and next action."
      />
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--final"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-final">
      <div>
        <p class="home-reboot-kicker">Ready when you are</p>
        <h2 class="home-reboot-section-title">
          Send the main issue. Get a clearer next step.
        </h2>
        <p class="home-reboot-copy">
          The first message does not need to be perfect. It only needs enough
          context to route the right owner, risk, and next decision.
        </p>
      </div>

      <aside class="home-reboot-route-board" aria-label="Route board">
        <p>Route board</p>
        <ol>
          {routeBoardSteps.map(step => <li>{step}</li>)}
        </ol>
      </aside>

      <div class="home-reboot-actions home-reboot-actions--final">
        <ModernButton href={contactHref} variant="gradient" rounded="sm">
          Start fit check
        </ModernButton>
        <ModernButton href={servicesHref} variant="outline" rounded="sm">
          What we own
        </ModernButton>
      </div>
    </div>
  </section>

  <style>
    :global(.home-reboot) {
      --home-bg: #07100f;
      --home-bg-2: #0b1715;
      --home-bg-3: #101817;
      --home-surface: rgba(9, 21, 20, 0.9);
      --home-surface-strong: rgba(4, 13, 12, 0.94);
      --home-line: rgba(213, 229, 215, 0.16);
      --home-line-strong: rgba(146, 230, 217, 0.28);
      --home-paper: #f2e8d4;
      --home-paper-soft: #e4d6bc;
      --home-ink: #101417;
      --home-text: #f7f0e3;
      --home-muted: rgba(232, 238, 229, 0.72);
      --home-faint: rgba(232, 238, 229, 0.5);
      --home-teal: #68d8cc;
      --home-teal-strong: #00a5a8;
      --home-amber: #e3b35c;
      background: var(--home-bg);
      color: var(--home-text);
    }

    :global(.home-reboot .tone-site-shell),
    :global(.home-reboot .tone-main-shell) {
      background: transparent;
    }

    .home-reboot-shell {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .home-reboot-hero {
      position: relative;
      min-height: max(42rem, calc(100svh - 4.5rem));
      display: grid;
      align-items: center;
      overflow: hidden;
      padding: clamp(4.5rem, 8vw, 7.5rem) 0 0;
      background: #050807;
      color: var(--home-text);
      isolation: isolate;
    }

    .home-reboot-hero__media,
    .home-reboot-hero__media img,
    .home-reboot-hero__shade {
      position: absolute;
      inset: 0;
    }

    .home-reboot-hero__media {
      z-index: -2;
      overflow: hidden;
      background: #050807;
    }

    .home-reboot-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 57% center;
      filter: saturate(0.95) contrast(1.08);
      transform: scale(1.012);
    }

    .home-reboot-hero__shade {
      z-index: -1;
      background:
        linear-gradient(
          90deg,
          rgba(5, 8, 7, 0.92) 0%,
          rgba(5, 8, 7, 0.74) 33%,
          rgba(5, 8, 7, 0.24) 58%,
          rgba(5, 8, 7, 0.72) 100%
        ),
        linear-gradient(
          180deg,
          rgba(5, 8, 7, 0.16) 0%,
          rgba(5, 8, 7, 0.12) 46%,
          rgba(5, 8, 7, 0.9) 100%
        );
      pointer-events: none;
    }

    .home-reboot-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        linear-gradient(rgba(247, 240, 227, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(247, 240, 227, 0.03) 1px, transparent 1px);
      background-size: 68px 68px;
      mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.45), transparent 76%);
    }

    .home-reboot-hero__grid {
      position: relative;
      z-index: 1;
      display: grid;
      gap: clamp(2rem, 4vw, 3.75rem);
      align-items: center;
      padding-bottom: clamp(2.5rem, 6vw, 4.75rem);
    }

    .home-reboot-hero__content {
      display: grid;
      gap: 1.25rem;
      max-width: 47rem;
    }

    .home-reboot-kicker {
      margin: 0;
      color: var(--home-faint);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1.45;
      text-transform: uppercase;
    }

    .home-reboot-title,
    .home-reboot-section-title {
      margin: 0;
      color: inherit;
      font-family: var(--font-display);
      font-weight: 790;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .home-reboot-title {
      max-width: 14ch;
      text-shadow: 0 3px 34px rgba(0, 0, 0, 0.68);
      font-size: clamp(3.15rem, 5.2vw, 5.35rem);
      line-height: 0.94;
    }

    .home-reboot-section-title {
      font-size: clamp(2rem, 4vw, 4.35rem);
      line-height: 0.98;
    }

    .home-reboot-copy {
      max-width: 64ch;
      margin: 0;
      color: var(--home-muted);
      font-size: 1rem;
      line-height: 1.65;
    }

    .home-reboot-copy--large {
      max-width: 44rem;
      color: rgba(247, 240, 227, 0.8);
      text-shadow: 0 2px 22px rgba(0, 0, 0, 0.6);
      font-size: clamp(1.05rem, 1.45vw, 1.22rem);
      line-height: 1.62;
    }

    .home-reboot-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: center;
      margin-top: 0.2rem;
    }

    .home-reboot-primary-action,
    .home-reboot-secondary-action,
    .home-reboot-actions :global(.modern-button) {
      min-height: 52px;
    }

    .home-reboot-hero__board {
      align-self: center;
      min-width: 0;
    }

    .home-reboot-hero__board :global(.operating-proof-board) {
      border-color: rgba(104, 216, 204, 0.28);
      background:
        linear-gradient(180deg, rgba(104, 216, 204, 0.07), transparent 38%),
        repeating-linear-gradient(
          0deg,
          transparent 0 4.45rem,
          rgba(213, 229, 215, 0.08) 4.45rem calc(4.45rem + 1px)
        ),
        rgba(2, 15, 14, 0.9);
      box-shadow:
        0 34px 90px -54px rgba(0, 0, 0, 0.95),
        0 0 0 6px rgba(0, 0, 0, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
    }

    .home-reboot-hero__board :global(.operating-proof-board__header h2) {
      color: var(--home-teal);
    }

    .home-reboot-receipt-tape {
      position: relative;
      z-index: 2;
      width: 100%;
      border-block: 1px solid rgba(16, 20, 23, 0.22);
      background:
        linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.5),
          transparent 16% 84%,
          rgba(255, 255, 255, 0.42)
        ),
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.42),
          rgba(228, 214, 188, 0.72)
        ),
        var(--home-paper);
      color: var(--home-ink);
      box-shadow: 0 -18px 48px rgba(0, 0, 0, 0.3);
    }

    .home-reboot-receipt-tape::before,
    .home-reboot-receipt-tape::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 0.5rem;
      background: radial-gradient(circle, var(--home-bg) 0 35%, transparent 38%)
        0 0 / 0.5rem 0.5rem;
    }

    .home-reboot-receipt-tape::before {
      left: 0;
    }

    .home-reboot-receipt-tape::after {
      right: 0;
    }

    .home-reboot-receipt-tape__grid {
      display: grid;
      gap: 0;
      padding: 1.05rem 0;
    }

    .home-reboot-receipt-tape__field {
      display: grid;
      gap: 0.35rem;
      min-height: 5rem;
      align-content: center;
      border-left: 1px solid rgba(16, 20, 23, 0.2);
      padding: 0.35rem clamp(1rem, 2vw, 1.35rem);
    }

    .home-reboot-receipt-tape__field:first-child {
      border-left: 0;
      padding-left: 0;
    }

    .home-reboot-receipt-tape__field span,
    .home-reboot-receipt-tape__field strong {
      font-family: var(--font-mono);
      line-height: 1.45;
    }

    .home-reboot-receipt-tape__field span {
      color: rgba(16, 20, 23, 0.64);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .home-reboot-receipt-tape__field strong {
      color: rgba(16, 20, 23, 0.82);
      font-size: clamp(0.78rem, 1vw, 0.9rem);
      font-weight: 700;
    }

    .home-reboot-section {
      position: relative;
      overflow: clip;
      padding: clamp(4rem, 7vw, 6.5rem) 0;
      border-top: 1px solid rgba(247, 240, 227, 0.09);
      background: var(--home-bg);
      color: var(--home-text);
    }

    .home-reboot-section::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(rgba(247, 240, 227, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(247, 240, 227, 0.026) 1px, transparent 1px);
      background-size: 70px 70px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 78%);
      opacity: 0.52;
    }

    .home-reboot-section > * {
      position: relative;
      z-index: 1;
    }

    .home-reboot-section--model {
      background:
        linear-gradient(90deg, rgba(104, 216, 204, 0.11), transparent 36%),
        var(--home-bg-2);
    }

    .home-reboot-section--router,
    .home-reboot-section--handoff {
      background: #08110f;
    }

    .home-reboot-section--services {
      background:
        linear-gradient(180deg, rgba(104, 216, 204, 0.04), transparent 28%),
        #06100f;
    }

    .home-reboot-section-heading {
      display: grid;
      gap: 1rem;
      max-width: 44rem;
    }

    .home-reboot-section-heading--wide {
      max-width: 58rem;
    }

    .home-reboot-model,
    .home-reboot-receipt-section,
    .home-reboot-operating,
    .home-reboot-final {
      display: grid;
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .home-reboot-model__signals {
      display: grid;
      gap: 0;
      border-block: 1px solid var(--home-line);
    }

    .home-reboot-model-card {
      display: grid;
      gap: 0.65rem;
      min-height: 13rem;
      align-content: center;
      border-bottom: 1px solid var(--home-line);
      padding: clamp(1rem, 2vw, 1.35rem);
    }

    .home-reboot-model-card:last-child {
      border-bottom: 0;
    }

    .home-reboot-model-card span,
    .home-reboot-lane__number,
    .home-reboot-lane__label,
    .home-reboot-lane strong,
    .home-reboot-output-board p,
    .home-reboot-route-board p {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.12em;
