---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ChicagoSkyline from '../components/ChicagoSkyline.astro';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const contactHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake - Olive Global Systems')}`;

const serviceLanes = [
  {
    index: '01',
    label: 'Operate',
    title: 'Managed IT that actually owns the day-to-day',
    copy: 'Help desk, endpoint management, onboarding, vendor coordination, and recurring maintenance under one accountable operating model.',
    href: withBasePath('services/'),
  },
  {
    index: '02',
    label: 'Protect',
    title: 'Security and compliance without enterprise theater',
    copy: 'Identity, email protection, endpoint security, compliance readiness, and response planning that leadership can actually follow.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    index: '03',
    label: 'Modernize',
    title: 'Cloud and Microsoft 365 with practical leverage',
    copy: 'Migration, cleanup, collaboration governance, backup strategy, and workflow automation tied to lower drag and better visibility.',
    href: withBasePath('build-studio/'),
  },
  {
    index: '04',
    label: 'Present',
    title: 'A digital front door that feels as strong as the backend',
    copy: 'Selective website, portal, and client-facing work for firms whose presentation needs to match the quality of their operations.',
    href: withBasePath('about/'),
  },
];

const outcomePoints = [
  'One partner for support, security, Microsoft 365, and infrastructure decisions',
  'A Chicago-specific service story that reads clearly on mobile',
  'A sharper first impression before the first sales or intake call',
];

const operatingSignals = [
  {
    label: 'Response ownership',
    copy: 'Clear ticket lanes, escalation rules, and a weekly view of what is open, aging, blocked, or recurring.',
  },
  {
    label: 'Security baseline',
    copy: 'Identity, endpoint, email, backup, and admin-access checks before new tools or larger projects are layered in.',
  },
  {
    label: 'Executive visibility',
    copy: 'Plain-language priorities, risk notes, and roadmap sequencing that leadership can use without translating IT noise.',
  },
];

const firstThirtyDays = [
  'Map users, devices, Microsoft 365, network, backup, vendors, and support pain',
  'Stabilize urgent support and security gaps before expanding scope',
  'Create a practical roadmap with owners, budget ranges, and the next decision point',
];

const startOptions = [
  {
    title: 'Need service coverage?',
    copy: 'Start with the solution hub if you need help desk ownership, security lift, M365 guidance, or infrastructure support.',
    href: withBasePath('services/'),
    cta: 'View solutions',
  },
  {
    title: 'Need budget clarity?',
    copy: 'Use pricing when the main question is directional budget, coverage depth, or whether co-managed support makes sense.',
    href: withBasePath('pricing/'),
    cta: 'See pricing',
  },
  {
    title: 'Need a first-phase roadmap?',
    copy: 'Use the roadmap studio to shape the first 30, 60, or 90 days before the first detailed scope call.',
    href: withBasePath('build-studio/'),
    cta: 'Open roadmap',
  },
];
---

<MarketingLayout
  title="Olive Global Systems | Chicago Managed IT, Security, and Digital Systems"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and selective digital systems for firms that need steadier operations and a stronger first impression."
  mainClass="relative overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-homepage-hero" id="landing-hero" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-hero__shell">
        <div class="home-homepage-hero__copy">
          <p class="home-homepage-eyebrow">
            Chicago managed IT and cybersecurity
          </p>
          <h1 class="home-homepage-title">
            Support that answers.
            <span>Security that holds.</span>
            <span>A sharper Chicago front door.</span>
          </h1>
          <p class="home-homepage-copy">
            Managed IT, cybersecurity, Microsoft 365, cloud, backup, networking,
            and selective digital systems for Chicago-area teams that need
            technology to feel organized again.
          </p>

          <div class="home-homepage-actions">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[54px]"
            >
              Start strategy intake
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="outline"
              className="min-h-[54px]"
            >
              Explore services
            </ModernButton>
          </div>

          <ul class="home-homepage-outcomes" aria-label="Primary outcomes">
            {outcomePoints.map(item => <li>{item}</li>)}
          </ul>
        </div>

        <div class="home-homepage-hero__art" aria-hidden="true">
          <div class="home-homepage-art-panel">
            <div class="home-homepage-art-panel__topline">
              <span>Operate</span>
              <span>Protect</span>
              <span>Modernize</span>
              <span>Present</span>
            </div>

            <div class="home-homepage-art-panel__headline">
              <span>Built</span>
              <span>for</span>
              <span>Chicago</span>
              <span>uptime.</span>
            </div>

            <div class="home-homepage-art-panel__rule"></div>

            <div class="home-homepage-art-panel__skyline">
              <ChicagoSkyline
                className="home-homepage-skyline"
                style="width:min(100%,30rem);height:4.2rem;"
              />
            </div>

            <div class="home-homepage-art-panel__meta">
              <p>Managed IT and support</p>
              <p>Security and compliance</p>
              <p>Cloud and M365</p>
              <p>Premium digital systems</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-homepage-section" id="services" data-page-section>
    <div class="premium-container">
      <div class="home-homepage-section__intro">
        <p class="home-homepage-eyebrow">What we do</p>
        <h2 class="home-homepage-section__title">
          Four lanes that make the operating model easier to understand.
        </h2>
        <p class="home-homepage-section__copy">
          The service story is intentionally organized around the decisions
          Chicago-area teams actually have to make: who owns support, how risk
          gets reduced, what cloud work should change first, and how the public
          experience supports trust.
        </p>
      </div>

      <div class="home-homepage-lanes">
        {
          serviceLanes.map(lane => (
            <a class="home-homepage-lane" href={lane.href}>
              <div class="home-homepage-lane__meta">
                <span class="home-homepage-lane__index">{lane.index}</span>
                <span class="home-homepage-lane__label">{lane.label}</span>
              </div>
              <div class="home-homepage-lane__body">
                <h3>{lane.title}</h3>
                <p>{lane.copy}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section"
    id="operating-standard"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-operating">
        <div class="home-homepage-section__intro">
          <p class="home-homepage-eyebrow">Operating standard</p>
          <h2 class="home-homepage-section__title">
            The first phase should make the environment easier to run, not just
            easier to sell.
          </h2>
          <p class="home-homepage-section__copy">
            Intake starts by separating urgent support needs from structural
            risk. That keeps early work concrete and gives leadership a clean
            view of what should happen now, next, and later.
          </p>
        </div>

        <div class="home-homepage-operating__grid">
          <div class="home-homepage-operating__signals">
            {
              operatingSignals.map(signal => (
                <article class="home-homepage-signal">
                  <h3>{signal.label}</h3>
                  <p>{signal.copy}</p>
                </article>
              ))
            }
          </div>

          <div class="home-homepage-first30" aria-labelledby="first30-title">
            <p class="home-homepage-eyebrow">First 30 days</p>
            <h3 id="first30-title">
              A practical start, before the bigger roadmap.
            </h3>
            <ol>
              {firstThirtyDays.map(item => <li>{item}</li>)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="home-homepage-section home-homepage-section--closing"
    data-page-section
  >
    <div class="premium-container">
      <div class="home-homepage-closing">
        <div class="home-homepage-closing__intro">
          <p class="home-homepage-eyebrow">Choose the next move</p>
          <h2 class="home-homepage-section__title">
            Start where the pressure is: support, budget, or roadmap shaping.
          </h2>
        </div>

        <div class="home-homepage-start-list">
          {
            startOptions.map(option => (
              <a class="home-homepage-start-item" href={option.href}>
                <div>
                  <h3>{option.title}</h3>
                  <p>{option.copy}</p>
                </div>
                <span>{option.cta}</span>
              </a>
            ))
          }
        </div>

        <div class="home-homepage-closeout">
          <div>
            <p class="home-homepage-eyebrow">Ready to move</p>
            <h3 class="home-homepage-closeout__title">
              Fix the operating layer first. Improve the front door with the
              same discipline.
            </h3>
          </div>

          <div class="home-homepage-actions home-homepage-actions--closeout">
            <ModernButton
              href={contactHref}
              variant="primary"
              className="min-h-[52px]"
            >
              Book intake
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Review pricing
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .home-homepage-hero,
    .home-homepage-section {
      position: relative;
      padding: clamp(4rem, 8vw, 7rem) 0;
    }

    .home-homepage-hero {
      padding-top: clamp(5.4rem, 8vw, 7rem);
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .home-homepage-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(
          circle at 14% 10%,
          color-mix(in srgb, var(--color-primary) 14%, transparent),
          transparent 30%
        ),
        linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22%);
      pointer-events: none;
    }

    .home-homepage-hero__shell {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 3.2rem;
      align-items: start;
    }

    .home-homepage-hero__copy {
      display: grid;
      gap: 1.35rem;
      max-width: 43rem;
    }

    .home-homepage-eyebrow {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-muted) 94%, transparent);
      font-family: var(--font-sans);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .home-homepage-title {
      max-width: 9.6ch;
      margin: 0;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(2.85rem, 7.5vw, 6.1rem);
      font-weight: 700;
      line-height: 0.92;
      letter-spacing: -0.065em;
      text-wrap: balance;
    }

    .home-homepage-title span {
      display: block;
    }

    .home-homepage-title span:first-of-type {
      color: color-mix(in srgb, var(--color-text-primary) 70%, transparent);
    }

    .home-homepage-title span:last-of-type {
      color: color-mix(in srgb, var(--color-primary) 78%, white 22%);
    }

    .home-homepage-copy,
    .home-homepage-section__copy,
    .home-homepage-lane p,
    .home-homepage-start-item p {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
      font-size: clamp(1.02rem, 1.26vw, 1.1rem);
      line-height: 1.76;
    }

    .home-homepage-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      padding-top: 0.25rem;
    }

    .home-homepage-outcomes {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 1.35rem 0 0;
      list-style: none;
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
    }

    .home-homepage-outcomes li {
      position: relative;
      padding-left: 1.2rem;
      color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .home-homepage-outcomes li::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 0;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-primary) 84%, white 16%);
    }

    .home-homepage-art-panel {
      position: relative;
      overflow: hidden;
      min-height: 100%;
      padding: clamp(1.2rem, 3vw, 1.8rem) 0 0;
    }

    .home-homepage-art-panel::before,
    .home-homepage-art-panel::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      height: 1px;
      background: color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-art-panel::before {
      top: 0;
    }

    .home-homepage-art-panel::after {
      bottom: 0;
    }

    .home-homepage-art-panel__topline,
    .home-homepage-art-panel__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem 1rem;
      color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
      font-family: var(--font-sans);
      font-size: 0.65rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .home-homepage-art-panel__headline {
      display: grid;
      gap: 0.1rem;
      margin: 1.1rem 0 1rem;
      color: var(--color-text-primary);
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6.4vw, 4.75rem);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -0.07em;
      text-transform: uppercase;
    }

    .home-homepage-art-panel__headline span:nth-child(2),
    .home-homepage-art-panel__headline span:nth-child(3) {
      padding-left: clamp(1rem, 4vw, 2.5rem);
      color: color-mix(in srgb, var(--color-text-primary) 42%, transparent);
    }

    .home-homepage-art-panel__headline span:last-child {
      color: color-mix(in srgb, var(--color-primary) 80%, white 20%);
    }

    .home-homepage-art-panel__rule {
      height: 1px;
      margin: 0 0 1rem;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-border) 70%, transparent),
        color-mix(in srgb, var(--color-primary) 55%, transparent),
        transparent
      );
    }

    .home-homepage-art-panel__skyline {
      padding: 0 0 0.9rem;
      color: color-mix(in srgb, var(--color-primary) 76%, white 24%);
    }

    .home-homepage-skyline {
      display: block;
      --skyline-width: min(100%, 30rem);
      --skyline-height: 4.2rem;
      width: min(100%, 30rem);
      height: 4.2rem;
      opacity: 0.9;
    }

    .home-homepage-section {
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 72%, transparent);
    }

    .home-homepage-section__intro {
      display: grid;
      gap: 0.85rem;
      max-width: 44rem;
      margin-bottom: 2.35rem;
    }

    .home-homepage-section__title,
    .home-homepage-lane h3,
    .home-homepage-start-item h3,
    .home-homepage-closeout__title {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.45rem, 3vw, 3rem);
      font-weight: 700;
      line-height: 0.98;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .home-homepage-lanes {
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-lane {
      display: grid;
      gap: 1rem;
      padding: 1.55rem 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .home-homepage-lane:hover {
      transform: translateX(3px);
      border-color: color-mix(
        in srgb,
        var(--color-text-primary) 20%,
        transparent
      );
    }

    .home-homepage-lane__meta {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .home-homepage-lane__index {
      color: color-mix(in srgb, var(--color-text-primary) 34%, transparent);
      font-family: var(--font-display);
      font-size: 1.1rem;
      letter-spacing: -0.04em;
    }

    .home-homepage-lane__label {
      color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .home-homepage-lane h3,
    .home-homepage-start-item h3 {
      font-size: clamp(1.3rem, 2vw, 1.8rem);
      margin-bottom: 0.55rem;
    }

    .home-homepage-closing {
      display: grid;
      gap: 2rem;
    }

    .home-homepage-operating {
      display: grid;
      gap: 2.25rem;
    }

    .home-homepage-operating__grid {
      display: grid;
      gap: 2rem;
      align-items: start;
    }

    .home-homepage-operating__signals {
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-signal {
      display: grid;
      gap: 0.45rem;
      padding: 1.35rem 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
    }

    .home-homepage-signal h3,
    .home-homepage-first30 h3 {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.25rem, 2vw, 1.75rem);
      font-weight: 700;
      line-height: 1.03;
      letter-spacing: -0.04em;
      text-wrap: balance;
    }

    .home-homepage-signal p,
    .home-homepage-first30 li {
      margin: 0;
      color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
      font-size: 0.98rem;
      line-height: 1.68;
    }

    .home-homepage-first30 {
      position: relative;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
      border-radius: var(--radius-sm);
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-surface) 94%, white 2%),
          color-mix(in srgb, var(--color-surface) 88%, transparent)
        ),
        color-mix(in srgb, var(--color-surface) 88%, transparent);
      padding: clamp(1.2rem, 3vw, 1.7rem);
      box-shadow: 0 24px 54px -44px rgba(0, 0, 0, 0.62);
    }

    .home-homepage-first30 ol {
      display: grid;
      gap: 1rem;
      margin: 1.2rem 0 0;
      padding: 0;
      list-style: none;
      counter-reset: first30;
    }

    .home-homepage-first30 li {
      position: relative;
      min-height: 2.4rem;
      padding-left: 3rem;
      counter-increment: first30;
    }

    .home-homepage-first30 li::before {
      content: counter(first30, decimal-leading-zero);
      position: absolute;
      top: 0.1rem;
      left: 0;
      display: inline-flex;
      width: 2.1rem;
      height: 2.1rem;
      align-items: center;
      justify-content: center;
      border: 1px solid
        color-mix(in srgb, var(--color-primary) 30%, transparent);
      border-radius: var(--radius-sm);
      background: color-mix(in srgb, var(--color-primary) 11%, transparent);
      color: color-mix(in srgb, var(--color-text-primary) 84%, transparent);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .home-homepage-start-list {
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 70%, transparent);
    }

    .home-homepage-start-item {
      display: grid;
      gap: 1rem;
      align-items: end;
      padding: 1.45rem 0;
      border-bottom: 1px solid
        color-mix(in srgb, var(--color-border) 66%, transparent);
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .home-homepage-start-item span {
      color: var(--color-text-primary);
      font-size: 0.92rem;
      font-weight: 700;
    }

    .home-homepage-start-item:hover {
      transform: translateX(3px);
      border-color: color-mix(
        in srgb,
        var(--color-text-primary) 20%,
        transparent
      );
    }

    .home-homepage-closeout {
      display: grid;
      gap: 1.2rem;
      padding-top: 0.5rem;
    }

    @media (min-width: 960px) {
      .home-homepage-hero__shell {
        grid-template-columns: minmax(0, 1fr) minmax(21rem, 27rem);
      }

      .home-homepage-lane {
        grid-template-columns: 8rem minmax(0, 1fr);
        align-items: start;
      }

      .home-homepage-start-item {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .home-homepage-operating__grid {
        grid-template-columns: minmax(0, 1fr) minmax(21rem, 28rem);
      }

      .home-homepage-closeout {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
      }
    }

    @media (max-width: 767px) {
      .home-homepage-hero {
        padding-top: calc(5.8rem + env(safe-area-inset-top));
      }

      .home-homepage-title {
        max-width: 100%;
        font-size: clamp(2.45rem, 12vw, 4.25rem);
      }

      .home-homepage-actions,
      .home-homepage-actions--closeout {
        flex-direction: column;
      }

      .home-homepage-art-panel__headline {
        font-size: clamp(2.1rem, 13vw, 3.45rem);
      }
    }
  </style>
</MarketingLayout>
