---
import Layout from '../layouts/MarketingLayout.astro';
import OliveUniverse from '../components/react/OliveUniverse';
---

<Layout
  title="Olive Global Systems — Immersive Creative Systems"
  description="A single fullscreen interactive landing experience built as a cinematic digital showcase for Olive Global Systems."
  mainClass="m-0 p-0"
  bodyClass="overflow-hidden bg-[#02040a]"
  showFooter={false}
  showStickyCTA={false}
  showHeader={false}
  showMobileNav={false}
  showLiveChat={false}
  enableClientRouter={false}
>
  <OliveUniverse client:load />
</Layout>
