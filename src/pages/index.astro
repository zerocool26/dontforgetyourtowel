---
import Layout from '../layouts/MarketingLayout.astro';
import OliveUniverse from '../components/react/OliveUniverse';
import SignalGrid from '../components/landing/SignalGrid.astro';
import EngagementSection from '../components/landing/EngagementSection.astro';
import InsightSection from '../components/landing/InsightSection.astro';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { CONTACT_EMAIL } from '../consts';
import { studioPresets } from '../data/build-studio';
import { withBasePath } from '../utils/helpers';

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Creative project inquiry')}`;

const lanes = [
  {
    label: 'AI Systems',
    href: withBasePath('services/#ai'),
  },
  {
    label: 'Cybersecurity',
    href: withBasePath('services/#cybersecurity'),
  },
  {
    label: 'Cloud Engineering',
    href: withBasePath('services/#cloud'),
  },
  {
    label: 'Managed Operations',
    href: withBasePath('services/#managed-it'),
  },
];

const demoLaunches = [
  {
    label: 'Build Studio',
    href: withBasePath('build-studio/#studio'),
  },
  {
    label: 'Cart flow',
    href: withBasePath('about/?demo=cart#shop-experience'),
  },
  {
    label: 'Compare mode',
    href: withBasePath('about/?demo=compare#shop-experience'),
  },
  {
    label: 'Quick view',
    href: withBasePath(
      'about/?demo=quickview&product=spectral-sneaker#shop-experience'
    ),
  },
  {
    label: 'Checkout simulation',
    href: withBasePath(
      'about/?demo=checkout&product=aurora-hoodie#shop-experience'
    ),
  },
];
---

<Layout
  title="Olive Global Systems — Creative Technology Studio"
  description="Story-driven digital systems: creative direction, engineering, security, and operations unified in one delivery model."
  showFooter={false}
  enableClientRouter={false}
>
  <main class="creative-page overflow-x-hidden">
    <OliveUniverse client:only="react" />

    <section
      class="mx-auto max-w-6xl px-6 pb-16 pt-8 sm:px-10 sm:pb-20 sm:pt-10"
      data-reveal
    >
      <div class="creative-hero-shell p-4 sm:p-5">
        <div class="mb-4 flex flex-wrap items-center gap-2">
          <span class="creative-kicker">Creative Lanes</span>
          {
            lanes.map(lane => (
              <a class="creative-chip" href={lane.href}>
                {lane.label}
              </a>
            ))
          }
        </div>

        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span class="creative-kicker">Live Demo Launch</span>
          {
            demoLaunches.map(item => (
              <a class="creative-chip" href={item.href}>
                {item.label}
              </a>
            ))
          }
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <ModernCard variant="minimal" className="creative-panel p-6">
            <p
              class="tone-muted text-xs font-semibold uppercase tracking-[0.32em]"
            >
              Cognitive Systems
            </p>
            <h2 class="creative-title tone-title mt-3 text-3xl">
              AI Orchestration & Advanced Dev
            </h2>
            <p class="creative-copy mt-4 text-[15px]">
              Multi-agent products, decision systems, and AI-native workflows
              crafted for clarity, speed, and measurable impact.
            </p>
            <ul class="tone-body mt-6 space-y-3 text-sm">
              <li class="flex items-start gap-3">
                <span
                  class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-[#ccff00] shadow-[0_0_8px_rgba(204,255,0,0.8)]"
                ></span>
                <span class="text-neutral-300"
                  >Autonomous workflow architecture and orchestration</span
                >
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-[#ccff00] shadow-[0_0_8px_rgba(204,255,0,0.8)]"
                ></span>
                <span class="text-neutral-300"
                  >Custom copilots with guardrails and governance</span
                >
              </li>
              <li class="flex items-start gap-2">
                <span
                  class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-[#ccff00] shadow-[0_0_8px_rgba(204,255,0,0.8)]"
                ></span>
                <span
                  >Realtime data interfaces for operational storytelling</span
                >
              </li>
            </ul>
            <div class="mt-6 flex flex-wrap gap-3">
              <ModernButton
                href={withBasePath('services/')}
                variant="primary"
                className="min-h-[48px]"
              >
                Explore services
              </ModernButton>
              <ModernButton
                href={startProjectHref}
                variant="secondary"
                className="min-h-[48px]"
              >
                Start a project
              </ModernButton>
            </div>
          </ModernCard>

          <ModernCard variant="minimal" className="creative-panel p-6">
            <p
              class="tone-muted text-xs font-semibold uppercase tracking-[0.32em]"
            >
              Digital Resilience
            </p>
            <h2 class="creative-title tone-title mt-3 text-2xl font-semibold">
              Cybersecurity & Platform Reliability
            </h2>
            <p class="creative-copy mt-3 text-sm">
              Security and reliability programs built to support ambitious
              product velocity, not slow it down.
            </p>
            <ul class="tone-body mt-5 space-y-2 text-sm">
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-violet-400"
                ></span>
                <span>Threat modeling tied directly to product roadmaps</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-violet-400"
                ></span>
                <span>Identity and access systems with resilient defaults</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-violet-400"
                ></span>
                <span>Operational runbooks that keep launches calm</span>
              </li>
            </ul>
            <div class="mt-6 flex flex-wrap gap-3">
              <ModernButton
                href={withBasePath('about/')}
                variant="secondary"
                className="min-h-[48px]"
              >
                View portfolio
              </ModernButton>
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
                className="min-h-[48px]"
              >
                Contact HQ
              </ModernButton>
            </div>
          </ModernCard>
        </div>
      </div>
    </section>

    <section class="tone-border tone-surface border-y" data-reveal>
      <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
          <div class="space-y-5">
            <span class="creative-kicker">Flagship showcase</span>
            <h2
              class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
            >
              Build Studio turns the site into a live strategy room.
            </h2>
            <p class="creative-copy text-sm sm:text-base">
              Configure a premium product system in real time—preset direction,
              launch tempo, modular capabilities, investment range, delivery
              arc, and a contact-ready build brief that travels with the link.
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <ModernCard variant="minimal" className="creative-panel p-5">
                <p class="tone-title text-sm font-semibold">Shareable state</p>
                <p class="tone-body mt-2 text-sm">
                  Every preset, module, and urgency choice syncs into the URL so
                  a premium brief can be reviewed or handed off instantly.
                </p>
              </ModernCard>
              <ModernCard variant="minimal" className="creative-panel p-5">
                <p class="tone-title text-sm font-semibold">Intake handoff</p>
                <p class="tone-body mt-2 text-sm">
                  The route feeds a structured project brief into Contact HQ so
                  the discovery flow feels like a real product, not a dead end.
                </p>
              </ModernCard>
            </div>

            <div class="flex flex-wrap gap-3">
              <ModernButton
                href={withBasePath('build-studio/#studio')}
                variant="primary"
                className="min-h-[48px]"
              >
                Open Build Studio
              </ModernButton>
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="secondary"
                className="min-h-[48px]"
              >
                Start from a live brief
              </ModernButton>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              studioPresets.slice(0, 4).map(preset => (
                <ModernCard variant="minimal" className="creative-panel p-5">
                  <p class="tone-muted text-xs uppercase tracking-[0.22em]">
                    {preset.kicker}
                  </p>
                  <p class="tone-title mt-3 text-lg font-semibold">
                    {preset.name}
                  </p>
                  <p class="tone-body mt-2 text-sm leading-relaxed">
                    {preset.summary}
                  </p>
                </ModernCard>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="tone-border tone-surface border-y" data-reveal>
      <div
        class="mx-auto grid max-w-6xl gap-4 px-6 py-10 sm:grid-cols-2 sm:px-10 lg:grid-cols-4"
      >
        <ModernCard variant="minimal" className="creative-panel p-5">
          <p class="tone-muted text-xs uppercase tracking-[0.22em]">
            Delivery Rhythm
          </p>
          <p class="tone-title mt-2 text-2xl font-semibold">
            Rapid + Structured
          </p>
          <p class="tone-body mt-1 text-xs">
            Creative exploration with clear production checkpoints.
          </p>
        </ModernCard>
        <ModernCard variant="minimal" className="creative-panel p-5">
          <p class="tone-muted text-xs uppercase tracking-[0.22em]">
            Specialties
          </p>
          <p class="tone-title mt-2 text-2xl font-semibold">6 Practice Lanes</p>
          <p class="tone-body mt-1 text-xs">
            AI, security, cloud, product, ops, and platform systems.
          </p>
        </ModernCard>
        <ModernCard variant="minimal" className="creative-panel p-5">
          <p class="tone-muted text-xs uppercase tracking-[0.22em]">
            Engagements
          </p>
          <p class="tone-title mt-2 text-2xl font-semibold">Sprint → Program</p>
          <p class="tone-body mt-1 text-xs">
            Start focused, then scale into long-term operating support.
          </p>
        </ModernCard>
        <ModernCard variant="minimal" className="creative-panel p-5">
          <p class="tone-muted text-xs uppercase tracking-[0.22em]">
            Collaboration
          </p>
          <p class="tone-title mt-2 text-2xl font-semibold">Embedded Teams</p>
          <p class="tone-body mt-1 text-xs">
            We work inside your velocity, not in parallel to it.
          </p>
        </ModernCard>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-14 sm:px-10 sm:py-20" data-reveal>
      <SignalGrid />
    </section>

    <section class="mx-auto max-w-6xl px-6 py-14 sm:px-10 sm:py-20" data-reveal>
      <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
        <div class="space-y-5">
          <span class="creative-kicker">Why teams switch</span>
          <h2
            class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
          >
            One creative engineering partner instead of five disconnected
            vendors.
          </h2>
          <p class="creative-copy text-sm">
            The biggest product drag comes from fragmented ownership. We unify
            strategy, execution, and operations so your roadmap keeps momentum
            from concept to release.
          </p>
          <div class="flex flex-wrap gap-3">
            <ModernButton
              href={withBasePath('services/')}
              variant="primary"
              className="min-h-[48px]"
            >
              Explore all capabilities
            </ModernButton>
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Compare delivery paths
            </ModernButton>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-title text-sm font-semibold">
              Narrative-first design
            </p>
            <p class="tone-body mt-2 text-sm">
              Interfaces are sequenced like stories, not random blocks.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-title text-sm font-semibold">Engineered motion</p>
            <p class="tone-body mt-2 text-sm">
              Animation supports comprehension instead of visual noise.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-title text-sm font-semibold">Security in the loop</p>
            <p class="tone-body mt-2 text-sm">
              Governance and controls are designed in from day one.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-title text-sm font-semibold">
              Outcome accountability
            </p>
            <p class="tone-body mt-2 text-sm">
              Every phase maps to measurable business movement.
            </p>
          </ModernCard>
        </div>
      </div>
    </section>

    <section class="tone-border tone-surface border-y" data-reveal>
      <div class="mx-auto max-w-6xl px-6 py-16 sm:px-10 sm:py-20">
        <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div class="space-y-5">
            <span class="creative-kicker">Guided discovery</span>
            <h2
              class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
            >
              Route the right engagement before the backlog gets noisy.
            </h2>
            <p class="creative-copy text-sm sm:text-base">
              Use the interactive planner to identify the best first move,
              compare plans without leaving the site, and launch a tailored
              intake from mobile or desktop in a few taps.
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <ModernCard variant="minimal" className="creative-panel p-5">
                <p class="tone-title text-sm font-semibold">
                  Operate without chaos
                </p>
                <p class="tone-body mt-2 text-sm">
                  Start with managed operations, support, and reporting if the
                  current problem is noise, downtime, or support sprawl.
                </p>
              </ModernCard>
              <ModernCard variant="minimal" className="creative-panel p-5">
                <p class="tone-title text-sm font-semibold">
                  Scale with intent
                </p>
                <p class="tone-body mt-2 text-sm">
                  Move into cloud, security, or AI delivery once the baseline is
                  stable and the team is ready to compound gains.
                </p>
              </ModernCard>
            </div>

            <div class="flex flex-wrap gap-3">
              <ModernButton
                href={withBasePath('pricing/')}
                variant="primary"
                className="min-h-[48px]"
              >
                Compare plans
              </ModernButton>
              <ModernButton
                href={withBasePath('services/')}
                variant="secondary"
                className="min-h-[48px]"
              >
                Explore service lanes
              </ModernButton>
            </div>
          </div>

          <div class="tone-border tone-surface rounded-2xl border p-6">
            <ServicesQuiz
              client:visible
              kicker="Route your next move"
              title="Interactive service planner"
              ctaLabel="Start tailored intake"
            />
          </div>
        </div>
      </div>
    </section>

    <EngagementSection />
    <InsightSection />
  </main>
</Layout>
