---

<MarketingLayout
  title="Olive Global Systems | Design-Forward MSP+ Systems"
  description="Design-forward MSP+ firm for managed IT, security, cloud, AI, automation, and premium client-facing systems."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="tone-section-divider relative min-h-[100svh] overflow-hidden border-b"
    id="landing-hero"
    data-page-section
    data-olive-universe="ready"
    data-olive-mobile-3d="optimized"
    data-olive-mode="lite"
  >
    <div aria-hidden="true" class="absolute inset-0">
      <canvas data-hero-canvas="true" class="block h-full w-full"></canvas>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.06),transparent_30%),linear-gradient(180deg,rgba(8,17,29,0.16),rgba(8,17,29,0.82)_72%,rgba(8,17,29,0.96))]"
      >
      </div>
    </div>

    <div
      class="premium-container relative z-10 flex min-h-[100svh] items-end pb-8 pt-18 sm:pb-16 sm:pt-28 lg:pb-18 lg:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
        <div class="space-y-7">
          <div class="space-y-3">
            <p class="premium-eyebrow">Olive Global Systems</p>
            <h1
              class="premium-title text-4xl font-semibold sm:text-5xl lg:text-6xl"
            >
              A design-forward MSP+ firm for teams that want calmer operations
              and sharper digital systems.
              <span class="sr-only"> Immersive landing experience.</span>
            </h1>
            <p class="premium-copy text-base sm:text-lg">
              Managed IT, security, cloud, AI, automation, and premium digital
              execution—organized to read fast on a phone and still feel high
              end.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('services/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Explore solutions
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review pricing
            </ModernButton>
            <ModernButton
              href={contactHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Start a strategy brief
            </ModernButton>
          </div>

          <div data-olive-links class="flex flex-wrap gap-2 pt-1">
            <a
              class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
              href={withBasePath('services/')}>Solutions</a
            >
            <a
              class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
              href={withBasePath('pricing/')}>Pricing</a
            >
            <a
              class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
              href={withBasePath('about/')}>Proof</a
            >
            <a
              class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
              href={withBasePath('build-studio/')}>Studio</a
            >
            <a
              class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
              href={withBasePath('contact-hq/')}>Contact</a
            >
          </div>

          <div data-home-jump-links class="flex flex-wrap gap-2 pt-1">
            {
              landingSections.map(section => (
                <a
                  class="tone-chip-soft tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                  href={section.href}
                >
                  {section.label}
                </a>
              ))
            }
          </div>

          <ModernCard variant="glass" className="tone-panel-soft p-5 lg:hidden">
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
            >
              At a glance
            </p>
            <div class="mt-4 grid gap-3 sm:grid-cols-3">
              {
                operatingHighlights.map(item => (
                  <div class="tone-panel-subtle tone-border rounded-2xl border p-4">
                    <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/45">
                      {item.label}
                    </p>
                    <p class="mt-2 text-2xl font-semibold tracking-tight text-white">
                      {item.value}
                    </p>
                    <p class="mt-2 text-xs leading-5 text-slate-300">
                      {item.note}
                    </p>
                  </div>
                ))
              }
            </div>
          </ModernCard>
        </div>

        <div
          class="hidden grid-cols-[0.8fr_1fr] gap-4 lg:grid lg:min-h-[430px]"
        >
          <div class="grid gap-4">
            {
              heroMedia.slice(0, 2).map(item => (
                <figure class="premium-media min-h-[150px]">
                  <img
                    src={item.src}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="premium-chip absolute bottom-3 left-3 z-10">
                    {item.label}
                  </figcaption>
                </figure>
              ))
            }
          </div>

          <div class="grid gap-4">
            <figure class="premium-media min-h-[220px]">
              <img
                src={heroMedia[2].src}
                alt={heroMedia[2].alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="premium-chip absolute bottom-3 left-3 z-10">
                {heroMedia[2].label}
              </figcaption>
            </figure>

            <ModernCard variant="glass" className="tone-panel-soft p-5">
              <p
                class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
              >
                At a glance
              </p>
              <div class="mt-4 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
                {
                  operatingHighlights.map(item => (
                    <div class="tone-panel-subtle tone-border rounded-2xl border p-4">
                      <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/45">
                        {item.label}
                      </p>
                      <p class="mt-2 text-2xl font-semibold tracking-tight text-white">
                        {item.value}
                      </p>
                      <p class="mt-2 text-xs leading-5 text-slate-300">
                        {item.note}
                      </p>
                    </div>
                  ))
                }
              </div>
            </ModernCard>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const heroSelector = '[data-olive-universe]';
      const canvasSelector = '[data-hero-canvas="true"]';

      const paintHeroCanvases = () => {
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        document.querySelectorAll(heroSelector).forEach(hero => {
          hero.setAttribute(
            'data-olive-mode',
            reducedMotion ? 'ambient' : 'interactive'
          );
        });

        document.querySelectorAll(canvasSelector).forEach(node => {
          if (!(node instanceof HTMLCanvasElement)) return;
          const context = node.getContext('2d');
          if (!context) return;

          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(node.clientWidth, 320);
          const height = Math.max(node.clientHeight, 520);
          node.width = Math.floor(width * ratio);
          node.height = Math.floor(height * ratio);
          context.setTransform(ratio, 0, 0, ratio, 0, 0);

          const base = context.createLinearGradient(0, 0, width, height);
          base.addColorStop(0, '#09111c');
          base.addColorStop(0.52, '#0d1727');
          base.addColorStop(1, '#08111d');
          context.fillStyle = base;
          context.fillRect(0, 0, width, height);

          const glowLeft = context.createRadialGradient(
            width * 0.18,
            height * 0.14,
            0,
            width * 0.18,
            height * 0.14,
            width * 0.34
          );
          glowLeft.addColorStop(0, 'rgba(191, 219, 254, 0.42)');
          glowLeft.addColorStop(1, 'rgba(191, 219, 254, 0)');
          context.fillStyle = glowLeft;
          context.fillRect(0, 0, width, height);

          const glowRight = context.createRadialGradient(
            width * 0.84,
            height * 0.1,
            0,
            width * 0.84,
            height * 0.1,
            width * 0.28
          );
          glowRight.addColorStop(0, 'rgba(125, 211, 252, 0.24)');
          glowRight.addColorStop(1, 'rgba(125, 211, 252, 0)');
          context.fillStyle = glowRight;
          context.fillRect(0, 0, width, height);

          context.strokeStyle = 'rgba(255, 255, 255, 0.08)';
          context.lineWidth = 1;
          const gridSize = Math.max(Math.round(width / 18), 44);

          for (let x = 0; x <= width; x += gridSize) {
            context.beginPath();
            context.moveTo(x, 0);
            context.lineTo(x, height);
            context.stroke();
          }

          for (let y = 0; y <= height; y += gridSize) {
            context.beginPath();
            context.moveTo(0, y);
            context.lineTo(width, y);
            context.stroke();
          }

          context.strokeStyle = 'rgba(147, 197, 253, 0.4)';
          context.lineWidth = 2;
          context.beginPath();
          context.moveTo(width * 0.08, height * 0.72);
          context.bezierCurveTo(
            width * 0.24,
            height * 0.58,
            width * 0.42,
            height * 0.82,
            width * 0.58,
            height * 0.6
          );
          context.bezierCurveTo(
            width * 0.68,
            height * 0.46,
            width * 0.8,
            height * 0.64,
            width * 0.92,
            height * 0.42
          );
          context.stroke();

          context.fillStyle = 'rgba(255, 255, 255, 0.65)';
          [
            [0.18, 0.32],
            [0.38, 0.54],
            [0.61, 0.38],
            [0.81, 0.22],
          ].forEach(([x, y]) => {
            context.beginPath();
            context.arc(width * x, height * y, 5, 0, Math.PI * 2);
            context.fill();
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', paintHeroCanvases, {
          once: true,
        });
      } else {
        paintHeroCanvases();
      }

      window.addEventListener('resize', paintHeroCanvases);
      document.addEventListener('astro:page-load', paintHeroCanvases);
    })();
  </script>

  <section
    class="premium-section"
    id="front-door-proof"
    data-page-section
    data-reveal
  >
    <div class="premium-container py-10 sm:py-12">
      <div class="grid gap-4 md:grid-cols-3">
        {
          frontDoorPaths.map(item => (
            <ModernCard variant="glass" className="h-full p-5 tone-panel-soft">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                Start path
              </p>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-[1.65rem]">
                {item.title}
              </h2>
              <p class="mb-0 mt-3 text-sm leading-6 text-slate-300">
                {item.copy}
              </p>
              <a
                class="tone-accent-link mt-5 inline-flex text-sm hover:underline"
                href={item.href}
              >
                {item.cta}
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="signal-cabinet"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <SignalCabinet
        eyebrow="Operating signals"
        title="Start with the pressure, not a giant service list."
        description="Use these four signals to find the right starting lane fast—then go deeper only where it matters."
        accent="#93c5fd"
        items={landingSignalItems}
      />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="focus"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Where the platform is strongest
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Where this firm creates value fastest.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          The homepage stays focused on the highest-value problems instead of
          shouting every capability at once.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          platformFocus.map(item => (
            <ModernCard
              variant="default"
              className="h-full p-7 tone-panel-soft"
            >
              <h3 class="text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="directory"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-3xl space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Solution lanes
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Four lanes that explain the business in one screen.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            You should know what kind of partner Olive is within seconds—not
            after digging through dozens of pages.
          </p>
        </div>

        <ModernButton
          href={withBasePath('services/')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          Open solution hub
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          solutionCards.map(card => (
            <a
              href={card.href}
              class="premium-card premium-card--interactive group block p-6"
              style="--trade-accent:var(--color-primary);"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div
                    class="inline-flex h-11 w-11 items-center justify-center rounded-lg border text-sm font-semibold uppercase tracking-[0.18em] text-white"
                    style="border-color:color-mix(in srgb, var(--trade-accent) 40%, rgba(255,255,255,0.12)); background:color-mix(in srgb, var(--trade-accent) 16%, transparent);"
                  >
                    {card.badge}
                  </div>
                  <p class="mt-4 text-xs uppercase tracking-[0.22em] text-white/45">
                    {card.eyebrow}
                  </p>
                </div>

                <span class="tone-chip-neutral inline-flex rounded-full border px-3 py-1 text-[0.65rem] uppercase tracking-[0.22em]">
                  {card.badge}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-semibold text-white">
                {card.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {card.summary}
              </p>

              <dl class="tone-divider-top mt-6 space-y-4 pt-5 text-sm">
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Operating model
                  </dt>
                  <dd class="mt-1 text-slate-100">{card.operatingModel}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Best rhythm
                  </dt>
                  <dd class="mt-1 text-slate-300">{card.rhythm}</dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="delivery"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Delivery model
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          The process is simple on purpose.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Great design matters, but the real differentiator is how clearly the
          work moves from first pressure point to visible proof.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          deliveryStages.map(stage => (
            <ModernCard
              variant="outline"
              className="h-full p-6 tone-panel-soft"
            >
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/45">
                {stage.step}
              </p>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {stage.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{stage.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="readiness"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="programs"
    data-page-section
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          What stays connected
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          The best engagements connect operations, trust, and presentation.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Even when the starting point is support or security, the strongest
          outcomes often include modernization, automation, and better client
          experience.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          proofPrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7 tone-panel-soft">
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>

              <div class="tone-divider-top mt-6 pt-5">
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                  Typical outputs
                </p>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                  {program.outputs.map(output => (
                    <li class="flex items-start gap-2">
                      <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                      <span>{output}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative" id="contact" data-page-section data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="tone-panel-soft p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div class="space-y-4">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Get started
            </p>
            <h2
              class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Need the right starting lane and a cleaner next step?
            </h2>
            <p class="max-w-2xl text-base leading-7 text-slate-300">
              Explore the solution hub, review pricing, or send a short brief
              with the pressure point you need solved first.
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
          >
            <ModernButton
              href={withBasePath('services/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Explore solutions
            </ModernButton>
            <ModernButton
              href={withBasePath('about/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open proof lab
            </ModernButton>
            <ModernButton
              href={contactHref}
              variant="outline"
              className="min-h-[50px]"
            >
              Email a strategy brief
            </ModernButton>
          </div>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
