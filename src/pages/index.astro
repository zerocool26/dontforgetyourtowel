---
import { Image } from 'astro:assets';

import heroImage from '../assets/chicago-editorial-hero-v3.png';
import motionImage from '../assets/chicago-editorial-motion-v3.png';
import riverImage from '../assets/chicago-editorial-river-v3.png';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { processSteps, proofRows, services } from '../data/site';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Technology Consulting & Software Engineering"
  description="Technology strategy, custom software, cloud, cybersecurity, and managed IT from one accountable Chicago team."
  bodyClass="editorial-site"
  mainClass="editorial-home"
>
  <section class="editorial-hero">
    <div class="shell editorial-hero__inner">
      <div class="editorial-hero__copy">
        <h1>
          <span>Build it</span>
          <span>like you’ll</span>
          <span>have to <em>run it.</em></span>
        </h1>
        <p>
          Strategy, software, cloud, security, and managed IT—designed by one
          accountable Chicago team that stays with the consequences.
        </p>
        <div class="button-row">
          <a class="button" href={withBasePath('contact-hq/')}>Put us to work</a
          >
          <a class="button button--outline" href="#what-we-deliver">
            See what we deliver
          </a>
        </div>
      </div>
      <figure class="editorial-hero__media">
        <Image
          src={heroImage}
          alt="Marina City and modern Chicago towers rising behind a steel bridge"
          widths={[720, 960, 1280, 1536]}
          sizes="(min-width: 900px) 62vw, 100vw"
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <span class="editorial-thread" aria-hidden="true"></span>
    </div>
  </section>

  <section class="editorial-principle" aria-labelledby="principle-heading">
    <div class="shell editorial-principle__inner">
      <h2 id="principle-heading">
        <span>A plan is only</span>
        <span>as good as</span>
        <em>Monday morning.</em>
      </h2>
      <ol>
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <strong>{step.title}</strong>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="editorial-handoff" id="what-we-deliver">
    <div class="shell editorial-handoff__inner">
      <header>
        <h2>The handoff is where ownership disappears.</h2>
        <p>
          Consultants write the plan. Developers ship the build. IT inherits the
          mess. We keep one accountable operating model across all three.
        </p>
      </header>

      <figure class="editorial-handoff__media">
        <Image
          src={motionImage}
          alt="Chicago roadway and river infrastructure moving toward downtown"
          widths={[640, 800, 1024]}
          sizes="(min-width: 900px) 36vw, 100vw"
          format="webp"
          quality={88}
          loading="lazy"
        />
      </figure>

      <div class="editorial-services">
        {
          services.map(service => (
            <a href={withBasePath(`services/#${service.id}`)}>
              <span>{service.number}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
              </div>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M5 12h13M14 7l5 5-5 5" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="editorial-process" id="how-we-work">
    <div class="shell editorial-process__inner">
      <header>
        <h2>
          Plan it. Build it.<br />
          <em>Secure it.</em> Run it.
        </h2>
        <p>
          Start with the stage you need. Keep the operating responsibility
          connected through what comes next.
        </p>
      </header>
      <ol>
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="editorial-proof">
    <div class="shell editorial-proof__inner">
      <header>
        <h2>
          The operating<br />record is the <em>proof.</em>
        </h2>
        <p>
          The name says #1. The standard has to earn it—through decisions,
          delivery discipline, secure ownership, and a system that works after
          launch.
        </p>
        <a class="editorial-link" href={withBasePath('trust-center/')}>
          Review our operating standard
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M5 12h13M14 7l5 5-5 5"></path>
          </svg>
        </a>
      </header>

      <div class="editorial-proof__rows">
        {
          proofRows.map(row => (
            <article>
              <span>{row.number}</span>
              <h3>{row.title}</h3>
              <p>{row.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="editorial-cta">
    <div class="editorial-cta__media">
      <Image
        src={riverImage}
        alt="Chicago skyline reflected across the river under a bright sky"
        widths={[720, 960, 1280]}
        sizes="(min-width: 900px) 52vw, 100vw"
        format="webp"
        quality={88}
        loading="lazy"
      />
    </div>
    <div class="shell editorial-cta__inner">
      <div class="editorial-cta__copy">
        <h2>Put one team on the whole <em>problem.</em></h2>
        <p>
          Bring us the decision, build, security issue, or operating gap. We
          will identify the right first move and the ownership it needs after
          that.
        </p>
        <div class="button-row">
          <a class="button" href={withBasePath('contact-hq/')}>Put us to work</a
          >
          <a class="button button--outline" href={withBasePath('services/')}>
            See what we deliver
          </a>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
