    href: withBasePath('services/'),
    cta: 'Explore solutions',
  },
  {
    title: 'Need pricing clarity?',
    copy: 'Use pricing to compare plan levels, budget drivers, and calculators before the conversation turns into a long email thread.',
    href: withBasePath('pricing/'),
    cta: 'Review pricing',
  },
  {
    title: 'Need proof the work can feel premium?',
