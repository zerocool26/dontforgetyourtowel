---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BuyerSituationRouter from '../components/business/BuyerSituationRouter.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import OperatingProofBoard from '../components/business/OperatingProofBoard.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ProviderSelectionStandard from '../components/business/ProviderSelectionStandard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { buyerSituations } from '../data/buyer-situations';
import { withBasePath } from '../utils/helpers';

const contactHref = withBasePath('contact-hq/');
const pricingHref = withBasePath('pricing/');
const servicesHref = withBasePath('services/');
const trustHref = withBasePath('trust-center/');
const heroMediaDesktop = withBasePath('media/chicago-ops-command.webp');
const heroMediaMobile = withBasePath('media/chicago-ops-command-mobile.webp');

const heroStats = [
  {
    value: '25-150',
    label: 'user teams',
    detail: 'Best fit for owner-led and operations-heavy Chicago-area firms.',
  },
  {
    value: '4 lanes',
    label: 'one owner',
    detail: 'Support, security, Microsoft 365, and recovery handled together.',
  },
  {
    value: '30/60/90',
    label: 'first plan',
    detail: 'A plain-language plan after the first environment review.',
  },
];

const serviceLanes = [
  {
    label: 'Support',
    title: 'Managed IT support',
    copy: 'Help desk, onboarding, device standards, patching, and vendor follow-through.',
    href: servicesHref,
  },
  {
    label: 'Security',
    title: 'Cybersecurity baseline',
    copy: 'MFA, endpoint protection, email defense, admin access, awareness, and response contacts.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Microsoft 365',
    title: 'Microsoft 365 operations',
    copy: 'Exchange, Teams, SharePoint, OneDrive, licensing, access rules, cleanup, and governance.',
    href: withBasePath('services/#technology-catalog'),
  },
  {
    label: 'Continuity',
    title: 'Backup, network, and recovery',
    copy: 'Backup monitoring, restore checks, firewall, Wi-Fi, ISP coordination, and recovery order.',
    href: withBasePath('services/#technology-catalog'),
  },
];

const firstThirtyDays = [
  'Document users, devices, Microsoft 365, backups, vendors, network gear, admin roles, and recurring issues.',
  'Stabilize the support, access, email, and recovery gaps that create the most daily disruption.',
  'Deliver a 30/60/90 plan with owners, budget notes, and the decisions leadership needs to make next.',
];

const firstReplySignals = [
  'Main issue named',
  'Likely first owner',
  'Proof to bring',
  'Next step and scope risk',
];
---

<MarketingLayout
  title="CHICAGOS #1 MSP | Managed IT, Security, Microsoft 365, and Backup"
  description="Chicago-area managed IT, cybersecurity, Microsoft 365, backup, networking, and support ownership for firms that need calmer operations."
  mainClass="relative overflow-x-clip"
  bodyClass="home-reboot"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section class="home-reboot-hero" id="landing-hero" data-page-section>
    <picture class="home-reboot-hero__media">
      <source media="(max-width: 767px)" srcset={heroMediaMobile} />
      <img
        src={heroMediaDesktop}
        alt="Chicago skyline behind a managed IT operations desk at dusk"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="home-reboot-hero__shade" aria-hidden="true"></div>

    <div class="home-reboot-shell home-reboot-hero__grid">
      <div class="home-reboot-hero__content">
        <p class="home-reboot-kicker">
          Managed IT for Chicago teams that need the work owned
        </p>
        <h1 class="home-reboot-title">
          When IT feels ownerless, the business slows down.
        </h1>
        <p class="home-reboot-copy home-reboot-copy--large">
          Chicago-area support, cybersecurity, Microsoft 365, backup, network,
          and vendor work organized around visible owners, evidence, and the
          next decision.
        </p>

        <div class="home-reboot-actions" aria-label="Primary actions">
          <ModernButton
            href={contactHref}
            variant="gradient"
            rounded="sm"
            className="home-reboot-primary-action"
          >
            Start fit check
          </ModernButton>
          <ModernButton
            href={pricingHref}
            variant="outline"
            rounded="sm"
            className="home-reboot-secondary-action"
          >
            See pricing
          </ModernButton>
          <a class="home-reboot-text-link" href={servicesHref}>View services</a>
        </div>

        <div class="home-reboot-stat-grid" aria-label="Buyer fit signals">
          {
            heroStats.map(stat => (
              <article class="home-reboot-stat">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
                <p>{stat.detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <aside
        class="home-reboot-hero__brief"
        aria-label="What a useful first reply should include"
      >
        <p class="home-reboot-kicker">First reply standard</p>
        <h2>Not a sales pitch. A working diagnosis.</h2>
        <ul>
          {
            firstReplySignals.map(signal => (
              <li>
                <span aria-hidden="true" />
                {signal}
              </li>
            ))
          }
        </ul>
        <a href="#situation-router">Route the issue</a>
      </aside>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--board"
    id="operating-proof-board"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-board-section">
      <div class="home-reboot-section-heading">
        <p class="home-reboot-kicker">Operating proof board</p>
        <h2 class="home-reboot-section-title">
          Five states a first review should make visible.
        </h2>
        <p class="home-reboot-copy">
          Response ownership, access risk, recovery confidence, Microsoft 365
          cleanup, and scope boundaries should be visible early enough to shape
          the first decision.
        </p>
      </div>

      <OperatingProofBoard />
    </div>
  </section>

  <ProofOperatingSystem
    eyebrow="What leadership should see"
    title="Support should leave a record, not another vague ticket thread."
    description="The first review should make the basics visible: open issues, vendor ownership, backup confidence, access risk, Microsoft 365 cleanup, and the budget decisions ahead."
    ctaHref={contactHref}
    ctaLabel="Send the main issue"
  />

  <ProviderSelectionStandard
    compact
    eyebrow="Why this should feel different"
    title="A good MSP makes the first questions easier to answer."
    description="The advantage is not a longer service list. It is whether ownership, recovery, access, Microsoft 365, recurring issues, and scope boundaries become visible fast."
    ctaHref={trustHref}
    ctaLabel="Review proof"
  />

  <section
    class="home-reboot-section home-reboot-section--router"
    id="situation-router"
    data-page-section
  >
    <div class="home-reboot-shell">
      <BuyerSituationRouter
        client:only="preact"
        situations={buyerSituations}
        contactHref={contactHref}
        pricingHref={pricingHref}
        trustHref={trustHref}
        defaultSituationId="provider-stall"
        eyebrow="Fit router"
        title="Pick the pressure point. Get the right first move."
        description="A serious MSP conversation should start with what is happening in the business, not a menu of tools. Choose the closest situation and send a cleaner first brief."
      />
    </div>
  </section>

  <section class="home-reboot-section" id="services" data-page-section>
    <div class="home-reboot-shell">
      <div
        class="home-reboot-section-heading home-reboot-section-heading--wide"
      >
        <p class="home-reboot-kicker">Services</p>
        <h2 class="home-reboot-section-title">
          Four service lanes that cover the daily IT mess.
        </h2>
        <p class="home-reboot-copy">
          Start with the problem in front of you, then route it to the right
          support, security, Microsoft 365, or recovery owner.
        </p>
      </div>

      <div class="home-reboot-lanes">
        {
          serviceLanes.map((lane, index) => (
            <a class="home-homepage-lane home-reboot-lane" href={lane.href}>
              <span class="home-reboot-lane__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="home-homepage-lane__label home-reboot-lane__label">
                {lane.label}
              </span>
              <h3>{lane.title}</h3>
              <p>{lane.copy}</p>
              <strong>Open scope</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--handoff"
    id="decision-handoff"
    data-page-section
  >
    <div class="home-reboot-shell">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Decision handoff"
        title="A useful first conversation should leave you with a next step."
        description="Bring the rough counts, the current provider problem, and the urgent risk. The first reply should point to the right owner, missing details, and next action."
      />
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--operating"
    id="operating-standard"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-operating">
      <div class="home-reboot-section-heading">
        <p class="home-reboot-kicker">First phase</p>
        <h2 class="home-reboot-section-title">
          The first phase should reduce the noise.
        </h2>
        <p class="home-reboot-copy">
          Before buying more tools, the environment needs a baseline, clear
          owners, and a practical plan leadership can understand.
        </p>
      </div>

      <div class="home-homepage-first30 home-reboot-first30">
        <ol>
          {firstThirtyDays.map(item => <li>{item}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section
    class="home-reboot-section home-reboot-section--final"
    data-page-section
  >
    <div class="home-reboot-shell home-reboot-final">
      <div>
        <p class="home-reboot-kicker">Ready when you are</p>
        <h2 class="home-reboot-section-title">
          Send the main issue. Get a clearer next step.
        </h2>
      </div>
      <div class="home-reboot-actions home-reboot-actions--final">
        <ModernButton href={contactHref} variant="gradient" rounded="sm">
          Start fit check
        </ModernButton>
        <ModernButton href={servicesHref} variant="outline" rounded="sm">
          View services
        </ModernButton>
      </div>
    </div>
  </section>

  <style>
    :global(.home-reboot) {
      background: linear-gradient(
        180deg,
        #111816 0%,
        #101416 36%,
        #090b0d 100%
      );
      color: #f8f2e7;
    }

    :global(.home-reboot .tone-site-shell),
    :global(.home-reboot .tone-main-shell) {
      background: transparent;
    }

    .home-reboot-shell {
      width: min(100% - 2rem, 1180px);
      margin-inline: auto;
    }

    .home-reboot-hero {
      position: relative;
      min-height: min(47rem, calc(100svh - 1rem));
      display: grid;
      align-items: center;
      overflow: hidden;
      padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(2.5rem, 5vw, 4rem);
      background: #070809;
      color: #f8f2e7;
      isolation: isolate;
    }

    .home-reboot-hero__media,
    .home-reboot-hero__media img,
    .home-reboot-hero__shade {
      position: absolute;
      inset: 0;
    }

    .home-reboot-hero__media {
      z-index: -1;
      overflow: hidden;
    }

    .home-reboot-hero__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 62% center;
      filter: saturate(0.9) contrast(1.04);
      transform: scale(1.015);
    }

    .home-reboot-hero__shade {
      z-index: 0;
      background:
        linear-gradient(
          90deg,
          rgba(7, 8, 9, 0.98) 0%,
          rgba(7, 8, 9, 0.88) 30%,
          rgba(7, 8, 9, 0.44) 58%,
          rgba(7, 8, 9, 0.56) 100%
        ),
        linear-gradient(
          180deg,
          rgba(7, 8, 9, 0.36) 0%,
          rgba(7, 8, 9, 0.16) 46%,
          rgba(7, 8, 9, 0.92) 100%
        );
      pointer-events: none;
    }

    .home-reboot-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        linear-gradient(rgba(248, 242, 231, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(248, 242, 231, 0.026) 1px, transparent 1px);
      background-size: 62px 62px;
      mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.54), transparent 72%);
    }

    .home-reboot-hero__grid {
      position: relative;
      z-index: 2;
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .home-reboot-hero__content {
      display: grid;
      gap: 1.15rem;
      max-width: 47rem;
    }

    .home-reboot-kicker {
      margin: 0;
      color: rgba(248, 242, 231, 0.58);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      line-height: 1.45;
      text-transform: uppercase;
    }

    .home-reboot-title,
    .home-reboot-section-title {
      margin: 0;
      color: inherit;
      font-family: var(--font-display);
      font-weight: 760;
      letter-spacing: 0;
      text-wrap: balance;
    }

    .home-reboot-title {
      max-width: 13ch;
      font-size: clamp(3rem, 4.8vw, 4.7rem);
      line-height: 0.98;
    }

    .home-reboot-section-title {
      font-size: clamp(2rem, 4vw, 4.25rem);
      line-height: 0.98;
    }

    .home-reboot-copy {
      max-width: 64ch;
      margin: 0;
      color: rgba(226, 232, 240, 0.76);
      font-size: 1rem;
      line-height: 1.65;
    }

    .home-reboot-copy--large {
      max-width: 43rem;
      color: rgba(248, 242, 231, 0.78);
      font-size: clamp(1.05rem, 1.7vw, 1.28rem);
      line-height: 1.62;
    }

    .home-reboot-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      align-items: center;
      margin-top: 0.3rem;
    }

    .home-reboot-primary-action,
    .home-reboot-secondary-action {
      min-height: 52px;
    }

    .home-reboot-text-link {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid rgba(15, 118, 110, 0.42);
      color: #9ce6d9;
      font-weight: 750;
    }

    .home-reboot-text-link:hover {
      color: #f8f2e7;
    }

    .home-reboot-text-link--standalone {
      margin-top: 0.65rem;
      color: #9ce6d9;
      justify-self: start;
    }

    .home-reboot-stat-grid {
      display: grid;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    .home-reboot-stat {
      border: 1px solid rgba(248, 242, 231, 0.13);
      border-radius: 8px;
      background: rgba(248, 242, 231, 0.055);
      padding: 1rem;
    }

    .home-reboot-stat strong,
    .home-reboot-stat span {
      display: block;
    }

    .home-reboot-stat strong {
      color: #f8f2e7;
      font-size: 1.4rem;
      line-height: 1;
    }

    .home-reboot-stat span {
      margin-top: 0.3rem;
      color: #9ce6d9;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-stat p {
      margin: 0.55rem 0 0;
      color: rgba(248, 242, 231, 0.66);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .home-reboot-hero__brief {
      display: grid;
      gap: 1rem;
      align-self: end;
      max-width: 26rem;
      margin-left: auto;
      border: 1px solid rgba(248, 242, 231, 0.16);
      border-radius: 10px;
      background:
        linear-gradient(145deg, rgba(156, 230, 217, 0.14), transparent 36%),
        rgba(7, 10, 12, 0.68);
      box-shadow: 0 32px 90px -54px rgba(0, 0, 0, 0.92);
      padding: clamp(1rem, 2.4vw, 1.35rem);
      backdrop-filter: blur(16px) saturate(1.1);
    }

    .home-reboot-hero__brief h2 {
      max-width: 13ch;
      margin: 0;
      color: #f8f2e7;
      font-family: var(--font-display);
      font-size: clamp(1.65rem, 2.6vw, 2.35rem);
      font-weight: 780;
      letter-spacing: 0;
      line-height: 1;
      text-wrap: balance;
    }

    .home-reboot-hero__brief ul {
      display: grid;
      gap: 0.6rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .home-reboot-hero__brief li {
      display: flex;
      gap: 0.65rem;
      align-items: center;
      color: rgba(248, 242, 231, 0.82);
      font-size: 0.95rem;
      line-height: 1.35;
    }

    .home-reboot-hero__brief li span {
      width: 0.5rem;
      height: 0.5rem;
      flex: 0 0 auto;
      border-radius: 999px;
      background: #f2c76f;
      box-shadow: 0 0 0 5px rgba(242, 199, 111, 0.12);
    }

    .home-reboot-hero__brief a {
      display: inline-flex;
      width: fit-content;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(156, 230, 217, 0.38);
      border-radius: 8px;
      background: rgba(156, 230, 217, 0.12);
      color: #9ce6d9;
      padding: 0 0.9rem;
      font-weight: 780;
      text-decoration: none;
    }

    .home-reboot-section {
      position: relative;
      padding: clamp(4rem, 7vw, 6.5rem) 0;
      border-top: 1px solid rgba(248, 242, 231, 0.08);
      background: #090b0d;
      color: #f8f2e7;
    }

    .home-reboot-section:nth-of-type(odd) {
      background: #0f1416;
    }

    .home-reboot-section .home-reboot-kicker {
      color: rgba(248, 242, 231, 0.48);
    }

    .home-reboot-split,
    .home-reboot-proof-grid,
    .home-reboot-board-section,
    .home-reboot-operating,
    .home-reboot-final {
      display: grid;
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .home-reboot-section-heading {
      display: grid;
      gap: 1rem;
      max-width: 44rem;
    }

    .home-reboot-section-heading--wide {
      max-width: 58rem;
    }

    .home-reboot-reasons {
      display: grid;
      gap: 0.75rem;
    }

    .home-reboot-reason,
    .home-reboot-lane,
    .home-reboot-proof-item,
    .home-reboot-first30 {
      border: 1px solid rgba(248, 242, 231, 0.11);
      border-radius: 8px;
      background:
        linear-gradient(180deg, rgba(248, 242, 231, 0.045), transparent 48%),
        rgba(248, 242, 231, 0.025);
    }

    .home-reboot-reason {
      padding: 1.15rem;
    }

    .home-reboot-reason p {
      margin: 0;
      color: #f2c76f;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-reason h3 {
      margin: 0.55rem 0 0;
      color: #f8f2e7;
      font-size: clamp(1.25rem, 2vw, 1.65rem);
      line-height: 1.12;
    }

    .home-reboot-lanes,
    .home-reboot-proof-list {
      display: grid;
      gap: 0.85rem;
      margin-top: 1.5rem;
    }

    .home-reboot-lane {
      display: grid;
      gap: 0.72rem;
      min-height: 100%;
      padding: 1.15rem;
      color: inherit;
      transition:
        border-color 0.18s ease,
        transform 0.18s ease,
        background 0.18s ease;
    }

    .home-reboot-lane:hover {
      transform: translateY(-2px);
      border-color: rgba(156, 230, 217, 0.35);
      background:
        linear-gradient(180deg, rgba(156, 230, 217, 0.075), transparent 54%),
        rgba(248, 242, 231, 0.035);
    }

    .home-reboot-lane__number,
    .home-reboot-lane__label,
    .home-reboot-lane strong {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-reboot-lane__number {
      color: #f2c76f;
    }

    .home-reboot-lane__label {
      color: #9ce6d9;
    }

    .home-reboot-lane h3 {
      margin: 0;
      color: #f8f2e7;
      font-size: 1.35rem;
      line-height: 1.14;
    }

    .home-reboot-lane p,
    .home-reboot-proof-item p {
      margin: 0;
      color: rgba(226, 232, 240, 0.74);
      font-size: 0.95rem;
      line-height: 1.56;
    }

    .home-reboot-lane strong {
      margin-top: auto;
      color: rgba(248, 242, 231, 0.82);
    }

    .home-reboot-section--proof {
      background:
        linear-gradient(110deg, rgba(15, 118, 110, 0.18), transparent 36%),
        #101416;
    }

    .home-reboot-proof-list {
      margin-top: 0;
    }

    .home-reboot-proof-item {
      padding: 1.15rem;
    }

    .home-reboot-proof-item h3 {
      margin: 0 0 0.55rem;
      color: #f8f2e7;
      font-size: 1.12rem;
      line-height: 1.2;
    }

    .home-reboot-section--handoff {
      background: #080a0c;
    }

    .home-reboot-section--board {
      background:
        linear-gradient(110deg, rgba(156, 230, 217, 0.09), transparent 42%),
        #0c1113;
    }

    .home-reboot-section--operating {
      background: #f6f0e6;
      color: #111827;
    }

    .home-reboot-section--operating .home-reboot-kicker {
      color: rgba(15, 23, 42, 0.58);
    }

    .home-reboot-section--operating .home-reboot-copy {
      color: rgba(15, 23, 42, 0.72);
    }

    .home-reboot-first30 {
      background: rgba(255, 255, 255, 0.62);
      border-color: rgba(15, 23, 42, 0.14);
      padding: clamp(1rem, 3vw, 1.4rem);
    }

    .home-reboot-first30 ol {
      display: grid;
      gap: 0.85rem;
      margin: 0;
      padding: 0;
      counter-reset: first30;
      list-style: none;
    }

    .home-reboot-first30 li {
      position: relative;
      min-height: 2.2rem;
      padding-left: 3rem;
      color: rgba(15, 23, 42, 0.76);
      line-height: 1.58;
      counter-increment: first30;
    }

    .home-reboot-first30 li::before {
      content: counter(first30, decimal-leading-zero);
      position: absolute;
      left: 0;
      top: 0.1rem;
      display: inline-flex;
