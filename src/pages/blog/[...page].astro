---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ResourceDecisionTools from '../../components/business/ResourceDecisionTools.astro';
import RouteProofStrip from '../../components/business/RouteProofStrip.astro';
import ModernButton from '../../components/ui/ModernButton.astro';
import {
  getResourceLibraryRecord,
  resourceLibraryLanes,
  resourceLibraryProof,
} from '../../data/resource-library';
import { withBasePath } from '../../utils/helpers';

export const prerender = true;

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    entry => !entry.data.draft
  );

  return [
    {
      params: { page: undefined },
      props: {
        posts: posts.sort(
          (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        ),
      },
    },
  ];
}

const { posts } = Astro.props as { posts: BlogPost[] };

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

const getReadingMinutes = (post: BlogPost) => {
  const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
  return Math.max(2, Math.round(wordCount / 180));
};

const resourceRows = posts.map(post => ({
  post,
  record: getResourceLibraryRecord(post.id),
  dateLabel: formatDate(post.data.pubDate),
  readingMinutes: getReadingMinutes(post),
}));

const featuredResource = resourceRows[0];
const supportingRows = resourceRows.slice(1, 3);

const laneCards = resourceLibraryLanes.map(lane => ({
  ...lane,
  count: resourceRows.filter(row => row.record.lane === lane.filter).length,
}));

const tagLeaderboard = Array.from(
  posts
    .flatMap(post => post.data.tags)
    .reduce((map, tag) => {
      map.set(tag, (map.get(tag) ?? 0) + 1);
      return map;
    }, new Map<string, number>())
    .entries()
)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([label]) => label);

const laneFilters = resourceLibraryLanes.map(lane => lane.filter);
const filterTags = [
  'All',
  ...laneFilters,
  ...tagLeaderboard.filter(tag => !laneFilters.includes(tag)),
];

const heroImage = {
  desktop: withBasePath('media/chicago-ops-command.webp'),
  mobile: withBasePath('media/chicago-ops-command-mobile.webp'),
};
---

<MarketingLayout
  title="Resources | CHICAGOS #1 MSP"
  description="Practical resource library for managed IT, cybersecurity, Microsoft 365 cleanup, backup confidence, provider transitions, and workflow decisions for Chicago-area teams."
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'CHICAGOS #1 MSP Resource Library',
      description:
        'Decision-focused resources about managed IT, security, Microsoft 365, backup confidence, provider transitions, and workflow support.',
      hasPart: posts.map(post => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: withBasePath(`blog/${post.id}/`),
      })),
    }}
  />

  <section class="blog-page-hero" data-page-section>
    <div class="premium-container">
      <div class="blog-page-hero__grid">
        <div class="tone-page-header blog-page-hero__copy">
          <p class="tone-page-eyebrow">Resource library</p>
          <h1 class="tone-page-title">
            Resources that make the next IT decision clearer.
          </h1>
          <p class="tone-page-copy">
            Start with the pressure in front of you: provider transition,
            security baseline, Microsoft 365 cleanup, backup confidence, or a
            workflow handoff that needs better ownership.
          </p>

          <div class="blog-hero-proof" aria-label="Resource library summary">
            <span>
              <strong>{posts.length}</strong>
              <small>field notes</small>
            </span>
            <span>
              <strong>{resourceLibraryLanes.length}</strong>
              <small>decision lanes</small>
            </span>
            <span>
              <strong>RSS</strong>
              <small>feed ready</small>
            </span>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href="#blog-library"
              variant="gradient"
              className="min-h-[52px]"
            >
              Browse decision library
            </ModernButton>
            <ModernButton
              href={withBasePath('news/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Open news + podcast
            </ModernButton>
          </div>
        </div>

        <div class="blog-command-visual" aria-label="Featured resource">
          <picture>
            <source media="(max-width: 720px)" srcset={heroImage.mobile} />
            <img
              src={heroImage.desktop}
              alt="Chicago office technology command desk used as a visual frame for resource planning."
              loading="eager"
              decoding="async"
            />
          </picture>

          {
            featuredResource ? (
              <a
                class="blog-feature-receipt tone-focus-accent"
                href={withBasePath(`blog/${featuredResource.post.id}/`)}
              >
                <p class="blog-meta-kicker">Featured field note</p>
                <h2>{featuredResource.post.data.title}</h2>
                <p>{featuredResource.record.buyerQuestion}</p>
                <ul aria-label="What this article helps inspect">
                  {featuredResource.record.evidence.slice(0, 3).map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
                <div class="blog-feature-receipt__meta">
                  <span>{featuredResource.dateLabel}</span>
                  <span>{featuredResource.readingMinutes} min read</span>
                  <span>{featuredResource.record.stage}</span>
                </div>
              </a>
            ) : null
          }
        </div>
      </div>
    </div>
  </section>

  <RouteProofStrip
    label="Resource operating receipt"
    title="Read, inspect, act."
    note="Each resource should reduce ambiguity before a call, project, contract, or internal review."
    items={resourceLibraryProof}
    ctaHref={withBasePath('contact-hq/')}
    ctaLabel="Start fit check"
  />

  <section class="blog-page-section" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Decision lanes</p>
        <h2 class="tone-section-title">
          Pick the operating pressure before picking the article.
        </h2>
      </div>

      <div class="blog-lane-board" aria-label="Resource decision lanes">
        {
          laneCards.map(lane => (
            <a
              class="blog-lane-card tone-focus-accent"
              href={`${withBasePath('blog/')}?topic=${encodeURIComponent(lane.filter)}#blog-library`}
            >
              <span class="blog-lane-card__rail" aria-hidden="true" />
              <span class="blog-lane-card__top">
                <span>{lane.shortLabel}</span>
                <strong>
                  {lane.count} {lane.count === 1 ? 'note' : 'notes'}
                </strong>
              </span>
              <span class="blog-lane-card__body">
                <strong>{lane.label}</strong>
                <span>{lane.copy}</span>
              </span>
              <span class="blog-lane-card__proof">{lane.proof}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ResourceDecisionTools
    compact
    eyebrow="Resource tools"
    title="Start with a worksheet, then read deeper."
    description="The best resource path helps a buyer decide what to inspect next. Choose a pressure point to preview the evidence, owners, and output that should shape the conversation."
  />

  {
    supportingRows.length ? (
      <section class="blog-page-section" data-page-section>
        <div class="premium-container">
          <div class="tone-section-heading">
            <p class="tone-section-kicker">Start here</p>
            <h2 class="tone-section-title">
              Two notes that quickly clarify support, security, and cleanup
              work.
            </h2>
          </div>

          <div class="blog-support-grid">
            {supportingRows.map(row => (
              <a
                class="blog-support-card tone-focus-accent"
                href={withBasePath(`blog/${row.post.id}/`)}
              >
                <span class="blog-support-card__meta">
                  <span>{row.dateLabel}</span>
                  <span>{row.readingMinutes} min read</span>
                </span>
                <h3>{row.post.data.title}</h3>
                <p>{row.record.pressure}</p>
                <span class="blog-support-card__next">
                  {row.record.nextAction}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }

  <section class="blog-page-section" id="blog-library" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Article ledger</p>
        <h2 class="tone-section-title">
          Filter by topic and jump to the question in front of you.
        </h2>
      </div>

      <div class="blog-library-shell">
        <div
          class="blog-filter-bar"
          data-blog-filter-group
          role="toolbar"
          aria-label="Filter resources by topic"
        >
          {
            filterTags.map((tag, index) => (
              <button
                type="button"
                class:list={['blog-filter-button', index === 0 && 'is-active']}
                data-blog-filter={tag}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {tag}
              </button>
            ))
          }
        </div>

        <div class="blog-state-bar tone-panel-soft">
          <div>
            <p class="blog-meta-kicker">Current view</p>
            <p class="blog-state-bar__title" data-blog-active-state>
              All topics - {resourceRows.length} articles
            </p>
          </div>
          <button type="button" class="blog-state-button" data-blog-reset>
            Reset filter
          </button>
        </div>

        <div class="blog-ledger" data-blog-grid>
          {
            resourceRows.map(row => (
              <a
                class="blog-ledger-row tone-focus-accent"
                href={withBasePath(`blog/${row.post.id}/`)}
                data-blog-card
                data-blog-tags={[row.record.lane, ...row.post.data.tags].join(
                  '|'
                )}
              >
                <span
                  class="blog-ledger-row__status"
                  data-status={row.record.status}
                  aria-hidden="true"
                />
                <span class="blog-ledger-row__main">
                  <span class="blog-meta-kicker">{row.record.lane}</span>
                  <strong>{row.post.data.title}</strong>
                  <span>{row.record.buyerQuestion}</span>
                  <span class="blog-tags">
                    {row.post.data.tags.slice(0, 4).map(tag => (
                      <span>{tag}</span>
                    ))}
                  </span>
                </span>
                <span class="blog-ledger-row__proof">
                  <span>
                    {row.dateLabel} / {row.readingMinutes} min
                  </span>
                  <strong>{row.record.nextAction}</strong>
                  <small>{row.record.proofCue}</small>
                </span>
              </a>
            ))
          }
        </div>

        <p class="blog-empty-state tone-panel-soft" data-blog-empty hidden>
          No resources match this filter yet. Reset the view or start from a
          worksheet above.
        </p>
      </div>
    </div>
  </section>

  <section class="blog-page-section" data-page-section>
    <div class="premium-container">
      <div class="blog-editorial-cta tone-panel-soft">
        <div>
          <p class="blog-meta-kicker">Keep the editorial context going</p>
          <h2>
            Pair written guidance with live briefings, trust posture, and a
            clearer intake path.
          </h2>
          <p>
            The strongest resource systems do not stop at articles. They help a
            reader turn the idea into a worksheet, a proof request, or a scoped
            conversation.
          </p>
        </div>
        <div class="blog-editorial-cta__actions">
          <ModernButton
            href={withBasePath('rss.xml')}
            variant="outline"
            className="min-h-[48px]"
          >
            Subscribe by RSS
          </ModernButton>
          <ModernButton
            href={withBasePath('trust-center/')}
            variant="gradient"
            className="min-h-[48px]"
          >
            Review trust proof
          </ModernButton>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const FILTER_PARAM = 'topic';

    const initBlogFilters = () => {
      const root = document.querySelector('[data-blog-grid]');
      const state = document.querySelector('[data-blog-active-state]');
      const buttons = Array.from(
        document.querySelectorAll('[data-blog-filter]')
      );
      const cards = Array.from(document.querySelectorAll('[data-blog-card]'));
      const resetButton = document.querySelector('[data-blog-reset]');
      const emptyState = document.querySelector('[data-blog-empty]');

      if (!(root instanceof HTMLElement) || !(state instanceof HTMLElement)) {
        return;
      }

      if (root.dataset.blogBound === 'true') {
        return;
      }

      root.dataset.blogBound = 'true';

      const availableFilters = new Set(
        buttons
          .filter(button => button instanceof HTMLElement)
          .map(button => button.dataset.blogFilter || 'All')
      );

      const readFilter = () => {
        const params = new URLSearchParams(window.location.search);
        const requested = params.get(FILTER_PARAM) || 'All';
        return availableFilters.has(requested) ? requested : 'All';
      };

      let activeFilter = readFilter();

      const syncButtons = () => {
        buttons.forEach(button => {
          if (!(button instanceof HTMLButtonElement)) return;
          const isActive =
            (button.dataset.blogFilter ?? 'All') === activeFilter;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const syncUrl = () => {
        const nextUrl = new URL(window.location.href);
        if (activeFilter === 'All') {
          nextUrl.searchParams.delete(FILTER_PARAM);
        } else {
          nextUrl.searchParams.set(FILTER_PARAM, activeFilter);
        }
        window.history.replaceState({}, '', nextUrl.toString());
      };

      const render = () => {
        let visibleCount = 0;
        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;
          const tags = (card.dataset.blogTags || '').split('|').filter(Boolean);
          const isVisible =
            activeFilter === 'All' || tags.includes(activeFilter);
          card.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        state.textContent = `${activeFilter} - ${visibleCount} article${visibleCount === 1 ? '' : 's'}`;
        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount > 0;
        }
        syncButtons();
        syncUrl();
      };

      buttons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          activeFilter = button.dataset.blogFilter || 'All';
          render();
        });
      });

      if (resetButton instanceof HTMLButtonElement) {
        resetButton.addEventListener('click', () => {
          activeFilter = 'All';
          render();
        });
      }

      render();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogFilters, {
        once: true,
      });
    } else {
      initBlogFilters();
    }

    document.addEventListener('astro:page-load', initBlogFilters);
  })();
</script>

<style is:inline>
  .blog-page-hero,
  .blog-page-section {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .blog-page-hero {
    padding: clamp(5.8rem, 9vw, 7.8rem) 0 clamp(4.25rem, 7vw, 6.25rem);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 72%, transparent),
        transparent 58%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-primary) 7%, transparent),
        transparent 42%
      );
  }

  .blog-page-section {
    padding: clamp(4.25rem, 8vw, 6.75rem) 0;
  }

  .blog-page-hero__grid,
  .blog-lane-board,
  .blog-support-grid,
  .blog-ledger {
    display: grid;
    gap: 1rem;
  }

  .blog-page-hero__copy {
    align-content: center;
  }

  .blog-hero-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    max-width: 35rem;
  }

  .blog-hero-proof span,
  .blog-feature-receipt,
  .blog-lane-card,
  .blog-support-card,
  .blog-state-bar,
  .blog-ledger-row,
  .blog-empty-state,
  .blog-editorial-cta {
    border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
    border-radius: 8px;
  }

  .blog-hero-proof span {
    display: grid;
    gap: 0.25rem;
    min-height: 4.8rem;
    align-content: center;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .blog-hero-proof strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1;
  }

  .blog-hero-proof small,
  .blog-feature-receipt__meta,
  .blog-support-card__meta,
  .blog-ledger-row__proof > span,
  .blog-ledger-row__proof small,
  .blog-lane-card__top,
  .blog-lane-card__proof,
  .blog-meta-kicker,
  .blog-filter-button,
  .blog-state-button {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .blog-hero-proof small,
  .blog-feature-receipt__meta,
  .blog-support-card__meta,
  .blog-ledger-row__proof > span,
  .blog-ledger-row__proof small,
  .blog-lane-card__top,
  .blog-lane-card__proof,
  .blog-meta-kicker {
    color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
  }

  .blog-command-visual {
    position: relative;
    min-height: min(34rem, 72vw);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 74%, transparent);
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: 0 34px 80px -62px rgba(0, 0, 0, 0.72);
  }

  .blog-command-visual picture,
  .blog-command-visual img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-command-visual img {
    position: absolute;
    inset: 0;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
  }

  .blog-command-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.58) 74%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.58), rgba(0, 0, 0, 0.06) 58%);
    pointer-events: none;
  }

  .blog-feature-receipt {
    position: absolute;
    right: clamp(0.9rem, 3vw, 1.4rem);
    bottom: clamp(0.9rem, 3vw, 1.4rem);
    left: clamp(0.9rem, 3vw, 1.4rem);
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
    padding: clamp(1rem, 2.4vw, 1.35rem);
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 3.05rem,
        color-mix(in srgb, var(--color-ink) 8%, transparent) 3.05rem
          calc(3.05rem + 1px)
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, white 70%, var(--color-paper) 30%),
        var(--color-paper)
      );
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: 0 28px 70px -48px rgba(0, 0, 0, 0.88);
  }

  .blog-feature-receipt h2,
  .blog-support-card h3,
  .blog-editorial-cta h2 {
    margin: 0;
    color: inherit;
    font-family: var(--font-display);
    font-weight: 680;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .blog-feature-receipt h2 {
    font-size: clamp(1.28rem, 2.6vw, 2rem);
  }

  .blog-feature-receipt p,
  .blog-feature-receipt li {
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
    line-height: 1.52;
  }

  .blog-feature-receipt p,
  .blog-feature-receipt ul,
  .blog-support-card p,
  .blog-editorial-cta p,
  .blog-empty-state {
    margin: 0;
  }

  .blog-feature-receipt ul {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .blog-feature-receipt li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem;
  }

  .blog-feature-receipt li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    margin-top: 0.5rem;
    border: 1px solid var(--color-status-verified);
    background: color-mix(
      in srgb,
      var(--color-status-verified) 18%,
      transparent
    );
  }

  .blog-feature-receipt .blog-meta-kicker,
  .blog-feature-receipt__meta {
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
  }

  .blog-feature-receipt__meta,
  .blog-tags,
  .blog-editorial-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .blog-lane-board {
    margin-top: 1.5rem;
  }

  .blog-lane-card {
    position: relative;
    display: grid;
    gap: 0.95rem;
    min-height: 13.5rem;
    overflow: hidden;
    padding: 1.05rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 3%, transparent),
        transparent 50%
      ),
      color-mix(in srgb, var(--color-surface) 90%, transparent);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .blog-lane-card:hover,
  .blog-support-card:hover,
  .blog-ledger-row:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-primary) 34%, transparent);
  }

  .blog-lane-card__rail {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: color-mix(in srgb, var(--color-primary) 48%, transparent);
  }

  .blog-lane-card__top {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
  }

  .blog-lane-card__top strong {
    color: color-mix(in srgb, var(--color-primary) 76%, white 10%);
  }

  .blog-lane-card__body {
    display: grid;
    gap: 0.55rem;
  }

  .blog-lane-card__body strong {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 2vw, 1.45rem);
    line-height: 1.05;
  }

  .blog-lane-card__body span,
  .blog-lane-card__proof,
  .blog-support-card p,
  .blog-ledger-row__main > span:not(.blog-meta-kicker):not(.blog-tags),
  .blog-editorial-cta p,
  .blog-empty-state {
    color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
    line-height: 1.65;
  }

  .blog-lane-card__proof {
    align-self: end;
    padding-top: 0.85rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 74%, transparent);
    letter-spacing: 0.08em;
  }

  .blog-support-grid {
