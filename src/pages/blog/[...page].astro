---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';

import CtaBand from '../../components/CtaBand.astro';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { withBasePath } from '../../utils/helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(posts, { pageSize: 8 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props as Props;
const featured = page.data[0];
const remaining = page.data.slice(1);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<MarketingLayout
  title="Technology Strategy, Software & Operations Resources | CHICAGOS #1 MSP"
  description="Practical guidance on technology decisions, software delivery, cloud, cybersecurity, managed IT, recovery, and operating ownership."
>
  <section class="resource-hero">
    <div class="shell resource-hero__grid">
      <h1>Useful answers before the sales call.</h1>
      <p>
        Practical notes for evaluating technology decisions, software delivery,
        cloud, security, managed operations, recovery, and scope.
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="featured-resource">
        <div class="shell featured-resource__grid">
          <div>
            <span>{formatDate(featured.data.pubDate)}</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <a class="text-link" href={withBasePath(`blog/${featured.id}/`)}>
              Read the article <span aria-hidden="true">→</span>
            </a>
          </div>
          <aside>
            <span>Start here</span>
            <p>
              Use the article to sharpen the questions you bring into a
              consulting, software, provider, or internal planning conversation.
            </p>
          </aside>
        </div>
      </section>
    )
  }

  <section class="section resource-list-section">
    <div class="shell">
      <div class="section-heading">
        <h2>All resources.</h2>
      </div>
      <div class="resource-list">
        {
          remaining.map((post: typeof featured) => (
            <article>
              <span>{formatDate(post.data.pubDate)}</span>
              <div>
                <h3>
                  <a href={withBasePath(`blog/${post.id}/`)}>
                    {post.data.title}
                  </a>
                </h3>
                <p>{post.data.description}</p>
              </div>
              <a
                aria-label={`Read ${post.data.title}`}
                href={withBasePath(`blog/${post.id}/`)}
              >
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="Resource pages">
            {page.url.prev ? <a href={page.url.prev}>Previous</a> : <span />}
            <p>
              Page {page.currentPage} of {page.lastPage}
            </p>
            {page.url.next ? <a href={page.url.next}>Next</a> : <span />}
          </nav>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Need an answer tied to your environment?"
    copy="Bring the actual outcome, rough environment, and timing. We will help identify the next useful review."
    secondaryLabel="Explore services"
    secondaryHref="services/"
  />
</MarketingLayout>
