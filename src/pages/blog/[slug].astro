---
import { getCollection } from 'astro:content';
import LegacyRedirect from '../../components/LegacyRedirect.astro';

export const prerender = true;

export async function getStaticPaths() {
  // Keep legacy blog links resolvable and redirect each slug.
  const posts = (await getCollection('blog' as never)) as any[];
  const published = posts.filter(entry => !entry.data.draft);
  return published.map(entry => ({ params: { slug: entry.id } }));
}
---

<LegacyRedirect destination="services/#case-studies" />
