---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

import CtaBand from '../../components/CtaBand.astro';
import { editorialMedia, localServiceMedia } from '../../data/visuals';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { withBasePath } from '../../utils/helpers';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(post.data.pubDate);
const mediaKey =
  localServiceMedia[post.id.length % localServiceMedia.length] ?? 'loop';
const articleMedia = editorialMedia[mediaKey];
---

<MarketingLayout
  title={`${post.data.title} | CHICAGOS #1 MSP`}
  description={post.data.description}
  type="article"
>
  <article class="article-page">
    <header class="article-header">
      <div class="shell article-header__inner">
        <a href={withBasePath('blog/')}>Resources</a>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      </div>
    </header>
    <figure class="article-cover">
      <Image
        src={articleMedia.src}
        alt={articleMedia.alt}
        widths={[960, 1440, 1920, 2400]}
        width={2400}
        sizes="100vw"
        format="webp"
        quality={88}
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${articleMedia.position}`}
      />
      <figcaption class="shell">{articleMedia.caption}</figcaption>
    </figure>
    <div class="shell article-layout">
      <aside>
        <p>Practical guidance from CHICAGOS #1 MSP.</p>
        <a class="text-link" href={withBasePath('contact-hq/')}>
          Ask about your environment <span aria-hidden="true">→</span>
        </a>
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
  <CtaBand
    title="Turn the checklist into a"
    accent="next step."
    copy="Tell us what you found, what remains unclear, and who needs the answer. We will help route the next review."
    secondaryLabel="Back to resources"
    secondaryHref="blog/"
  />
</MarketingLayout>
