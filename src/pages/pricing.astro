---
/* eslint-disable astro/no-set-html-directive */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import PricingCalculator from '../components/business/PricingCalculator.tsx';
import ROICalculator from '../components/business/ROICalculator.tsx';
import FAQAccordion from '../components/ui/FAQAccordion.tsx';
import {
  pricingFaqs,
  pricingSignals,
  pricingTiers,
  slaComparisonRows,
} from '../data/pricing';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const requestQuoteHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Request pricing / quote')}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(withBasePath('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Pricing',
      item: new URL(withBasePath('pricing/'), Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.content,
    },
  })),
};

const pricingDrivers = [
  {
    title: 'User and device count',
    copy: 'Seats, endpoints, servers, and site complexity are still the most direct cost inputs for recurring managed services.',
  },
  {
    title: 'Coverage and response expectations',
    copy: 'Business-hours support, after-hours response, security triage, and escalation depth materially change the operating model.',
  },
  {
    title: 'Security and compliance depth',
    copy: 'Identity hardening, audit readiness, managed response, and evidence habits increase the amount of ongoing operational work.',
  },
  {
    title: 'Project and platform workstreams',
    copy: 'Cloud modernization, automation, application support, and engineering tracks sit on top of the monthly operating baseline when needed.',
  },
];
---

<MarketingLayout
  title="Pricing | Olive Global Systems"
  description="Clear managed-service pricing, SLA guidance, and planning tools for support, security, cloud, and operational technology delivery."
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Pricing',
      description:
        'Plan comparison, SLA guidance, pricing calculators, and ROI planning tools.',
    }}
  />
  <StructuredData
    type="breadcrumbs"
    data={{ items: breadcrumbSchema.itemListElement }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="border-b border-white/10" data-reveal>
    <div
      class="mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div class="space-y-6">
          <div class="space-y-3">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Pricing
            </p>
            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
            >
              Clear pricing guidance for support, security, cloud, and managed
              operations.
            </h1>
            <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
              The goal of this page is simple: help buyers understand the plan
              levels, the cost drivers, and the planning tools available before
              they ask for a tailored quote.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href="#plans"
              variant="primary"
              className="min-h-[50px]"
            >
              Compare plans
            </ModernButton>
            <ModernButton
              href="#estimate"
              variant="secondary"
              className="min-h-[50px]"
            >
              Open calculators
            </ModernButton>
            <ModernButton
              href={requestQuoteHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Email for a quote
            </ModernButton>
          </div>

          <p
            class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
          >
            Illustrative pricing — final scope is validated in discovery
          </p>
        </div>

        <ModernCard variant="glass" className="hidden p-7 sm:p-8 md:block">
          <div class="space-y-5">
            <div>
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-white/50"
              >
                What changes price most
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                Pricing is tied to operating reality, not vague package names.
              </p>
            </div>

            <div class="space-y-4">
              {
                pricingDrivers.slice(0, 3).map(item => (
                  <div class="border-l border-white/10 pl-4">
                    <p class="text-sm font-semibold text-white">{item.title}</p>
                    <p class="mt-2 text-sm leading-6 text-slate-300">
                      {item.copy}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          pricingSignals.map(signal => (
            <ModernCard variant="default" className="h-full p-5">
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45">
                Signal
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                {signal.label}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {signal.sublabel}
              </p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" id="plans" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-3xl space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Plans
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Choose the operating lane that matches your current pressure.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            Start with the level of support, security, and strategic involvement
            you actually need. The deeper engineering and modernization work can
            be layered in once the baseline is stable.
          </p>
        </div>

        <ModernButton
          href={withBasePath('services/#service-planner')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          Open service planner
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          pricingTiers.map(tier => (
            <ModernCard
              variant={tier.highlight ? 'gradient' : 'default'}
              className="h-full p-6"
            >
              <p class="text-sm font-semibold text-white">{tier.name}</p>
              <p class="mt-2 text-3xl font-semibold tracking-tight text-white">
                {tier.price}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {tier.description}
              </p>

              <div class="mt-5 space-y-4 border-t border-white/10 pt-5 text-sm">
                <div>
                  <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                    Best for
                  </p>
                  <p class="mt-1 text-slate-200">{tier.bestFor}</p>
                </div>
                <div>
                  <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                    Response model
                  </p>
                  <p class="mt-1 text-slate-300">{tier.responseSla}</p>
                </div>
              </div>

              <ul class="mt-5 space-y-2 text-sm text-slate-300">
                {tier.perks.map(perk => (
                  <li class="flex items-start gap-2">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#12b5a6]" />
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-6">
                <ModernButton
                  href={requestQuoteHref}
                  variant={tier.highlight ? 'primary' : 'secondary'}
                  className="min-h-[48px] w-full"
                >
                  {tier.ctaLabel}
                </ModernButton>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Cost drivers
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Four things that tend to move pricing the most.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          This is the practical context behind the plan table. If your
          environment is changing quickly, these are usually the levers that
          explain why one scope lands in Growth, Secure+, or Custom.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          pricingDrivers.map(item => (
            <ModernCard variant="outline" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" id="sla" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          SLA comparison
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Compare the depth of support, security, and strategic coverage.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          The matrix below helps clarify what changes as you move from a
          baseline support plan into stronger security coverage or a custom
          operating model.
        </p>
      </div>

      <div
        class="mt-10 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.03]"
      >
        <table class="w-full min-w-[760px] border-collapse text-left">
          <thead>
            <tr
              class="border-b border-white/10 text-xs uppercase tracking-[0.22em] text-white/45"
            >
              <th class="px-5 py-4 font-semibold">Capability</th>
              <th class="px-5 py-4 font-semibold">Essentials</th>
              <th class="px-5 py-4 font-semibold">Growth</th>
              <th class="px-5 py-4 font-semibold">Secure+</th>
              <th class="px-5 py-4 font-semibold">Custom</th>
            </tr>
          </thead>
          <tbody>
            {
              slaComparisonRows.map((row, index) => (
                <tr class={index % 2 === 0 ? 'bg-white/[0.02]' : ''}>
                  <th class="px-5 py-4 align-top text-sm font-semibold text-white">
                    {row.capability}
                  </th>
                  <td class="px-5 py-4 text-sm text-slate-300">
                    {row.essentials}
                  </td>
                  <td class="px-5 py-4 text-sm text-slate-300">{row.growth}</td>
                  <td class="px-5 py-4 text-sm text-slate-300">
                    {row.securePlus}
                  </td>
                  <td class="px-5 py-4 text-sm text-slate-300">{row.custom}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" id="estimate" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Planning tools
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Estimate cost and business impact before you ask for a tailored quote.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          These calculators stay on the site because they help buyers
          pressure-test assumptions before discovery. They are not a replacement
          for scoping, but they do make the conversation better.
        </p>
      </div>

      <div class="mt-10 grid gap-8 xl:grid-cols-2 xl:items-start">
        <PricingCalculator
          client:visible
          ctaHref={requestQuoteHref}
          ctaLabel="Email for a quote"
          title="Estimate monthly cost"
          description="Use the model to sanity-check budget before discovery. We will validate the assumptions once we understand your users, devices, response expectations, and project scope."
        />
        <ROICalculator
          client:visible
          ctaHref={requestQuoteHref}
          ctaLabel="Request ROI review"
          title="Model business impact"
          description="Translate stronger support coverage, fewer emergency escalations, and better security hygiene into a rough payback story for leadership."
        />
      </div>
    </div>
  </section>

  <section class="border-b border-white/10" id="faq" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            FAQ
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Common questions around scope, onboarding, and fit.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            These answers focus on the practical buying questions that typically
            come up before discovery, especially for co-managed environments and
            teams with compliance pressure.
          </p>
          <ModernButton
            href={withBasePath('services/#faq')}
            variant="secondary"
            className="min-h-[48px]"
          >
            View services FAQ
          </ModernButton>
        </div>

        <div>
          <FAQAccordion client:visible items={pricingFaqs} />
        </div>
      </div>
    </div>
  </section>

  <section id="contact" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.12fr_0.88fr] lg:items-center">
          <div class="space-y-4">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Request pricing
            </p>
            <h2
              class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Need a best-fit quote instead of a rough estimate?
            </h2>
            <p class="max-w-2xl text-base leading-7 text-slate-300">
              Send over user counts, critical systems, compliance needs, support
              hours, and any major cloud or security priorities. That is usually
              enough to recommend the right lane and shape the next
              conversation.
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
          >
            <ModernButton
              href={requestQuoteHref}
              variant="primary"
              className="min-h-[50px]"
            >
              Email project details
            </ModernButton>
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open intake form
            </ModernButton>
          </div>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
