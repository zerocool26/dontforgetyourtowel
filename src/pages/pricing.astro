---
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import PageHero from '../components/PageHero.astro';
import PricingEstimator from '../components/business/PricingEstimator';
import { pricingDrivers, pricingTiers } from '../data/site';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { withBasePath } from '../utils/helpers';

const faqs = [
  {
    question: 'Are these exact prices?',
    answer:
      'No. They are directional planning ranges. Final pricing depends on users, devices, locations, coverage, servers, security requirements, backup scope, and the amount of project or cleanup work involved.',
  },
  {
    question: 'Is onboarding included?',
    answer:
      'The quote will separate recurring service from onboarding and one-time remediation. That keeps transition work visible instead of hiding it inside the monthly fee.',
  },
  {
    question: 'How are consulting and software engagements priced?',
    answer:
      'A focused assessment or discovery phase is scoped around clear outputs. Build and modernization work is then priced by phase, milestone, or a defined delivery team. The proposal should show assumptions, acceptance criteria, dependencies, and what ongoing support would cost separately.',
  },
];
---

<MarketingLayout
  title="Technology Consulting, Software & Managed IT Pricing | CHICAGOS #1 MSP"
  description="Pricing models for technology advisory, custom software, modernization, cybersecurity, projects, and managed IT services."
>
  <PageHero
    title="Know what you are"
    accent="buying."
    copy="Clear engagement models, visible cost drivers, and a hard line between discovery, delivery, ongoing operations, and unresolved assumptions."
    primaryLabel="Request a scoped range"
    secondaryLabel="Explore services"
    secondaryHref="services/"
    asideTitle="The useful starting point"
    asideCopy="The business outcome, current environment, users, systems, timeline, risk, internal owners, and the evidence still needed before a responsible quote."
    mediaKey="fog"
  />

  <section class="route-index pricing-models">
    <div class="shell">
      <h2>Three engagement models.</h2>
      <div class="route-index__rows">
        <div class="software-route-row">
          <span class="index-number">01</span>
          <strong>Advisory & discovery</strong>
          <p>
            A scoped review, roadmap, architecture decision, due diligence
            package, or recovery plan with defined outputs.
          </p>
        </div>
        <div class="software-route-row">
          <span class="index-number">02</span>
          <strong>Build & modernization</strong>
          <p>
            Software, cloud, integration, migration, and security delivery
            organized by phase, milestone, or an agreed delivery team.
          </p>
        </div>
        <div class="software-route-row">
          <span class="index-number">03</span>
          <strong>Managed operations</strong>
          <p>
            Recurring support, workplace, cloud, security, application, or
            co-managed responsibility with explicit coverage and review cadence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section pricing-section">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>Managed IT planning ranges.</h2>
        <p>
          These figures apply to recurring user and workplace support—not
          consulting or software delivery. Per-user pricing is only a planning
          shorthand; the quote still needs an environment review.
        </p>
      </div>
      <div class="pricing-tiers">
        {
          pricingTiers.map((tier, index) => (
            <article>
              <span class="index-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{tier.name}</h3>
              <p class="pricing-tiers__price">
                <strong>{tier.range}</strong>
                <span>per user / month</span>
              </p>
              <p>{tier.description}</p>
              <ul>
                {tier.includes.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="estimator-section">
    <div class="shell estimator-section__grid">
      <div class="section-heading">
        <h2>Estimate recurring managed IT.</h2>
        <p>
          Use this only for internal managed-service budgeting. Consulting,
          software, modernization, and project work require outcome-based scope.
        </p>
      </div>
      <PricingEstimator
        client:load
        tiers={pricingTiers.map(({ id, name, low, high }) => ({
          id,
          name,
          low,
          high,
        }))}
      />
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>What changes the number.</h2>
        <p>
          Price follows the outcome, technical environment, delivery risk, and
          responsibility—not a mystery bundle or a developer count alone.
        </p>
      </div>
      <div class="driver-list">
        {
          pricingDrivers.map((driver, index) => (
            <article>
              <span class="index-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{driver.title}</h3>
                <p>{driver.copy}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="shell quote-standard">
      <div class="section-heading">
        <h2>A proposal should make three things obvious.</h2>
      </div>
      <ol>
        <li>
          <span>01</span><strong>What is recurring</strong><p>
            Deliverables, milestones, managed service, support, security,
            recovery, and review cadence.
          </p>
        </li>
        <li>
          <span>02</span><strong>What is one-time</strong><p>
            Discovery, onboarding, remediation, migrations, hardware, and
            project or software delivery.
          </p>
        </li>
        <li>
          <span>03</span><strong>What is still unknown</strong><p>
            Assumptions that need access, evidence, or a technical decision.
          </p>
        </li>
      </ol>
      <a class="text-link" href={withBasePath('contact-hq/?topic=pricing')}>
        Request a scoped range <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>Pricing questions.</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Get the model, assumptions, and next"
    accent="decision."
    copy="Bring the business outcome and the rough environment. We will identify what can be priced now, what needs discovery, and who should own the next step."
    secondaryLabel="Review services"
    secondaryHref="services/"
  />
</MarketingLayout>
