---
/* eslint-disable astro/no-set-html-directive */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import PricingCalculator from '../components/business/PricingCalculator.tsx';
import ROICalculator from '../components/business/ROICalculator.tsx';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import {
  pricingFaqs,
  pricingSignals,
  pricingTiers,
  slaComparisonRows,
} from '../data/pricing';
import { CONTACT_EMAIL } from '../consts';
import { withBasePath } from '../utils/helpers';

const requestQuoteHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Chicago MSP pricing and roadmap request')}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(withBasePath('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Pricing',
      item: new URL(withBasePath('pricing/'), Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.content,
    },
  })),
};

const pricingDrivers = [
  {
    title: 'User and device count',
    copy: 'Seats are only the beginning. Laptops, shared workstations, servers, mobile devices, warranty age, and endpoint standards all change the work.',
  },
  {
    title: 'Coverage and response expectations',
    copy: 'Business-hours coverage is different from after-hours response, executive escalation, onsite help, or a dedicated co-managed lane.',
  },
  {
    title: 'Security and compliance depth',
    copy: 'MFA, conditional access, EDR/MDR, awareness, vulnerability review, audit evidence, and response planning add real recurring ownership.',
  },
  {
    title: 'Projects and modernization workstreams',
    copy: 'Cloud migrations, Microsoft 365 cleanup, office moves, portal work, ecommerce demos, and infrastructure refreshes should be scoped visibly.',
  },
];

const quoteExamples = [
  {
    size: '25 users / one office',
    likelyFit: 'Core Coverage or Secure Operations',
    notes:
      'Usually driven by help desk ownership, endpoint cleanup, onboarding discipline, Microsoft 365 basics, and backup verification.',
  },
  {
    size: '75 users / hybrid team',
    likelyFit: 'Secure Operations',
    notes:
      'Often needs identity policy, device hardening, email security, Teams/SharePoint governance, lifecycle planning, and monthly reporting.',
  },
  {
    size: '120 users / regulated or multi-site',
    likelyFit: 'Co-Managed and Regulated',
    notes:
      'Scope typically includes tighter escalation, compliance evidence habits, restore testing, change control, and internal IT coordination.',
  },
  {
    size: 'Complex estate / project-heavy',
    likelyFit: 'Custom',
    notes:
      'Best when pricing depends on cloud migration, office refreshes, servers, dedicated security, ecommerce, portals, or executive cadence.',
  },
];

const quotePrep = [
  'User count, shared workstation count, and number of locations',
  'Servers, key applications, Microsoft 365 tenant notes, and cloud footprint',
  'Current provider pain: slow response, recurring issues, poor security visibility, unclear reporting, or weak project follow-through',
  'Compliance pressure, cyber insurance requirements, and backup or recovery concerns',
  'Known projects in the next six months: moves, migrations, refreshes, website, portal, or ecommerce work',
];

const scopeBoundaries = [
  {
    label: 'Usually recurring',
    items: [
      'Help desk triage and user support',
      'Endpoint monitoring, patching, and baseline hygiene',
      'Microsoft 365 administration and access changes',
      'Backup monitoring and routine reporting',
      'Vendor coordination tied to supported systems',
    ],
  },
  {
    label: 'Usually project-scoped',
    items: [
      'Tenant migrations, server migrations, and major cloud changes',
      'Office moves, network redesign, cabling, and hardware refreshes',
      'Compliance program buildout, audit remediation, and vCISO projects',
      'Website, ecommerce, portal, and client-facing digital builds',
      'Large automation, integration, or reporting workstreams',
    ],
  },
  {
    label: 'Needs discovery',
    items: [
      'After-hours response expectations and executive escalation',
      'Cyber insurance, HIPAA, SOC 2, or regulated evidence needs',
      'Multi-site support, onsite requirements, and critical production systems',
      'Current provider transition, backup handoff, and access transfer',
      'Line-of-business applications with unusual vendor constraints',
    ],
  },
];

const pricingSections = [
  { label: 'Plans', href: '#plans' },
  { label: 'SLA matrix', href: '#sla' },
  { label: 'Scope examples', href: '#scope-examples' },
  { label: 'Boundaries', href: '#scope-boundaries' },
  { label: 'Estimate', href: '#estimate' },
  { label: 'FAQ', href: '#faq' },
];
---

<MarketingLayout
  title="Pricing | Olive Chicago"
  description="Directional Chicago MSP pricing, SLA guidance, and planning tools for support, security, Microsoft 365, cloud, and selective digital delivery."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Pricing',
      description:
        'Plan comparison, SLA guidance, pricing calculators, and ROI planning tools.',
    }}
  />
  <StructuredData
    type="breadcrumbs"
    data={{ items: breadcrumbSchema.itemListElement }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="tone-page-hero tone-section-divider border-b" data-reveal>
    <div
      class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Pricing</p>
            <h1 class="tone-page-title">
              Directional Chicago pricing for support, security, Microsoft 365,
              cloud, and selective digital delivery.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Compare plan levels, budget drivers, and planning tools before you
              ask for a tailored quote or roadmap conversation.
            </p>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href="#plans"
              variant="primary"
              className="min-h-[50px]"
            >
              Compare plans
            </ModernButton>
            <ModernButton
              href="#estimate"
              variant="secondary"
              className="min-h-[50px]"
            >
              Open calculators
            </ModernButton>
            <ModernButton
              href={requestQuoteHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Request a roadmap quote
            </ModernButton>
          </div>

          <p
            class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
          >
            Directional ranges only — final scope still gets tuned in discovery
          </p>
        </div>

        <ModernCard variant="glass" className="p-6 sm:p-8">
          <div class="space-y-5">
            <div>
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-white/50"
              >
                Pricing logic
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                Price follows support depth, risk, locations, and execution
                scope.
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                Use this page to get directional clarity first. The final quote
                still gets tuned to users, devices, servers, locations, response
                expectations, and any project work.
              </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="tone-panel-soft rounded-2xl p-4">
                <p class="text-sm font-semibold text-white">Best first move</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  Compare the plan levels, then use the calculators if you need
                  a faster budget check.
                </p>
              </div>
              <div class="tone-panel-soft rounded-2xl p-4">
                <p class="text-sm font-semibold text-white">When to email</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  Email once the question shifts from rough fit to exact scope,
                  timeline, or approval-ready pricing.
                </p>
              </div>
            </div>
          </div>
        </ModernCard>
      </div>

      <div class="tone-page-jump-links mt-6">
        {
          pricingSections.map(section => (
            <a
              href={section.href}
              class="tone-chip-soft tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
            >
              {section.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {
          pricingSignals.map(signal => (
            <ModernCard variant="default" className="h-full p-5">
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45">
                Signal
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                {signal.label}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {signal.sublabel}
              </p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" id="plans" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Plans</p>
          <h2 class="tone-section-title">
            Choose the level of coverage that matches your current pressure.
          </h2>
          <p class="tone-section-copy">
            Start with the support and security depth you actually need, then
            layer in cloud, Microsoft 365, project work, or digital delivery
            where it earns the investment.
          </p>
        </div>

        <ModernButton
          href={withBasePath('services/#service-planner')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          Open service planner
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          pricingTiers.map(tier => (
            <ModernCard
              variant={tier.highlight ? 'gradient' : 'default'}
              className="h-full p-6"
            >
              <p class="text-sm font-semibold text-white">{tier.name}</p>
              <p class="mt-2 text-3xl font-semibold tracking-tight text-white">
                {tier.price}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {tier.description}
              </p>

              <div class="tone-divider-top mt-5 space-y-4 pt-5 text-sm">
                <div>
                  <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                    Best for
                  </p>
                  <p class="mt-1 text-slate-200">{tier.bestFor}</p>
                </div>
                <div>
                  <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                    Response model
                  </p>
                  <p class="mt-1 text-slate-300">{tier.responseSla}</p>
                </div>
              </div>

              <ul class="mt-5 space-y-2 text-sm text-slate-300">
                {tier.perks.map(perk => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-6">
                <ModernButton
                  href={requestQuoteHref}
                  variant={tier.highlight ? 'primary' : 'secondary'}
                  className="min-h-[48px] w-full"
                >
                  {tier.ctaLabel}
                </ModernButton>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Cost drivers</p>
        <h2 class="tone-section-title">
          Four things that usually move pricing the most.
        </h2>
        <p class="tone-section-copy">
          These are the levers that usually explain why a scope lands in Core
          Coverage, Secure Operations, Co-Managed, or a custom roadmap.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          pricingDrivers.map(item => (
            <ModernCard variant="outline" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" id="sla" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">SLA comparison</p>
        <h2 class="tone-section-title">
          Compare the depth of support, security, and strategic coverage.
        </h2>
        <p class="tone-section-copy">
          The matrix below shows what changes as you move from a clean support
          baseline into deeper security coverage or a custom operating model.
        </p>
      </div>

      <div class="tone-table-shell mt-10 overflow-x-auto rounded-2xl">
        <table class="w-full min-w-[760px] border-collapse text-left">
          <thead>
            <tr
              class="border-b border-white/10 text-xs uppercase tracking-[0.22em] text-white/45"
            >
              <th class="px-5 py-4 font-semibold">Capability</th>
              <th class="px-5 py-4 font-semibold">Core</th>
              <th class="px-5 py-4 font-semibold">Secure Ops</th>
              <th class="px-5 py-4 font-semibold">Co-Managed</th>
              <th class="px-5 py-4 font-semibold">Custom</th>
            </tr>
          </thead>
          <tbody>
            {
              slaComparisonRows.map((row, index) => (
                <tr
                  class={
                    index % 2 === 0
                      ? 'bg-[color:color-mix(in_srgb,var(--color-surface)_72%,transparent)]'
                      : ''
                  }
                >
                  <th class="px-5 py-4 align-top text-sm font-semibold text-white">
                    {row.capability}
                  </th>
                  <td class="px-5 py-4 text-sm text-slate-300">
                    {row.essentials}
                  </td>
                  <td class="px-5 py-4 text-sm text-slate-300">{row.growth}</td>
                  <td class="px-5 py-4 text-sm text-slate-300">
                    {row.securePlus}
                  </td>
                  <td class="px-5 py-4 text-sm text-slate-300">{row.custom}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="scope-examples"
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Scope examples</p>
        <h2 class="tone-section-title">
          Pricing should sound like your environment, not a mystery package.
        </h2>
        <p class="tone-section-copy">
          These examples are not quotes. They show how experienced providers
          usually think through fit before promising a number.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-4">
        {
          quoteExamples.map(example => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {example.size}
              </p>
              <h3 class="mt-3 text-lg font-semibold leading-tight text-white">
                {example.likelyFit}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {example.notes}
              </p>
            </ModernCard>
          ))
        }
      </div>

      <ModernCard variant="glass" className="mt-8 p-6">
        <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="tone-section-kicker">Quote prep</p>
            <h3 class="mt-3 text-2xl font-semibold leading-tight text-white">
              Send this once and the pricing conversation gets sharper fast.
            </h3>
          </div>
          <ul
            class="grid gap-3 text-sm leading-6 text-slate-300 md:grid-cols-2"
          >
            {
              quotePrep.map(item => (
                <li class="flex items-start gap-2">
                  <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </ModernCard>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="scope-boundaries"
    data-reveal
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Scope boundaries</p>
        <h2 class="tone-section-title">
          The quote should say what is recurring, what is project work, and what
          needs discovery.
        </h2>
        <p class="tone-section-copy">
          This is where many MSP conversations get fuzzy. Clear boundaries make
          pricing easier to trust and reduce surprises after onboarding.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          scopeBoundaries.map(group => (
            <ModernCard variant="default" className="h-full p-6">
              <h3 class="text-xl font-semibold text-white">{group.label}</h3>
              <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-300">
                {group.items.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" id="estimate" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Planning tools</p>
        <h2 class="tone-section-title">
          Estimate cost and business impact before you ask for a tailored quote.
        </h2>
        <p class="tone-section-copy">
          Use these calculators to pressure-test assumptions before discovery,
          leadership review, or a pricing call.
        </p>
      </div>

      <div class="mt-10 grid gap-8 xl:grid-cols-2 xl:items-start">
        <PricingCalculator
          client:only="preact"
          ctaHref={requestQuoteHref}
          ctaLabel="Email for a quote"
          title="Estimate monthly cost"
          description="Use the model to sanity-check budget before discovery. We validate the assumptions once we understand your users, devices, and response expectations."
        />
        <ROICalculator
          client:only="preact"
          ctaHref={requestQuoteHref}
          ctaLabel="Request ROI review"
          title="Model business impact"
          description="Translate stronger support coverage and fewer escalations into a rough payback story for leadership."
        />
      </div>
    </div>
  </section>

  <section class="tone-section-divider border-b" id="faq" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">FAQ</p>
          <h2 class="tone-section-title">
            Common questions around scope, onboarding, and fit.
          </h2>
          <p class="tone-section-copy">
            These answers focus on the practical buying questions that usually
            come up before discovery.
          </p>
          <ModernButton
            href={withBasePath('services/#faq')}
            variant="secondary"
            className="min-h-[48px]"
          >
            View services FAQ
          </ModernButton>
        </div>

        <div>
          <FAQAccordion items={pricingFaqs} />
        </div>
      </div>
    </div>
  </section>

  <section id="contact" data-reveal>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="tone-cta-band p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.12fr_0.88fr] lg:items-center">
          <div class="tone-section-heading">
            <p class="tone-section-kicker">Request pricing</p>
            <h2 class="tone-section-title">
              Need a best-fit quote instead of a rough estimate?
            </h2>
            <p class="tone-section-copy max-w-2xl">
              Send over user counts, locations, critical systems, support
              expectations, and any major security, cloud, or project
              priorities.
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
          >
            <ModernButton
              href={requestQuoteHref}
              variant="primary"
              className="min-h-[50px]"
            >
              Email project details
            </ModernButton>
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open intake form
            </ModernButton>
          </div>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
