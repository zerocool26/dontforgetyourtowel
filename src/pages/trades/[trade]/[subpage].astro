---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import ModernButton from '../../../components/ui/ModernButton.astro';
import ModernCard from '../../../components/ui/ModernCard.astro';
import TradePhaseStudio from '../../../components/business/TradePhaseStudio.astro';
import {
  tradeProfiles,
  getTradeSubpage,
  type TradeProfile,
  type TradeSubpage,
} from '../../../data/trades';
import { getTradeVisual } from '../../../data/trade-visuals';
import { getTradeSubpageOperations } from '../../../data/trade-operations';
import { withBasePath } from '../../../utils/helpers';

export function getStaticPaths() {
  return tradeProfiles.flatMap(trade =>
    trade.subpages.map(subpage => ({
      params: { trade: trade.slug, subpage: subpage.slug },
      props: { trade, subpage },
    }))
  );
}

const { trade, subpage } = Astro.props as {
  trade: TradeProfile;
  subpage: TradeSubpage;
};

const siblingSubpages = trade.subpages.filter(
  item => item.slug !== subpage.slug
);
const resolvedSubpage = getTradeSubpage(trade.slug, subpage.slug) ?? subpage;
const tradeVisual = getTradeVisual(trade.slug);
const subpageOperations = getTradeSubpageOperations(trade.slug, subpage.slug);
const routeExecutionPhases = subpageOperations
  ? [
      {
        title: 'Required inputs',
        items: subpageOperations.requiredInputs,
        summary: subpageOperations.requiredInputs[0],
      },
      {
        title: 'Field checklist',
        items: subpageOperations.fieldChecklist,
        summary: subpageOperations.fieldChecklist[0],
      },
      {
        title: 'Owner deliverables',
        items: subpageOperations.ownerDeliverables,
        summary: subpageOperations.ownerDeliverables[0],
      },
    ]
  : [];
const subpageHref = withBasePath(`trades/${trade.slug}/${subpage.slug}/`);
const subpageIntakeHref = `${withBasePath('contact-hq/')}?trade=${encodeURIComponent(trade.slug)}&tradePage=${encodeURIComponent(resolvedSubpage.title)}`;
const subpageBreadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Trade Directory',
    item: new URL(withBasePath('trades/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 3,
    name: trade.name,
    item: new URL(withBasePath(`trades/${trade.slug}/`), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 4,
    name: resolvedSubpage.title,
    item: new URL(subpageHref, Astro.site).toString(),
  },
];

const pageNavigator = {
  label: `${trade.shortName} Route`,
  accent: trade.accent,
  items: [
    { id: 'route-hero', label: 'Route Overview', shortLabel: 'Overview' },
    {
      id: 'route-playbook',
      label: 'Execution Playbook',
      shortLabel: 'Playbook',
    },
  ],
};
---

<MarketingLayout
  title={`${resolvedSubpage.title} | ${trade.name}`}
  description={resolvedSubpage.description}
  bodyClass={`bg-[#06101d] ${tradeVisual.themeClass}`}
  showFooter={true}
  pageNavigator={pageNavigator}
>
  <StructuredData
    type="service"
    data={{
      name: resolvedSubpage.title,
      description: resolvedSubpage.description,
      serviceType: resolvedSubpage.callout.value,
      audience: {
        '@type': 'BusinessAudience',
        audienceType: trade.marketFocus,
      },
      areaServed: 'United States',
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: subpageBreadcrumbItems }} />
  <section
    class="tone-surface relative scroll-mt-32 overflow-hidden pb-14 pt-28"
    data-reveal
    id="route-hero"
    data-page-section
  >
    <div
      class="absolute inset-0 -z-10 opacity-90"
      style={`background: radial-gradient(circle at top, color-mix(in srgb, ${trade.accent} 18%, transparent), transparent 54%);`}
    >
    </div>
    <div class="mx-auto max-w-[1320px] px-6">
      <div
        class="creative-hero-shell trade-subpage-shell grid gap-8 p-8 xl:grid-cols-[1.1fr_0.9fr]"
        style={`--trade-accent:${trade.accent};`}
      >
        <div class="space-y-5">
          <div class="flex flex-wrap gap-2">
            <a class="creative-chip" href={withBasePath('/')}>Home</a>
            <a class="creative-chip" href={withBasePath('trades/')}>Trades</a>
            <a
              class="creative-chip"
              href={withBasePath(`trades/${trade.slug}/`)}
            >
              {trade.shortName}
            </a>
            <span
              class="creative-chip"
              style={`border-color: color-mix(in srgb, ${trade.accent} 30%, rgba(255,255,255,0.08));`}
            >
              {resolvedSubpage.shortLabel}
            </span>
          </div>
          <p class="creative-kicker">Focused delivery route</p>
          <h1
            class="tone-title text-5xl font-semibold tracking-tight sm:text-6xl"
          >
            {resolvedSubpage.title}
          </h1>
          <p class="tone-body max-w-3xl text-base leading-relaxed">
            {resolvedSubpage.description}
          </p>
          <p class="tone-body max-w-3xl text-sm leading-relaxed">
            {resolvedSubpage.intro}
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={subpageIntakeHref}
              variant="primary"
              className="min-h-[48px]"
            >
              Start intake for this route
            </ModernButton>
            <ModernButton
              href={withBasePath(`trades/${trade.slug}/`)}
              variant="secondary"
              className="min-h-[48px]"
            >
              Back to {trade.shortName}
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="outline"
              className="min-h-[48px]"
            >
              Open services hub
            </ModernButton>
          </div>
        </div>

        <ModernCard variant="glass" className="trade-subpage-callout p-6">
          <p class="creative-kicker">{tradeVisual.stageLabel}</p>
          <p class="tone-title mt-4 text-3xl font-semibold">
            {resolvedSubpage.callout.value}
          </p>
          <p class="tone-body mt-3 text-sm">{resolvedSubpage.callout.note}</p>
          {
            subpageOperations && (
              <div class="mt-5 grid gap-3">
                <div class="trade-subpage-mini">
                  <p class="trade-subpage-mini__label">Required inputs</p>
                  <p class="trade-subpage-mini__value">
                    {subpageOperations.requiredInputs[0]}
                  </p>
                </div>
                <div class="trade-subpage-mini">
                  <p class="trade-subpage-mini__label">Field checkpoint</p>
                  <p class="trade-subpage-mini__value">
                    {subpageOperations.fieldChecklist[0]}
                  </p>
                </div>
              </div>
            )
          }
          <div class="mt-6 flex flex-wrap gap-2">
            <span
              class="creative-chip"
              style={`border-color: color-mix(in srgb, ${trade.accent} 28%, rgba(255,255,255,0.08));`}
            >
              {resolvedSubpage.callout.label}
            </span>
            <span class="creative-chip">{trade.shortName}</span>
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    data-reveal
    id="route-playbook"
    data-page-section
  >
    <div class="mx-auto max-w-[1320px] px-6 py-12">
      <div class="grid gap-5 xl:grid-cols-[1.1fr_0.9fr]">
        <div class="grid gap-5">
          {
            resolvedSubpage.sections.map((section, index) => (
              <ModernCard variant="glass" className="trade-subpage-section p-7">
                <div class="flex items-start gap-4">
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 font-mono text-xs text-white/75">
                    0{index + 1}
                  </span>
                  <div class="min-w-0">
                    <h2 class="tone-title text-3xl font-semibold">
                      {section.title}
                    </h2>
                    <p class="tone-body mt-3 text-sm leading-relaxed">
                      {section.copy}
                    </p>
                    <ul class="tone-body mt-5 space-y-3 text-sm">
                      {section.bullets.map(item => (
                        <li class="flex items-start gap-3">
                          <span
                            class="mt-2 h-2 w-2 flex-shrink-0 rounded-full"
                            style={`background:${trade.accent};`}
                          />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </ModernCard>
            ))
          }
        </div>

        <div class="grid gap-5">
          <ModernCard variant="glass" className="trade-subpage-aside p-6">
            <p class="creative-kicker">{tradeVisual.subpageLabel}</p>
            <p class="tone-title mt-4 text-2xl font-semibold">{trade.name}</p>
            <p class="tone-body mt-2 text-sm">{trade.summary}</p>
            <div class="mt-5">
              <ModernButton
                href={withBasePath(`trades/${trade.slug}/`)}
                variant="secondary"
              >
                Open trade overview
              </ModernButton>
            </div>
          </ModernCard>

          <ModernCard variant="glass" className="trade-subpage-aside p-6">
            <p class="creative-kicker">Other routes in this division</p>
            <div class="mt-4 grid gap-3">
              {
                siblingSubpages.map(item => (
                  <a
                    href={withBasePath(`trades/${trade.slug}/${item.slug}/`)}
                    class="trade-subpage-link rounded-3xl border border-white/10 bg-white/[0.02] p-4 transition hover:border-white/20 hover:bg-white/[0.04]"
                  >
                    <p class="tone-title text-base font-semibold">
                      {item.title}
                    </p>
                    <p class="tone-body mt-2 text-sm">{item.description}</p>
                  </a>
                ))
              }
            </div>
          </ModernCard>

          {
            routeExecutionPhases.length ? (
              <TradePhaseStudio
                eyebrow={`${trade.shortName} Route Logic`}
                title="Execution lens"
                description={`${resolvedSubpage.callout.note} Use this view to keep required inputs, field checkpoints, and owner handoff expectations in one place.`}
                accent={trade.accent}
                phases={routeExecutionPhases}
              />
            ) : null
          }
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style is:inline>
  .trade-subpage-shell,
  .trade-subpage-callout,
  .trade-subpage-section,
  .trade-subpage-aside,
  .trade-subpage-link {
    position: relative;
    overflow: hidden;
  }

  .trade-subpage-shell {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9)),
      rgba(5, 7, 12, 0.88);
  }

  .trade-subpage-callout {
    border: 1px solid
      color-mix(in srgb, var(--trade-accent, #ffffff) 24%, transparent);
    background:
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--trade-accent, #ffffff) 18%, transparent),
        transparent 40%
      ),
      rgba(5, 7, 12, 0.82);
  }

  .trade-subpage-section,
  .trade-subpage-aside,
  .trade-subpage-link {
    background:
      linear-gradient(
        150deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.01)
      ),
      rgba(255, 255, 255, 0.02);
  }

  .trade-subpage-mini {
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.85rem 0.9rem;
  }

  .trade-subpage-mini__label {
    margin: 0;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.46);
  }

  .trade-subpage-mini__value {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  body.trade-experience--mechanical .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(185, 242, 113, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--electrical .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(255, 224, 130, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--plumbing .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(125, 211, 252, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--gc .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(253, 164, 175, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--hvac .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(134, 239, 172, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--auto .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(252, 165, 165, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--msp .trade-subpage-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(196, 181, 253, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }
</style>
