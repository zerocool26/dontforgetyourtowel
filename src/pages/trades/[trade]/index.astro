---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import StructuredData from '../../../components/StructuredData.astro';
import ModernButton from '../../../components/ui/ModernButton.astro';
import ModernCard from '../../../components/ui/ModernCard.astro';
import TradePhaseStudio from '../../../components/business/TradePhaseStudio.astro';
import SignalCabinet from '../../../components/business/SignalCabinet.astro';
import { servicesExtended } from '../../../data/services-extended';
import { tradeProfiles, type TradeProfile } from '../../../data/trades';
import { getTradeVisual } from '../../../data/trade-visuals';
import { getTradeOperations } from '../../../data/trade-operations';
import { withBasePath } from '../../../utils/helpers';

export function getStaticPaths() {
  return tradeProfiles.map(trade => ({
    params: { trade: trade.slug },
    props: { trade },
  }));
}

const { trade } = Astro.props as { trade: TradeProfile };
const techCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);
const tradeHref = withBasePath(`trades/${trade.slug}/`);
const tradeVisual = getTradeVisual(trade.slug);
const tradeOperations = getTradeOperations(trade.slug);
const overviewPhases = tradeOperations.setupGroups.map(group => ({
  title: group.title,
  items: group.items,
  summary: group.items[0],
}));
const tradeSignalItems = [
  {
    kicker: 'Differentiator',
    title: `${trade.shortName} posture`,
    detail: trade.differentiators[0] ?? trade.summary,
    meta: trade.differentiators.slice(1),
  },
  {
    kicker: 'Owner outputs',
    title: 'Closeout built for operations',
    detail: tradeOperations.ownerOutputs[0] ?? trade.summary,
    meta: tradeOperations.ownerOutputs.slice(1),
  },
  {
    kicker: 'Standards',
    title: 'Field quality expectations',
    detail: tradeOperations.standards[0] ?? trade.marketFocus,
    meta: tradeOperations.standards.slice(1),
  },
];
const tradeIntakeHref = `${withBasePath('contact-hq/')}?trade=${encodeURIComponent(trade.slug)}&tradePage=${encodeURIComponent(`${trade.name} overview`)}`;
const tradeBreadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Trade Directory',
    item: new URL(withBasePath('trades/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 3,
    name: trade.name,
    item: new URL(tradeHref, Astro.site).toString(),
  },
];

const pageNavigator = {
  label: `${trade.shortName} Guide`,
  accent: trade.accent,
  items: [
    { id: 'trade-hero', label: 'Trade Overview', shortLabel: 'Overview' },
    { id: 'trade-scope', label: 'Service Lines', shortLabel: 'Scope' },
    {
      id: 'trade-positioning',
      label: 'Market And Standards',
      shortLabel: 'Standards',
    },
    { id: 'trade-routes', label: 'Focused Routes', shortLabel: 'Routes' },
  ],
};
---

<MarketingLayout
  title={`${trade.name} | CHICAGOS #1 MSP`}
  description={trade.summary}
  noIndex={true}
  bodyClass={`creative-page ${tradeVisual.themeClass}`}
  showFooter={true}
  pageNavigator={pageNavigator}
  mainClass="relative isolate overflow-x-clip"
  showSavedRoutesDock={false}
>
  <StructuredData
    type="service"
    data={{
      name: trade.name,
      description: trade.summary,
      serviceType: tradeOperations.operatingModel,
      audience: {
        '@type': 'BusinessAudience',
        audienceType: trade.marketFocus,
      },
      areaServed: 'United States',
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: tradeBreadcrumbItems }} />
  <section
    class="tone-surface relative scroll-mt-32 overflow-hidden pb-12 pt-20 sm:pb-14 sm:pt-28"
    data-reveal
    id="trade-hero"
    data-page-section
  >
    <div
      class="absolute inset-0 -z-10 opacity-90"
      style={`background: radial-gradient(circle at top, color-mix(in srgb, ${trade.accent} 18%, transparent), transparent 52%);`}
    >
    </div>
    <div class="mx-auto max-w-[1400px] px-4 sm:px-6">
      <div
        class="creative-hero-shell trade-hero-shell grid gap-8 p-5 sm:p-8 xl:grid-cols-[1.1fr_0.9fr]"
        style={`--trade-accent:${trade.accent};`}
      >
        <div class="space-y-5">
          <div class="flex flex-wrap items-center gap-3">
            <a class="creative-chip" href={withBasePath('/')}>Home</a>
            <a class="creative-chip" href={withBasePath('trades/')}>Trades</a>
            <span
              class="creative-chip"
              style={`border-color: color-mix(in srgb, ${trade.accent} 30%, rgba(255,255,255,0.08));`}
            >
              {trade.shortName}
            </span>
          </div>
          <p class="creative-kicker">Service division overview</p>
          <h1
            class="tone-title text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl"
          >
            {trade.name}
          </h1>
          <p class="tone-body max-w-3xl text-base leading-relaxed">
            {trade.summary}
          </p>
          <p
            class="tone-body text-white/72 hidden max-w-3xl text-sm leading-relaxed md:block"
          >
            {trade.heroDescription}
          </p>
          <p class="tone-body text-white/62 max-w-3xl text-sm leading-relaxed">
            <span class="text-white/84 font-semibold">Best fit:</span>
            {' '}
            {trade.marketFocus}
          </p>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="trade-info-chip">
              <p class="trade-info-chip__label">Operating model</p>
              <p class="trade-info-chip__value">
                {tradeOperations.operatingModel}
              </p>
            </div>
            <div class="trade-info-chip">
              <p class="trade-info-chip__label">Service rhythm</p>
              <p class="trade-info-chip__value">
                {tradeOperations.serviceRhythm}
              </p>
            </div>
            <div class="trade-info-chip">
              <p class="trade-info-chip__label">Project window</p>
              <p class="trade-info-chip__value">
                {tradeOperations.projectWindow}
              </p>
            </div>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={tradeIntakeHref}
              variant="primary"
              className="min-h-[48px]"
            >
              Start {trade.shortName} intake
            </ModernButton>
            <ModernButton
              href={withBasePath('trades/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Back to trade directory
            </ModernButton>
            <span class="hidden sm:block">
              <ModernButton
                href={withBasePath('services/')}
                variant="outline"
                className="min-h-[48px]"
              >
                Open services hub
              </ModernButton>
            </span>
          </div>
        </div>

        <div class="grid gap-4">
          <ModernCard variant="glass" className="trade-stage-board p-6">
            <p class="creative-kicker">{tradeVisual.stageLabel}</p>
            <p class="tone-title mt-4 text-3xl font-semibold">
              {tradeVisual.stageValue}
            </p>
            <p class="tone-body mt-3 text-sm">{tradeVisual.stageCopy}</p>
            <ul class="tone-body mt-5 space-y-3 text-sm">
              {
                tradeVisual.stageBullets.map(item => (
                  <li class="flex items-start gap-3">
                    <span
                      class="mt-2 h-2 w-2 flex-shrink-0 rounded-full"
                      style={`background:${trade.accent};`}
                    />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </ModernCard>

          <div class="hidden gap-4 sm:grid sm:grid-cols-3 xl:grid-cols-1">
            {
              trade.metrics.map(metric => (
                <ModernCard variant="glass" className="p-5">
                  <p class="tone-muted text-xs uppercase tracking-[0.24em]">
                    {metric.label}
                  </p>
                  <p class="tone-title mt-2 text-2xl font-semibold">
                    {metric.value}
                  </p>
                  <p class="tone-body mt-2 text-sm">{metric.note}</p>
                </ModernCard>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    data-reveal
    id="trade-scope"
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6">
      <div class="grid gap-5 xl:grid-cols-[1.1fr_0.9fr]">
        <ModernCard variant="glass" className="trade-service-grid p-7">
          <p class="creative-kicker">Service Lines</p>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {
              trade.serviceLines.map(line => (
                <div class="trade-detail-card rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                  <p class="tone-title text-lg font-semibold">{line.title}</p>
                  <p class="tone-body mt-2 text-sm">{line.description}</p>
                  <ul class="tone-body mt-4 space-y-2 text-sm">
                    {line.deliverables.map(item => (
                      <li class="flex items-start gap-2">
                        <span
                          class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full"
                          style={`background:${trade.accent};`}
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </ModernCard>

        <div class="grid gap-5">
          <TradePhaseStudio
            eyebrow={`${trade.shortName} Sequence`}
            title="Execution sequence"
            description={`${tradeOperations.operatingModel}. ${tradeOperations.projectWindow}.`}
            accent={trade.accent}
            phases={overviewPhases}
          />

          <SignalCabinet
            eyebrow={`${trade.shortName} Signals`}
            title={`${trade.shortName} delivery posture`}
            description="Use this summary to understand field posture, owner expectations, and the quality standards shaping delivery."
            accent={trade.accent}
            items={tradeSignalItems}
          />
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    data-reveal
    id="trade-positioning"
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-4 py-4 sm:px-6">
      <div class="grid gap-5 xl:grid-cols-[0.9fr_1.1fr]">
        <ModernCard
          variant="glass"
          className="trade-side-panel scroll-mt-32 p-6"
          id="trade-routes"
        >
          <p class="creative-kicker">Best-fit sectors</p>
          <div class="mt-5 grid gap-4">
            {
              trade.sectors.map(sector => (
                <div class="trade-detail-card rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                  <p class="tone-title text-lg font-semibold">{sector.name}</p>
                  <p class="tone-body mt-2 text-sm">{sector.note}</p>
                </div>
              ))
            }
          </div>
        </ModernCard>

        <ModernCard variant="glass" className="trade-side-panel p-6">
          <div class="grid gap-4 border-b border-white/10 pb-5 md:grid-cols-2">
            <div>
              <p class="creative-kicker">Related divisions</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {
                  trade.integration.map(item => (
                    <span
                      class="creative-chip"
                      style={`border-color: color-mix(in srgb, ${trade.accent} 24%, rgba(255,255,255,0.08));`}
                    >
                      {item}
                    </span>
                  ))
                }
              </div>
            </div>
            <div>
              <p class="creative-kicker">Where this works best</p>
              <p class="tone-body mt-4 text-sm leading-relaxed">
                {trade.marketFocus}
              </p>
            </div>
          </div>
          <div
            class="flex flex-col gap-4 pt-6 md:flex-row md:items-end md:justify-between"
          >
            <div>
              <p class="creative-kicker">Focused routes</p>
              <h2 class="tone-title mt-3 text-3xl font-semibold">
                Delivery routes for this division.
              </h2>
            </div>
            <a class="creative-chip" href={tradeHref}> Overview </a>
          </div>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {
              trade.subpages.map(subpage => (
                <a
                  href={withBasePath(`trades/${trade.slug}/${subpage.slug}/`)}
                  class="trade-detail-card rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition hover:border-white/20 hover:bg-white/[0.04]"
                >
                  <p class="tone-title text-lg font-semibold">
                    {subpage.title}
                  </p>
                  <p class="tone-body mt-2 text-sm">{subpage.description}</p>
                  <p class="tone-muted mt-4 text-xs uppercase tracking-[0.22em]">
                    {subpage.callout.value}
                  </p>
                </a>
              ))
            }
          </div>
        </ModernCard>
      </div>
    </div>
  </section>

  {
    trade.slug === 'msp-tech-services' && (
      <section class="tone-surface pb-20" data-reveal>
        <div class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6">
          <ModernCard variant="glass" className="p-7">
            <div class="flex flex-col gap-4 border-b border-white/10 pb-5 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="creative-kicker">Technology catalog</p>
                <h2 class="tone-title mt-3 text-3xl font-semibold">
                  The deeper technology catalog still supports this division.
                </h2>
              </div>
              <ModernButton
                href={withBasePath('services/#service-planner')}
                variant="secondary"
              >
                Open planner
              </ModernButton>
            </div>
            <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {techCategories.map(category => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">
                  <p class="tone-title text-lg font-semibold">{category}</p>
                  <p class="tone-body mt-2 text-sm">
                    Preserved from the services architecture and now connected
                    cleanly into the seven-division site map.
                  </p>
                </div>
              ))}
            </div>
          </ModernCard>
        </div>
      </section>
    )
  }
</MarketingLayout>

<style is:inline>
  .trade-hero-shell {
    position: relative;
    isolation: isolate;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9)),
      rgba(5, 7, 12, 0.88);
  }

  .trade-stage-board {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--trade-accent, #ffffff) 24%, transparent);
    background:
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.08),
        rgba(255, 255, 255, 0.02)
      ),
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--trade-accent, #ffffff) 18%, transparent),
        transparent 42%
      ),
      rgba(5, 7, 12, 0.84);
  }

  .trade-stage-board::after {
    content: '';
    position: absolute;
    inset: auto -10% -28% 38%;
    height: 220px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--trade-accent, #ffffff) 22%, transparent),
      transparent 72%
    );
    filter: blur(22px);
    pointer-events: none;
  }

  .trade-detail-card,
  .trade-side-panel {
    background:
      linear-gradient(
        150deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.01)
      ),
      rgba(255, 255, 255, 0.02);
  }

  .trade-info-chip {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.95rem 1rem;
  }

  .trade-info-chip__label {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
  }

  .trade-info-chip__value {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  body.trade-experience--mechanical .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(185, 242, 113, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--electrical .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(255, 224, 130, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--plumbing .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(125, 211, 252, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--gc .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(253, 164, 175, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--hvac .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(134, 239, 172, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--auto .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(252, 165, 165, 0.1),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }

  body.trade-experience--msp .trade-hero-shell {
    background:
      radial-gradient(
        circle at top right,
        rgba(196, 181, 253, 0.12),
        transparent 28%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(4, 8, 12, 0.9));
  }
</style>
