---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ModernButton from '../../components/ui/ModernButton.astro';
import ModernCard from '../../components/ui/ModernCard.astro';
import TradeDirectoryCard from '../../components/business/TradeDirectoryCard.astro';
import TradeCoordinationMatrix from '../../components/business/TradeCoordinationMatrix.astro';
import {
  tradeProfiles,
  tradePrograms,
  totalTradeSubpages,
} from '../../data/trades';
import { getTradeOperations } from '../../data/trade-operations';
import { withBasePath } from '../../utils/helpers';

const tradeSignals = [
  {
    label: 'Trade overviews',
    value: String(tradeProfiles.length),
  },
  {
    label: 'Trade subpages',
    value: String(totalTradeSubpages),
  },
  {
    label: 'Linked hub',
    value: 'Homepage + services',
  },
];

const tradeMatrixItems = tradeProfiles.map(trade => {
  const operations = getTradeOperations(trade.slug);
  const linkedPrograms = tradePrograms
    .filter(program => program.tradeSlugs.includes(trade.slug))
    .map(program => program.title);

  return {
    slug: trade.slug,
    name: trade.name,
    badge: trade.badge,
    accent: trade.accent,
    operatingModel: operations.operatingModel,
    serviceRhythm: operations.serviceRhythm,
    ownerOutput: operations.ownerOutputs[0] ?? trade.summary,
    integration: trade.integration.slice(0, 3),
    programs: linkedPrograms.length ? linkedPrograms : ['Independent route'],
    href: withBasePath(`trades/${trade.slug}/`),
  };
});

const pageNavigator = {
  label: 'Trade Directory',
  accent: '#d7f75b',
  items: [
    {
      id: 'trade-directory-hero',
      label: 'Directory Overview',
      shortLabel: 'Overview',
    },
    {
      id: 'coordination-matrix',
      label: 'Coordination Matrix',
      shortLabel: 'Matrix',
    },
    { id: 'directory', label: 'Trade Grid', shortLabel: 'Trades' },
    {
      id: 'trade-programs',
      label: 'Integrated Programs',
      shortLabel: 'Programs',
    },
  ],
};
---

<MarketingLayout
  title="Trade Directory | CHICAGOS #1 MSP"
  description="Browse the seven trade divisions and their supporting subpages across the integrated CHICAGOS #1 MSP website."
  noIndex={true}
  bodyClass="creative-page"
  showFooter={true}
  pageNavigator={pageNavigator}
  mainClass="relative isolate overflow-x-clip"
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Trade Directory',
      description:
        'Browse all seven trade divisions, their overviews, and their supporting subpages.',
    }}
  />
  <StructuredData
    type="breadcrumbs"
    data={{
      items: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL(withBasePath('/'), Astro.site).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Trade Directory',
          item: new URL(withBasePath('trades/'), Astro.site).toString(),
        },
      ],
    }}
  />
  <section
    class="tone-page-hero scroll-mt-32 overflow-hidden border-b border-white/10 pb-12 pt-20 sm:pb-14 sm:pt-28"
    data-reveal
    id="trade-directory-hero"
    data-page-section
  >
    <div class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 sm:px-6">
      <div class="grid gap-8 pb-2 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="space-y-5">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Trade directory</p>
            <h1 class="tone-page-title max-w-5xl">
              Seven service divisions with clearer operating logic and faster
              routing.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Compare the divisions, understand how they operate, and move into
              the right overview page without wading through generic contractor
              language.
            </p>
          </div>
          <div class="tone-page-actions">
            <ModernButton
              href={withBasePath('/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Return to homepage
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Open services hub
            </ModernButton>
          </div>
        </div>

        <div class="hidden gap-4 sm:grid sm:grid-cols-3 xl:grid-cols-1">
          {
            tradeSignals.map(signal => (
              <ModernCard variant="glass" className="tone-metric-card p-5">
                <p class="tone-metric-card__label">{signal.label}</p>
                <p class="tone-metric-card__value">{signal.value}</p>
                <p class="tone-metric-card__detail">
                  {signal.label === 'Trade overviews'
                    ? 'Each lead division has its own overview page.'
                    : signal.label === 'Trade subpages'
                      ? 'Specialist routes extend the main division pages.'
                      : 'Homepage and services stay connected.'}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="scroll-mt-32 border-b border-white/10"
    id="coordination-matrix"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <TradeCoordinationMatrix
        eyebrow="Coordination Matrix"
        title="Compare how the trades actually operate."
        description="Compare operating model, service rhythm, owner outputs, and trade-program connections without leaving the directory."
        items={tradeMatrixItems}
      />
    </div>
  </section>

  <section
    class="scroll-mt-32 border-b border-white/10"
    id="directory"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          tradeProfiles.map(trade => (
            <TradeDirectoryCard trade={trade} showMarketFocus={false} />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="scroll-mt-32 pb-20 pt-2"
    data-reveal
    id="trade-programs"
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 sm:px-6">
      <div class="tone-section-heading pb-8">
        <p class="tone-section-kicker">Integrated programs</p>
        <h2 class="tone-section-title">
          Some scopes belong to one division. Others need a coordinated stack.
        </h2>
        <p class="tone-section-copy">
          These recurring programs help buyers think across connected lanes
          instead of treating every project as a single-trade problem.
        </p>
      </div>
      <div class="grid gap-5 xl:grid-cols-3">
        {
          tradePrograms.map(program => (
            <ModernCard variant="glass" className="p-6">
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45">
                {program.tradeSlugs.length} linked trades
              </p>
              <p class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </p>
              <p class="mt-4 text-sm leading-7 text-slate-300">
                {program.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                {program.tradeSlugs.map(slug => {
                  const trade = tradeProfiles.find(item => item.slug === slug);
                  return trade ? (
                    <a
                      class="rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:border-white/20 hover:bg-white/[0.05]"
                      href={withBasePath(`trades/${trade.slug}/`)}
                    >
                      {trade.shortName}
                    </a>
                  ) : null;
                })}
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>
