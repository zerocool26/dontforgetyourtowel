---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import { withBasePath } from '../utils/helpers';

const companySignals = [
  {
    label: 'Operating style',
    value: 'Calm + design-led',
    detail: 'Clear ownership, sharper taste, and less generic MSP noise.',
  },
  {
    label: 'Coverage depth',
    value: 'MSP+',
    detail:
      'Managed IT, security, cloud, AI, automation, and client-facing delivery.',
  },
  {
    label: 'Best fit',
    value: 'Growth-minded teams',
    detail: 'Ideal when operations and presentation both need to level up.',
  },
];

const positioningPoints = [
  {
    title: 'Operator-led, not theater-led',
    copy: 'The business starts with real pressures—support chaos, security drift, cloud sprawl, slow processes, or a weak digital front door.',
  },
  {
    title: 'Minimal, but not generic',
    copy: 'The visual system stays restrained and premium while still carrying personality, motion, and art-direction where it earns the space.',
  },
  {
    title: 'One partner from support to standout builds',
    copy: 'Retained operations, security work, modernization tracks, and premium proof surfaces all stay inside one clear operating model.',
  },
];

const sectors = [
  [
    'Founder-led companies',
    'Need a strategic partner that can stabilize operations without slowing momentum.',
  ],
  [
    'Professional services teams',
    'Want cleaner systems, better support, and a front door that feels more premium.',
  ],
  [
    'Healthcare and regulated teams',
    'Need stronger security posture, calmer compliance habits, and trustworthy guidance.',
  ],
  [
    'Multi-site and hybrid teams',
    'Need device, access, and support models that work across locations.',
  ],
  [
    'Retail and lifestyle brands',
    'Need operations to stay sharp while customer-facing experiences level up.',
  ],
  [
    'Real estate and hospitality groups',
    'Need better systems, stronger trust signals, and mobile-friendly client experiences.',
  ],
  [
    'SaaS and product teams',
    'Need support, cloud clarity, and product-adjacent execution without adding five vendors.',
  ],
  [
    'Teams in transition',
    'Need an easier bridge from “barely coping” to “actually operating well.”',
  ],
];

const deliveryModel = [
  {
    step: '01',
    title: 'Diagnose the pressure',
    copy: 'Start with the friction that is actually costing time, trust, or opportunity right now.',
  },
  {
    step: '02',
    title: 'Set the lead lane',
    copy: 'Choose the first service lane clearly, then only add the adjacent work that genuinely helps the outcome.',
  },
  {
    step: '03',
    title: 'Stabilize and modernize',
    copy: 'Fix the foundations first, then expand into modernization, automation, or premium digital work.',
  },
  {
    step: '04',
    title: 'Leave a sharper next move',
    copy: 'Every engagement should end with visible proof, usable documentation, and a smarter next-step roadmap.',
  },
];

const companySections = [
  { label: 'Why us', href: '#positioning' },
  { label: 'Delivery flow', href: '#delivery-model' },
  { label: 'Capabilities', href: '#trade-overview' },
  { label: 'Proof', href: '#programs' },
];

const capabilityOverview = [
  {
    eyebrow: 'Managed operations',
    title: 'Support and ownership',
    summary:
      'Help desk, onboarding, endpoint hygiene, vendor coordination, and executive-friendly reporting that finally feel organized.',
    detail:
      'Best when the team needs steadier operations before anything more ambitious can land.',
  },
  {
    eyebrow: 'Security and compliance',
    title: 'Trust and control',
    summary:
      'Identity, device posture, awareness, response readiness, and compliance habits that build confidence without bureaucracy overload.',
    detail:
      'Best when leadership wants sharper security without turning the whole company into a security department.',
  },
  {
    eyebrow: 'Cloud, AI, and automation',
    title: 'Modernization and leverage',
    summary:
      'Cloud cleanup, automation, AI workflows, observability, and systems thinking that remove operational drag.',
    detail:
      'Best when the business needs lift, not another stack of half-used tools.',
  },
  {
    eyebrow: 'Proof and experience',
    title: 'Premium digital surfaces',
    summary:
      'Proof labs, launch surfaces, portals, and product experiences that feel cinematic, simple, and persuasive on mobile.',
    detail:
      'Best when the front door matters as much as the infrastructure behind it.',
  },
];

const proofModes = [
  {
    title: 'Live proof routes',
    description:
      'Interactive routes show the work as a working system instead of a flat case-study paragraph.',
  },
  {
    title: 'Pricing without fog',
    description:
      'Plan levels, budget drivers, and calculators keep buying conversations calmer and more transparent.',
  },
  {
    title: 'Studio-led planning',
    description:
      'The studio turns a vague idea into a tighter roadmap with priorities, surfaces, and realistic rollout pace.',
  },
];
---

<MarketingLayout
  title="Company | Olive Global Systems"
  description="Company overview for Olive Global Systems, including positioning, delivery model, buyer fit, and how the MSP+ stack stays connected."
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
  mainClass="relative isolate overflow-x-clip"
>
  <section
    class="tone-page-hero tone-section-divider border-b"
    id="company-hero"
    data-reveal
    data-page-section
  >
    <div
      class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 pb-14 pt-20 sm:px-6 sm:pb-20 sm:pt-28"
    >
      <div class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Company</p>
            <h1 class="tone-page-title max-w-5xl">
              A design-led MSP+ firm built to make technology feel calmer,
              sharper, and easier to buy.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Olive Global Systems blends support, security, modernization, and
              premium digital execution into one operating model that reads
              clearly on mobile and still feels distinctive.
            </p>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href={withBasePath('services/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Explore solutions
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review pricing
            </ModernButton>
            <span class="hidden sm:block">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="outline"
                className="min-h-[50px]"
              >
                Start a conversation
              </ModernButton>
            </span>
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            {
              companySections.map(section => (
                <a
                  class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                  href={section.href}
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid gap-4">
          <ModernCard
            variant="glass"
            className="tone-metric-card tone-panel-soft h-full p-6"
          >
            <p class="tone-metric-card__label">What kind of firm this is</p>
            <p
              class="tone-metric-card__value text-[clamp(1.45rem,2vw,1.95rem)]"
            >
              Operationally serious. Visually sharp.
            </p>
            <p class="tone-metric-card__detail">
              Built for companies that need calmer systems and stronger buyer
              confidence without adding more noise.
            </p>
          </ModernCard>
          <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
            {
              companySignals.map(signal => (
                <ModernCard
                  variant="default"
                  className="tone-metric-card h-full p-5 tone-panel-soft"
                >
                  <p class="tone-metric-card__label">{signal.label}</p>
                  <p class="tone-metric-card__value text-[clamp(1.3rem,2vw,1.8rem)]">
                    {signal.value}
                  </p>
                  <p class="tone-metric-card__detail">{signal.detail}</p>
                </ModernCard>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="positioning"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Positioning</p>
        <h2 class="tone-section-title">Why the company is built this way.</h2>
        <p class="tone-section-copy">
          The goal is not to look bigger than necessary. The goal is to make a
          high-trust partner easier to understand and easier to choose.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          positioningPoints.map(item => (
            <ModernCard
              variant="default"
              className="h-full p-7 tone-panel-soft"
            >
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="delivery-model"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Delivery model</p>
          <h2 class="tone-section-title">
            The delivery flow is deliberately simple.
          </h2>
          <p class="tone-section-copy">
            Diagnose the pressure, set the lead lane, stabilize the stack, and
            leave the client with visible proof plus a smarter next move.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          {
            deliveryModel.map(item => (
              <ModernCard
                variant="outline"
                className="h-full p-6 tone-panel-soft"
              >
                <p class="font-mono text-[0.72rem] uppercase tracking-[0.22em] text-white/45">
                  {item.step}
                </p>
                <h3 class="mt-4 text-lg font-semibold text-white">
                  {item.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="sectors"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Buyer fit</p>
        <h2 class="tone-section-title">
          Best for teams with real pressure and no patience for fluff.
        </h2>
        <p class="tone-section-copy">
          These are the kinds of clients who benefit most from calmer systems,
          stronger trust signals, and a more polished digital front door.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          sectors.map(([name, note]) => (
            <ModernCard variant="glass" className="h-full p-6 tone-panel-soft">
              <p class="text-lg font-semibold text-white">{name}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{note}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="trade-overview"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Capability clusters</p>
          <h2 class="tone-section-title">
            Four capability clusters explain the whole business.
          </h2>
          <p class="tone-section-copy">
            Buyers should be able to orient quickly before they ever need the
            deeper catalog or proof routes.
          </p>
        </div>

        <ModernButton
          href={withBasePath('services/')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          Open solution hub
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {
          capabilityOverview.map(item => (
            <ModernCard
              variant="default"
              className="h-full p-6 tone-panel-soft"
            >
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45">
                {item.eyebrow}
              </p>
              <h3 class="mt-4 text-xl font-semibold text-white">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {item.summary}
              </p>
              <div class="tone-divider-top mt-6 pt-5 text-sm">
                <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                  Best fit
                </p>
                <p class="mt-2 text-slate-200">{item.detail}</p>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="scope-readiness"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel
        title="Pressure-test the first company conversation."
        description="Use the same three checks we use to route work into the right lane, the right scope, and a smarter first step."
      />
    </div>
  </section>

  <section id="programs" data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="tone-cta-band p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
          <div class="tone-section-heading">
            <p class="tone-section-kicker">Proof modes</p>
            <h2 class="tone-section-title">
              The company story works because the proof does too.
            </h2>
            <p class="tone-section-copy">
              A stronger firm narrative needs more than a promise. It needs live
              proof, pricing clarity, and a planning surface that turns ideas
              into scope.
            </p>
          </div>

          <div class="grid gap-4">
            {
              proofModes.map(program => (
                <div class="tone-panel-soft rounded-2xl p-5">
                  <p class="text-lg font-semibold text-white">
                    {program.title}
                  </p>
                  <p class="mt-2 text-sm leading-7 text-slate-300">
                    {program.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
