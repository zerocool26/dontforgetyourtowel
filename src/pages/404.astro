---
import PageHero from '../components/PageHero.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Page Not Found | CHICAGOS #1 MSP"
  description="The requested page could not be found."
  noIndex
>
  <PageHero
    title="This page is"
    accent="no longer here."
    copy="The route may have been retired during the site rebuild. Start with the current services, resources, or contact page."
    primaryLabel="Go home"
    primaryHref="/"
    secondaryLabel="See services"
    secondaryHref="services/"
  >
    <div slot="aside">
      <p class="eyebrow">Best next move</p>
      <h2>Return to the current operating model.</h2>
      <p>
        Every live service and decision path starts from the main navigation.
      </p>
    </div>
  </PageHero>
</MarketingLayout>
