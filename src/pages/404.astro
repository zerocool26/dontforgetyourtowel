---
/**
 * 404 Page Not Found
 * Enhanced error page with accessibility and helpful navigation
 */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { withBasePath } from '../utils/helpers';
import { LEGACY_REDIRECT_DESTINATIONS } from '../../config/legacyRedirects.js';

const quickLinks = [
  {
    label: 'Home',
    href: withBasePath('/'),
    description: 'Return to the main page',
  },
  {
    label: 'E Commerce Demo',
    href: withBasePath('about/'),
    description: 'Review the interactive experience route',
  },
  {
    label: 'Solutions',
    href: withBasePath('services/'),
    description: 'Explore the core solution lanes',
  },
  {
    label: 'Contact',
    href: withBasePath('contact-hq/'),
    description: 'How to reach us',
  },
  {
    label: 'Pricing',
    href: withBasePath('pricing/'),
    description: 'Review plans and pricing guidance',
  },
];

const legacyRedirectMap = Object.fromEntries(
  Object.entries(LEGACY_REDIRECT_DESTINATIONS).map(
    ([legacyPath, destination]) => [legacyPath, withBasePath(destination)]
  )
);
---

<MarketingLayout
  title="Page Not Found | Olive Chicago"
  description="The page you're looking for doesn't exist. Use the links below to navigate."
  bodyClass="creative-page"
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <section
    class="relative flex min-h-[80vh] items-center justify-center overflow-hidden border-b border-white/10"
    aria-labelledby="error-title"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(215,247,91,0.08),transparent_40%),linear-gradient(to_right,rgba(148,163,184,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:auto,32px_32px,32px_32px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-[860px] px-4 py-20 text-center sm:px-6">
      <ModernCard
        variant="glass"
        className="relative px-8 py-14 backdrop-blur-sm sm:px-14 sm:py-18"
        role="alert"
        aria-live="polite"
      >
        <div class="mb-8 flex justify-center">
          <ModernCard
            variant="outline"
            className="inline-flex h-24 w-24 items-center justify-center border font-mono text-4xl font-bold text-[#d7f75b]"
            aria-hidden="true"
          >
            404
          </ModernCard>
        </div>

        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/50"
        >
          Route not found
        </p>

        <h1
          id="error-title"
          class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          This page is no longer available.
        </h1>

        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg"
        >
          The link may be outdated, the route may have changed, or the page may
          have been retired during the site cleanup. Use one of the routes below
          to get back to the main sections of the site.
        </p>

        <p
          id="legacy-redirect-status"
          class="mx-auto mt-5 hidden max-w-xl rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm text-slate-300"
          aria-live="polite"
        >
        </p>

        <p class="mt-6 font-mono text-sm text-white/55">
          <span class="sr-only">Requested URL:</span>
          Requested: <code
            class="break-all rounded border border-white/10 bg-white/[0.03] px-2 py-1 text-[#d7f75b]"
            id="current-url"
            aria-label="Current URL path"></code>
        </p>

        <div
          class="mt-10 flex flex-wrap justify-center gap-4"
          role="group"
          aria-label="Error page actions"
        >
          <ModernButton
            href={withBasePath('/')}
            variant="primary"
            className="min-h-[48px]"
          >
            <svg
              class="mr-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              ></path>
            </svg>
            Return Home
          </ModernButton>
          <ModernButton
            href={withBasePath('contact-hq/')}
            variant="secondary"
            className="min-h-[48px]"
          >
            <svg
              class="mr-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Contact
          </ModernButton>
        </div>

        <div class="mt-10 grid gap-4 text-left sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <p
              class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-white/45"
            >
              Best next step
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Start at the homepage if you want the quickest overview of the
              company, solution lanes, and current priorities.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <p
              class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-white/45"
            >
              Looking for scope?
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Use the services or pricing pages if you were trying to understand
              capabilities, planning direction, or likely engagement size.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
            <p
              class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-white/45"
            >
              Need help fast?
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              If the missing route matters to an active conversation, the
              contact page is the fastest way to get routed correctly.
            </p>
          </div>
        </div>

        <script define:vars={{ legacyRedirectMap }} is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const urlElement = document.getElementById('current-url');
            const statusElement = document.getElementById(
              'legacy-redirect-status'
            );
            if (urlElement) {
              urlElement.textContent = window.location.pathname;
            }

            const trimTrailingSlash = value =>
              value === '/' ? '/' : value.replace(/\/+$/, '');

            const basePathRaw =
              document.documentElement.getAttribute('data-base-path') || '/';
            const basePath = trimTrailingSlash(basePathRaw);

            const pathname = window.location.pathname;
            let normalizedPath = pathname;

            if (
              basePath &&
              basePath !== '/' &&
              normalizedPath.startsWith(basePath)
            ) {
              normalizedPath = normalizedPath.slice(basePath.length) || '/';
            }

            if (!normalizedPath.startsWith('/')) {
              normalizedPath = `/${normalizedPath}`;
            }

            const routeKey = trimTrailingSlash(normalizedPath);
            const redirectTarget = legacyRedirectMap[routeKey];

            if (!redirectTarget) return;

            const target = new URL(redirectTarget, window.location.origin);
            if (!target.search && window.location.search) {
              target.search = window.location.search;
            }
            if (!target.hash && window.location.hash) {
              target.hash = window.location.hash;
            }

            if (statusElement) {
              statusElement.classList.remove('hidden');
              statusElement.textContent =
                'Legacy route detected. Redirecting to the updated location…';
            }

            window.setTimeout(() => {
              window.location.replace(target.toString());
            }, 120);
          });
        </script>

        <div class="mt-12 border-t border-white/10 pt-10">
          <p
            class="font-mono text-xs font-bold uppercase tracking-[0.24em] text-white/45"
            id="quick-links-title"
          >
            Quick Links
          </p>
          <nav
            class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-3"
            aria-labelledby="quick-links-title"
          >
            {
              quickLinks.map(link => (
                <a
                  class="text-sm font-medium text-slate-300 transition hover:text-white focus:text-white focus:underline focus:outline-none"
                  href={link.href}
                  title={link.description}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </ModernCard>
    </div>
  </section>
</MarketingLayout>
