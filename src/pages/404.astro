---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { withBasePath } from '../utils/helpers';
---

<MarketingLayout
  title="Page Not Found | CHICAGOS #1 MSP"
  description="The requested page could not be found."
  noIndex
>
  <section class="not-found">
    <div class="shell not-found__inner">
      <span>404</span>
      <h1>This page is no longer here.</h1>
      <p>
        The route may have been retired during the site rebuild. Start with the
        current services, resources, or contact page.
      </p>
      <div class="button-row">
        <a class="button" href={withBasePath('/')}>Go home</a>
        <a class="button button--outline" href={withBasePath('services/')}
          >See services</a
        >
      </div>
    </div>
  </section>
</MarketingLayout>
