---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ProviderSelectionStandard from '../components/business/ProviderSelectionStandard.astro';
import RouteProofStrip from '../components/business/RouteProofStrip.astro';
import TrustEvidenceVault from '../components/business/TrustEvidenceVault.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import { buildContactHqHref } from '../utils/contact';
import { withBasePath } from '../utils/helpers';

const trustHeroMediaDesktop = withBasePath('media/chicago-trust-evidence.webp');
const trustHeroMediaMobile = withBasePath(
  'media/chicago-trust-evidence-mobile.webp'
);

const trustFaqs = [
  {
    title: 'Do you publish every internal control publicly?',
    content:
      'No. This page is meant to show posture, review rhythm, and accountability without oversharing internal implementation detail that would weaken security.',
  },
  {
    title: 'What should a company expect before onboarding?',
    content:
      'A fit conversation, scope framing, owner identification, and a clear picture of which operating risks need attention first.',
  },
  {
    title: 'Can this page support security questionnaires or approvals?',
    content:
      'Yes. It gives leadership a public summary of backup, incident coordination, data handling, and review cadence before deeper conversations.',
  },
];

const trustReviewHref = buildContactHqHref({
  service: 'security',
  brief:
    'I want to review trust, backup, incident coordination, or security posture.',
});

const trustRouteProof = [
  {
    label: 'Backup',
    title: 'Recovery order discussed',
    copy: 'Protected systems, restore access, and business priority are part of the conversation.',
    status: 'verified' as const,
    href: '#evidence-backup-recovery',
  },
  {
    label: 'Access',
    title: 'Admin risk visible',
    copy: 'Privileged access, MFA, guest access, and exceptions should not be vague.',
    status: 'review' as const,
    href: '#evidence-identity-access',
  },
  {
    label: 'Incident',
    title: 'Roles before panic',
    copy: 'Escalation, communication, and vendor responsibilities get named before trouble.',
    status: 'planned' as const,
    href: '#evidence-incident-coordination',
  },
];
---

<MarketingLayout
  title="Trust Center | CHICAGOS #1 MSP"
  description="Public trust center covering backup posture, incident coordination, data handling, review cadence, and practical operating accountability."
  bodyClass="creative-page buyer-reframe trust-reframe"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="service"
    data={{
      name: 'CHICAGOS #1 MSP Trust Center',
      description:
        'Public trust center with backup, incident response, data handling, and operating review posture for Chicago-area managed IT and security engagements.',
      serviceType: 'Trust center',
    }}
  />

  <section
    class="tone-page-hero tone-page-hero--media tone-section-divider border-b"
    data-page-section
    data-reveal
    style="--hero-media-position: 62% center; --hero-media-mobile-position: center;"
  >
    <picture class="tone-page-hero__media">
      <source media="(max-width: 767px)" srcset={trustHeroMediaMobile} />
      <img
        src={trustHeroMediaDesktop}
        alt="Chicago cybersecurity trust review desk with backup device and security evidence"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="tone-page-hero__veil" aria-hidden="true"></div>

    <div class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Trust center</p>
            <h1 class="tone-page-title">
              Backup, access, and incident responsibilities should be clear.
            </h1>
            <p class="tone-page-copy">
              Review how backup posture, incident coordination, data handling,
              access discipline, and account reviews are handled before a deeper
              security conversation.
            </p>
          </div>
          <div class="tone-page-actions">
            <ModernButton
              href={trustReviewHref}
              variant="primary"
              className="min-h-[52px]"
            >
              Start trust review
            </ModernButton>
            <ModernButton
              href={withBasePath('contact-hq/')}
              variant="secondary"
              className="min-h-[52px]"
            >
              Contact HQ
            </ModernButton>
          </div>
        </div>

        <ModernCard variant="glass" className="tone-metric-card p-6 sm:p-8">
          <p class="tone-metric-card__label">Buyer reassurance</p>
          <p class="tone-metric-card__value">Public-safe summary</p>
          <p class="tone-metric-card__detail">
            The goal is not to publish sensitive internals. It is to show the
            review habits a serious provider uses before deeper review.
          </p>
        </ModernCard>
      </div>
    </div>
  </section>

  <RouteProofStrip
    label="Public-safe proof"
    title="Review posture without oversharing internals."
    note="Trust should show responsibilities and habits before deeper security detail."
    items={trustRouteProof}
    ctaHref={trustReviewHref}
    ctaLabel="Start trust review"
  />

  <ProofOperatingSystem
    compact
    showComparison={false}
    showFit={false}
    eyebrow="Public trust summary"
    title="Badges matter less than clear responsibilities."
    description="Backup scope, incident contacts, access reviews, and review cadence should be easy to discuss before anyone shares sensitive internal details."
  />

  <ProviderSelectionStandard
    id="trust-selection-standard"
    compact
    eyebrow="Trust test"
    title="A trust page should answer the questions buyers actually ask."
    description="Real confidence comes from reviewable ownership: recovery order, privileged access, incident roles, Microsoft 365 governance, recurring risks, and scope boundaries."
    ctaHref={trustReviewHref}
    ctaLabel="Start trust review"
  />

  <section class="premium-page-section" data-page-section data-reveal>
    <div class="premium-container">
      <TrustEvidenceVault />
    </div>
  </section>

  <section
    class="premium-page-section pb-16 sm:pb-20"
    id="faq"
    data-page-section
  >
    <div class="premium-container max-w-4xl">
      <FAQAccordion items={trustFaqs} />
    </div>
  </section>
</MarketingLayout>
