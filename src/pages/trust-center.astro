---
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import PageHero from '../components/PageHero.astro';
import { proofRows, trustAreas } from '../data/site';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const faqs = [
  {
    question: 'Why is some security evidence not public?',
    answer:
      'Public pages should explain responsibilities and review habits without publishing sensitive configurations, client details, access paths, or incident procedures. Deeper evidence belongs in an appropriate review process.',
  },
  {
    question: 'What should we ask before hiring a technology firm?',
    answer:
      'Ask who owns source, data, domains, cloud and production accounts; how privileged access is reviewed; how security and recovery are validated; what marks delivery complete; and who owns the system after launch.',
  },
  {
    question: 'Does a trust center replace due diligence?',
    answer:
      'No. It should make due diligence more focused. The actual review should match your risk, regulatory, insurance, and contractual requirements.',
  },
];
---

<MarketingLayout
  title="Trust Center | CHICAGOS #1 MSP"
  description="How CHICAGOS #1 MSP approaches access, source and data ownership, application and cloud security, recovery, and delivery accountability."
>
  <PageHero
    title="Trust the ownership, not the pitch."
    copy="A practical view of access, source, data, application and cloud security, recovery, delivery acceptance, and the operating record you should expect from a technology partner."
    primaryLabel="Ask a due-diligence question"
    secondaryLabel="See services"
    secondaryHref="services/"
    asideTitle="Public by design"
    asideCopy="This page explains operating posture without exposing client environments, security configurations, access paths, or incident details."
  />

  <section class="section trust-areas">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>Four areas that demand direct answers.</h2>
        <p>
          Trust should be reviewable in the way work is assigned, documented,
          and carried forward.
        </p>
      </div>
      <div class="trust-areas__list">
        {
          trustAreas.map((area, index) => (
            <article>
              <span class="index-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{area.title}</h3>
                <p>{area.copy}</p>
              </div>
              <aside>
                <strong>Ask this</strong>
                <p>{area.ask}</p>
              </aside>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ownership-band">
    <div class="shell">
      <h2>What the engagement record should show.</h2>
      <ol>
        {
          proofRows.map(row => (
            <li>
              <span>{row.number}</span>
              <strong>{row.title}</strong>
              <p>{row.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>What we will not publish.</h2>
        <p>
          Credibility does not require oversharing information that could make
          clients or systems easier to target.
        </p>
      </div>
      <div class="boundary-list">
        <div>
          <span>01</span><p>
            Client names, environments, incidents, or access details without
            explicit authorization.
          </p>
        </div>
        <div>
          <span>02</span><p>
            Detailed security configurations, administrative paths, or recovery
            credentials, repository access, or production secrets.
          </p>
        </div>
        <div>
          <span>03</span><p>
            Certifications, partnerships, coverage, or response commitments that
            have not been formally established.
          </p>
        </div>
        <div>
          <span>04</span><p>
            Vague claims of perfect security, flawless software, guaranteed
            prevention, or risk-free operations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>Due-diligence questions.</h2>
        <p>Ask for enough evidence to make a decision, in the right setting.</p>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Bring the hard questions."
    copy="Tell us what your insurer, auditor, leadership team, product owner, or internal technology lead needs to understand. We will answer directly and identify what requires a private review."
    secondaryLabel="Review services"
    secondaryHref="services/"
  />
</MarketingLayout>
