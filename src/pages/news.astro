---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import RouteProofStrip from '../components/business/RouteProofStrip.astro';
import { withBasePath } from '../utils/helpers';

const episodes = [
  {
    id: 'episode-01',
    label: 'Episode 01',
    title: 'The first 30 days after switching IT providers',
    copy: 'What should get mapped, what should be stabilized, and how leadership can tell whether the handoff is working.',
    runtime: '18 min',
    progress: '38%',
    elapsed: '06:24',
    beat: 'Operations',
    tone: 'Operator',
    chapters: ['Operating map', 'Stabilize first', 'Monthly reporting'],
  },
  {
    id: 'episode-02',
    label: 'Episode 02',
    title: 'Microsoft 365 cleanup without turning it into a committee',
    copy: 'Teams, SharePoint, guest access, retention, and backup decisions that make the tenant easier to govern.',
    runtime: '22 min',
    progress: '54%',
    elapsed: '11:52',
    beat: 'Microsoft 365',
    tone: 'Executive',
    chapters: [
      'Ownership rules',
      'Retention vs backup',
      'Repeatable clean state',
    ],
  },
  {
    id: 'episode-03',
    label: 'Episode 03',
    title: 'Security baseline before the shiny security stack',
    copy: 'Identity, endpoint, email, backup, and response habits that should be visible before larger projects begin.',
    runtime: '16 min',
    progress: '31%',
    elapsed: '04:58',
    beat: 'Security',
    tone: 'Technical',
    chapters: ['Identity first', 'Email + endpoint', 'Backup + response'],
  },
];

const advisories = [
  {
    topic: 'Switching providers',
    title: 'A provider change is a control change.',
    copy: 'Capture admin access, tools, vendors, contracts, backup proof, and support history before the old relationship ends.',
  },
  {
    topic: 'Operations',
    title: 'Recurring tickets are a roadmap signal.',
    copy: 'If the same issues keep returning, the problem is usually process, policy, endpoint standards, or an application workflow.',
  },
  {
    topic: 'Workflow systems',
    title: 'A portal should prove the handoff.',
    copy: 'Review routing, trust cues, form friction, mobile behavior, ownership, and status feedback before approving a build plan.',
  },
  {
    topic: 'Security',
    title: 'Evidence beats tool names.',
    copy: 'Leadership and insurance reviewers need visible MFA, endpoint, email, backup, and response ownership more than a longer platform list.',
  },
];

const newsDesk = [
  {
    beat: 'Security',
    symbol: 'shield',
    notes: [
      'Token theft and phishing controls are changing insurance conversations.',
      'Backup proof still matters more than abstract security maturity.',
    ],
    time: '9:14 AM',
  },
  {
    beat: 'Microsoft 365',
    symbol: 'grid',
    notes: [
      'Shared mailboxes and guest access still create quiet ownership drift.',
      'Cleanup before Copilot: get the basics right first.',
    ],
    time: '8:42 AM',
  },
  {
    beat: 'Operations',
    symbol: 'gear',
    notes: [
      'Ticket volume spikes often point to standards, not staffing alone.',
      'SLA clarity reduces fire drills when escalation paths are known.',
    ],
    time: '8:17 AM',
  },
  {
    beat: 'Workflow trust',
    symbol: 'flow',
    notes: [
      'Access sprawl creates both risk and drag in client-facing systems.',
      'Approvals and audit trails should be simplified before launch.',
    ],
    time: '7:58 AM',
  },
];

const briefingBuilder = [
  {
    beat: 'Security',
    signal: 'Insurance and leadership are asking for proof, not tool names.',
    question: 'Which control can be evidenced this month?',
    angle:
      'Frame identity, endpoint, email, and backup controls as evidence habits rather than abstract security spend.',
    actions: [
      'Check MFA posture',
      'Verify backup proof',
      'Document response path',
    ],
  },
  {
    beat: 'Microsoft 365',
    signal: 'Collaboration sprawl is making normal work harder to govern.',
    question: 'Which Teams or SharePoint rule would remove the most confusion?',
    angle:
      'Show how tenant cleanup improves speed, access confidence, search, retention, and everyday operating clarity.',
    actions: ['Map guest access', 'Review stale sites', 'Set lifecycle rules'],
  },
  {
    beat: 'Operations',
    signal:
      'Recurring tickets are becoming a management issue, not a help desk issue.',
    question: 'Which recurring support pattern should become roadmap work?',
    angle:
      'Turn noisy ticket history into an executive brief about ownership, standards, and the first operating fix.',
    actions: [
      'Review ticket themes',
      'Name the owner',
      'Publish the first fix',
    ],
  },
  {
    beat: 'Workflow trust',
    signal:
      'The client-facing path is not keeping up with the service quality.',
    question: 'Which handoff most affects trust or conversion?',
    angle:
      'Connect visual craft to the actual service path: mobile clarity, proof, intake, status feedback, and follow-through.',
    actions: ['Audit mobile path', 'Find proof gaps', 'Prototype handoff'],
  },
];

const proofItems = [
  {
    label: '01 / Plain English',
    title: 'Operator-first',
    copy: 'Short notes explain what changed and what it means for ownership.',
    status: 'verified' as const,
  },
  {
    label: '02 / Local fit',
    title: 'Chicago operating lens',
    copy: 'Briefings stay grounded in small and mid-sized team reality.',
    status: 'review' as const,
  },
  {
    label: '03 / Next move',
    title: 'Route to action',
    copy: 'Every briefing points to a checklist, resource, proof route, or intake.',
    status: 'planned' as const,
  },
];

const editorialActions = [
  {
    title: 'Read the blog',
    copy: 'Turn short-form signals into fuller written guidance and practical checklists.',
    href: withBasePath('blog/'),
  },
  {
    title: 'Visit the Trust Center',
    copy: 'Pair commentary with backup, incident, data-handling, and service proof.',
    href: withBasePath('trust-center/'),
  },
  {
    title: 'Contact the operating desk',
    copy: 'Start a scoped conversation when the question is ready.',
    href: withBasePath('contact-hq/'),
  },
];

const currentEpisode = episodes[0];
const currentBrief = briefingBuilder[0];
---

<MarketingLayout
  title="News + Podcast | CHICAGOS #1 MSP"
  description="Editorial desk and podcast-style briefings on managed IT, security, Microsoft 365, operations, service ownership, and workflow systems."
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'CHICAGOS #1 MSP News and Podcast',
      description:
        'Short editorial signals and podcast-style briefings about managed IT, security, Microsoft 365, service ownership, and workflow systems.',
      hasPart: episodes.map(episode => ({
        '@type': 'PodcastEpisode',
        name: episode.title,
        description: episode.copy,
        timeRequired: episode.runtime,
      })),
    }}
  />

  <section class="news-hero" data-page-section>
    <div class="premium-container">
      <div class="news-hero__topline" aria-label="News route context">
        <span>News + podcast</span>
        <span>Chicago, IL / Local team. Real operations.</span>
      </div>

      <div class="news-hero__grid">
        <div class="news-hero__copy">
          <h1 class="tone-page-title">
            Short briefings on technology shifts that affect real operations.
          </h1>
          <p class="tone-page-copy">
            Security requirements, Microsoft 365 governance, workflow pressure,
            support operations, and client-facing service paths move quickly.
            This desk turns the change into practical notes for operators and
            owners.
          </p>

          <div class="news-hero__actions">
            <ModernButton
              href="#episodes"
              variant="gradient"
              className="min-h-[52px]"
            >
              Browse episodes
            </ModernButton>
            <ModernButton
              href={withBasePath('blog/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Read the blog
            </ModernButton>
          </div>

          <div class="news-hero__signals" aria-label="Editorial standards">
            <span>Operator-first</span>
            <span>Chicago local</span>
            <span>Route-proof</span>
            <span>Plain English</span>
          </div>
        </div>

        <div class="news-hero__studio">
          <article class="news-ticket" aria-label="Featured briefing receipt">
            <p class="news-meta-kicker">Featured briefing</p>
            <h2 data-news-ticket-title>{currentEpisode.title}</h2>
            <p data-news-ticket-copy>{currentEpisode.copy}</p>
            <div class="news-ticket__stamp">Reviewed</div>
            <div class="news-ticket__meta">
              <span data-news-ticket-label>{currentEpisode.label}</span>
              <span data-news-ticket-runtime>{currentEpisode.runtime}</span>
              <span data-news-ticket-tone>{currentEpisode.tone}</span>
            </div>
            <div class="news-ticket__barcode" aria-hidden="true"></div>
          </article>

          <article class="news-player" aria-label="Featured podcast episode">
            <div>
              <p class="news-meta-kicker">
                <span aria-hidden="true" class="news-live-dot"></span>
                Now playing
              </p>
              <h2 data-news-player-title>{currentEpisode.title}</h2>
              <p data-news-player-copy>{currentEpisode.copy}</p>
            </div>

            <div class="news-waveform" aria-hidden="true">
              {
                Array.from({ length: 42 }).map((_, index) => (
                  <span
                    style={`--wave:${12 + ((index * 17) % 34)}%; --delay:${index * 18}ms`}
                  />
                ))
              }
            </div>

            <div class="news-player__timeline">
              <span data-news-player-elapsed>{currentEpisode.elapsed}</span>
              <div class="news-player__bar">
                <span
                  data-news-player-progress
                  style={`width:${currentEpisode.progress};`}
                >
                </span>
              </div>
              <span data-news-player-runtime>{currentEpisode.runtime}</span>
            </div>

            <div class="news-player__controls" aria-label="Player controls">
              <button type="button" aria-label="Skip back 15 seconds">15</button
              >
              <button
                type="button"
                class="news-player__play"
                data-news-play
                aria-label="Pause briefing"
                aria-pressed="true"
              >
                <span aria-hidden="true"></span>
              </button>
              <button type="button" aria-label="Skip forward 15 seconds">
                15
              </button>
            </div>

            <div class="news-player__chapters" data-news-player-chapters>
              {currentEpisode.chapters.map(chapter => <span>{chapter}</span>)}
            </div>
          </article>
        </div>

        <aside class="news-builder" aria-label="Brief builder">
          <div class="news-builder__header">
            <p class="news-meta-kicker">Brief builder</p>
            <h2>Build your own briefing queue.</h2>
          </div>

          <div class="news-builder__topics" aria-label="Choose briefing topic">
            {
              briefingBuilder.map((brief, index) => (
                <button
                  type="button"
                  class:list={[
                    'news-builder-topic',
                    index === 0 && 'is-active',
                  ]}
                  data-news-brief-button
                  data-news-brief-beat={brief.beat}
                  data-news-brief-signal-value={brief.signal}
                  data-news-brief-question-value={brief.question}
                  data-news-brief-angle-value={brief.angle}
                  data-news-brief-actions-value={brief.actions.join('|')}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span>{brief.beat}</span>
                  <span aria-hidden="true" />
                </button>
              ))
            }
          </div>

          <div class="news-builder__segmented" aria-label="Brief duration">
            <button type="button">10 min</button>
            <button type="button" class="is-active">15 min</button>
            <button type="button">20 min</button>
          </div>

          <div class="news-builder__segmented" aria-label="Brief tone">
            <button type="button" class="is-active">Executive</button>
            <button type="button">Operator</button>
            <button type="button">Technical</button>
          </div>

          <article class="news-builder__receipt" aria-live="polite">
            <p class="news-meta-kicker">Brief receipt</p>
            <h3 data-news-brief-question>{currentBrief.question}</h3>
            <p data-news-brief-signal>{currentBrief.signal}</p>
            <p data-news-brief-angle>{currentBrief.angle}</p>
            <div class="news-brief-actions" data-news-brief-actions>
              {currentBrief.actions.map(action => <span>{action}</span>)}
            </div>
          </article>

          <ModernButton
            href={withBasePath('contact-hq/?brief=News%20briefing%20queue')}
            variant="gradient"
            className="news-builder__cta min-h-[48px]"
          >
            Build my briefing
          </ModernButton>
        </aside>
      </div>
    </div>
  </section>

  <RouteProofStrip
    label="Briefing standard"
    title="No fluff. Useful next move."
    note="The editorial route should clarify what changed, why it matters, and what to inspect next."
    items={proofItems}
    ctaHref={withBasePath('contact-hq/')}
    ctaLabel="Start fit check"
  />

  <section class="news-section" id="episodes" data-page-section>
    <div class="premium-container">
      <div class="news-dual-board">
        <div class="news-queue">
          <div class="news-panel-header">
            <div>
              <p class="news-meta-kicker">Listening queue</p>
              <h2>Up next in your queue.</h2>
            </div>
            <a href={withBasePath('blog/')} class="news-panel-link">
              View written notes
            </a>
          </div>

          <div class="news-episode-list">
            {
              episodes.map((episode, index) => (
                <article
                  class:list={['news-episode', index === 0 && 'is-active']}
                  data-news-episode
                  data-news-id={episode.id}
                >
                  <span class="news-episode__index">{index + 1}</span>
                  <div class="news-episode__receipt" aria-hidden="true">
                    <span>{episode.label.replace('Episode ', 'EP ')}</span>
                  </div>
                  <div class="news-episode__copy">
                    <p class="news-meta-kicker">
                      {episode.beat} / {episode.runtime}
                    </p>
                    <h3>{episode.title}</h3>
                    <p>{episode.copy}</p>
                  </div>
                  <div class="news-episode__wave" aria-hidden="true">
                    {Array.from({ length: 20 }).map((_, waveIndex) => (
                      <span style={`--wave:${16 + ((waveIndex * 13) % 38)}%`} />
                    ))}
                  </div>
                  <button
                    type="button"
                    class="news-episode__button"
                    data-news-load={episode.id}
                    data-news-label={episode.label}
                    data-news-title={episode.title}
                    data-news-copy={episode.copy}
                    data-news-runtime={episode.runtime}
                    data-news-elapsed={episode.elapsed}
                    data-news-beat={episode.beat}
                    data-news-tone={episode.tone}
                    data-news-progress={episode.progress}
                    data-news-chapters={episode.chapters.join('|')}
                    aria-label={`Load ${episode.title} in player`}
                  >
                    <span aria-hidden="true" />
                  </button>
                </article>
              ))
            }
          </div>
        </div>

        <div class="news-desk">
          <div class="news-panel-header">
            <div>
              <p class="news-meta-kicker">Live editorial desk</p>
              <h2>Today&apos;s beats from the operating desk.</h2>
            </div>
            <a href={withBasePath('blog/')} class="news-panel-link">
              See desk notes
            </a>
          </div>

          <div class="news-desk-grid">
            {
              newsDesk.map(item => (
                <article class="news-desk-card">
                  <span
                    class={`news-desk-card__icon is-${item.symbol}`}
                    aria-hidden="true"
                  />
                  <p class="news-meta-kicker">{item.beat}</p>
                  {item.notes.map(note => (
                    <p>{note}</p>
                  ))}
                  <small>Desk note / {item.time}</small>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="news-section" data-page-section>
    <div class="premium-container">
      <div class="news-advisory-board">
        <div class="news-advisory-main">
          <p class="news-meta-kicker">Advisory notes</p>
          <h2>Short notes worth acting on.</h2>
          <div class="news-advisory-grid">
            {
              advisories.map(item => (
                <article class="news-advisory-card">
                  <span aria-hidden="true">-</span>
                  <div>
                    <p class="news-meta-kicker">{item.topic}</p>
                    <h3>{item.title}</h3>
                    <p>{item.copy}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <aside class="news-approval" aria-label="Route-proof review">
          <p class="news-meta-kicker">Route-proof review</p>
          <strong>Approved</strong>
          <span>Operating desk</span>
        </aside>
      </div>
    </div>
  </section>

  <section class="news-section" data-page-section>
    <div class="premium-container">
      <div class="news-editorial-cta">
        <div class="news-editorial-cta__copy">
          <p class="news-meta-kicker">Your next editorial move</p>
          <h2>Keep learning, dig deeper, or start the conversation.</h2>
          <p>
            Good editorial systems create momentum. They should point a reader
            toward a checklist, a proof route, or a better question for the next
            meeting.
          </p>
        </div>

        <div class="news-editorial-cta__grid">
          {
            editorialActions.map(action => (
              <a href={action.href} class="news-editorial-link">
                <span aria-hidden="true" />
                <div>
                  <h3>{action.title}</h3>
                  <p>{action.copy}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const initNewsPlayer = () => {
      const playerTitle = document.querySelector('[data-news-player-title]');
      const playerCopy = document.querySelector('[data-news-player-copy]');
      const playerRuntime = document.querySelector(
        '[data-news-player-runtime]'
      );
      const playerElapsed = document.querySelector(
        '[data-news-player-elapsed]'
      );
      const playerProgress = document.querySelector(
        '[data-news-player-progress]'
      );
      const playerChapters = document.querySelector(
        '[data-news-player-chapters]'
      );
      const ticketTitle = document.querySelector('[data-news-ticket-title]');
      const ticketCopy = document.querySelector('[data-news-ticket-copy]');
      const ticketLabel = document.querySelector('[data-news-ticket-label]');
      const ticketRuntime = document.querySelector(
        '[data-news-ticket-runtime]'
      );
      const ticketTone = document.querySelector('[data-news-ticket-tone]');
      const loadButtons = Array.from(
        document.querySelectorAll('[data-news-load]')
      );
      const cards = Array.from(
        document.querySelectorAll('[data-news-episode]')
      );
      const playButton = document.querySelector('[data-news-play]');

      if (
        !(playerTitle instanceof HTMLElement) ||
        !(playerChapters instanceof HTMLElement)
      ) {
        return;
      }

      if (playerTitle.dataset.newsBound === 'true') {
        return;
      }

      playerTitle.dataset.newsBound = 'true';

      const syncActiveCard = id => {
        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;
          card.classList.toggle('is-active', card.dataset.newsId === id);
        });
      };

      loadButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const id = button.dataset.newsLoad || '';
          const chapters = (button.dataset.newsChapters || '')
            .split('|')
            .filter(Boolean);

          playerTitle.textContent = button.dataset.newsTitle || '';
          if (playerCopy instanceof HTMLElement) {
            playerCopy.textContent = button.dataset.newsCopy || '';
          }
          if (playerRuntime instanceof HTMLElement) {
            playerRuntime.textContent = button.dataset.newsRuntime || '';
          }
          if (playerElapsed instanceof HTMLElement) {
            playerElapsed.textContent = button.dataset.newsElapsed || '';
          }
          if (playerProgress instanceof HTMLElement) {
            playerProgress.style.width = button.dataset.newsProgress || '0%';
          }
          if (ticketTitle instanceof HTMLElement) {
            ticketTitle.textContent = button.dataset.newsTitle || '';
          }
          if (ticketCopy instanceof HTMLElement) {
            ticketCopy.textContent = button.dataset.newsCopy || '';
          }
          if (ticketLabel instanceof HTMLElement) {
            ticketLabel.textContent = button.dataset.newsLabel || '';
          }
          if (ticketRuntime instanceof HTMLElement) {
            ticketRuntime.textContent = button.dataset.newsRuntime || '';
          }
          if (ticketTone instanceof HTMLElement) {
            ticketTone.textContent = button.dataset.newsTone || '';
          }

          playerChapters.replaceChildren();
          chapters.forEach(chapter => {
            const chip = document.createElement('span');
            chip.textContent = chapter;
            playerChapters.appendChild(chip);
          });

          syncActiveCard(id);
        });
      });

      if (playButton instanceof HTMLButtonElement) {
        playButton.addEventListener('click', () => {
          const isPlaying = playButton.getAttribute('aria-pressed') === 'true';
          playButton.setAttribute('aria-pressed', String(!isPlaying));
          playButton.setAttribute(
            'aria-label',
            isPlaying ? 'Play briefing' : 'Pause briefing'
          );
          playButton.classList.toggle('is-paused', isPlaying);
        });
      }
    };

    const initNewsBriefBuilder = () => {
      const buttons = Array.from(
        document.querySelectorAll('[data-news-brief-button]')
      );
      const question = document.querySelector('[data-news-brief-question]');
      const signal = document.querySelector('[data-news-brief-signal]');
      const angle = document.querySelector('[data-news-brief-angle]');
      const actions = document.querySelector('[data-news-brief-actions]');

      if (
        !(question instanceof HTMLElement) ||
        !(signal instanceof HTMLElement) ||
        !(angle instanceof HTMLElement) ||
        !(actions instanceof HTMLElement)
      ) {
        return;
      }

      if (question.dataset.newsBriefBound === 'true') {
        return;
      }

      question.dataset.newsBriefBound = 'true';

      buttons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          buttons.forEach(item => {
            if (!(item instanceof HTMLButtonElement)) return;
            const isActive = item === button;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', String(isActive));
          });

          question.textContent = button.dataset.newsBriefQuestionValue || '';
          signal.textContent = button.dataset.newsBriefSignalValue || '';
          angle.textContent = button.dataset.newsBriefAngleValue || '';
          actions.replaceChildren();

          (button.dataset.newsBriefActionsValue || '')
            .split('|')
            .filter(Boolean)
            .forEach(action => {
              const chip = document.createElement('span');
              chip.textContent = action;
              actions.appendChild(chip);
            });
        });
      });
    };

    const initSegmentedControls = () => {
      document.querySelectorAll('.news-builder__segmented').forEach(control => {
        if (!(control instanceof HTMLElement)) return;
        if (control.dataset.newsSegmentedBound === 'true') return;
        control.dataset.newsSegmentedBound = 'true';
        control.querySelectorAll('button').forEach(button => {
          button.addEventListener('click', () => {
            control
              .querySelectorAll('button')
              .forEach(item =>
                item.classList.toggle('is-active', item === button)
              );
          });
        });
      });
    };

    const initNewsPage = () => {
      initNewsPlayer();
      initNewsBriefBuilder();
      initSegmentedControls();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNewsPage, {
        once: true,
      });
    } else {
      initNewsPage();
    }

    document.addEventListener('astro:page-load', initNewsPage);
  })();
</script>

<style is:inline>
  .news-hero,
  .news-section {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .news-hero {
    padding: clamp(3.4rem, 6vw, 5rem) 0 clamp(2.25rem, 4.5vw, 3.5rem);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 72%, transparent),
        transparent 58%
      ),
      linear-gradient(
        115deg,
        transparent 0 42%,
        color-mix(in srgb, var(--color-primary) 8%, transparent) 42% 68%,
        transparent 68% 100%
      );
  }

  .news-section {
    padding: clamp(3.75rem, 7vw, 5.75rem) 0;
  }

  .news-hero__topline,
  .news-hero__grid,
  .news-hero__copy,
  .news-hero__studio,
  .news-builder,
  .news-builder__header,
  .news-builder__topics,
  .news-builder__receipt,
  .news-dual-board,
  .news-queue,
  .news-desk,
  .news-episode-list,
  .news-desk-grid,
  .news-advisory-board,
  .news-advisory-main,
  .news-advisory-grid,
  .news-editorial-cta,
  .news-editorial-cta__grid {
    display: grid;
    gap: 1rem;
  }

  .news-hero__topline {
    grid-template-columns: 1fr;
    margin-bottom: clamp(1.15rem, 2vw, 1.65rem);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    color: color-mix(in srgb, var(--color-text-secondary) 88%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-hero__topline span:first-child {
    color: color-mix(in srgb, var(--color-primary) 82%, white 8%);
  }

  .news-hero__copy {
    align-content: center;
  }

  .news-hero__copy .tone-page-title {
    max-width: 11.8ch;
  }

  .news-hero__copy .tone-page-copy {
    max-width: 43rem;
  }

  .news-hero__actions,
  .news-hero__signals,
  .news-player__timeline,
  .news-player__controls,
  .news-player__chapters,
  .news-ticket__meta,
  .news-builder__segmented,
  .news-brief-actions,
  .news-panel-header,
  .news-editorial-link {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .news-hero__signals span,
  .news-player,
  .news-builder,
  .news-queue,
  .news-desk,
  .news-advisory-board,
  .news-editorial-cta {
    border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
    border-radius: 8px;
  }

  .news-hero__signals span {
    min-height: 2.25rem;
    align-content: center;
    padding: 0.25rem 0.75rem;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: 0.82rem;
  }

  .news-hero__studio {
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    align-items: start;
  }

  .news-meta-kicker,
  .news-ticket__meta,
  .news-player__timeline,
  .news-episode__index,
  .news-episode__receipt,
  .news-desk-card small,
  .news-approval span,
  .news-panel-link {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .news-ticket,
  .news-builder,
  .news-builder__receipt,
  .news-approval {
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 3.05rem,
        color-mix(in srgb, var(--color-ink) 8%, transparent) 3.05rem
          calc(3.05rem + 1px)
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, white 72%, var(--color-paper) 28%),
        var(--color-paper)
      );
    color: var(--color-ink);
  }

  .news-ticket {
    position: relative;
    display: grid;
    gap: 0.75rem;
    min-height: auto;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 8px;
    box-shadow: 0 24px 58px -46px rgba(0, 0, 0, 0.78);
  }

  .news-ticket h2,
  .news-builder h2,
  .news-builder__receipt h3,
  .news-player h2,
  .news-panel-header h2,
  .news-episode h3,
  .news-desk-card p,
  .news-advisory-main h2,
  .news-advisory-card h3,
  .news-editorial-cta h2,
  .news-editorial-link h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 690;
    letter-spacing: 0;
    line-height: 1.05;
    text-wrap: balance;
  }

  .news-ticket h2,
  .news-builder h2,
  .news-builder__receipt h3,
  .news-approval strong {
    color: var(--color-ink);
  }

  .news-ticket h2 {
    font-size: clamp(1.28rem, 1.9vw, 1.72rem);
    line-height: 1.08;
  }

  .news-builder h2 {
    font-size: clamp(1.38rem, 1.8vw, 1.85rem);
    line-height: 1.08;
  }

  .news-builder__receipt h3 {
    font-size: clamp(1.05rem, 1.25vw, 1.32rem);
    line-height: 1.14;
  }

  .news-advisory-card h3 {
    font-size: clamp(1.16rem, 1.9vw, 1.55rem);
    line-height: 1.08;
  }

  .news-ticket p:not(.news-meta-kicker),
  .news-builder__header,
  .news-builder__receipt p,
  .news-approval span {
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    line-height: 1.58;
  }

  .news-ticket p:not(.news-meta-kicker),
  .news-builder__receipt p {
    font-size: 0.92rem;
    line-height: 1.52;
  }

  .news-ticket__stamp {
    justify-self: start;
    transform: rotate(-9deg);
    border: 2px solid
      color-mix(in srgb, var(--color-status-review) 80%, black 8%);
    padding: 0.28rem 0.5rem;
    color: color-mix(in srgb, var(--color-status-review) 80%, black 8%);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 860;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-ticket__barcode {
    height: 1.6rem;
    margin-top: auto;
    background: repeating-linear-gradient(
      90deg,
      var(--color-ink) 0 2px,
      transparent 2px 5px,
      var(--color-ink) 5px 6px,
      transparent 6px 10px
    );
    opacity: 0.78;
  }

  .news-player,
  .news-queue,
  .news-desk,
  .news-advisory-board,
  .news-editorial-cta {
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  }

  .news-player {
    display: grid;
    gap: 0.85rem;
    align-content: center;
    padding: 1rem;
  }

  .news-player h2 {
    color: var(--color-text-primary);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .news-player p,
  .news-episode p,
  .news-desk-card p,
  .news-advisory-card p,
  .news-editorial-cta p,
  .news-editorial-link p {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
    line-height: 1.65;
  }

  .news-live-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: var(--color-primary);
  }

  .news-waveform,
  .news-episode__wave {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.18rem;
  }

  .news-waveform {
    min-height: 3.3rem;
    padding-block: 0.35rem;
  }

  .news-waveform span,
  .news-episode__wave span {
    width: 2px;
    height: var(--wave);
    min-height: 0.45rem;
    background: color-mix(
      in srgb,
      var(--color-text-secondary) 40%,
      transparent
    );
  }

  .news-waveform span:nth-child(5n),
  .news-episode__wave span:nth-child(4n) {
    background: color-mix(in srgb, var(--color-primary) 62%, transparent);
  }

  .news-player__timeline {
    align-items: center;
  }

  .news-player__bar {
    position: relative;
    flex: 1 1 11rem;
    height: 0.32rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-border) 78%, transparent);
  }

  .news-player__bar span {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--color-primary);
    transition: width 0.25s ease;
  }

  .news-player__controls {
    align-items: center;
    justify-content: center;
  }

  .news-player__controls button,
  .news-episode__button,
  .news-builder-topic,
  .news-builder__segmented button {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 86%, transparent);
  }

  .news-player__controls button {
    display: inline-flex;
    width: 2.8rem;
    min-width: 44px;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .news-player__controls .news-player__play {
    width: 3.55rem;
    height: 3.55rem;
    border-color: color-mix(in srgb, var(--color-primary) 48%, transparent);
    background:
      radial-gradient(
        circle at 45% 38%,
        color-mix(in srgb, white 18%, transparent),
        transparent 34%
      ),
      color-mix(in srgb, var(--color-primary) 76%, black 12%);
    color: var(--color-text-inverse);
  }

  .news-player__play span,
  .news-player__play span::after {
    display: block;
    width: 0.3rem;
    height: 1.2rem;
    background: currentColor;
    content: '';
  }

  .news-player__play span {
    position: relative;
    transform: translateX(-0.22rem);
  }

  .news-player__play span::after {
    position: absolute;
    left: 0.58rem;
    top: 0;
  }

  .news-player__play.is-paused span {
    width: 0;
    height: 0;
    border-top: 0.72rem solid transparent;
    border-bottom: 0.72rem solid transparent;
    border-left: 1rem solid currentColor;
    background: transparent;
    transform: translateX(0.12rem);
  }

  .news-player__play.is-paused span::after {
    content: none;
  }

  .news-player__chapters span,
  .news-brief-actions span,
  .news-builder__segmented button {
    display: inline-flex;
    min-height: 1.9rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 999px;
    padding: 0 0.72rem;
    color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
    font-size: 0.78rem;
  }

  .news-builder {
    padding: 1rem;
    border-color: color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .news-builder__topics {
    gap: 0.55rem;
  }

  .news-builder-topic {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    border-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, white 24%, transparent);
    color: var(--color-ink);
    padding: 0.55rem 0.7rem;
    text-align: left;
  }

  .news-builder-topic > span:first-child {
    font-weight: 700;
  }

  .news-builder-topic > span:last-child {
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 44%, transparent);
    border-radius: 2px;
  }

  .news-builder-topic.is-active > span:last-child {
    border-color: color-mix(in srgb, var(--color-primary) 82%, black 8%);
    background:
      linear-gradient(135deg, transparent 46%, white 47% 53%, transparent 54%),
      color-mix(in srgb, var(--color-primary) 82%, black 8%);
  }

  .news-builder__segmented {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .news-builder__segmented button {
    border-radius: 4px;
    border-color: color-mix(in srgb, var(--color-ink) 18%, transparent);
    background: color-mix(in srgb, white 18%, transparent);
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
  }

  .news-builder__segmented button.is-active {
    background: color-mix(in srgb, var(--color-primary) 72%, black 10%);
    color: var(--color-text-inverse);
  }

  .news-builder__receipt {
    gap: 0.55rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 24%, transparent);
    padding-top: 0.85rem;
  }

  .news-builder__receipt .news-brief-actions {
    gap: 0.42rem;
  }

  .news-builder__receipt .news-brief-actions span {
    min-height: 1.72rem;
    border-color: color-mix(in srgb, var(--color-ink) 22%, transparent);
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
    padding: 0 0.55rem;
    font-size: 0.72rem;
  }

  .news-builder__cta {
    width: 100%;
  }

  .news-dual-board {
    align-items: stretch;
  }

  .news-queue,
  .news-desk,
  .news-advisory-board,
  .news-editorial-cta {
    padding: 1rem;
  }

  .news-panel-header {
    align-items: start;
    justify-content: space-between;
  }

  .news-panel-header h2,
  .news-advisory-main h2,
  .news-editorial-cta h2 {
    color: var(--color-text-primary);
    font-size: clamp(1.4rem, 3vw, 2.25rem);
  }

  .news-panel-link {
    color: color-mix(in srgb, var(--color-primary) 76%, white 10%);
    text-decoration: none;
  }

  .news-episode {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) minmax(7rem, 0.26fr) auto;
    gap: 0.8rem;
    align-items: center;
    min-width: 0;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    padding: 0.85rem 0;
  }

  .news-episode.is-active {
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }

  .news-episode__index {
    color: var(--color-text-primary);
  }

  .news-episode__receipt {
    display: grid;
    width: 3.5rem;
    aspect-ratio: 0.72;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    border-radius: 4px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, white 70%, var(--color-paper) 30%),
      var(--color-paper)
    );
    color: var(--color-ink);
    text-align: center;
  }

  .news-episode__copy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .news-episode h3 {
    color: var(--color-text-primary);
    font-size: 1.02rem;
  }

  .news-episode__button {
    display: inline-grid;
    width: 2.75rem;
    min-width: 44px;
    height: 2.75rem;
    place-items: center;
    border-radius: 999px;
  }

  .news-episode__button span {
    width: 0;
    height: 0;
    border-top: 0.45rem solid transparent;
    border-bottom: 0.45rem solid transparent;
    border-left: 0.7rem solid currentColor;
    transform: translateX(0.08rem);
  }

  .news-desk-grid {
    grid-template-columns: 1fr;
  }

  .news-desk-card {
    display: grid;
    gap: 0.75rem;
    min-height: 13rem;
    border-left: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
    padding: 0.75rem;
  }

  .news-desk-card__icon {
    width: 1.45rem;
    height: 1.45rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 50%, transparent);
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .news-desk-card__icon.is-shield {
    clip-path: polygon(50% 0, 92% 16%, 82% 76%, 50% 100%, 18% 76%, 8% 16%);
  }

  .news-desk-card__icon.is-grid {
    background:
      linear-gradient(
        90deg,
        transparent 46%,
        var(--color-surface) 47% 53%,
        transparent 54%
      ),
      linear-gradient(
        0deg,
        transparent 46%,
        var(--color-surface) 47% 53%,
        transparent 54%
      ),
      color-mix(in srgb, var(--color-primary) 28%, transparent);
  }

  .news-desk-card__icon.is-gear {
    border-radius: 999px;
  }

  .news-desk-card__icon.is-flow {
    border-radius: 4px;
    transform: rotate(45deg);
  }

  .news-desk-card p:not(.news-meta-kicker) {
    color: var(--color-text-primary);
    font-size: 0.96rem;
  }

  .news-desk-card small {
    margin-top: auto;
  }

  .news-advisory-board {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-paper) 82%, white 18%),
      color-mix(in srgb, var(--color-paper) 72%, white 28%)
    );
    color: var(--color-ink);
  }

  .news-advisory-main h2,
  .news-advisory-card h3 {
    color: var(--color-ink);
  }

  .news-advisory-main .news-meta-kicker,
  .news-advisory-card .news-meta-kicker {
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
  }

  .news-advisory-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    padding-top: 0.95rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .news-advisory-card > span {
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
  }

  .news-advisory-card p:not(.news-meta-kicker) {
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .news-approval {
    display: grid;
    gap: 0.8rem;
    align-content: center;
    justify-items: center;
    border-left: 1px dashed
      color-mix(in srgb, var(--color-ink) 22%, transparent);
    padding: 1rem;
    text-align: center;
  }

  .news-approval strong {
    border: 2px solid
      color-mix(in srgb, var(--color-status-review) 78%, black 8%);
    padding: 0.45rem 1rem;
    color: color-mix(in srgb, var(--color-status-review) 78%, black 8%);
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .news-editorial-cta {
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-primary) 6%, transparent),
        transparent 42%
      ),
      color-mix(in srgb, var(--color-surface) 88%, transparent);
  }

  .news-editorial-cta__copy {
    display: grid;
    gap: 0.55rem;
  }

  .news-editorial-link {
    align-items: start;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    padding-top: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  .news-editorial-link > span {
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 42%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .news-editorial-link h3 {
    color: color-mix(in srgb, var(--color-primary) 82%, white 10%);
    font-size: 1.02rem;
  }

  @media (min-width: 900px) {
    .news-hero__topline {
      grid-template-columns: 1fr auto;
    }

    .news-hero__grid {
      grid-template-columns: minmax(24rem, 0.95fr) minmax(31rem, 1.15fr) minmax(
          18rem,
          0.7fr
        );
      align-items: start;
    }

    .news-dual-board {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    }

    .news-desk-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .news-advisory-board {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.28fr);
    }

    .news-advisory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .news-editorial-cta {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  @media (max-width: 1120px) {
    .news-hero__studio {
      grid-template-columns: 1fr;
    }

    .news-ticket {
      min-height: auto;
    }
  }

  @media (max-width: 760px) {
    .news-hero {
      padding-top: 2.4rem;
    }

    .news-hero__copy .tone-page-title {
      max-width: 10.6ch;
    }

    .news-hero__studio {
      grid-template-columns: minmax(8rem, 0.72fr) minmax(0, 1fr);
      gap: 0.65rem;
    }

    .news-ticket,
    .news-player,
    .news-builder {
      padding: 0.8rem;
    }

    .news-ticket p:not(.news-meta-kicker),
    .news-ticket__stamp,
    .news-ticket__barcode {
      display: none;
    }

    .news-ticket h2 {
      font-size: clamp(1rem, 5.2vw, 1.34rem);
    }

    .news-ticket__meta,
    .news-player__chapters,
    .news-waveform {
      gap: 0.38rem;
    }

    .news-player h2 {
      font-size: clamp(1.08rem, 5.4vw, 1.42rem);
    }

    .news-player p:not(.news-meta-kicker),
    .news-player__chapters span {
      font-size: 0.76rem;
      line-height: 1.45;
    }

    .news-player__controls {
      justify-content: start;
    }

    .news-player__controls button {
      width: 2.35rem;
      min-width: 44px;
      height: 2.35rem;
    }

    .news-player__controls .news-player__play {
      width: 3rem;
      height: 3rem;
    }

    .news-builder h2 {
      max-width: 12ch;
      font-size: clamp(1.35rem, 8vw, 1.9rem);
    }

    .news-builder__topics {
      gap: 0.45rem;
    }

    .news-builder-topic,
    .news-builder__segmented button {
      font-size: 0.82rem;
    }

    .news-hero__actions .modern-button,
    .news-builder__cta {
      width: 100%;
