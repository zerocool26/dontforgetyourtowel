---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ResourceDecisionTools from '../components/business/ResourceDecisionTools.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { withBasePath } from '../utils/helpers';

const episodes = [
  {
    id: 'episode-01',
    label: 'Episode 01',
    title: 'The first 30 days after switching IT providers',
    copy: 'What should get mapped, what should be stabilized, and how leadership can tell whether the handoff is working.',
    runtime: '18 min',
    progress: '38%',
    beat: 'Operations',
    chapters: ['Operating map', 'Stabilize first', 'Monthly reporting'],
  },
  {
    id: 'episode-02',
    label: 'Episode 02',
    title: 'Microsoft 365 cleanup without turning it into a committee',
    copy: 'Teams, SharePoint, guest access, retention, and backup decisions that make the tenant easier to govern.',
    runtime: '22 min',
    progress: '54%',
    beat: 'Microsoft 365',
    chapters: [
      'Ownership rules',
      'Retention vs backup',
      'Repeatable clean state',
    ],
  },
  {
    id: 'episode-03',
    label: 'Episode 03',
    title: 'Security baseline before the shiny security stack',
    copy: 'Identity, endpoint, email, backup, and response habits that should be visible before larger projects begin.',
    runtime: '16 min',
    progress: '31%',
    beat: 'Security',
    chapters: ['Identity first', 'Email + endpoint', 'Backup + response'],
  },
];

const advisories = [
  {
    topic: 'Buyer note',
    title: 'Ask for ownership, not just tool names.',
    copy: 'The most useful provider conversations clarify who owns support, vendors, patching, reporting, escalation, backup testing, and security evidence.',
  },
  {
    topic: 'Operations',
    title: 'Recurring tickets are a roadmap signal.',
    copy: 'If the same issues keep returning, the problem is usually process, policy, endpoint standards, or an application workflow that needs attention.',
  },
  {
    topic: 'Workflow systems',
    title: 'A portal or intake path should prove the real handoff.',
    copy: 'For portals and intake flows, review routing, trust cues, form friction, mobile behavior, ownership, and status feedback before approving a build plan.',
  },
];

const newsDesk = [
  {
    beat: 'Security',
    note: 'Identity hardening, token theft, phishing controls, cyber insurance questionnaires, backup proof, and incident-response rehearsal.',
  },
  {
    beat: 'Microsoft 365',
    note: 'Tenant cleanup, SharePoint lifecycle, Teams sprawl, guest access, retention, licensing, and Microsoft 365 backup expectations.',
  },
  {
    beat: 'Operations',
    note: 'Help desk response patterns, recurring-ticket reduction, onboarding/offboarding, vendor ownership, endpoint refresh, and executive reporting.',
  },
  {
    beat: 'Workflow trust',
    note: 'Portals, intake paths, service pages, forms, status feedback, analytics, proof cues, and mobile conversion paths.',
  },
];

const briefingBuilder = [
  {
    beat: 'Operations',
    signal:
      'Recurring tickets are becoming a management issue, not a help desk issue.',
    question: 'Which recurring support pattern should become roadmap work?',
    angle:
      'Turn noisy ticket history into an executive brief about ownership, standards, and the first operating fix.',
    actions: [
      'Review ticket themes',
      'Name the owner',
      'Publish the first fix',
    ],
  },
  {
    beat: 'Security',
    signal: 'Insurance and leadership are asking for proof, not tool names.',
    question: 'Which control can be evidenced this month?',
    angle:
      'Frame identity, endpoint, email, and backup controls as evidence habits rather than abstract security spend.',
    actions: [
      'Check MFA posture',
      'Verify backup proof',
      'Document response path',
    ],
  },
  {
    beat: 'Microsoft 365',
    signal: 'Collaboration sprawl is making normal work harder to govern.',
    question: 'Which Teams or SharePoint rule would remove the most confusion?',
    angle:
      'Show how tenant cleanup improves speed, access confidence, search, retention, and everyday operating clarity.',
    actions: ['Map guest access', 'Review stale sites', 'Set lifecycle rules'],
  },
  {
    beat: 'Workflow systems',
    signal:
      'The client-facing path is not keeping up with the service quality.',
    question: 'Which handoff most affects trust or conversion?',
    angle:
      'Connect visual craft to the actual service path: mobile clarity, proof, intake, status feedback, and follow-through.',
    actions: ['Audit mobile path', 'Find proof gaps', 'Prototype the handoff'],
  },
];

const editorialActions = [
  {
    title: 'Read the blog',
    copy: 'Turn short-form signals into fuller written guidance and practical checklists.',
    href: withBasePath('blog/'),
  },
  {
    title: 'Review the proof',
    copy: 'Pair the editorial commentary with the trust, backup, response, and customer-excellence proof route.',
    href: withBasePath('trust-center/'),
  },
  {
    title: 'Scope the work',
    copy: 'When the editorial direction is clear, move into an actual intake conversation.',
    href: withBasePath('contact-hq/'),
  },
];
---

<MarketingLayout
  title="News + Podcast | CHICAGOS #1 MSP"
  description="Editorial desk and podcast-style briefings on managed IT, security, Microsoft 365, operations, service ownership, and workflow systems."
  bodyClass="creative-page"
  mainClass="relative isolate overflow-x-clip"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'CHICAGOS #1 MSP News and Podcast',
      description:
        'Short editorial signals and podcast-style briefings about managed IT, security, Microsoft 365, service ownership, and workflow systems.',
    }}
  />

  <section class="news-hero" data-page-section>
    <div class="premium-container">
      <div class="news-hero__grid">
        <div class="tone-page-header">
          <p class="tone-page-eyebrow">News + podcast</p>
          <h1 class="tone-page-title">
            Short briefings on technology shifts that affect real operations.
          </h1>
          <p class="tone-page-copy">
            Security requirements, Microsoft 365 changes, workflow pressure,
            support operations, and client-facing service paths move quickly.
            This desk turns the change into practical notes for operators and
            owners.
          </p>

          <div class="tone-page-actions">
            <ModernButton
              href="#episodes"
              variant="gradient"
              className="min-h-[52px]"
            >
              Browse episodes
            </ModernButton>
            <ModernButton
              href={withBasePath('blog/')}
              variant="outline"
              className="min-h-[52px]"
            >
              Read the blog
            </ModernButton>
          </div>
        </div>

        <article
          class="news-player tone-panel-soft"
          aria-label="Featured podcast episode"
        >
          <div class="news-player__headline">
            <p class="news-meta-kicker" data-news-player-label>
              {episodes[0].label}
            </p>
            <h2 data-news-player-title>{episodes[0].title}</h2>
            <p data-news-player-copy>{episodes[0].copy}</p>
          </div>
          <div class="news-player__bar">
            <span
              data-news-player-progress
              style={`width:${episodes[0].progress};`}></span>
          </div>
          <div class="news-player__meta">
            <span data-news-player-runtime>{episodes[0].runtime}</span>
            <span data-news-player-beat>{episodes[0].beat}</span>
          </div>
          <div class="news-player__chapters" data-news-player-chapters>
            {episodes[0].chapters.map(chapter => <span>{chapter}</span>)}
          </div>
        </article>
      </div>
    </div>
  </section>

  <ResourceDecisionTools
    compact
    eyebrow="Decision tools"
    title="Turn a briefing into the next useful checklist."
    description="Use the editorial beat to choose a worksheet for provider switching, recovery, Microsoft 365 cleanup, cyber-insurance evidence, or first-month MSP transition."
  />

  <section class="news-section" id="episodes" data-page-section>
    <div class="premium-container">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Listening queue</p>
        <h2 class="tone-section-title">
          Pick a briefing and get the useful version fast.
        </h2>
      </div>

      <div class="news-episode-list">
        {
          episodes.map((episode, index) => (
            <article
              class:list={['news-episode', index === 0 && 'is-active']}
              data-news-episode
              data-news-id={episode.id}
            >
              <div class="news-episode__meta">
                <span>{episode.label}</span>
                <span>{episode.runtime}</span>
              </div>
              <h3>{episode.title}</h3>
              <p>{episode.copy}</p>
              <div class="news-episode__footer">
                <span>{episode.beat}</span>
                <button
                  type="button"
                  class="news-episode__button"
                  data-news-load={episode.id}
                  data-news-label={episode.label}
                  data-news-title={episode.title}
                  data-news-copy={episode.copy}
                  data-news-runtime={episode.runtime}
                  data-news-beat={episode.beat}
                  data-news-progress={episode.progress}
                  data-news-chapters={episode.chapters.join('|')}
                >
                  Load in player
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="news-section" id="brief-builder" data-page-section>
    <div class="premium-container">
      <div class="news-brief-shell tone-panel-soft">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Brief builder</p>
          <h2 class="tone-section-title">
            Turn a topic into an operator briefing.
          </h2>
          <p class="tone-section-copy">
            Switch between the beats that tend to affect budget, risk,
            insurance, workflow, and buyer confidence.
          </p>
        </div>

        <div class="news-brief-controls" aria-label="Choose a briefing beat">
          {
            briefingBuilder.map((brief, index) => (
              <button
                type="button"
                class:list={['news-brief-button', index === 0 && 'is-active']}
                data-news-brief-button
                data-news-brief-beat={brief.beat}
                data-news-brief-signal={brief.signal}
                data-news-brief-question={brief.question}
                data-news-brief-angle={brief.angle}
                data-news-brief-actions={brief.actions.join('|')}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {brief.beat}
              </button>
            ))
          }
        </div>

        <article class="news-brief-panel" aria-live="polite">
          <p class="news-meta-kicker" data-news-brief-active-beat>
            {briefingBuilder[0].beat}
          </p>
          <h3 data-news-brief-question>{briefingBuilder[0].question}</h3>
          <p data-news-brief-signal>{briefingBuilder[0].signal}</p>
          <p data-news-brief-angle>{briefingBuilder[0].angle}</p>
          <div class="news-brief-actions" data-news-brief-actions>
            {briefingBuilder[0].actions.map(action => <span>{action}</span>)}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="news-section" data-page-section>
    <div class="premium-container">
      <div class="news-advisory-shell tone-panel-soft">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Advisory notes</p>
          <h2 class="tone-section-title">Short notes worth acting on.</h2>
        </div>

        <div class="news-advisory-grid">
          {
            advisories.map(item => (
              <article class="news-advisory-card">
                <p class="news-meta-kicker">{item.topic}</p>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="news-section" data-page-section>
    <div class="premium-container">
      <div class="news-desk-shell">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Editorial desk</p>
          <h2 class="tone-section-title">
            Follow the beats that change budget, ownership, or buyer confidence.
          </h2>
        </div>

        <div class="news-desk-grid">
          {
            newsDesk.map(item => (
              <article class="news-desk-card tone-panel-soft">
                <p class="news-meta-kicker">{item.beat}</p>
                <p>{item.note}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="news-section" data-page-section>
    <div class="premium-container">
      <div class="news-editorial-cta tone-panel-soft">
        <div>
          <p class="news-meta-kicker">Next editorial move</p>
          <h2>
            Connect the short-form signals to written guidance, live proof, or
            an actual scoped conversation.
          </h2>
          <p>
            Good editorial systems create momentum. They should point a reader
            toward a checklist, a scope decision, or a better question for the
            next meeting.
          </p>
        </div>

        <div class="news-editorial-cta__grid">
          {
            editorialActions.map(action => (
              <a href={action.href} class="news-editorial-link">
                <h3>{action.title}</h3>
                <p>{action.copy}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<script is:inline>
  (() => {
    const initNewsPlayer = () => {
      const playerTitle = document.querySelector('[data-news-player-title]');
      const playerLabel = document.querySelector('[data-news-player-label]');
      const playerCopy = document.querySelector('[data-news-player-copy]');
      const playerRuntime = document.querySelector(
        '[data-news-player-runtime]'
      );
      const playerBeat = document.querySelector('[data-news-player-beat]');
      const playerProgress = document.querySelector(
        '[data-news-player-progress]'
      );
      const playerChapters = document.querySelector(
        '[data-news-player-chapters]'
      );
      const loadButtons = Array.from(
        document.querySelectorAll('[data-news-load]')
      );
      const cards = Array.from(
        document.querySelectorAll('[data-news-episode]')
      );

      if (
        !(playerTitle instanceof HTMLElement) ||
        !(playerChapters instanceof HTMLElement)
      ) {
        return;
      }

      if (playerTitle.dataset.newsBound === 'true') {
        return;
      }

      playerTitle.dataset.newsBound = 'true';

      const syncActiveCard = id => {
        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;
          card.classList.toggle('is-active', card.dataset.newsId === id);
        });
      };

      loadButtons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          const id = button.dataset.newsLoad || '';
          const chapters = (button.dataset.newsChapters || '')
            .split('|')
            .filter(Boolean);

          if (playerLabel instanceof HTMLElement) {
            playerLabel.textContent = button.dataset.newsLabel || '';
          }
          playerTitle.textContent = button.dataset.newsTitle || '';
          if (playerCopy instanceof HTMLElement) {
            playerCopy.textContent = button.dataset.newsCopy || '';
          }
          if (playerRuntime instanceof HTMLElement) {
            playerRuntime.textContent = button.dataset.newsRuntime || '';
          }
          if (playerBeat instanceof HTMLElement) {
            playerBeat.textContent = button.dataset.newsBeat || '';
          }
          if (playerProgress instanceof HTMLElement) {
            playerProgress.style.width = button.dataset.newsProgress || '0%';
          }

          playerChapters.replaceChildren();
          chapters.forEach(chapter => {
            const chip = document.createElement('span');
            chip.textContent = chapter;
            playerChapters.appendChild(chip);
          });

          syncActiveCard(id);
        });
      });
    };

    const initNewsBriefBuilder = () => {
      const buttons = Array.from(
        document.querySelectorAll('[data-news-brief-button]')
      );
      const activeBeat = document.querySelector(
        '[data-news-brief-active-beat]'
      );
      const question = document.querySelector('[data-news-brief-question]');
      const signal = document.querySelector('[data-news-brief-signal]');
      const angle = document.querySelector('[data-news-brief-angle]');
      const actions = document.querySelector('[data-news-brief-actions]');

      if (
        !(activeBeat instanceof HTMLElement) ||
        !(question instanceof HTMLElement) ||
        !(signal instanceof HTMLElement) ||
        !(angle instanceof HTMLElement) ||
        !(actions instanceof HTMLElement)
      ) {
        return;
      }

      if (activeBeat.dataset.newsBriefBound === 'true') {
        return;
      }

      activeBeat.dataset.newsBriefBound = 'true';

      buttons.forEach(button => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          buttons.forEach(item => {
            if (!(item instanceof HTMLButtonElement)) return;
            const isActive = item === button;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', String(isActive));
          });

          activeBeat.textContent = button.dataset.newsBriefBeat || '';
          question.textContent = button.dataset.newsBriefQuestion || '';
          signal.textContent = button.dataset.newsBriefSignal || '';
          angle.textContent = button.dataset.newsBriefAngle || '';
          actions.replaceChildren();

          (button.dataset.newsBriefActions || '')
            .split('|')
            .filter(Boolean)
            .forEach(action => {
              const chip = document.createElement('span');
              chip.textContent = action;
              actions.appendChild(chip);
            });
        });
      });
    };

    const initNewsPage = () => {
      initNewsPlayer();
      initNewsBriefBuilder();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNewsPage, {
        once: true,
      });
    } else {
      initNewsPage();
    }

    document.addEventListener('astro:page-load', initNewsPage);
  })();
</script>

<style is:inline>
  .news-hero,
  .news-section {
    padding: clamp(4.25rem, 8vw, 6.75rem) 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 70%, transparent);
  }

  .news-hero {
    padding-top: clamp(5.8rem, 9vw, 7.5rem);
  }

  .news-hero__grid,
  .news-episode-list,
  .news-brief-controls,
  .news-brief-actions,
  .news-advisory-grid,
  .news-desk-grid,
  .news-editorial-cta__grid {
    display: grid;
    gap: 1rem;
  }

  .news-player,
  .news-brief-shell,
  .news-advisory-shell,
  .news-desk-card,
  .news-editorial-cta {
    padding: 1.2rem;
    border-radius: 1.5rem;
  }

  .news-meta-kicker,
  .news-episode__meta,
  .news-episode__footer span {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-muted) 92%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .news-player h2,
  .news-brief-panel h3,
  .news-episode h3,
  .news-advisory-card h3,
  .news-editorial-link h3,
  .news-editorial-cta h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-weight: 650;
    line-height: 1.04;
    text-wrap: balance;
  }

  .news-player p,
  .news-brief-panel p,
  .news-episode p,
  .news-advisory-card p,
  .news-desk-card p,
  .news-editorial-link p,
  .news-editorial-cta p {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 95%, transparent);
    line-height: 1.68;
  }

  .news-player,
  .news-brief-shell,
  .news-brief-panel,
  .news-advisory-shell,
  .news-editorial-cta {
    display: grid;
    gap: 1rem;
  }

  .news-player__headline,
  .news-player__meta,
  .news-player__chapters,
  .news-episode,
  .news-advisory-card,
  .news-editorial-link {
    display: grid;
    gap: 0.8rem;
  }

  .news-player__bar {
    height: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-border) 72%, transparent);
  }

  .news-player__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-primary-strong),
      var(--color-primary)
    );
    transition: width 0.25s ease;
  }

  .news-player__meta,
  .news-episode__meta,
  .news-episode__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .news-player__chapters {
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .news-player__chapters span,
  .news-brief-button,
  .news-brief-panel,
  .news-brief-actions span,
  .news-episode,
  .news-advisory-card,
  .news-editorial-link,
  .news-episode__button {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
  }

  .news-player__chapters span {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 0.8rem;
    color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
    font-size: 0.78rem;
  }

  .news-brief-shell {
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }

  .news-brief-controls {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }

  .news-brief-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .news-brief-button:hover,
  .news-brief-button.is-active {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-text-primary);
  }

  .news-brief-panel {
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    padding: 1rem;
  }

  .news-brief-actions {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .news-brief-actions span {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 0.8rem;
    color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
    font-size: 0.78rem;
    text-align: center;
  }

  .news-episode,
  .news-advisory-card,
  .news-editorial-link {
    padding: 1rem;
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .news-episode.is-active,
  .news-episode:hover,
  .news-advisory-card:hover,
  .news-editorial-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .news-episode__button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 960px) {
    .news-hero__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      align-items: end;
    }

