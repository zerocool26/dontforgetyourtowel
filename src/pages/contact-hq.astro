  <section data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="tone-cta-band p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
          <div class="tone-section-heading">
            <p class="tone-section-kicker">Primary contact</p>
            <h2 class="tone-section-title">Ready to send the first message?</h2>
            <p class="tone-section-copy max-w-2xl">
              Send the context once, even if the scope is not fully shaped yet.
              The immediate goal is still the same: route the request into the
              right next move.
            </p>
            <p class="text-sm text-slate-300">
              <a class="tone-accent-link hover:underline" href={scheduleHref}>
                Book a planning call
              </a>
              <span class="mx-2 text-white/30">/</span>
              <span>{CONTACT_EMAIL}</span>
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
