---
import { CONTACT_CALENDAR_URL, CONTACT_EMAIL } from '../consts';
import EngagementArc from '../components/EngagementArc.astro';
import PageHero from '../components/PageHero.astro';
import { contactArc } from '../data/model';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { withBasePath } from '../utils/helpers';

const topic = Astro.url.searchParams.get('topic') ?? '';
const subject =
  topic === 'pricing'
    ? 'Technology engagement pricing review'
    : topic
      ? `${topic.replaceAll('-', ' ')} discussion`
      : 'Technology fit review';
const body = `Hi CHICAGOS #1 MSP,%0D%0A%0D%0AWhat the business needs to change:%0D%0A%0D%0ACurrent systems / workflow / provider context:%0D%0A%0D%0AUsers, locations, or people involved:%0D%0A%0D%0ATiming, risk, or decision ahead:%0D%0A%0D%0ABest way to follow up:%0D%0A`;
const emailHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${body}`;
---

<MarketingLayout
  title="Contact CHICAGOS #1 MSP | Put Us to Work"
  description="Contact CHICAGOS #1 MSP about technology strategy, custom software, cloud, cybersecurity, managed IT, data, integration, or modernization."
>
  <PageHero
    title="Give us the"
    accent="hard problem."
    copy="Tell us what the business needs to decide, build, secure, modernize, or operate. We will tell you whether we are the right fit and what needs to happen before responsible scope."
    primaryLabel={false}
    mediaKey="fog"
  >
    <Fragment slot="aside">
      <div class="page-hero__contact">
        <span>Direct email</span>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <p>Use email for the fastest, clearest first handoff.</p>
      </div>
    </Fragment>
  </PageHero>

  <section class="contact-action">
    <div class="shell contact-action__grid">
      <div class="contact-action__main">
        <h2>Start with five useful details.</h2>
        <ol>
          <li>
            <span>01</span><strong>The business outcome</strong><p>
              The decision, customer experience, workflow, system, risk, or
              operating result that needs to change.
            </p>
          </li>
          <li>
            <span>02</span><strong>The current state</strong><p>
              Existing applications, cloud, data, devices, vendors, source, or
              manual process involved.
            </p>
          </li>
          <li>
            <span>03</span><strong>The people involved</strong><p>
              Users, locations, customers, internal technology owners,
              decision-makers, and current providers.
            </p>
          </li>
          <li>
            <span>04</span><strong>Timing</strong><p>
              Launch window, urgent event, contract date, project recovery, or
              leadership decision ahead.
            </p>
          </li>
          <li>
            <span>05</span><strong>Best follow-up</strong><p>
              Who should join, what they need answered, and the easiest way to
              respond.
            </p>
          </li>
        </ol>
      </div>
      <aside class="contact-action__aside">
        <h2>Open a structured email.</h2>
        <p>
          We have prefilled a short outline. Add what you know and leave the
          rest blank.
        </p>
        <a class="button" href={emailHref}>Start an email</a>
        {
          CONTACT_CALENDAR_URL && (
            <a class="button button--outline" href={CONTACT_CALENDAR_URL}>
              Schedule a conversation
            </a>
          )
        }
        <p class="small-print">
          Do not send passwords, recovery codes, private keys, or sensitive
          client data through the first email.
        </p>
      </aside>
    </div>
  </section>

  <EngagementArc
    id="what-happens-next"
    title="What happens after you hit"
    accent="send."
    copy="No drip sequence, no discovery call before the discovery call. Four steps, and you can stop at any of them."
    stages={contactArc}
    outputLabel="You get"
  />

  <section class="simple-band">
    <div class="shell simple-band__inner">
      <div>
        <h2>Still deciding where to start?</h2><p>
          Review the service model, software delivery approach, or pricing
          models first.
        </p>
      </div>
      <div class="button-row">
        <a class="button button--outline" href={withBasePath('services/')}
          >Explore services</a
        >
        <a class="button button--outline" href={withBasePath('pricing/')}
          >See pricing</a
        >
      </div>
    </div>
  </section>
</MarketingLayout>
