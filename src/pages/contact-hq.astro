---
/* eslint-disable astro/no-set-html-directive */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import FAQAccordion from '../components/ui/FAQAccordion.tsx';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import { withBasePath } from '../utils/helpers';
import { CONTACT_EMAIL } from '../consts';
import { studioPresets } from '../data/build-studio';
import { tradeProfiles } from '../data/trades';

const serviceIntent = Astro.url.searchParams.get('service')?.trim() ?? '';
const solutionIntent = Astro.url.searchParams.get('solution')?.trim() ?? '';
const briefIntent = Astro.url.searchParams.get('brief')?.trim() ?? '';
const tradeIntent = Astro.url.searchParams.get('trade')?.trim() ?? '';
const tradePageIntent = Astro.url.searchParams.get('tradePage')?.trim() ?? '';
const workspaceTitleIntent =
  Astro.url.searchParams.get('workspaceTitle')?.trim() ?? '';
const workspaceSummaryIntent =
  Astro.url.searchParams.get('workspaceSummary')?.trim() ?? '';
const workspaceRoutesIntentRaw =
  Astro.url.searchParams.get('workspaceRoutes')?.trim() ?? '';
const workspaceRoutesIntent = (() => {
  if (!workspaceRoutesIntentRaw) return [];

  try {
    const parsed = JSON.parse(workspaceRoutesIntentRaw);
    if (!Array.isArray(parsed)) return [];

    return parsed.filter(
      item =>
        item &&
        typeof item.title === 'string' &&
        typeof item.category === 'string' &&
        typeof item.url === 'string'
    ) as Array<{
      title: string;
      category: string;
      description?: string;
      url: string;
    }>;
  } catch {
    return [];
  }
})();

const recommendedServiceLabel: Record<string, string> = {
  msp: 'Managed IT Services',
  security: 'Cybersecurity & Compliance',
  cloud: 'Cloud & Infrastructure',
  ai: 'AI Consulting & Integration',
};

const recommendedSolutionLabel = Object.fromEntries(
  studioPresets.map(preset => [preset.id, preset.name])
) as Record<string, string>;
const recommendedTradeLabel = Object.fromEntries(
  tradeProfiles.map(trade => [trade.slug, trade.name])
) as Record<string, string>;

const serviceIntentLabel =
  recommendedServiceLabel[serviceIntent.toLowerCase()] ?? serviceIntent;
const solutionIntentLabel =
  recommendedSolutionLabel[solutionIntent] ?? solutionIntent;
const tradeIntentLabel =
  recommendedTradeLabel[tradeIntent.toLowerCase()] ?? tradeIntent;

const kickoffSubject = tradeIntentLabel
  ? `New project inquiry — ${tradeIntentLabel}`
  : serviceIntentLabel
    ? `New project inquiry — ${serviceIntentLabel}`
    : solutionIntentLabel
      ? `New project inquiry — ${solutionIntentLabel}`
      : 'New project inquiry';

const kickoffBodyLines = [
  tradeIntentLabel ? `Trade focus: ${tradeIntentLabel}` : '',
  tradePageIntent ? `Trade page: ${tradePageIntent}` : '',
  solutionIntentLabel ? `Build path: ${solutionIntentLabel}` : '',
  briefIntent ? `Build brief: ${briefIntent}` : '',
  workspaceTitleIntent ? `Workspace title: ${workspaceTitleIntent}` : '',
  workspaceSummaryIntent ? `Workspace summary: ${workspaceSummaryIntent}` : '',
  workspaceRoutesIntent.length
    ? `Workspace routes:\n${workspaceRoutesIntent
        .map(route => `- ${route.title} (${route.category})`)
        .join('\n')}`
    : '',
].filter(Boolean);

const kickoffMailtoParams = new URLSearchParams({
  subject: kickoffSubject,
});

if (kickoffBodyLines.length) {
  kickoffMailtoParams.set('body', kickoffBodyLines.join('\n\n'));
}

const kickoffHref = `mailto:${encodeURIComponent(CONTACT_EMAIL)}?${kickoffMailtoParams.toString()}`;
const hasIntakeContext = Boolean(
  tradeIntentLabel ||
  tradePageIntent ||
  serviceIntentLabel ||
  solutionIntentLabel ||
  briefIntent ||
  workspaceTitleIntent ||
  workspaceSummaryIntent ||
  workspaceRoutesIntent.length
);

const channels = [
  {
    title: 'New project / sales',
    note: 'Scope review, sequencing, planning assumptions, and next-step recommendations.',
    subject: 'New project inquiry',
  },
  {
    title: 'Managed operations and support',
    note: 'Ongoing support questions, service requests, and operating-model discussions.',
    subject: 'Managed services support request',
  },
  {
    title: 'Security and advisory',
    note: 'Architecture guidance, security posture reviews, and compliance-oriented planning.',
    subject: 'Security advisory request',
  },
  {
    title: 'Partnerships and collaboration',
    note: 'Strategic collaboration, co-delivery opportunities, and long-term alignment conversations.',
    subject: 'Partnership inquiry',
  },
];

const firstMessageChecklist = [
  'What you are trying to achieve in plain language',
  'The current system, facility, or operational context',
  'Known constraints such as occupancy, timeline, support hours, or compliance needs',
  'Any urgent issues, blockers, or decision deadlines',
  'Who needs to review or approve the next step',
];

const engagementSteps = [
  {
    phase: '01',
    title: 'Align on the problem',
    detail:
      'The first conversation should confirm the real pressure point before anyone jumps to a solution.',
  },
  {
    phase: '02',
    title: 'Recommend the right lane',
    detail:
      'We identify the lead division, the likely interfaces, and whether the scope should stay narrow or expand into a program.',
  },
  {
    phase: '03',
    title: 'Shape the first plan',
    detail:
      'The next step becomes a right-sized plan: discovery, pricing, a scoped sprint, phased rollout, or direct project intake.',
  },
  {
    phase: '04',
    title: 'Start with clear ownership',
    detail:
      'Once approved, onboarding and execution begin with named owners, agreed milestones, and visible outputs.',
  },
];

const faqs = [
  {
    title: 'How quickly do you usually respond?',
    content:
      'Most first responses happen within the same business day. Time-sensitive operational issues are prioritized faster when the first message clearly explains urgency.',
  },
  {
    title: 'Can we start with a narrow scope instead of a big engagement?',
    content:
      'Yes. Many engagements begin with discovery, a stabilization sprint, a focused trade package, or a single operational priority before expanding.',
  },
  {
    title: 'Do you work with internal teams or existing vendors?',
    content:
      'Yes. Co-managed delivery is common. The goal is to clarify ownership and close capability gaps, not force unnecessary replacement of existing teams.',
  },
  {
    title: 'What if we are not sure which division should lead?',
    content:
      'That is a normal starting point. Send the context you have, and we will help identify the right lead lane and the likely supporting interfaces.',
  },
];

const contactBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(withBasePath('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact HQ',
      item: new URL(withBasePath('contact-hq/'), Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.content,
    },
  })),
};
---

<MarketingLayout
  title="Contact | Olive Global Systems"
  description="Contact and intake page for project discovery, support conversations, security advisory, and partnership inquiries."
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
  mainClass="relative isolate overflow-x-clip"
>
  <StructuredData type="contact" />
  <StructuredData type="organization" />
  <StructuredData
    type="breadcrumbs"
    data={{ items: contactBreadcrumbSchema.itemListElement }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section
    class="border-b border-white/10"
    data-reveal
    id="contact-hero"
    data-page-section
  >
    <div
      class="mx-auto max-w-[1240px] px-4 pb-14 pt-20 sm:px-6 sm:pb-20 sm:pt-28"
    >
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div class="space-y-6">
          <div class="space-y-3">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Contact HQ
            </p>
            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
            >
              Let’s scope your next initiative with enough context to make the
              next step obvious.
            </h1>
            <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
              This page is now built around one job: helping you route a request
              clearly, whether it is a new project, an operational issue, a
              security advisory need, or a partnership conversation.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={kickoffHref}
              data-kickoff-mailto
              variant="primary"
              className="min-h-[50px]"
            >
              Email project details
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review services first
            </ModernButton>
          </div>
        </div>

        <ModernCard variant="glass" className="hidden p-7 sm:p-8 md:block">
          <div class="space-y-5">
            <div>
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-white/50"
              >
                Primary contact
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                {CONTACT_EMAIL}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                Use email when you want the fastest way to capture context,
                routes, and next-step questions in one place.
              </p>
            </div>

            <div class="border-t border-white/10 pt-5">
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
              >
                Best first message includes
              </p>
              <ul class="mt-3 space-y-2 text-sm text-slate-300">
                {
                  firstMessageChecklist.slice(0, 3).map(item => (
                    <li class="flex items-start gap-2">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#12b5a6]" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </ModernCard>
      </div>

      <div
        id="intake-context"
        class:list={[
          'mt-8 rounded-2xl border border-white/10 bg-white/[0.03] p-6',
          !hasIntakeContext && 'hidden',
        ]}
      >
        <p
          class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
        >
          Routed context
        </p>
        <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <div
            id="intake-context-trade-row"
            class:list={[!tradeIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Trade focus
            </p>
            <p
              id="intake-context-trade"
              class="mt-2 text-sm font-semibold text-white"
            >
              {tradeIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-trade-page-row"
            class:list={[!tradePageIntent && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Trade route
            </p>
            <p
              id="intake-context-trade-page"
              class="mt-2 text-sm text-slate-300"
            >
              {tradePageIntent}
            </p>
          </div>
          <div
            id="intake-context-service-row"
            class:list={[!serviceIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Recommended service
            </p>
            <p
              id="intake-context-service"
              class="mt-2 text-sm font-semibold text-white"
            >
              {serviceIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-solution-row"
            class:list={[!solutionIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Build path
            </p>
            <p
              id="intake-context-solution"
              class="mt-2 text-sm font-semibold text-white"
            >
              {solutionIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-brief-row"
            class:list={[!briefIntent && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Brief
            </p>
            <p id="intake-context-brief" class="mt-2 text-sm text-slate-300">
              {briefIntent}
            </p>
          </div>
        </div>

        <div
          id="intake-context-workspace-row"
          class:list={[
            'mt-5 rounded-2xl border border-white/10 bg-black/20 p-5',
            !(
              workspaceTitleIntent ||
              workspaceSummaryIntent ||
              workspaceRoutesIntent.length
            ) && 'hidden',
          ]}
        >
          <p
            class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
          >
            Workspace context
          </p>
          <p
            id="intake-context-workspace-title"
            class="mt-3 text-sm font-semibold text-white"
          >
            {workspaceTitleIntent || 'Curated route workspace'}
          </p>
          <p
            id="intake-context-workspace-summary"
            class="mt-2 text-sm leading-6 text-slate-300"
          >
            {workspaceSummaryIntent}
          </p>
          <div id="intake-context-workspace-routes" class="mt-4 grid gap-2">
            {
              workspaceRoutesIntent.map(route => (
                <a
                  class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-3 text-sm transition hover:border-white/20 hover:bg-white/[0.05]"
                  href={route.url}
                >
                  <span class="block font-semibold text-white">
                    {route.title}
                  </span>
                  <span class="mt-1 block font-mono text-[11px] uppercase tracking-[0.18em] text-white/45">
                    {route.category}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="channels"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Contact lanes
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Choose the right channel for the conversation you need to have.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Picking the right channel helps reduce handoffs and gets the
          conversation in front of the right people faster.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          channels.map(channel => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{channel.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {channel.note}
              </p>
              <a
                class="mt-5 inline-flex text-sm font-semibold text-[#d7f75b] hover:underline"
                href={`mailto:${encodeURIComponent(CONTACT_EMAIL)}?subject=${encodeURIComponent(channel.subject)}`}
              >
                Email this channel
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="intake"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            First message guidance
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            What to include in your first message.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            Most intake friction comes from missing context. A simple, direct
            summary usually does more than a polished but vague request.
          </p>
        </div>

        <ModernCard variant="glass" className="p-7">
          <ul class="space-y-3 text-sm text-slate-300">
            {
              firstMessageChecklist.map(item => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#12b5a6]" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </ModernCard>
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="readiness"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel
        title="Send a cleaner first brief."
        description="Check the owner, constraints, and target window before you email. The stronger the inputs, the faster the next step can become real."
      />
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="engagement"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Engagement sequence
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          A straightforward path from intake to active work.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          The point of the contact page is not to sell theatrics. It is to help
          a serious request move into the right decision path quickly and
          clearly.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          engagementSteps.map(step => (
            <ModernCard variant="outline" className="h-full p-6">
              <p class="font-mono text-[0.72rem] uppercase tracking-[0.22em] text-white/45">
                {step.phase}
              </p>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {step.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{step.detail}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10"
    id="faq"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            FAQ
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Common questions before kickoff.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            These cover the most common uncertainties around response timing,
            scope sizing, internal-team collaboration, and figuring out the
            right lead division.
          </p>
        </div>

        <div>
          <FAQAccordion client:visible items={faqs} />
        </div>
      </div>
    </div>
  </section>

  <section data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <ModernCard variant="glass" className="p-8 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
          <div class="space-y-4">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Primary contact
            </p>
            <h2
              class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
            >
              Ready to send the first message?
            </h2>
            <p class="max-w-2xl text-base leading-7 text-slate-300">
              Email the context you have, even if the scope is not fully shaped
              yet. The immediate goal is to identify the right lead lane and the
              right next decision.
            </p>
            <p class="text-sm text-slate-300">
              <a
                class="font-semibold text-[#d7f75b] hover:underline"
                href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
              >
            </p>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:justify-end"
          >
            <ModernButton
              href={kickoffHref}
              data-kickoff-mailto
              variant="primary"
              className="min-h-[50px]"
            >
              Email now
            </ModernButton>
            <ModernButton
              href={withBasePath('trades/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Browse divisions first
            </ModernButton>
          </div>
        </div>
      </ModernCard>
    </div>
  </section>

  <script
    is:inline
    define:vars={{
      contactEmail: CONTACT_EMAIL,
      serviceLabels: recommendedServiceLabel,
      solutionLabels: recommendedSolutionLabel,
      tradeLabels: recommendedTradeLabel,
    }}
  >
    (() => {
      const params = new URLSearchParams(window.location.search);
      const serviceKey = (params.get('service') || '').trim();
      const solutionKey = (params.get('solution') || '').trim();
      const briefValue = (params.get('brief') || '').trim();
      const tradeKey = (params.get('trade') || '').trim();
      const tradePageValue = (params.get('tradePage') || '').trim();
      const workspaceTitle = (params.get('workspaceTitle') || '').trim();
      const workspaceSummary = (params.get('workspaceSummary') || '').trim();
      const workspaceRoutesRaw = (params.get('workspaceRoutes') || '').trim();
      let workspaceRoutes = [];

      if (workspaceRoutesRaw) {
        try {
          const parsed = JSON.parse(workspaceRoutesRaw);
          if (Array.isArray(parsed)) {
            workspaceRoutes = parsed.filter(
              item =>
                item &&
                typeof item.title === 'string' &&
                typeof item.category === 'string' &&
                typeof item.url === 'string'
            );
          }
        } catch {
          workspaceRoutes = [];
        }
      }

      const serviceLabel =
        serviceLabels[serviceKey.toLowerCase()] || serviceKey;
      const solutionLabel = solutionLabels[solutionKey] || solutionKey;
      const tradeLabel = tradeLabels[tradeKey.toLowerCase()] || tradeKey;
      const hasContext = Boolean(
        tradeLabel ||
        tradePageValue ||
        serviceLabel ||
        solutionLabel ||
        briefValue ||
        workspaceTitle ||
        workspaceSummary ||
        workspaceRoutes.length
      );

      const panel = document.getElementById('intake-context');
      const tradeRow = document.getElementById('intake-context-trade-row');
      const tradePageRow = document.getElementById(
        'intake-context-trade-page-row'
      );
      const serviceRow = document.getElementById('intake-context-service-row');
      const solutionRow = document.getElementById(
        'intake-context-solution-row'
      );
      const briefRow = document.getElementById('intake-context-brief-row');
      const tradeValue = document.getElementById('intake-context-trade');
      const tradePageNode = document.getElementById(
        'intake-context-trade-page'
      );
      const serviceValue = document.getElementById('intake-context-service');
      const solutionValue = document.getElementById('intake-context-solution');
      const briefValueNode = document.getElementById('intake-context-brief');
      const workspaceRow = document.getElementById(
        'intake-context-workspace-row'
      );
      const workspaceTitleNode = document.getElementById(
        'intake-context-workspace-title'
      );
      const workspaceSummaryNode = document.getElementById(
        'intake-context-workspace-summary'
      );
      const workspaceRoutesNode = document.getElementById(
        'intake-context-workspace-routes'
      );

      const applyField = (row, node, value) => {
        if (!(row instanceof HTMLElement) || !(node instanceof HTMLElement)) {
          return;
        }

        row.classList.toggle('hidden', !value);
        node.textContent = value;
      };

      if (panel instanceof HTMLElement) {
        panel.classList.toggle('hidden', !hasContext);
      }

      applyField(tradeRow, tradeValue, tradeLabel);
      applyField(tradePageRow, tradePageNode, tradePageValue);
      applyField(serviceRow, serviceValue, serviceLabel);
      applyField(solutionRow, solutionValue, solutionLabel);
      applyField(briefRow, briefValueNode, briefValue);

      if (workspaceRow instanceof HTMLElement) {
        const hasWorkspace =
          Boolean(workspaceTitle || workspaceSummary) ||
          workspaceRoutes.length > 0;
        workspaceRow.classList.toggle('hidden', !hasWorkspace);

        if (workspaceTitleNode instanceof HTMLElement) {
          workspaceTitleNode.textContent =
            workspaceTitle || 'Curated route workspace';
        }

        if (workspaceSummaryNode instanceof HTMLElement) {
          workspaceSummaryNode.textContent =
            workspaceSummary ||
            (workspaceRoutes.length
              ? `Workspace imported with ${workspaceRoutes.length} saved route${workspaceRoutes.length === 1 ? '' : 's'}.`
              : '');
        }

        if (workspaceRoutesNode instanceof HTMLElement) {
          workspaceRoutesNode.innerHTML = '';

          workspaceRoutes.forEach(route => {
            const link = document.createElement('a');
            link.className =
              'rounded-xl border border-white/10 bg-white/[0.03] px-3 py-3 text-sm transition hover:border-white/20 hover:bg-white/[0.05]';
            link.href = route.url;

            const title = document.createElement('span');
            title.className = 'block font-semibold text-white';
            title.textContent = route.title;

            const meta = document.createElement('span');
            meta.className =
              'mt-1 block font-mono text-[11px] uppercase tracking-[0.18em] text-white/45';
            meta.textContent = route.category;

            link.append(title, meta);
            workspaceRoutesNode.appendChild(link);
          });
        }
      }

      const kickoffSubject = tradeLabel
        ? `New project inquiry — ${tradeLabel}`
        : serviceLabel
          ? `New project inquiry — ${serviceLabel}`
          : solutionLabel
            ? `New project inquiry — ${solutionLabel}`
            : 'New project inquiry';

      const bodyLines = [];
      if (tradeLabel) {
        bodyLines.push(`Trade focus: ${tradeLabel}`);
      }
      if (tradePageValue) {
        bodyLines.push(`Trade page: ${tradePageValue}`);
      }
      if (solutionLabel) {
        bodyLines.push(`Build path: ${solutionLabel}`);
      }
      if (briefValue) {
        bodyLines.push(`Build brief: ${briefValue}`);
      }
      if (workspaceTitle) {
        bodyLines.push(`Workspace title: ${workspaceTitle}`);
      }
      if (workspaceSummary) {
        bodyLines.push(`Workspace summary: ${workspaceSummary}`);
      }
      if (workspaceRoutes.length) {
        bodyLines.push(
          `Workspace routes:\n${workspaceRoutes
            .map(route => `- ${route.title} (${route.category})`)
            .join('\n')}`
        );
      }

      const mailtoParams = new URLSearchParams({ subject: kickoffSubject });
      if (bodyLines.length) {
        mailtoParams.set('body', bodyLines.join('\n\n'));
      }

      const dynamicKickoffHref = `mailto:${encodeURIComponent(contactEmail)}?${mailtoParams.toString()}`;

      document.querySelectorAll('[data-kickoff-mailto]').forEach(link => {
        if (link instanceof HTMLAnchorElement) {
          link.href = dynamicKickoffHref;
        }
      });
    })();
  </script>
</MarketingLayout>
