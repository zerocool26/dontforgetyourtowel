---
/* eslint-disable astro/no-set-html-directive */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import OperationalIntelligenceWorkbench from '../components/business/OperationalIntelligenceWorkbench.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import { withBasePath } from '../utils/helpers';
import {
  CONTACT_CALENDAR_URL,
  CONTACT_CRM_LABEL,
  CONTACT_EMAIL,
} from '../consts';
import { studioPresets } from '../data/build-studio';
import { operatingIntelligenceItems } from '../data/operating-intelligence';
import { servicesExtended } from '../data/services-extended';
import { tradeProfiles } from '../data/trades';
import { buildContactHqHref } from '../utils/contact';

const serviceIntent = Astro.url.searchParams.get('service')?.trim() ?? '';
const solutionIntent = Astro.url.searchParams.get('solution')?.trim() ?? '';
const briefIntent = Astro.url.searchParams.get('brief')?.trim() ?? '';
const tradeIntent = Astro.url.searchParams.get('trade')?.trim() ?? '';
const tradePageIntent = Astro.url.searchParams.get('tradePage')?.trim() ?? '';
const workspaceTitleIntent =
  Astro.url.searchParams.get('workspaceTitle')?.trim() ?? '';
const workspaceSummaryIntent =
  Astro.url.searchParams.get('workspaceSummary')?.trim() ?? '';
const workspaceRoutesIntentRaw =
  Astro.url.searchParams.get('workspaceRoutes')?.trim() ?? '';
const workspaceRoutesIntent = (() => {
  if (!workspaceRoutesIntentRaw) return [];

  try {
    const parsed = JSON.parse(workspaceRoutesIntentRaw);
    if (!Array.isArray(parsed)) return [];

    return parsed.filter(
      item =>
        item &&
        typeof item.title === 'string' &&
        typeof item.category === 'string' &&
        typeof item.url === 'string'
    ) as Array<{
      title: string;
      category: string;
      description?: string;
      url: string;
    }>;
  } catch {
    return [];
  }
})();

const recommendedServiceLabel: Record<string, string> = {
  msp: 'Managed IT and Support',
  security: 'Cybersecurity & Compliance',
  cloud: 'Cloud and Microsoft 365',
  ai: 'Automation and Digital Workflow',
  digital: 'Client-Facing Digital Systems',
};

const serviceCatalogLabel = Object.fromEntries(
  servicesExtended.map(service => [service.id, service.name])
) as Record<string, string>;

const recommendedSolutionLabel = Object.fromEntries(
  studioPresets.map(preset => [preset.id, preset.name])
) as Record<string, string>;
const recommendedTradeLabel = Object.fromEntries(
  tradeProfiles.map(trade => [trade.slug, trade.name])
) as Record<string, string>;

const serviceIntentLabel =
  recommendedServiceLabel[serviceIntent.toLowerCase()] ??
  serviceCatalogLabel[serviceIntent] ??
  serviceIntent;
const solutionIntentLabel =
  recommendedSolutionLabel[solutionIntent] ?? solutionIntent;
const tradeIntentLabel =
  recommendedTradeLabel[tradeIntent.toLowerCase()] ?? tradeIntent;

const kickoffSubject = tradeIntentLabel
  ? `${tradeIntentLabel} inquiry`
  : serviceIntentLabel
    ? `${serviceIntentLabel} inquiry`
    : solutionIntentLabel
      ? `${solutionIntentLabel} inquiry`
      : 'Chicago Operations Studio inquiry';
const scheduleHref = CONTACT_CALENDAR_URL || '#structured-intake';
const hasIntakeContext = Boolean(
  tradeIntentLabel ||
  tradePageIntent ||
  serviceIntentLabel ||
  solutionIntentLabel ||
  briefIntent ||
  workspaceTitleIntent ||
  workspaceSummaryIntent ||
  workspaceRoutesIntent.length
);

const workbenchItems = operatingIntelligenceItems.map(item => ({
  ...item,
  ctaHref: withBasePath(item.path),
}));

const defaultContactWorkbenchId =
  serviceIntent.includes('backup') || serviceIntent.includes('recovery')
    ? 'recovery-confidence'
    : solutionIntentLabel
      ? 'digital-trust'
      : 'support-ownership';

const channels = [
  {
    title: 'Strategy and discovery',
    note: 'Scope review, user/device assumptions, provider-transition questions, budget shape, and next-step recommendations.',
    subject: 'Strategy and discovery inquiry',
  },
  {
    title: 'Managed operations and support',
    note: 'Support coverage, recurring tickets, onboarding/offboarding, vendor confusion, device standards, and response expectations.',
    subject: 'Managed services support request',
  },
  {
    title: 'Security and advisory',
    note: 'MFA, admin access, endpoint protection, email risk, backup evidence, cyber-insurance pressure, and response planning.',
    subject: 'Security advisory request',
  },
  {
    title: 'Projects and digital systems',
    note: 'Microsoft 365 cleanup, cloud projects, office moves, workflow automation, website refreshes, portals, and co-delivery conversations.',
    subject: 'Build and collaboration inquiry',
  },
];

const firstMessageChecklist = [
  'The main problem you want fixed or improved',
  'Rough user count, device count, locations, and current provider situation',
  'Key constraints such as timing, compliance, budget, or team capacity',
  'Anything urgent or customer-visible',
  'Who needs to approve the next step',
];

const fitSignals = [
  {
    label: 'Good fit',
    title: 'You want ownership, not a ticket-only vendor.',
    copy: 'The strongest fit is a team that needs support, security, Microsoft 365, backup, vendor coordination, or digital work tied to visible business outcomes.',
  },
  {
    label: 'Worth a conversation',
    title: 'Recurring issues are starting to cost real attention.',
    copy: 'Slow response, unclear escalation, stale access, surprise renewals, messy onboarding, repeated printer/network/app complaints, or weak reporting are usually signs the operating model needs attention.',
  },
  {
    label: 'Not the right first move',
    title: 'If the request is only a one-off break/fix task.',
    copy: 'One-off emergency work may not justify a relationship unless it connects to a broader support, security, recovery, provider-transition, or modernization need.',
  },
];

const responsePrep = [
  {
    title: 'For support coverage',
    copy: 'Send user count, device count, site count, current provider pain, hours needed, core apps, and the top three recurring tickets.',
  },
  {
    title: 'For security review',
    copy: 'Send cyber-insurance requirements, MFA status, endpoint tool, email security notes, backup concerns, compliance pressure, and any recent incidents.',
  },
  {
    title: 'For Microsoft 365 or cloud',
    copy: 'Send tenant pain, SharePoint/Teams issues, license count, migration goals, external sharing concerns, retention assumptions, and backup expectations.',
  },
  {
    title: 'For digital or ecommerce work',
    copy: 'Send the buyer path, product or service catalog needs, content state, approval owner, launch window, analytics notes, and what the current site fails to do.',
  },
];

const engagementSteps = [
  {
    phase: '01',
    title: 'Confirm the pressure point',
    detail:
      'Make sure the real issue is clear before anyone jumps into solution mode.',
  },
  {
    phase: '02',
    title: 'Recommend the right lane',
    detail:
      'Identify the best starting lane and the adjacent work that actually belongs in view.',
  },
  {
    phase: '03',
    title: 'Shape the first plan',
    detail:
      'Turn the next move into a right-sized plan: discovery, pricing, sprint, stabilization, or rollout.',
  },
  {
    phase: '04',
    title: 'Start with clear ownership',
    detail:
      'Once approved, execution starts with named owners, visible milestones, and useful outputs.',
  },
];

const contactSections = [
  { label: 'Handoff', href: '#decision-handoff' },
  { label: 'Router', href: '#contact-workbench' },
  { label: 'Fit', href: '#fit' },
  { label: 'Channels', href: '#channels' },
  { label: 'Message checklist', href: '#intake' },
  { label: 'Readiness', href: '#readiness' },
  { label: 'FAQ', href: '#faq' },
];

const faqs = [
  {
    title: 'How quickly do you usually respond?',
    content:
      'Most first responses happen within the same business day. Time-sensitive issues move faster when the first note is short, direct, and clearly marks urgency.',
  },
  {
    title: 'Can we start with a narrow scope instead of a big engagement?',
    content:
      'Yes. Many engagements start with discovery, a stabilization sprint, a focused security scope, or one urgent priority before expanding.',
  },
  {
    title: 'Do you work with internal teams or existing vendors?',
    content:
      'Yes. Co-managed delivery is common. The goal is to clarify ownership and close capability gaps, not force unnecessary replacement of existing teams.',
  },
  {
    title: 'What if we are not sure which service should lead?',
    content:
      'That is a normal starting point. Send the context you have, and we will help identify the right lead lane and any supporting work that should stay attached.',
  },
];

const contactBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(withBasePath('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact HQ',
      item: new URL(withBasePath('contact-hq/'), Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.content,
    },
  })),
};
---

<MarketingLayout
  title="Contact | Olive Chicago"
  description="Contact and intake page for Chicago-area strategy, support, security advisory, roadmap conversations, cloud projects, and selective digital-system work."
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
  mainClass="relative isolate overflow-x-clip"
>
  <StructuredData type="contact" />
  <StructuredData type="organization" />
  <StructuredData
    type="breadcrumbs"
    data={{ items: contactBreadcrumbSchema.itemListElement }}
  />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section
    class="tone-page-hero tone-section-divider border-b"
    data-reveal
    id="contact-hero"
    data-page-section
  >
    <div
      class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 pb-14 pt-20 sm:px-6 sm:pb-20 sm:pt-28"
    >
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Contact HQ</p>
            <h1 class="tone-page-title max-w-5xl">
              Chicago Operations Studio intake, built for real routing.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Use one structured brief for support ownership, security posture,
              Microsoft 365 cleanup, backup confidence, provider transition, or
              proof-led digital system work. The goal is a routed next move, not
              another vague contact thread.
            </p>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href="#structured-intake"
              variant="primary"
              className="min-h-[50px]"
            >
              Start structured intake
            </ModernButton>
            <ModernButton
              href={scheduleHref}
              variant="secondary"
              className="min-h-[50px]"
            >
              Schedule a planning call
            </ModernButton>
          </div>

          <div class="tone-page-jump-links pt-1">
            {
              contactSections.map(section => (
                <a
                  class="tone-chip-neutral tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                  href={section.href}
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>

        <ModernCard variant="glass" className="tone-panel-soft p-7 sm:p-8">
          <div class="space-y-5">
            <div>
              <p
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-white/50"
              >
                Intake system
              </p>
              <p class="mt-3 text-lg font-semibold text-white">
                {CONTACT_CRM_LABEL}
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                Structured intake captures routing context, qualification
                detail, source attribution, and scheduling intent in one place
                so the follow-up owner starts with the full picture.
              </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="tone-panel-soft rounded-2xl p-4">
                <p class="text-sm font-semibold text-white">Response target</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  Most qualified inquiries get a same-business-day first review
                  with a recommended lane, missing inputs, and next action.
                </p>
              </div>
              <div class="tone-panel-soft rounded-2xl p-4">
                <p class="text-sm font-semibold text-white">Best backup path</p>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  If you already know you want a live conversation, use the
                  scheduling option first and keep the intake form for the full
                  handoff detail.
                </p>
              </div>
            </div>
          </div>
        </ModernCard>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="tone-panel-soft rounded-2xl p-5">
          <p
            class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45"
          >
            Built for
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Chicago-area firms that need calmer operations, stronger proof, and
            clearer owner handoffs.
          </p>
        </div>
        <div class="tone-panel-soft rounded-2xl p-5">
          <p
            class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45"
          >
            What gets routed
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Support, security, Microsoft 365, backup/recovery, provider
            transition, roadmap, and selected digital system work.
          </p>
        </div>
        <div class="tone-panel-soft rounded-2xl p-5">
          <p
            class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45"
          >
            Direct contact
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            {CONTACT_EMAIL}
          </p>
        </div>
      </div>

      <div
        id="intake-context"
        class:list={[
          'tone-panel-soft mt-8 rounded-2xl p-6',
          !hasIntakeContext && 'hidden',
        ]}
      >
        <p
          class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45"
        >
          Routed context
        </p>
        <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <div
            id="intake-context-trade-row"
            class:list={[!tradeIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Context focus
            </p>
            <p
              id="intake-context-trade"
              class="mt-2 text-sm font-semibold text-white"
            >
              {tradeIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-trade-page-row"
            class:list={[!tradePageIntent && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Context route
            </p>
            <p
              id="intake-context-trade-page"
              class="mt-2 text-sm text-slate-300"
            >
              {tradePageIntent}
            </p>
          </div>
          <div
            id="intake-context-service-row"
            class:list={[!serviceIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Recommended service
            </p>
            <p
              id="intake-context-service"
              class="mt-2 text-sm font-semibold text-white"
            >
              {serviceIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-solution-row"
            class:list={[!solutionIntentLabel && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Build path
            </p>
            <p
              id="intake-context-solution"
              class="mt-2 text-sm font-semibold text-white"
            >
              {solutionIntentLabel}
            </p>
          </div>
          <div
            id="intake-context-brief-row"
            class:list={[!briefIntent && 'hidden']}
          >
            <p
              class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
            >
              Brief
            </p>
            <p id="intake-context-brief" class="mt-2 text-sm text-slate-300">
              {briefIntent}
            </p>
          </div>
        </div>

        <div
          id="intake-context-workspace-row"
          class:list={[
            'tone-panel-subtle tone-border mt-5 rounded-2xl border p-5',
            !(
              workspaceTitleIntent ||
              workspaceSummaryIntent ||
              workspaceRoutesIntent.length
            ) && 'hidden',
          ]}
        >
          <p
            class="font-mono text-[0.64rem] uppercase tracking-[0.18em] text-white/40"
          >
            Workspace context
          </p>
          <p
            id="intake-context-workspace-title"
            class="mt-3 text-sm font-semibold text-white"
          >
            {workspaceTitleIntent || 'Curated route workspace'}
          </p>
          <p
            id="intake-context-workspace-summary"
            class="mt-2 text-sm leading-6 text-slate-300"
          >
            {workspaceSummaryIntent}
          </p>
          <div id="intake-context-workspace-routes" class="mt-4 grid gap-2">
            {
              workspaceRoutesIntent.map(route => (
                <a
                  class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-3 text-sm transition hover:border-white/20 hover:bg-white/[0.05]"
                  href={route.url}
                >
                  <span class="block font-semibold text-white">
                    {route.title}
                  </span>
                  <span class="mt-1 block font-mono text-[11px] uppercase tracking-[0.18em] text-white/45">
                    {route.category}
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="structured-intake"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Structured intake</p>
          <h2 class="tone-section-title">
            Give the next owner a brief they can actually act on.
          </h2>
          <p class="tone-section-copy">
            This form captures the real pressure point, company shape, timing,
            risk, source, and route context. It is built for routing, not for a
            generic “hello”.
          </p>

          <div class="mt-8 grid gap-4">
            <div class="tone-panel-soft rounded-2xl p-5">
              <p class="text-sm font-semibold text-white">What belongs here</p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                Support ownership gaps, security review, Microsoft 365 cleanup,
                backup doubt, provider transitions, compliance pressure,
                leadership planning, and buyer-facing system proof work.
              </p>
            </div>
            <div class="tone-panel-soft rounded-2xl p-5">
              <p class="text-sm font-semibold text-white">
                What speeds routing
              </p>
              <p class="mt-2 text-sm leading-7 text-slate-300">
                User count, locations, current provider context, recurring pain,
                timing, approval owner, and anything regulated or
                customer-visible.
              </p>
            </div>
            <div class="tone-panel-soft rounded-2xl p-5">
              <p class="text-sm font-semibold text-white">
                Need a live review?
              </p>
              <div class="mt-3 flex flex-wrap gap-3">
                <ModernButton
                  href={scheduleHref}
                  variant="secondary"
                  className="min-h-[46px]"
                >
                  Book planning call
                </ModernButton>
                <ModernButton
                  href={withBasePath('pricing/')}
                  variant="outline"
                  className="min-h-[46px]"
                >
                  Review pricing first
                </ModernButton>
              </div>
            </div>
          </div>
        </div>

        <ModernCard variant="glass" className="p-6 sm:p-8">
          <form
            id="contact-form"
            data-keyboard-aware
            class="contact-intake-form space-y-5"
            novalidate
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="contact-form-field">
                <span>First name</span>
                <input
                  class="contact-form-input form-input"
                  type="text"
                  name="firstName"
                  autocomplete="given-name"
                  required
                />
                <span class="form-error hidden"></span>
              </label>
              <label class="contact-form-field">
                <span>Last name</span>
                <input
                  class="contact-form-input form-input"
                  type="text"
                  name="lastName"
                  autocomplete="family-name"
                  required
                />
                <span class="form-error hidden"></span>
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="contact-form-field">
                <span>Email</span>
                <input
                  class="contact-form-input form-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                />
                <span class="form-error hidden"></span>
              </label>
              <label class="contact-form-field">
                <span>Phone</span>
                <input
                  class="contact-form-input form-input"
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                />
                <span class="form-error hidden"></span>
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="contact-form-field">
                <span>Company</span>
                <input
                  class="contact-form-input form-input"
                  type="text"
                  name="company"
                  autocomplete="organization"
                />
                <span class="form-error hidden"></span>
              </label>
              <label class="contact-form-field">
                <span>Subject</span>
                <input
                  class="contact-form-input form-input"
                  type="text"
                  name="subject"
                  value={kickoffSubject}
                  required
                />
                <span class="form-error hidden"></span>
              </label>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <label class="contact-form-field">
                <span>Budget shape</span>
                <select class="contact-form-input form-select" name="budget">
                  <option value="">Select range</option>
                  <option value="Under $3k / month">Under $3k / month</option>
                  <option value="$3k - $7.5k / month"
                    >$3k - $7.5k / month</option
                  >
                  <option value="$7.5k - $15k / month"
                    >$7.5k - $15k / month</option
                  >
                  <option value="$15k+ / month">$15k+ / month</option>
                  <option value="Project scoped">Project scoped</option>
                  <option value="Need guidance">Need guidance</option>
                </select>
                <span class="form-error hidden"></span>
              </label>
              <label class="contact-form-field">
                <span>Timing</span>
                <select class="contact-form-input form-select" name="timeline">
                  <option value="">Select timing</option>
                  <option value="Urgent / this week">Urgent / this week</option>
                  <option value="This month">This month</option>
                  <option value="This quarter">This quarter</option>
                  <option value="Next 6 months">Next 6 months</option>
                  <option value="Planning ahead">Planning ahead</option>
                </select>
                <span class="form-error hidden"></span>
              </label>
            </div>

            <label class="contact-form-field">
              <span>What needs attention?</span>
              <textarea
                class="contact-form-input contact-form-textarea form-textarea"
                name="message"
                rows="7"
                required
              >
              </textarea>
              <span class="form-help">
                Include the pressure point, rough user/device/site count,
                current provider context, key constraint, and what success
                should look like.
              </span>
              <span class="form-error hidden"></span>
            </label>

            <label class="contact-form-consent">
              <input
                class="form-checkbox"
                type="checkbox"
                name="terms"
                required
              />
              <span>
                I understand this intake is used to route the request and start
                a follow-up conversation.
              </span>
            </label>

            <input type="hidden" name="leadSource" value="website-contact-hq" />
            <input type="hidden" name="serviceIntent" value="" />
