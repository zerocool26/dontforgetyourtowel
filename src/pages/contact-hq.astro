---
/* eslint-disable astro/no-set-html-directive */
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import { withBasePath } from '../utils/helpers';
import { CONTACT_EMAIL } from '../consts';
import { studioPresets } from '../data/build-studio';
import { tradeProfiles } from '../data/trades';

const serviceIntent = Astro.url.searchParams.get('service')?.trim() ?? '';
const solutionIntent = Astro.url.searchParams.get('solution')?.trim() ?? '';
const briefIntent = Astro.url.searchParams.get('brief')?.trim() ?? '';
const tradeIntent = Astro.url.searchParams.get('trade')?.trim() ?? '';
const tradePageIntent = Astro.url.searchParams.get('tradePage')?.trim() ?? '';

const recommendedServiceLabel: Record<string, string> = {
  msp: 'Managed IT Services',
  security: 'Cybersecurity & Compliance',
  cloud: 'Cloud & Infrastructure',
  ai: 'AI Consulting & Integration',
};

const recommendedSolutionLabel = Object.fromEntries(
  studioPresets.map(preset => [preset.id, preset.name])
) as Record<string, string>;
const recommendedTradeLabel = Object.fromEntries(
  tradeProfiles.map(trade => [trade.slug, trade.name])
) as Record<string, string>;

const serviceIntentLabel =
  recommendedServiceLabel[serviceIntent.toLowerCase()] ?? serviceIntent;
const solutionIntentLabel =
  recommendedSolutionLabel[solutionIntent] ?? solutionIntent;
const tradeIntentLabel =
  recommendedTradeLabel[tradeIntent.toLowerCase()] ?? tradeIntent;

const kickoffSubject = tradeIntentLabel
  ? `New project inquiry — ${tradeIntentLabel}`
  : serviceIntentLabel
    ? `New project inquiry — ${serviceIntentLabel}`
    : solutionIntentLabel
      ? `New project inquiry — ${solutionIntentLabel}`
      : 'New project inquiry';

const kickoffBodyLines = [
  tradeIntentLabel ? `Trade focus: ${tradeIntentLabel}` : '',
  tradePageIntent ? `Trade page: ${tradePageIntent}` : '',
  solutionIntentLabel ? `Build path: ${solutionIntentLabel}` : '',
  briefIntent ? `Build brief: ${briefIntent}` : '',
].filter(Boolean);

const kickoffMailtoParams = new URLSearchParams({
  subject: kickoffSubject,
});

if (kickoffBodyLines.length) {
  kickoffMailtoParams.set('body', kickoffBodyLines.join('\n\n'));
}

const kickoffHref = `mailto:${encodeURIComponent(CONTACT_EMAIL)}?${kickoffMailtoParams.toString()}`;
const hasIntakeContext = Boolean(
  tradeIntentLabel ||
  tradePageIntent ||
  serviceIntentLabel ||
  solutionIntentLabel ||
  briefIntent
);

const contactChannels = [
  {
    title: 'New Project / Sales',
    note: 'Scope alignment, proposal framing, and delivery sequencing.',
    email: CONTACT_EMAIL,
    subject: 'New project inquiry',
  },
  {
    title: 'Managed Services Support',
    note: 'Operational support, escalations, and continuity requests.',
    email: CONTACT_EMAIL,
    subject: 'Managed services support request',
  },
  {
    title: 'Security Advisory',
    note: 'Risk reviews, architecture guidance, and response readiness.',
    email: CONTACT_EMAIL,
    subject: 'Security advisory request',
  },
  {
    title: 'Partnerships',
    note: 'Strategic collaboration and co-delivery opportunities.',
    email: CONTACT_EMAIL,
    subject: 'Partnership inquiry',
  },
];

const intakeChecklist = [
  'What outcome you want in plain language',
  'Current stack and system constraints',
  'Security/compliance boundaries (if relevant)',
  'Timeline expectations and decision dates',
  'Known blockers or operational pressure points',
];

const engagementSteps = [
  {
    phase: '01 • Discovery',
    detail:
      'We align on intent, urgency, constraints, and architectural context before solutions are proposed.',
  },
  {
    phase: '02 • Design',
    detail:
      'We frame options, sequencing, and operating model tradeoffs around your real delivery environment.',
  },
  {
    phase: '03 • Plan',
    detail:
      'You receive a right-sized plan with milestones, owners, and confidence checkpoints.',
  },
  {
    phase: '04 • Kickoff',
    detail:
      'Once approved, we activate onboarding, workflows, and the first implementation cycle.',
  },
];

const faqs = [
  {
    q: 'How quickly do you respond?',
    a: 'Most first responses happen same business day. Critical operational escalations are prioritized immediately.',
  },
  {
    q: 'Do you support co-managed engagements?',
    a: 'Yes. We commonly embed with internal teams and fill specialist capability gaps where needed.',
  },
  {
    q: 'Can we start with a narrow scope?',
    a: 'Absolutely. Many clients begin with discovery or hardening sprints, then scale into broader programs.',
  },
  {
    q: 'Do you offer fixed-price and recurring options?',
    a: 'Yes. The model is chosen based on scope volatility, risk profile, and desired operating cadence.',
  },
];

const contactBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL(withBasePath('/'), Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact HQ',
      item: new URL(withBasePath('contact-hq/'), Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<MarketingLayout
  title="Contact | Olive Global Systems"
  description="Creative intake hub for project discovery, operational support, security advisory, and partnership conversations."
>
  <StructuredData type="contact" />
  <StructuredData type="organization" />
  <StructuredData
    type="breadcrumbs"
    data={{ items: contactBreadcrumbSchema.itemListElement }}
  />
  <!-- eslint-disable-next-line astro/no-set-html-directive -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="tone-surface relative overflow-hidden" data-reveal>
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(204,255,0,0.14),_transparent_52%)]"
    >
    </div>
    <div class="relative mx-auto max-w-[1220px] px-6 pb-16 pt-28">
      <div class="creative-hero-shell p-8 sm:p-10">
        <div class="max-w-3xl space-y-6">
          <span class="creative-kicker">Contact HQ</span>
          <h1 class="creative-title tone-title text-4xl font-bold sm:text-5xl">
            Let’s scope your next initiative
            <span class="text-[#ccff00]">—with speed and clarity.</span>
          </h1>
          <p class="creative-copy text-base">
            This is the fastest way to route a serious request. Share context
            once, and we’ll map it to the right team, the right delivery path,
            and the right pace.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={kickoffHref}
              data-kickoff-mailto
              variant="primary"
              className="min-h-[48px]"
            >
              Start a project
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Review services
            </ModernButton>
          </div>

          <div
            id="intake-context"
            class:list={[
              'tone-border tone-surface mt-6 rounded-xl border px-4 py-4',
              !hasIntakeContext && 'hidden',
            ]}
          >
            <p class="tone-muted text-xs uppercase tracking-[0.22em]">
              Live intake context
            </p>
            <div class="mt-3 grid gap-3">
              <div
                id="intake-context-trade-row"
                class:list={[!tradeIntentLabel && 'hidden']}
              >
                <p class="tone-muted text-[11px] uppercase tracking-[0.18em]">
                  Trade focus
                </p>
                <p
                  id="intake-context-trade"
                  class="tone-title mt-1 text-sm font-semibold"
                >
                  {tradeIntentLabel}
                </p>
              </div>
              <div
                id="intake-context-trade-page-row"
                class:list={[!tradePageIntent && 'hidden']}
              >
                <p class="tone-muted text-[11px] uppercase tracking-[0.18em]">
                  Trade route
                </p>
                <p
                  id="intake-context-trade-page"
                  class="tone-body mt-1 text-sm leading-relaxed"
                >
                  {tradePageIntent}
                </p>
              </div>
              <div
                id="intake-context-service-row"
                class:list={[!serviceIntentLabel && 'hidden']}
              >
                <p class="tone-muted text-[11px] uppercase tracking-[0.18em]">
                  Recommended service
                </p>
                <p
                  id="intake-context-service"
                  class="tone-title mt-1 text-sm font-semibold"
                >
                  {serviceIntentLabel}
                </p>
              </div>
              <div
                id="intake-context-solution-row"
                class:list={[!solutionIntentLabel && 'hidden']}
              >
                <p class="tone-muted text-[11px] uppercase tracking-[0.18em]">
                  Selected build path
                </p>
                <p
                  id="intake-context-solution"
                  class="tone-title mt-1 text-sm font-semibold"
                >
                  {solutionIntentLabel}
                </p>
              </div>
              <div
                id="intake-context-brief-row"
                class:list={[!briefIntent && 'hidden']}
              >
                <p class="tone-muted text-[11px] uppercase tracking-[0.18em]">
                  Build brief
                </p>
                <p
                  id="intake-context-brief"
                  class="tone-body mt-1 text-sm leading-relaxed"
                >
                  {briefIntent}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-border tone-surface sticky top-16 z-20 border-y backdrop-blur-xl"
    data-reveal
  >
    <div class="mx-auto max-w-[1220px] px-6 py-4 sm:py-5">
      <div class="flex flex-wrap items-center gap-2">
        <span class="creative-kicker">Navigator</span>
        <a class="creative-chip" href="#channels">Channels</a>
        <a class="creative-chip" href="#intake">Intake Checklist</a>
        <a class="creative-chip" href="#engagement">Engagement Model</a>
        <a class="creative-chip" href="#faq">FAQ</a>
      </div>
    </div>
  </section>

  <section
    id="channels"
    class="tone-border tone-surface scroll-mt-32 border-y"
    data-reveal
  >
    <div class="mx-auto max-w-[1220px] px-6 py-16">
      <div class="max-w-3xl space-y-3">
        <h2 class="creative-title tone-title text-3xl font-semibold">
          Choose the right channel
        </h2>
        <p class="creative-copy text-sm">
          Picking the correct lane means faster first response and fewer
          handoffs.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          contactChannels.map(channel => (
            <ModernCard variant="minimal" className="creative-panel p-6">
              <p class="tone-title text-sm font-semibold">{channel.title}</p>
              <p class="tone-body mt-3 text-sm">{channel.note}</p>
              <a
                class="mt-5 inline-flex text-sm font-semibold text-[#ccff00] hover:underline"
                href={`mailto:${encodeURIComponent(channel.email)}?subject=${encodeURIComponent(channel.subject)}`}
              >
                Email this channel
              </a>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section id="intake" class="tone-surface scroll-mt-32" data-reveal>
    <div class="mx-auto max-w-[1220px] px-6 py-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start">
        <div class="space-y-4">
          <h2 class="creative-title tone-title text-3xl font-semibold">
            What to include in your first message
          </h2>
          <p class="creative-copy text-sm">
            Better context on day one creates better recommendations in the
            first call.
          </p>
        </div>

        <ModernCard
          variant="minimal"
          className="creative-panel tone-elevated p-6"
        >
          <ul class="tone-body space-y-3 text-sm">
            {
              intakeChecklist.map(item => (
                <li class="flex items-start gap-2">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-[#ccff00]" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </ModernCard>
      </div>
    </div>
  </section>

  <section
    id="engagement"
    class="tone-border tone-surface scroll-mt-32 border-y"
    data-reveal
  >
    <div class="mx-auto max-w-[1220px] px-6 py-20">
      <div class="max-w-3xl space-y-3">
        <h2 class="creative-title tone-title text-3xl font-semibold">
          How engagement starts
        </h2>
        <p class="creative-copy text-sm">
          A clear kickoff sequence from first message to active execution.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          engagementSteps.map(step => (
            <ModernCard variant="minimal" className="creative-panel p-6">
              <p class="tone-muted text-xs uppercase tracking-[0.24em]">
                {step.phase}
              </p>
              <p class="tone-body mt-3 text-sm">{step.detail}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-surface" id="faq" data-reveal>
    <div class="mx-auto max-w-[1220px] px-6 py-20">
      <div class="max-w-3xl space-y-4">
        <h2 class="creative-title tone-title text-3xl font-semibold">FAQs</h2>
        <p class="creative-copy text-sm">Quick answers before kickoff.</p>
      </div>

      <div class="mt-10 grid gap-4">
        {
          faqs.map(item => (
            <details class="creative-panel tone-elevated p-6">
              <summary class="tone-title cursor-pointer select-none text-sm font-semibold">
                {item.q}
              </summary>
              <p class="tone-body mt-3 text-sm leading-relaxed">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tone-border tone-surface border-t" data-reveal>
    <div class="mx-auto max-w-[1220px] px-6 py-20">
      <div class="creative-hero-shell p-8">
        <div
          class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
        >
          <div class="max-w-2xl">
            <h2 class="creative-title tone-title text-2xl font-semibold">
              Primary contact
            </h2>
            <p class="tone-body mt-3 text-sm">
              Send your intake summary and we’ll reply with the recommended next
              step.
            </p>
            <p class="tone-body mt-3 text-sm">
              <a
                class="text-[#ccff00] hover:underline"
                href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
              >
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={kickoffHref}
              data-kickoff-mailto
              variant="primary"
              className="min-h-[48px]"
            >
              Email now
            </ModernButton>
            <ModernButton
              href={withBasePath('services/')}
              variant="secondary"
              className="min-h-[48px]"
            >
              Browse services
            </ModernButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script
    is:inline
    define:vars={{
      contactEmail: CONTACT_EMAIL,
      serviceLabels: recommendedServiceLabel,
      solutionLabels: recommendedSolutionLabel,
      tradeLabels: recommendedTradeLabel,
    }}
  >
    (() => {
      const params = new URLSearchParams(window.location.search);
      const serviceKey = (params.get('service') || '').trim();
      const solutionKey = (params.get('solution') || '').trim();
      const briefValue = (params.get('brief') || '').trim();
      const tradeKey = (params.get('trade') || '').trim();
      const tradePageValue = (params.get('tradePage') || '').trim();

      const serviceLabel =
        serviceLabels[serviceKey.toLowerCase()] || serviceKey;
      const solutionLabel = solutionLabels[solutionKey] || solutionKey;
      const tradeLabel = tradeLabels[tradeKey.toLowerCase()] || tradeKey;
      const hasContext = Boolean(
        tradeLabel ||
        tradePageValue ||
        serviceLabel ||
        solutionLabel ||
        briefValue
      );

      const panel = document.getElementById('intake-context');
      const tradeRow = document.getElementById('intake-context-trade-row');
      const tradePageRow = document.getElementById(
        'intake-context-trade-page-row'
      );
      const serviceRow = document.getElementById('intake-context-service-row');
      const solutionRow = document.getElementById(
        'intake-context-solution-row'
      );
      const briefRow = document.getElementById('intake-context-brief-row');
      const tradeValue = document.getElementById('intake-context-trade');
      const tradePageNode = document.getElementById(
        'intake-context-trade-page'
      );
      const serviceValue = document.getElementById('intake-context-service');
      const solutionValue = document.getElementById('intake-context-solution');
      const briefValueNode = document.getElementById('intake-context-brief');

      const applyField = (row, node, value) => {
        if (!(row instanceof HTMLElement) || !(node instanceof HTMLElement)) {
          return;
        }

        row.classList.toggle('hidden', !value);
        node.textContent = value;
      };

      if (panel instanceof HTMLElement) {
        panel.classList.toggle('hidden', !hasContext);
      }

      applyField(tradeRow, tradeValue, tradeLabel);
      applyField(tradePageRow, tradePageNode, tradePageValue);
      applyField(serviceRow, serviceValue, serviceLabel);
      applyField(solutionRow, solutionValue, solutionLabel);
      applyField(briefRow, briefValueNode, briefValue);

      const kickoffSubject = tradeLabel
        ? `New project inquiry — ${tradeLabel}`
        : serviceLabel
          ? `New project inquiry — ${serviceLabel}`
          : solutionLabel
            ? `New project inquiry — ${solutionLabel}`
            : 'New project inquiry';

      const bodyLines = [];
      if (tradeLabel) {
        bodyLines.push(`Trade focus: ${tradeLabel}`);
      }
      if (tradePageValue) {
        bodyLines.push(`Trade page: ${tradePageValue}`);
      }
      if (solutionLabel) {
        bodyLines.push(`Build path: ${solutionLabel}`);
      }
      if (briefValue) {
        bodyLines.push(`Build brief: ${briefValue}`);
      }

      const mailtoParams = new URLSearchParams({ subject: kickoffSubject });
      if (bodyLines.length) {
        mailtoParams.set('body', bodyLines.join('\n\n'));
      }

      const kickoffHref = `mailto:${encodeURIComponent(contactEmail)}?${mailtoParams.toString()}`;

      document.querySelectorAll('[data-kickoff-mailto]').forEach(link => {
        if (link instanceof HTMLAnchorElement) {
          link.href = kickoffHref;
        }
      });
    })();
  </script>
</MarketingLayout>
