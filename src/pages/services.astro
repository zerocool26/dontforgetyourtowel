<script is:inline>
  (() => {
    const initServiceMap = () => {
      const rows = Array.from(
        document.querySelectorAll('[data-service-track]')
      );
      const chips = Array.from(
        document.querySelectorAll('[data-service-route-chip]')
      );
      const lane = document.querySelector('[data-service-receipt-lane]');
      const scope = document.querySelector('[data-service-receipt-scope]');
      const output = document.querySelector('[data-service-receipt-output]');
      const proof = document.querySelector('[data-service-receipt-proof]');

      if (
        !(lane instanceof HTMLElement) ||
        !(scope instanceof HTMLElement) ||
        !(output instanceof HTMLElement) ||
        !(proof instanceof HTMLElement)
      ) {
        return;
      }

      if (lane.dataset.serviceMapBound === 'true') {
        return;
      }

      lane.dataset.serviceMapBound = 'true';

      const setActiveTrack = trackId => {
        const activeRow = rows.find(
          row =>
            row instanceof HTMLButtonElement &&
            row.dataset.serviceTrack === trackId
        );

        if (!(activeRow instanceof HTMLButtonElement)) return;

        rows.forEach(row => {
          if (!(row instanceof HTMLButtonElement)) return;
          const isActive = row === activeRow;
          row.classList.toggle('is-active', isActive);
          row.setAttribute('aria-pressed', String(isActive));
        });

        chips.forEach(chip => {
          if (!(chip instanceof HTMLButtonElement)) return;
          const isActive = chip.dataset.serviceRouteChip === trackId;
          chip.classList.toggle('is-active', isActive);
          chip.setAttribute('aria-pressed', String(isActive));
        });

        lane.textContent = activeRow.dataset.serviceLane || '';
        scope.textContent = activeRow.dataset.serviceScope || '';
        output.textContent = (activeRow.dataset.serviceOutput || '').replaceAll(
          '|',
          ' + '
        );
        proof.textContent = (activeRow.dataset.serviceProof || '').replaceAll(
          '|',
          ' + '
        );
      };

      rows.forEach(row => {
        if (!(row instanceof HTMLButtonElement)) return;
        row.addEventListener('click', () => {
          setActiveTrack(row.dataset.serviceTrack || '');
        });
      });

      chips.forEach(chip => {
        if (!(chip instanceof HTMLButtonElement)) return;
        chip.addEventListener('click', () => {
          setActiveTrack(chip.dataset.serviceRouteChip || '');
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initServiceMap, {
        once: true,
      });
    } else {
      initServiceMap();
    }

    document.addEventListener('astro:page-load', initServiceMap);
  })();
</script>

