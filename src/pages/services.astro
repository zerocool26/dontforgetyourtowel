---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import TradeDirectoryCard from '../components/business/TradeDirectoryCard.astro';
import ServiceCatalog from '../components/business/ServiceCatalog.tsx';
import ServiceComparisonMatrix from '../components/business/ServiceComparisonMatrix.tsx';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import FAQAccordion from '../components/ui/FAQAccordion.tsx';
import { CONTACT_EMAIL } from '../consts';
import { servicesExtended } from '../data/services-extended';
import { servicesFaqs, pricingTiers } from '../data/pricing';
import { tradeProfiles } from '../data/trades';
import { withBasePath } from '../utils/helpers';

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Services and trades inquiry')}`;

const serviceCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Services Hub',
    item: new URL(withBasePath('services/'), Astro.site).toString(),
  },
];

const pageNavigator = {
  label: 'Services Hub',
  accent: '#ccff00',
  items: [
    { id: 'services-hero', label: 'Hub Overview', shortLabel: 'Overview' },
    { id: 'trade-surface', label: 'Trade Surface', shortLabel: 'Trades' },
    { id: 'service-catalog', label: 'Catalog Depth', shortLabel: 'Catalog' },
    {
      id: 'service-planner',
      label: 'Planning Tools',
      shortLabel: 'Planner',
    },
    { id: 'service-quiz', label: 'Recommendation Engine', shortLabel: 'Quiz' },
    { id: 'faq', label: 'Scope FAQ', shortLabel: 'FAQ' },
  ],
};
---

<MarketingLayout
  title="Services Hub | Olive Global Systems"
  description="Integrated services hub for all seven trades, with the retained MSP, security, cloud, AI, and digital systems catalog still live."
  bodyClass="creative-page bg-[#02040a]"
  showFooter={true}
  pageNavigator={pageNavigator}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Services Hub',
      description:
        'Integrated services hub covering all seven trades plus the retained technology services catalog.',
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: breadcrumbItems }} />

  <section
    class="tone-surface relative scroll-mt-32 overflow-hidden pb-14 pt-28"
    data-reveal
    id="services-hero"
    data-page-section
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(204,255,0,0.12),transparent_52%)]"
    >
    </div>
    <div class="mx-auto max-w-[1400px] px-6">
      <div
        class="creative-hero-shell grid gap-8 p-8 xl:grid-cols-[1.1fr_0.9fr]"
      >
        <div class="space-y-5">
          <p class="creative-kicker">Services Hub</p>
          <h1
            class="tone-title text-5xl font-semibold tracking-tight sm:text-6xl"
          >
            Seven trades up front. Full tech catalog still alive underneath.
          </h1>
          <p class="tone-body max-w-3xl text-base leading-relaxed">
            This page now acts as the cross-trade services hub. The new trade
            architecture sits at the top, while the original MSP, security,
            cloud, AI, pricing, and planning tools remain part of the same
            experience instead of being cut out.
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/')}
              variant="primary"
              className="min-h-[48px]"
            >
              Browse trade directory
            </ModernButton>
            <ModernButton
              href={startProjectHref}
              variant="secondary"
              className="min-h-[48px]"
            >
              Start service intake
            </ModernButton>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.24em]">
              Trade lanes
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {tradeProfiles.length}
            </p>
            <p class="tone-body mt-2 text-sm">
              Physical trades plus MSP / tech services in one linked structure.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.24em]">
              Catalog depth
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">
              {servicesExtended.length}+
            </p>
            <p class="tone-body mt-2 text-sm">
              Specialist technology services preserved from the original site.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.24em]">
              Planner mode
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">Live</p>
            <p class="tone-body mt-2 text-sm">
              Existing comparison tools still guide pricing and service fit.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <p class="tone-muted text-xs uppercase tracking-[0.24em]">
              Site role
            </p>
            <p class="tone-title mt-2 text-3xl font-semibold">Bridge page</p>
            <p class="tone-body mt-2 text-sm">
              Connects the landing page, trade pages, pricing, and retained
              technical features.
            </p>
          </ModernCard>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    data-reveal
    id="trade-surface"
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-6 py-10">
      <div
        class="flex flex-col gap-4 border-b border-white/10 pb-6 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-3xl space-y-3">
          <p class="creative-kicker">Trade Surface</p>
          <h2 class="tone-title text-4xl font-semibold tracking-tight">
            Every trade is linked here first.
          </h2>
          <p class="tone-body text-sm">
            The services hub is no longer tech-only. It now routes into the
            seven-trade system while keeping the deeper digital catalog and
            tools intact.
          </p>
        </div>
        <ModernButton
          href={withBasePath('trades/')}
          variant="secondary"
          className="min-h-[48px]"
        >
          Open all trade pages
        </ModernButton>
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {tradeProfiles.map(trade => <TradeDirectoryCard trade={trade} />)}
      </div>
    </div>
  </section>

  <section class="tone-surface" data-reveal>
    <div class="mx-auto max-w-[1400px] px-6 py-10">
      <div class="grid gap-5 xl:grid-cols-[0.95fr_1.05fr]">
        <ModernCard variant="minimal" className="creative-panel p-7">
          <p class="creative-kicker">Tech Service Lanes</p>
          <h2 class="tone-title mt-4 text-3xl font-semibold">
            MSP and digital services remain a major part of the platform.
          </h2>
          <p class="tone-body mt-3 text-sm">
            These categories are preserved from the original services build and
            now sit inside the same site map as the physical trades.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              serviceCategories.map(category => (
                <span class="creative-chip">{category}</span>
              ))
            }
          </div>
        </ModernCard>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            pricingTiers.slice(0, 4).map(tier => (
              <ModernCard variant="minimal" className="creative-panel p-5">
                <p class="tone-muted text-xs uppercase tracking-[0.24em]">
                  {tier.bestFor}
                </p>
                <p class="tone-title mt-2 text-2xl font-semibold">
                  {tier.name}
                </p>
                <p class="tone-title mt-2 text-xl">{tier.price}</p>
                <p class="tone-body mt-2 text-sm">{tier.description}</p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-border tone-surface scroll-mt-32 overflow-hidden border-y"
    data-reveal
    id="service-catalog"
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-6 py-20">
      <div class="mb-10 max-w-3xl space-y-4">
        <p class="creative-kicker">Comprehensive Catalog</p>
        <h2 class="tone-title text-4xl font-semibold tracking-tight">
          The original high-depth technology catalog is still available.
        </h2>
        <p class="tone-body text-sm">
          This is the retained catalog for managed services, security, cloud,
          AI, development, networking, and cloud platform work. It now supports
          the MSP / tech trade inside the broader seven-trade experience.
        </p>
      </div>

      <ServiceCatalog client:visible services={servicesExtended} />
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    id="service-planner"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-6 py-20">
      <div class="max-w-3xl space-y-4">
        <p class="creative-kicker">Planning Tools</p>
        <h2 class="tone-title text-3xl font-semibold">
          Keep the live comparison and recommendation tooling.
        </h2>
        <p class="tone-body text-sm">
          The existing planner remains part of the site so technology buyers can
          still compare options without losing the new trade architecture.
        </p>
      </div>

      <div class="mt-10">
        <ServiceComparisonMatrix client:visible services={servicesExtended} />
      </div>
    </div>
  </section>

  <section
    class="tone-surface scroll-mt-32"
    data-reveal
    id="service-quiz"
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-6 py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="space-y-4">
          <p class="creative-kicker">Recommendation Engine</p>
          <h2 class="tone-title text-3xl font-semibold">
            Keep the service quiz as a fast entry point.
          </h2>
          <p class="tone-body text-sm">
            Buyers can still use the existing quiz to get guided direction, then
            branch into the trade pages or the deeper MSP service catalog.
          </p>
        </div>
        <div class="tone-border tone-surface rounded-2xl border p-6">
          <ServicesQuiz client:visible />
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-border tone-surface scroll-mt-32 border-y"
    id="faq"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1400px] px-6 py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div class="space-y-4">
          <p class="creative-kicker">FAQ</p>
          <h2 class="tone-title text-3xl font-semibold">
            Common questions about fit, scope, and next steps.
          </h2>
          <p class="tone-body text-sm">
            The supporting FAQ remains live and continues to serve buyers who
            need clarity before they route into a trade page or pricing path.
          </p>
        </div>

        <div>
          <FAQAccordion client:visible items={servicesFaqs} />
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
