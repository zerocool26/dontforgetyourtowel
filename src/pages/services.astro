---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ServiceCatalog from '../components/business/ServiceCatalog.tsx';
import ServiceComparisonMatrix from '../components/business/ServiceComparisonMatrix.tsx';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import FAQAccordion from '../components/ui/FAQAccordion.tsx';
import { CONTACT_EMAIL } from '../consts';
import { servicesExtended } from '../data/services-extended';
import { servicesFaqs, pricingTiers } from '../data/pricing';
import { tradeProfiles, tradePrograms } from '../data/trades';
import { getTradeOperations } from '../data/trade-operations';
import { withBasePath } from '../utils/helpers';

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Services and trades inquiry')}`;

const serviceCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);

const tradeCards = tradeProfiles.map(trade => ({
  trade,
  operations: getTradeOperations(trade.slug),
}));

const entryLanes = [
  {
    title: 'Facility and building work',
    copy: 'Start here for renovations, retrofits, shutdown-sensitive MEP work, equipment replacement, or phased turnover.',
    href: withBasePath('trades/'),
    cta: 'Browse trade lanes',
  },
  {
    title: 'Managed technology and business systems',
    copy: 'Use this path for IT support, security, cloud, automation, ecommerce, reporting, and day-to-day operational tooling.',
    href: '#technology-catalog',
    cta: 'Open technology catalog',
  },
  {
    title: 'Cross-trade planning and comparisons',
    copy: 'If you are not sure which lane should lead, use the comparison tools and quiz to find the right starting point.',
    href: '#service-planner',
    cta: 'Compare service options',
  },
];

const serviceSections = [
  { label: 'Trade lanes', href: '#trade-surface' },
  { label: 'Tech catalog', href: '#technology-catalog' },
  { label: 'Comparison', href: '#service-planner' },
  { label: 'Quiz', href: '#service-quiz' },
  { label: 'FAQ', href: '#faq' },
];

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Services Hub',
    item: new URL(withBasePath('services/'), Astro.site).toString(),
  },
];
---

<MarketingLayout
  title="Services Hub | Olive Global Systems"
  description="Buyer-focused services hub for trade delivery, managed technology, pricing guidance, and service-planning tools."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Services Hub',
      description:
        'Integrated services hub covering trade delivery, managed technology, pricing guidance, and planning tools.',
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: breadcrumbItems }} />

  <section
    class="tone-section-divider border-b"
    id="services-hero"
    data-reveal
    data-page-section
  >
    <div
      class="mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-end">
        <div class="space-y-6">
          <div class="space-y-3">
            <p
              class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
            >
              Services hub
            </p>
            <h1
              class="max-w-4xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
            >
              Choose the right lane across trades, cloud, AI, and security.
            </h1>
            <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
              Use this page to route building work, managed technology, or
              blended programs without guessing which lane should lead.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <ModernButton
              href={withBasePath('trades/')}
              variant="primary"
              className="min-h-[50px]"
            >
              Browse trade lanes
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review pricing guidance
            </ModernButton>
            <ModernButton
              href={startProjectHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Start service intake
            </ModernButton>
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            {
              serviceSections.map(section => (
                <a
                  href={section.href}
                  class="tone-chip-soft tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:gap-4">
          <ModernCard variant="glass" className="p-5">
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
            >
              Trade coverage
            </p>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-white">
              {tradeProfiles.length}
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Distinct divisions with their own scopes and delivery logic.
            </p>
          </ModernCard>
          <ModernCard variant="glass" className="p-5">
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
            >
              Technology depth
            </p>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-white">
              {servicesExtended.length}+
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Managed IT, security, cloud, AI, automation, ecommerce, and
              platform support.
            </p>
          </ModernCard>
          <ModernCard variant="glass" className="p-5">
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
            >
              Planning tools
            </p>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-white">
              Live
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Matrix, quiz, pricing guidance, and calculators stay available.
            </p>
          </ModernCard>
          <ModernCard variant="glass" className="p-5">
            <p
              class="font-mono text-[0.66rem] uppercase tracking-[0.22em] text-white/45"
            >
              Best use
            </p>
            <p class="mt-3 text-2xl font-semibold tracking-tight text-white">
              Early qualification
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              Decide which division should lead before discovery starts.
            </p>
          </ModernCard>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-entry"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Where to start
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Three common ways buyers enter the platform.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Pick the closest fit, then move deeper only where needed.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          entryLanes.map(item => (
            <ModernCard
              href={item.href}
              variant="default"
              className="h-full p-7"
            >
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <span class="tone-accent-link text-sm font-semibold">
                  {item.cta} →
                </span>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="trade-surface"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-3xl space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Trade directory snapshot
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Each trade is described by delivery logic, not generic copy.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            The cards below help buyers route to the right lane faster.
          </p>
        </div>
        <ModernButton
          href={withBasePath('trades/')}
          variant="secondary"
          className="min-h-[48px] shrink-0"
        >
          Open full trade directory
        </ModernButton>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          tradeCards.map(({ trade, operations }) => (
            <a
              href={withBasePath(`trades/${trade.slug}/`)}
              class="premium-card premium-card--interactive group block p-6"
              style={`--trade-accent:${trade.accent};`}
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div
                    class="inline-flex h-11 w-11 items-center justify-center rounded-lg border text-sm font-semibold uppercase tracking-[0.18em] text-white"
                    style={`border-color:color-mix(in srgb, var(--trade-accent) 40%, rgba(255,255,255,0.12)); background:color-mix(in srgb, var(--trade-accent) 16%, transparent);`}
                  >
                    {trade.badge}
                  </div>
                  <p class="mt-4 text-xs uppercase tracking-[0.22em] text-white/45">
                    {trade.eyebrow}
                  </p>
                </div>
                <span class="tone-chip-neutral rounded-full border px-3 py-1 text-[0.65rem] uppercase tracking-[0.22em] text-white/55">
                  {trade.shortName}
                </span>
              </div>

              <h3 class="mt-4 text-xl font-semibold text-white">
                {trade.name}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {trade.summary}
              </p>

              <dl class="tone-divider-top mt-6 space-y-4 pt-5 text-sm">
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Operating model
                  </dt>
                  <dd class="mt-1 text-slate-100">
                    {operations.operatingModel}
                  </dd>
                </div>
                <div>
                  <dt class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-white/45">
                    Owner output
                  </dt>
                  <dd class="mt-1 text-slate-300">
                    {operations.ownerOutputs[0]}
                  </dd>
                </div>
              </dl>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-programs"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Cross-trade programs
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Some problems are not single-service problems.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          These recurring program types show where the right answer is
          coordinated delivery.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          tradePrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-white/45">
                {program.tradeSlugs.length} linked trades
              </p>
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>
              <ul class="mt-5 space-y-2 text-sm text-slate-300">
                {program.outputs.map(output => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{output}</span>
                  </li>
                ))}
              </ul>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="technology-catalog"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 xl:grid-cols-[0.9fr_1.1fr] xl:items-start">
        <ModernCard variant="glass" className="p-7">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Technology and business systems
          </p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white">
            The digital catalog is still here — just framed more clearly.
          </h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">
            Managed IT, security, cloud, AI, automation, and digital systems
            remain core services inside a cleaner buyer journey.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              serviceCategories.map(category => (
                <span class="tone-chip-soft rounded-full px-3 py-1.5 text-xs font-medium text-slate-200">
                  {category}
                </span>
              ))
            }
          </div>
        </ModernCard>

        <div class="grid gap-4 sm:grid-cols-3">
          {
            pricingTiers.slice(0, 3).map(tier => (
              <ModernCard
                variant={tier.highlight ? 'gradient' : 'default'}
                className="h-full p-5"
              >
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  {tier.bestFor}
                </p>
                <p class="mt-3 text-2xl font-semibold tracking-tight text-white">
                  {tier.name}
                </p>
                <p class="mt-2 text-base font-medium text-slate-100">
                  {tier.price}
                </p>
                <p class="mt-3 text-sm leading-6 text-slate-300">
                  {tier.description}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>

      <div class="mt-12">
        <ServiceCatalog client:visible services={servicesExtended} />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-planner"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="max-w-3xl space-y-4">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
        >
          Comparison tools
        </p>
        <h2
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Compare service options before you commit to discovery.
        </h2>
        <p class="text-base leading-7 text-slate-300">
          Use the matrix to narrow the likely engagement shape before intake.
        </p>
      </div>

      <div class="mt-10">
        <ServiceComparisonMatrix client:visible services={servicesExtended} />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-quiz"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            Recommendation quiz
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Not sure what you need?
          </h2>
          <p class="text-base leading-7 text-slate-300">
            The quiz gives quick direction when the better fit is not obvious
            yet.
          </p>
        </div>

        <div class="tone-panel-soft rounded-2xl p-6">
          <ServicesQuiz client:only="preact" />
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="readiness"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel
        title="Turn a broad service need into a cleaner first scope."
        description="Use the readiness check before intake so the right owner can pick up the work faster."
        compact
      />
    </div>
  </section>

  <section id="faq" data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="space-y-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-white/55"
          >
            FAQ
          </p>
          <h2
            class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            Common questions about fit, timing, and scope.
          </h2>
          <p class="text-base leading-7 text-slate-300">
            These are the questions that usually come up before discovery.
          </p>
        </div>

        <div>
          <FAQAccordion client:visible items={servicesFaqs} />
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
