---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import OperationalIntelligenceWorkbench from '../components/business/OperationalIntelligenceWorkbench.tsx';
import ServiceCatalog from '../components/business/ServiceCatalog.tsx';
import ServiceComparisonMatrix from '../components/business/ServiceComparisonMatrix.tsx';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ResearchRadarPanel from '../components/business/ResearchRadarPanel.astro';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import {
  onboardingPhases,
  providerSelectionQuestions,
  serviceCategoryBriefs,
  serviceOperatingFacts,
  servicesExtended,
} from '../data/services-extended';
import {
  businessAreaServed,
  businessAudience,
  businessOfferCatalog,
} from '../data/business-profile';
import { operatingIntelligenceItems } from '../data/operating-intelligence';
import { servicesFaqs, pricingTiers } from '../data/pricing';
import { withBasePath } from '../utils/helpers';
import { buildContactHqHref } from '../utils/contact';

const startProjectHref = buildContactHqHref({
  service: 'msp',
  brief:
    'I want to discuss support ownership, security, Microsoft 365, backup, network, or workflow support.',
});

const serviceCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);

const workbenchItems = operatingIntelligenceItems.map(item => ({
  ...item,
  ctaHref: withBasePath(item.path),
}));

const caseStudies = (
  (await getCollection('caseStudies')) as CollectionEntry<'caseStudies'>[]
).sort(
  (a, b) =>
    (b.data.published?.valueOf() ?? 0) - (a.data.published?.valueOf() ?? 0)
);

const entryLanes = [
  {
    title: 'Managed IT and support',
    copy: 'Start here when users need a real help path, devices need standards, onboarding is messy, or vendors keep bouncing issues back.',
    href: '#service-tracks',
    cta: 'View support track',
  },
  {
    title: 'Security and compliance',
    copy: 'Use this lane for MFA, admin access, endpoint protection, email risk, backup evidence, cyber-insurance requests, and response planning.',
    href: '#technology-catalog',
    cta: 'Open capability catalog',
  },
  {
    title: 'Cloud, Microsoft 365, and roadmap work',
    copy: 'Use this lane for SharePoint/Teams sprawl, license waste, cloud migration, office changes, automation candidates, or workflow cleanup.',
    href: '#service-planner',
    cta: 'Compare solution options',
  },
];

const serviceSections = [
  { label: 'Diagnostic', href: '#diagnostic-board' },
  { label: 'Tracks', href: '#service-tracks' },
  { label: 'Catalog', href: '#technology-catalog' },
  { label: 'Comparison', href: '#service-planner' },
  { label: 'Proof', href: '#case-studies' },
  { label: 'FAQ', href: '#faq' },
];

const serviceTracks = [
  {
    title: 'Managed IT and support operations',
    copy: 'Stabilize the day-to-day layer first: ticket routing, endpoint standards, onboarding/offboarding, vendor follow-up, reporting, and escalation discipline.',
    detail:
      'Best for teams with recurring tickets, unclear ownership, stale devices, slow provider response, or no useful monthly reporting.',
  },
  {
    title: 'Cybersecurity and compliance motion',
    copy: 'Build a practical security posture around identity, endpoints, email, awareness, backup evidence, incident contacts, and reviewable control notes.',
    detail:
      'Best for cyber-insurance renewals, regulated teams, leadership risk reviews, recent incidents, or environments with too many exceptions.',
  },
  {
    title: 'Cloud and Microsoft 365 modernization',
    copy: 'Clean up Teams, SharePoint, Exchange, OneDrive, external sharing, retention assumptions, licensing, and migration plans before the tenant becomes expensive clutter.',
    detail:
      'Best for teams that depend on Microsoft 365 every day but cannot explain who owns sites, groups, guest access, licenses, or backups.',
  },
  {
    title: 'Workflow portals and intake systems',
    copy: 'Prototype and deliver portals, intake paths, forms, service pages, and client-facing workflows when they support revenue or service.',
    detail:
      'Best for firms where support, sales, onboarding, or customer handoff needs a cleaner digital path.',
  },
];

const deliveryPrograms = [
  {
    title: 'Stabilize and document',
    description:
      'Start with help desk ownership, admin access, endpoint standards, vendor records, and documentation so support stops depending on memory.',
    outputs: ['Support lanes', 'Device inventory', 'Vendor map'],
  },
  {
    title: 'Secure and standardize',
    description:
      'Layer in identity controls, endpoint protection, email safety, backup verification, and incident roles so security becomes normal work.',
    outputs: ['MFA review', 'Backup evidence', 'Incident contacts'],
  },
  {
    title: 'Modernize and streamline',
    description:
      'Use Microsoft 365 cleanup, cloud work, small automations, and workflow improvements when they remove real friction.',
    outputs: ['M365 rules', 'Workflow shortlist', 'Intake-path fixes'],
  },
];

const diagnosticBoard = [
  {
    lane: 'Support drag',
    trigger: 'Tickets close, but the same users and issues keep coming back.',
    inspect: [
      'Recurring ticket patterns',
      'Onboarding and offboarding gaps',
      'Endpoint age, warranty, patch state, and setup standards',
    ],
    output:
      'A support ownership map with escalation rules, vendor handoffs, and recurring-issue reduction targets.',
  },
  {
    lane: 'Security ambiguity',
    trigger:
      'Leadership cannot tell whether the basics are actually under control.',
    inspect: [
      'MFA and conditional access',
      'Endpoint and email controls',
      'Backup coverage, restore proof, and incident contacts',
    ],
    output:
      'A practical security baseline with evidence, insurance-readiness notes, and the next control sequence.',
  },
  {
    lane: 'Microsoft 365 sprawl',
    trigger: 'Teams, SharePoint, licensing, and access rules feel improvised.',
    inspect: [
      'Tenant governance, guest access, and risky sharing',
      'SharePoint/Teams lifecycle',
      'Retention, backup, and license usage',
    ],
    output:
      'A cleanup roadmap that separates urgent risk, governance rules, and workflow wins.',
  },
  {
    lane: 'Workflow trust gap',
    trigger:
      'The portal, intake path, or client handoff undersells the quality of the business.',
    inspect: [
      'Mobile service path',
      'Trust signals and intake clarity',
      'Content, performance, analytics, and launch constraints',
    ],
    output:
      'A workflow improvement plan with priority pages, trust gaps, and measurable launch criteria.',
  },
];

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Services Hub',
    item: new URL(withBasePath('services/'), Astro.site).toString(),
  },
];
---

<MarketingLayout
  title="Services Hub | CHICAGOS #1 MSP"
  description="Chicago-focused managed IT, cybersecurity, Microsoft 365, cloud, backup, networking, and workflow support."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page buyer-reframe services-reframe"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Services Hub',
      description:
        'Buyer-focused solution hub for managed operations, security, Microsoft 365, cloud, backup, onboarding, and workflow support.',
    }}
  />
  <StructuredData
    type="service"
    data={{
      name: 'Chicago managed IT, cybersecurity, Microsoft 365, backup, and network support',
      serviceType: 'Managed IT services',
      areaServed: businessAreaServed,
      audience: businessAudience.map(name => ({
        '@type': 'BusinessAudience',
        name,
      })),
      hasOfferCatalog: businessOfferCatalog,
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: breadcrumbItems }} />

  <section
    class="tone-page-hero tone-section-divider border-b"
    id="services-hero"
    data-reveal
    data-page-section
  >
    <div
      class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Chicago services hub</p>
            <h1 class="tone-page-title">
              Services that make IT feel owned again.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Pick the problem first: support drag, risky access, Microsoft 365
              sprawl, backup doubt, network friction, or a workflow that should
              help the business instead of slowing it down.
            </p>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href={startProjectHref}
              variant="primary"
              className="min-h-[50px]"
            >
              Start fit check
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              See pricing
            </ModernButton>
          </div>

          <div class="tone-page-jump-links pt-1">
            {
              serviceSections.map(section => (
                <a
                  href={section.href}
                  class="tone-chip-soft tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid gap-4">
          <ModernCard variant="glass" className="tone-metric-card p-6">
            <p class="tone-metric-card__label">How to use this page</p>
            <p class="tone-metric-card__value">Diagnose first</p>
            <p class="tone-metric-card__detail">
              Start with the symptom, then use the tracks and catalog to see
              what should be owned, measured, and handled first.
            </p>
          </ModernCard>
          <div class="grid gap-4 sm:grid-cols-2">
            <ModernCard variant="default" className="tone-metric-card p-5">
              <p class="tone-metric-card__label">Solution lanes</p>
              <p class="tone-metric-card__value">4</p>
              <p class="tone-metric-card__detail">
                Support, security, modernization, and workflow support.
              </p>
            </ModernCard>
            <ModernCard variant="default" className="tone-metric-card p-5">
              <p class="tone-metric-card__label">Technology depth</p>
              <p class="tone-metric-card__value">
                {serviceCategories.length}
              </p>
              <p class="tone-metric-card__detail">
                Specific enough for scoping, calm enough for a first pass.
              </p>
            </ModernCard>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ProofOperatingSystem
    compact
    eyebrow="Service proof system"
    title="Every service has to produce an artifact."
    description="Support, security, Microsoft 365, and recovery work should leave behind visible ownership, evidence, and decisions."
    ctaHref={startProjectHref}
    ctaLabel="Start service fit check"
  />

  <section
    class="tone-section-divider border-b"
    id="decision-handoff"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Service handoff"
        title="Choose the first service lane by the output you need."
        description="The right starting point is easier to defend when the pressure, evidence, and first deliverable are visible before the catalog opens."
      />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="diagnostic-board"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Decision diagnostic</p>
          <h2 class="tone-section-title">
            Start with the symptom. The right service lane gets obvious fast.
          </h2>
          <p class="tone-section-copy">
            Buyers do not need a giant catalog first. They need to know what
            should be inspected, what gets stabilized, who owns the next action,
            and what output they should expect to see.
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {
            diagnosticBoard.map(item => (
              <ModernCard variant="glass" className="h-full p-6">
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  {item.lane}
                </p>
                <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                  {item.trigger}
                </h3>
                <div class="tone-divider-top mt-5 pt-5">
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    First inspection
                  </p>
                  <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-300">
                    {item.inspect.map(check => (
                      <li class="flex items-start gap-2">
                        <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                        <span>{check}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="tone-divider-top mt-5 pt-5 text-sm leading-7 text-slate-200">
                  {item.output}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="research-radar"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ResearchRadarPanel />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="operating-intelligence"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <OperationalIntelligenceWorkbench
        client:only="preact"
        compact
        items={workbenchItems}
        defaultItemId="security-evidence"
        eyebrow="Service intelligence"
        title="Turn symptoms into service scope, evidence, and first actions."
        description="A serious service page should help a buyer diagnose the problem. This workbench maps common operating pressure into ownership, evidence, automation candidates, and the next route."
      />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-tracks"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Core tracks</p>
          <h2 class="tone-section-title">
            Four realistic ways the engagement usually enters an environment.
          </h2>
          <p class="tone-section-copy">
            Most engagements start in one lane, then pull in adjacent work only
            when it clearly supports the first outcome.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          serviceTracks.map(track => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{track.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{track.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  Best fit
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-200">
                  {track.detail}
                </p>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="onboarding"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Onboarding</p>
        <h2 class="tone-section-title">
          The first 90 days should show real control.
        </h2>
        <p class="tone-section-copy">
          Onboarding should not feel like a handoff into a black box. It should
          define access, support channels, security baseline, backup evidence,
          recurring issues, Microsoft 365 cleanup, vendor handoffs, and the
          first roadmap.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-4">
        {
          onboardingPhases.map(phase => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {phase.phase}
              </p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                {phase.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{phase.goal}</p>
              <ul class="mt-5 space-y-2 text-sm leading-6 text-slate-300">
                {phase.checkpoints.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="tone-divider-top mt-5 pt-4">
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                  Buyer-visible output
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-200">
                  {phase.buyerVisibleOutput}
                </p>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="case-studies"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Proof stories</p>
        <h2 class="tone-section-title">
          Proof should sound like before, after, and what changed.
        </h2>
        <p class="tone-section-copy">
          These are anonymized examples of practical outcomes: fewer repeat
          issues, cleaner ownership, better evidence, and clearer next steps.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          caseStudies.map(study => (
            <ModernCard variant="glass" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {study.data.industry}
              </p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                {study.data.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {study.data.summary}
              </p>

              <div class="tone-divider-top mt-5 grid gap-4 pt-5">
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    Challenge
                  </p>
                  <p class="mt-2 text-sm leading-6 text-slate-300">
                    {study.data.challenge}
                  </p>
                </div>
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    Work performed
                  </p>
                  <p class="mt-2 text-sm leading-6 text-slate-300">
                    {study.data.solution}
                  </p>
                </div>
              </div>

              <div class="mt-5 grid gap-3 sm:grid-cols-3">
                {study.data.results.map(result => (
                  <div class="tone-panel-soft rounded-xl p-3">
                    <p class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-white/40">
                      {result.label}
                    </p>
                    <p class="mt-2 text-sm font-semibold text-white">
                      {result.value}
                    </p>
                  </div>
                ))}
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="selection-questions"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Selection questions</p>
          <h2 class="tone-section-title">
            Ask these before signing an MSP agreement.
          </h2>
          <p class="tone-section-copy">
            Strong providers should answer these directly. The answers reveal
            whether the engagement is built around operations or just a bundle
            of tools with a monthly invoice.
          </p>
        </div>

        <div class="grid gap-3">
          {
            providerSelectionQuestions.map(item => (
              <ModernCard variant="outline" className="p-5">
                <h3 class="text-base font-semibold text-white">
                  {item.question}
                </h3>
                <p class="mt-2 text-sm leading-6 text-slate-300">
                  {item.whyItMatters}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-entry"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Where to start</p>
        <h2 class="tone-section-title">Three simple entry points.</h2>
        <p class="tone-section-copy">
          Choose the closest path if you already know what you need. Otherwise,
          the diagnostic above is the cleaner start.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          entryLanes.map(item => (
            <ModernCard
              href={item.href}
              variant="default"
              className="h-full p-7"
            >
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <span class="tone-accent-link text-sm font-semibold">
                  {item.cta} →
                </span>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-programs"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Delivery programs</p>
        <h2 class="tone-section-title">
          Good scopes blend capability without becoming a grab bag.
        </h2>
        <p class="tone-section-copy">
          The point is to stack the right work in the right order so the
          environment gets easier to support before it gets more ambitious.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          deliveryPrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7">
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>
              <ul class="mt-5 space-y-2 text-sm text-slate-300">
                {program.outputs.map(output => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{output}</span>
                  </li>
                ))}
              </ul>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="buyer-guide"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Buyer guide</p>
        <h2 class="tone-section-title">
          What gets inspected before a responsible recommendation.
        </h2>
        <p class="tone-section-copy">
          A useful scope starts with the buyer question, the evidence to check,
          and the first outputs leadership should see.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          serviceOperatingFacts.map(item => (
            <ModernCard variant="glass" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{item.label}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>

      <div class="mt-10 grid gap-5 xl:grid-cols-2">
        {
          serviceCategoryBriefs.map(brief => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {brief.category}
              </p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                {brief.buyerQuestion}
              </h3>

              <div class="mt-6 grid gap-5 md:grid-cols-3">
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    We check
                  </p>
                  <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-300">
                    {brief.whatWeCheck.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    First outputs
                  </p>
                  <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-300">
                    {brief.firstOutputs.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    Warning signs
                  </p>
                  <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-300">
                    {brief.warningSigns.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="technology-catalog"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 xl:grid-cols-[0.9fr_1.1fr] xl:items-start">
        <ModernCard variant="glass" className="p-7">
          <p class="tone-section-kicker">Technology and business systems</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white">
            The catalog is for validation, not the starting point.
          </h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">
            Use the catalog once the lane is clear. It shows the systems the
            team can own across support, security, Microsoft 365, cloud,
            continuity, networking, vendor coordination, advisory, and selective
            project work.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              serviceCategories.map(category => (
                <span class="tone-chip-soft rounded-full px-3 py-1.5 text-xs font-medium text-slate-200">
                  {category}
                </span>
              ))
            }
          </div>
        </ModernCard>

        <div class="grid gap-4 sm:grid-cols-3">
          {
            pricingTiers.slice(0, 3).map(tier => (
              <ModernCard
                variant={tier.highlight ? 'gradient' : 'default'}
                className="h-full p-5"
              >
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  {tier.bestFor}
                </p>
                <p class="mt-3 text-2xl font-semibold tracking-tight text-white">
                  {tier.name}
                </p>
                <p class="mt-2 text-base font-medium text-slate-100">
                  {tier.price}
                </p>
                <p class="mt-3 text-sm leading-6 text-slate-300">
                  {tier.description}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>

      <div class="mt-12">
        <ServiceCatalog client:only="preact" services={servicesExtended} />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-planner"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Comparison tools</p>
        <h2 class="tone-section-title">
          Compare solution shapes before a scoped conversation.
        </h2>
        <p class="tone-section-copy">
          Use the matrix to narrow the likely engagement shape before you start
          a scoped conversation or ask for a first-phase plan.
        </p>
      </div>

      <div class="mt-10">
        <ServiceComparisonMatrix
          client:only="preact"
          services={servicesExtended}
        />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-quiz"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Recommendation quiz</p>
          <h2 class="tone-section-title">Not sure what you need?</h2>
          <p class="tone-section-copy">
            The quiz gives quick direction when the best mix of coverage and
            modernization is not obvious yet.
          </p>
        </div>

        <div class="tone-panel-soft rounded-2xl p-6">
          <ServicesQuiz client:only="preact" />
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="readiness"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel
        title="Turn a broad service need into a cleaner first scope."
        description="Use the readiness check before intake so the right owner can pick up the work faster and with less back-and-forth."
        compact
      />
    </div>
  </section>

  <section id="faq" data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">FAQ</p>
          <h2 class="tone-section-title">
            Common questions about fit, timing, and scope.
          </h2>
          <p class="tone-section-copy">
            These are the questions that usually come up before discovery.
          </p>
        </div>

        <div>
          <FAQAccordion items={servicesFaqs} />
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
