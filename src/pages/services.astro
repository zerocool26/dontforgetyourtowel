---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import StructuredData from '../components/StructuredData.astro';
import ServiceDiagnosticBoard from '../components/business/ServiceDiagnosticBoard.tsx';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import OperationalIntelligenceWorkbench from '../components/business/OperationalIntelligenceWorkbench.tsx';
import ServiceCatalog from '../components/business/ServiceCatalog.tsx';
import ServiceComparisonMatrix from '../components/business/ServiceComparisonMatrix.tsx';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import DecisionHandoffPanel from '../components/business/DecisionHandoffPanel.astro';
import ProofOperatingSystem from '../components/business/ProofOperatingSystem.astro';
import ProviderSelectionStandard from '../components/business/ProviderSelectionStandard.astro';
import RouteProofStrip from '../components/business/RouteProofStrip.astro';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import {
  onboardingPhases,
  serviceCategoryBriefs,
  serviceOperatingFacts,
  servicesExtended,
} from '../data/services-extended';
import { serviceDiagnostics } from '../data/service-diagnostics';
import {
  businessAreaServed,
  businessAudience,
  businessOfferCatalog,
} from '../data/business-profile';
import { operatingIntelligenceItems } from '../data/operating-intelligence';
import { servicesFaqs, pricingTiers } from '../data/pricing';
import { withBasePath } from '../utils/helpers';
import { buildContactHqHref } from '../utils/contact';

const startProjectHref = buildContactHqHref({
  service: 'msp',
  brief:
    'I want to discuss support ownership, security, Microsoft 365, backup, network, or workflow support.',
});
const pricingHref = withBasePath('pricing/');

const serviceDiagnosticItems = serviceDiagnostics.map(diagnostic => ({
  ...diagnostic,
  ctaHref: buildContactHqHref({
    service: diagnostic.serviceParam,
    brief: diagnostic.contactBrief,
  }),
  secondaryHref: diagnostic.secondaryHref.startsWith('#')
    ? diagnostic.secondaryHref
    : withBasePath(diagnostic.secondaryHref),
}));

const serviceCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);

const workbenchItems = operatingIntelligenceItems.map(item => ({
  ...item,
  ctaHref: withBasePath(item.path),
}));

const caseStudies = (
  (await getCollection('caseStudies')) as CollectionEntry<'caseStudies'>[]
).sort(
  (a, b) =>
    (b.data.published?.valueOf() ?? 0) - (a.data.published?.valueOf() ?? 0)
);

const entryLanes = [
  {
    title: 'Managed IT and support',
    copy: 'Start here when users need a real help path, devices need standards, onboarding is messy, or vendors keep bouncing issues back.',
    href: '#service-tracks',
    cta: 'View support track',
  },
  {
    title: 'Security and compliance',
    copy: 'Use this lane for MFA, admin access, endpoint protection, email risk, backup evidence, cyber-insurance requests, and response planning.',
    href: '#technology-catalog',
    cta: 'Open capability catalog',
  },
  {
    title: 'Cloud, Microsoft 365, and roadmap work',
    copy: 'Use this lane for SharePoint/Teams sprawl, license waste, cloud migration, office changes, automation candidates, or workflow cleanup.',
    href: '#service-planner',
    cta: 'Compare solution options',
  },
];

const serviceSections = [
  { label: 'Diagnostics', href: '#diagnostic-board' },
  { label: 'Tracks', href: '#service-tracks' },
  { label: 'Catalog', href: '#technology-catalog' },
  { label: 'Comparison', href: '#service-planner' },
  { label: 'Proof', href: '#case-studies' },
  { label: 'FAQ', href: '#faq' },
];

const serviceRouteProof = [
  {
    label: 'Discover',
    title: 'Problem first',
    copy: 'Support drag, access risk, recovery doubt, or Microsoft 365 sprawl sets the lane.',
    status: 'verified' as const,
    href: '#diagnostic-board',
  },
  {
    label: 'Design',
    title: 'Owner and handoff',
    copy: 'The service path names the first owner, expected proof, and next decision.',
    status: 'planned' as const,
    href: '#decision-handoff',
  },
  {
    label: 'Deliver',
    title: 'Record left behind',
    copy: 'Outputs stay visible as owners, risks, scope notes, and follow-up work.',
    status: 'verified' as const,
    href: '#service-tracks',
  },
];

const serviceTracks = [
  {
    id: 'managed-it',
    icon: 'headset',
    title: 'Managed IT and support',
    owner: 'Senior service lead',
    symptom: 'Support drag. Slow response. No clear owner.',
    firstOutput: ['Environment review', 'Support baseline', 'Quick wins list'],
    proofRequired: ['Response SLAs met for 14 days', 'Backlog reduced'],
    routeProblems: ['Support drag', 'Network friction'],
    scope: 'Help desk, endpoint, users, patching, monitoring, telecom.',
    copy: 'Stabilize the day-to-day layer first: ticket routing, endpoint standards, onboarding/offboarding, vendor follow-up, reporting, and escalation discipline.',
    detail:
      'Best for teams with recurring tickets, unclear ownership, stale devices, slow provider response, or no useful monthly reporting.',
  },
  {
    id: 'security',
    icon: 'shield',
    title: 'Security and compliance',
    owner: 'Security owner',
    symptom: 'Risky access. Insurance pressure. Too many exceptions.',
    firstOutput: ['MFA review', 'Admin access map', 'Response roles'],
    proofRequired: ['Control notes visible', 'Backup evidence checked'],
    routeProblems: ['Risky access', 'Backup doubt'],
    scope: 'Identity, email, endpoint, data, awareness, compliance.',
    copy: 'Build a practical security posture around identity, endpoints, email, awareness, backup evidence, incident contacts, and reviewable control notes.',
    detail:
      'Best for cyber-insurance renewals, regulated teams, leadership risk reviews, recent incidents, or environments with too many exceptions.',
  },
  {
    id: 'cloud-m365',
    icon: 'cloud',
    title: 'Cloud + Microsoft 365',
    owner: 'Tenant and cloud lead',
    symptom: 'M365 sprawl. Licensing waste. No lifecycle rules.',
    firstOutput: ['Tenant cleanup map', 'Sharing review', 'License findings'],
    proofRequired: ['Owners assigned', 'Risky sharing reduced'],
    routeProblems: ['M365 sprawl'],
    scope: 'M365, migration, SharePoint, Teams, licensing, governance.',
    copy: 'Clean up Teams, SharePoint, Exchange, OneDrive, external sharing, retention assumptions, licensing, and migration plans before the tenant becomes expensive clutter.',
    detail:
      'Best for teams that depend on Microsoft 365 every day but cannot explain who owns sites, groups, guest access, licenses, or backups.',
  },
  {
    id: 'workflow',
    icon: 'clipboard',
    title: 'Workflow portals and intake',
    owner: 'Workflow delivery lead',
    symptom: 'Workflow gap. Intake friction. Client handoffs leak trust.',
    firstOutput: ['Path audit', 'Prototype handoff', 'Ownership notes'],
    proofRequired: ['Mobile path reviewed', 'Status feedback defined'],
    routeProblems: ['Workflow gap'],
    scope: 'Intake, approvals, client portals, automations, integrations.',
    copy: 'Prototype and deliver portals, intake paths, forms, service pages, and client-facing workflows when they support revenue or service.',
    detail:
      'Best for firms where support, sales, onboarding, or customer handoff needs a cleaner digital path.',
  },
];

const serviceProblemRoutes = [
  { label: 'Support drag', trackId: 'managed-it' },
  { label: 'Risky access', trackId: 'security' },
  { label: 'M365 sprawl', trackId: 'cloud-m365' },
  { label: 'Backup doubt', trackId: 'security' },
  { label: 'Network friction', trackId: 'managed-it' },
  { label: 'Workflow gap', trackId: 'workflow' },
];

const serviceProofStandards = [
  {
    title: 'Chicago-area only',
    copy: 'We know the paths, providers, and regulations in this market.',
    symbol: 'building',
  },
  {
    title: 'Owner-to-owner',
    copy: 'You work with senior people who take ownership.',
    symbol: 'person',
  },
  {
    title: 'Proof before promise',
    copy: 'We define the proof up front and stand on it.',
    symbol: 'shield',
  },
  {
    title: 'Practical over trendy',
    copy: 'We solve real problems that move the business forward.',
    symbol: 'clipboard',
  },
];

const selectedServiceTrack = serviceTracks[0];

const deliveryPrograms = [
  {
    title: 'Stabilize and document',
    description:
      'Start with help desk ownership, admin access, endpoint standards, vendor records, and documentation so support stops depending on memory.',
    outputs: ['Support lanes', 'Device inventory', 'Vendor map'],
  },
  {
    title: 'Secure and standardize',
    description:
      'Layer in identity controls, endpoint protection, email safety, backup verification, and incident roles so security becomes normal work.',
    outputs: ['MFA review', 'Backup evidence', 'Incident contacts'],
  },
  {
    title: 'Modernize and streamline',
    description:
      'Use Microsoft 365 cleanup, cloud work, small automations, and workflow improvements when they remove real friction.',
    outputs: ['M365 rules', 'Workflow shortlist', 'Intake-path fixes'],
  },
];

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Services Hub',
    item: new URL(withBasePath('services/'), Astro.site).toString(),
  },
];
---

<MarketingLayout
  title="Services Hub | CHICAGOS #1 MSP"
  description="Chicago-focused managed IT, cybersecurity, Microsoft 365, cloud, backup, networking, and workflow support."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page buyer-reframe services-reframe"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Services Hub',
      description:
        'Buyer-focused solution hub for managed operations, security, Microsoft 365, cloud, backup, onboarding, and workflow support.',
    }}
  />
  <StructuredData
    type="service"
    data={{
      name: 'Chicago managed IT, cybersecurity, Microsoft 365, backup, and network support',
      serviceType: 'Managed IT services',
      areaServed: businessAreaServed,
      audience: businessAudience.map(name => ({
        '@type': 'BusinessAudience',
        name,
      })),
      hasOfferCatalog: businessOfferCatalog,
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: breadcrumbItems }} />

  <section
    class="service-map-hero"
    id="services-hero"
    data-reveal
    data-page-section
  >
    <div class="service-map-hero__inner">
      <div class="service-map-hero__copy">
        <h1>Services that make IT feel owned again.</h1>
        <p>
          Pick the problem first: support drag, risky access, Microsoft 365
          sprawl, backup doubt, network friction, or a workflow that should help
          the business instead of slowing it down.
        </p>

        <div class="service-map-hero__actions">
          <ModernButton
            href={startProjectHref}
            variant="primary"
            rounded="sm"
            className="min-h-[52px]"
          >
            Start fit check
          </ModernButton>
          <ModernButton
            href={pricingHref}
            variant="outline"
            rounded="sm"
            className="min-h-[52px]"
          >
            See pricing
          </ModernButton>
        </div>

        <nav class="service-jump-nav" aria-label="Service page sections">
          {
            serviceSections.map(section => (
              <a href={section.href}>{section.label}</a>
            ))
          }
        </nav>
      </div>

      <div class="service-command-board" aria-label="Service ownership map">
        <div class="service-command-board__table">
          <div class="service-command-board__head" aria-hidden="true">
            <span>Owner</span>
            <span>Symptom</span>
            <span>First output</span>
            <span>Proof required</span>
          </div>

          <div class="service-command-board__rows">
            {
              serviceTracks.map((track, index) => (
                <button
                  type="button"
                  class:list={[
                    'service-command-row',
                    index === 0 && 'is-active',
                  ]}
                  data-service-track={track.id}
                  data-service-lane={track.title}
                  data-service-owner={track.owner}
                  data-service-symptom={track.symptom}
                  data-service-scope={track.scope}
                  data-service-output={track.firstOutput.join('|')}
                  data-service-proof={track.proofRequired.join('|')}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span class="service-command-row__lane">
                    <span
                      class:list={['service-icon', `is-${track.icon}`]}
                      aria-hidden="true"
                    />
                    <span>{track.title}</span>
                  </span>
                  <span>{track.symptom}</span>
                  <span>
                    {track.firstOutput.map(item => (
                      <em>{item}</em>
                    ))}
                  </span>
                  <span>
                    {track.proofRequired.map(item => (
                      <em>{item}</em>
                    ))}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <aside class="service-receipt" aria-live="polite">
          <p>Service receipt</p>
          <div>
            <span>Lane</span>
            <strong data-service-receipt-lane
              >{selectedServiceTrack.title}</strong
            >
          </div>
          <div>
            <span>What we own</span>
            <p data-service-receipt-scope>{selectedServiceTrack.scope}</p>
          </div>
          <div>
            <span>First output</span>
            <p data-service-receipt-output>
              {selectedServiceTrack.firstOutput.join(' + ')}
            </p>
          </div>
          <div>
            <span>Proof we require</span>
            <p data-service-receipt-proof>
              {selectedServiceTrack.proofRequired.join(' + ')}
            </p>
          </div>
          <div class="service-receipt__barcode" aria-hidden="true"></div>
          <small>We do not start without proof.</small>
        </aside>

        <div class="service-route-problems" aria-label="Route by problem">
          <span>Route by problem</span>
          <div>
            {
              serviceProblemRoutes.map((problem, index) => (
                <button
                  type="button"
                  class:list={[
                    'service-route-chip',
                    index === 0 && 'is-active',
                  ]}
                  data-service-route-chip={problem.trackId}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  {problem.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="service-proof-standards" aria-label="Service proof standards">
    <div class="service-proof-standards__inner">
      <h2>Proof we stand on</h2>
      <div class="service-proof-standards__grid">
        {
          serviceProofStandards.map(standard => (
            <article>
              <span
                class:list={['service-icon', `is-${standard.symbol}`]}
                aria-hidden="true"
              />
              <div>
                <h3>{standard.title}</h3>
                <p>{standard.copy}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <RouteProofStrip
    label="Service route"
    title="Proven, repeatable, Chicago-built."
    note="The service catalog should explain ownership, not hide behind tool names."
    items={serviceRouteProof}
    ctaHref={startProjectHref}
    ctaLabel="Start fit check"
  />

  <section
    class="tone-section-divider border-b"
    id="diagnostic-board"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ServiceDiagnosticBoard
        client:only="preact"
        diagnostics={serviceDiagnosticItems}
        defaultDiagnosticId="recurring-tickets"
      />
    </div>
  </section>

  <section
    class="service-track-section"
    id="service-tracks"
    data-reveal
    data-page-section
  >
    <div class="service-track-section__inner">
      <div class="service-track-section__header">
        <p>Service tracks</p>
        <h2>
          Pick a track to see what we own, first outputs, and required proof.
        </h2>
        <span
          >Most engagements start in one lane, then pull in adjacent work only
          when it clearly supports the first outcome.</span
        >
      </div>

      <div class="service-track-list">
        {
          serviceTracks.map((track, index) => (
            <a
              href={startProjectHref}
              class:list={['service-track-row', index === 0 && 'is-featured']}
            >
              <span class="service-track-row__identity">
                <span
                  class:list={['service-icon', `is-${track.icon}`]}
                  aria-hidden="true"
                />
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{track.title}</strong>
              </span>
              <span class="service-track-row__scope">{track.scope}</span>
              <span class="service-track-row__problem">
                {track.routeProblems[0]}
              </span>
              <span class="service-track-row__arrow" aria-hidden="true" />
              <div class="service-track-row__detail">
                <p>{track.copy}</p>
                <p>{track.detail}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ProofOperatingSystem
    compact
    eyebrow="What you should receive"
    title="Every service should leave a clear record."
    description="Support, security, Microsoft 365, and recovery work should leave behind owners, open decisions, and the next item to review."
    ctaHref={startProjectHref}
    ctaLabel="Start service fit check"
  />

  <section
    class="tone-section-divider border-b"
    id="decision-handoff"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <DecisionHandoffPanel
        activeId="support-ownership"
        eyebrow="Service handoff"
        title="Choose the first service lane by the problem you need solved."
        description="The right starting point is easier to defend when the pressure, facts, and first deliverable are clear before the service catalog opens."
      />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="operating-intelligence"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <OperationalIntelligenceWorkbench
        client:only="preact"
        compact
        items={workbenchItems}
        defaultItemId="security-evidence"
        eyebrow="Service intelligence"
        title="Turn symptoms into service scope and first actions."
        description="Use this to match common IT pressure to the first checks, records to collect, possible automation, and the right service route."
      />
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="onboarding"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Onboarding</p>
        <h2 class="tone-section-title">
          The first 90 days should show real control.
        </h2>
        <p class="tone-section-copy">
          Onboarding should not feel like a handoff into a black box. It should
          define access, support channels, security baseline, backup evidence,
          recurring issues, Microsoft 365 cleanup, vendor handoffs, and the
          first roadmap.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-4">
        {
          onboardingPhases.map(phase => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {phase.phase}
              </p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                {phase.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{phase.goal}</p>
              <ul class="mt-5 space-y-2 text-sm leading-6 text-slate-300">
                {phase.checkpoints.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="tone-divider-top mt-5 pt-4">
                <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                  What you receive
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-200">
                  {phase.buyerVisibleOutput}
                </p>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="case-studies"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Proof stories</p>
        <h2 class="tone-section-title">
          Proof should show the problem, the work, and what changed.
        </h2>
        <p class="tone-section-copy">
          These anonymized examples focus on practical outcomes: fewer repeat
          issues, cleaner ownership, stronger records, and clearer next steps.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          caseStudies.map(study => (
            <ModernCard variant="glass" className="h-full p-6">
              <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                {study.data.industry}
              </p>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-white">
                {study.data.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {study.data.summary}
              </p>

              <div class="tone-divider-top mt-5 grid gap-4 pt-5">
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    Challenge
                  </p>
                  <p class="mt-2 text-sm leading-6 text-slate-300">
                    {study.data.challenge}
                  </p>
                </div>
                <div>
                  <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/40">
                    Work performed
                  </p>
                  <p class="mt-2 text-sm leading-6 text-slate-300">
                    {study.data.solution}
                  </p>
                </div>
              </div>

              <div class="mt-5 grid gap-3 sm:grid-cols-3">
                {study.data.results.map(result => (
                  <div class="tone-panel-soft rounded-xl p-3">
                    <p class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-white/40">
                      {result.label}
                    </p>
                    <p class="mt-2 text-sm font-semibold text-white">
                      {result.value}
                    </p>
                  </div>
                ))}
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <ProviderSelectionStandard
    id="selection-questions"
    compact
    eyebrow="Selection questions"
    title="Ask these before signing an MSP agreement."
    description="Strong answers should come with owner names, review habits, and buyer-visible proof. That is what separates an operating partner from a tool bundle."
    ctaHref={startProjectHref}
    ctaLabel="Start service fit check"
  />

  <section
    class="tone-section-divider border-b"
    id="service-entry"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Where to start</p>
        <h2 class="tone-section-title">Three simple entry points.</h2>
        <p class="tone-section-copy">
          Choose the closest path if you already know what you need. Otherwise,
          the diagnostic above is the cleaner start.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          entryLanes.map(item => (
            <ModernCard
              href={item.href}
              variant="default"
              className="h-full p-7"
            >
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <span class="tone-accent-link text-sm font-semibold">
                  {item.cta} →
                </span>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-programs"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Delivery programs</p>
        <h2 class="tone-section-title">
          Good scopes blend capability without becoming a grab bag.
        </h2>
        <p class="tone-section-copy">
