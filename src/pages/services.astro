---
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import PageHero from '../components/PageHero.astro';
import { ownershipStandards, processSteps, services } from '../data/site';
import MarketingLayout from '../layouts/MarketingLayout.astro';

const situations = [
  [
    'The technology plan keeps changing',
    'Technology advisory',
    '#technology-advisory',
  ],
  [
    'A critical workflow needs real software',
    'Software engineering',
    '#software-product-engineering',
  ],
  [
    'Cloud and legacy systems are holding work back',
    'Modernization',
    '#cloud-platform-modernization',
  ],
  [
    'Risk is growing faster than the controls',
    'Cybersecurity',
    '#cybersecurity-resilience',
  ],
  ['Daily support has no clear owner', 'Managed IT', '#managed-it-workplace'],
  [
    'Manual handoffs keep creating errors',
    'Integration & automation',
    '#data-integration-automation',
  ],
];

const faqs = [
  {
    question: 'Do we need to buy every service lane?',
    answer:
      'No. Start with the outcome or operating gap that matters now. We define the immediate engagement and show which later responsibilities should stay connected without forcing them into the first scope.',
  },
  {
    question: 'Can you work with our internal technology or product team?',
    answer:
      'Yes. We can lead a defined lane, add architecture or engineering capacity, recover a project, or operate alongside an internal team. Responsibilities, decision authority, source ownership, and handoffs are agreed before delivery begins.',
  },
  {
    question: 'Can a project become an ongoing managed service?',
    answer:
      'Yes, when that is the right operating model. We separate the build from the ongoing support, cloud, security, and improvement scope so the business can approve each responsibility clearly.',
  },
];
---

<MarketingLayout
  title="Technology Consulting, Software & Managed Services | CHICAGOS #1 MSP"
  description="Technology advisory, custom software, cloud modernization, cybersecurity, managed IT, data, integration, and automation for Chicago businesses."
>
  <PageHero
    title="One firm. Full technology responsibility."
    copy="Strategy, software, cloud, cybersecurity, data, and managed operations—connected through one delivery model instead of scattered across vendors."
    secondaryLabel="Explore software engineering"
    secondaryHref="software/"
    asideTitle="A practical fit"
    asideCopy="Established organizations with an important decision, a system to build, an environment to modernize, or technology operations that need a stronger owner."
  />

  <section class="route-index">
    <div class="shell">
      <h2>Start with the business problem.</h2>
      <div class="route-index__rows">
        {
          situations.map((item, index) => (
            <a href={item[2]}>
              <span class="index-number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <strong>{item[0]}</strong>
              <em>{item[1]}</em>
              <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ownership-band">
    <div class="shell">
      <h2>What integrated ownership looks like.</h2>
      <ol>
        {
          ownershipStandards.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item}</strong>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section service-details">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>Six lanes. One operating model.</h2>
        <p>
          Each lane has a distinct outcome. The work stays connected wherever a
          decision, build, security control, or operating handoff crosses the
          boundary.
        </p>
      </div>
      <div class="service-details__list">
        {
          services.map(service => (
            <article id={service.id}>
              <span class="index-number">{service.number}</span>
              <div class="service-details__copy">
                <h3>{service.title}</h3>
                <p>{service.detail}</p>
              </div>
              <ul>
                {service.includes.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="delivery-band">
    <div class="shell">
      <div class="delivery-band__heading">
        <h2>Plan it. Build it. Secure it. Run it.</h2>
        <p>
          The engagement can begin at any stage. Responsibility should not
          disappear between them.
        </p>
      </div>
      <ol class="delivery-band__steps">
        {
          processSteps.map(step => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell split-section split-section--top">
      <div class="section-heading">
        <h2>Questions before we start.</h2>
        <p>Direct answers make the fit easier to judge.</p>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand
    title="Put the whole problem on the table."
    copy="Tell us what the business needs to decide, build, secure, or operate. We will separate the first engagement from the responsibilities that follow it."
    secondaryLabel="Review pricing models"
    secondaryHref="pricing/"
  />
</MarketingLayout>
