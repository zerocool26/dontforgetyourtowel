---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import ModernButton from '../components/ui/ModernButton.astro';
import ModernCard from '../components/ui/ModernCard.astro';
import ServiceCatalog from '../components/business/ServiceCatalog.tsx';
import ServiceComparisonMatrix from '../components/business/ServiceComparisonMatrix.tsx';
import ServicesQuiz from '../components/business/ServicesQuiz.tsx';
import ScopeReadinessPanel from '../components/business/ScopeReadinessPanel.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';
import { CONTACT_EMAIL } from '../consts';
import { servicesExtended } from '../data/services-extended';
import { servicesFaqs, pricingTiers } from '../data/pricing';
import { withBasePath } from '../utils/helpers';

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Chicago managed services planning inquiry')}`;

const serviceCategories = Array.from(
  new Set(servicesExtended.map(service => service.category))
);

const entryLanes = [
  {
    title: 'Managed IT and support',
    copy: 'Start here when help desk ownership, onboarding, patching, vendor coordination, and day-to-day follow-through are the priority.',
    href: '#service-tracks',
    cta: 'View support track',
  },
  {
    title: 'Security and compliance',
    copy: 'Use this lane for identity, endpoint protection, awareness, response planning, and practical compliance readiness.',
    href: '#technology-catalog',
    cta: 'Open capability catalog',
  },
  {
    title: 'Cloud, Microsoft 365, and roadmap work',
    copy: 'If you need M365 cleanup, cloud migration, workflow automation, office projects, or digital-system work, start here and shape the right mix.',
    href: '#service-planner',
    cta: 'Compare solution options',
  },
];

const serviceSections = [
  { label: 'Tracks', href: '#service-tracks' },
  { label: 'Catalog', href: '#technology-catalog' },
  { label: 'Comparison', href: '#service-planner' },
  { label: 'Quiz', href: '#service-quiz' },
  { label: 'FAQ', href: '#faq' },
];

const serviceTracks = [
  {
    title: 'Managed IT and support operations',
    copy: 'Stabilize the day-to-day layer first: support ownership, device hygiene, onboarding, vendor wrangling, reporting, and escalation discipline.',
    detail:
      'Best for teams that are tired of reactive support, recurring issues, and messy accountability.',
  },
  {
    title: 'Cybersecurity and compliance motion',
    copy: 'Build a practical security posture around identity, endpoints, awareness, response readiness, and evidence habits that leadership can actually understand.',
    detail:
      'Best for regulated, high-visibility, or security-conscious teams that still need momentum.',
  },
  {
    title: 'Cloud and Microsoft 365 modernization',
    copy: 'Move beyond maintenance with cloud, collaboration, backup, and governance work that reduces drag and improves visibility across the business.',
    detail:
      'Best for teams that need modernization without getting buried in vague transformation language or tool sprawl.',
  },
  {
    title: 'Client-facing digital systems',
    copy: 'Prototype, design, and deliver higher-trust websites, portals, and launch surfaces when the front door matters just as much as the back office.',
    detail:
      'Best for launches, portals, buyer-facing upgrades, and firms whose presentation should better match their operations.',
  },
];

const deliveryPrograms = [
  {
    title: 'Stabilize and document',
    description:
      'Start with help desk ownership, endpoint standards, and documentation so the environment stops leaking time and trust.',
    outputs: ['Support ownership', 'Device standards', 'Reporting rhythm'],
  },
  {
    title: 'Secure and standardize',
    description:
      'Layer in identity, endpoint protection, awareness, and continuity planning so security becomes part of normal operations.',
    outputs: ['Identity controls', 'Security baseline', 'Continuity habits'],
  },
  {
    title: 'Modernize and present',
    description:
      'Use cloud, Microsoft 365, workflow automation, and selective digital delivery to make the client-facing side of the business feel as strong as the operations behind it.',
    outputs: ['Cloud roadmap', 'Workflow wins', 'Premium buyer experience'],
  },
];

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(withBasePath('/'), Astro.site).toString(),
  },
  {
    '@type': 'ListItem',
    position: 2,
    name: 'Services Hub',
    item: new URL(withBasePath('services/'), Astro.site).toString(),
  },
];
---

<MarketingLayout
  title="Services Hub | Olive Chicago"
  description="Chicago-focused managed IT, cybersecurity, Microsoft 365, cloud, backup, networking, and selective digital systems."
  mainClass="relative isolate overflow-x-clip"
  bodyClass="creative-page"
  showFooter={true}
  showStickyCTA={false}
  showLiveChat={false}
  showSavedRoutesDock={false}
>
  <StructuredData
    type="collection"
    data={{
      name: 'Services Hub',
      description:
        'Buyer-focused solution hub for managed operations, security, cloud, AI, and premium digital delivery.',
    }}
  />
  <StructuredData type="breadcrumbs" data={{ items: breadcrumbItems }} />

  <section
    class="tone-page-hero tone-section-divider border-b"
    id="services-hero"
    data-reveal
    data-page-section
  >
    <div
      class="tone-page-hero__inner mx-auto max-w-[1240px] px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-32"
    >
      <div class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-end">
        <div class="space-y-6">
          <div class="tone-page-header">
            <p class="tone-page-eyebrow">Chicago services hub</p>
            <h1 class="tone-page-title">
              Choose the right lane across support, security, Microsoft 365,
              cloud, continuity, and client-facing systems.
            </h1>
            <p class="tone-page-copy max-w-3xl">
              Start with the current pressure point, not a bloated checklist.
              The deeper catalog is still here when you want it, but the first
              decision should feel obvious on a phone.
            </p>
          </div>

          <div class="tone-page-actions">
            <ModernButton
              href="#service-tracks"
              variant="primary"
              className="min-h-[50px]"
            >
              Explore core tracks
            </ModernButton>
            <ModernButton
              href={withBasePath('pricing/')}
              variant="secondary"
              className="min-h-[50px]"
            >
              Review pricing guidance
            </ModernButton>
            <ModernButton
              href={startProjectHref}
              variant="outline"
              className="hidden min-h-[50px] sm:inline-flex"
            >
              Start planning intake
            </ModernButton>
          </div>

          <div class="tone-page-jump-links pt-1">
            {
              serviceSections.map(section => (
                <a
                  href={section.href}
                  class="tone-chip-soft tone-chip-jump tone-focus-accent inline-flex items-center justify-center"
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid gap-4">
          <ModernCard variant="glass" className="tone-metric-card p-6">
            <p class="tone-metric-card__label">How to use this page</p>
            <p class="tone-metric-card__value">Start with the lane</p>
            <p class="tone-metric-card__detail">
              Pick the closest pressure point first. Open the deeper catalog,
              planner, or quiz only if you actually need more detail.
            </p>
          </ModernCard>
          <div class="grid gap-4 sm:grid-cols-2">
            <ModernCard variant="default" className="tone-metric-card p-5">
              <p class="tone-metric-card__label">Solution lanes</p>
              <p class="tone-metric-card__value">4</p>
              <p class="tone-metric-card__detail">
                Support, security, modernization, and client-facing digital
                systems.
              </p>
            </ModernCard>
            <ModernCard variant="default" className="tone-metric-card p-5">
              <p class="tone-metric-card__label">Technology depth</p>
              <p class="tone-metric-card__value">
                {serviceCategories.length}
              </p>
              <p class="tone-metric-card__detail">
                Deep enough for specifics, simple enough for a first pass on
                mobile.
              </p>
            </ModernCard>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-entry"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Where to start</p>
        <h2 class="tone-section-title">
          Three smart ways Chicago-area buyers usually enter the conversation.
        </h2>
        <p class="tone-section-copy">
          Pick the closest fit, then only open the deeper layers that actually
          help the decision.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          entryLanes.map(item => (
            <ModernCard
              href={item.href}
              variant="default"
              className="h-full p-7"
            >
              <p class="text-lg font-semibold text-white">{item.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{item.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <span class="tone-accent-link text-sm font-semibold">
                  {item.cta} →
                </span>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-tracks"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div
        class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
      >
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Core tracks</p>
          <h2 class="tone-section-title">
            Four tracks that make the business legible fast.
          </h2>
          <p class="tone-section-copy">
            Buyers should know the right starting lane on mobile without
            decoding a giant sitemap or a wall of vendor logos.
          </p>
        </div>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {
          serviceTracks.map(track => (
            <ModernCard variant="default" className="h-full p-6">
              <p class="text-lg font-semibold text-white">{track.title}</p>
              <p class="mt-3 text-sm leading-7 text-slate-300">{track.copy}</p>
              <div class="tone-divider-top mt-6 pt-4">
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  Best fit
                </p>
                <p class="mt-2 text-sm leading-6 text-slate-200">
                  {track.detail}
                </p>
              </div>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-programs"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Delivery programs</p>
        <h2 class="tone-section-title">
          The best work usually blends more than one capability.
        </h2>
        <p class="tone-section-copy">
          The point is not to list everything. The point is to stack the right
          work in the right order so the environment gets calmer before it gets
          more ambitious.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          deliveryPrograms.map(program => (
            <ModernCard variant="glass" className="h-full p-7">
              <h3 class="mt-4 text-xl font-semibold text-white">
                {program.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {program.description}
              </p>
              <ul class="mt-5 space-y-2 text-sm text-slate-300">
                {program.outputs.map(output => (
                  <li class="flex items-start gap-2">
                    <span class="tone-accent-dot mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full" />
                    <span>{output}</span>
                  </li>
                ))}
              </ul>
            </ModernCard>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="technology-catalog"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 xl:grid-cols-[0.9fr_1.1fr] xl:items-start">
        <ModernCard variant="glass" className="p-7">
          <p class="tone-section-kicker">Technology and business systems</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white">
            The deep catalog is still here, just framed more clearly.
          </h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">
            This catalog reflects the kinds of services leading Chicago MSPs
            actually emphasize: support, security, Microsoft 365, cloud,
            continuity, networking, strategy, and selective project work.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              serviceCategories.map(category => (
                <span class="tone-chip-soft rounded-full px-3 py-1.5 text-xs font-medium text-slate-200">
                  {category}
                </span>
              ))
            }
          </div>
        </ModernCard>

        <div class="grid gap-4 sm:grid-cols-3">
          {
            pricingTiers.slice(0, 3).map(tier => (
              <ModernCard
                variant={tier.highlight ? 'gradient' : 'default'}
                className="h-full p-5"
              >
                <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-white/45">
                  {tier.bestFor}
                </p>
                <p class="mt-3 text-2xl font-semibold tracking-tight text-white">
                  {tier.name}
                </p>
                <p class="mt-2 text-base font-medium text-slate-100">
                  {tier.price}
                </p>
                <p class="mt-3 text-sm leading-6 text-slate-300">
                  {tier.description}
                </p>
              </ModernCard>
            ))
          }
        </div>
      </div>

      <div class="mt-12">
        <ServiceCatalog client:only="preact" services={servicesExtended} />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-planner"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="tone-section-heading">
        <p class="tone-section-kicker">Comparison tools</p>
        <h2 class="tone-section-title">
          Compare solution shapes before you commit to discovery.
        </h2>
        <p class="tone-section-copy">
          Use the matrix to narrow the likely engagement shape before you start
          a scoped conversation or ask for a first-phase plan.
        </p>
      </div>

      <div class="mt-10">
        <ServiceComparisonMatrix
          client:only="preact"
          services={servicesExtended}
        />
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="service-quiz"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">Recommendation quiz</p>
          <h2 class="tone-section-title">Not sure what you need?</h2>
          <p class="tone-section-copy">
            The quiz gives quick direction when the best mix of coverage and
            modernization is not obvious yet.
          </p>
        </div>

        <div class="tone-panel-soft rounded-2xl p-6">
          <ServicesQuiz client:only="preact" />
        </div>
      </div>
    </div>
  </section>

  <section
    class="tone-section-divider border-b"
    id="readiness"
    data-reveal
    data-page-section
  >
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6">
      <ScopeReadinessPanel
        title="Turn a broad service need into a cleaner first scope."
        description="Use the readiness check before intake so the right owner can pick up the work faster and with less back-and-forth."
        compact
      />
    </div>
  </section>

  <section id="faq" data-reveal data-page-section>
    <div class="mx-auto max-w-[1240px] px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-start">
        <div class="tone-section-heading">
          <p class="tone-section-kicker">FAQ</p>
          <h2 class="tone-section-title">
            Common questions about fit, timing, and scope.
          </h2>
          <p class="tone-section-copy">
            These are the questions that usually come up before discovery.
          </p>
        </div>

        <div>
          <FAQAccordion items={servicesFaqs} />
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
