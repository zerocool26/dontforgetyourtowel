---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  noIndex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  showHeader?: boolean;
  showFooter?: boolean;
  mainClass?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  noIndex = false,
  image,
  type = 'website',
  showHeader = true,
  showFooter = true,
  mainClass = '',
  bodyClass = '',
} = Astro.props as Props;

const bodyClasses = ['editorial-site', bodyClass]
  .filter(Boolean)
  .filter((value, index, values) => values.indexOf(value) === index)
  .join(' ');
const mainClasses = ['editorial-page', mainClass]
  .filter(Boolean)
  .filter((value, index, values) => values.indexOf(value) === index)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      noIndex={noIndex}
      image={image}
      type={type}
    />
  </head>
  <body class={bodyClasses}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {showHeader && <Header />}
    <main id="main-content" class={mainClasses} tabindex="-1">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
