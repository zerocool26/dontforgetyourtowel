---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter(h => h.depth <= 3);
---

<nav
  class="toc sticky top-24 hidden max-h-[calc(100vh-6rem)] overflow-y-auto lg:block"
>
  <h2
    class="mb-4 text-sm font-semibold uppercase tracking-wider text-neutral-500"
  >
    On this page
  </h2>
  <ul class="space-y-2 border-l border-white/10 text-sm">
    {
      filteredHeadings.map(heading => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a
            href={`#${heading.slug}`}
            class="-ml-[1px] block border-l-2 border-transparent py-1 pl-4 text-neutral-400 transition-colors hover:border-[#ccff00] hover:text-white"
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        if (!id) return;

        const link = document.querySelector(`.toc a[href="#${id}"]`);
        if (entry.isIntersecting) {
          document.querySelectorAll('.toc a').forEach(a => {
            a.classList.remove(
              'text-indigo-400',
              'border-indigo-500',
              'font-medium'
            );
            a.classList.add('text-neutral-400', 'border-transparent');
          });
          link?.classList.remove('text-neutral-400', 'border-transparent');
          link?.classList.add(
            'text-indigo-400',
            'border-indigo-500',
            'font-medium'
          );
        }
      });
    },
    { rootMargin: '-100px 0px -66%' }
  );

  document.querySelectorAll('article h2, article h3').forEach(h => {
    observer.observe(h);
  });
</script>
