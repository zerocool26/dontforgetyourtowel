---

---

<div class="theme-selector">
  <button
    id="theme-toggle"
    class="theme-selector__trigger"
    type="button"
    aria-label="Open theme selector"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-menu"
  >
    <span class="theme-selector__current">
      <span class="theme-selector__swatch" data-theme-swatch></span>
      <span class="theme-selector__copy">
        <span class="theme-selector__label">Theme</span>
        <span class="theme-selector__value" data-theme-current-label>
          Ops Center
        </span>
      </span>
    </span>
    <svg
      class="theme-selector__chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5L6 8L9.5 4.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div
    id="theme-menu"
    class="theme-selector__menu"
    role="menu"
    aria-label="Choose a theme"
    hidden
  >
    <button
      type="button"
      data-theme="ops-center"
      class="theme-option"
      role="menuitemradio"
      aria-checked="true"
    >
      <span class="theme-option__visual theme-option__visual--ops"></span>
      <span class="theme-option__copy">
        <span class="theme-option__title">Ops Center</span>
        <span class="theme-option__detail">
          Dark, cinematic, and premium with signal-green highlights.
        </span>
      </span>
    </button>
    <button
      type="button"
      data-theme="corporate"
      class="theme-option"
      role="menuitemradio"
      aria-checked="false"
    >
      <span class="theme-option__visual theme-option__visual--corp"></span>
      <span class="theme-option__copy">
        <span class="theme-option__title">Corporate</span>
        <span class="theme-option__detail">
          Bright, architectural, and presentation-ready without going flat.
        </span>
      </span>
    </button>
    <button
      type="button"
      data-theme="terminal"
      class="theme-option"
      role="menuitemradio"
      aria-checked="false"
    >
      <span class="theme-option__visual theme-option__visual--terminal"></span>
      <span class="theme-option__copy">
        <span class="theme-option__title">Terminal</span>
        <span class="theme-option__detail">
          Monospace operations mode with a sharper engineering feel.
        </span>
      </span>
    </button>
  </div>
</div>

<style>
  .theme-selector {
    position: relative;
    display: inline-block;
  }

  .theme-selector__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    min-width: 14.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(5, 7, 10, 0.84);
    padding: 0.55rem 0.8rem;
    color: var(--color-text-primary);
    box-shadow:
      0 18px 34px -26px rgba(0, 0, 0, 0.88),
      0 0 28px -26px rgba(215, 247, 91, 0.24);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .theme-selector__trigger:hover {
    border-color: rgba(215, 247, 91, 0.22);
    transform: translateY(-1px);
  }

  .theme-selector__current {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .theme-selector__swatch {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(215, 247, 91, 0.28),
        transparent 52%
      ),
      linear-gradient(135deg, rgba(2, 6, 12, 0.96), rgba(16, 18, 24, 0.86));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }

  .theme-selector__copy {
    display: grid;
    min-width: 0;
  }

  .theme-selector__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .theme-selector__value {
    font-size: 0.88rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .theme-selector__chevron {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.46);
    transition: transform 180ms ease;
  }

  .theme-selector__trigger[aria-expanded='true'] .theme-selector__chevron {
    transform: rotate(180deg);
  }

  .theme-selector__menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(20rem, 84vw);
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(10, 12, 18, 0.96), rgba(6, 8, 14, 0.92)),
      rgba(5, 7, 10, 0.94);
    padding: 0.45rem;
    box-shadow:
      0 28px 58px -30px rgba(0, 0, 0, 0.96),
      0 0 40px -28px rgba(215, 247, 91, 0.16);
    backdrop-filter: blur(20px);
    z-index: 70;
  }

  .theme-option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    width: 100%;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
    padding: 0.7rem;
    color: var(--color-text-primary);
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .theme-option:hover,
  .theme-option:focus-visible {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
  }

  .theme-option.active {
    border-color: rgba(215, 247, 91, 0.24);
    background: rgba(215, 247, 91, 0.08);
    box-shadow: 0 0 28px -22px rgba(215, 247, 91, 0.32);
  }

  .theme-option__visual {
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .theme-option__visual--ops {
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(215, 247, 91, 0.3),
        transparent 55%
      ),
      linear-gradient(135deg, #010204, #101319);
  }

  .theme-option__visual--corp {
    background:
      radial-gradient(
        circle at 24% 30%,
        rgba(37, 99, 235, 0.24),
        transparent 52%
      ),
      linear-gradient(135deg, #ffffff, #e2e8f0);
  }

  .theme-option__visual--terminal {
    background:
      radial-gradient(
        circle at 24% 30%,
        rgba(34, 197, 94, 0.24),
        transparent 52%
      ),
      linear-gradient(135deg, #010101, #0a130d);
  }

  .theme-option__copy {
    display: grid;
    gap: 0.16rem;
  }

  .theme-option__title {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .theme-option__detail {
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.56);
  }
</style>

<script>
  import { initializeTheme, theme, setTheme, type Theme } from '../store/index';

  const themeMeta = {
    'ops-center': {
      label: 'Ops Center',
      swatch:
        'radial-gradient(circle at 30% 30%, rgba(215,247,91,0.28), transparent 52%), linear-gradient(135deg, rgba(2,6,12,0.96), rgba(16,18,24,0.86))',
    },
    corporate: {
      label: 'Corporate',
      swatch:
        'radial-gradient(circle at 30% 30%, rgba(37,99,235,0.24), transparent 52%), linear-gradient(135deg, #ffffff, #e2e8f0)',
    },
    terminal: {
      label: 'Terminal',
      swatch:
        'radial-gradient(circle at 30% 30%, rgba(34,197,94,0.24), transparent 52%), linear-gradient(135deg, #010101, #0a130d)',
    },
  } as const;

  const bindThemeSelector = () => {
    initializeTheme();

    const root = document.querySelector('.theme-selector');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const toggle = root.querySelector(
      '#theme-toggle'
    ) as HTMLButtonElement | null;
    const menu = root.querySelector('#theme-menu') as HTMLElement | null;
    const options = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.theme-option')
    );
    const currentLabel = root.querySelector(
      '[data-theme-current-label]'
    ) as HTMLElement | null;
    const swatch = root.querySelector(
      '[data-theme-swatch]'
    ) as HTMLElement | null;

    if (!toggle || !menu) return;

    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    };

    const syncThemeUi = (currentTheme: Theme) => {
      const meta = themeMeta[currentTheme];
      if (currentLabel) currentLabel.textContent = meta.label;
      if (swatch) swatch.style.background = meta.swatch;

      options.forEach(option => {
        const isActive = option.dataset.theme === currentTheme;
        option.classList.toggle('active', isActive);
        option.setAttribute('aria-checked', String(isActive));
      });
    };

    theme.subscribe(syncThemeUi);
    syncThemeUi(theme.get());

    toggle.addEventListener('click', event => {
      event.stopPropagation();
      if (menu.hidden) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    document.addEventListener('click', event => {
      const target = event.target as Node | null;
      if (!target || root.contains(target)) return;
      closeMenu();
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeMenu();
      }
    });

    options.forEach(option => {
      option.addEventListener('click', () => {
        const newTheme = option.dataset.theme as Theme | undefined;
        if (!newTheme) return;
        setTheme(newTheme);
        closeMenu();
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindThemeSelector, {
      once: true,
    });
  } else {
    bindThemeSelector();
  }

  document.addEventListener('astro:page-load', bindThemeSelector);
</script>
