---
import { withBasePath } from '../utils/helpers';
import ModernButton from './ui/ModernButton.astro';

const today = new Date();

const primaryLinks = [
  { label: 'Solutions', href: withBasePath('services/') },
  { label: 'Pricing', href: withBasePath('pricing/') },
  { label: 'Proof', href: withBasePath('about/') },
  { label: 'Studio', href: withBasePath('build-studio/') },
  { label: 'Contact', href: withBasePath('contact-hq/') },
];

const supportLinks = [
  { label: 'Company', href: withBasePath('company/') },
  { label: 'Privacy', href: withBasePath('privacy/') },
  { label: 'Terms', href: withBasePath('terms/') },
];

const footerSignals = [
  {
    label: 'Coverage',
    value: 'MSP+',
    detail: 'Operations, security, cloud, AI, and premium web systems.',
  },
  {
    label: 'Execution',
    value: 'Mobile first',
    detail:
      'Sharper presentation and cleaner browsing on the smallest screen first.',
  },
  {
    label: 'Best first move',
    value: 'Short brief',
    detail:
      'Lead with the pressure point and route it into the right lane fast.',
  },
];
---

<footer class="tone-shell-footer tone-border border-t" role="contentinfo">
  <div class="mx-auto max-w-[1240px] px-4 py-10 sm:px-6 sm:py-14">
    <div class="footer-shell">
      <div class="footer-shell__top">
        <div class="footer-brand">
          <span class="footer-brand__mark">OGS</span>
          <div>
            <p class="footer-brand__title">Olive Global Systems</p>
            <p class="footer-brand__copy">
              Managed IT, security, cloud, AI, and premium buyer-facing systems
              for companies that need a sharper operating layer and a stronger
              front door.
            </p>
          </div>
        </div>

        <div class="footer-actions">
          <ModernButton href={withBasePath('contact-hq/')} variant="primary">
            Start intake
          </ModernButton>
          <ModernButton href={withBasePath('services/')} variant="secondary">
            Explore solutions
          </ModernButton>
        </div>
      </div>

      <div class="footer-shell__middle">
        <nav class="footer-nav" aria-label="Primary footer navigation">
          <p class="footer-nav__label">Routes</p>
          <div class="footer-nav__links">
            {
              primaryLinks.map(link => (
                <a class="footer-link" href={link.href}>
                  {link.label}
                </a>
              ))
            }
          </div>
        </nav>

        <nav class="footer-nav" aria-label="Support footer navigation">
          <p class="footer-nav__label">Support</p>
          <div class="footer-nav__links">
            {
              supportLinks.map(link => (
                <a class="footer-link" href={link.href}>
                  {link.label}
                </a>
              ))
            }
          </div>
        </nav>
      </div>

      <div class="footer-signal-grid">
        {
          footerSignals.map(item => (
            <div class="footer-signal">
              <p class="footer-signal__label">{item.label}</p>
              <p class="footer-signal__value">{item.value}</p>
              <p class="footer-signal__detail">{item.detail}</p>
            </div>
          ))
        }
      </div>

      <div class="footer-shell__bottom">
        <p>
          &copy; {today.getFullYear()} Olive Global Systems. All rights reserved.
        </p>
        <p>Built with Astro for speed, clarity, and accessibility.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-shell {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid color-mix(in srgb, var(--color-border) 74%, transparent);
    border-radius: 1.75rem;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.01)
    );
    box-shadow: 0 24px 56px -42px rgba(0, 0, 0, 0.58);
  }

  .footer-shell__top,
  .footer-shell__middle,
  .footer-shell__bottom {
    display: grid;
    gap: 1rem;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
    align-items: start;
  }

  .footer-brand__mark {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .footer-brand__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .footer-brand__copy {
    max-width: 42rem;
    margin: 0.7rem 0 0;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    line-height: 1.7;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .footer-nav {
    display: grid;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 66%, transparent);
  }

  .footer-nav__label,
  .footer-signal__label {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-muted) 88%, transparent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .footer-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .footer-link {
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: 0.95rem;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }

  .footer-signal-grid {
    display: grid;
    gap: 0.9rem;
  }

  .footer-signal {
    padding: 1rem 1.05rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .footer-signal__value {
    margin: 0.45rem 0 0;
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .footer-signal__detail {
    margin: 0.45rem 0 0;
    color: color-mix(in srgb, var(--color-text-secondary) 90%, transparent);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .footer-shell__bottom {
    padding-top: 1.25rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 66%, transparent);
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
    font-size: 0.78rem;
  }

  .footer-shell__bottom p {
    margin: 0;
  }

  @media (min-width: 860px) {
    .footer-shell__top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .footer-brand {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .footer-shell__middle {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-signal-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-shell__bottom {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
    }

    .footer-shell__bottom p:last-child {
      text-align: right;
    }
  }

  @media (max-width: 767px) {
    .footer-actions {
      flex-direction: column;
    }
  }
</style>
