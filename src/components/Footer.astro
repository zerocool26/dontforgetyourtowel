---
import { SITE_TITLE } from '../consts';
import { navLinks } from '../data/site';
import { withBasePath } from '../utils/helpers';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand" href={withBasePath('/')}>{SITE_TITLE}</a>
      <p>
        Technology consulting, custom software, cloud, cybersecurity, and
        managed IT for Chicago teams.
      </p>
    </div>
    <nav aria-label="Services and company">
      {
        navLinks
          .slice(0, 4)
          .map(link => <a href={withBasePath(link.href)}>{link.label}</a>)
      }
    </nav>
    <nav aria-label="About and resources">
      <a href={withBasePath('about/')}>About</a>
      <a href={withBasePath('blog/')}>Resources</a>
      <a href={withBasePath('chicago/')}>Chicago technology services</a>
    </nav>
    <nav aria-label="Legal">
      <a href={withBasePath('privacy/')}>Privacy</a>
      <a href={withBasePath('terms/')}>Terms</a>
      <a href={withBasePath('contact-hq/')}>Contact</a>
    </nav>
  </div>
  <div class="shell site-footer__bottom">
    <p>© {year} {SITE_TITLE}. All rights reserved.</p>
    <p>Chicago, Illinois</p>
  </div>
</footer>
