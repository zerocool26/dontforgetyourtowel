---
import { withBasePath } from '../utils/helpers';
import ModernCard from './ui/ModernCard.astro';
import ModernButton from './ui/ModernButton.astro';

const today = new Date();

const navSections = [
  {
    title: 'Company',
    items: [
      { label: 'Company', href: withBasePath('company/') },
      { label: 'Trade Directory', href: withBasePath('trades/') },
      { label: 'Portfolio', href: withBasePath('about/') },
      { label: 'Services', href: withBasePath('services/') },
      { label: 'Pricing', href: withBasePath('pricing/') },
      { label: 'Contact', href: withBasePath('contact-hq/') },
    ],
  },
  {
    title: 'Policies',
    items: [
      { label: 'Privacy', href: withBasePath('privacy/') },
      { label: 'Terms', href: withBasePath('terms/') },
    ],
  },
  {
    title: 'Get started',
    items: [
      { label: 'Request a quote', href: withBasePath('contact-hq/') },
      { label: 'Explore services', href: withBasePath('services/') },
      { label: 'Review pricing', href: withBasePath('pricing/') },
      { label: 'Browse divisions', href: withBasePath('trades/') },
    ],
  },
];
---

<footer class="border-t border-white/10 bg-[#07101c]" role="contentinfo">
  <div class="mx-auto max-w-[1240px] px-4 py-12 sm:px-6 sm:py-16">
    <div
      class="grid gap-8 sm:gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]"
    >
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-sm font-semibold uppercase tracking-[0.24em] text-white"
          >
            OGS
          </span>
          <div class="leading-tight">
            <p
              class="tone-title font-display text-sm font-bold uppercase tracking-[0.16em]"
            >
              Olive Global Systems
            </p>
            <p
              class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/45"
            >
              Integrated trade and technology delivery
            </p>
          </div>
        </div>
        <p class="max-w-xl text-sm leading-7 text-slate-300 sm:text-[0.95rem]">
          Olive Global Systems helps buyers coordinate trade delivery, managed
          technology, security, and operational change without forcing every
          problem into the same template. The focus is clear scope, clear
          ownership, and work that moves forward.
        </p>
        <div class="flex flex-wrap gap-4">
          <ModernButton
            href={withBasePath('contact-hq/')}
            variant="primary"
            className="min-h-[48px]"
          >
            Start a conversation
          </ModernButton>
          <ModernButton
            href={withBasePath('services/')}
            variant="secondary"
            className="min-h-[48px]"
          >
            Review services
          </ModernButton>
        </div>
        <div
          class="grid gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-5 text-sm text-slate-300 sm:max-w-xl sm:grid-cols-2"
        >
          <div>
            <p
              class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/45"
            >
              Where we help most
            </p>
            <p class="mb-0 mt-2">
              Multi-trade delivery, managed IT, cybersecurity, infrastructure,
              and operating-model improvements.
            </p>
          </div>
          <div>
            <p
              class="font-mono text-[11px] uppercase tracking-[0.2em] text-white/45"
            >
              Working model
            </p>
            <p class="mb-0 mt-2">
              Remote-first planning with on-site support, rollout coordination,
              and retained operational coverage when required.
            </p>
          </div>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
        {
          navSections.map(section => (
            <ModernCard variant="minimal" className="p-6">
              <p class="mb-4 border-b border-white/10 pb-3 font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-white/45">
                {section.title}
              </p>
              <ul class="space-y-3 text-sm">
                {section.items.map(item => (
                  <li>
                    <a
                      class="inline-flex items-center gap-2 text-slate-300 transition hover:text-white"
                      href={item.href}
                    >
                      <span class="h-1.5 w-1.5 rounded-full bg-[#12b5a6]" />
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </ModernCard>
          ))
        }
        <ModernCard variant="glass" className="p-6 sm:col-span-2">
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
            <div>
              <p
                class="text-xs font-semibold uppercase tracking-[0.32em] text-white/45"
              >
                HQ
              </p>
              <p class="mt-4 text-base font-semibold text-white">
                Start with contact, then route into the right service lane.
              </p>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                Best for project discovery, support discussions, security
                advisory, and cross-functional planning that needs a clear
                owner.
              </p>
            </div>
            <div class="flex flex-wrap gap-3 md:justify-end">
              <ModernButton
                href={withBasePath('contact-hq/')}
                variant="primary"
              >
                Contact HQ
              </ModernButton>
              <ModernButton href={withBasePath('pricing/')} variant="secondary">
                Pricing
              </ModernButton>
            </div>
          </div>
        </ModernCard>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {today.getFullYear()} Olive Global Systems. All rights reserved.
      </p>
      <p>Built with Astro for speed, clarity, and accessibility.</p>
    </div>
  </div>
</footer>
