---
import { getRouteContext } from '../../utils/route-context';

const routeContext = getRouteContext(Astro.url.pathname);
---

<aside
  class="saved-routes-dock"
  data-saved-routes-dock
  style={`--saved-routes-accent:${routeContext.accent};`}
  aria-label="Saved routes dock"
  hidden
>
  <button
    type="button"
    class="saved-routes-dock__toggle"
    data-saved-routes-toggle
    aria-expanded="false"
  >
    <span class="saved-routes-dock__toggle-copy">
      <span class="saved-routes-dock__eyebrow">Saved routes</span>
      <span class="saved-routes-dock__toggle-title">Workspace set</span>
    </span>
    <span class="saved-routes-dock__count" data-saved-routes-count>0</span>
  </button>

  <div
    class="saved-routes-dock__panel"
    data-saved-routes-panel
    data-state="collapsed"
  >
    <div class="saved-routes-dock__desktop">
      <div class="saved-routes-dock__header">
        <div>
          <p class="saved-routes-dock__eyebrow">Saved routes</p>
          <p class="saved-routes-dock__title">Personal route set</p>
        </div>
        <div class="saved-routes-dock__desktop-tools">
          <span class="saved-routes-dock__count" data-saved-routes-count>0</span
          >
          <button
            type="button"
            class="saved-routes-dock__mini-action"
            data-saved-routes-toggle
          >
            Collapse
          </button>
        </div>
      </div>
      <p class="saved-routes-dock__copy">
        Build a shortlist across solutions, proof routes, studio moments, and
        gallery references.
      </p>

      <div class="saved-routes-dock__summary">
        <p
          class="saved-routes-dock__summary-title"
          data-saved-routes-summary-title
        >
          Curated route workspace
        </p>
        <p class="saved-routes-dock__summary-copy" data-saved-routes-summary>
          Save standout routes to turn them into a sharper working brief.
        </p>
        <div
          class="saved-routes-dock__summary-categories"
          data-saved-routes-categories
        >
        </div>
      </div>

      <div class="saved-routes-dock__list" data-saved-routes-list></div>
      <div class="saved-routes-dock__actions">
        <button
          type="button"
          class="saved-routes-dock__action saved-routes-dock__action--primary"
          data-saved-routes-brief
        >
          Brief intake
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-copy-brief
        >
          Copy brief
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-download
        >
          Download JSON
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-export
        >
          Export
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-console
        >
          Open console
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-clear
        >
          Clear
        </button>
      </div>
    </div>

    <div class="saved-routes-dock__mobile">
      <div class="saved-routes-dock__mobile-head">
        <div>
          <p class="saved-routes-dock__eyebrow">Saved routes</p>
          <p class="saved-routes-dock__mobile-title">Quick return set</p>
        </div>
        <div class="saved-routes-dock__mobile-actions">
          <span class="saved-routes-dock__count" data-saved-routes-count>0</span
          >
          <button
            type="button"
            class="saved-routes-dock__mini-action"
            data-saved-routes-console
          >
            Console
          </button>
          <button
            type="button"
            class="saved-routes-dock__mini-action"
            data-saved-routes-toggle
          >
            Hide
          </button>
        </div>
      </div>

      <div
        class="saved-routes-dock__summary saved-routes-dock__summary--mobile"
      >
        <p
          class="saved-routes-dock__summary-title"
          data-saved-routes-summary-title
        >
          Curated route workspace
        </p>
        <p class="saved-routes-dock__summary-copy" data-saved-routes-summary>
          Save standout routes to turn them into a sharper working brief.
        </p>
        <div
          class="saved-routes-dock__summary-categories"
          data-saved-routes-categories
        >
        </div>
      </div>

      <div
        class="saved-routes-dock__mobile-rail scrollbar-hide"
        data-saved-routes-mobile-list
      >
      </div>
      <div
        class="saved-routes-dock__actions saved-routes-dock__actions--mobile"
      >
        <button
          type="button"
          class="saved-routes-dock__action saved-routes-dock__action--primary"
          data-saved-routes-brief
        >
          Brief intake
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-copy-brief
        >
          Copy brief
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-download
        >
          JSON
        </button>
        <button
          type="button"
          class="saved-routes-dock__action"
          data-saved-routes-clear
        >
          Clear
        </button>
      </div>
    </div>
  </div>
</aside>

<script>
  import {
    buildWorkspaceClipboardPayload,
    buildWorkspaceContactHref,
    buildWorkspaceDraft,
    buildWorkspaceJsonPayload,
    clearPinnedRoutes,
    readPinnedRoutes,
    toNavigableRouteUrl,
    unpinRoute,
  } from '../../utils/route-memory';
  import { getLocalStorage, setLocalStorage } from '../../utils/storage';

  declare global {
    interface Window {
      __savedRoutesDockCleanup?: () => void;
    }
  }

  const SAVED_ROUTES_DOCK_STORAGE_KEY = 'olive-saved-routes-dock-state';

  const bindSavedRoutesDock = () => {
    window.__savedRoutesDockCleanup?.();

    const root = document.querySelector<HTMLElement>(
      '[data-saved-routes-dock]'
    );
    if (!root) return;

    const countTargets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-saved-routes-count]')
    );
    const desktopList = root.querySelector<HTMLElement>(
      '[data-saved-routes-list]'
    );
    const mobileList = root.querySelector<HTMLElement>(
      '[data-saved-routes-mobile-list]'
    );
    const summaryTargets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-saved-routes-summary]')
    );
    const summaryTitleTargets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-saved-routes-summary-title]')
    );
    const categoryTargets = Array.from(
      root.querySelectorAll<HTMLElement>('[data-saved-routes-categories]')
    );
    const panel = root.querySelector<HTMLElement>('[data-saved-routes-panel]');
    const toggleButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-toggle]')
    );
    const exportButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-export]')
    );
    const briefButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-brief]')
    );
    const copyBriefButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-copy-brief]')
    );
    const downloadButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-download]')
    );
    const consoleButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-console]')
    );
    const clearButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-saved-routes-clear]')
    );

    let panelOpen = getLocalStorage<boolean>(
      SAVED_ROUTES_DOCK_STORAGE_KEY,
      false
    );

    const syncPanelState = () => {
      if (panel) {
        panel.dataset.state = panelOpen ? 'expanded' : 'collapsed';
      }

      toggleButtons.forEach(button => {
        button.setAttribute('aria-expanded', String(panelOpen));
      });

      setLocalStorage(SAVED_ROUTES_DOCK_STORAGE_KEY, panelOpen);
    };

    const updateButtonLabel = (
      button: HTMLButtonElement | undefined,
      nextText: string,
      fallbackText: string
    ) => {
      if (!button) return;
      button.textContent = nextText;
      window.setTimeout(() => {
        button.textContent = fallbackText;
      }, 1200);
    };

    const renderSummary = () => {
      const workspace = buildWorkspaceDraft();

      summaryTitleTargets.forEach(node => {
        node.textContent = workspace.title;
      });

      summaryTargets.forEach(node => {
        node.textContent = workspace.summary;
      });

      categoryTargets.forEach(node => {
        node.replaceChildren();
        workspace.categories.slice(0, 4).forEach(category => {
          const chip = document.createElement('span');
          chip.className = 'saved-routes-dock__chip';
          chip.textContent = category;
          node.appendChild(chip);
        });
      });
    };

    const render = () => {
      const items = readPinnedRoutes().slice(0, 5);
      root.hidden = items.length === 0;

      if (!items.length) {
        panelOpen = false;
      }

      countTargets.forEach(node => {
        node.textContent = `${items.length}`;
      });

      renderSummary();

      desktopList?.replaceChildren();
      mobileList?.replaceChildren();

      items.forEach((item, index) => {
        if (desktopList) {
          const shell = document.createElement('div');
          shell.className = 'saved-routes-dock__item-shell';

          const link = document.createElement('a');
          link.className = 'saved-routes-dock__item';
          link.href = toNavigableRouteUrl(item.url);

          const order = document.createElement('span');
          order.className = 'saved-routes-dock__item-order';
          order.textContent = `${index + 1}`;

          const content = document.createElement('span');
          content.className = 'saved-routes-dock__item-copy';

          const title = document.createElement('span');
          title.className = 'saved-routes-dock__item-title';
          title.textContent = item.title;

          const meta = document.createElement('span');
          meta.className = 'saved-routes-dock__item-meta';
          meta.textContent = item.category;

          content.append(title, meta);
          link.append(order, content);

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'saved-routes-dock__remove';
          removeButton.textContent = 'Remove';
          removeButton.addEventListener('click', () => {
            unpinRoute(item.url);
          });

          shell.append(link, removeButton);
          desktopList.appendChild(shell);
        }

        if (mobileList) {
          const shell = document.createElement('div');
          shell.className = 'saved-routes-dock__pill-shell';

          const link = document.createElement('a');
          link.className = 'saved-routes-dock__pill';
          link.href = toNavigableRouteUrl(item.url);

          const title = document.createElement('span');
          title.className = 'saved-routes-dock__pill-title';
          title.textContent = item.title;

          const meta = document.createElement('span');
          meta.className = 'saved-routes-dock__pill-meta';
          meta.textContent = item.category;

          link.append(title, meta);

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'saved-routes-dock__pill-remove';
          removeButton.textContent = 'Remove';
          removeButton.addEventListener('click', () => {
            unpinRoute(item.url);
          });

          shell.append(link, removeButton);
          mobileList.appendChild(shell);
        }
      });

      syncPanelState();
    };

    const handleExport = async (button?: HTMLButtonElement) => {
      const items = readPinnedRoutes();
      if (!items.length) return;

      try {
        await navigator.clipboard.writeText(
          buildWorkspaceClipboardPayload(items)
        );
        updateButtonLabel(button, 'Copied', 'Export');
      } catch {
        updateButtonLabel(button, 'Unavailable', 'Export');
      }
    };

    const handleCopyBrief = async (button?: HTMLButtonElement) => {
      const items = readPinnedRoutes();
      if (!items.length) return;

      try {
        await navigator.clipboard.writeText(buildWorkspaceDraft(items).summary);
        updateButtonLabel(button, 'Copied', 'Copy brief');
      } catch {
        updateButtonLabel(button, 'Unavailable', 'Copy brief');
      }
    };

    const handleDownload = (button?: HTMLButtonElement) => {
      const items = readPinnedRoutes();
      if (!items.length) return;

      try {
        const blob = new Blob([buildWorkspaceJsonPayload(items)], {
          type: 'application/json;charset=utf-8',
        });
        const href = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = href;
        link.download = 'olive-route-workspace.json';
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(href);
        updateButtonLabel(button, 'Downloaded', 'Download JSON');
      } catch {
        updateButtonLabel(button, 'Unavailable', 'Download JSON');
      }
    };

    const handleBrief = () => {
      const items = readPinnedRoutes();
      if (!items.length) return;

      const nextHref = buildWorkspaceContactHref(items);
      try {
        const nextUrl = new URL(nextHref, window.location.href);
        if (
          nextUrl.protocol === 'mailto:' ||
          nextUrl.origin === window.location.origin
        ) {
          window.location.assign(nextUrl.toString());
        }
      } catch {
        // ignore invalid or blocked navigation targets
      }
    };

    const handleConsole = () => {
      window.dispatchEvent(new CustomEvent('command-palette:open'));
    };

    const handleClear = () => {
      clearPinnedRoutes();
      render();
    };

    const handleToggle = () => {
      panelOpen = !panelOpen;
      syncPanelState();
    };

    const handleOpen = () => {
      panelOpen = true;
      syncPanelState();
    };

    const toggleHandlers = toggleButtons.map(button => {
      button.addEventListener('click', handleToggle);
      return button;
    });

    const exportHandlers = exportButtons.map(button => {
      const handler = () => handleExport(button);
      button.addEventListener('click', handler);
      return { button, handler };
    });

    const briefHandlers = briefButtons.map(button => {
      button.addEventListener('click', handleBrief);
      return button;
    });

    const copyBriefHandlers = copyBriefButtons.map(button => {
      const handler = () => handleCopyBrief(button);
      button.addEventListener('click', handler);
      return { button, handler };
    });

    const downloadHandlers = downloadButtons.map(button => {
      const handler = () => handleDownload(button);
      button.addEventListener('click', handler);
      return { button, handler };
    });

    const consoleHandlers = consoleButtons.map(button => {
      button.addEventListener('click', handleConsole);
      return button;
    });

    const clearHandlers = clearButtons.map(button => {
      button.addEventListener('click', handleClear);
      return button;
    });

    window.addEventListener('olive:route-pins-updated', render);
    window.addEventListener('saved-routes-dock:toggle', handleToggle);
    window.addEventListener('saved-routes-dock:open', handleOpen);
    render();

    window.__savedRoutesDockCleanup = () => {
      toggleHandlers.forEach(button => {
        button.removeEventListener('click', handleToggle);
      });
      exportHandlers.forEach(({ button, handler }) => {
        button.removeEventListener('click', handler);
      });
      briefHandlers.forEach(button => {
        button.removeEventListener('click', handleBrief);
      });
      copyBriefHandlers.forEach(({ button, handler }) => {
        button.removeEventListener('click', handler);
      });
      downloadHandlers.forEach(({ button, handler }) => {
        button.removeEventListener('click', handler);
      });
      consoleHandlers.forEach(button => {
        button.removeEventListener('click', handleConsole);
      });
      clearHandlers.forEach(button => {
        button.removeEventListener('click', handleClear);
      });
      window.removeEventListener('olive:route-pins-updated', render);
      window.removeEventListener('saved-routes-dock:toggle', handleToggle);
      window.removeEventListener('saved-routes-dock:open', handleOpen);
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindSavedRoutesDock, {
      once: true,
    });
  } else {
    bindSavedRoutesDock();
  }

  document.addEventListener('astro:page-load', bindSavedRoutesDock);
</script>

<style>
  .saved-routes-dock {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 44;
    display: grid;
    gap: 0.65rem;
    pointer-events: none;
  }

  .saved-routes-dock__toggle,
  .saved-routes-dock__desktop,
  .saved-routes-dock__mobile {
    pointer-events: auto;
    border: 1px solid
      color-mix(
        in srgb,
        var(--saved-routes-accent) 16%,
        rgba(255, 255, 255, 0.08)
      );
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--saved-routes-accent) 10%, transparent),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(6, 8, 12, 0.88);
    box-shadow:
      0 30px 74px -42px rgba(0, 0, 0, 0.96),
      0 0 42px -24px
        color-mix(in srgb, var(--saved-routes-accent) 24%, transparent);
    backdrop-filter: blur(18px);
  }

  .saved-routes-dock__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    min-width: 12.5rem;
    max-width: 100%;
    border-radius: 999px;
    padding: 0.72rem 0.88rem;
  }

  .saved-routes-dock__toggle-copy {
    display: grid;
    text-align: left;
  }

  .saved-routes-dock__toggle-title {
    margin-top: 0.15rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .saved-routes-dock__panel {
    display: grid;
    gap: 0.65rem;
    transition:
      opacity 220ms ease,
      transform 220ms ease;
  }

  .saved-routes-dock__panel[data-state='collapsed'] {
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
  }

  .saved-routes-dock__panel[data-state='expanded'] {
    opacity: 1;
    transform: translateY(0);
  }

  .saved-routes-dock__desktop {
    display: none;
    width: min(21rem, 24vw);
    border-radius: 1.5rem;
    padding: 1rem;
  }

  .saved-routes-dock__header,
  .saved-routes-dock__mobile-head,
  .saved-routes-dock__mobile-actions,
  .saved-routes-dock__desktop-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .saved-routes-dock__eyebrow,
  .saved-routes-dock__item-meta,
  .saved-routes-dock__pill-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .saved-routes-dock__title,
  .saved-routes-dock__mobile-title {
    margin: 0.25rem 0 0;
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .saved-routes-dock__count {
    display: inline-flex;
    min-width: 2rem;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid
      color-mix(
        in srgb,
        var(--saved-routes-accent) 28%,
        rgba(255, 255, 255, 0.08)
      );
    padding: 0.3rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: color-mix(in srgb, var(--saved-routes-accent) 76%, white 24%);
  }

  .saved-routes-dock__copy {
    margin: 0.8rem 0 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .saved-routes-dock__summary {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.95rem;
    border: 1px solid
      color-mix(
        in srgb,
        var(--saved-routes-accent) 18%,
        rgba(255, 255, 255, 0.08)
      );
    border-radius: 1.15rem;
    background:
      radial-gradient(
        circle at top right,
        color-mix(in srgb, var(--saved-routes-accent) 12%, transparent),
        transparent 48%
      ),
      rgba(255, 255, 255, 0.025);
    padding: 0.88rem 0.92rem;
  }

  .saved-routes-dock__summary-title {
    margin: 0;
    color: rgba(255, 255, 255, 0.96);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .saved-routes-dock__summary-copy {
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .saved-routes-dock__summary-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .saved-routes-dock__chip {
    display: inline-flex;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.34rem 0.62rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .saved-routes-dock__list {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.9rem;
  }

  .saved-routes-dock__item-shell,
  .saved-routes-dock__pill-shell {
    display: grid;
    gap: 0.45rem;
  }

  .saved-routes-dock__item,
  .saved-routes-dock__pill {
    display: grid;
    gap: 0.3rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.75rem 0.85rem;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .saved-routes-dock__item {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .saved-routes-dock__item:hover,
  .saved-routes-dock__pill:hover {
    border-color: color-mix(
      in srgb,
      var(--saved-routes-accent) 24%,
      rgba(255, 255, 255, 0.08)
    );
    background: color-mix(
      in srgb,
      var(--saved-routes-accent) 10%,
      rgba(255, 255, 255, 0.03)
    );
    transform: translateY(-2px);
  }

  .saved-routes-dock__item-order {
    display: inline-flex;
    min-width: 1.8rem;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.3rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: color-mix(in srgb, var(--saved-routes-accent) 78%, white 22%);
  }

  .saved-routes-dock__item-copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .saved-routes-dock__item-title,
  .saved-routes-dock__pill-title {
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .saved-routes-dock__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .saved-routes-dock__action,
  .saved-routes-dock__mini-action,
  .saved-routes-dock__remove,
  .saved-routes-dock__pill-remove {
