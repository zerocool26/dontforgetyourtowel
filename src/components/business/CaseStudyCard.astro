---
import ModernCard from '../ui/ModernCard.astro';

export interface Props {
  title: string;
  industry: string;
  summary: string;
  results: { label: string; value: string }[];
  href?: string;
}

const { title, industry, summary, results, href } = Astro.props as Props;
---

{
  href ? (
    <a
      href={href}
      class="block h-full rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2"
    >
      <ModernCard
        variant="minimal"
        className="creative-panel tone-elevated tone-border h-full border p-6 hover:border-accent-500/50 transition-colors"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent-300">
              {industry}
            </p>
            <h3 class="tone-title mt-2 text-lg font-semibold">{title}</h3>
          </div>
        </div>

        <p class="tone-body mt-3 text-sm leading-relaxed">{summary}</p>

        <dl class="mt-5 grid grid-cols-2 gap-4">
          {results.slice(0, 4).map(item => (
            <div class="tone-border tone-surface rounded-lg border px-3 py-2">
              <dt class="tone-muted text-[0.7rem] uppercase tracking-widest">
                {item.label}
              </dt>
              <dd class="tone-title mt-1 text-sm font-semibold">
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      </ModernCard>
    </a>
  ) : (
    <ModernCard
      variant="minimal"
      className="creative-panel tone-elevated tone-border h-full border p-6 hover:border-accent-500/50 transition-colors"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-accent-300">
            {industry}
          </p>
          <h3 class="tone-title mt-2 text-lg font-semibold">{title}</h3>
        </div>
      </div>

      <p class="tone-body mt-3 text-sm leading-relaxed">{summary}</p>

      <dl class="mt-5 grid grid-cols-2 gap-4">
        {results.slice(0, 4).map(item => (
          <div class="tone-border tone-surface rounded-lg border px-3 py-2">
            <dt class="tone-muted text-[0.7rem] uppercase tracking-widest">
              {item.label}
            </dt>
            <dd class="tone-title mt-1 text-sm font-semibold">{item.value}</dd>
          </div>
        ))}
      </dl>
    </ModernCard>
  )
}
