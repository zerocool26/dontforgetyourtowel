---
interface SignalCabinetItem {
  kicker: string;
  title: string;
  detail: string;
  meta?: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?: string;
  items: SignalCabinetItem[];
}

const {
  eyebrow,
  title,
  description,
  accent = '#d7f75b',
  items = [],
} = Astro.props as Props;

const normalizedItems = items.filter(
  item => item.kicker && item.title && item.detail
);
const initialItem = normalizedItems[0];
---

{
  normalizedItems.length ? (
    <section
      class="signal-cabinet creative-panel rounded-2xl p-6 md:p-7"
      style={`--signal-cabinet-accent:${accent};`}
      data-signal-cabinet
    >
      <div class="signal-cabinet__header">
        <div class="space-y-3">
          <p class="creative-kicker">{eyebrow}</p>
          <h2 class="tone-title text-3xl font-semibold tracking-tight md:text-[2rem]">
            {title}
          </h2>
          <p class="tone-body max-w-3xl text-sm leading-relaxed md:text-[0.95rem]">
            {description}
          </p>
        </div>
        <div class="signal-cabinet__preview">
          <p class="signal-cabinet__preview-kicker" data-signal-cabinet-kicker>
            {initialItem?.kicker}
          </p>
          <p class="signal-cabinet__preview-title" data-signal-cabinet-title>
            {initialItem?.title}
          </p>
          <p class="signal-cabinet__preview-detail" data-signal-cabinet-detail>
            {initialItem?.detail}
          </p>
          <div class="signal-cabinet__meta" data-signal-cabinet-meta>
            {(initialItem?.meta ?? []).map(entry => (
              <span class="signal-cabinet__meta-chip">{entry}</span>
            ))}
          </div>
        </div>
      </div>

      <div
        class="signal-cabinet__rail scrollbar-hide"
        aria-label={`${title} signals`}
      >
        {normalizedItems.map((item, index) => (
          <button
            type="button"
            class={`signal-cabinet__item ${index === 0 ? 'is-active' : ''}`}
            data-signal-cabinet-item
            data-signal-kicker={item.kicker}
            data-signal-title={item.title}
            data-signal-detail={item.detail}
            data-signal-meta={(item.meta ?? []).join('||')}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="signal-cabinet__item-kicker">{item.kicker}</span>
            <span class="signal-cabinet__item-title">{item.title}</span>
          </button>
        ))}
      </div>
    </section>
  ) : null
}

<script is:inline>
  (() => {
    const initSignalCabinets = () => {
      const roots = Array.from(
        document.querySelectorAll('[data-signal-cabinet]')
      ).filter(node => node instanceof HTMLElement);

      roots.forEach(root => {
        if (root.dataset.signalCabinetBound === 'true') return;
        root.dataset.signalCabinetBound = 'true';

        const previewKicker = root.querySelector(
          '[data-signal-cabinet-kicker]'
        );
        const previewTitle = root.querySelector('[data-signal-cabinet-title]');
        const previewDetail = root.querySelector(
          '[data-signal-cabinet-detail]'
        );
        const previewMeta = root.querySelector('[data-signal-cabinet-meta]');
        const items = Array.from(
          root.querySelectorAll('[data-signal-cabinet-item]')
        ).filter(node => node instanceof HTMLButtonElement);

        const setActive = item => {
          items.forEach(node => {
            const isActive = node === item;
            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-pressed', String(isActive));
          });

          if (previewKicker) {
            previewKicker.textContent = item.dataset.signalKicker || '';
          }
          if (previewTitle) {
            previewTitle.textContent = item.dataset.signalTitle || '';
          }
          if (previewDetail) {
            previewDetail.textContent = item.dataset.signalDetail || '';
          }
          if (previewMeta) {
            previewMeta.replaceChildren();
            const entries = (item.dataset.signalMeta || '')
              .split('||')
              .filter(Boolean);
            entries.forEach(entry => {
              const chip = document.createElement('span');
              chip.className = 'signal-cabinet__meta-chip';
              chip.textContent = entry;
              previewMeta.appendChild(chip);
            });
          }
        };

        items.forEach(item => {
          item.addEventListener('click', () => setActive(item));
        });

        if (items[0]) setActive(items[0]);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSignalCabinets, {
        once: true,
      });
    } else {
      initSignalCabinets();
    }

    document.addEventListener('astro:page-load', initSignalCabinets);
  })();
</script>

<style is:inline>
  .signal-cabinet {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in srgb,
        var(--signal-cabinet-accent) 20%,
        rgba(255, 255, 255, 0.08)
      );
    background: linear-gradient(
      145deg,
      color-mix(
        in srgb,
        var(--signal-cabinet-accent) 10%,
        rgba(8, 10, 18, 0.96)
      ),
      rgba(5, 7, 12, 0.94) 46%,
      rgba(3, 4, 8, 0.98)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 24px 64px rgba(0, 0, 0, 0.28);
  }

  .signal-cabinet::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 18% 14%,
        color-mix(in srgb, var(--signal-cabinet-accent) 24%, transparent),
        transparent 24%
      ),
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.035),
        transparent
      );
    opacity: 0.9;
  }

  .signal-cabinet__header,
  .signal-cabinet__rail {
    position: relative;
    z-index: 1;
  }

  .signal-cabinet__header {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .signal-cabinet__preview {
    border-radius: 8px;
    border: 1px solid
      color-mix(
        in srgb,
        var(--signal-cabinet-accent) 22%,
        rgba(255, 255, 255, 0.08)
      );
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.05rem;
    backdrop-filter: blur(18px);
  }

  .signal-cabinet__preview-kicker,
  .signal-cabinet__item-kicker {
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(
      in srgb,
      var(--signal-cabinet-accent) 56%,
      rgba(255, 255, 255, 0.7)
    );
  }

  .signal-cabinet__preview-title {
    margin-top: 0.45rem;
    font-size: 1.08rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.96);
  }

  .signal-cabinet__preview-detail {
    margin-top: 0.5rem;
    font-size: 0.93rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.74);
  }

  .signal-cabinet__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.85rem;
  }

  .signal-cabinet__meta-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.35rem 0.65rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  .signal-cabinet__rail {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    margin-top: 1.2rem;
    padding-bottom: 0.15rem;
  }

  .signal-cabinet__item {
    min-width: min(11.5rem, calc(100vw - 3rem));
    flex: 0 0 auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    padding: 0.95rem 1rem;
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .signal-cabinet__item:hover,
  .signal-cabinet__item:focus-visible,
  .signal-cabinet__item.is-active {
    outline: none;
    transform: translateY(-1px);
    border-color: color-mix(
      in srgb,
      var(--signal-cabinet-accent) 34%,
      rgba(255, 255, 255, 0.12)
    );
    background: color-mix(
      in srgb,
      var(--signal-cabinet-accent) 10%,
      rgba(255, 255, 255, 0.04)
    );
  }

  .signal-cabinet__item-title {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    overflow-wrap: anywhere;
    white-space: normal;
  }

  @media (min-width: 960px) {
    .signal-cabinet__header {
      grid-template-columns: 1.06fr 0.94fr;
    }
  }

  @media (max-width: 699px) {
    .signal-cabinet {
      padding-inline: 1rem;
    }

    .signal-cabinet__item {
      min-width: 10rem;
    }
  }
</style>
