---
import { clientBadges, keyMetrics } from '../../data/marketing';
import { pricingSignals } from '../../data/pricing';
import TrustBadge from './TrustBadge.astro';

const highlights = [
  pricingSignals[0],
  pricingSignals[1],
  {
    label: keyMetrics[0]?.value ?? '15 min',
    sublabel: keyMetrics[0]?.label ?? 'Typical first response (demo)',
  },
  pricingSignals[2],
];
---

<section class="tone-border tone-surface border-b" data-reveal>
  <div class="mx-auto max-w-[1220px] px-6 py-12 sm:py-14">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div class="space-y-5">
        <p class="creative-kicker">Proof in the operating model</p>
        <h2 class="tone-title text-3xl font-semibold sm:text-4xl">
          Proof should show up in response ownership, not vague innovation.
        </h2>
        <p class="tone-body max-w-2xl text-sm sm:text-base">
          The real test is whether support gets easier to own, security gets
          easier to explain, Microsoft 365 gets cleaner, and leadership can see
          what is improving without chasing a vendor for updates.
        </p>

        <div
          class="flex flex-wrap gap-3"
          aria-label="Representative client badges"
        >
          {
            clientBadges.map(badge => (
              <span class="tone-border tone-surface tone-title inline-flex rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.22em]">
                {badge}
              </span>
            ))
          }
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          highlights.map(item => (
            <TrustBadge label={item.label} sublabel={item.sublabel} />
          ))
        }
      </div>
    </div>
  </div>
</section>
