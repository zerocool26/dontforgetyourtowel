---
import ModernButton from '../ui/ModernButton.astro';
import {
  competitorContrasts,
  fitSignals,
  proofArtifacts,
  proofMetrics,
} from '../../data/proof-system';
import { withBasePath } from '../../utils/helpers';

export interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  compact?: boolean;
  showComparison?: boolean;
  showFit?: boolean;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  eyebrow = 'Why this MSP',
  title = 'The difference is what gets documented and followed through.',
  description = 'A stronger IT partner shows who owns support issues, what recovery depends on, where access risk lives, and which budget decisions need attention.',
  compact = false,
  showComparison = true,
  showFit = true,
  ctaHref = withBasePath('contact-hq/'),
  ctaLabel = 'Start fit check',
} = Astro.props as Props;
---

<section
  class:list={['proof-system', compact && 'proof-system--compact']}
  data-proof-system
>
  <div class="proof-system__shell">
    <div class="proof-system__header">
      <div>
        <p class="proof-system__eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
      <p>{description}</p>
    </div>

    <div class="proof-system__grid">
      <div
        class="proof-system__console"
        role="img"
        aria-label="Operating proof dashboard showing support ownership, recovery, Microsoft 365 governance, and budget scope"
      >
        <div class="proof-system__console-top">
          <span>Chicago IT review</span>
          <strong>owners, risks, next steps</strong>
        </div>

        <div class="proof-system__metric-grid">
          {
            proofMetrics.map(metric => (
              <article class="proof-system__metric">
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <small>{metric.note}</small>
              </article>
            ))
          }
        </div>

        <div class="proof-system__flow" aria-hidden="true">
          <div class="proof-system__lane proof-system__lane--support">
            <span></span><span></span><span></span>
          </div>
          <div class="proof-system__lane proof-system__lane--security">
            <span></span><span></span><span></span>
          </div>
          <div class="proof-system__lane proof-system__lane--recovery">
            <span></span><span></span><span></span>
          </div>
          <div class="proof-system__receipt">
            <span>first review</span>
            <strong>owners + risks + budget</strong>
          </div>
        </div>
      </div>

      <div class="proof-system__artifacts">
        {
          proofArtifacts.map(item => (
            <article class="proof-system__artifact">
              <div class="proof-system__artifact-top">
                <span>{item.label}</span>
                <strong>{item.title}</strong>
              </div>
              <p>{item.signal}</p>
              <small>{item.proof}</small>
            </article>
          ))
        }
      </div>
    </div>

    {
      showComparison ? (
        <div class="proof-system__comparison" aria-label="Provider contrast">
          <div class="proof-system__comparison-head">
            <p>Question</p>
            <p>Typical answer</p>
            <p>What gets documented</p>
          </div>
          {competitorContrasts.map(row => (
            <article class="proof-system__comparison-row">
              <h3>{row.buyerQuestion}</h3>
              <p>{row.genericMsp}</p>
              <strong>{row.chicagoMsp}</strong>
            </article>
          ))}
        </div>
      ) : null
    }

    {
      showFit ? (
        <div class="proof-system__fit">
          {fitSignals.map(item => (
            <article class={`proof-system__fit-card is-${item.state}`}>
              <span>{item.label}</span>
              <strong>{item.title}</strong>
            </article>
          ))}
          <ModernButton href={ctaHref} variant="primary" rounded="sm">
            {ctaLabel}
          </ModernButton>
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .proof-system {
    position: relative;
    overflow: clip;
    border-block: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    background:
      radial-gradient(
        circle at 18% 12%,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 16%,
          transparent
        ),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 95%, transparent),
        color-mix(in srgb, var(--color-surface) 86%, transparent)
      );
  }

  .proof-system__shell {
    width: min(100% - 2rem, 1240px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .proof-system--compact .proof-system__shell {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
  }

  .proof-system__header {
    display: grid;
    gap: 1rem;
    max-width: 64rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .proof-system__eyebrow,
  .proof-system__console-top span,
  .proof-system__metric span,
  .proof-system__artifact-top span,
  .proof-system__artifact small,
  .proof-system__comparison-head p,
  .proof-system__fit-card span,
  .proof-system__receipt span {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .proof-system__eyebrow,
  .proof-system__metric span,
  .proof-system__artifact-top span,
  .proof-system__comparison-head p,
  .proof-system__fit-card span,
  .proof-system__receipt span {
    color: color-mix(in srgb, var(--color-text-muted) 88%, transparent);
  }

  .proof-system__header h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 4.8rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .proof-system__header > p {
    max-width: 58ch;
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.62;
  }

  .proof-system__grid {
    display: grid;
    gap: 1rem;
  }

  .proof-system__console,
  .proof-system__artifact,
  .proof-system__comparison,
  .proof-system__fit-card {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 0.75rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 3%, transparent),
        transparent 32%
      ),
      color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 5%, transparent),
      0 24px 60px -52px rgba(0, 0, 0, 0.72);
  }

  .proof-system__console {
    min-height: 34rem;
    display: grid;
    gap: 1rem;
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .proof-system__console-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 64%, transparent);
    padding-bottom: 1rem;
  }

  .proof-system__console-top strong,
  .proof-system__artifact-top strong,
  .proof-system__fit-card strong,
  .proof-system__receipt strong {
    color: var(--color-text-primary);
    font-weight: 760;
  }

  .proof-system__console-top strong {
    font-size: 0.9rem;
  }

  .proof-system__metric-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proof-system__metric {
    min-height: 7.2rem;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 62%, transparent);
    border-radius: 0.65rem;
    background: color-mix(in srgb, black 12%, transparent);
    padding: 0.9rem;
  }

  .proof-system__metric strong {
    color: var(--color-text-primary);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.05;
  }

  .proof-system__metric small {
    color: color-mix(in srgb, var(--color-text-secondary) 86%, transparent);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .proof-system__flow {
    position: relative;
    min-height: 14rem;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 58%, transparent);
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-text-primary) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-text-primary) 4%, transparent) 1px,
        transparent 1px
      ),
      color-mix(in srgb, black 14%, transparent);
    background-size: 42px 42px;
  }

  .proof-system__lane {
    position: absolute;
    left: 8%;
    right: 28%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 80%,
        white 10%
      ),
      transparent
    );
  }

  .proof-system__lane--support {
    top: 28%;
  }

  .proof-system__lane--security {
    top: 48%;
    opacity: 0.82;
  }

  .proof-system__lane--recovery {
    top: 68%;
    opacity: 0.7;
  }

  .proof-system__lane span {
    position: absolute;
    top: -0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    border: 2px solid
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 70%,
        white 8%
      );
    background: color-mix(in srgb, var(--color-surface) 72%, black 12%);
  }

  .proof-system__lane span:nth-child(1) {
    left: 4%;
  }

  .proof-system__lane span:nth-child(2) {
    left: 45%;
  }

  .proof-system__lane span:nth-child(3) {
    right: 0;
  }

  .proof-system__receipt {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: min(13rem, calc(100% - 2rem));
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 28%,
        transparent
      );
    border-radius: 0.65rem;
    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 12%,
          transparent
        ),
        transparent
      ),
      color-mix(in srgb, var(--color-surface) 92%, black 10%);
    padding: 0.9rem;
  }

  .proof-system__receipt strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .proof-system__artifacts {
    display: grid;
    gap: 1rem;
  }

  .proof-system__artifact {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
  }

  .proof-system__artifact-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .proof-system__artifact p {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-primary) 88%, transparent);
    line-height: 1.45;
  }

  .proof-system__artifact small {
    display: block;
    color: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 72%,
      var(--color-text-secondary)
    );
    line-height: 1.45;
  }

  .proof-system__comparison {
    display: grid;
    gap: 0;
    margin-top: 1rem;
    overflow: hidden;
  }

  .proof-system__comparison-head,
  .proof-system__comparison-row {
    display: grid;
    gap: 0;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .proof-system__comparison-head {
    background: color-mix(in srgb, black 12%, transparent);
  }

  .proof-system__comparison-head p,
  .proof-system__comparison-row > * {
    margin: 0;
    border-left: 1px solid
      color-mix(in srgb, var(--color-border) 58%, transparent);
    padding: 0.9rem;
  }

  .proof-system__comparison-head p:first-child,
  .proof-system__comparison-row > *:first-child {
    border-left: 0;
  }

  .proof-system__comparison-row {
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 58%, transparent);
  }

  .proof-system__comparison-row h3 {
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 720;
    line-height: 1.3;
  }

  .proof-system__comparison-row p,
  .proof-system__comparison-row strong {
    color: color-mix(in srgb, var(--color-text-secondary) 88%, transparent);
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .proof-system__comparison-row strong {
    color: color-mix(in srgb, var(--color-text-primary) 92%, transparent);
    font-weight: 700;
  }

  .proof-system__fit {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .proof-system__fit-card {
    min-height: 6.3rem;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 1rem;
  }

  .proof-system__fit-card.is-strong {
    border-color: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 36%,
      transparent
    );
  }

  .proof-system__fit-card.is-no {
    opacity: 0.72;
  }

  .proof-system__fit :global(.modern-button) {
    min-height: 52px;
    align-self: stretch;
  }

  @media (min-width: 860px) {
    .proof-system__header {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.62fr);
      align-items: end;
    }

    .proof-system__grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
      align-items: stretch;
    }

    .proof-system__artifacts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proof-system__fit {
      grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
      align-items: stretch;
    }
  }

  @media (max-width: 767px) {
    .proof-system__shell {
      width: min(100% - 2rem, 1240px);
      padding-block: 3rem;
    }

    .proof-system__header h2 {
      max-width: 100%;
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .proof-system__console {
      min-height: auto;
    }

    .proof-system__metric-grid {
      grid-template-columns: 1fr;
    }

    .proof-system__flow {
      min-height: 11rem;
    }

    .proof-system__comparison-head {
      display: none;
    }

    .proof-system__comparison-row {
      grid-template-columns: 1fr;
    }

    .proof-system__comparison-row > * {
      border-left: 0;
      border-top: 1px solid
        color-mix(in srgb, var(--color-border) 52%, transparent);
    }

    .proof-system__comparison-row > *:first-child {
      border-top: 0;
    }
  }
</style>
