---
interface TradeCoordinationMatrixItem {
  slug: string;
  name: string;
  badge: string;
  accent: string;
  operatingModel: string;
  serviceRhythm: string;
  ownerOutput: string;
  integration: string[];
  programs: string[];
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  items: TradeCoordinationMatrixItem[];
}

const { eyebrow, title, description, items = [] } = Astro.props as Props;
const initialItem = items[0];
---

{
  items.length ? (
    <section
      class="trade-coordination-matrix creative-panel rounded-2xl p-6 md:p-7"
      style={`--matrix-accent:${initialItem?.accent ?? '#d7f75b'};`}
      data-trade-matrix
    >
      <div class="trade-coordination-matrix__header">
        <div class="space-y-3">
          <p class="creative-kicker">{eyebrow}</p>
          <h2 class="tone-title text-3xl font-semibold tracking-tight md:text-[2rem]">
            {title}
          </h2>
          <p class="tone-body max-w-3xl text-sm leading-relaxed md:text-[0.95rem]">
            {description}
          </p>
        </div>
        <a
          class="trade-coordination-matrix__cta"
          href={initialItem?.href}
          data-trade-matrix-link
        >
          Open {initialItem?.name}
        </a>
      </div>

      <div
        class="trade-coordination-matrix__rail scrollbar-hide"
        role="tablist"
        aria-label={`${title} trades`}
      >
        {items.map((item, index) => (
          <button
            type="button"
            class={`trade-coordination-matrix__tab ${index === 0 ? 'is-active' : ''}`}
            data-trade-matrix-tab
            data-trade-name={item.name}
            data-trade-accent={item.accent}
            data-trade-operating-model={item.operatingModel}
            data-trade-service-rhythm={item.serviceRhythm}
            data-trade-owner-output={item.ownerOutput}
            data-trade-integration={item.integration.join('||')}
            data-trade-programs={item.programs.join('||')}
            data-trade-link={item.href}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="trade-coordination-matrix__tab-badge">
              {item.badge}
            </span>
            <span class="trade-coordination-matrix__tab-title">
              {item.name}
            </span>
          </button>
        ))}
      </div>

      <div class="trade-coordination-matrix__dashboard">
        <div class="trade-coordination-matrix__signal">
          <p class="trade-coordination-matrix__signal-label">Active trade</p>
          <p
            class="trade-coordination-matrix__signal-title"
            data-trade-matrix-name
          >
            {initialItem?.name}
          </p>
        </div>

        <div class="trade-coordination-matrix__panels">
          <article class="trade-coordination-matrix__panel">
            <p class="creative-kicker">Operating model</p>
            <p
              class="trade-coordination-matrix__panel-copy"
              data-trade-matrix-operating-model
            >
              {initialItem?.operatingModel}
            </p>
          </article>

          <article class="trade-coordination-matrix__panel">
            <p class="creative-kicker">Service rhythm</p>
            <p
              class="trade-coordination-matrix__panel-copy"
              data-trade-matrix-service-rhythm
            >
              {initialItem?.serviceRhythm}
            </p>
          </article>

          <article class="trade-coordination-matrix__panel">
            <p class="creative-kicker">First owner output</p>
            <p
              class="trade-coordination-matrix__panel-copy"
              data-trade-matrix-owner-output
            >
              {initialItem?.ownerOutput}
            </p>
          </article>
        </div>

        <div class="trade-coordination-matrix__meta-grid">
          <div class="trade-coordination-matrix__meta-panel">
            <p class="creative-kicker">Connected trades</p>
            <div
              class="trade-coordination-matrix__chips"
              data-trade-matrix-integrations
            >
              {(initialItem?.integration ?? []).map(entry => (
                <span class="trade-coordination-matrix__chip">{entry}</span>
              ))}
            </div>
          </div>

          <div class="trade-coordination-matrix__meta-panel">
            <p class="creative-kicker">Linked programs</p>
            <div
              class="trade-coordination-matrix__chips"
              data-trade-matrix-programs
            >
              {(initialItem?.programs ?? []).map(entry => (
                <span class="trade-coordination-matrix__chip">{entry}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : null
}

<script is:inline>
  (() => {
    const initTradeMatrices = () => {
      const roots = Array.from(
        document.querySelectorAll('[data-trade-matrix]')
      ).filter(node => node instanceof HTMLElement);

      roots.forEach(root => {
        if (root.dataset.tradeMatrixBound === 'true') return;
        root.dataset.tradeMatrixBound = 'true';

        const tabs = Array.from(
          root.querySelectorAll('[data-trade-matrix-tab]')
        ).filter(node => node instanceof HTMLButtonElement);
        const nameTarget = root.querySelector('[data-trade-matrix-name]');
        const operatingModelTarget = root.querySelector(
          '[data-trade-matrix-operating-model]'
        );
        const serviceRhythmTarget = root.querySelector(
          '[data-trade-matrix-service-rhythm]'
        );
        const ownerOutputTarget = root.querySelector(
          '[data-trade-matrix-owner-output]'
        );
        const integrationsTarget = root.querySelector(
          '[data-trade-matrix-integrations]'
        );
        const programsTarget = root.querySelector(
          '[data-trade-matrix-programs]'
        );
        const linkTarget = root.querySelector('[data-trade-matrix-link]');

        const renderChips = (target, entries) => {
          if (!target) return;
          target.replaceChildren();
          entries.forEach(entry => {
            const chip = document.createElement('span');
            chip.className = 'trade-coordination-matrix__chip';
            chip.textContent = entry;
            target.appendChild(chip);
          });
        };

        const setActive = tab => {
          tabs.forEach(node => {
            const isActive = node === tab;
            node.classList.toggle('is-active', isActive);
            node.setAttribute('aria-pressed', String(isActive));
          });

          const accent = tab.dataset.tradeAccent || '#d7f75b';
          root.style.setProperty('--matrix-accent', accent);

          if (nameTarget) {
            nameTarget.textContent = tab.dataset.tradeName || '';
          }
          if (operatingModelTarget) {
            operatingModelTarget.textContent =
              tab.dataset.tradeOperatingModel || '';
          }
          if (serviceRhythmTarget) {
            serviceRhythmTarget.textContent =
              tab.dataset.tradeServiceRhythm || '';
          }
          if (ownerOutputTarget) {
            ownerOutputTarget.textContent = tab.dataset.tradeOwnerOutput || '';
          }

          renderChips(
            integrationsTarget,
            (tab.dataset.tradeIntegration || '').split('||').filter(Boolean)
          );
          renderChips(
            programsTarget,
            (tab.dataset.tradePrograms || '').split('||').filter(Boolean)
          );

          if (linkTarget instanceof HTMLAnchorElement) {
            const name = tab.dataset.tradeName || 'trade';
            linkTarget.href = tab.dataset.tradeLink || '#';
            linkTarget.textContent = `Open ${name}`;
          }
        };

        tabs.forEach(tab => {
          tab.addEventListener('click', () => setActive(tab));
        });

        if (tabs[0]) setActive(tabs[0]);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTradeMatrices, {
        once: true,
      });
    } else {
      initTradeMatrices();
    }

    document.addEventListener('astro:page-load', initTradeMatrices);
  })();
</script>

<style is:inline>
  .trade-coordination-matrix {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--matrix-accent) 20%, rgba(255, 255, 255, 0.08));
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--matrix-accent) 10%, rgba(6, 8, 14, 0.96)),
      rgba(5, 7, 12, 0.94) 45%,
      rgba(3, 4, 8, 0.98)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 24px 68px rgba(0, 0, 0, 0.28);
  }

  .trade-coordination-matrix::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 14% 14%,
        color-mix(in srgb, var(--matrix-accent) 24%, transparent),
        transparent 26%
      ),
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.035),
        transparent
      );
    opacity: 0.92;
  }

  .trade-coordination-matrix__header,
  .trade-coordination-matrix__rail,
  .trade-coordination-matrix__dashboard {
    position: relative;
    z-index: 1;
  }

  .trade-coordination-matrix__header {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .trade-coordination-matrix__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(in srgb, var(--matrix-accent) 28%, rgba(255, 255, 255, 0.08));
    background: color-mix(
      in srgb,
      var(--matrix-accent) 10%,
      rgba(255, 255, 255, 0.04)
    );
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .trade-coordination-matrix__cta:hover,
  .trade-coordination-matrix__cta:focus-visible {
    outline: none;
    transform: translateY(-1px);
    border-color: color-mix(
      in srgb,
      var(--matrix-accent) 40%,
      rgba(255, 255, 255, 0.12)
    );
  }

  .trade-coordination-matrix__rail {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    margin-top: 1.2rem;
    padding-bottom: 0.15rem;
  }

  .trade-coordination-matrix__tab {
    min-width: 10.5rem;
    flex: 0 0 auto;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    padding: 0.95rem 1rem;
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .trade-coordination-matrix__tab:hover,
  .trade-coordination-matrix__tab:focus-visible,
  .trade-coordination-matrix__tab.is-active {
    outline: none;
    transform: translateY(-1px);
    border-color: color-mix(
      in srgb,
      var(--matrix-accent) 34%,
      rgba(255, 255, 255, 0.12)
    );
    background: color-mix(
      in srgb,
      var(--matrix-accent) 10%,
      rgba(255, 255, 255, 0.04)
    );
  }

  .trade-coordination-matrix__tab-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.5rem;
    border: 1px solid
      color-mix(in srgb, var(--matrix-accent) 20%, rgba(255, 255, 255, 0.08));
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  .trade-coordination-matrix__tab-title {
    display: block;
    margin-top: 0.65rem;
    font-size: 0.96rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
  }

  .trade-coordination-matrix__dashboard {
    display: grid;
    gap: 1rem;
    margin-top: 1.3rem;
  }

  .trade-coordination-matrix__signal,
  .trade-coordination-matrix__panel,
  .trade-coordination-matrix__meta-panel {
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.05rem;
    backdrop-filter: blur(18px);
  }

  .trade-coordination-matrix__signal-label {
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.46);
  }

  .trade-coordination-matrix__signal-title {
    margin-top: 0.45rem;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.96);
  }

  .trade-coordination-matrix__panels,
  .trade-coordination-matrix__meta-grid {
    display: grid;
    gap: 1rem;
  }

  .trade-coordination-matrix__panel-copy {
    margin-top: 0.55rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
  }

  .trade-coordination-matrix__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .trade-coordination-matrix__chip {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.38rem 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }

  @media (min-width: 900px) {
    .trade-coordination-matrix__header {
      grid-template-columns: 1.04fr auto;
    }

    .trade-coordination-matrix__panels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .trade-coordination-matrix__meta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 699px) {
    .trade-coordination-matrix {
      padding-inline: 1rem;
    }

    .trade-coordination-matrix__tab {
      min-width: 9.25rem;
    }
  }
</style>
