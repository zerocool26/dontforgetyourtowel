---
import ModernButton from '../ui/ModernButton.astro';
import { resourceDecisionTools } from '../../data/resource-decision-tools';
import { withBasePath } from '../../utils/helpers';

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  compact?: boolean;
}

const {
  id = 'decision-tools',
  eyebrow = 'Decision tools',
  title = 'Turn the next IT question into a usable checklist.',
  description = 'Choose the pressure point and use the preview to see what evidence, owners, and next actions should be gathered before a sales call or internal approval conversation.',
  compact = false,
} = Astro.props as Props;

const firstTool = resourceDecisionTools[0];
const buildToolBrief = (tool: typeof firstTool) =>
  [
    'Resource worksheet brief',
    `Tool: ${tool.title}`,
    `Buyer question: ${tool.buyerQuestion}`,
    `Pressure: ${tool.pressure}`,
    `Use when: ${tool.useWhen}`,
    '',
    'Check first:',
    ...tool.checks.map(check => `- ${check}`),
    '',
    `Owner: ${tool.owner}`,
    `Decision: ${tool.decision}`,
    `Output: ${tool.artifact}`,
    `Guardrail: ${tool.guardrail}`,
  ].join('\n');
const buildToolBriefSummary = (tool: typeof firstTool) =>
  `${tool.checks.length} checks, one accountable owner, a decision path, and a restraint that keeps the next step practical.`;
const firstBrief = buildToolBrief(firstTool);
const firstBriefSummary = buildToolBriefSummary(firstTool);
---

<section
  id={id}
  class:list={['resource-toolkit', compact && 'resource-toolkit--compact']}
  data-resource-toolkit
  data-testid="resource-decision-tools"
  data-page-section
>
  <div class="resource-toolkit__shell">
    <div class="resource-toolkit__header">
      <div>
        <p class="resource-toolkit__eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
      <p>{description}</p>
    </div>

    <div class="resource-toolkit__grid">
      <div class="resource-toolkit__tools" aria-label="Choose a decision tool">
        {
          resourceDecisionTools.map((tool, index) => (
            <button
              type="button"
              class:list={[
                'resource-toolkit__tool',
                index === 0 && 'is-active',
              ]}
              data-resource-tool-button
              data-tool-id={tool.id}
              data-tool-label={tool.label}
              data-tool-title={tool.title}
              data-tool-question={tool.buyerQuestion}
              data-tool-pressure={tool.pressure}
              data-tool-use-when={tool.useWhen}
              data-tool-checks={tool.checks.join('|')}
              data-tool-output={tool.output}
              data-tool-owner={tool.owner}
              data-tool-artifact={tool.artifact}
              data-tool-decision={tool.decision}
              data-tool-guardrail={tool.guardrail}
              data-tool-cta-href={withBasePath(tool.ctaHref)}
              data-tool-cta-label={tool.ctaLabel}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span>{tool.label}</span>
              <strong>{tool.title}</strong>
              <small>{tool.buyerQuestion}</small>
            </button>
          ))
        }
      </div>

      <aside class="resource-toolkit__preview" aria-live="polite">
        <div class="resource-toolkit__preview-top">
          <p data-resource-tool-label>{firstTool.label}</p>
          <span>Worksheet preview</span>
        </div>

        <h3 data-resource-tool-title>{firstTool.title}</h3>
        <p data-resource-tool-pressure>{firstTool.pressure}</p>

        <div class="resource-toolkit__checks">
          <p>Check first</p>
          <ul data-resource-tool-checks>
            {firstTool.checks.map(check => <li>{check}</li>)}
          </ul>
        </div>

        <details class="resource-toolkit__details">
          <summary>Context and guardrails</summary>

          <div class="resource-toolkit__details-body">
            <div class="resource-toolkit__preview-card">
              <p>Use when</p>
              <strong data-resource-tool-use-when>{firstTool.useWhen}</strong>
            </div>

            <div class="resource-toolkit__output">
              <p>Output</p>
              <strong data-resource-tool-output>{firstTool.output}</strong>
            </div>

            <div class="resource-toolkit__meta-grid">
              <div class="resource-toolkit__mini">
                <p>Owner</p>
                <strong data-resource-tool-owner>{firstTool.owner}</strong>
              </div>
              <div class="resource-toolkit__mini">
                <p>Decision</p>
                <strong data-resource-tool-decision>{firstTool.decision}</strong
                >
              </div>
            </div>

            <div class="resource-toolkit__guardrail">
              <p>Guardrail</p>
              <strong data-resource-tool-guardrail>{firstTool.guardrail}</strong
              >
            </div>
          </div>
        </details>

        <div class="resource-toolkit__brief">
          <div class="resource-toolkit__brief-top">
            <p>Working brief</p>
            <span>{firstTool.artifact}</span>
          </div>
          <p
            class="resource-toolkit__brief-summary"
            data-resource-tool-brief-summary
          >
            {firstBriefSummary}
          </p>
          <pre data-resource-tool-brief hidden>{firstBrief}</pre>
        </div>

        <div class="resource-toolkit__actions">
          <button
            type="button"
            class="resource-toolkit__copy"
            data-resource-tool-copy
          >
            Copy brief
          </button>

          <ModernButton
            href={withBasePath(firstTool.ctaHref)}
            variant="primary"
            rounded="sm"
            className="resource-toolkit__cta min-h-[50px]"
            data-resource-tool-cta
          >
            {firstTool.ctaLabel}
          </ModernButton>
        </div>
        <p
          class="resource-toolkit__status"
          data-resource-tool-status
          aria-live="polite"
        >
          Brief ready for internal routing.
        </p>
      </aside>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const initResourceToolkits = () => {
      document.querySelectorAll('[data-resource-toolkit]').forEach(root => {
        if (!(root instanceof HTMLElement)) return;
        if (root.dataset.resourceToolkitBound === 'true') return;
        root.dataset.resourceToolkitBound = 'true';

        const buttons = Array.from(
          root.querySelectorAll('[data-resource-tool-button]')
        ).filter(button => button instanceof HTMLButtonElement);
        const label = root.querySelector('[data-resource-tool-label]');
        const title = root.querySelector('[data-resource-tool-title]');
        const pressure = root.querySelector('[data-resource-tool-pressure]');
        const useWhen = root.querySelector('[data-resource-tool-use-when]');
        const checks = root.querySelector('[data-resource-tool-checks]');
        const output = root.querySelector('[data-resource-tool-output]');
        const owner = root.querySelector('[data-resource-tool-owner]');
        const decision = root.querySelector('[data-resource-tool-decision]');
        const guardrail = root.querySelector('[data-resource-tool-guardrail]');
        const brief = root.querySelector('[data-resource-tool-brief]');
        const briefSummary = root.querySelector(
          '[data-resource-tool-brief-summary]'
        );
        const briefArtifact = root.querySelector(
          '.resource-toolkit__brief-top span'
        );
        const copy = root.querySelector('[data-resource-tool-copy]');
        const status = root.querySelector('[data-resource-tool-status]');
        const cta = root.querySelector('[data-resource-tool-cta]');

        const getChecks = button =>
          (button.dataset.toolChecks || '').split('|').filter(Boolean);

        const buildBrief = button => {
          const lines = [
            'Resource worksheet brief',
            `Tool: ${button.dataset.toolTitle || ''}`,
            `Buyer question: ${button.dataset.toolQuestion || ''}`,
            `Pressure: ${button.dataset.toolPressure || ''}`,
            `Use when: ${button.dataset.toolUseWhen || ''}`,
            '',
            'Check first:',
            ...getChecks(button).map(check => `- ${check}`),
            '',
            `Owner: ${button.dataset.toolOwner || ''}`,
            `Decision: ${button.dataset.toolDecision || ''}`,
            `Output: ${button.dataset.toolArtifact || button.dataset.toolOutput || ''}`,
            `Guardrail: ${button.dataset.toolGuardrail || ''}`,
          ];
          return lines.join('\n');
        };

        const buildBriefSummary = button => {
          const checkCount = getChecks(button).length;
          return `${checkCount} checks, one accountable owner, a decision path, and a restraint that keeps the next step practical.`;
        };

        const hrefWithBrief = (href, briefText) => {
          if (!href) return href;
          try {
            const url = new URL(href, window.location.origin);
            url.searchParams.set('brief', briefText);
            return `${url.pathname}${url.search}${url.hash}`;
          } catch {
            return href;
          }
        };

        const sync = button => {
          const briefText = buildBrief(button);

          buttons.forEach(item => {
            const isActive = item === button;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', String(isActive));
          });

          root.dataset.activeTool = button.dataset.toolId || '';

          if (label instanceof HTMLElement) {
            label.textContent = button.dataset.toolLabel || '';
          }
          if (title instanceof HTMLElement) {
            title.textContent = button.dataset.toolTitle || '';
          }
          if (pressure instanceof HTMLElement) {
            pressure.textContent = button.dataset.toolPressure || '';
          }
          if (useWhen instanceof HTMLElement) {
            useWhen.textContent = button.dataset.toolUseWhen || '';
          }
          if (output instanceof HTMLElement) {
            output.textContent = button.dataset.toolOutput || '';
          }
          if (owner instanceof HTMLElement) {
            owner.textContent = button.dataset.toolOwner || '';
          }
          if (decision instanceof HTMLElement) {
            decision.textContent = button.dataset.toolDecision || '';
          }
          if (guardrail instanceof HTMLElement) {
            guardrail.textContent = button.dataset.toolGuardrail || '';
          }
          if (briefArtifact instanceof HTMLElement) {
            briefArtifact.textContent = button.dataset.toolArtifact || '';
          }
          if (briefSummary instanceof HTMLElement) {
            briefSummary.textContent = buildBriefSummary(button);
          }
          if (brief instanceof HTMLElement) {
            brief.textContent = briefText;
          }
          if (checks instanceof HTMLElement) {
            checks.replaceChildren();
            getChecks(button).forEach(check => {
              const item = document.createElement('li');
              item.textContent = check;
              checks.appendChild(item);
            });
          }
          if (cta instanceof HTMLAnchorElement) {
            cta.href = hrefWithBrief(button.dataset.toolCtaHref, briefText);
            const content = cta.querySelector('.modern-button__content');
            if (content instanceof HTMLElement) {
              content.textContent = button.dataset.toolCtaLabel || '';
            } else {
              cta.textContent = button.dataset.toolCtaLabel || '';
            }
          }
          if (status instanceof HTMLElement) {
            status.textContent = 'Brief ready for internal routing.';
          }
        };

        buttons.forEach(button => {
          button.addEventListener('click', () => sync(button));
          button.addEventListener('keydown', event => {
            const index = buttons.indexOf(button);
            const focusButton = nextIndex => {
              const next = buttons[nextIndex];
              if (next instanceof HTMLButtonElement) next.focus();
            };

            if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
              event.preventDefault();
              focusButton((index + 1) % buttons.length);
            }
            if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
              event.preventDefault();
              focusButton((index - 1 + buttons.length) % buttons.length);
            }
            if (event.key === 'Home') {
              event.preventDefault();
              focusButton(0);
            }
            if (event.key === 'End') {
              event.preventDefault();
              focusButton(buttons.length - 1);
            }
          });
        });

        if (copy instanceof HTMLButtonElement) {
          copy.addEventListener('click', async () => {
            const text = brief instanceof HTMLElement ? brief.textContent : '';
            const briefText = text?.trim();

            if (!briefText) return;

            try {
              if (!navigator.clipboard?.writeText) {
                throw new Error('Clipboard API unavailable');
              }
              copy.disabled = true;
              await navigator.clipboard.writeText(briefText);
              if (status instanceof HTMLElement) {
                status.textContent = 'Worksheet brief copied.';
              }
            } catch {
              if (status instanceof HTMLElement) {
                status.textContent =
                  'Clipboard blocked. The route button still carries the brief context.';
              }
            } finally {
              window.setTimeout(() => {
                copy.disabled = false;
              }, 500);
            }
          });
        }

        const activeButton = buttons.find(button =>
          button.classList.contains('is-active')
        );
        if (activeButton instanceof HTMLButtonElement) sync(activeButton);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initResourceToolkits, {
        once: true,
      });
    } else {
      initResourceToolkits();
    }

    document.addEventListener('astro:page-load', initResourceToolkits);
  })();
</script>

<style>
  .resource-toolkit {
    position: relative;
    overflow: clip;
    border-block: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-text-primary) 3.5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-text-primary) 2.5%, transparent) 1px,
        transparent 1px
      ),
      radial-gradient(
        circle at 14% 10%,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 13%,
          transparent
        ),
        transparent 32%
      ),
      color-mix(in srgb, var(--color-surface) 92%, transparent);
    background-size:
      54px 54px,
      54px 54px,
      auto,
      auto;
  }

  .resource-toolkit__shell {
    width: min(100% - 2rem, 1240px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6.25rem);
  }

  .resource-toolkit--compact .resource-toolkit__shell {
    padding-block: clamp(3rem, 5vw, 4.75rem);
  }

  .resource-toolkit__header {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .resource-toolkit__eyebrow,
  .resource-toolkit__tool span,
  .resource-toolkit__preview-top,
  .resource-toolkit__preview-card p,
  .resource-toolkit__checks p,
  .resource-toolkit__output p,
  .resource-toolkit__mini p,
  .resource-toolkit__guardrail p,
  .resource-toolkit__brief-top p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .resource-toolkit__eyebrow,
  .resource-toolkit__tool span,
  .resource-toolkit__preview-top,
  .resource-toolkit__preview-card p,
  .resource-toolkit__checks p,
  .resource-toolkit__output p,
  .resource-toolkit__mini p,
  .resource-toolkit__guardrail p,
  .resource-toolkit__brief-top p {
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
  }

  .resource-toolkit__header h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.3vw, 4.45rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .resource-toolkit__header > p {
    max-width: 62ch;
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.64;
  }

  .resource-toolkit__grid,
  .resource-toolkit__tools,
  .resource-toolkit__preview {
    display: grid;
    gap: 1rem;
  }

  .resource-toolkit__tool,
  .resource-toolkit__preview,
  .resource-toolkit__preview-card,
  .resource-toolkit__checks,
  .resource-toolkit__details,
  .resource-toolkit__output,
  .resource-toolkit__mini,
  .resource-toolkit__guardrail,
  .resource-toolkit__brief {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 0.75rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 3%, transparent),
        transparent 36%
      ),
      color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow: 0 24px 58px -50px rgba(0, 0, 0, 0.72);
  }

  .resource-toolkit__tool {
    display: grid;
    gap: 0.55rem;
    min-height: 8.5rem;
    padding: 1rem;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .resource-toolkit__tool strong,
  .resource-toolkit__preview h3,
  .resource-toolkit__preview-card strong,
  .resource-toolkit__output strong,
  .resource-toolkit__mini strong,
  .resource-toolkit__guardrail strong {
    color: var(--color-text-primary);
    font-weight: 760;
    letter-spacing: 0;
  }

  .resource-toolkit__tool strong {
    font-size: 1.02rem;
    line-height: 1.22;
  }

  .resource-toolkit__tool small,
  .resource-toolkit__preview > p,
  .resource-toolkit__preview-card strong,
  .resource-toolkit__checks li,
  .resource-toolkit__output strong,
  .resource-toolkit__mini strong,
  .resource-toolkit__guardrail strong,
  .resource-toolkit__status {
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    line-height: 1.5;
  }

  .resource-toolkit__tool.is-active,
  .resource-toolkit__tool:hover {
    transform: translateY(-1px);
    border-color: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 34%,
      transparent
    );
    background:
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 9%,
          transparent
        ),
        transparent 46%
      ),
      color-mix(in srgb, var(--color-surface) 94%, transparent);
  }

  .resource-toolkit__tool:focus-visible,
  .resource-toolkit__copy:focus-visible {
    outline: 3px solid
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 42%,
        transparent
      );
    outline-offset: 3px;
  }

  .resource-toolkit__preview {
    align-content: start;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .resource-toolkit__preview-top {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 64%, transparent);
    padding-bottom: 1rem;
  }

  .resource-toolkit__preview h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .resource-toolkit__preview > p {
    margin: 0;
  }

  .resource-toolkit__preview-card,
  .resource-toolkit__checks,
  .resource-toolkit__details,
  .resource-toolkit__output,
  .resource-toolkit__mini,
  .resource-toolkit__guardrail,
  .resource-toolkit__brief {
    display: grid;
    gap: 0.65rem;
    padding: 0.9rem;
  }

  .resource-toolkit__checks ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resource-toolkit__checks li {
    display: flex;
    gap: 0.55rem;
    font-size: 0.92rem;
  }

  .resource-toolkit__checks li::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    margin-top: 0.52rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 76%,
      white 10%
    );
  }

  .resource-toolkit__details {
    overflow: hidden;
  }

  .resource-toolkit__details summary {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.85rem 0.95rem;
    color: color-mix(in srgb, var(--color-text-primary) 90%, transparent);
    font-size: 0.9rem;
    font-weight: 760;
    cursor: pointer;
    list-style: none;
  }

  .resource-toolkit__details summary::-webkit-details-marker {
    display: none;
  }

  .resource-toolkit__details summary::after {
    content: '+';
    width: 1.5rem;
    height: 1.5rem;
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--color-text-muted) 88%, transparent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1;
  }

  .resource-toolkit__details[open] summary::after {
    content: '-';
  }

  .resource-toolkit__details summary:focus-visible {
    outline: 3px solid
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 42%,
        transparent
      );
    outline-offset: -3px;
  }

  .resource-toolkit__details-body {
    display: grid;
    gap: 0.85rem;
    padding: 0.2rem 0.95rem 1rem;
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 58%, transparent);
  }

  .resource-toolkit__details .resource-toolkit__preview-card,
  .resource-toolkit__details .resource-toolkit__output,
  .resource-toolkit__details .resource-toolkit__mini,
  .resource-toolkit__details .resource-toolkit__guardrail {
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
  }

  .resource-toolkit__details .resource-toolkit__meta-grid {
    padding-top: 0.1rem;
  }

  .resource-toolkit__meta-grid {
    display: grid;
    gap: 0.75rem;
  }

  .resource-toolkit__mini strong,
  .resource-toolkit__guardrail strong {
    font-size: 0.94rem;
    line-height: 1.48;
  }

  .resource-toolkit__guardrail {
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-warning, #c98121) 10%, transparent),
        transparent 54%
      ),
      color-mix(in srgb, var(--color-surface) 91%, transparent);
  }

  .resource-toolkit__brief {
    overflow: hidden;
    padding: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 8%, transparent),
        transparent 36%
      ),
      color-mix(in srgb, var(--color-surface-elevated) 88%, white 6%);
  }

  .resource-toolkit__brief-top {
    display: flex;
    gap: 0.85rem;
    align-items: start;
    justify-content: space-between;
    padding: 0.9rem 0.95rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 64%, transparent);
  }

  .resource-toolkit__brief-top span {
    max-width: 24ch;
    color: color-mix(in srgb, var(--color-text-secondary) 86%, transparent);
    font-size: 0.82rem;
    font-weight: 680;
    line-height: 1.35;
    text-align: right;
  }

  .resource-toolkit__brief-summary {
    margin: 0;
    padding: 1rem;
    color: color-mix(in srgb, var(--color-text-primary) 90%, transparent);
    font-size: 0.94rem;
    font-weight: 720;
    line-height: 1.5;
  }

  .resource-toolkit__actions {
    display: grid;
    gap: 0.75rem;
  }

  .resource-toolkit__copy {
    min-height: 50px;
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, transparent);
    border-radius: 0.25rem;
    background:
