---
import ModernButton from '../ui/ModernButton.astro';
import { CONTACT_EMAIL } from '../../consts';
import { withBasePath } from '../../utils/helpers';

const href = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Free consultation request')}`;
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed bottom-16 left-0 right-0 z-40 hidden px-4 md:hidden"
>
  <div
    class="tone-border tone-elevated pointer-events-auto mx-auto flex max-w-[740px] items-center justify-between gap-4 rounded-2xl border px-4 py-3 backdrop-blur"
  >
    <p class="tone-body text-sm">
      Want a flagship build brief in two minutes?
      <span class="tone-muted">Live config, no obligation.</span>
      <a
        class="ml-2 text-[#ccff00] hover:underline"
        href={withBasePath('build-studio/#studio')}>Launch studio</a
      >
    </p>
    <ModernButton
      href={href}
      variant="primary"
      className="pointer-events-auto min-h-[48px] whitespace-nowrap"
    >
      Schedule
    </ModernButton>
  </div>
</div>

<script is:inline>
  (function () {
    const el = document.getElementById('sticky-cta');
    if (!el) return;

    let shouldShow = false;

    function applyVisibility() {
      if (shouldShow) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    function onScroll() {
      // show after scrolling past ~1 viewport height
      shouldShow = window.scrollY > window.innerHeight * 0.8;
      applyVisibility();
    }

    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
