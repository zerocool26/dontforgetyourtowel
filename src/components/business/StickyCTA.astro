---
import ModernButton from '../ui/ModernButton.astro';
import { getRouteStickyCTA } from '../../utils/route-context';

const cta = getRouteStickyCTA(Astro.url.pathname);
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed left-0 right-0 z-40 hidden px-4 md:hidden"
  style="bottom: calc(8.85rem + env(safe-area-inset-bottom)); --sticky-accent: var(--color-primary);"
>
  <div
    class="tone-border tone-elevated sticky-cta-shell pointer-events-auto mx-auto flex max-w-[760px] items-center justify-between gap-4 rounded-[1.4rem] border px-4 py-3 backdrop-blur"
    style={`--sticky-accent:${cta.accent};`}
  >
    <div class="sticky-cta-shell__progress" aria-hidden="true">
      <span data-sticky-progress></span>
    </div>
    <p class="tone-body min-w-0 text-sm">
      <span class="sticky-cta-shell__eyebrow">{cta.eyebrow}</span>
      <span class="block">
        {cta.copy}
        <span class="tone-muted"> {cta.detail}</span>
      </span>
      <a
        class="sticky-cta-shell__link mt-2 inline-flex"
        href={cta.secondaryHref}>{cta.secondaryLabel}</a
      >
    </p>
    <ModernButton
      href={cta.primaryHref}
      variant="primary"
      className="pointer-events-auto min-h-[48px] whitespace-nowrap"
    >
      {cta.primaryLabel}
    </ModernButton>
  </div>
</div>

<style>
  .sticky-cta-shell {
    position: relative;
    overflow: hidden;
    box-shadow:
      0 26px 54px -32px rgba(0, 0, 0, 0.95),
      0 0 38px -24px color-mix(in srgb, var(--sticky-accent) 45%, transparent);
  }

  .sticky-cta-shell__progress {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .sticky-cta-shell__progress span {
    display: block;
    height: 100%;
    width: var(--sticky-progress, 0%);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sticky-accent) 42%, transparent),
      color-mix(in srgb, var(--sticky-accent) 88%, white 12%)
    );
    box-shadow: 0 0 18px
      color-mix(in srgb, var(--sticky-accent) 42%, transparent);
    transition: width 180ms ease;
  }

  .sticky-cta-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at top left,
        color-mix(in srgb, var(--sticky-accent) 18%, transparent),
        transparent 38%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--sticky-accent) 16%, transparent),
        transparent 42%
      );
    opacity: 0.9;
  }

  .sticky-cta-shell__eyebrow {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sticky-accent) 76%, white 24%);
  }

  .sticky-cta-shell__link {
    color: color-mix(in srgb, var(--sticky-accent) 78%, white 22%);
  }
</style>

<script is:inline>
  (function () {
    const globalScope = window;
    if (typeof globalScope.__stickyCtaCleanup === 'function') {
      globalScope.__stickyCtaCleanup();
    }

    const el = document.getElementById('sticky-cta');
    const progressEl = el?.querySelector('[data-sticky-progress]');
    if (!el) return;

    let shouldShow = false;
    let rafId = 0;

    function applyVisibility() {
      if (shouldShow) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    function updateProgress() {
      const scrollHeight =
        document.documentElement.scrollHeight - window.innerHeight;
      const progress =
        scrollHeight > 0 ? Math.min(window.scrollY / scrollHeight, 1) : 0;
      progressEl?.style.setProperty(
        '--sticky-progress',
        `${Math.round(progress * 100)}%`
      );
    }

    function onScroll() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        // show after scrolling past ~1 viewport height
        shouldShow = window.scrollY > window.innerHeight * 0.8;
        applyVisibility();
        updateProgress();
      });
    }

    document.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    globalScope.__stickyCtaCleanup = function () {
      document.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      if (rafId) cancelAnimationFrame(rafId);
    };
    onScroll();
  })();
</script>
