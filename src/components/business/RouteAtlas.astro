---
import { BASE_PATH } from '../../consts';
import { tradeProfiles } from '../../data/trades';
import { withBasePath } from '../../utils/helpers';

const normalizePath = (value: string) => {
  const strippedBase =
    BASE_PATH && BASE_PATH !== '/' ? value.replace(BASE_PATH, '/') : value;
  const trimmed = strippedBase.replace(/\/+$/, '');
  return trimmed.length ? trimmed : '/';
};

const currentPath = normalizePath(Astro.url.pathname);
const pathSegments = currentPath.split('/').filter(Boolean);
const activeTrade =
  pathSegments[0] === 'trades'
    ? tradeProfiles.find(trade => trade.slug === pathSegments[1])
    : undefined;
const activeSubpage =
  activeTrade && pathSegments[2]
    ? activeTrade.subpages.find(subpage => subpage.slug === pathSegments[2])
    : undefined;

let atlasKicker = 'Site Atlas';
let atlasTitle =
  'One connected route system for every trade and platform page.';
let atlasCopy =
  'The site now behaves like a structured platform. Use this atlas to keep moving through related routes instead of bouncing between disconnected pages.';
let atlasAccent = '#ccff00';
let currentTitle = 'Current route';
let currentDescription =
  'You are inside the live seven-trade platform with shared navigation, search, and route-aware UX.';
let currentCategory = 'Platform';
let suggestions = [
  {
    label: 'Open trade directory',
    detail: 'Jump straight into the seven-trade map.',
    href: withBasePath('trades/'),
  },
  {
    label: 'Enter design gallery',
    detail: 'Study the premium visual experiments tied back to live routes.',
    href: withBasePath('gallery/'),
  },
  {
    label: 'Read platform story',
    detail:
      'See how the site is structured from landing page to trade vertical.',
    href: withBasePath('company/'),
  },
];

if (currentPath.startsWith('/gallery')) {
  atlasKicker = 'Gallery Atlas';
  atlasTitle = 'Gallery concepts stay wired into the real site map.';
  atlasCopy =
    'The gallery is not isolated art direction. It routes directly back into the working trades, services, and build experiences.';
  atlasAccent = '#7dd3fc';
  currentTitle = 'Design Gallery';
  currentDescription =
    'Interactive gallery mode for premium visual studies, curatorial filters, and route-linked concepts.';
  currentCategory = 'Gallery';
  suggestions = [
    {
      label: 'Browse trade directory',
      detail: 'Move from visual studies into the live seven-trade structure.',
      href: withBasePath('trades/'),
    },
    {
      label: 'Open Build Studio',
      detail:
        'Shift from gallery thinking into a flagship interactive planning route.',
      href: withBasePath('build-studio/#studio'),
    },
    {
      label: 'Read platform architecture',
      detail: 'See how the gallery fits the broader site system.',
      href: withBasePath('company/'),
    },
  ];
} else if (currentPath.startsWith('/services')) {
  atlasKicker = 'Services Atlas';
  atlasTitle =
    'Trade delivery and retained tech systems now share one service map.';
  atlasCopy =
    'The services hub is the bridge between the field-facing trades and the deeper digital catalog. The route logic should stay visible here.';
  currentTitle = 'Services Hub';
  currentDescription =
    'Cross-trade bridge page for MSP, cloud, AI, pricing, planning tools, and seven-trade routing.';
  currentCategory = 'Services';
  suggestions = [
    {
      label: 'Open planner',
      detail: 'Jump to the live matrix and recommendation tooling.',
      href: withBasePath('services/#service-planner'),
    },
    {
      label: 'Browse all trades',
      detail: 'Move from broad service mapping into specific trade worlds.',
      href: withBasePath('trades/'),
    },
    {
      label: 'Start intake',
      detail: 'Route a trade-aware or services-aware project brief.',
      href: withBasePath('contact-hq/'),
    },
  ];
} else if (currentPath.startsWith('/company')) {
  atlasKicker = 'Platform Atlas';
  atlasTitle =
    'The about page explains the operating logic behind the whole site.';
  atlasCopy =
    'This page holds the higher-level structure so the landing page can stay expressive and the trade routes can stay specialized.';
  atlasAccent = '#f59e0b';
  currentTitle = 'About The Platform';
  currentDescription =
    'Broader site architecture, trade positioning, and system logic for the seven-trade build.';
  currentCategory = 'About';
  suggestions = [
    {
      label: 'Return to landing page',
      detail: 'Go back to the creative front door and platform overview.',
      href: withBasePath('/'),
    },
    {
      label: 'Study the gallery',
      detail:
        'See the design system stretched into higher-expression territory.',
      href: withBasePath('gallery/'),
    },
    {
      label: 'Browse trade worlds',
      detail: 'Move from platform logic into the specialized vertical pages.',
      href: withBasePath('trades/'),
    },
  ];
} else if (activeTrade) {
  atlasKicker = `${activeTrade.shortName} Atlas`;
  atlasTitle = activeSubpage
    ? `${activeSubpage.title} sits inside a bigger ${activeTrade.shortName} route system.`
    : `${activeTrade.shortName} is treated like its own premium vertical, not a generic services page.`;
  atlasCopy = activeSubpage
    ? 'Use the atlas to move back to the overview, branch into related routes, or jump into intake with the context preserved.'
    : 'Overview, subpages, services integration, and intake now behave like one coordinated route family.';
  atlasAccent = activeTrade.accent;
  currentTitle = activeSubpage ? activeSubpage.title : activeTrade.name;
  currentDescription = activeSubpage
    ? activeSubpage.description
    : activeTrade.summary;
  currentCategory = activeSubpage ? 'Trade Route' : 'Trade Overview';
  suggestions = activeSubpage
    ? [
        {
          label: `Open ${activeTrade.shortName} overview`,
          detail:
            'Step back to the main vertical and service architecture for this trade.',
          href: withBasePath(`trades/${activeTrade.slug}/`),
        },
        ...activeTrade.subpages
          .filter(subpage => subpage.slug !== activeSubpage.slug)
          .slice(0, 1)
          .map(subpage => ({
            label: subpage.title,
            detail: 'Jump laterally into the sibling route for this trade.',
            href: withBasePath(`trades/${activeTrade.slug}/${subpage.slug}/`),
          })),
        {
          label: 'Start trade intake',
          detail:
            'Carry this route directly into contact with trade context attached.',
          href: `${withBasePath('contact-hq/')}?trade=${encodeURIComponent(activeTrade.slug)}&tradePage=${encodeURIComponent(activeSubpage.title)}`,
        },
      ]
    : [
        ...activeTrade.subpages.slice(0, 2).map(subpage => ({
          label: subpage.title,
          detail: 'Open a more specialized route inside this trade vertical.',
          href: withBasePath(`trades/${activeTrade.slug}/${subpage.slug}/`),
        })),
        {
          label: 'Open services hub',
          detail:
            'See how this trade links back into the retained digital systems.',
          href: withBasePath('services/'),
        },
      ];
} else if (currentPath.startsWith('/trades')) {
  atlasKicker = 'Trade Atlas';
  atlasTitle = 'The trade directory is the source map for the seven verticals.';
  atlasCopy =
    'Use the directory to branch into trade-specific worlds, then come back through shared services, gallery, and intake routes.';
  currentTitle = 'Trade Directory';
  currentDescription =
    'Browse all seven trade overviews and supporting subpages from one structured index.';
  currentCategory = 'Trade Directory';
  suggestions = [
    {
      label: 'Return to landing page',
      detail:
        'Move back to the main command center and broader platform framing.',
      href: withBasePath('/'),
    },
    {
      label: 'Open services hub',
      detail:
        'See the bridge between trade lanes and retained digital systems.',
      href: withBasePath('services/'),
    },
    {
      label: 'Study gallery ideas',
      detail:
        'See the trade worlds translated into more art-forward interface experiments.',
      href: withBasePath('gallery/'),
    },
  ];
}
---

<section
  class="route-atlas"
  data-route-atlas
  data-route-url={currentPath}
  data-route-title={currentTitle}
  data-route-description={currentDescription}
  data-route-category={currentCategory}
  style={`--route-atlas-accent:${atlasAccent};`}
>
  <div class="route-atlas__header">
    <div class="space-y-3">
      <p class="creative-kicker">{atlasKicker}</p>
      <h2 class="route-atlas__title">{atlasTitle}</h2>
      <p class="route-atlas__copy">{atlasCopy}</p>
    </div>
    <div class="route-atlas__current">
      <p class="route-atlas__label">Current route</p>
      <p class="route-atlas__current-title">{currentTitle}</p>
      <p class="route-atlas__current-copy">{currentDescription}</p>
      <span class="route-atlas__badge">{currentCategory}</span>
    </div>
  </div>

  <div class="route-atlas__grid">
    <div class="route-atlas__panel">
      <div class="route-atlas__panel-head">
        <p class="route-atlas__label">Continue with intention</p>
        <span class="route-atlas__microcopy">Next best routes</span>
      </div>
      <div class="route-atlas__links">
        {
          suggestions.map(link => (
            <a class="route-atlas__link" href={link.href}>
              <span class="route-atlas__link-title">{link.label}</span>
              <span class="route-atlas__link-copy">{link.detail}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="route-atlas__panel">
      <div class="route-atlas__panel-head">
        <p class="route-atlas__label">Resume exploration</p>
        <button
          type="button"
          class="route-atlas__clear"
          data-route-atlas-clear
          hidden
        >
          Clear
        </button>
      </div>
      <div class="route-atlas__history" data-route-atlas-history>
        <p class="route-atlas__empty" data-route-atlas-empty>
          As you move through the site, your recent routes will appear here for
          quick return access.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    clearRecentRoutes,
    pushRecentRoute,
    readRecentRoutes,
    toNavigableRouteUrl,
  } from '../../utils/route-memory';

  declare global {
    interface Window {
      __routeAtlasCleanup?: () => void;
    }
  }

  const bindRouteAtlas = () => {
    window.__routeAtlasCleanup?.();

    const root = document.querySelector<HTMLElement>('[data-route-atlas]');
    if (!root) return;

    const currentRoute = {
      url: root.dataset.routeUrl || '/',
      title: root.dataset.routeTitle || 'Current route',
      description: root.dataset.routeDescription || '',
      category: root.dataset.routeCategory || 'Page',
    };

    const historyTarget = root.querySelector(
      '[data-route-atlas-history]'
    ) as HTMLElement | null;
    const emptyTarget = root.querySelector(
      '[data-route-atlas-empty]'
    ) as HTMLElement | null;
    const clearButton = root.querySelector(
      '[data-route-atlas-clear]'
    ) as HTMLButtonElement | null;

    const renderHistory = () => {
      if (!historyTarget) return;

      const items = readRecentRoutes()
        .filter(item => item.url !== currentRoute.url)
        .slice(0, 3);

      historyTarget.innerHTML = '';

      if (!items.length) {
        if (emptyTarget) {
          historyTarget.appendChild(emptyTarget);
        } else {
          const placeholder = document.createElement('p');
          placeholder.className = 'route-atlas__empty';
          placeholder.textContent =
            'As you move through the site, your recent routes will appear here.';
          historyTarget.appendChild(placeholder);
        }
        if (clearButton) clearButton.hidden = true;
        return;
      }

      items.forEach(item => {
        const link = document.createElement('a');
        link.className = 'route-atlas__history-item';
        link.href = toNavigableRouteUrl(item.url);

        const title = document.createElement('span');
        title.className = 'route-atlas__history-title';
        title.textContent = item.title;

        const meta = document.createElement('span');
        meta.className = 'route-atlas__history-meta';
        meta.textContent = item.category;

        const copy = document.createElement('span');
        copy.className = 'route-atlas__history-copy';
        copy.textContent = item.description;

        link.append(title, meta, copy);
        historyTarget.appendChild(link);
      });

      if (clearButton) clearButton.hidden = false;
    };

    const handleClear = () => {
      clearRecentRoutes();
      renderHistory();
    };

    pushRecentRoute(currentRoute);
    renderHistory();

    clearButton?.addEventListener('click', handleClear);
    window.addEventListener('olive:route-memory-updated', renderHistory);

    window.__routeAtlasCleanup = () => {
      clearButton?.removeEventListener('click', handleClear);
      window.removeEventListener('olive:route-memory-updated', renderHistory);
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindRouteAtlas, {
      once: true,
    });
  } else {
    bindRouteAtlas();
  }

  document.addEventListener('astro:page-load', bindRouteAtlas);
</script>

<style>
  .route-atlas {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.85rem;
    background:
      radial-gradient(
        circle at top left,
        color-mix(in srgb, var(--route-atlas-accent) 16%, transparent),
        transparent 28%
      ),
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.015)
      ),
      rgba(6, 8, 12, 0.86);
    box-shadow:
      0 34px 90px -46px rgba(0, 0, 0, 0.96),
      0 0 56px -30px
        color-mix(in srgb, var(--route-atlas-accent) 22%, transparent);
    backdrop-filter: blur(18px);
  }

  .route-atlas::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent 100%);
    opacity: 0.45;
  }

  .route-atlas__header {
    display: grid;
    gap: 1.2rem;
    padding: 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .route-atlas__title {
    margin: 0;
    font-size: clamp(1.5rem, 2.4vw, 2.35rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.98);
  }

  .route-atlas__copy,
  .route-atlas__current-copy,
  .route-atlas__link-copy,
  .route-atlas__history-copy {
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    line-height: 1.55;
  }

  .route-atlas__current {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-atlas-accent) 22%,
        rgba(255, 255, 255, 0.08)
      );
    border-radius: 1.35rem;
    padding: 1rem;
    background: color-mix(
      in srgb,
      var(--route-atlas-accent) 8%,
      rgba(255, 255, 255, 0.03)
    );
  }

  .route-atlas__label,
  .route-atlas__microcopy,
  .route-atlas__history-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .route-atlas__label {
    margin: 0 0 0.45rem;
    color: rgba(255, 255, 255, 0.44);
  }

  .route-atlas__current-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .route-atlas__badge {
    display: inline-flex;
    margin-top: 0.8rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-atlas-accent) 28%,
        rgba(255, 255, 255, 0.08)
      );
    padding: 0.34rem 0.66rem;
    font-size: 0.66rem;
    font-family: var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--route-atlas-accent) 74%, white 26%);
  }

  .route-atlas__grid {
    display: grid;
    gap: 1rem;
    padding: 1.4rem;
  }

  .route-atlas__panel {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .route-atlas__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }

  .route-atlas__microcopy {
    color: color-mix(in srgb, var(--route-atlas-accent) 58%, white 42%);
  }

  .route-atlas__links,
  .route-atlas__history {
    display: grid;
    gap: 0.7rem;
  }

  .route-atlas__link,
  .route-atlas__history-item {
    display: grid;
    gap: 0.32rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 0.95rem;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .route-atlas__link:hover,
  .route-atlas__history-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(
      in srgb,
      var(--route-atlas-accent) 24%,
      rgba(255, 255, 255, 0.08)
    );
    background: color-mix(
      in srgb,
      var(--route-atlas-accent) 9%,
      rgba(255, 255, 255, 0.03)
    );
  }

  .route-atlas__link-title,
  .route-atlas__history-title {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 700;
    line-height: 1.3;
  }

  .route-atlas__history-meta {
    color: color-mix(in srgb, var(--route-atlas-accent) 64%, white 36%);
  }

  .route-atlas__clear {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.4rem 0.72rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .route-atlas__empty {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .route-atlas__header {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      align-items: end;
    }

    .route-atlas__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
