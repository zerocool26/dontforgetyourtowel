---
import {
  getRouteContext,
  normalizeContextPath,
} from '../../utils/route-context';

const currentPath = normalizeContextPath(Astro.url.pathname);
const routeContext = getRouteContext(Astro.url.pathname);
---

<section
  class="route-atlas"
  data-route-atlas
  data-route-url={currentPath}
  data-route-title={routeContext.currentTitle}
  data-route-description={routeContext.currentDescription}
  data-route-category={routeContext.currentCategory}
  style={`--route-atlas-accent:${routeContext.accent};`}
>
  <div class="route-atlas__header">
    <div class="space-y-3">
      <p class="creative-kicker">{routeContext.kicker}</p>
      <h2 class="route-atlas__title">{routeContext.title}</h2>
      <p class="route-atlas__copy">{routeContext.description}</p>
    </div>
    <div class="route-atlas__current">
      <p class="route-atlas__label">Current route</p>
      <p class="route-atlas__current-title">{routeContext.currentTitle}</p>
      <p class="route-atlas__current-copy">
        {routeContext.currentDescription}
      </p>
      <span class="route-atlas__badge">{routeContext.currentCategory}</span>
      <div class="route-atlas__actions">
        <button
          type="button"
          class="route-atlas__action"
          data-route-atlas-pin-current
        >
          Save route
        </button>
        <button
          type="button"
          class="route-atlas__action"
          data-route-atlas-copy-current
        >
          Copy link
        </button>
      </div>
    </div>
  </div>

  <div class="route-atlas__grid">
    <div class="route-atlas__panel">
      <div class="route-atlas__panel-head">
        <p class="route-atlas__label">Continue with intention</p>
        <span class="route-atlas__microcopy">Next best routes</span>
      </div>
      <div class="route-atlas__links">
        {
          routeContext.suggestions.map(link => (
            <div class="route-atlas__link-shell">
              <a class="route-atlas__link" href={link.href}>
                <span class="route-atlas__link-title">{link.label}</span>
                <span class="route-atlas__link-copy">{link.detail}</span>
              </a>
              <button
                type="button"
                class="route-atlas__save-link"
                data-route-atlas-pin-link={link.href}
                data-route-atlas-pin-title={link.label}
                data-route-atlas-pin-description={link.detail}
                data-route-atlas-pin-category="Suggested Route"
                aria-label={`Save ${link.label}`}
              >
                Save
              </button>
            </div>
          ))
        }
      </div>
    </div>

    <div class="route-atlas__panel">
      <div class="route-atlas__panel-head">
        <p class="route-atlas__label">Saved routes</p>
        <button
          type="button"
          class="route-atlas__clear"
          data-route-atlas-clear-pins
          hidden
        >
          Clear saved
        </button>
      </div>
      <div
        class="route-atlas__history route-atlas__history--pinned"
        data-route-atlas-pins
      >
        <p class="route-atlas__empty" data-route-atlas-pins-empty>
          Save standout routes here to build your own cross-site shortlist.
        </p>
      </div>
      <div class="route-atlas__workspace-actions">
        <button
          type="button"
          class="route-atlas__action"
          data-route-atlas-workspace-brief
        >
          Brief saved set
        </button>
        <button
          type="button"
          class="route-atlas__action"
          data-route-atlas-workspace-copy
        >
          Copy workspace
        </button>
      </div>
    </div>

    <div class="route-atlas__panel">
      <div class="route-atlas__panel-head">
        <p class="route-atlas__label">Resume exploration</p>
        <button
          type="button"
          class="route-atlas__clear"
          data-route-atlas-clear
          hidden
        >
          Clear recent
        </button>
      </div>
      <div class="route-atlas__history" data-route-atlas-history>
        <p class="route-atlas__empty" data-route-atlas-empty>
          As you move through the site, your recent routes will appear here for
          quick return access.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    buildWorkspaceClipboardPayload,
    buildWorkspaceContactHref,
    clearRecentRoutes,
    clearPinnedRoutes,
    isPinnedRoute,
    pinRoute,
    pushRecentRoute,
    readPinnedRoutes,
    readRecentRoutes,
    togglePinnedRoute,
    toNavigableRouteUrl,
    unpinRoute,
  } from '../../utils/route-memory';

  declare global {
    interface Window {
      __routeAtlasCleanup?: () => void;
    }
  }

  const bindRouteAtlas = () => {
    window.__routeAtlasCleanup?.();

    const root = document.querySelector<HTMLElement>('[data-route-atlas]');
    if (!root) return;

    const currentRoute = {
      url: root.dataset.routeUrl || '/',
      title: root.dataset.routeTitle || 'Current route',
      description: root.dataset.routeDescription || '',
      category: root.dataset.routeCategory || 'Page',
    };

    const historyTarget = root.querySelector(
      '[data-route-atlas-history]'
    ) as HTMLElement | null;
    const pinsTarget = root.querySelector(
      '[data-route-atlas-pins]'
    ) as HTMLElement | null;
    const emptyTarget = root.querySelector(
      '[data-route-atlas-empty]'
    ) as HTMLElement | null;
    const pinsEmptyTarget = root.querySelector(
      '[data-route-atlas-pins-empty]'
    ) as HTMLElement | null;
    const clearButton = root.querySelector(
      '[data-route-atlas-clear]'
    ) as HTMLButtonElement | null;
    const clearPinsButton = root.querySelector(
      '[data-route-atlas-clear-pins]'
    ) as HTMLButtonElement | null;
    const workspaceBriefButton = root.querySelector(
      '[data-route-atlas-workspace-brief]'
    ) as HTMLButtonElement | null;
    const workspaceCopyButton = root.querySelector(
      '[data-route-atlas-workspace-copy]'
    ) as HTMLButtonElement | null;
    const pinCurrentButton = root.querySelector(
      '[data-route-atlas-pin-current]'
    ) as HTMLButtonElement | null;
    const copyCurrentButton = root.querySelector(
      '[data-route-atlas-copy-current]'
    ) as HTMLButtonElement | null;
    const pinLinkButtons = Array.from(
      root.querySelectorAll<HTMLElement>('[data-route-atlas-pin-link]')
    );

    const syncPinButton = () => {
      if (!pinCurrentButton) return;
      const pinned = isPinnedRoute(currentRoute.url);
      pinCurrentButton.textContent = pinned ? 'Saved route' : 'Save route';
      pinCurrentButton.dataset.pinned = pinned ? 'true' : 'false';
    };

    const renderHistory = () => {
      if (!historyTarget) return;

      const items = readRecentRoutes()
        .filter(item => item.url !== currentRoute.url)
        .slice(0, 3);

      historyTarget.replaceChildren();

      if (!items.length) {
        if (emptyTarget) {
          historyTarget.appendChild(emptyTarget);
        } else {
          const placeholder = document.createElement('p');
          placeholder.className = 'route-atlas__empty';
          placeholder.textContent =
            'As you move through the site, your recent routes will appear here.';
          historyTarget.appendChild(placeholder);
        }
        if (clearButton) clearButton.hidden = true;
        return;
      }

      items.forEach(item => {
        const link = document.createElement('a');
        link.className = 'route-atlas__history-item';
        link.href = toNavigableRouteUrl(item.url);

        const title = document.createElement('span');
        title.className = 'route-atlas__history-title';
        title.textContent = item.title;

        const meta = document.createElement('span');
        meta.className = 'route-atlas__history-meta';
        meta.textContent = item.category;

        const copy = document.createElement('span');
        copy.className = 'route-atlas__history-copy';
        copy.textContent = item.description;

        link.append(title, meta, copy);
        historyTarget.appendChild(link);
      });

      if (clearButton) clearButton.hidden = false;
    };

    const renderPins = () => {
      if (!pinsTarget) return;

      const items = readPinnedRoutes().slice(0, 4);
      pinsTarget.replaceChildren();

      if (!items.length) {
        if (pinsEmptyTarget) {
          pinsTarget.appendChild(pinsEmptyTarget);
        } else {
          const placeholder = document.createElement('p');
          placeholder.className = 'route-atlas__empty';
          placeholder.textContent =
            'Save standout routes to return to them quickly.';
          pinsTarget.appendChild(placeholder);
        }
        if (clearPinsButton) clearPinsButton.hidden = true;
        syncPinButton();
        return;
      }

      items.forEach(item => {
        const shell = document.createElement('div');
        shell.className = 'route-atlas__saved-shell';

        const link = document.createElement('a');
        link.className = 'route-atlas__history-item';
        link.href = toNavigableRouteUrl(item.url);

        const title = document.createElement('span');
        title.className = 'route-atlas__history-title';
        title.textContent = item.title;

        const meta = document.createElement('span');
        meta.className = 'route-atlas__history-meta';
        meta.textContent = item.category;

        const copy = document.createElement('span');
        copy.className = 'route-atlas__history-copy';
        copy.textContent = item.description;

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'route-atlas__remove-link';
        removeButton.textContent = 'Remove';
        removeButton.addEventListener('click', () => {
          unpinRoute(item.url);
          renderPins();
        });

        link.append(title, meta, copy);
        shell.append(link, removeButton);
        pinsTarget.appendChild(shell);
      });

      if (clearPinsButton) clearPinsButton.hidden = false;
      syncPinButton();
    };

    const handleClear = () => {
      clearRecentRoutes();
      renderHistory();
    };

    const handleClearPins = () => {
      clearPinnedRoutes();
      renderPins();
    };

    const handlePinCurrent = () => {
      togglePinnedRoute(currentRoute);
      renderPins();
    };

    const handleCopyCurrent = async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyCurrentButton) {
          copyCurrentButton.textContent = 'Copied';
          window.setTimeout(() => {
            if (copyCurrentButton) {
              copyCurrentButton.textContent = 'Copy link';
            }
          }, 1200);
        }
      } catch {
        if (copyCurrentButton) {
          copyCurrentButton.textContent = 'Unavailable';
          window.setTimeout(() => {
            if (copyCurrentButton) {
              copyCurrentButton.textContent = 'Copy link';
            }
          }, 1200);
        }
      }
    };

    const handlePinSuggestion = (event: Event) => {
      const button = event.currentTarget as HTMLElement | null;
      const href = button?.dataset.routeAtlasPinLink;
      const title = button?.dataset.routeAtlasPinTitle;
      const description = button?.dataset.routeAtlasPinDescription;
      const category = button?.dataset.routeAtlasPinCategory;
      if (!href || !title || !description || !category) return;

      pinRoute({
        url: href,
        title,
        description,
        category,
      });
      renderPins();
    };

    const handleWorkspaceBrief = () => {
      const items = readPinnedRoutes();
      if (!items.length) return;

      const nextHref = buildWorkspaceContactHref(items);
      try {
        const nextUrl = new URL(nextHref, window.location.href);
        if (
          nextUrl.protocol === 'mailto:' ||
          nextUrl.origin === window.location.origin
        ) {
          window.location.assign(nextUrl.toString());
        }
      } catch {
        // ignore invalid or blocked navigation targets
      }
    };

    const handleWorkspaceCopy = async () => {
      const items = readPinnedRoutes();
      if (!items.length || !workspaceCopyButton) return;

      try {
        await navigator.clipboard.writeText(
          buildWorkspaceClipboardPayload(items)
        );
        workspaceCopyButton.textContent = 'Copied';
      } catch {
        workspaceCopyButton.textContent = 'Unavailable';
      }

      window.setTimeout(() => {
        workspaceCopyButton.textContent = 'Copy workspace';
      }, 1200);
    };

    pushRecentRoute(currentRoute);
    renderHistory();
    renderPins();

    clearButton?.addEventListener('click', handleClear);
    clearPinsButton?.addEventListener('click', handleClearPins);
    pinCurrentButton?.addEventListener('click', handlePinCurrent);
    copyCurrentButton?.addEventListener('click', handleCopyCurrent);
    workspaceBriefButton?.addEventListener('click', handleWorkspaceBrief);
    workspaceCopyButton?.addEventListener('click', handleWorkspaceCopy);
    pinLinkButtons.forEach(button => {
      button.addEventListener('click', handlePinSuggestion);
    });
    window.addEventListener('olive:route-memory-updated', renderHistory);
    window.addEventListener('olive:route-pins-updated', renderPins);

    window.__routeAtlasCleanup = () => {
      clearButton?.removeEventListener('click', handleClear);
      clearPinsButton?.removeEventListener('click', handleClearPins);
      pinCurrentButton?.removeEventListener('click', handlePinCurrent);
      copyCurrentButton?.removeEventListener('click', handleCopyCurrent);
      workspaceBriefButton?.removeEventListener('click', handleWorkspaceBrief);
      workspaceCopyButton?.removeEventListener('click', handleWorkspaceCopy);
      pinLinkButtons.forEach(button => {
        button.removeEventListener('click', handlePinSuggestion);
      });
      window.removeEventListener('olive:route-memory-updated', renderHistory);
      window.removeEventListener('olive:route-pins-updated', renderPins);
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindRouteAtlas, {
      once: true,
    });
  } else {
    bindRouteAtlas();
  }

  document.addEventListener('astro:page-load', bindRouteAtlas);
</script>

<style>
  .route-atlas {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.85rem;
    background:
      radial-gradient(
        circle at top left,
        color-mix(in srgb, var(--route-atlas-accent) 16%, transparent),
        transparent 28%
      ),
      linear-gradient(
        160deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.015)
      ),
      rgba(6, 8, 12, 0.86);
    box-shadow:
      0 34px 90px -46px rgba(0, 0, 0, 0.96),
      0 0 56px -30px
        color-mix(in srgb, var(--route-atlas-accent) 22%, transparent);
    backdrop-filter: blur(18px);
  }

  .route-atlas::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent 100%);
    opacity: 0.45;
  }

  .route-atlas__header {
    display: grid;
    gap: 1.2rem;
    padding: 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .route-atlas__title {
    margin: 0;
    font-size: clamp(1.5rem, 2.4vw, 2.35rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.98);
  }

  .route-atlas__copy,
  .route-atlas__current-copy,
  .route-atlas__link-copy,
  .route-atlas__history-copy {
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    line-height: 1.55;
  }

  .route-atlas__current {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-atlas-accent) 22%,
        rgba(255, 255, 255, 0.08)
      );
    border-radius: 1.35rem;
    padding: 1rem;
    background: color-mix(
      in srgb,
      var(--route-atlas-accent) 8%,
      rgba(255, 255, 255, 0.03)
    );
  }

  .route-atlas__label,
  .route-atlas__microcopy,
  .route-atlas__history-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .route-atlas__label {
    margin: 0 0 0.45rem;
    color: rgba(255, 255, 255, 0.44);
  }

  .route-atlas__current-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .route-atlas__badge {
    display: inline-flex;
    margin-top: 0.8rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-atlas-accent) 28%,
        rgba(255, 255, 255, 0.08)
      );
    padding: 0.34rem 0.66rem;
    font-size: 0.66rem;
    font-family: var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--route-atlas-accent) 74%, white 26%);
  }

  .route-atlas__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .route-atlas__action,
  .route-atlas__save-link,
  .route-atlas__remove-link {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.48rem 0.78rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.74);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  @media (hover: hover) {
    .route-atlas__action:hover,
    .route-atlas__save-link:hover,
    .route-atlas__remove-link:hover {
      border-color: color-mix(
        in srgb,
        var(--route-atlas-accent) 28%,
        rgba(255, 255, 255, 0.08)
      );
      background: color-mix(
        in srgb,
        var(--route-atlas-accent) 10%,
        rgba(255, 255, 255, 0.03)
      );
      color: rgba(255, 255, 255, 0.96);
    }
  }

  .route-atlas__action[data-pinned='true'] {
    border-color: color-mix(
      in srgb,
      var(--route-atlas-accent) 28%,
      rgba(255, 255, 255, 0.08)
    );
    background: color-mix(
      in srgb,
      var(--route-atlas-accent) 10%,
      rgba(255, 255, 255, 0.03)
    );
    color: rgba(255, 255, 255, 0.96);
  }

  .route-atlas__action:active,
  .route-atlas__save-link:active,
  .route-atlas__remove-link:active {
    transform: scale(0.96);
  }

  .route-atlas__grid {
    display: grid;
    gap: 1rem;
    padding: 1.4rem;
  }

  .route-atlas__panel {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.025);
    padding: 1rem;
  }

  .route-atlas__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
  }

  .route-atlas__microcopy {
    color: color-mix(in srgb, var(--route-atlas-accent) 58%, white 42%);
  }

  .route-atlas__links,
  .route-atlas__history {
    display: grid;
    gap: 0.7rem;
  }

  .route-atlas__workspace-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.85rem;
  }

  .route-atlas__link-shell,
  .route-atlas__saved-shell {
    display: grid;
    gap: 0.55rem;
  }

  .route-atlas__link,
  .route-atlas__history-item {
    display: grid;
    gap: 0.32rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 0.95rem;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  @media (hover: hover) {
    .route-atlas__link:hover,
    .route-atlas__history-item:hover {
      transform: translateY(-2px);
      border-color: color-mix(
        in srgb,
        var(--route-atlas-accent) 24%,
        rgba(255, 255, 255, 0.08)
      );
      background: color-mix(
        in srgb,
        var(--route-atlas-accent) 9%,
        rgba(255, 255, 255, 0.03)
      );
    }
  }

  .route-atlas__link:active,
  .route-atlas__history-item:active {
    transform: scale(0.985);
    background: color-mix(
      in srgb,
      var(--route-atlas-accent) 8%,
      rgba(255, 255, 255, 0.03)
    );
  }

  .route-atlas__link-title,
  .route-atlas__history-title {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 700;
    line-height: 1.3;
  }

  .route-atlas__history-meta {
    color: color-mix(in srgb, var(--route-atlas-accent) 64%, white 36%);
  }

  .route-atlas__save-link,
  .route-atlas__remove-link {
    justify-self: start;
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .route-atlas__clear {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.4rem 0.72rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .route-atlas__empty {
    margin: 0;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .route-atlas__header {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      align-items: end;
    }

    .route-atlas__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.85fr) minmax(
          0,
          0.85fr
        );
    }
  }
</style>
