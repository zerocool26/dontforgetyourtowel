---
import ModernButton from '../ui/ModernButton.astro';
import {
  localReadinessOutcomes,
  localReadinessSignals,
} from '../../data/local-readiness';
import { withBasePath } from '../../utils/helpers';

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  compact?: boolean;
}

const {
  id = 'local-readiness-map',
  eyebrow = 'Local readiness map',
  title = 'Local coverage should show the route, not just the radius.',
  description = 'Chicago-area support gets clearer when locations, hours, access, recovery, vendors, and review cadence are mapped before the service plan is treated as final.',
  ctaHref = withBasePath('contact-hq/'),
  ctaLabel = 'Start local intake',
  compact = false,
} = Astro.props as Props;
---

<section
  id={id}
  class:list={['local-readiness', compact && 'local-readiness--compact']}
  data-local-readiness
  data-page-section
>
  <div class="local-readiness__shell">
    <div class="local-readiness__header">
      <div>
        <p class="local-readiness__eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
      <div class="local-readiness__intro">
        <p>{description}</p>
        <ModernButton href={ctaHref} variant="primary" rounded="sm">
          {ctaLabel}
        </ModernButton>
      </div>
    </div>

    <div class="local-readiness__grid">
      <div
        class="local-readiness__map"
        aria-label="Chicago local readiness review routes"
      >
        <div class="local-readiness__map-top">
          <span>Chicago operating grid</span>
          <strong>5 readiness routes</strong>
        </div>

        <div class="local-readiness__routes">
          {
            localReadinessSignals.map((signal, index) => (
              <article class={`local-readiness__route route-${index + 1}`}>
                <div class="local-readiness__route-index">
                  <span>{signal.zone}</span>
                  <strong>{String(index + 1).padStart(2, '0')}</strong>
                </div>
                <div>
                  <p>{signal.label}</p>
                  <h3>{signal.question}</h3>
                  <small>{signal.proof}</small>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <aside class="local-readiness__confidence" aria-label="Readiness output">
        <div class="local-readiness__confidence-top">
          <p>Service confidence panel</p>
          <span>First review</span>
        </div>

        <div class="local-readiness__outcomes">
          {
            localReadinessOutcomes.map(item => (
              <article>
                <p>{item.label}</p>
                <strong>{item.value}</strong>
              </article>
            ))
          }
        </div>

        <div class="local-readiness__first-moves">
          <p>First moves</p>
          <ul>
            {
              localReadinessSignals
                .slice(0, 4)
                .map(signal => <li>{signal.firstMove}</li>)
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .local-readiness {
    position: relative;
    overflow: clip;
    border-block: 1px solid
      color-mix(in srgb, var(--color-border) 72%, transparent);
    background:
      radial-gradient(
        circle at 78% 12%,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 12%,
          transparent
        ),
        transparent 30%
      ),
      color-mix(in srgb, var(--color-background) 94%, transparent);
  }

  .local-readiness__shell {
    width: min(100% - 2rem, 1240px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6.25rem);
  }

  .local-readiness--compact .local-readiness__shell {
    padding-block: clamp(3rem, 5vw, 4.75rem);
  }

  .local-readiness__header {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .local-readiness__eyebrow,
  .local-readiness__map-top span,
  .local-readiness__route-index span,
  .local-readiness__route p,
  .local-readiness__confidence-top,
  .local-readiness__outcomes p,
  .local-readiness__first-moves p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .local-readiness__eyebrow,
  .local-readiness__map-top span,
  .local-readiness__route-index span,
  .local-readiness__route p,
  .local-readiness__confidence-top,
  .local-readiness__outcomes p,
  .local-readiness__first-moves p {
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
  }

  .local-readiness__header h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.3vw, 4.45rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .local-readiness__intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .local-readiness__intro p {
    max-width: 62ch;
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, transparent);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.64;
  }

  .local-readiness__grid,
  .local-readiness__routes,
  .local-readiness__confidence,
  .local-readiness__outcomes,
  .local-readiness__first-moves {
    display: grid;
    gap: 1rem;
  }

  .local-readiness__map,
  .local-readiness__route,
  .local-readiness__confidence,
  .local-readiness__outcomes article,
  .local-readiness__first-moves {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 0.75rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 3%, transparent),
        transparent 34%
      ),
      color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 4%, transparent),
      0 24px 58px -50px rgba(0, 0, 0, 0.72);
  }

  .local-readiness__map {
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .local-readiness__map-top,
  .local-readiness__confidence-top {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 64%, transparent);
    padding-bottom: 1rem;
  }

  .local-readiness__map-top strong,
  .local-readiness__route-index strong,
  .local-readiness__route h3,
  .local-readiness__outcomes strong,
  .local-readiness__first-moves li {
    color: var(--color-text-primary);
  }

  .local-readiness__map-top strong {
    font-size: 0.92rem;
  }

  .local-readiness__routes {
    position: relative;
    margin-top: 1rem;
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-text-primary) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-text-primary) 4%, transparent) 1px,
        transparent 1px
      );
    background-size: 46px 46px;
  }

  .local-readiness__route {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.9rem;
    min-height: 8.2rem;
    padding: 1rem;
  }

  .local-readiness__route:nth-child(2n) {
    transform: translateX(1.5rem);
  }

  .local-readiness__route-index {
    display: grid;
    gap: 0.45rem;
    align-content: start;
  }

  .local-readiness__route-index strong {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 32%,
        transparent
      );
    border-radius: 0.45rem;
    background: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 10%,
      transparent
    );
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .local-readiness__route h3 {
    margin: 0.35rem 0 0;
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: 1.22;
    text-wrap: balance;
  }

  .local-readiness__route small {
    display: block;
    margin-top: 0.55rem;
    color: color-mix(in srgb, var(--color-text-secondary) 88%, transparent);
    line-height: 1.5;
  }

  .local-readiness__confidence {
    align-content: start;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .local-readiness__outcomes article,
  .local-readiness__first-moves {
    gap: 0.55rem;
    padding: 0.9rem;
  }

  .local-readiness__outcomes article {
    display: grid;
  }

  .local-readiness__outcomes strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.05;
  }

  .local-readiness__first-moves ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-readiness__first-moves li {
    display: flex;
    gap: 0.55rem;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .local-readiness__first-moves li::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    margin-top: 0.5rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 76%,
      white 10%
    );
  }

  @media (min-width: 860px) {
    .local-readiness__header {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.62fr);
      align-items: end;
    }

    .local-readiness__grid {
      grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.38fr);
      align-items: start;
    }
  }

  @media (max-width: 767px) {
    .local-readiness__shell {
      width: min(100% - 1.25rem, 1240px);
    }

    .local-readiness__header h2 {
      max-width: 100%;
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .local-readiness__route {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .local-readiness__route:nth-child(2n) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .local-readiness__route {
      transform: none !important;
    }
  }
</style>
