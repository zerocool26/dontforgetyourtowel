---
import ModernButton from '../ui/ModernButton.astro';
import {
  providerSelectionOutcomes,
  providerSelectionSignals,
} from '../../data/provider-selection-standard';
import { withBasePath } from '../../utils/helpers';

export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  ctaHref?: string;
  ctaLabel?: string;
  compact?: boolean;
  showCta?: boolean;
}

const {
  id,
  eyebrow = 'MSP selection standard',
  title = 'The best provider is the one that can answer the hard questions early.',
  description = 'A serious first review should make ownership, recovery, access, Microsoft 365, recurring issues, and scope boundaries visible before anyone signs a long agreement.',
  ctaHref = withBasePath('contact-hq/'),
  ctaLabel = 'Start fit check',
  compact = false,
  showCta = true,
} = Astro.props as Props;
---

<section
  id={id}
  class:list={['provider-standard', compact && 'provider-standard--compact']}
  data-provider-standard
  data-page-section
>
  <div class="provider-standard__shell">
    <div class="provider-standard__header">
      <div>
        <p class="provider-standard__eyebrow">{eyebrow}</p>
        <h2>{title}</h2>
      </div>
      <div class="provider-standard__intro">
        <p>{description}</p>
        {
          showCta ? (
            <ModernButton href={ctaHref} variant="primary" rounded="sm">
              {ctaLabel}
            </ModernButton>
          ) : null
        }
      </div>
    </div>

    <div class="provider-standard__grid">
      <div class="provider-standard__console">
        <div class="provider-standard__console-top">
          <span>Selection console</span>
          <strong>6 proof checks</strong>
        </div>

        <div class="provider-standard__rows">
          {
            providerSelectionSignals.map((item, index) => (
              <article class="provider-standard__row">
                <span class="provider-standard__index">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <p>{item.label}</p>
                  <strong>{item.question}</strong>
                </div>
                <small>{item.proof}</small>
              </article>
            ))
          }
        </div>
      </div>

      <div class="provider-standard__outcomes" aria-label="Buyer outcomes">
        {
          providerSelectionOutcomes.map(item => (
            <article class="provider-standard__outcome">
              <p>{item.label}</p>
              <strong>{item.value}</strong>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .provider-standard {
    position: relative;
    overflow: clip;
    scroll-margin-top: 5.5rem;
    border-block: 1px solid
      color-mix(in srgb, var(--color-border) 74%, transparent);
    background:
      radial-gradient(
        circle at 85% 8%,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 13%,
          transparent
        ),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 94%, transparent),
        color-mix(in srgb, var(--color-background) 96%, transparent)
      );
  }

  .provider-standard::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        color-mix(in srgb, var(--color-text-primary) 4%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-text-primary) 3%, transparent) 1px,
        transparent 1px
      );
    background-size: 56px 56px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.5), transparent 72%);
  }

  .provider-standard__shell {
    position: relative;
    width: min(100% - 2rem, 1240px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6.25rem);
  }

  .provider-standard--compact .provider-standard__shell {
    padding-block: clamp(3rem, 5vw, 4.75rem);
  }

  .provider-standard__header {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.6rem);
  }

  .provider-standard__eyebrow,
  .provider-standard__console-top span,
  .provider-standard__row p,
  .provider-standard__outcome p,
  .provider-standard__index {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .provider-standard__eyebrow,
  .provider-standard__row p,
  .provider-standard__outcome p,
  .provider-standard__index,
  .provider-standard__console-top span {
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
  }

  .provider-standard__header h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.3vw, 4.55rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .provider-standard__intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .provider-standard__intro p {
    max-width: 57ch;
    margin: 0;
    color: color-mix(in srgb, var(--color-text-secondary) 94%, transparent);
    font-size: clamp(0.98rem, 1.18vw, 1.1rem);
    line-height: 1.64;
  }

  .provider-standard__grid {
    display: grid;
    gap: 1rem;
  }

  .provider-standard__console,
  .provider-standard__outcome {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: 0.75rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 3%, transparent),
        transparent 42%
      ),
      color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 5%, transparent),
      0 24px 60px -52px rgba(0, 0, 0, 0.72);
  }

  .provider-standard__console {
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .provider-standard__console-top {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 64%, transparent);
    padding-bottom: 1rem;
  }

  .provider-standard__console-top strong {
    color: var(--color-text-primary);
    font-size: 0.92rem;
    font-weight: 760;
  }

  .provider-standard__rows {
    display: grid;
    gap: 0.72rem;
    padding-top: 1rem;
  }

  .provider-standard__row {
    display: grid;
    gap: 0.75rem;
    min-height: 6.4rem;
    align-items: start;
    border: 1px solid color-mix(in srgb, var(--color-border) 58%, transparent);
    border-radius: 0.65rem;
    background:
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 8%,
          transparent
        ),
        transparent 36%
      ),
      color-mix(in srgb, black 10%, transparent);
    padding: 0.95rem;
  }

  .provider-standard__index {
    color: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 72%,
      white 10%
    );
  }

  .provider-standard__row strong,
  .provider-standard__outcome strong {
    display: block;
    color: var(--color-text-primary);
    font-weight: 760;
    letter-spacing: 0;
  }

  .provider-standard__row strong {
    margin-top: 0.35rem;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.22;
  }

  .provider-standard__row small {
    color: color-mix(in srgb, var(--color-text-secondary) 88%, transparent);
    font-size: 0.86rem;
    line-height: 1.48;
  }

  .provider-standard__outcomes {
    display: grid;
    gap: 0.75rem;
  }

  .provider-standard__outcome {
    min-height: 8rem;
    display: grid;
    align-content: end;
    gap: 0.55rem;
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .provider-standard__outcome::before {
    content: '';
    width: 2.4rem;
    height: 0.22rem;
    border-radius: 999px;
    background: color-mix(
      in srgb,
      var(--route-accent, var(--color-primary)) 76%,
      white 8%
    );
  }

  .provider-standard__outcome strong {
    max-width: 13ch;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  @media (min-width: 760px) {
    .provider-standard__row {
      grid-template-columns: 3.25rem minmax(0, 1.05fr) minmax(14rem, 0.95fr);
    }

    .provider-standard__outcomes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1060px) {
    .provider-standard__header {
      grid-template-columns: minmax(0, 0.96fr) minmax(20rem, 0.7fr);
      align-items: end;
    }

    .provider-standard__grid {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.34fr);
      align-items: stretch;
    }

    .provider-standard__outcomes {
      grid-template-columns: 1fr;
    }

    .provider-standard__outcome {
      min-height: 0;
    }
  }

  @media (max-width: 767px) {
    .provider-standard__shell {
      width: min(100% - 1.25rem, 1240px);
    }

    .provider-standard__header h2 {
      max-width: 100%;
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .provider-standard__row {
      min-height: 0;
    }
  }
</style>
