---
import { getRouteContext } from '../../utils/route-context';

const routeContext = getRouteContext(Astro.url.pathname);
---

<div
  class="route-atmosphere"
  style={`--route-atmosphere-accent:${routeContext.accent};`}
  aria-hidden="true"
>
  <div class="route-atmosphere__wash"></div>
</div>

<style>
  .route-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: clip;
    isolation: isolate;
    contain: layout style;
  }

  .route-atmosphere__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        42rem circle at 14% 8%,
        color-mix(in srgb, var(--route-atmosphere-accent) 4%, transparent),
        transparent 52%
      ),
      radial-gradient(
        32rem circle at 88% 16%,
        color-mix(in srgb, var(--route-atmosphere-accent) 2.5%, transparent),
        transparent 48%
      );
    opacity: 0.5;
  }

  :global(html[data-experience-mode='blueprint']) .route-atmosphere__wash {
    background:
      radial-gradient(
        42rem circle at 12% 12%,
        color-mix(in srgb, var(--route-atmosphere-accent) 6%, transparent),
        transparent 50%
      ),
      radial-gradient(
        36rem circle at 88% 18%,
        color-mix(in srgb, #7dd3fc 5%, transparent),
        transparent 48%
      );
    opacity: 0.4;
  }
</style>
