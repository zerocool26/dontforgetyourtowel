---
import { getRouteContext } from '../../utils/route-context';

const routeContext = getRouteContext(Astro.url.pathname);
---

<div
  class="route-atmosphere"
  style={`--route-atmosphere-accent:${routeContext.accent};`}
  aria-hidden="true"
>
  <div class="route-atmosphere__wash"></div>
  <div class="route-atmosphere__map" aria-hidden="true"></div>
  <div class="route-atmosphere__ledger" aria-hidden="true"></div>
</div>

<style>
  .route-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: clip;
    isolation: isolate;
    contain: layout style;
  }

  .route-atmosphere__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--route-atmosphere-accent) 5%, transparent),
      transparent 32%,
      color-mix(in srgb, var(--color-primary-strong) 3%, transparent) 68%,
      transparent
    );
    opacity: 0.7;
  }

  .route-atmosphere__map,
  .route-atmosphere__ledger {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .route-atmosphere__map {
    opacity: 0.105;
    background-image:
      linear-gradient(
        28deg,
        transparent 0 18%,
        color-mix(in srgb, var(--route-atmosphere-accent) 46%, transparent)
          18.2%,
        transparent 18.7% 44%,
        color-mix(in srgb, white 24%, transparent) 44.2%,
        transparent 44.6% 100%
      ),
      linear-gradient(
        142deg,
        transparent 0 34%,
        color-mix(in srgb, var(--color-border) 72%, transparent) 34.2%,
        transparent 34.6% 58%,
        color-mix(in srgb, var(--route-atmosphere-accent) 32%, transparent)
          58.2%,
        transparent 58.6% 100%
      );
    background-position:
      left -8rem top 4rem,
      right -10rem top 11rem;
    background-size:
      min(56rem, 72vw) min(38rem, 48vw),
      min(62rem, 74vw) min(42rem, 52vw);
    background-repeat: no-repeat;
    mask-image: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.72),
      rgba(0, 0, 0, 0.24) 48%,
      transparent 88%
    );
  }

  .route-atmosphere__ledger {
    opacity: 0.028;
    background-image:
      linear-gradient(
        90deg,
        color-mix(in srgb, white 48%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, white 38%, transparent) 1px,
        transparent 1px
      );
    background-size: 7.5rem 7.5rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent 72%);
  }

  :global(html[data-experience-mode='blueprint']) .route-atmosphere__wash {
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--route-atmosphere-accent) 7%, transparent),
      transparent 36%,
      color-mix(in srgb, #7dd3fc 5%, transparent) 72%,
      transparent
    );
    opacity: 0.4;
  }
</style>
