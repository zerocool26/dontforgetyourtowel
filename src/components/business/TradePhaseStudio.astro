---
interface TradePhaseStudioPhase {
  title: string;
  items: string[];
  summary?: string;
  badge?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?: string;
  phases: TradePhaseStudioPhase[];
}

const {
  eyebrow,
  title,
  description,
  accent = '#ccff00',
  phases = [],
} = Astro.props as Props;

const normalizedPhases = phases
  .filter(phase => phase.title && phase.items?.length)
  .map((phase, index) => ({
    ...phase,
    key:
      phase.title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '') || `phase-${index + 1}`,
    summary:
      phase.summary ??
      `${phase.items.length} ${phase.items.length === 1 ? 'checkpoint' : 'checkpoints'} in this lane.`,
    badge:
      phase.badge ??
      `${(index + 1).toString().padStart(2, '0')} / ${phases.length
        .toString()
        .padStart(2, '0')}`,
  }));

const initialPhase = normalizedPhases[0];
---

{
  normalizedPhases.length ? (
    <section
      class="trade-phase-studio creative-panel rounded-[2rem] p-6 md:p-7"
      style={`--trade-phase-accent:${accent};`}
      data-phase-studio
    >
      <div class="trade-phase-studio__header">
        <div class="space-y-3">
          <p class="creative-kicker">{eyebrow}</p>
          <h2 class="tone-title text-3xl font-semibold tracking-tight md:text-[2rem]">
            {title}
          </h2>
          <p class="tone-body max-w-3xl text-sm leading-relaxed md:text-[0.95rem]">
            {description}
          </p>
        </div>

        <div class="trade-phase-studio__status-shell">
          <p class="trade-phase-studio__status-label">Focused lane</p>
          <p
            class="trade-phase-studio__status-title"
            data-phase-studio-status-title
          >
            {initialPhase?.title}
          </p>
          <p
            class="trade-phase-studio__status-copy"
            data-phase-studio-status-copy
          >
            {initialPhase?.summary}
          </p>
        </div>
      </div>

      <div
        class="trade-phase-studio__rail scrollbar-hide"
        role="tablist"
        aria-label={`${title} phases`}
      >
        {normalizedPhases.map((phase, index) => (
          <button
            type="button"
            class={`trade-phase-studio__tab ${index === 0 ? 'is-active' : ''}`}
            data-phase-studio-tab
            data-phase-key={phase.key}
            data-phase-title={phase.title}
            data-phase-summary={phase.summary}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="trade-phase-studio__tab-badge">{phase.badge}</span>
            <span class="trade-phase-studio__tab-title">{phase.title}</span>
            <span class="trade-phase-studio__tab-meta">
              {phase.items.length} {phase.items.length === 1 ? 'item' : 'items'}
            </span>
          </button>
        ))}
      </div>

      <div class="trade-phase-studio__grid">
        {normalizedPhases.map((phase, index) => (
          <article
            class={`trade-phase-studio__card ${index === 0 ? 'is-active' : ''}`}
            data-phase-studio-card
            data-phase-key={phase.key}
            data-state={index === 0 ? 'active' : 'idle'}
          >
            <div class="trade-phase-studio__card-head">
              <span class="trade-phase-studio__card-index">{phase.badge}</span>
              <div class="min-w-0">
                <h3 class="tone-title text-lg font-semibold">{phase.title}</h3>
                <p class="tone-body mt-2 text-sm leading-relaxed">
                  {phase.summary}
                </p>
              </div>
            </div>

            <ul class="trade-phase-studio__list tone-body">
              {phase.items.map(item => (
                <li class="trade-phase-studio__item">
                  <span class="trade-phase-studio__dot" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  ) : null
}

<script is:inline>
  (() => {
    const initTradePhaseStudios = () => {
      const roots = Array.from(
        document.querySelectorAll('[data-phase-studio]')
      ).filter(node => node instanceof HTMLElement);

      roots.forEach(root => {
        if (root.dataset.phaseStudioBound === 'true') {
          return;
        }

        root.dataset.phaseStudioBound = 'true';

        const tabs = Array.from(
          root.querySelectorAll('[data-phase-studio-tab]')
        ).filter(node => node instanceof HTMLButtonElement);
        const cards = Array.from(
          root.querySelectorAll('[data-phase-studio-card]')
        ).filter(node => node instanceof HTMLElement);
        const statusTitle = root.querySelector(
          '[data-phase-studio-status-title]'
        );
        const statusCopy = root.querySelector(
          '[data-phase-studio-status-copy]'
        );

        if (!tabs.length || !cards.length) return;

        const setActive = key => {
          tabs.forEach(tab => {
            const isActive = tab.dataset.phaseKey === key;
            tab.classList.toggle('is-active', isActive);
            tab.setAttribute('aria-pressed', String(isActive));

            if (isActive) {
              if (statusTitle) {
                statusTitle.textContent = tab.dataset.phaseTitle || '';
              }
              if (statusCopy) {
                statusCopy.textContent = tab.dataset.phaseSummary || '';
              }
            }
          });

          cards.forEach(card => {
            const isActive = card.dataset.phaseKey === key;
            card.classList.toggle('is-active', isActive);
            card.dataset.state = isActive ? 'active' : 'idle';
          });
        };

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const key = tab.dataset.phaseKey;
            if (!key) return;
            setActive(key);
          });
        });

        setActive(tabs[0]?.dataset.phaseKey || '');
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTradePhaseStudios, {
        once: true,
      });
    } else {
      initTradePhaseStudios();
    }

    document.addEventListener('astro:page-load', initTradePhaseStudios);
  })();
</script>

<style is:inline>
  .trade-phase-studio {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(
        in srgb,
        var(--trade-phase-accent) 24%,
        rgba(255, 255, 255, 0.08)
      );
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--trade-phase-accent) 10%, rgba(5, 10, 18, 0.96)),
      rgba(6, 8, 14, 0.94) 45%,
      rgba(3, 4, 8, 0.98)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 28px 80px rgba(0, 0, 0, 0.32);
  }

  .trade-phase-studio::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 12% 18%,
        color-mix(in srgb, var(--trade-phase-accent) 24%, transparent),
        transparent 28%
      ),
      linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.04),
        transparent
      );
    opacity: 0.85;
  }

  .trade-phase-studio__header,
  .trade-phase-studio__rail,
  .trade-phase-studio__grid {
    position: relative;
    z-index: 1;
  }

  .trade-phase-studio__header {
    display: grid;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1.25rem;
  }

  .trade-phase-studio__status-shell {
    border-radius: 1.4rem;
    border: 1px solid
      color-mix(
        in srgb,
        var(--trade-phase-accent) 20%,
        rgba(255, 255, 255, 0.08)
      );
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.05rem;
    backdrop-filter: blur(18px);
  }

  .trade-phase-studio__status-label,
  .trade-phase-studio__tab-meta,
  .trade-phase-studio__card-index {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
  }

  .trade-phase-studio__status-title {
    margin-top: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.96);
  }

  .trade-phase-studio__status-copy {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
  }

  .trade-phase-studio__rail {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    margin-bottom: 1.25rem;
  }

  .trade-phase-studio__tab {
    min-width: 12rem;
    flex: 0 0 auto;
    border-radius: 1.3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.95rem 1rem 1rem;
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .trade-phase-studio__tab:hover,
  .trade-phase-studio__tab:focus-visible,
  .trade-phase-studio__tab.is-active {
    outline: none;
    transform: translateY(-1px);
    border-color: color-mix(
      in srgb,
      var(--trade-phase-accent) 36%,
      rgba(255, 255, 255, 0.14)
    );
    background: color-mix(
      in srgb,
      var(--trade-phase-accent) 10%,
      rgba(255, 255, 255, 0.05)
    );
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .trade-phase-studio__tab-badge {
    display: inline-flex;
    margin-bottom: 0.55rem;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(
      in srgb,
      var(--trade-phase-accent) 58%,
      rgba(255, 255, 255, 0.78)
    );
  }

  .trade-phase-studio__tab-title {
    display: block;
    font-size: 0.98rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
  }

  .trade-phase-studio__tab-meta {
    display: block;
    margin-top: 0.45rem;
  }

  .trade-phase-studio__grid {
    display: grid;
    gap: 1rem;
  }

  .trade-phase-studio__card {
    position: relative;
    border-radius: 1.55rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.028);
    padding: 1.05rem;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease,
      opacity 200ms ease;
  }

  .trade-phase-studio__card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--trade-phase-accent) 12%, transparent),
      transparent 46%
    );
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .trade-phase-studio__card[data-state='idle'] {
    opacity: 0.7;
  }

  .trade-phase-studio__card.is-active {
    transform: translateY(-2px);
    border-color: color-mix(
      in srgb,
      var(--trade-phase-accent) 34%,
      rgba(255, 255, 255, 0.14)
    );
    background: color-mix(
      in srgb,
      var(--trade-phase-accent) 8%,
      rgba(255, 255, 255, 0.04)
    );
    opacity: 1;
  }

  .trade-phase-studio__card.is-active::before {
    opacity: 1;
  }

  .trade-phase-studio__card-head {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .trade-phase-studio__card-index {
    min-width: 4.2rem;
    padding-top: 0.1rem;
  }

  .trade-phase-studio__list {
    margin-top: 1rem;
    display: grid;
    gap: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .trade-phase-studio__item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .trade-phase-studio__dot {
    width: 0.55rem;
    height: 0.55rem;
    flex-shrink: 0;
    border-radius: 999px;
    margin-top: 0.45rem;
    background: var(--trade-phase-accent);
    box-shadow: 0 0 0 5px
      color-mix(in srgb, var(--trade-phase-accent) 14%, transparent);
  }

  @media (min-width: 900px) {
    .trade-phase-studio__header {
      grid-template-columns: 1.08fr 0.92fr;
    }

    .trade-phase-studio__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .trade-phase-studio__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 699px) {
    .trade-phase-studio {
      padding-inline: 1rem;
    }

    .trade-phase-studio__tab {
      min-width: 10.75rem;
    }

    .trade-phase-studio__card-head {
      flex-direction: column;
      gap: 0.55rem;
    }
  }
</style>
