---
export type RouteProofItem = {
  label: string;
  title: string;
  copy: string;
  status?: 'verified' | 'review' | 'planned';
  href?: string;
};

interface Props {
  label: string;
  title: string;
  note?: string;
  items: RouteProofItem[];
  ctaHref?: string;
  ctaLabel?: string;
  className?: string;
}

const {
  label,
  title,
  note,
  items,
  ctaHref,
  ctaLabel = 'Start fit check',
  className = '',
} = Astro.props;
---

<section class={`route-proof-strip ${className}`} aria-label={title}>
  <div class="route-proof-strip__inner">
    <div class="route-proof-strip__receipt">
      <div class="route-proof-strip__intro">
        <p>{label}</p>
        <strong>{title}</strong>
        {note ? <span>{note}</span> : null}
      </div>

      <div class="route-proof-strip__items">
        {
          items.map(item =>
            item.href ? (
              <a
                class="route-proof-strip__item tone-focus-accent"
                href={item.href}
                data-status={item.status ?? 'planned'}
                aria-label={`${item.label}: ${item.title}. ${item.copy}`}
              >
                <span class="route-proof-strip__mark" aria-hidden="true" />
                <span>
                  <em>{item.label}</em>
                  <strong>{item.title}</strong>
                  <small>{item.copy}</small>
                </span>
              </a>
            ) : (
              <div
                class="route-proof-strip__item"
                data-status={item.status ?? 'planned'}
              >
                <span class="route-proof-strip__mark" aria-hidden="true" />
                <span>
                  <em>{item.label}</em>
                  <strong>{item.title}</strong>
                  <small>{item.copy}</small>
                </span>
              </div>
            )
          )
        }
      </div>

      {
        ctaHref ? (
          <a class="route-proof-strip__cta tone-focus-accent" href={ctaHref}>
            <span>{ctaLabel}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h13m-5-5 5 5-5 5" />
            </svg>
          </a>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .route-proof-strip {
    border-block: 1px solid
      color-mix(in srgb, var(--color-border) 78%, transparent);
    background:
      linear-gradient(
        90deg,
        transparent,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 8%,
          transparent
        ),
        transparent
      ),
      color-mix(in srgb, var(--color-surface) 86%, black 14%);
  }

  .route-proof-strip__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(1rem, 2vw, 1.35rem) 1rem;
  }

  .route-proof-strip__receipt {
    display: grid;
    grid-template-columns: minmax(13rem, 0.34fr) minmax(0, 1fr) auto;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    border-radius: 8px;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 3.1rem,
        color-mix(in srgb, var(--color-ink) 9%, transparent) 3.1rem
          calc(3.1rem + 1px)
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, white 66%, var(--color-paper) 34%),
        var(--color-paper)
      );
    color: var(--color-ink);
    box-shadow:
      0 24px 54px -44px rgba(0, 0, 0, 0.66),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .route-proof-strip__intro,
  .route-proof-strip__item,
  .route-proof-strip__cta {
    min-width: 0;
    border-left: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    padding: clamp(0.9rem, 1.7vw, 1.15rem);
  }

  .route-proof-strip__intro {
    display: grid;
    gap: 0.4rem;
    border-left: 0;
  }

  .route-proof-strip__intro p,
  .route-proof-strip__item em {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .route-proof-strip__intro p,
  .route-proof-strip__item em {
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
  }

  .route-proof-strip__intro strong {
    max-width: 16ch;
    color: var(--color-ink);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 820;
    line-height: 1.12;
  }

  .route-proof-strip__intro span {
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .route-proof-strip__items {
    display: grid;
    grid-template-columns: repeat(var(--route-proof-count, 3), minmax(0, 1fr));
  }

  .route-proof-strip__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .route-proof-strip__item:hover {
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }

  .route-proof-strip__mark {
    width: 0.85rem;
    height: 0.85rem;
    margin-top: 0.12rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    color: color-mix(in srgb, var(--color-text-muted) 80%, transparent);
  }

  .route-proof-strip__item[data-status='verified'] .route-proof-strip__mark {
    color: var(--color-status-verified);
    background: color-mix(
      in srgb,
      var(--color-status-verified) 18%,
      transparent
    );
  }

  .route-proof-strip__item[data-status='review'] .route-proof-strip__mark {
    color: var(--color-status-review);
    background: color-mix(in srgb, var(--color-status-review) 16%, transparent);
  }

  .route-proof-strip__item[data-status='planned'] .route-proof-strip__mark {
    color: var(--color-status-planned);
    background: color-mix(
      in srgb,
      var(--color-status-planned) 14%,
      transparent
    );
  }

  .route-proof-strip__item span:last-child {
    display: grid;
    gap: 0.22rem;
  }

  .route-proof-strip__item strong {
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 820;
    line-height: 1.2;
  }

  .route-proof-strip__item small {
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    font-size: 0.75rem;
    line-height: 1.42;
  }

  .route-proof-strip__cta {
    display: inline-flex;
    min-height: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-primary) 72%, black 12%),
        color-mix(
          in srgb,
          var(--color-primary-strong) 50%,
          var(--color-ink) 50%
        )
      ),
      var(--color-primary);
    color: var(--color-text-inverse);
    font-size: 0.86rem;
    font-weight: 840;
    text-decoration: none;
    white-space: nowrap;
  }

  .route-proof-strip__cta:hover {
    color: var(--color-text-inverse);
    filter: saturate(1.05);
  }

  .route-proof-strip__cta svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.8;
  }

  @media (max-width: 1020px) {
    .route-proof-strip__receipt {
      grid-template-columns: 1fr;
    }

    .route-proof-strip__intro,
    .route-proof-strip__item,
    .route-proof-strip__cta {
      border-top: 1px solid
        color-mix(in srgb, var(--color-ink) 14%, transparent);
      border-left: 0;
    }

    .route-proof-strip__intro {
      border-top: 0;
    }

    .route-proof-strip__items {
      grid-template-columns: 1fr;
    }

    .route-proof-strip__item {
      border-left: 0;
    }

    .route-proof-strip__cta {
      min-height: 52px;
    }
  }
</style>
