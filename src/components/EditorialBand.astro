---
interface Item {
  number: string;
  title: string;
  copy?: string;
}

interface Props {
  title: string;
  accent?: string;
  copy?: string;
  items: Item[];
  tone?: 'white' | 'soft' | 'ink';
}

const { title, accent, copy, items, tone = 'soft' } = Astro.props as Props;
---

<section class:list={['editorial-band', `editorial-band--${tone}`]}>
  <div class="shell editorial-band__inner">
    <header>
      <h2>
        <span>{title}</span>
        {accent && <em>{accent}</em>}
      </h2>
      {copy && <p>{copy}</p>}
    </header>
    <ol>
      {
        items.map(item => (
          <li>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            {item.copy && <p>{item.copy}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
