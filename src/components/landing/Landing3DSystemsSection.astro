---
import ModernButton from '../ui/ModernButton.astro';
import ModernCard from '../ui/ModernCard.astro';
import { withBasePath } from '../../utils/helpers';

const chapters = [
  {
    id: 'genesis',
    label: 'Genesis',
    kicker: 'Creative Technology Studio',
    accent: '#ccff00',
    index: '01',
  },
  {
    id: 'neural',
    label: 'Neural',
    kicker: 'AI Orchestration',
    accent: '#00d4ff',
    index: '02',
  },
  {
    id: 'vault',
    label: 'Vault',
    kicker: 'Digital Resilience',
    accent: '#a78bfa',
    index: '03',
  },
  {
    id: 'cloud',
    label: 'Cloud',
    kicker: 'Infrastructure at Scale',
    accent: '#38bdf8',
    index: '04',
  },
  {
    id: 'ops',
    label: 'Signal',
    kicker: 'Operational Intelligence',
    accent: '#4ade80',
    index: '05',
  },
  {
    id: 'ascent',
    label: 'Ascent',
    kicker: 'Singularity Core',
    accent: '#ccff00',
    index: '06',
  },
];

const systemSpecs = [
  { label: 'Render engine', value: 'React Three Fiber / WebGL2' },
  {
    label: 'Post-processing',
    value: 'Bloom · Chromatic aberration · Vignette · Film grain',
  },
  { label: 'Particle systems', value: '16k particles · custom GLSL morphing' },
  {
    label: 'Camera system',
    value: 'Catmull-Rom spline · 6-chapter cinematic path',
  },
  { label: 'Performance', value: 'Adaptive quality tiers · FPS-aware budget' },
  {
    label: 'Interaction',
    value: 'Pointer field physics · touch momentum tracking',
  },
];
---

<section
  class="mx-auto max-w-6xl px-6 py-14 sm:px-10 sm:py-20"
  data-reveal
  aria-labelledby="landing-3d-systems-title"
>
  <div
    class="creative-section-shell creative-grid-backdrop creative-section-shell--spotlit p-6 sm:p-8 lg:p-10"
  >
    <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
      <div class="space-y-5">
        <span class="creative-kicker">3D systems architecture</span>
        <h2
          id="landing-3d-systems-title"
          class="creative-title tone-title text-3xl font-semibold sm:text-4xl"
        >
          Six cinematic chapters. One continuous scroll-driven experience.
        </h2>
        <p class="creative-copy text-sm sm:text-base">
          The immersive system runs 6 distinct 3D chapters across a 700vh scroll
          container — each with custom GLSL shaders, atmospheric lighting, and
          pointer-reactive physics. No canvas reloads. No chapter cold-starts.
        </p>

        <div class="grid gap-3">
          {
            systemSpecs.map(spec => (
              <div class="creative-spectrum-card">
                <div class="shrink-0">
                  <p class="creative-spectrum-card__label">{spec.label}</p>
                </div>
                <p class="creative-spectrum-card__detail">{spec.value}</p>
              </div>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-3">
          <ModernButton
            href={withBasePath('services/')}
            variant="primary"
            className="min-h-[48px]"
          >
            Explore 3D-backed services
          </ModernButton>
          <ModernButton
            href={withBasePath('debug-webgl/')}
            variant="secondary"
            className="min-h-[48px]"
          >
            Open 3D diagnostics
          </ModernButton>
        </div>
      </div>

      <div class="grid gap-4">
        <!-- Chapter scene grid -->
        <div class="scene-chapter-grid">
          {
            chapters.map(chapter => (
              <a
                href={withBasePath(`/?chapter=${chapter.id}#hero`)}
                class="scene-chapter-card"
                style={`--chapter-accent: ${chapter.accent};`}
                aria-label={`Jump to ${chapter.kicker} chapter`}
              >
                <div class="scene-chapter-glow" aria-hidden="true" />
                <div class="scene-chapter-content">
                  <span class="scene-chapter-index">{chapter.index}</span>
                  <span class="scene-chapter-name">{chapter.label}</span>
                  <span class="scene-chapter-kicker">{chapter.kicker}</span>
                </div>
                <div class="scene-chapter-accent-bar" aria-hidden="true" />
              </a>
            ))
          }
        </div>

        <!-- Spec cards -->
        <div class="grid gap-4 sm:grid-cols-3">
          <ModernCard variant="minimal" className="creative-panel p-5">
            <div class="creative-panel-index">A</div>
            <p class="tone-title mt-3 text-sm font-semibold">
              Scroll-driven chapters
            </p>
            <p class="tone-body mt-2 text-sm">
              Each chapter occupies a range of the 700vh scroll space and
              transitions without resetting canvas state.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <div class="creative-panel-index">B</div>
            <p class="tone-title mt-3 text-sm font-semibold">
              Background scene priming
            </p>
            <p class="tone-body mt-2 text-sm">
              Chapters warm in the background while you explore the current one,
              so jumps feel instant rather than cold.
            </p>
          </ModernCard>
          <ModernCard variant="minimal" className="creative-panel p-5">
            <div class="creative-panel-index">C</div>
            <p class="tone-title mt-3 text-sm font-semibold">
              Single control panel
            </p>
            <p class="tone-body mt-2 text-sm">
              One unified tabbed panel handles scene navigation, camera lens,
              render quality, and guided tour in a single compact surface.
            </p>
          </ModernCard>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scene-chapter-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  @media (max-width: 480px) {
    .scene-chapter-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .scene-chapter-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 1 / 0.95;
    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.2s ease;
  }

  .scene-chapter-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: color-mix(in srgb, var(--chapter-accent) 50%, transparent);
    transform: translateY(-2px);
  }

  .scene-chapter-glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--chapter-accent) 18%, transparent) 0%,
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .scene-chapter-card:hover .scene-chapter-glow {
    opacity: 1;
  }

  .scene-chapter-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .scene-chapter-index {
    font-size: 10px;
    font-weight: 700;
    color: var(--chapter-accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  .scene-chapter-name {
    font-size: 13px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.2;
  }

  .scene-chapter-kicker {
    font-size: 10px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.38);
    line-height: 1.3;
  }

  .scene-chapter-accent-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--chapter-accent);
    opacity: 0.35;
    transition: opacity 0.25s ease;
  }

  .scene-chapter-card:hover .scene-chapter-accent-bar {
    opacity: 0.7;
  }
</style>
