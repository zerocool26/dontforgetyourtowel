---
import { insightReports } from '../../data/marketing';
import { withBasePath } from '../../utils/helpers';

const sectionId = 'insight-section';

const insightSignals = [
  {
    label: 'Planning speed',
    value: 'Compressed',
  },
  {
    label: 'Team clarity',
    value: 'Shared',
  },
  {
    label: 'Operational posture',
    value: 'Calmer',
  },
];
---

<section class="relative" aria-labelledby={`${sectionId}-title`}>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_85%_10%,rgba(204,255,0,0.08),transparent_28%),linear-gradient(180deg,rgba(3,8,18,0.92),rgba(2,5,12,0.88))]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-[1220px] px-6 py-24">
    <div
      class="creative-section-shell creative-grid-backdrop p-6 sm:p-8 lg:p-10"
    >
      <div
        class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-end"
      >
        <header class="max-w-3xl space-y-4">
          <p class="creative-kicker" aria-hidden="true">Ops intelligence</p>
          <h2
            id={`${sectionId}-title`}
            class="creative-title text-3xl font-semibold text-white sm:text-4xl"
          >
            Toolkits that accelerate planning, audits, and recovery
          </h2>
          <p class="creative-copy text-sm">
            Focused resources that help leadership, operations, and product
            teams move from vague intent to a crisp operating plan.
          </p>
        </header>

        <div
          class="creative-signal-band"
          role="list"
          aria-label="Operational intelligence signals"
        >
          {
            insightSignals.map(signal => (
              <div class="creative-signal-band__item" role="listitem">
                <p class="creative-signal-band__label">{signal.label}</p>
                <p class="creative-signal-band__value">{signal.value}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3"
        role="list"
        aria-label="Intelligence reports and toolkits"
      >
        {
          insightReports.map((report, index) => (
            <article
              class="creative-panel flex h-full flex-col justify-between gap-5 p-6 transition-all duration-300 focus-within:ring-2 focus-within:ring-indigo-500/50"
              role="listitem"
              aria-labelledby={`report-${index}-title`}
            >
              <div class="creative-panel-index">0{index + 1}</div>
              <div class="space-y-4">
                <span
                  class="creative-pill"
                  aria-label={`Category: ${report.category}`}
                >
                  {report.category}
                </span>
                <h3
                  id={`report-${index}-title`}
                  class="text-xl font-semibold text-white"
                >
                  {report.title}
                </h3>
                <p class="text-sm text-slate-300">{report.description}</p>
              </div>
              <a
                class="creative-inline-link inline-flex w-max items-center gap-2 rounded-sm text-sm font-semibold text-slate-200 transition hover:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900"
                href={withBasePath(report.href)}
                aria-describedby={`report-${index}-title`}
              >
                {report.linkLabel}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="creative-section-footer mt-10">
        <p class="creative-section-footer__copy">
          Short resources. Strong leverage. Enough operational signal to move a
          conversation forward without shipping a twelve-tab PDF into the void.
        </p>
        <div class="creative-link-cluster">
          <a class="creative-chip" href={withBasePath('services/')}
            >Preview service architecture</a
          >
          <a class="creative-chip" href={withBasePath('about/')}
            >See portfolio proof</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
