---
import { keyMetrics } from '../../data/marketing';
import ModernCard from '../ui/ModernCard.astro';

const sectionId = 'signal-grid';

const signalBand = [
  {
    label: 'Readability',
    value: 'Fast scan',
  },
  {
    label: 'Trust',
    value: 'High-credibility',
  },
  {
    label: 'Energy',
    value: 'Premium motion',
  },
];

const signalDescriptors = [
  {
    title: 'Premium pacing',
    copy: 'Information lands in deliberate beats so visitors feel guided, not flooded.',
  },
  {
    title: 'Trust surfaces',
    copy: 'Signals, proof, and motion work together to make the system feel serious and alive.',
  },
];
---

<div
  class="creative-section-shell creative-grid-backdrop p-8 shadow-lg lg:p-10"
  role="region"
  aria-labelledby={`${sectionId}-title`}
>
  <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
    <div class="space-y-5">
      <div
        class="creative-signal-band"
        role="list"
        aria-label="Confidence signal summary"
      >
        {
          signalBand.map(item => (
            <div class="creative-signal-band__item" role="listitem">
              <p class="creative-signal-band__label">{item.label}</p>
              <p class="creative-signal-band__value">{item.value}</p>
            </div>
          ))
        }
      </div>

      <div>
        <h2 id={`${sectionId}-title`} class="creative-kicker">
          Confidence indicators
        </h2>
        <p class="creative-title tone-title mt-4 text-3xl sm:text-4xl">
          Visual proof that the system is built for launch velocity and
          operational calm.
        </p>
      </div>
      <p class="creative-copy text-sm sm:text-base">
        Metrics matter more when they live inside a visual rhythm that feels
        premium, believable, and easy to scan under pressure.
      </p>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          signalDescriptors.map((item, index) => (
            <ModernCard variant="minimal" className="creative-panel p-5">
              <div class="creative-panel-index">0{index + 1}</div>
              <p class="tone-title text-sm font-semibold">{item.title}</p>
              <p class="tone-body mt-2 text-sm">{item.copy}</p>
            </ModernCard>
          ))
        }
      </div>
    </div>

    <div>
      <ul
        class="grid list-none gap-6 p-0 sm:grid-cols-3"
        aria-label="Key performance metrics"
      >
        {
          keyMetrics.map((metric, index) => (
            <li>
              <ModernCard
                variant="minimal"
                className="creative-panel creative-stat-card h-full p-5 text-center"
              >
                <div class="creative-panel-index creative-panel-index--center">
                  0{index + 1}
                </div>
                <p id={`metric-${index}-label`} class="creative-stat-label">
                  {metric.label}
                </p>
                <p
                  class="creative-stat-value mt-3 tabular-nums"
                  aria-labelledby={`metric-${index}-label`}
                >
                  {metric.value}
                </p>
                <p class="creative-stat-copy mt-3">
                  Delivery models tuned for executive clarity, memorable
                  visuals, and resilient operations.
                </p>
              </ModernCard>
            </li>
          ))
        }
      </ul>

      <div class="creative-section-footer mt-8">
        <p class="creative-section-footer__copy">
          Results from delivery models designed for launch speed, executive
          clarity, and resilient operations.
        </p>
        <div
          class="creative-link-cluster"
          aria-label="Confidence design principles"
        >
          <span class="creative-pill">Fast comprehension</span>
          <span class="creative-pill">Strong contrast</span>
          <span class="creative-pill">Executive trust</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
</style>
