---
import { keyMetrics } from '../../data/marketing';
import ModernCard from '../ui/ModernCard.astro';

const sectionId = 'signal-grid';
---

<div
  class="glass-panel p-8 shadow-lg lg:p-10"
  role="region"
  aria-labelledby={`${sectionId}-title`}
>
  <h2
    id={`${sectionId}-title`}
    class="text-xs font-semibold uppercase tracking-[0.32em] text-slate-400"
  >
    Confidence indicators
  </h2>
  <ul
    class="mt-6 grid list-none gap-6 p-0 sm:grid-cols-3"
    aria-label="Key performance metrics"
  >
    {
      keyMetrics.map((metric, index) => (
        <li>
          <ModernCard
            variant="minimal"
            className="relative bg-white/5 p-5 text-center transition-colors hover:border-[#ccff00]/50 focus-within:ring-2 focus-within:ring-[#ccff00]/50"
          >
            <div
              class="absolute left-0 top-0 h-2 w-2 border-l border-t border-white/20 transition-colors group-hover:border-[#ccff00]"
              aria-hidden="true"
            />
            <div
              class="absolute right-0 top-0 h-2 w-2 border-r border-t border-white/20 transition-colors group-hover:border-[#ccff00]"
              aria-hidden="true"
            />
            <div
              class="absolute bottom-0 left-0 h-2 w-2 border-b border-l border-white/20 transition-colors group-hover:border-[#ccff00]"
              aria-hidden="true"
            />
            <div
              class="absolute bottom-0 right-0 h-2 w-2 border-b border-r border-white/20 transition-colors group-hover:border-[#ccff00]"
              aria-hidden="true"
            />

            <p
              id={`metric-${index}-label`}
              class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.3em] text-neutral-500"
            >
              {metric.label}
            </p>
            <p
              class="mt-3 font-display text-2xl font-semibold tabular-nums text-white"
              aria-labelledby={`metric-${index}-label`}
            >
              {metric.value}
            </p>
          </ModernCard>
        </li>
      ))
    }
  </ul>
  <p class="mt-8 text-xs text-slate-400">
    Results from delivery models designed for launch speed, executive clarity,
    and resilient operations.
  </p>
</div>

<style>
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
</style>
