---

---

<div class="experience-selector">
  <button
    id="experience-toggle"
    class="experience-selector__trigger"
    type="button"
    aria-label="Open visual direction selector"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="experience-menu"
  >
    <span class="experience-selector__current">
      <span class="experience-selector__swatch" data-experience-swatch></span>
      <span class="experience-selector__copy">
        <span class="experience-selector__label">Direction</span>
        <span class="experience-selector__value" data-experience-current-label>
          Cinematic
        </span>
      </span>
    </span>
    <svg
      class="experience-selector__chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M2.5 4.5L6 8L9.5 4.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div
    id="experience-menu"
    class="experience-selector__menu"
    role="menu"
    aria-label="Choose a visual direction"
    hidden
  >
    <button
      type="button"
      data-experience-mode="cinematic"
      class="experience-option"
      role="menuitemradio"
      aria-checked="true"
    >
      <span
        class="experience-option__visual experience-option__visual--cinematic"
      ></span>
      <span class="experience-option__copy">
        <span class="experience-option__title">Cinematic</span>
        <span class="experience-option__detail">
          Rich atmosphere, stronger glow, and gallery-level drama.
        </span>
      </span>
    </button>
    <button
      type="button"
      data-experience-mode="editorial"
      class="experience-option"
      role="menuitemradio"
      aria-checked="false"
    >
      <span
        class="experience-option__visual experience-option__visual--editorial"
      ></span>
      <span class="experience-option__copy">
        <span class="experience-option__title">Editorial</span>
        <span class="experience-option__detail">
          Softer noise, calmer spacing, and a more magazine-like rhythm.
        </span>
      </span>
    </button>
    <button
      type="button"
      data-experience-mode="blueprint"
      class="experience-option"
      role="menuitemradio"
      aria-checked="false"
    >
      <span
        class="experience-option__visual experience-option__visual--blueprint"
      ></span>
      <span class="experience-option__copy">
        <span class="experience-option__title">Blueprint</span>
        <span class="experience-option__detail">
          Sharper grid logic, technical contrast, and systems-first framing.
        </span>
      </span>
    </button>
  </div>
</div>

<style>
  .experience-selector {
    position: relative;
    display: inline-block;
  }

  .experience-selector__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    min-width: 15.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.05),
        rgba(255, 255, 255, 0.02)
      ),
      rgba(5, 7, 10, 0.84);
    padding: 0.55rem 0.8rem;
    color: var(--color-text-primary);
    box-shadow:
      0 18px 34px -26px rgba(0, 0, 0, 0.88),
      0 0 28px -26px rgba(56, 189, 248, 0.18);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .experience-selector__trigger:hover {
    border-color: rgba(56, 189, 248, 0.22);
    transform: translateY(-1px);
  }

  .experience-selector__current {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .experience-selector__swatch {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(215, 247, 91, 0.28),
        transparent 52%
      ),
      linear-gradient(135deg, rgba(2, 6, 12, 0.96), rgba(16, 18, 24, 0.86));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }

  .experience-selector__copy {
    display: grid;
    min-width: 0;
  }

  .experience-selector__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .experience-selector__value {
    font-size: 0.88rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .experience-selector__chevron {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.46);
    transition: transform 180ms ease;
  }

  .experience-selector__trigger[aria-expanded='true']
    .experience-selector__chevron {
    transform: rotate(180deg);
  }

  .experience-selector__menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(20rem, 84vw);
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(10, 12, 18, 0.96), rgba(6, 8, 14, 0.92)),
      rgba(5, 7, 10, 0.94);
    padding: 0.45rem;
    box-shadow:
      0 28px 58px -30px rgba(0, 0, 0, 0.96),
      0 0 40px -28px rgba(56, 189, 248, 0.16);
    backdrop-filter: blur(20px);
    z-index: 70;
  }

  .experience-option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    width: 100%;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
    padding: 0.7rem;
    color: var(--color-text-primary);
    text-align: left;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .experience-option:hover,
  .experience-option:focus-visible {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
  }

  .experience-option.active {
    border-color: rgba(56, 189, 248, 0.22);
    background: rgba(56, 189, 248, 0.08);
    box-shadow: 0 0 28px -22px rgba(56, 189, 248, 0.32);
  }

  .experience-option__visual {
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .experience-option__visual--cinematic {
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(215, 247, 91, 0.3),
        transparent 55%
      ),
      linear-gradient(135deg, #010204, #101319);
  }

  .experience-option__visual--editorial {
    background:
      radial-gradient(
        circle at 28% 28%,
        rgba(248, 250, 252, 0.34),
        transparent 48%
      ),
      linear-gradient(135deg, #201b18, #0d1118);
  }

  .experience-option__visual--blueprint {
    background:
      linear-gradient(rgba(148, 163, 184, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.16) 1px, transparent 1px),
      linear-gradient(135deg, #06111a, #0b1a24);
    background-size:
      12px 12px,
      12px 12px,
      auto;
  }

  .experience-option__copy {
    display: grid;
    gap: 0.16rem;
  }

  .experience-option__title {
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .experience-option__detail {
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.56);
  }
</style>

<script>
  import {
    experienceMode,
    initializeExperienceMode,
    setExperienceMode,
    type ExperienceMode,
  } from '../store/index';

  const modeMeta = {
    cinematic: {
      label: 'Cinematic',
      swatch:
        'radial-gradient(circle at 30% 30%, rgba(215,247,91,0.28), transparent 52%), linear-gradient(135deg, rgba(2,6,12,0.96), rgba(16,18,24,0.86))',
    },
    editorial: {
      label: 'Editorial',
      swatch:
        'radial-gradient(circle at 30% 30%, rgba(248,250,252,0.28), transparent 52%), linear-gradient(135deg, rgba(32,27,24,0.96), rgba(13,17,24,0.92))',
    },
    blueprint: {
      label: 'Blueprint',
      swatch:
        'linear-gradient(rgba(148,163,184,0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,0.16) 1px, transparent 1px), linear-gradient(135deg, #06111a, #0b1a24)',
    },
  } as const;

  const bindExperienceSelector = () => {
    initializeExperienceMode();

    const root = document.querySelector('.experience-selector');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const toggle = root.querySelector(
      '#experience-toggle'
    ) as HTMLButtonElement | null;
    const menu = root.querySelector('#experience-menu') as HTMLElement | null;
    const options = Array.from(
      root.querySelectorAll<HTMLButtonElement>('.experience-option')
    );
    const currentLabel = root.querySelector(
      '[data-experience-current-label]'
    ) as HTMLElement | null;
    const swatch = root.querySelector(
      '[data-experience-swatch]'
    ) as HTMLElement | null;

    if (!toggle || !menu) return;

    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    const openMenu = () => {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    };

    const syncModeUi = (currentMode: ExperienceMode) => {
      const meta = modeMeta[currentMode];
      if (currentLabel) currentLabel.textContent = meta.label;
      if (swatch) {
        swatch.style.background = meta.swatch;
        if (currentMode === 'blueprint') {
          swatch.style.backgroundSize = '12px 12px, 12px 12px, auto';
        } else {
          swatch.style.backgroundSize = 'auto';
        }
      }

      options.forEach(option => {
        const isActive = option.dataset.experienceMode === currentMode;
        option.classList.toggle('active', isActive);
        option.setAttribute('aria-checked', String(isActive));
      });
    };

    experienceMode.subscribe(syncModeUi);
    syncModeUi(experienceMode.get());

    toggle.addEventListener('click', event => {
      event.stopPropagation();
      if (menu.hidden) {
        openMenu();
      } else {
        closeMenu();
      }
    });

    document.addEventListener('click', event => {
      const target = event.target as Node | null;
      if (!target || root.contains(target)) return;
      closeMenu();
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeMenu();
      }
    });

    options.forEach(option => {
      option.addEventListener('click', () => {
        const newMode = option.dataset.experienceMode as
          | ExperienceMode
          | undefined;
        if (!newMode) return;
        setExperienceMode(newMode);
        closeMenu();
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindExperienceSelector, {
      once: true,
    });
  } else {
    bindExperienceSelector();
  }

  document.addEventListener('astro:page-load', bindExperienceSelector);
</script>
