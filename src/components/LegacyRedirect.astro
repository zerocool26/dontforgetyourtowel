---
import { SITE_TITLE } from '../consts';
import { withBasePath } from '../utils/helpers';

interface Props {
  destination?: string;
  reason?: string;
  statusText?: string;
  preserveParams?: boolean;
}

const {
  destination = '/',
  reason = 'This page is no longer available.',
  statusText = 'Redirecting…',
  preserveParams = true,
} = Astro.props as Props;

const href = destination.startsWith('/')
  ? withBasePath(destination)
  : destination;
---

<!doctype html>
<html
  lang="en"
  data-redirect-target={href}
  data-redirect-preserve={preserveParams ? 'true' : 'false'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={href} />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <title>{statusText} | {SITE_TITLE}</title>
    <style>
      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          Arial,
          sans-serif;
        background:
          radial-gradient(
            circle at 15% 10%,
            rgba(215, 247, 91, 0.1),
            transparent 34%
          ),
          radial-gradient(
            circle at 85% 15%,
            rgba(18, 181, 166, 0.1),
            transparent 32%
          ),
          linear-gradient(180deg, #11140f, #050604 72%);
        color: #e4e4e7;
      }
      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1rem;
      }
      .card {
        max-width: 42rem;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        padding: clamp(1.15rem, 4vw, 1.75rem);
        background:
          linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.065),
            rgba(255, 255, 255, 0.025)
          ),
          rgba(6, 8, 5, 0.82);
        box-shadow:
          0 28px 70px -42px rgba(0, 0, 0, 0.95),
          0 0 42px -28px rgba(215, 247, 91, 0.42);
      }
      h1 {
        font-size: clamp(1.35rem, 5vw, 2rem);
        margin: 0;
        letter-spacing: 0;
        line-height: 1.08;
      }
      p {
        margin: 0.75rem 0 0;
        color: rgba(228, 228, 231, 0.82);
        line-height: 1.5;
      }
      a {
        color: #d7f75b;
        font-weight: 700;
        text-underline-offset: 0.18em;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="card">
        <h1>{statusText}</h1>
        <p>{reason}</p>
        <p>
          If you are not redirected automatically, <a href={href}
            >continue here</a
          >.
        </p>
      </div>
    </main>
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const targetValue = root.getAttribute('data-redirect-target') || '';
          const shouldPreserve =
            root.getAttribute('data-redirect-preserve') !== 'false';

          if (!targetValue) return;

          const target = new URL(targetValue, window.location.href);
          const current = new URL(window.location.href);

          if (shouldPreserve) {
            if (!target.search && current.search)
              target.search = current.search;
            if (!target.hash && current.hash) target.hash = current.hash;
          }

          const nextUrl = target.toString();
          if (nextUrl !== window.location.href) {
            window.location.replace(nextUrl);
          }
        } catch {
          // no-op: meta refresh remains fallback
        }
      })();
    </script>
  </body>
</html>
