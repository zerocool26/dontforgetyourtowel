---
import { SITE_TITLE } from '../consts';
import { navLinks } from '../data/site';
import { withBasePath } from '../utils/helpers';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const resolvedLinks = navLinks.map(link => ({
  ...link,
  href: withBasePath(link.href),
}));

const isActive = (href: string) => {
  const pathname =
    new URL(href, Astro.site).pathname.replace(/\/+$/, '') || '/';
  return currentPath === pathname;
};
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href={withBasePath('/')} aria-label={`${SITE_TITLE} home`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span>{SITE_TITLE}</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        resolvedLinks.map(link => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      class="button button--small desktop-cta"
      href={withBasePath('contact-hq/')}
    >
      Put us to work
    </a>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {
          resolvedLinks.map(link => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <a class="button" href={withBasePath('contact-hq/')}>
          Put us to work
        </a>
      </nav>
    </details>
  </div>
</header>
