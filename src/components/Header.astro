---
import { BASE_PATH, CONTACT_EMAIL, SITE_TITLE } from '../consts';
import { withBasePath } from '../utils/helpers';
import { tradeProfiles } from '../data/trades';
import { getTradeVisual } from '../data/trade-visuals';
import { getRouteContext } from '../utils/route-context';
import ModernButton from './ui/ModernButton.astro';

const homeHref = withBasePath('/');
const mobileSiteTitle = SITE_TITLE.replace(/\s+Systems$/i, '');

const links = [
  { label: 'Solutions', href: withBasePath('services/') },
  { label: 'Pricing', href: withBasePath('pricing/') },
  { label: 'Company', href: withBasePath('company/') },
  { label: 'Proof', href: withBasePath('about/') },
  { label: 'Studio', href: withBasePath('build-studio/') },
  { label: 'Gallery', href: withBasePath('gallery/') },
  { label: 'Contact', href: withBasePath('contact-hq/') },
];

const tradeLinks = tradeProfiles.map(trade => ({
  label: getTradeVisual(trade.slug).navLabel,
  href: withBasePath(`trades/${trade.slug}/`),
  accent: trade.accent,
}));

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('Strategy intake — Olive Global Systems')}`;

const normalizePath = (value: string) => {
  const strippedBase =
    BASE_PATH && BASE_PATH !== '/' ? value.replace(BASE_PATH, '/') : value;
  const trimmed = strippedBase.replace(/\/+$/, '');
  return trimmed.length ? trimmed : '/';
};

const currentPath = normalizePath(Astro.url.pathname);
const routeContext = getRouteContext(Astro.url.pathname);
const isHomePage = currentPath === '/';
const isTradePage =
  currentPath === '/trades' || currentPath.startsWith('/trades/');
const compactContextLinks = routeContext.suggestions.slice(
  0,
  isTradePage ? 2 : 2
);

const searchTriggerClasses =
  'header-action tone-focus-accent inline-flex min-h-[44px] items-center gap-2 rounded-xl px-3 text-sm font-medium transition';

const desktopNavLinkClasses =
  'header-desktop-link tone-focus-accent relative flex h-full items-center border-l border-white/[0.06] px-4 font-mono text-xs uppercase tracking-wide transition-all duration-300';

const mobileMenuLinkClasses =
  'header-mobile-link tone-focus-accent min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition';

const isActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    return normalizePath(url.pathname) === currentPath;
  } catch {
    return normalizePath(href) === currentPath;
  }
};

const isTradeActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    const normalized = normalizePath(url.pathname);
    return (
      currentPath === normalized || currentPath.startsWith(`${normalized}/`)
    );
  } catch {
    const normalized = normalizePath(href);
    return (
      currentPath === normalized || currentPath.startsWith(`${normalized}/`)
    );
  }
};
---

<header
  class="tone-shell-header safe-area-inset-top sticky top-0 z-50 border-b backdrop-blur-2xl backdrop-saturate-150"
  style={`--header-route-accent:${routeContext.accent};`}
>
  <!-- Accent gradient line at top of header -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px"
    style="background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--header-route-accent) 50%, transparent), transparent);"
    aria-hidden="true"
  >
  </div>
  <nav
    class="header-nav-shell mx-auto flex min-h-[4.5rem] max-w-[1400px] items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a
      class="tone-focus-accent tone-title group flex h-full min-w-0 flex-1 items-center gap-2 rounded-md py-3 sm:gap-3 lg:flex-none"
      href={homeHref}
      aria-label={`${SITE_TITLE} home`}
    >
      <span
        class="header-brand-mark relative inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg text-[10px] font-bold uppercase tracking-widest transition-colors duration-200"
      >
        OGS
      </span>
      <div class="flex min-w-0 flex-col leading-none">
        <span
          class="tone-title block whitespace-nowrap font-display text-xs font-bold uppercase tracking-tight sm:hidden"
        >
          {mobileSiteTitle}
        </span>
        <span
          class="tone-title hidden truncate whitespace-nowrap font-display text-sm font-bold uppercase tracking-tight sm:block"
        >
          {SITE_TITLE}
        </span>
        <div class="mt-0.5 hidden items-center gap-2 sm:flex">
          <span
            class="max-w-[19rem] truncate whitespace-nowrap font-mono text-[0.6rem] uppercase tracking-[0.22em] text-white/55"
          >
            MSP+ • security • cloud • AI • custom systems
          </span>
          {
            !isHomePage ? (
              <span class="header-route-pill">
                {routeContext.currentCategory}
              </span>
            ) : null
          }
        </div>
      </div>
    </a>

    <div class="hidden h-full items-center lg:flex">
      {
        (() => {
          const active = isActiveHref(homeHref);
          return (
            <a
              class={`${desktopNavLinkClasses} ${active ? 'is-active' : ''}`}
              href={homeHref}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              Home
            </a>
          );
        })()
      }
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`${desktopNavLinkClasses} ${active ? 'is-active' : ''}`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <div
        class="h-8 w-px self-center bg-gradient-to-b from-transparent via-white/10 to-transparent"
      >
      </div>
    </div>

    <div class="hidden items-center gap-4 pl-6 lg:flex">
      <button
        type="button"
        data-open-saved-routes
        class="saved-routes-trigger header-action tone-focus-accent min-h-[44px] items-center gap-2 rounded-lg px-3 font-mono text-xs uppercase tracking-[0.2em] transition"
        hidden
      >
        <span>Saved</span>
        <span
          class="saved-routes-trigger__count rounded-full border border-white/10 px-1.5 py-0.5 text-[10px]"
          data-saved-routes-count
        >
          0
        </span>
      </button>
      <button
        type="button"
        data-command-palette-trigger
        class={searchTriggerClasses}
        aria-label="Open site search"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path>
        </svg>
        <span>Search</span>
        <kbd class="tone-kbd rounded px-1.5 py-0.5 text-[10px]"> Ctrl/⌘ K </kbd>
      </button>
      <div class="tone-border h-6 w-px"></div>
      <ModernButton
        variant="primary"
        className="font-mono text-xs uppercase tracking-wider"
        rounded="sm"
        href={startProjectHref}
      >
        Start Intake
      </ModernButton>
    </div>

    <div class="flex flex-shrink-0 items-center gap-2 lg:hidden">
      <button
        type="button"
        data-open-saved-routes
        class={`${searchTriggerClasses} h-12 min-w-[3.5rem] justify-center gap-1 px-3`}
        hidden
        aria-label="Open saved routes"
      >
        <span>Save</span>
        <span
          class="rounded-full border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 text-[10px]"
          data-saved-routes-count
        >
          0
        </span>
      </button>
      <button
        type="button"
        data-command-palette-trigger
        class={`${searchTriggerClasses} h-12 w-12 justify-center px-0`}
        aria-label="Open site search"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path>
        </svg>
      </button>
      <ModernButton
        variant="outline"
        className="tone-border tone-surface tone-muted min-h-touch min-w-touch flex h-12 w-12 touch-manipulation items-center justify-center p-0 hover:border-white/20 hover:text-white"
        id="mobile-menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        rounded="none"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-linecap="square"
            stroke-linejoin="miter"
            stroke-width="1.5"></path>
        </svg>
      </ModernButton>
    </div>
  </nav>

  {
    isTradePage ? (
      <div class="hidden border-t border-white/[0.05] lg:block">
        <nav
          class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-8"
          aria-label="Specialized route navigation"
        >
          <div class="flex items-center gap-2 overflow-x-auto py-2.5 scrollbar-hide">
            <a
              class={`tone-focus-accent rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.24em] transition ${
                isActiveHref(withBasePath('trades/'))
                  ? 'tone-chip-active'
                  : 'tone-chip-neutral hover:border-white/20 hover:text-white'
              }`}
              href={withBasePath('trades/')}
              data-astro-prefetch
              aria-current={
                isActiveHref(withBasePath('trades/')) ? 'page' : undefined
              }
            >
              Specialized routes
            </a>
            {tradeLinks.map(link => {
              const active = isTradeActiveHref(link.href);
              return (
                <a
                  class={`tone-focus-accent rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.22em] transition ${
                    active
                      ? 'text-white shadow-[0_0_20px_rgba(255,255,255,0.08)]'
                      : 'text-white/58 hover:text-white'
                  }`}
                  style={`border-color: ${active ? `color-mix(in srgb, ${link.accent} 42%, transparent)` : 'rgba(255,255,255,0.08)'}; background:${active ? `color-mix(in srgb, ${link.accent} 14%, rgba(255,255,255,0.03))` : 'rgba(255,255,255,0.03)'};`}
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    ) : null
  }

  {
    !isHomePage ? (
      <div class="hidden border-t border-white/[0.05] lg:block">
        <div class="mx-auto max-w-[1400px] px-4 py-2.5 sm:px-6 lg:px-8">
          <div class="header-context-compact flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <div class="flex min-w-0 items-start gap-3">
              <span
                class="mt-0.5 inline-flex flex-shrink-0 rounded-full border px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-[0.22em] text-white/80"
                style="border-color: color-mix(in srgb, var(--header-route-accent) 30%, rgba(255,255,255,0.08)); background: color-mix(in srgb, var(--header-route-accent) 8%, rgba(255,255,255,0.03));"
              >
                {routeContext.currentCategory}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <p class="truncate text-sm font-semibold text-white sm:text-[0.95rem]">
                    {routeContext.currentTitle}
                  </p>
                  <span class="text-white/34 font-mono text-[0.58rem] uppercase tracking-[0.22em]">
                    {routeContext.kicker}
                  </span>
                </div>
                <p class="text-white/48 mt-1 hidden max-w-3xl truncate text-sm leading-relaxed xl:block">
                  {routeContext.currentDescription}
                </p>
              </div>
            </div>

            <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-hide md:max-w-[34rem] md:justify-end">
              {compactContextLinks.map(link => (
                <a
                  href={link.href}
                  class="header-context-compact__link min-w-[10rem] flex-1 rounded-full border border-white/10 bg-white/[0.03] px-3 py-2 transition hover:border-white/20 hover:bg-white/[0.05] md:min-w-0 md:flex-none"
                >
                  <span class="block text-sm font-semibold text-white">
                    {link.label}
                  </span>
                  <span class="text-white/46 mt-0.5 hidden text-[0.72rem] leading-relaxed lg:block">
                    {link.detail}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ) : null
  }

  <div class="lg:hidden" id="mobile-menu" hidden>
    <div
      class="tone-border tone-surface tone-body space-y-2 border-t px-4 py-5 text-sm"
    >
      <button
        type="button"
        data-command-palette-trigger
        class="header-action tone-focus-accent tone-title min-h-touch flex w-full touch-manipulation items-center justify-between rounded-lg px-3 py-3 font-medium transition"
      >
        <span>Search the site</span>
        <span class="tone-muted text-xs">Ctrl/⌘ K</span>
      </button>
      <a
        class={`${mobileMenuLinkClasses} tone-body`}
        href={homeHref}
        data-astro-prefetch
        aria-current={isActiveHref(homeHref) ? 'page' : undefined}
      >
        Home
      </a>
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`${mobileMenuLinkClasses} ${
                active ? 'bg-white/10 text-white' : 'tone-body'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      {
        isTradePage ? (
          <div class="border-t border-white/10 pt-3">
            <p class="px-3 pb-2 font-mono text-[0.65rem] uppercase tracking-[0.24em] text-white/45">
              Specialized routes
            </p>
            {tradeLinks.map(link => {
              const active = isTradeActiveHref(link.href);
              return (
                <a
                  class={`${mobileMenuLinkClasses} mb-2 ${
                    active
                      ? 'bg-white/10 text-white'
                      : 'tone-body hover:bg-white/5'
                  }`}
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        ) : null
      }
      <a
        class="tone-focus-accent min-h-touch flex touch-manipulation items-center rounded-lg bg-white px-3 py-3 font-semibold text-slate-900 transition hover:bg-slate-100"
        href={startProjectHref}
      >
        Book strategy intake
      </a>
    </div>
  </div>
</header>

<style>
  .header-nav-shell {
    position: relative;
  }

  .header-nav-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.35rem;
    border: 1px solid color-mix(in srgb, white 4%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 3%, transparent),
      transparent
    );
    opacity: 0.95;
    pointer-events: none;
  }

  .header-brand-mark {
    border: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 12%,
          transparent
        ),
        color-mix(in srgb, var(--color-surface) 90%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 86%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 90%, transparent);
    box-shadow:
      0 14px 28px -18px rgba(2, 6, 23, 0.72),
      inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
  }

  .group:hover .header-brand-mark {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 18%,
      transparent
    );
    color: var(--color-text-primary);
  }

  .header-desktop-link {
    color: color-mix(in srgb, var(--color-text-primary) 50%, transparent);
  }

  .header-desktop-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-primary) 88%, white 12%);
    box-shadow: 0 0 8px
      color-mix(in srgb, var(--color-primary) 45%, transparent);
    transform: scaleX(0);
    transform-origin: center;
    opacity: 0.7;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .header-desktop-link:hover,
  .header-desktop-link.is-active {
    color: var(--color-text-primary);
  }

  .header-desktop-link:hover::after,
  .header-desktop-link.is-active::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .header-action {
    border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 92%, white 3%),
        color-mix(in srgb, var(--color-surface) 78%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 78%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 4%, transparent),
      0 12px 28px -24px rgba(2, 6, 23, 0.76);
  }

  .header-action:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 16%,
      transparent
    );
    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 8%,
          transparent
        ),
        color-mix(in srgb, var(--color-surface) 84%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
    color: var(--color-text-primary);
  }

  .header-route-pill {
    display: inline-flex;
    min-height: 1.45rem;
    align-items: center;
    border-radius: 999px;
    border: 1px solid
      color-mix(in srgb, var(--header-route-accent) 28%, transparent);
    background: color-mix(
      in srgb,
      var(--header-route-accent) 12%,
      rgba(255, 255, 255, 0.03)
    );
    padding: 0 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .header-context-compact {
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1.2rem;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.015)
    );
    padding: 0.85rem 0.95rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .header-context-compact__link {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .header-mobile-link {
    color: color-mix(in srgb, var(--color-text-primary) 76%, transparent);
  }

  .header-mobile-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
  }
</style>

<script is:inline>
  (() => {
    const globalScope = window;

    const bindPaletteTriggers = () => {
      document
        .querySelectorAll('[data-command-palette-trigger]')
        .forEach(el => {
          const trigger = el;
          if (!(trigger instanceof HTMLElement)) return;
          if (trigger.dataset.paletteBound === '1') return;

          trigger.dataset.paletteBound = '1';
          trigger.addEventListener('click', () => {
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuButton =
              document.getElementById('mobile-menu-button');

            if (mobileMenu && !mobileMenu.hasAttribute('hidden')) {
              mobileMenu.setAttribute('hidden', '');
              mobileMenuButton?.setAttribute('aria-expanded', 'false');
            }

            window.dispatchEvent(new CustomEvent('command-palette:toggle'));
          });
        });
    };

    const bindSavedRouteTriggers = () => {
      globalScope.__headerSavedRoutesCleanup?.();

      const buttons = Array.from(
        document.querySelectorAll('[data-open-saved-routes]')
      ).filter(node => node instanceof HTMLButtonElement);
      const countTargets = Array.from(
        document.querySelectorAll('[data-saved-routes-count]')
      ).filter(node => node instanceof HTMLElement);

      const updateCounts = async () => {
        try {
          const mod = await import('../utils/route-memory');
          const count = mod.readPinnedRoutes().length;

          buttons.forEach(button => {
            button.hidden = count === 0;
            button.classList.toggle('inline-flex', count > 0);
          });

          countTargets.forEach(target => {
            target.textContent = `${count}`;
          });
        } catch {
          buttons.forEach(button => {
            button.hidden = true;
            button.classList.remove('inline-flex');
          });
        }
      };

      buttons.forEach(button => {
        if (button.dataset.savedRoutesBound === '1') return;
        button.dataset.savedRoutesBound = '1';
        button.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('saved-routes-dock:open'));
        });
      });

      window.addEventListener('olive:route-pins-updated', updateCounts);
      globalScope.__headerSavedRoutesCleanup = () => {
        window.removeEventListener('olive:route-pins-updated', updateCounts);
      };
      updateCounts();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindPaletteTriggers, {
        once: true,
      });
      document.addEventListener('DOMContentLoaded', bindSavedRouteTriggers, {
        once: true,
      });
    } else {
      bindPaletteTriggers();
      bindSavedRouteTriggers();
    }

    document.addEventListener('astro:page-load', bindPaletteTriggers);
    document.addEventListener('astro:page-load', bindSavedRouteTriggers);
  })();
</script>

<script>
  // Import the enhanced header script that uses our utilities
  import '../scripts/header';
</script>
