---
import { BASE_PATH, CONTACT_EMAIL, SITE_TITLE } from '../consts';
import { withBasePath } from '../utils/helpers';
import ThemeSelector from './ThemeSelector.astro';
import ModernButton from './ui/ModernButton.astro';

const homeHref = withBasePath('/');

const links = [
  { label: 'Services', href: withBasePath('services/') },
  { label: 'Contact', href: withBasePath('contact-hq/') },
  { label: 'Portfolio', href: withBasePath('about/') },
];

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('New project inquiry')}`;

const normalizePath = (value: string) => {
  const strippedBase =
    BASE_PATH && BASE_PATH !== '/' ? value.replace(BASE_PATH, '/') : value;
  const trimmed = strippedBase.replace(/\/+$/, '');
  return trimmed.length ? trimmed : '/';
};

const currentPath = normalizePath(Astro.url.pathname);

const isActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    return normalizePath(url.pathname) === currentPath;
  } catch {
    return normalizePath(href) === currentPath;
  }
};
---

<header
  class="safe-area-inset-top tone-border tone-surface sticky top-0 z-50 border-b backdrop-blur-xl"
>
  <nav
    class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 py-0 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a
      class="tone-title group flex h-full items-center gap-3 rounded-md py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-0"
      href={homeHref}
      aria-label={`${SITE_TITLE} home`}
    >
      <span
        class="tone-border tone-surface tone-title inline-flex h-8 w-8 items-center justify-center rounded-lg border text-[10px] font-bold uppercase tracking-widest transition-colors group-hover:border-accent-400 group-hover:text-accent-300"
      >
        OC
      </span>
      <div class="flex flex-col leading-none">
        <span
          class="tone-title font-display text-sm font-bold uppercase tracking-tight"
        >
          {SITE_TITLE}
        </span>
        <span
          class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.22em] text-accent-300"
        >
          DESIGN SYSTEMS • EXPERIENCES • ENGINEERING
        </span>
      </div>
    </a>

    <div class="hidden h-full items-center md:flex">
      {
        (() => {
          const active = isActiveHref(homeHref);
          return (
            <a
              class={`flex h-full items-center border-l border-zinc-800/50 px-4 font-mono text-xs uppercase tracking-wide transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-0 ${
                active
                  ? 'tone-surface tone-title'
                  : 'tone-body hover:tone-surface hover:text-white'
              }`}
              href={homeHref}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              Home
            </a>
          );
        })()
      }
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`flex h-full items-center border-l border-zinc-800/50 px-4 font-mono text-xs uppercase tracking-wide transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-0 ${
                active
                  ? 'tone-surface tone-title'
                  : 'tone-body hover:tone-surface hover:text-white'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <div class="tone-border h-full w-px"></div>
    </div>

    <div class="hidden items-center gap-4 pl-6 md:flex">
      <ThemeSelector />
      <div class="tone-border h-6 w-px"></div>
      <ModernButton
        variant="primary"
        className="font-mono text-xs uppercase tracking-wider"
        rounded="sm"
        href={startProjectHref}
      >
        Start a Project
      </ModernButton>
    </div>

    <div class="md:hidden">
      <ModernButton
        variant="outline"
        className="tone-border tone-surface tone-muted min-h-touch min-w-touch flex h-12 w-12 touch-manipulation items-center justify-center p-0 hover:border-zinc-600 hover:text-white"
        id="mobile-menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        rounded="none"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-linecap="square"
            stroke-linejoin="miter"
            stroke-width="1.5"></path>
        </svg>
      </ModernButton>
    </div>
  </nav>

  <div class="md:hidden" id="mobile-menu" hidden>
    <div
      class="tone-border tone-surface tone-body space-y-2 border-t px-4 py-5 text-sm"
    >
      <a
        class="tone-body min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400"
        href={homeHref}
        data-astro-prefetch
        aria-current={isActiveHref(homeHref) ? 'page' : undefined}
      >
        Home
      </a>
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 ${
                active ? 'bg-white/10 text-white' : 'tone-body'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        class="tone-title min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-semibold transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400"
        href={withBasePath('services/')}
        data-astro-prefetch
      >
        View services
      </a>
      <a
        class="min-h-touch flex touch-manipulation items-center rounded-lg bg-[rgba(99,102,241,0.15)] px-3 py-3 font-semibold text-white transition hover:bg-[rgba(99,102,241,0.25)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400"
        href={startProjectHref}
      >
        Start a project
      </a>
    </div>
  </div>
</header>

<script>
  // Import the enhanced header script that uses our utilities
  import '../scripts/header';
</script>
