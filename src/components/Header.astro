---
import { BASE_PATH, CONTACT_EMAIL, SITE_TITLE } from '../consts';
import { withBasePath } from '../utils/helpers';
import ThemeSelector from './ThemeSelector.astro';
import ModernButton from './ui/ModernButton.astro';

const homeHref = withBasePath('/');

const links = [
  { label: 'Services', href: withBasePath('services/') },
  { label: 'Pricing', href: withBasePath('pricing/') },
  { label: 'Build Studio', href: withBasePath('build-studio/') },
  { label: 'Portfolio', href: withBasePath('about/') },
  { label: 'Contact', href: withBasePath('contact-hq/') },
];

const startProjectHref = `mailto:${encodeURIComponent(
  CONTACT_EMAIL
)}?subject=${encodeURIComponent('New project inquiry')}`;

const normalizePath = (value: string) => {
  const strippedBase =
    BASE_PATH && BASE_PATH !== '/' ? value.replace(BASE_PATH, '/') : value;
  const trimmed = strippedBase.replace(/\/+$/, '');
  return trimmed.length ? trimmed : '/';
};

const currentPath = normalizePath(Astro.url.pathname);

const searchTriggerClasses =
  'tone-border tone-surface tone-muted inline-flex min-h-[44px] items-center gap-2 rounded-lg border px-3 text-xs font-mono uppercase tracking-[0.22em] transition hover:border-white/20 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00]';

const isActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    return normalizePath(url.pathname) === currentPath;
  } catch {
    return normalizePath(href) === currentPath;
  }
};
---

<header
  class="safe-area-inset-top sticky top-0 z-50 border-b border-white/[0.06] bg-[#030303]/80 backdrop-blur-2xl backdrop-saturate-150"
>
  <!-- Accent gradient line at top of header -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#ccff00]/40 to-transparent"
    aria-hidden="true"
  >
  </div>
  <nav
    class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 py-0 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a
      class="tone-title group flex h-full items-center gap-3 rounded-md py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-0"
      href={homeHref}
      aria-label={`${SITE_TITLE} home`}
    >
      <span
        class="relative inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-gradient-to-br from-white/[0.08] to-transparent text-[10px] font-bold uppercase tracking-widest text-white/90 shadow-[0_0_12px_rgba(204,255,0,0.08)] transition-all duration-300 group-hover:border-[#ccff00]/50 group-hover:text-[#ccff00] group-hover:shadow-[0_0_20px_rgba(204,255,0,0.25)]"
      >
        OC
      </span>
      <div class="flex flex-col leading-none">
        <span
          class="tone-title font-display text-sm font-bold uppercase tracking-tight"
        >
          {SITE_TITLE}
        </span>
        <span
          class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.22em] text-[#ccff00]"
        >
          DESIGN SYSTEMS • EXPERIENCES • ENGINEERING
        </span>
      </div>
    </a>

    <div class="hidden h-full items-center md:flex">
      {
        (() => {
          const active = isActiveHref(homeHref);
          return (
            <a
              class={`relative flex h-full items-center border-l border-white/[0.06] px-4 font-mono text-xs uppercase tracking-wide transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-0 ${
                active
                  ? 'text-white after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:rounded-full after:bg-[#ccff00] after:shadow-[0_0_8px_rgba(204,255,0,0.5)]'
                  : 'text-white/50 after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:scale-x-0 after:rounded-full after:bg-[#ccff00]/60 after:transition-transform after:duration-300 hover:text-white hover:after:scale-x-100'
              }`}
              href={homeHref}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              Home
            </a>
          );
        })()
      }
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`relative flex h-full items-center border-l border-white/[0.06] px-4 font-mono text-xs uppercase tracking-wide transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] focus-visible:ring-offset-0 ${
                active
                  ? 'text-white after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:rounded-full after:bg-[#ccff00] after:shadow-[0_0_8px_rgba(204,255,0,0.5)]'
                  : 'text-white/50 after:absolute after:inset-x-3 after:bottom-0 after:h-[2px] after:scale-x-0 after:rounded-full after:bg-[#ccff00]/60 after:transition-transform after:duration-300 hover:text-white hover:after:scale-x-100'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <div
        class="h-8 w-px self-center bg-gradient-to-b from-transparent via-white/10 to-transparent"
      >
      </div>
    </div>

    <div class="hidden items-center gap-4 pl-6 md:flex">
      <button
        type="button"
        data-command-palette-trigger
        class={searchTriggerClasses}
        aria-label="Open site search"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path>
        </svg>
        <span>Search</span>
        <kbd
          class="rounded border border-white/[0.08] bg-white/[0.04] px-1.5 py-0.5 text-[10px] text-zinc-500"
        >
          Ctrl/⌘ K
        </kbd>
      </button>
      <ThemeSelector />
      <div class="tone-border h-6 w-px"></div>
      <ModernButton
        variant="primary"
        className="font-mono text-xs uppercase tracking-wider"
        rounded="sm"
        href={startProjectHref}
      >
        Start a Project
      </ModernButton>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        data-command-palette-trigger
        class={`${searchTriggerClasses} h-12 w-12 justify-center px-0`}
        aria-label="Open site search"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path>
        </svg>
      </button>
      <ModernButton
        variant="outline"
        className="tone-border tone-surface tone-muted min-h-touch min-w-touch flex h-12 w-12 touch-manipulation items-center justify-center p-0 hover:border-white/20 hover:text-white"
        id="mobile-menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        rounded="none"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-linecap="square"
            stroke-linejoin="miter"
            stroke-width="1.5"></path>
        </svg>
      </ModernButton>
    </div>
  </nav>

  <div class="md:hidden" id="mobile-menu" hidden>
    <div
      class="tone-border tone-surface tone-body space-y-2 border-t px-4 py-5 text-sm"
    >
      <button
        type="button"
        data-command-palette-trigger
        class="tone-border tone-surface tone-title min-h-touch flex w-full touch-manipulation items-center justify-between rounded-lg border px-3 py-3 font-medium transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00]"
      >
        <span>Search the site</span>
        <span class="text-xs text-zinc-400">Ctrl/⌘ K</span>
      </button>
      <a
        class="tone-body min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00]"
        href={homeHref}
        data-astro-prefetch
        aria-current={isActiveHref(homeHref) ? 'page' : undefined}
      >
        Home
      </a>
      {
        links.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00] ${
                active ? 'bg-white/10 text-white' : 'tone-body'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        class="tone-title min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-semibold transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00]"
        href={withBasePath('build-studio/')}
        data-astro-prefetch
      >
        Launch Build Studio
      </a>
      <a
        class="min-h-touch flex touch-manipulation items-center rounded-lg bg-[rgba(99,102,241,0.15)] px-3 py-3 font-semibold text-white transition hover:bg-[rgba(99,102,241,0.25)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#ccff00]"
        href={startProjectHref}
      >
        Start a project
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const bindPaletteTriggers = () => {
      document
        .querySelectorAll('[data-command-palette-trigger]')
        .forEach(el => {
          const trigger = el;
          if (!(trigger instanceof HTMLElement)) return;
          if (trigger.dataset.paletteBound === '1') return;

          trigger.dataset.paletteBound = '1';
          trigger.addEventListener('click', () => {
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuButton =
              document.getElementById('mobile-menu-button');

            if (mobileMenu && !mobileMenu.hasAttribute('hidden')) {
              mobileMenu.setAttribute('hidden', '');
              mobileMenuButton?.setAttribute('aria-expanded', 'false');
            }

            window.dispatchEvent(new CustomEvent('command-palette:toggle'));
          });
        });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindPaletteTriggers, {
        once: true,
      });
    } else {
      bindPaletteTriggers();
    }

    document.addEventListener('astro:page-load', bindPaletteTriggers);
  })();
</script>

<script>
  // Import the enhanced header script that uses our utilities
  import '../scripts/header';
</script>
