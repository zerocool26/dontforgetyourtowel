---
import { BASE_PATH, SITE_TITLE } from '../consts';
import { withBasePath } from '../utils/helpers';
import { tradeProfiles } from '../data/trades';
import { getTradeVisual } from '../data/trade-visuals';
import { getRouteContext } from '../utils/route-context';

const homeHref = withBasePath('/');
const mobileSiteTitle = SITE_TITLE;

const links = [
  { label: 'Solutions', href: withBasePath('services/') },
  { label: 'Pricing', href: withBasePath('pricing/') },
  { label: 'E Commerce Demo', href: withBasePath('about/') },
  { label: 'Contact', href: withBasePath('contact-hq/') },
];

const tradeLinks = tradeProfiles.map(trade => ({
  label: getTradeVisual(trade.slug).navLabel,
  href: withBasePath(`trades/${trade.slug}/`),
  accent: trade.accent,
}));

const normalizePath = (value: string) => {
  const strippedBase =
    BASE_PATH && BASE_PATH !== '/' ? value.replace(BASE_PATH, '/') : value;
  const trimmed = strippedBase.replace(/\/+$/, '');
  return trimmed.length ? trimmed : '/';
};

const currentPath = normalizePath(Astro.url.pathname);
const routeContext = getRouteContext(Astro.url.pathname);
const isTradePage =
  currentPath === '/trades' || currentPath.startsWith('/trades/');
const headerLinks = links;

const searchTriggerClasses =
  'header-action tone-focus-accent inline-flex min-h-[46px] items-center gap-2 rounded-[0.95rem] px-3.5 text-sm font-medium transition';

const desktopNavLinkClasses =
  'header-desktop-link tone-focus-accent relative flex h-full items-center border-l border-white/[0.06] px-4 text-[0.78rem] font-semibold uppercase tracking-[0.12em] transition-all duration-300';

const mobileMenuLinkClasses =
  'header-mobile-link tone-focus-accent min-h-touch flex touch-manipulation items-center rounded-lg px-3 py-3 font-medium transition';

const isActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    return normalizePath(url.pathname) === currentPath;
  } catch {
    return normalizePath(href) === currentPath;
  }
};

const isTradeActiveHref = (href: string) => {
  try {
    const url = Astro.site
      ? new URL(href, Astro.site)
      : new URL(href, 'https://local.invalid');
    const normalized = normalizePath(url.pathname);
    return (
      currentPath === normalized || currentPath.startsWith(`${normalized}/`)
    );
  } catch {
    const normalized = normalizePath(href);
    return (
      currentPath === normalized || currentPath.startsWith(`${normalized}/`)
    );
  }
};
---

<header
  class="tone-shell-header safe-area-inset-top sticky top-0 z-50 border-b backdrop-blur-2xl backdrop-saturate-150"
  style={`--header-route-accent:${routeContext.accent};`}
>
  <!-- Accent gradient line at top of header -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px"
    style="background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--header-route-accent) 50%, transparent), transparent);"
    aria-hidden="true"
  >
  </div>
  <nav
    class="header-nav-shell mx-auto flex min-h-[4.35rem] max-w-[1400px] items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a
      class="tone-focus-accent tone-title group flex h-full min-w-0 flex-1 items-center gap-2 rounded-md py-3 sm:gap-3 lg:flex-none"
      href={homeHref}
      aria-label={`${SITE_TITLE} home`}
    >
      <span
        class="header-brand-mark relative inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg text-[10px] font-bold uppercase tracking-widest transition-colors duration-200"
      >
        OC
      </span>
      <div class="flex min-w-0 flex-col leading-none">
        <span
          class="tone-title block whitespace-nowrap font-display text-[0.72rem] font-semibold uppercase tracking-[0.08em] sm:hidden"
        >
          {mobileSiteTitle}
        </span>
        <span
          class="tone-title hidden truncate whitespace-nowrap font-display text-[0.9rem] font-semibold uppercase tracking-[0.06em] sm:block"
        >
          {SITE_TITLE}
        </span>
      </div>
    </a>

    <div class="hidden h-full items-center lg:flex">
      {
        (() => {
          const active = isActiveHref(homeHref);
          return (
            <a
              class={`${desktopNavLinkClasses} ${active ? 'is-active' : ''}`}
              href={homeHref}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              Home
            </a>
          );
        })()
      }
      {
        headerLinks.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`${desktopNavLinkClasses} ${active ? 'is-active' : ''}`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      <div
        class="h-8 w-px self-center bg-gradient-to-b from-transparent via-white/10 to-transparent"
      >
      </div>
    </div>

    <div class="hidden items-center gap-4 pl-6 lg:flex">
      <button
        type="button"
        data-open-saved-routes
        class="saved-routes-trigger header-action tone-focus-accent min-h-[44px] items-center gap-2 rounded-lg px-3 text-[0.72rem] font-semibold uppercase tracking-[0.12em] transition"
        hidden
      >
        <span>Saved</span>
        <span
          class="saved-routes-trigger__count rounded-full border border-white/10 px-1.5 py-0.5 text-[10px]"
          data-saved-routes-count
        >
          0
        </span>
      </button>
      <button
        type="button"
        data-command-palette-trigger
        class={searchTriggerClasses}
        aria-label="Open site search"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"></path>
        </svg>
        <span>Search</span>
        <kbd class="tone-kbd rounded px-1.5 py-0.5 text-[10px]"> Ctrl/⌘ K </kbd>
      </button>
    </div>

    <div class="flex flex-shrink-0 items-center gap-2 lg:hidden">
      <button
        class="tone-border tone-surface tone-muted tone-focus-accent min-h-touch min-w-touch flex h-12 w-12 touch-manipulation items-center justify-center rounded-lg p-0 transition hover:border-white/20 hover:text-white"
        id="mobile-menu-button"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        rounded="sm"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-linecap="square"
            stroke-linejoin="miter"
            stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </nav>

  {
    isTradePage ? (
      <div class="hidden border-t border-white/[0.05] lg:block">
        <nav
          class="mx-auto max-w-[1400px] px-5 sm:px-6 lg:px-8"
          aria-label="Specialized route navigation"
        >
          <div class="flex items-center gap-2 overflow-x-auto py-2.5 scrollbar-hide">
            <a
              class={`tone-focus-accent rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.24em] transition ${
                isActiveHref(withBasePath('trades/'))
                  ? 'tone-chip-active'
                  : 'tone-chip-neutral hover:border-white/20 hover:text-white'
              }`}
              href={withBasePath('trades/')}
              data-astro-prefetch
              aria-current={
                isActiveHref(withBasePath('trades/')) ? 'page' : undefined
              }
            >
              Specialized routes
            </a>
            {tradeLinks.map(link => {
              const active = isTradeActiveHref(link.href);
              return (
                <a
                  class={`tone-focus-accent rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.22em] transition ${
                    active
                      ? 'text-white shadow-[0_0_20px_rgba(255,255,255,0.08)]'
                      : 'text-white/58 hover:text-white'
                  }`}
                  style={`border-color: ${active ? `color-mix(in srgb, ${link.accent} 42%, transparent)` : 'rgba(255,255,255,0.08)'}; background:${active ? `color-mix(in srgb, ${link.accent} 14%, rgba(255,255,255,0.03))` : 'rgba(255,255,255,0.03)'};`}
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        </nav>
      </div>
    ) : null
  }

  <div class="lg:hidden" id="mobile-menu" hidden>
    <div
      class="tone-border tone-surface tone-body space-y-2 border-t px-4 py-5 text-sm"
    >
      <button
        type="button"
        data-command-palette-trigger
        class="header-action tone-focus-accent tone-title min-h-touch flex w-full touch-manipulation items-center justify-between rounded-lg px-3 py-3 font-medium transition"
      >
        <span>Search the site</span>
        <span class="tone-muted text-xs">Ctrl/⌘ K</span>
      </button>
      <a
        class={`${mobileMenuLinkClasses} tone-body`}
        href={homeHref}
        data-astro-prefetch
        aria-current={isActiveHref(homeHref) ? 'page' : undefined}
      >
        Home
      </a>
      {
        headerLinks.map(link => {
          const active = isActiveHref(link.href);
          return (
            <a
              class={`${mobileMenuLinkClasses} ${
                active ? 'bg-white/10 text-white' : 'tone-body'
              }`}
              href={link.href}
              data-astro-prefetch
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
      {
        isTradePage ? (
          <div class="border-t border-white/10 pt-3">
            <p class="px-3 pb-2 font-mono text-[0.65rem] uppercase tracking-[0.24em] text-white/45">
              Specialized routes
            </p>
            {tradeLinks.map(link => {
              const active = isTradeActiveHref(link.href);
              return (
                <a
                  class={`${mobileMenuLinkClasses} mb-2 ${
                    active
                      ? 'bg-white/10 text-white'
                      : 'tone-body hover:bg-white/5'
                  }`}
                  href={link.href}
                  data-astro-prefetch
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        ) : null
      }
    </div>
  </div>
</header>

<style>
  .header-nav-shell {
    position: relative;
    border-radius: 1.1rem;
  }

  .header-nav-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, white 4%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 2%, transparent),
      transparent 42%
    );
    opacity: 0.88;
    pointer-events: none;
  }

  .header-nav-shell::after {
    content: none;
  }

  .header-nav-shell > * {
    position: relative;
    z-index: 2;
  }

  .header-brand-mark {
    border: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 8%,
          transparent
        ),
        color-mix(in srgb, var(--color-surface) 90%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 86%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 90%, transparent);
    box-shadow:
      0 14px 24px -20px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 color-mix(in srgb, white 10%, transparent);
  }

  .group:hover .header-brand-mark {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 18%,
      transparent
    );
    color: var(--color-text-primary);
  }

  .header-desktop-link {
    margin-block: 0.35rem;
    border-left-color: transparent;
    border-radius: 0.9rem;
    color: color-mix(in srgb, var(--color-text-primary) 60%, transparent);
  }

  .header-desktop-link::after {
    content: '';
    position: absolute;
    inset: 0.26rem;
    height: auto;
    border-radius: 0.8rem;
    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 5%,
          transparent
        ),
        color-mix(in srgb, var(--color-surface) 86%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
    transform: scale(0.97);
    transform-origin: center;
    opacity: 0;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    z-index: -1;
  }

  .header-desktop-link:hover,
  .header-desktop-link.is-active {
    color: var(--color-text-primary);
  }

  .header-desktop-link:hover::after,
  .header-desktop-link.is-active::after {
    transform: scale(1);
    opacity: 1;
  }

  .header-action {
    border: 1px solid color-mix(in srgb, var(--color-border) 76%, transparent);
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 78%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, white 4%, transparent),
      0 18px 34px -34px rgba(0, 0, 0, 0.45);
  }

  .header-action:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 16%,
      transparent
    );
    background: color-mix(in srgb, var(--color-surface) 98%, transparent);
    color: var(--color-text-primary);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 4%, transparent);
  }

  .header-mobile-link {
    color: color-mix(in srgb, var(--color-text-primary) 76%, transparent);
  }

  .header-mobile-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
  }

  #mobile-menu > div {
    position: relative;
    border-radius: 0 0 1.1rem 1.1rem;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 96%, white 2%),
        color-mix(in srgb, var(--color-surface) 88%, transparent)
      ),
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--header-route-accent) 4%, transparent),
        transparent 46%
      );
    box-shadow: none;
  }
</style>

<script is:inline>
  (() => {
    const globalScope = window;

    const bindPaletteTriggers = () => {
      document
        .querySelectorAll('[data-command-palette-trigger]')
        .forEach(el => {
          const trigger = el;
          if (!(trigger instanceof HTMLElement)) return;
          if (trigger.dataset.paletteBound === '1') return;

          trigger.dataset.paletteBound = '1';
          trigger.addEventListener('click', () => {
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuButton =
              document.getElementById('mobile-menu-button');

            if (mobileMenu && !mobileMenu.hasAttribute('hidden')) {
              mobileMenu.setAttribute('hidden', '');
              mobileMenuButton?.setAttribute('aria-expanded', 'false');
            }

            window.dispatchEvent(new CustomEvent('command-palette:toggle'));
          });
        });
    };

    const bindSavedRouteTriggers = () => {
      globalScope.__headerSavedRoutesCleanup?.();

      const buttons = Array.from(
        document.querySelectorAll('[data-open-saved-routes]')
      ).filter(node => node instanceof HTMLButtonElement);
      const countTargets = Array.from(
        document.querySelectorAll('[data-saved-routes-count]')
      ).filter(node => node instanceof HTMLElement);

      const updateCounts = async () => {
        try {
          const mod = await import('../utils/route-memory');
          const count = mod.readPinnedRoutes().length;

          buttons.forEach(button => {
            button.hidden = count === 0;
            button.classList.toggle('inline-flex', count > 0);
          });

          countTargets.forEach(target => {
            target.textContent = `${count}`;
          });
        } catch {
          buttons.forEach(button => {
            button.hidden = true;
            button.classList.remove('inline-flex');
          });
        }
      };

      buttons.forEach(button => {
        if (button.dataset.savedRoutesBound === '1') return;
        button.dataset.savedRoutesBound = '1';
        button.addEventListener('click', () => {
          window.dispatchEvent(new CustomEvent('saved-routes-dock:open'));
        });
      });

      window.addEventListener('olive:route-pins-updated', updateCounts);
      globalScope.__headerSavedRoutesCleanup = () => {
        window.removeEventListener('olive:route-pins-updated', updateCounts);
      };
      updateCounts();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindPaletteTriggers, {
        once: true,
      });
      document.addEventListener('DOMContentLoaded', bindSavedRouteTriggers, {
        once: true,
      });
    } else {
      bindPaletteTriggers();
      bindSavedRouteTriggers();
    }

    document.addEventListener('astro:page-load', bindPaletteTriggers);
    document.addEventListener('astro:page-load', bindSavedRouteTriggers);
  })();
</script>

<script>
  // Import the enhanced header script that uses our utilities
  import '../scripts/header';
</script>
