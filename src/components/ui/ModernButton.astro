---
export interface Props {
  variant?:
    | 'primary'
    | 'secondary'
    | 'outline'
    | 'ghost'
    | 'destructive'
    | 'success'
    | 'warning'
    | 'gradient'
    | 'neon'
    | 'light';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  disabled?: boolean;
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  onClick?: string;
  loading?: boolean;
  leftIcon?: string;
  rightIcon?: string;
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'full';
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  disabled = false,
  className = '',
  type = 'button',
  onClick,
  loading = false,
  leftIcon,
  rightIcon,
  rounded = 'lg',
  shadow = 'md',
  ...rest
} = Astro.props;

const baseClasses =
  'group inline-flex select-none touch-manipulation items-center justify-center font-semibold tracking-[-0.01em] transition-[background-color,border-color,color,box-shadow,transform] duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0b1120] disabled:opacity-50 disabled:cursor-not-allowed motion-reduce:transition-none motion-reduce:transform-none';

const variants = {
  primary:
    'border border-white/80 bg-white text-slate-900 shadow-[0_12px_32px_rgba(15,23,42,0.18)] hover:bg-slate-100 hover:shadow-[0_16px_36px_rgba(15,23,42,0.22)] focus:ring-white/40',
  secondary:
    'border border-white/[0.12] bg-white/[0.04] text-white/92 shadow-[0_10px_24px_rgba(2,6,23,0.18)] hover:border-white/20 hover:bg-white/[0.08] hover:shadow-[0_14px_28px_rgba(2,6,23,0.24)] focus:ring-white/20',
  outline:
    'border border-white/[0.16] bg-transparent text-white/78 hover:border-white/24 hover:bg-white/[0.04] hover:text-white focus:ring-white/20',
  ghost:
    'bg-transparent text-white/62 hover:bg-white/[0.04] hover:text-white/88 focus:ring-white/10',
  destructive:
    'border border-red-400/20 bg-red-500/10 text-red-200 hover:bg-red-500/18 hover:border-red-300/30 focus:ring-red-400/40',
  success:
    'border border-emerald-300/20 bg-emerald-500/10 text-emerald-100 hover:bg-emerald-500/18 hover:border-emerald-200/30 focus:ring-emerald-300/40',
  warning:
    'border border-amber-300/20 bg-amber-500/10 text-amber-100 hover:bg-amber-500/18 hover:border-amber-200/30 focus:ring-amber-300/40',
  gradient:
    'border border-sky-200/40 bg-gradient-to-r from-slate-50 via-sky-50 to-blue-100 text-slate-900 shadow-[0_14px_34px_rgba(37,99,235,0.16)] hover:from-white hover:to-sky-100 hover:shadow-[0_18px_38px_rgba(37,99,235,0.2)] focus:ring-sky-200/40',
  neon: 'border border-sky-300/32 bg-sky-400/10 text-sky-100 shadow-[0_12px_28px_rgba(37,99,235,0.14)] hover:bg-sky-400/14 hover:border-sky-200/40 focus:ring-sky-200/35',
  light:
    'border border-slate-200 bg-slate-50 text-slate-900 hover:bg-white focus:ring-slate-300 shadow-[0_10px_22px_rgba(15,23,42,0.08)]',
};

const sizes = {
  xs: 'px-2.5 py-1.5 text-xs min-h-[40px] min-w-[40px]',
  sm: 'px-3 py-2 text-sm min-h-[44px] min-w-[44px]',
  md: 'px-4 py-2.5 text-base min-h-touch min-w-touch',
  lg: 'px-6 py-3 text-lg min-h-touch min-w-touch',
  xl: 'px-8 py-4 text-xl min-h-touch min-w-touch',
};

const roundedClasses = {
  none: 'rounded-none',
  sm: 'rounded-sm',
  md: 'rounded-md',
  lg: 'rounded-lg',
  full: 'rounded-full',
};

const shadowClasses = {
  none: '',
  sm: '',
  md: '',
  lg: '',
  xl: '',
};

const hoverEffects = '[@media(hover:hover)]:hover:-translate-y-px';
const focusEffects = '';

const classes =
  `${baseClasses} ${variants[variant]} ${sizes[size]} ${roundedClasses[rounded]} ${shadowClasses[shadow]} ${hoverEffects} ${focusEffects} ${className} ${disabled || loading ? 'opacity-50 cursor-not-allowed pointer-events-none' : ''} modern-button`.trim();

const Tag = href ? 'a' : 'button';
const linkProps = href
  ? { href, target, 'aria-disabled': disabled || loading }
  : {};
const buttonProps = href ? {} : { type, disabled: disabled || loading };
const ariaProps = { 'aria-busy': loading };
---

<Tag
  class={classes}
  {...linkProps}
  {...buttonProps}
  {...ariaProps}
  {...onClick && { onclick: onClick }}
  {...rest}
>
  {
    loading && (
      <div class="absolute inset-0 flex items-center justify-center bg-inherit">
        <div class="h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent" />
      </div>
    )
  }

  <div
    class={`flex items-center gap-2 ${loading ? 'opacity-0' : 'opacity-100'} transition-opacity`}
  >
    {leftIcon && <span class="text-current">{leftIcon}</span>}
    <slot />
    {rightIcon && <span class="text-current">{rightIcon}</span>}
  </div>
</Tag>

<style>
  .modern-button {
    transition-property: transform, box-shadow, filter, background-color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-button {
      transition-duration: 0.01ms !important;
    }

    .modern-button:hover,
    .modern-button:active {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
