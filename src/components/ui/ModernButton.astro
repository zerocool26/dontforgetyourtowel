---
export interface Props {
  variant?:
    | 'primary'
    | 'secondary'
    | 'outline'
    | 'ghost'
    | 'destructive'
    | 'success'
    | 'warning'
    | 'gradient'
    | 'neon'
    | 'light';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  disabled?: boolean;
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  onClick?: string;
  loading?: boolean;
  leftIcon?: string;
  rightIcon?: string;
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'full';
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  disabled = false,
  className = '',
  type = 'button',
  onClick,
  loading = false,
  leftIcon,
  rightIcon,
  rounded = 'lg',
  shadow = 'md',
  ...rest
} = Astro.props;

const baseClasses =
  'modern-button group relative inline-flex select-none touch-manipulation items-center justify-center overflow-hidden font-semibold tracking-[0.01em] focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed motion-reduce:transition-none motion-reduce:transform-none';

const variants = {
  primary: 'modern-button--primary',
  secondary: 'modern-button--secondary',
  outline: 'modern-button--outline',
  ghost: 'modern-button--ghost',
  destructive: 'modern-button--destructive',
  success: 'modern-button--success',
  warning: 'modern-button--warning',
  gradient: 'modern-button--gradient',
  neon: 'modern-button--neon',
  light: 'modern-button--light',
};

const sizes = {
  xs: 'px-2.5 py-1.5 text-xs min-h-[40px] min-w-[40px]',
  sm: 'px-3 py-2 text-sm min-h-[44px] min-w-[44px]',
  md: 'px-4 py-2.5 text-base min-h-touch min-w-touch',
  lg: 'px-6 py-3 text-lg min-h-touch min-w-touch',
  xl: 'px-8 py-4 text-xl min-h-touch min-w-touch',
};

const roundedClasses = {
  none: 'rounded-none',
  sm: 'rounded-sm',
  md: 'rounded-md',
  lg: 'rounded-lg',
  full: 'rounded-full',
};

const shadowClasses = {
  none: '',
  sm: '',
  md: '',
  lg: '',
  xl: '',
};

const classes =
  `${baseClasses} ${variants[variant]} ${sizes[size]} ${roundedClasses[rounded]} ${shadowClasses[shadow]} ${className} ${disabled || loading ? 'opacity-50 cursor-not-allowed pointer-events-none' : ''}`.trim();

const Tag = href ? 'a' : 'button';
const linkProps = href
  ? { href, target, 'aria-disabled': disabled || loading }
  : {};
const buttonProps = href ? {} : { type, disabled: disabled || loading };
const ariaProps = { 'aria-busy': loading };
---

<Tag
  class={classes}
  {...linkProps}
  {...buttonProps}
  {...ariaProps}
  {...onClick && { onclick: onClick }}
  {...rest}
>
  <span class="modern-button__frame" aria-hidden="true"></span>
  {
    loading && (
      <div class="absolute inset-0 z-[3] flex items-center justify-center bg-inherit">
        <div class="h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent" />
      </div>
    )
  }

  <div
    class={`modern-button__content relative z-[2] flex items-center gap-2 ${loading ? 'opacity-0' : 'opacity-100'} transition-opacity`}
  >
    {leftIcon && <span class="text-current">{leftIcon}</span>}
    <slot />
    {rightIcon && <span class="text-current">{rightIcon}</span>}
  </div>
</Tag>

<style>
  .modern-button {
    isolation: isolate;
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    box-shadow: var(--button-shadow, none);
    transition-property:
      transform, box-shadow, filter, background-color, border-color, color;
    transition-duration: 0.18s;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(12px);
  }

  .modern-button::before {
    content: none;
  }

  .modern-button__frame {
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.045),
      rgba(255, 255, 255, 0.01) 42%,
      transparent
    );
    opacity: 0.62;
    pointer-events: none;
  }

  .modern-button__content {
    text-wrap: balance;
  }

  .modern-button:focus-visible {
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--color-primary) 32%, transparent),
      0 0 0 5px color-mix(in srgb, var(--color-surface) 96%, transparent),
      var(--button-shadow, none);
  }

  .modern-button--primary {
    --button-shadow: 0 22px 48px -30px
      color-mix(in srgb, var(--color-primary) 52%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 32%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 90%, white 10%),
      color-mix(in srgb, var(--color-primary-strong) 32%, white 68%)
    );
    color: #061019;
  }

  .modern-button--primary:hover {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 84%, white 16%),
      color-mix(in srgb, var(--color-primary-strong) 38%, white 62%)
    );
    box-shadow: 0 24px 52px -30px
      color-mix(in srgb, var(--color-primary) 58%, transparent);
  }

  .modern-button--secondary {
    --button-shadow: 0 18px 40px -34px rgba(0, 0, 0, 0.42);
    border-color: color-mix(in srgb, var(--color-border) 74%, transparent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 4%, transparent),
        transparent 52%
      ),
      color-mix(in srgb, var(--color-surface) 94%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 92%, transparent);
  }

  .modern-button--secondary:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 18%,
      transparent
    );
    background: color-mix(in srgb, var(--color-surface) 99%, white 1%);
    box-shadow: 0 20px 42px -34px rgba(0, 0, 0, 0.46);
  }

  .modern-button--outline {
    border-color: color-mix(in srgb, var(--color-border) 84%, transparent);
    background: color-mix(in srgb, var(--color-surface) 48%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
  }

  .modern-button--outline:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 22%,
      transparent
    );
    background: linear-gradient(
      135deg,
      color-mix(
        in srgb,
        var(--route-accent, var(--color-primary)) 8%,
        transparent
      ),
      color-mix(in srgb, var(--color-surface) 92%, transparent)
    );
    color: var(--color-text-primary);
  }

  .modern-button--ghost {
    background: transparent;
    color: color-mix(in srgb, var(--color-text-primary) 64%, transparent);
  }

  .modern-button--ghost:hover {
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    color: color-mix(in srgb, var(--color-text-primary) 88%, transparent);
  }

  .modern-button--destructive {
    border-color: color-mix(in srgb, var(--color-danger) 28%, transparent);
    background: color-mix(in srgb, var(--color-danger) 10%, transparent);
    color: color-mix(in srgb, white 84%, var(--color-danger) 16%);
  }

  .modern-button--destructive:hover {
    border-color: color-mix(in srgb, var(--color-danger) 38%, transparent);
    background: color-mix(in srgb, var(--color-danger) 16%, transparent);
  }

  .modern-button--success {
    border-color: color-mix(in srgb, var(--color-success) 28%, transparent);
    background: color-mix(in srgb, var(--color-success) 10%, transparent);
    color: color-mix(in srgb, white 84%, var(--color-success) 16%);
  }

  .modern-button--success:hover {
    border-color: color-mix(in srgb, var(--color-success) 38%, transparent);
    background: color-mix(in srgb, var(--color-success) 16%, transparent);
  }

  .modern-button--warning {
    border-color: color-mix(in srgb, var(--color-warning) 28%, transparent);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    color: color-mix(in srgb, white 82%, var(--color-warning) 18%);
  }

  .modern-button--warning:hover {
    border-color: color-mix(in srgb, var(--color-warning) 38%, transparent);
    background: color-mix(in srgb, var(--color-warning) 16%, transparent);
  }

  .modern-button--gradient {
    --button-shadow: 0 24px 58px -32px rgba(0, 0, 0, 0.5);
    border-color: color-mix(in srgb, var(--color-primary) 26%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 88%, white 12%),
      color-mix(in srgb, var(--color-primary-strong) 68%, white 32%)
    );
    color: #05111a;
  }

  .modern-button--gradient:hover {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 82%, white 18%),
      color-mix(in srgb, var(--color-primary-strong) 72%, white 28%)
    );
    box-shadow: 0 26px 62px -32px rgba(0, 0, 0, 0.54);
  }

  .modern-button--neon {
    --button-shadow: 0 18px 42px -34px rgba(0, 0, 0, 0.42);
    border-color: color-mix(
      in srgb,
      var(--color-primary-strong) 32%,
      transparent
    );
    background: color-mix(
      in srgb,
      var(--color-primary-strong) 10%,
      transparent
    );
    color: color-mix(in srgb, white 86%, var(--color-primary-strong) 14%);
  }

  .modern-button--neon:hover {
    border-color: color-mix(in srgb, var(--color-primary) 38%, transparent);
    background: color-mix(
      in srgb,
      var(--color-primary-strong) 18%,
      transparent
    );
  }

  .modern-button--light {
    --button-shadow: none;
    border-color: color-mix(in srgb, var(--color-border) 88%, white 12%);
    background: color-mix(in srgb, white 94%, var(--color-surface) 6%);
    color: color-mix(in srgb, var(--color-background) 86%, black 14%);
  }

  .modern-button--light:hover {
    background: white;
  }

  @media (hover: hover) {
    .modern-button:not(:disabled):not([aria-disabled='true']):hover {
      transform: translateY(-1px);
      filter: saturate(1.04);
    }

    .modern-button:not(:disabled):not([aria-disabled='true']):active {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-button {
      transition-duration: 0.01ms !important;
    }

    .modern-button:hover,
    .modern-button:active {
      transform: none !important;
      filter: none !important;
    }
  }
</style>
