---
import { normalizeContextPath } from '../../utils/route-context';

export interface NavItem {
  href: string;
  label: string;
  icon?: string;
  iconPaths?: string[];
  iconViewBox?: string;
  active?: boolean;
  match?: 'exact' | 'prefix';
}

export interface Props {
  items: NavItem[];
  class?: string;
  accent?: string;
  contextTitle?: string;
  contextAction?: {
    label: string;
    href: string;
    detail?: string;
  };
}

const {
  items,
  class: className = '',
  accent = '#ccff00',
  contextTitle,
  contextAction,
} = Astro.props;
const currentPath = normalizeContextPath(Astro.url.pathname);

const isActiveItem = (item: NavItem) => {
  const hrefPath = normalizeContextPath(item.href);
  const matchMode = item.match ?? 'exact';

  if (item.active) return true;
  if (matchMode === 'prefix') {
    return currentPath === hrefPath || currentPath.startsWith(`${hrefPath}/`);
  }
  return currentPath === hrefPath;
};
---

<nav
  class={`bottom-nav ${className}`}
  role="navigation"
  aria-label="Mobile navigation"
  style={`--bottom-nav-accent:${accent};`}
>
  {
    contextAction ? (
      <a class="bottom-nav-context" href={contextAction.href}>
        <span class="bottom-nav-context__meta">
          <span class="bottom-nav-context__label">Route action</span>
          <span class="bottom-nav-context__title">
            {contextTitle ?? contextAction.label}
          </span>
        </span>
        <span class="bottom-nav-context__cta">
          <span>{contextAction.label}</span>
          {contextAction.detail ? (
            <span class="bottom-nav-context__detail">
              {contextAction.detail}
            </span>
          ) : null}
        </span>
      </a>
    ) : null
  }
  <div class="bottom-nav-inner">
    {
      items.map(item => (
        <a
          href={item.href}
          class={`bottom-nav-item ${isActiveItem(item) ? 'active' : ''}`}
          aria-label={item.label}
          aria-current={isActiveItem(item) ? 'page' : undefined}
        >
          <span class="bottom-nav-icon" aria-hidden="true">
            {item.iconPaths?.length ? (
              <svg
                class="bottom-nav-icon__svg"
                fill="none"
                viewBox={item.iconViewBox ?? '0 0 24 24'}
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.6"
              >
                {item.iconPaths.map(path => (
                  <path d={path} />
                ))}
              </svg>
            ) : (
              item.icon
            )}
          </span>
          <span class="bottom-nav-label">{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: max(0.55rem, env(safe-area-inset-bottom, 0));
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(calc(100% - 1rem), 34rem);
    border-radius: 1.55rem;
    background: linear-gradient(
      180deg,
      rgba(10, 12, 18, 0.96),
      rgba(6, 8, 12, 0.98)
    );
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      0 32px 80px -36px rgba(0, 0, 0, 0.98),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 0 52px -30px
        color-mix(in srgb, var(--bottom-nav-accent) 30%, transparent);

    /* Top shimmer line */
    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, var(--bottom-nav-accent) 40%, transparent),
        transparent
      );
      border-radius: 999px;
    }

    /* Safe area support for devices with notches/home indicator */
    padding-bottom: max(env(safe-area-inset-bottom, 0), 0.25rem);

    /* Hide on desktop */
    display: none;
  }

  @media (max-width: 768px) {
    .bottom-nav {
      display: block;
    }
  }

  .bottom-nav-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 4px;
    padding: 8px 8px 6px;
    max-width: 100%;
  }

  .bottom-nav-context {
    display: grid;
    gap: 0.4rem;
    margin: 0 0 0.45rem;
    border-radius: 1.25rem;
    border: 1px solid
      color-mix(in srgb, var(--bottom-nav-accent) 20%, transparent);
    background:
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--bottom-nav-accent) 10%, transparent),
        rgba(255, 255, 255, 0.015)
      ),
      rgba(8, 10, 16, 0.6);
    padding: 0.72rem 0.9rem;
    box-shadow:
      0 18px 40px -28px rgba(0, 0, 0, 0.96),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .bottom-nav-context:active {
    background:
      linear-gradient(
        150deg,
        color-mix(in srgb, var(--bottom-nav-accent) 14%, transparent),
        rgba(255, 255, 255, 0.025)
      ),
      rgba(8, 10, 16, 0.7);
    border-color: color-mix(in srgb, var(--bottom-nav-accent) 30%, transparent);
  }

  .bottom-nav-context__meta,
  .bottom-nav-context__cta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .bottom-nav-context__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .bottom-nav-context__title {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .bottom-nav-context__cta {
    color: color-mix(in srgb, var(--bottom-nav-accent) 78%, white 22%);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .bottom-nav-context__detail {
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .bottom-nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 1rem;
    color: color-mix(in srgb, var(--color-text-muted) 90%, transparent);
    text-decoration: none;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 140ms ease,
      border-color 200ms ease;
    position: relative;
    border: 1px solid transparent;

    /* WCAG AAA touch target - minimum 48x48px */
    min-height: 48px;
    min-width: 48px;

    /* Improve tap response */
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .bottom-nav-item:active {
    transform: scale(0.95);
  }

  .bottom-nav-item:hover,
  .bottom-nav-item:focus-visible {
    background: color-mix(in srgb, var(--bottom-nav-accent) 12%, transparent);
    color: var(--color-text-primary);
    border-color: color-mix(in srgb, var(--bottom-nav-accent) 24%, transparent);
  }

  .bottom-nav-item.active {
    color: var(--bottom-nav-accent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bottom-nav-accent) 18%, transparent),
      color-mix(in srgb, var(--bottom-nav-accent) 12%, transparent)
    );
    border-color: color-mix(in srgb, var(--bottom-nav-accent) 24%, transparent);
    box-shadow: 0 0 26px -18px
      color-mix(in srgb, var(--bottom-nav-accent) 40%, transparent);
  }

  .bottom-nav-item.active::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 3px;
    background: var(--bottom-nav-accent);
    border-radius: 0 0 4px 4px;
    box-shadow:
      0 0 12px color-mix(in srgb, var(--bottom-nav-accent) 70%, transparent),
      0 0 24px color-mix(in srgb, var(--bottom-nav-accent) 30%, transparent);
  }

  .bottom-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    line-height: 1;
    color: currentColor;
  }

  .bottom-nav-icon__svg {
    width: 100%;
    height: 100%;
  }

  .bottom-nav-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1;
    white-space: nowrap;
  }

  /* Focus indicators */
  .bottom-nav-item:focus-visible {
    outline: 2px solid
      color-mix(in srgb, var(--bottom-nav-accent) 92%, transparent);
    outline-offset: 2px;
  }

  /* Animation for page load */
  @media (prefers-reduced-motion: no-preference) {
    .bottom-nav {
      animation: slideUpFadeIn 380ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes slideUpFadeIn {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(110%);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bottom-nav {
      animation: none;
    }
    .bottom-nav-item {
      transition: none;
    }
    .bottom-nav-item:active {
      transform: none;
    }
  }
</style>

<script>
  // Add haptic feedback on tap (iOS/Android)
  function addHapticFeedback() {
    const items = document.querySelectorAll<HTMLElement>('.bottom-nav-item');

    items.forEach(item => {
      if (item.dataset.hapticBound === '1') return;
      item.dataset.hapticBound = '1';
      item.addEventListener('click', () => {
        // Trigger haptic feedback if available
        if ('vibrate' in navigator) {
          navigator.vibrate(10); // 10ms light tap
        }
      });
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addHapticFeedback);
  } else {
    addHapticFeedback();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener('astro:page-load', addHapticFeedback);
</script>
