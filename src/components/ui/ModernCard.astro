---
export interface Props {
  variant?:
    | 'default'
    | 'outline'
    | 'gradient'
    | 'glass'
    | 'neon'
    | 'minimal'
    | 'elevated'
    | 'bordered';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
  href?: string;
  hover?: boolean;
  glow?: boolean;
  spotlight?: boolean;
  animated?: boolean;
  direction?: 'up' | 'down' | 'left' | 'right';
  delay?: number;
  style?: string;
  [key: string]: any;
}

const {
  variant = 'default',
  size = 'md',
  className = '',
  href,
  hover = true,
  glow = false,
  spotlight = false,
  animated = false,
  direction = 'up',
  delay = 0,
  style = '',
  ...rest
} = Astro.props;

const baseClasses =
  'modern-card-shell group relative overflow-hidden rounded-[1.35rem] transition-[border-color,background-color,box-shadow,transform] duration-150 ease-out touch-manipulation motion-reduce:transition-none';

const variants = {
  default: 'modern-card--default',
  outline: 'modern-card--outline',
  gradient: 'modern-card--gradient',
  glass: 'modern-card--glass',
  neon: 'modern-card--neon',
  minimal: 'modern-card--minimal',
  elevated: 'modern-card--elevated',
  bordered: 'modern-card--bordered',
};

const sizes = {
  xs: 'p-3',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8',
  xl: 'p-10',
};

const hoverEffects = hover
  ? '[@media(hover:hover)]:hover:-translate-y-[1px]'
  : '';
const glowEffects = glow ? 'modern-card--glow' : '';
const spotlightEffects = spotlight
  ? 'card-spotlight modern-card--spotlight'
  : '';

const animationClasses = animated ? `animate-slide-${direction}` : '';
const delayStyle = delay > 0 ? `animation-delay: ${delay}s` : '';
const combinedStyle = [delayStyle, style].filter(Boolean).join('; ');

const interactiveClasses = href
  ? 'modern-card--interactive block cursor-pointer active:scale-[0.98] focus:outline-none motion-reduce:transform-none'
  : '';

const classes = `${baseClasses} modern-card ${interactiveClasses} ${variants[variant]} ${sizes[size]} ${hoverEffects} ${glowEffects} ${spotlightEffects} ${animationClasses} ${className}`;

const Tag = href ? 'a' : 'div';
---

<Tag href={href} class={classes} style={combinedStyle} {...rest}>
  <div class="modern-card__surface" aria-hidden="true"></div>
  <div class="modern-card__inner-ring" aria-hidden="true"></div>
  {
    spotlight && (
      <div
        class="pointer-events-none absolute inset-0 z-10 opacity-0 transition-opacity duration-300 motion-reduce:transition-none [@media(hover:hover)]:group-hover:opacity-100"
        style="background: radial-gradient(420px circle at var(--mouse-x) var(--mouse-y), color-mix(in srgb, var(--color-text-primary) 6%, transparent), transparent 42%);"
      />
    )
  }

  {
    glow && (
      <div
        class="absolute inset-[1px] z-10 rounded-[calc(1.75rem-1px)]"
        style="background: color-mix(in srgb, var(--color-surface) 72%, transparent);"
      />
    )
  }

  <div class="relative z-20">
    <slot />
  </div>

  {
    variant === 'neon' && (
      <div class="modern-card__neon-overlay absolute inset-0 rounded-2xl opacity-0 blur-lg transition-opacity duration-300 group-hover:opacity-100" />
    )
  }

  {
    variant === 'glass' && (
      <div class="pointer-events-none absolute inset-0 opacity-[0.02] pattern-grid dark:opacity-[0.05]" />
    )
  }
</Tag>

<style>
  .modern-card {
    border: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent);
    isolation: isolate;
    backdrop-filter: none;
    box-shadow: 0 24px 56px -44px rgba(0, 0, 0, 0.58);
  }

  .modern-card__surface {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.035),
      rgba(255, 255, 255, 0.015) 26%,
      transparent 60%
    );
    opacity: 0.44;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .modern-card__inner-ring {
    position: absolute;
    inset: 1px;
    z-index: 1;
    border-radius: inherit;
    border: 1px solid color-mix(in srgb, white 3%, transparent);
    pointer-events: none;
  }

  .modern-card--interactive:focus-visible {
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--color-primary) 34%, transparent),
      0 20px 44px -28px rgba(2, 6, 23, 0.76);
  }

  .modern-card--default {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 96%, white 2%),
        color-mix(in srgb, var(--color-surface) 88%, transparent)
      ),
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--route-accent, var(--color-primary)) 2%,
          transparent
        ),
        transparent 64%
      ),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
    box-shadow: none;
  }

  .modern-card--outline {
    background: transparent;
  }

  .modern-card--outline:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 18%,
      transparent
    );
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  }

  .modern-card--gradient {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-text-primary) 4%, transparent),
      color-mix(in srgb, var(--color-primary-strong) 6%, transparent)
    );
    box-shadow: 0 22px 50px -42px rgba(0, 0, 0, 0.5);
  }

  .modern-card--glass {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 96%, white 2%),
        color-mix(in srgb, var(--color-surface) 88%, transparent)
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-primary-strong) 4%, transparent),
        color-mix(in srgb, var(--color-primary) 3%, transparent) 42%,
        transparent 60%
      ),
      color-mix(in srgb, var(--color-surface) 86%, transparent);
    box-shadow: 0 22px 48px -42px rgba(0, 0, 0, 0.52);
    backdrop-filter: none;
  }

  .modern-card--neon {
    border-color: color-mix(
      in srgb,
      var(--color-primary-strong) 18%,
      transparent
    );
    background: color-mix(in srgb, var(--color-primary-strong) 6%, transparent);
    box-shadow: 0 24px 52px -42px rgba(0, 0, 0, 0.56);
  }

  .modern-card--minimal {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-surface) 42%, transparent),
      transparent
    );
  }

  .modern-card--minimal:hover {
    border-color: color-mix(
      in srgb,
      var(--color-text-primary) 14%,
      transparent
    );
  }

  .modern-card--elevated {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-surface) 97%, white 3%),
        color-mix(in srgb, var(--color-surface) 88%, transparent)
      ),
      color-mix(in srgb, var(--color-surface) 84%, transparent);
    box-shadow: none;
  }

  .modern-card--bordered {
    border-top: 1px solid
      color-mix(in srgb, var(--color-border) 88%, transparent);
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
    border-radius: 0;
    background: transparent;
  }

  .modern-card--glow::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 45%, transparent),
      color-mix(in srgb, var(--color-primary-strong) 28%, transparent),
      color-mix(in srgb, var(--color-text-primary) 18%, transparent)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .modern-card--glow:hover::before {
    opacity: 1;
  }

  .modern-card__neon-overlay {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-primary) 12%, transparent),
      color-mix(in srgb, var(--color-primary-strong) 10%, transparent),
      color-mix(in srgb, var(--color-text-primary) 12%, transparent)
    );
  }

  @media (hover: hover) {
    .modern-card:hover .modern-card__surface {
      opacity: 0.7;
    }

    .modern-card--interactive:hover {
      box-shadow: none;
    }
  }

  @media (max-width: 768px) {
    .modern-card {
      -webkit-tap-highlight-color: transparent;
    }
  }
</style>

<style>
  /* Enhanced animations */
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-down {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-left {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slide-right {
    from {
      opacity: 0;
      transform: translateX(20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out both;
  }

  .animate-slide-down {
    animation: slide-down 0.6s ease-out both;
  }

  .animate-slide-left {
    animation: slide-left 0.6s ease-out both;
  }

  .animate-slide-right {
    animation: slide-right 0.6s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-card,
    .modern-card::before,
    .modern-card::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }

    .modern-card:hover,
    .modern-card:active {
      transform: none !important;
    }
  }
</style>

<script>
  function initSpotlightCards() {
    const cards = document.querySelectorAll<HTMLElement>('.card-spotlight');
    cards.forEach(card => {
      if (card.dataset.spotlightBound === '1') return;
      card.dataset.spotlightBound = '1';

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlightCards);
  } else {
    initSpotlightCards();
  }

  document.addEventListener('astro:page-load', initSpotlightCards);
</script>
