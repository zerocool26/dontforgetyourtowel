---
/**
 * Structured Data (JSON-LD) Component
 * Adds schema.org markup for better SEO and rich results
 */

import {
  CONTACT_EMAIL,
  SITE_CONFIG,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
} from '../consts';
import {
  businessAreaServed,
  businessAudience,
  businessOfferCatalog,
  businessServiceTypes,
} from '../data/business-profile';

export interface Props {
  type?:
    | 'website'
    | 'article'
    | 'blog'
    | 'organization'
    | 'breadcrumbs'
    | 'collection'
    | 'service'
    | 'contact';
  data?: Record<string, any>;
}

const { type = 'website', data = {} } = Astro.props;

const baseUrl = Astro.site?.toString() || SITE_URL;
const currentUrl = new URL(Astro.url.pathname, baseUrl).toString();
const logoUrl = new URL(
  SITE_CONFIG.seo.ogImage || '/og-image.png',
  baseUrl
).toString();

// Website schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  alternateName: SITE_CONFIG.author,
  url: baseUrl,
  description: SITE_DESCRIPTION,
  inLanguage: 'en-US',
  publisher: {
    '@type': 'ProfessionalService',
    name: SITE_TITLE,
    url: baseUrl,
  },
  ...data,
};

// Organization schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE_TITLE,
  alternateName: SITE_CONFIG.author,
  url: baseUrl,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  areaServed: businessAreaServed,
  audience: businessAudience.map(name => ({
    '@type': 'BusinessAudience',
    name,
  })),
  knowsAbout: businessServiceTypes,
  hasOfferCatalog: businessOfferCatalog,
  logo: {
    '@type': 'ImageObject',
    url: logoUrl,
  },
  sameAs: Object.values(SITE_CONFIG.social).filter(Boolean),
  ...data,
};

// Article schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title || 'Article',
  description: data.description || '',
  image: data.image || `${baseUrl}/og-image.png`,
  datePublished: data.pubDate || new Date().toISOString(),
  dateModified: data.updatedDate || data.pubDate || new Date().toISOString(),
  author: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: baseUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  ...data,
};

// Breadcrumbs schema
const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: data.items || [],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: data.name || data.title || SITE_TITLE,
  description: data.description || SITE_DESCRIPTION,
  url: currentUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_TITLE,
    url: baseUrl,
  },
  ...data,
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.name || data.title || SITE_TITLE,
  description: data.description || SITE_DESCRIPTION,
  url: currentUrl,
  provider: {
    '@type': 'ProfessionalService',
    name: SITE_TITLE,
    url: baseUrl,
    areaServed: businessAreaServed,
  },
  serviceType: data.serviceType || data.name || data.title,
  areaServed: data.areaServed || businessAreaServed,
  audience: data.audience,
  hasOfferCatalog: data.hasOfferCatalog,
  offers: data.offers,
  termsOfService: data.termsOfService,
  ...data,
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: data.name || `${SITE_TITLE} Contact`,
  description: data.description || 'Project intake and contact routing.',
  url: currentUrl,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: SITE_TITLE,
    url: baseUrl,
    email: CONTACT_EMAIL,
    areaServed: businessAreaServed,
  },
  ...data,
};

// Select appropriate schema
let schema;
switch (type) {
  case 'organization':
    schema = organizationSchema;
    break;
  case 'article':
  case 'blog':
    schema = articleSchema;
    break;
  case 'breadcrumbs':
    schema = breadcrumbsSchema;
    break;
  case 'collection':
    schema = collectionSchema;
    break;
  case 'service':
    schema = serviceSchema;
    break;
  case 'contact':
    schema = contactSchema;
    break;
  default:
    schema = websiteSchema;
}

const schemaJson = JSON.stringify(schema);
---

<script type="application/ld+json" is:inline set:text={schemaJson} />
