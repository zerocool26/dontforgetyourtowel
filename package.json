{
  "name": "chicagos-number-one-msp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.8",
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/copy-three-decoders.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "bun run typecheck:astro && tsc --noEmit",
    "typecheck:astro": "astro check --minimumSeverity error",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 50",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "error-review": "tsx src/utils/error-reviewer-cli.ts analyze",
    "error-review:watch": "tsx src/utils/error-reviewer-cli.ts watch",
    "error-review:fix": "tsx src/utils/error-reviewer-cli.ts analyze --fix",
    "error-review:report": "tsx src/utils/error-reviewer-cli.ts analyze --format html --output error-report.html",
    "error-review:interactive": "tsx src/utils/error-reviewer-cli.ts --interactive",
    "error-review:critical": "tsx src/utils/error-reviewer-cli.ts analyze --severity critical",
    "error-review:security": "tsx src/utils/error-reviewer-cli.ts analyze --categories security",
    "error-review:deployment": "tsx src/utils/error-reviewer-cli.ts analyze --deployment",
    "error-review:markdown": "tsx src/utils/error-reviewer-cli.ts analyze --format markdown --output README-ERRORS.md",
    "error-review:json": "tsx src/utils/error-reviewer-cli.ts analyze --format json --output error-analysis.json",
    "pre-deploy": "bun run error-review:critical && bun run typecheck && bun run lint && bun run test && bun run build",
    "health-check": "tsx src/utils/error-reviewer-cli.ts analyze --severity critical --format terminal",
    "security-audit": "bun audit --audit-level moderate && bun run error-review:security",
    "code-quality": "bun run error-review && bun run lint && bun run typecheck",
    "deploy-ready": "bun run error-review:deployment && bun run pre-deploy",
    "new:post": "tsx scripts/scaffold.ts post",
    "new:component": "tsx scripts/scaffold.ts component",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "bun run test && bun run test:e2e",
    "quality:lighthouse": "bun run build && node scripts/run-lhci.mjs",
    "verify:fast": "bun run typecheck && bun run lint && bun run test",
    "verify:full": "bun run verify:fast && bun run build && bun run health-check",
    "doctor": "bun run health-check && bun audit --audit-level moderate",
    "deps:audit": "bun audit --audit-level moderate",
    "deps:outdated": "bun outdated"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/preact": "^5.1.2",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@nanostores/preact": "^1.0.0",
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.15.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@theatre/core": "^0.7.2",
    "@types/prismjs": "^1.26.5",
    "@types/yargs": "^17.0.35",
    "astro": "^6.3.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.3.21",
    "fuse.js": "^7.1.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "leva": "^0.9.35",
    "lucide-preact": "^0.563.0",
    "nanostores": "^1.1.0",
    "postprocessing": "^6.36.1",
    "preact": "^10.28.3",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "splitting": "^1.0.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.182.0",
    "tslib": "^2.8.1",
    "web-vitals": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "diff": "^8.0.3",
    "devalue": "^5.8.1",
    "h3": "^1.15.9",
    "fast-xml-parser": "^5.3.4",
    "tmp": "^0.2.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@axe-core/playwright": "^4.11.0",
    "@headlessui/tailwindcss": "^0.2.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.24",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lightningcss": "^1.31.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,ts,astro,css}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
