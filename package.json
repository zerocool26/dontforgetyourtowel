{
  "name": "chicagos-number-one-msp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "bun run typecheck:astro && tsc --noEmit",
    "typecheck:astro": "astro check --minimumSeverity error",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "verify:fast": "bun run typecheck && bun run lint && bun run test",
    "verify:full": "bun run verify:fast && bun run build",
    "deploy-ready": "bun run verify:full && bun run test:e2e",
    "deps:audit": "bun audit --audit-level moderate"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/preact": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.2.1",
    "preact": "^10.29.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.5",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "svgo": "^4.0.2",
    "yaml": "^2.8.3"
  }
}
