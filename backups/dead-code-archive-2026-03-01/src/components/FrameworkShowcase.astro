---
export interface Props {
  title: string;
  framework: string;
  color: string;
  client?: 'load' | 'idle' | 'visible' | 'media' | 'only';
}

const { title, framework, color, client = 'visible' } = Astro.props;
---

<div class="group relative">
  <!-- Framework indicator -->
  <div class="absolute -right-2 -top-2 z-10">
    <div
      class="rounded-full px-3 py-1 text-xs font-semibold text-white shadow-lg"
      style={`background: ${color}; box-shadow: 0 0 15px ${color}50;`}
    >
      {framework}
    </div>
  </div>

  <!-- Hydration indicator -->
  <div class="absolute -left-2 -top-2 z-10">
    <div
      class="rounded-full bg-blue-500 px-2 py-1 font-mono text-xs text-white"
    >
      client:{client}
    </div>
  </div>

  <!-- Main content area -->
  <div
    class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xl transition-all duration-300 group-hover:scale-105 group-hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
  >
    <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white">
      {title}
    </h3>

    <div class="relative">
      <slot />
    </div>

    <!-- Performance indicator -->
    <div
      class="mt-4 flex items-center justify-between text-sm text-gray-500 dark:text-gray-400"
    >
      <div class="flex items-center space-x-2">
        <div class="h-2 w-2 animate-pulse rounded-full bg-green-400"></div>
        <span>Hydrated</span>
      </div>
      <div class="font-mono text-xs">
        {new Date().toLocaleTimeString()}
      </div>
    </div>
  </div>
</div>

<style>
  .group:hover .framework-indicator {
    transform: scale(1.1);
  }
</style>
