---
import ModernCard from './ui/ModernCard.astro';

interface HighlightItem {
  label: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  items: HighlightItem[];
}

const { eyebrow, title, intro = '', items } = Astro.props as Props;
---

<section class="relative border-t border-white/10 bg-transparent py-24">
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,_var(--color-surface-subtle)_0%,_transparent_70%)] opacity-20"
  >
  </div>
  <div class="relative mx-auto max-w-[1220px] px-6">
    <div class="max-w-3xl space-y-4">
      <p
        class="font-mono text-xs font-bold uppercase tracking-[0.32em] text-[#ccff00]"
      >
        {eyebrow}
      </p>
      <h2
        class="font-display text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl"
      >
        {title}
      </h2>
      {
        intro && (
          <p class="border-l-2 border-white/10 pl-4 font-mono text-sm text-neutral-400">
            {intro}
          </p>
        )
      }
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map(item => (
          <ModernCard className="flex h-full flex-col gap-4 bg-white/5 border-white/10 hover:border-[#ccff00]/50 transition-colors group">
            <div class="flex items-center gap-3 text-[0.7rem] font-bold uppercase tracking-[0.32em] text-white">
              <span class="inline-flex h-8 w-8 items-center justify-center border border-white/20 bg-white/5 font-mono text-[#ccff00] transition-colors group-hover:border-[#ccff00]/50 group-hover:text-[#ccff00]">
                {item.label}
              </span>
              <span class="font-mono text-neutral-300 transition-colors group-hover:text-white">
                {item.title}
              </span>
            </div>
            <p class="font-mono text-sm leading-relaxed text-neutral-400">
              {item.description}
            </p>
          </ModernCard>
        ))
      }
    </div>
  </div>
</section>
