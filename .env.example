# Example environment variables

# Canonical site URL (defaults to an auto-derived GitHub Pages URL)
# SITE_URL=https://<username>.github.io/<repo>/
# PUBLIC_SITE_URL=https://<username>.github.io/<repo>/

# Optional: override the base path if you change the repo name or host under a subpath
# BASE_PATH=/docs/
# PUBLIC_BASE_PATH=/docs/

# Optional: enable client analytics explicitly (off by default for forks)
# PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Contact (static mailto). Used by src/scripts/contact-form.ts
PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional: public API origin for integrations that need a configured endpoint
# PUBLIC_API_URL=https://api.example.com

# Compatibility mirrors for app/** and lib/** surfaces that still accept Next-style naming.
# NEXT_PUBLIC_SITE_URL=https://<username>.github.io/<repo>/
# NEXT_PUBLIC_BASE_PATH=/docs/
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_API_URL=https://api.example.com
